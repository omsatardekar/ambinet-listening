{
  "schema_version": "1.0",
  "encounter_id": "01426",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 3.9,
      "duration_seconds": 3.35,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.51,
      "end_seconds": 9.74,
      "duration_seconds": 4.23,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.87,
      "end_seconds": 16.06,
      "duration_seconds": 5.19,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.72,
      "end_seconds": 21.1,
      "duration_seconds": 3.38,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.03,
      "end_seconds": 32.9,
      "duration_seconds": 9.87,
      "text": "Mm, you know, doctor, it's been passing out for a couple of minutes. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.21,
      "end_seconds": 37.49,
      "duration_seconds": 3.28,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.75,
      "end_seconds": 42.32,
      "duration_seconds": 3.57,
      "text": "Uh, around a week, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.17,
      "end_seconds": 48.37,
      "duration_seconds": 4.2,
      "text": "It, It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.29,
      "end_seconds": 53.88,
      "duration_seconds": 4.59,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.53,
      "end_seconds": 58.61,
      "duration_seconds": 3.08,
      "text": "Mm, that sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.39,
      "end_seconds": 62.34,
      "duration_seconds": 2.95,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.06,
      "end_seconds": 72.92,
      "duration_seconds": 8.86,
      "text": "Pretty mild, if I'm being honest. Oh, and a headache afterwards. Had that since Friday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.46,
      "end_seconds": 77.37,
      "duration_seconds": 2.91,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.95,
      "end_seconds": 83.47,
      "duration_seconds": 4.52,
      "text": "Well, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.51,
      "end_seconds": 87.39,
      "duration_seconds": 2.88,
      "text": "Have you had a bitten tongue?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.19,
      "end_seconds": 95.67,
      "duration_seconds": 6.48,
      "text": "Right, yeah. Ten days, I'd say. Mm, with bitten tongue, mostly moderate."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.25,
      "end_seconds": 108.53,
      "duration_seconds": 3.28,
      "text": "Have you had head injury, by any chance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.04,
      "end_seconds": 113.77,
      "duration_seconds": 4.73,
      "text": "No, you know, I haven't had any head injury."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.31,
      "end_seconds": 122.27,
      "duration_seconds": 3.96,
      "text": "And what about palpitations, fever or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.51,
      "end_seconds": 129.79,
      "duration_seconds": 6.28,
      "text": "Sorry, what was I saying, no, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.05,
      "end_seconds": 134.46,
      "duration_seconds": 3.41,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.41,
      "end_seconds": 138.1,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.26,
      "end_seconds": 142.64,
      "duration_seconds": 3.38,
      "text": "Okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.43,
      "end_seconds": 145.02,
      "duration_seconds": 1.59,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 145.68,
      "end_seconds": 153.71,
      "duration_seconds": 8.03,
      "text": "Hold on, doctor, I think she reacted to diclofenac once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.33,
      "end_seconds": 158.64,
      "duration_seconds": 3.31,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.37,
      "end_seconds": 167.73,
      "duration_seconds": 7.36,
      "text": "Alright, so that's unclear. I'll record what each of you said. Alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.8,
      "end_seconds": 178.79,
      "duration_seconds": 9.99,
      "text": "I had an operation for a hernia last spring. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.78,
      "end_seconds": 184.96,
      "duration_seconds": 5.18,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.04,
      "end_seconds": 207.9,
      "duration_seconds": 20.86,
      "text": "I have about eight cigarettes in a day. I'll have a glass of wine with dinner. I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.03,
      "end_seconds": 212.42,
      "duration_seconds": 3.39,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.63,
      "end_seconds": 221.18,
      "duration_seconds": 7.55,
      "text": "I've had high blood pressure for two years now. Depression, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.1,
      "end_seconds": 231.74,
      "duration_seconds": 8.64,
      "text": "Okay, I can see depression in your file as well. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.11,
      "end_seconds": 237.82,
      "duration_seconds": 4.71,
      "text": "Ah, it's hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 238.46,
      "end_seconds": 247.64,
      "duration_seconds": 9.18,
      "text": "Hmm, you know, it's meant to be every morning, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.2,
      "end_seconds": 253.07,
      "duration_seconds": 4.87,
      "text": "Actually, I take mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.35,
      "end_seconds": 256.79,
      "duration_seconds": 2.44,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.07,
      "end_seconds": 263.48,
      "duration_seconds": 2.41,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.09,
      "end_seconds": 269.0,
      "duration_seconds": 3.91,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.86,
      "end_seconds": 272.45,
      "duration_seconds": 2.59,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.71,
      "end_seconds": 286.33,
      "duration_seconds": 4.62,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.37,
      "end_seconds": 290.07,
      "duration_seconds": 1.7,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.9,
      "end_seconds": 318.55,
      "duration_seconds": 14.65,
      "text": "Taking everything into account, it fits best with a possible first seizure. I want to be honest that this is an impression, not a final answer. We shouldn't forget a faint with some jerking."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.48,
      "end_seconds": 322.51,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.13,
      "end_seconds": 353.32,
      "duration_seconds": 30.19,
      "text": "It's reasonable to be concerned, but right now a possible first seizure is my leading thought, not anything worse. I'll request an EEG, it'll help with possible seizure. I'll request a brain scan, it'll help with possible seizure. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. I'm going to send a referral to the epilepsy clinic. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.28,
      "end_seconds": 358.18,
      "duration_seconds": 3.9,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.33,
      "end_seconds": 364.92,
      "duration_seconds": 5.59,
      "text": "I mean, uh, great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.47,
      "end_seconds": 366.79,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
}