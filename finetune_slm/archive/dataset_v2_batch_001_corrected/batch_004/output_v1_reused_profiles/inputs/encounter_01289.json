{
  "schema_version": "1.0",
  "encounter_id": "01289",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.05,
      "duration_seconds": 3.3,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.06,
      "end_seconds": 9.94,
      "duration_seconds": 4.88,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 16.17,
      "duration_seconds": 4.33,
      "text": "So the thing is, I've got irregular periods."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.92,
      "end_seconds": 20.8,
      "duration_seconds": 2.88,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.82,
      "end_seconds": 24.24,
      "duration_seconds": 2.42,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.97,
      "end_seconds": 29.17,
      "duration_seconds": 3.2,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.23,
      "end_seconds": 40.54,
      "duration_seconds": 9.31,
      "text": "Sorry, what was I saying, it's been nearly five years now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.06,
      "end_seconds": 46.58,
      "duration_seconds": 4.52,
      "text": "Any headaches with vision changes, breast discharge or hot flushes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.56,
      "end_seconds": 55.13,
      "duration_seconds": 6.57,
      "text": "No, uh, no headaches with vision changes, breast discharge or hot flushes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.73,
      "end_seconds": 59.54,
      "duration_seconds": 3.81,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.6,
      "end_seconds": 65.96,
      "duration_seconds": 2.36,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.88,
      "end_seconds": 70.65,
      "duration_seconds": 2.77,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.09,
      "end_seconds": 83.55,
      "duration_seconds": 11.46,
      "text": "I live with my elderly mother. Lots of rice, lentils and some fruit. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.83,
      "end_seconds": 101.08,
      "duration_seconds": 3.25,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.14,
      "end_seconds": 105.06,
      "duration_seconds": 2.92,
      "text": "Not really, you know, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.14,
      "end_seconds": 114.17,
      "duration_seconds": 7.03,
      "text": "Before we go further, any allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.79,
      "end_seconds": 118.83,
      "duration_seconds": 3.04,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.69,
      "end_seconds": 139.19,
      "duration_seconds": 3.5,
      "text": "Alright, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.56,
      "end_seconds": 149.83,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.79,
      "end_seconds": 184.16,
      "duration_seconds": 13.37,
      "text": "Okay: temperature 36.5, height 170 centimetres. And respiratory rate 15, BMI works out to 31.8, heart rate 71, weight 92 kilos, pressure 109 over 77."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.51,
      "end_seconds": 192.49,
      "duration_seconds": 5.98,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.96,
      "end_seconds": 200.94,
      "duration_seconds": 0.98,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.34,
      "end_seconds": 204.71,
      "duration_seconds": 2.37,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.45,
      "end_seconds": 226.93,
      "duration_seconds": 8.48,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.16,
      "end_seconds": 233.01,
      "duration_seconds": 1.85,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.53,
      "end_seconds": 256.51,
      "duration_seconds": 13.98,
      "text": "Let me tell you where I've got to. It points towards a pattern that fits polycystic ovary syndrome. A pelvic ultrasound is what I'd like next, for irregular periods."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 257.05,
      "end_seconds": 259.34,
      "duration_seconds": 2.29,
      "text": "The earliest is Monday, 9 am."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.22,
      "end_seconds": 272.83,
      "duration_seconds": 11.61,
      "text": "I'm going to put you on metformin, 500 milligrams, once a day with food, for three months. It's for cycle regulation and weight."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.13,
      "end_seconds": 282.97,
      "duration_seconds": 3.84,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.24,
      "end_seconds": 295.78,
      "duration_seconds": 8.54,
      "text": "Regular exercise and a small weight loss can make cycles more regular. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.22,
      "end_seconds": 300.8,
      "duration_seconds": 3.58,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}