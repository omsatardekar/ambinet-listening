{
  "schema_version": "1.0",
  "encounter_id": "01152",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 6.67,
      "duration_seconds": 5.78,
      "text": "Doctor, hi, where would you like me to to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 12.63,
      "duration_seconds": 3.99,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.45,
      "end_seconds": 20.38,
      "duration_seconds": 5.93,
      "text": "good afternoon, doctor i look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.32,
      "end_seconds": 25.93,
      "duration_seconds": 4.61,
      "text": "Okay, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.48,
      "end_seconds": 30.58,
      "duration_seconds": 4.1,
      "text": "I'm here because of spots on my back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.08,
      "end_seconds": 34.48,
      "duration_seconds": 3.4,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.42,
      "end_seconds": 43.14,
      "duration_seconds": 7.72,
      "text": "He takes escitalopram, 10 milligrams, once a day. It's face wash, twice a day, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.74,
      "end_seconds": 46.47,
      "duration_seconds": 2.73,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.16,
      "end_seconds": 50.05,
      "duration_seconds": 1.89,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.8,
      "end_seconds": 53.46,
      "duration_seconds": 2.66,
      "text": "So, did it come on recently?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.18,
      "end_seconds": 60.51,
      "duration_seconds": 2.33,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.78,
      "end_seconds": 65.93,
      "duration_seconds": 5.15,
      "text": "Right, right. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.86,
      "end_seconds": 69.54,
      "duration_seconds": 1.68,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.4,
      "end_seconds": 75.42,
      "duration_seconds": 5.02,
      "text": "What about marks left after the spots, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.52,
      "end_seconds": 84.14,
      "duration_seconds": 7.62,
      "text": "Yes, actually. Hmm, I've also had sore red lumps, for about three months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.74,
      "end_seconds": 91.86,
      "duration_seconds": 6.12,
      "text": "Have you had spots on your back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.51,
      "end_seconds": 99.18,
      "duration_seconds": 6.67,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.31,
      "end_seconds": 105.0,
      "duration_seconds": 4.69,
      "text": "Did you get being pregnant, excess hair growth or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 112.99,
      "duration_seconds": 6.52,
      "text": "Okay, so I haven't had being pregnant, excess hair growth or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 117.26,
      "duration_seconds": 3.76,
      "text": "Yes, carry on. And headaches, any of that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.81,
      "end_seconds": 120.63,
      "duration_seconds": 2.82,
      "text": "I haven't noticed any headaches."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 125.14,
      "duration_seconds": 3.24,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.55,
      "end_seconds": 128.65,
      "duration_seconds": 2.1,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.73,
      "end_seconds": 133.81,
      "duration_seconds": 3.08,
      "text": "right, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.61,
      "end_seconds": 140.5,
      "duration_seconds": 2.89,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.69,
      "end_seconds": 144.65,
      "duration_seconds": 2.96,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 158.93,
      "duration_seconds": 13.09,
      "text": "Ah, yes, I had part of my thyroid removed, years back. It's the not knowing that gets to me. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.74,
      "end_seconds": 171.95,
      "duration_seconds": 3.21,
      "text": "Okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.25,
      "end_seconds": 177.21,
      "duration_seconds": 3.96,
      "text": "I have anxiety, for nearly five years"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.78,
      "end_seconds": 181.11,
      "duration_seconds": 2.33,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.77,
      "end_seconds": 191.3,
      "duration_seconds": 4.53,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.97,
      "end_seconds": 195.16,
      "duration_seconds": 2.19,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.31,
      "end_seconds": 200.91,
      "duration_seconds": 4.6,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.8,
      "end_seconds": 222.39,
      "duration_seconds": 2.59,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.96,
      "end_seconds": 234.77,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.08,
      "end_seconds": 258.7,
      "duration_seconds": 9.62,
      "text": "Okay: temp 36.4 degrees, respiratory rate 18, saturation 98 percent, blood pressure 118 over 71, pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.33,
      "end_seconds": 263.79,
      "duration_seconds": 3.46,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.94,
      "end_seconds": 266.94,
      "duration_seconds": 2.0,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.31,
      "end_seconds": 281.4,
      "duration_seconds": 7.09,
      "text": "There are red inflamed lumps and blackheads over both cheeks and the forehead, and a few scars."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.92,
      "end_seconds": 287.38,
      "duration_seconds": 2.46,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.29,
      "end_seconds": 318.63,
      "duration_seconds": 20.34,
      "text": "So where does that leave us? This looks most like moderate inflammatory acne. I can't rule out rosacea yet. I'm going to put you on adapalene gel, 0.1 percent, once a night, for twelve weeks. That's for acne. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.52,
      "end_seconds": 322.75,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    }
  ]
}