{
  "schema_version": "1.0",
  "encounter_id": "01116",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 6.91,
      "duration_seconds": 5.56,
      "text": "Sorry, what was I saying, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.33,
      "end_seconds": 15.71,
      "duration_seconds": 4.38,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.71,
      "end_seconds": 29.48,
      "duration_seconds": 12.77,
      "text": "Okay, so doctor, it's an itch down below. It's getting on my nerves now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.41,
      "end_seconds": 36.15,
      "duration_seconds": 4.74,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.15,
      "end_seconds": 50.6,
      "duration_seconds": 2.45,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.45,
      "end_seconds": 76.09,
      "duration_seconds": 7.64,
      "text": "Okay: pulse 66, respiratory rate 18, temperature is 36.7 degrees. And blood pressure 124 over 70."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.98,
      "end_seconds": 98.36,
      "duration_seconds": 3.38,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.41,
      "end_seconds": 103.73,
      "duration_seconds": 3.32,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.74,
      "end_seconds": 108.14,
      "duration_seconds": 2.4,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.67,
      "end_seconds": 112.12,
      "duration_seconds": 3.45,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 118.72,
      "duration_seconds": 5.79,
      "text": "Let me check a few things. Any bleeding between periods or being pregnant?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.51,
      "end_seconds": 127.09,
      "duration_seconds": 6.58,
      "text": "Sorry, uh, what was I saying, no, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.99,
      "end_seconds": 131.54,
      "duration_seconds": 3.55,
      "text": "Alright, and what about smell or new partner?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.42,
      "end_seconds": 138.71,
      "duration_seconds": 6.29,
      "text": "Sorry, what was I saying, no smell or new partner, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.27,
      "end_seconds": 143.19,
      "duration_seconds": 2.92,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.13,
      "end_seconds": 145.77,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 160.43,
      "duration_seconds": 3.13,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.03,
      "end_seconds": 165.16,
      "duration_seconds": 3.13,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.59,
      "end_seconds": 169.48,
      "duration_seconds": 2.89,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.42,
      "end_seconds": 171.44,
      "duration_seconds": 1.02,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.11,
      "end_seconds": 175.26,
      "duration_seconds": 2.15,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.99,
      "end_seconds": 179.75,
      "duration_seconds": 3.76,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.3,
      "end_seconds": 183.1,
      "duration_seconds": 2.8,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.91,
      "end_seconds": 191.73,
      "duration_seconds": 3.82,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.88,
      "end_seconds": 207.69,
      "duration_seconds": 3.81,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.4,
      "end_seconds": 211.6,
      "duration_seconds": 3.2,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.21,
      "end_seconds": 217.69,
      "duration_seconds": 4.48,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.63,
      "end_seconds": 221.17,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.78,
      "end_seconds": 226.21,
      "duration_seconds": 3.43,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.48,
      "end_seconds": 242.22,
      "duration_seconds": 6.74,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.84,
      "end_seconds": 248.56,
      "duration_seconds": 1.72,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.41,
      "end_seconds": 272.04,
      "duration_seconds": 5.63,
      "text": "So where does that leave us? My working impression is vaginal thrush."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.72,
      "end_seconds": 276.01,
      "duration_seconds": 3.29,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.04,
      "end_seconds": 301.69,
      "duration_seconds": 24.65,
      "text": "Nothing I've seen today points to an emergency. It looks like vaginal thrush, but I'd like to confirm. I'm going to order a swab, for vaginal discharge. That will help us see what's going on underneath and decide the next step. For this, fluconazole, 150 milligrams, once, for one day. That's for thrush."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.06,
      "end_seconds": 306.67,
      "duration_seconds": 3.61,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.59,
      "end_seconds": 312.14,
      "duration_seconds": 3.55,
      "text": "Wear cotton underwear and avoid scented soaps or washes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.36,
      "end_seconds": 319.45,
      "duration_seconds": 7.09,
      "text": "Ah. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.32,
      "end_seconds": 324.83,
      "duration_seconds": 3.51,
      "text": "Let me think, that's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.51,
      "end_seconds": 328.09,
      "duration_seconds": 2.58,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.63,
      "end_seconds": 331.48,
      "duration_seconds": 2.85,
      "text": "I think I understand everything. Thanks."
    }
  ]
}