{
  "schema_version": "1.0",
  "encounter_id": "01163",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 3.59,
      "duration_seconds": 2.93,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.5,
      "end_seconds": 9.01,
      "duration_seconds": 3.51,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.9,
      "end_seconds": 14.56,
      "duration_seconds": 4.66,
      "text": "Actually, I'm here cos of a high reading at home."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.63,
      "end_seconds": 20.56,
      "duration_seconds": 3.93,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.23,
      "end_seconds": 25.37,
      "duration_seconds": 3.14,
      "text": "Valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.8,
      "end_seconds": 28.2,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.49,
      "end_seconds": 45.04,
      "duration_seconds": 13.55,
      "text": "About... well, six months. Oh, um, and headaches in the mornings. About headaches in the mornings, mild, really. Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.82,
      "end_seconds": 63.41,
      "duration_seconds": 2.59,
      "text": "Alright, any nosebleeds, breathlessness or weakness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.43,
      "end_seconds": 67.02,
      "duration_seconds": 2.59,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.67,
      "end_seconds": 71.8,
      "duration_seconds": 4.13,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.21,
      "end_seconds": 75.19,
      "duration_seconds": 1.98,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.31,
      "end_seconds": 78.68,
      "duration_seconds": 2.37,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.69,
      "end_seconds": 81.88,
      "duration_seconds": 2.19,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.74,
      "end_seconds": 86.35,
      "duration_seconds": 2.61,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.14,
      "end_seconds": 94.55,
      "duration_seconds": 6.41,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.81,
      "end_seconds": 98.73,
      "duration_seconds": 2.92,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.2,
      "end_seconds": 104.08,
      "duration_seconds": 2.88,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.69,
      "end_seconds": 108.77,
      "duration_seconds": 4.08,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.34,
      "end_seconds": 128.51,
      "duration_seconds": 18.17,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. My husband and I live above the shop. I swim twice a week. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.73,
      "end_seconds": 145.45,
      "duration_seconds": 3.72,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.36,
      "end_seconds": 150.34,
      "duration_seconds": 2.98,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.1,
      "end_seconds": 154.89,
      "duration_seconds": 3.79,
      "text": "Right, right. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.02,
      "end_seconds": 168.97,
      "duration_seconds": 2.95,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.7,
      "end_seconds": 191.62,
      "duration_seconds": 7.92,
      "text": "Okay: saturation 97 percent, temperature 36.7, pulse is 75 beats a minute. And pressure 171 over 103."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.1,
      "end_seconds": 197.62,
      "duration_seconds": 3.52,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.2,
      "end_seconds": 200.47,
      "duration_seconds": 1.27,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.06,
      "end_seconds": 217.63,
      "duration_seconds": 1.57,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.87,
      "end_seconds": 220.86,
      "duration_seconds": 1.99,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.33,
      "end_seconds": 241.65,
      "duration_seconds": 3.32,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.38,
      "end_seconds": 249.31,
      "duration_seconds": 1.93,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.62,
      "end_seconds": 273.57,
      "duration_seconds": 6.95,
      "text": "Okay, so my impression is this: It points towards hypertension that isn't well controlled."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 291.0,
      "duration_seconds": 5.03,
      "text": "A urine test for protein is what I'd like next, for hypertension."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.81,
      "end_seconds": 293.44,
      "duration_seconds": 1.63,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.38,
      "end_seconds": 301.83,
      "duration_seconds": 7.45,
      "text": "The treatment will be amlodipine, 5 milligrams, once a day, long term. It's for high blood pressure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.36,
      "end_seconds": 307.63,
      "duration_seconds": 4.27,
      "text": "Oh, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.1,
      "end_seconds": 320.74,
      "duration_seconds": 11.64,
      "text": "Check the blood pressure at home, same time each morning, and write down the numbers for me. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.22,
      "end_seconds": 327.16,
      "duration_seconds": 2.94,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.81,
      "end_seconds": 332.12,
      "duration_seconds": 1.31,
      "text": "see you soon"
    }
  ]
}