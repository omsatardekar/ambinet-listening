  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 5.11,
      "duration_seconds": 4.4,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.32,
      "duration_seconds": 4.32,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.97,
      "end_seconds": 19.43,
      "duration_seconds": 4.46,
      "text": "Um, so... yellow eyes. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.01,
      "end_seconds": 23.44,
      "duration_seconds": 3.43,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.86,
      "end_seconds": 26.69,
      "duration_seconds": 1.83,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.0,
      "end_seconds": 30.38,
      "duration_seconds": 2.38,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.32,
      "end_seconds": 38.15,
      "duration_seconds": 5.83,
      "text": "Itching all over goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.09,
      "end_seconds": 49.7,
      "duration_seconds": 2.61,
      "text": "Did you notice any vomiting blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.8,
      "end_seconds": 57.17,
      "duration_seconds": 3.37,
      "text": "Not at all, no vomiting blood."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.18,
      "end_seconds": 62.28,
      "duration_seconds": 4.1,
      "text": "have you had any weight loss, confusion or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.69,
      "end_seconds": 68.23,
      "duration_seconds": 4.54,
      "text": "no weight loss, confusion or fever, none of it"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.65,
      "end_seconds": 72.13,
      "duration_seconds": 2.48,
      "text": "alright, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.45,
      "end_seconds": 74.49,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.69,
      "end_seconds": 78.11,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.74,
      "end_seconds": 80.92,
      "duration_seconds": 1.18,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.93,
      "end_seconds": 94.46,
      "duration_seconds": 4.53,
      "text": "okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.51,
      "end_seconds": 98.43,
      "duration_seconds": 2.92,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.85,
      "end_seconds": 101.1,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.83,
      "end_seconds": 108.2,
      "duration_seconds": 3.37,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.4,
      "end_seconds": 115.74,
      "duration_seconds": 2.34,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.55,
      "end_seconds": 120.77,
      "duration_seconds": 4.22,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.46,
      "end_seconds": 124.55,
      "duration_seconds": 2.09,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.4,
      "end_seconds": 130.35,
      "duration_seconds": 4.95,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.39,
      "end_seconds": 148.21,
      "duration_seconds": 3.82,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.21,
      "end_seconds": 152.3,
      "duration_seconds": 3.09,
      "text": "yes, I'm allergic to to walnuts"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.55,
      "end_seconds": 163.21,
      "duration_seconds": 3.66,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.23,
      "end_seconds": 173.92,
      "duration_seconds": 2.69,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.61,
      "end_seconds": 200.6,
      "duration_seconds": 5.99,
      "text": "Okay: pulse is 85 beats a minute, pressure 127 over 80, temperature 36.4."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.59,
      "end_seconds": 206.43,
      "duration_seconds": 3.84,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.93,
      "end_seconds": 208.54,
      "duration_seconds": 1.61,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.04,
      "end_seconds": 212.28,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.79,
      "end_seconds": 225.96,
      "duration_seconds": 3.17,
      "text": "the whites of your eyes are yellow"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.32,
      "end_seconds": 228.59,
      "duration_seconds": 1.27,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.14,
      "end_seconds": 247.95,
      "duration_seconds": 3.81,
      "text": "Liver edge is just palpable and mildly tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.73,
      "end_seconds": 262.03,
      "duration_seconds": 10.3,
      "text": "All finished, thank you. From what you've told me and what I found, this is probably jaundice with a cause we still need to find."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.72,
      "end_seconds": 266.74,
      "duration_seconds": 3.02,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.89,
      "end_seconds": 299.48,
      "duration_seconds": 31.59,
      "text": "I understand the worry. At the moment I'd say it's jaundice with a cause we still need to find, and we'll know more once the an ultrasound of the abdomen is back. I'll request an ultrasound of the abdomen, it'll help with jaundice. Please avoid alcohol completely and don't take any painkillers except paracetamol, and not much of that. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.1,
      "end_seconds": 316.6,
      "duration_seconds": 15.5,
      "text": "A A liver specialist would be the right next step, I'll refer you. Please don't wait if you vomit blood or become drowsy or confused. That's when to be seen urgently. Come back in three days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.71,
      "end_seconds": 319.71,
      "duration_seconds": 2.0,
      "text": "alright, I'll be back"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.83,
      "end_seconds": 323.96,
      "duration_seconds": 3.13,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.02,
      "end_seconds": 331.12,
      "duration_seconds": 5.1,
      "text": "Right, um, I'll do that. Thank you, doctor."
    }
  ]
}