{
  "schema_version": "1.0",
  "encounter_id": "01063",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 4.89,
      "duration_seconds": 3.5,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.93,
      "end_seconds": 9.05,
      "duration_seconds": 2.12,
      "text": "Evening, um, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.88,
      "end_seconds": 13.64,
      "duration_seconds": 2.76,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.94,
      "end_seconds": 22.59,
      "duration_seconds": 5.65,
      "text": "I mean, so the thing is, I've got hot flushes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.36,
      "end_seconds": 32.11,
      "duration_seconds": 3.75,
      "text": "how long has it it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.93,
      "end_seconds": 42.53,
      "duration_seconds": 9.6,
      "text": "right, um, it's been two years now i kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.78,
      "end_seconds": 52.83,
      "duration_seconds": 9.05,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.46,
      "end_seconds": 68.78,
      "duration_seconds": 15.32,
      "text": "it settles a little with a fan i notice it more with warm rooms i did have night sweats at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.46,
      "end_seconds": 73.64,
      "duration_seconds": 4.18,
      "text": "Right, any heavy bleeding, palpitations or breast lumps at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 81.18,
      "duration_seconds": 6.25,
      "text": "I haven't had heavy bleeding, palpitations or breast lumps, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.8,
      "end_seconds": 85.81,
      "duration_seconds": 4.01,
      "text": "Have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.17,
      "end_seconds": 89.62,
      "duration_seconds": 2.45,
      "text": "nope, no weight loss"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.39,
      "end_seconds": 93.6,
      "duration_seconds": 3.21,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.95,
      "end_seconds": 96.57,
      "duration_seconds": 1.62,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.23,
      "end_seconds": 101.56,
      "duration_seconds": 4.33,
      "text": "Any pins and and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.55,
      "end_seconds": 104.64,
      "duration_seconds": 2.09,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.64,
      "end_seconds": 109.88,
      "duration_seconds": 4.24,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.86,
      "end_seconds": 115.38,
      "duration_seconds": 3.52,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.5,
      "end_seconds": 133.85,
      "duration_seconds": 2.35,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.31,
      "end_seconds": 145.16,
      "duration_seconds": 4.85,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.39,
      "end_seconds": 152.4,
      "duration_seconds": 2.01,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.15,
      "end_seconds": 158.87,
      "duration_seconds": 4.72,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.26,
      "end_seconds": 162.32,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.15,
      "end_seconds": 169.36,
      "duration_seconds": 6.21,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.42,
      "end_seconds": 174.42,
      "duration_seconds": 3.0,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.2,
      "end_seconds": 177.34,
      "duration_seconds": 2.14,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.58,
      "end_seconds": 187.96,
      "duration_seconds": 9.38,
      "text": "Mm, okay. Right, so thin bones is already on your record. We'll keep that in mind today. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.81,
      "end_seconds": 193.78,
      "duration_seconds": 4.97,
      "text": "I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.29,
      "end_seconds": 199.36,
      "duration_seconds": 4.07,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.16,
      "end_seconds": 203.34,
      "duration_seconds": 2.18,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.22,
      "end_seconds": 215.73,
      "duration_seconds": 3.51,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.04,
      "end_seconds": 229.63,
      "duration_seconds": 2.59,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.79,
      "end_seconds": 257.44,
      "duration_seconds": 7.65,
      "text": "okay: blood pressure 116 over 77, pulse 76. And temperature is 36.9 degrees, oxygen saturation is 99 percent"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.72,
      "end_seconds": 260.37,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.37,
      "end_seconds": 264.74,
      "duration_seconds": 2.37,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.56,
      "end_seconds": 271.55,
      "duration_seconds": 4.99,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.66,
      "end_seconds": 274.67,
      "duration_seconds": 2.01,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.66,
      "end_seconds": 295.27,
      "duration_seconds": 6.61,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.34,
      "end_seconds": 300.72,
      "duration_seconds": 2.38,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.67,
      "end_seconds": 323.79,
      "duration_seconds": 15.12,
      "text": "Okay, so my impression is this: This looks most like perimenopausal symptoms. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.28,
      "end_seconds": 328.93,
      "duration_seconds": 3.65,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}