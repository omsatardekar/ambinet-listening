      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.24,
      "end_seconds": 385.92,
      "duration_seconds": 17.68,
      "text": "okay, thinking it through, I can't pin this down yet we're looking at chronic pelvic pain, possibly endometriosis or an ovarian cyst just to be sure I understood you've had pain during sex, and no bleeding between periods or burning when passing urine"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.0,
      "end_seconds": 389.91,
      "duration_seconds": 1.91,
      "text": "yes, you've got it"
