    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.57,
      "end_seconds": 399.74,
      "duration_seconds": 8.17,
      "text": "We should do a swab test for pelvic pain. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.58,
      "end_seconds": 404.33,
      "duration_seconds": 2.75,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.02,
      "end_seconds": 420.25,
      "duration_seconds": 14.23,
      "text": "I'll request a pelvic ultrasound, it'll help with pelvic pain. We should do a pregnancy test for pelvic pain. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.01,
      "end_seconds": 423.56,
      "duration_seconds": 2.55,
      "text": "How long will it take?"
    },
