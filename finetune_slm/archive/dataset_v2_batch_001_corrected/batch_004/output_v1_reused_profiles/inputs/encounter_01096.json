      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.1,
      "end_seconds": 358.91,
      "duration_seconds": 3.81,
      "text": "just part of my thyroid removed, years back"
