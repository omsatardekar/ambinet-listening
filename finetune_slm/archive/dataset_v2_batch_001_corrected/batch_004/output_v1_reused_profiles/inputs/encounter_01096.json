      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.44,
      "end_seconds": 440.21,
      "duration_seconds": 14.77,
      "text": "A heat pad and some gentle movement help many people, and a pain diary helps me see a pattern. Let's get you seen by a gynaecologist, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.75,
      "end_seconds": 442.44,
      "duration_seconds": 1.69,
      "text": "alright, thank you"
