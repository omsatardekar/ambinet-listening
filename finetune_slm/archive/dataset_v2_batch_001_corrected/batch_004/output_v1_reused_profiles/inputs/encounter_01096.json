    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.23,
      "end_seconds": 449.28,
      "duration_seconds": 5.05,
      "text": "Let's review you in four weeks. Does all of that make sense?"
