{
  "schema_version": "1.0",
  "encounter_id": "01243",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 5.89,
      "duration_seconds": 4.64,
      "text": "Evening. Let's get started. So what can I do for you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.97,
      "end_seconds": 11.78,
      "duration_seconds": 2.81,
      "text": "Well, I've been having heartburn."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.52,
      "end_seconds": 18.62,
      "duration_seconds": 3.1,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.34,
      "end_seconds": 24.57,
      "duration_seconds": 4.23,
      "text": "Ah, it's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.75,
      "end_seconds": 31.37,
      "duration_seconds": 5.62,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.46,
      "end_seconds": 41.26,
      "duration_seconds": 8.8,
      "text": "I, I'd say a couple of times a week. I get some relief from antacids."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.39,
      "end_seconds": 51.34,
      "duration_seconds": 4.95,
      "text": "What about a lump feeling in the throat, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.46,
      "end_seconds": 61.07,
      "duration_seconds": 8.61,
      "text": "Yeah, that too. I had a cough at night before. That's settled now, um, though."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.65,
      "end_seconds": 68.74,
      "duration_seconds": 6.09,
      "text": "Have you had any pain on exertion, weight loss, trouble swallowing or black stools?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.6,
      "end_seconds": 79.77,
      "duration_seconds": 10.17,
      "text": "Sorry, what was I saying, no pain on exertion, weight loss, trouble swallowing or black stools, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.75,
      "end_seconds": 84.82,
      "duration_seconds": 4.07,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.16,
      "end_seconds": 90.9,
      "duration_seconds": 2.74,
      "text": "Erm, no, that's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.86,
      "end_seconds": 95.65,
      "duration_seconds": 2.79,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.54,
      "end_seconds": 98.72,
      "duration_seconds": 1.18,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.16,
      "end_seconds": 104.0,
      "duration_seconds": 3.84,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.05,
      "end_seconds": 107.26,
      "duration_seconds": 2.21,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.83,
      "end_seconds": 110.14,
      "duration_seconds": 1.31,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.95,
      "end_seconds": 122.03,
      "duration_seconds": 10.08,
      "text": "I've got acid reflux. Erm, I have asthma, for about a year. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.0,
      "end_seconds": 131.94,
      "duration_seconds": 7.94,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.88,
      "end_seconds": 138.49,
      "duration_seconds": 5.61,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.51,
      "end_seconds": 160.0,
      "duration_seconds": 3.49,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.65,
      "end_seconds": 168.69,
      "duration_seconds": 8.04,
      "text": "Um, um, not currently, but as a youngster naproxen gave me stomach pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.53,
      "end_seconds": 171.44,
      "duration_seconds": 1.91,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.03,
      "end_seconds": 176.48,
      "duration_seconds": 4.45,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.83,
      "end_seconds": 179.78,
      "duration_seconds": 1.95,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.41,
      "end_seconds": 184.41,
      "duration_seconds": 3.0,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 190.61,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.24,
      "end_seconds": 195.27,
      "duration_seconds": 3.03,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.2,
      "end_seconds": 215.3,
      "duration_seconds": 2.1,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.37,
      "end_seconds": 227.24,
      "duration_seconds": 10.87,
      "text": "I'm on lisinopril, 10 milligrams, once a day. I'm on Asthalin inhaler, when needed. I take Digene, when it burns."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 238.71,
      "end_seconds": 251.25,
      "duration_seconds": 12.54,
      "text": "Okay, so the vitals from earlier. Blood pressure 118 over 72, respiratory rate 14, temperature is 37.0 degrees. Pulse is 72 beats a minute, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.01,
      "end_seconds": 253.71,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.96,
      "end_seconds": 259.35,
      "duration_seconds": 3.39,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.23,
      "end_seconds": 263.16,
      "duration_seconds": 1.93,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.76,
      "end_seconds": 275.1,
      "duration_seconds": 2.34,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.81,
      "end_seconds": 286.42,
      "duration_seconds": 5.61,
      "text": "You can sit up now. Having listened and examined, I'd lean towards gastro-oesophageal reflux."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.01,
      "end_seconds": 291.32,
      "duration_seconds": 3.31,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.29,
      "end_seconds": 308.82,
      "duration_seconds": 15.53,
      "text": "I understand the worry. At the moment I'd say it's gastro-oesophageal reflux, and we'll know more once the an upper endoscopy is back. I'll request an upper endoscopy, it'll help with persistent reflux."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 309.57,
      "end_seconds": 313.29,
      "duration_seconds": 3.72,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.44,
      "end_seconds": 336.13,
      "duration_seconds": 21.69,
      "text": "Good, thanks for doing that. I'm going to put you on esomeprazole, 40 milligrams, before breakfast, for eight weeks. You take it by mouth. It's for reflux. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. I'll want another look in six weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.52,
      "end_seconds": 340.92,
      "duration_seconds": 3.4,
      "text": "Uh, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.49,
      "end_seconds": 347.33,
      "duration_seconds": 4.84,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.59,
      "end_seconds": 352.5,
      "duration_seconds": 3.91,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}