{
  "schema_version": "1.0",
  "encounter_id": "01469",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.83,
      "duration_seconds": 4.85,
      "text": "Okay, so hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.58,
      "end_seconds": 15.74,
      "duration_seconds": 5.16,
      "text": "So, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.68,
      "end_seconds": 25.49,
      "duration_seconds": 7.81,
      "text": "Um, so... sharp pain in the left chest when I breathe in. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.27,
      "end_seconds": 30.49,
      "duration_seconds": 3.22,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.03,
      "end_seconds": 44.35,
      "duration_seconds": 10.32,
      "text": "Four weeks, I think... sorry, about a week, I got that wrong. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.25,
      "end_seconds": 46.95,
      "duration_seconds": 1.7,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.71,
      "end_seconds": 52.1,
      "duration_seconds": 4.39,
      "text": "Yes, um, deep breaths. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.56,
      "end_seconds": 55.74,
      "duration_seconds": 2.18,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.77,
      "end_seconds": 62.58,
      "duration_seconds": 4.81,
      "text": "Um, I'm on ibuprofen, 400 milligrams, when it hurts."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.8,
      "end_seconds": 72.66,
      "duration_seconds": 8.86,
      "text": "Do you have any medical conditions I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.17,
      "end_seconds": 77.26,
      "duration_seconds": 4.09,
      "text": "Mm, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.19,
      "end_seconds": 81.05,
      "duration_seconds": 1.86,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.08,
      "end_seconds": 89.18,
      "duration_seconds": 4.1,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.37,
      "end_seconds": 91.68,
      "duration_seconds": 1.31,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.2,
      "end_seconds": 96.74,
      "duration_seconds": 4.54,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.82,
      "end_seconds": 99.41,
      "duration_seconds": 1.59,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.33,
      "end_seconds": 104.94,
      "duration_seconds": 3.61,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.44,
      "end_seconds": 108.12,
      "duration_seconds": 1.68,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.11,
      "end_seconds": 112.43,
      "duration_seconds": 2.32,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.04,
      "end_seconds": 116.41,
      "duration_seconds": 3.37,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.09,
      "end_seconds": 121.85,
      "duration_seconds": 4.76,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.87,
      "end_seconds": 142.38,
      "duration_seconds": 4.51,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.44,
      "end_seconds": 151.31,
      "duration_seconds": 4.87,
      "text": "I'm allergic to grass pollen, I get itchy eyes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 157.77,
      "duration_seconds": 5.94,
      "text": "And what about coughing up blood, breathlessness at rest or injury to the chest?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.44,
      "end_seconds": 167.86,
      "duration_seconds": 9.42,
      "text": "Right, no coughing up blood, breathlessness at rest or injury to the chest, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.93,
      "end_seconds": 172.44,
      "duration_seconds": 3.51,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.99,
      "end_seconds": 178.09,
      "duration_seconds": 4.1,
      "text": "No, you know, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.65,
      "end_seconds": 196.95,
      "duration_seconds": 3.3,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.87,
      "end_seconds": 208.01,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.83,
      "end_seconds": 235.26,
      "duration_seconds": 8.43,
      "text": "Okay: temperature 37.0, SpO2 97 percent on room air, pressure 121 over 80, respiratory rate 17, pulse 74."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.89,
      "end_seconds": 237.26,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.36,
      "end_seconds": 242.31,
      "duration_seconds": 3.95,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.67,
      "end_seconds": 247.57,
      "duration_seconds": 3.9,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.72,
      "end_seconds": 249.81,
      "duration_seconds": 1.09,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.76,
      "end_seconds": 254.01,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.57,
      "end_seconds": 274.04,
      "duration_seconds": 4.47,
      "text": "I can hear a faint rub on the left side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.71,
      "end_seconds": 278.31,
      "duration_seconds": 1.6,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.0,
      "end_seconds": 311.62,
      "duration_seconds": 16.62,
      "text": "We should do an ECG for chest pain. Regular pain relief makes it easier to take deep breaths, which protects the lung. Do get help quickly if you become breathless or the pain changes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.54,
      "end_seconds": 318.91,
      "duration_seconds": 3.37,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.04,
      "end_seconds": 324.31,
      "duration_seconds": 4.27,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.16,
      "end_seconds": 328.67,
      "duration_seconds": 3.51,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.31,
      "end_seconds": 330.63,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}