{
  "schema_version": "1.0",
  "encounter_id": "01035",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.74,
      "duration_seconds": 3.97,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.51,
      "end_seconds": 11.01,
      "duration_seconds": 4.5,
      "text": "Okay, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.01,
      "end_seconds": 28.36,
      "duration_seconds": 15.35,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come. It's a cough that won't go away, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.43,
      "end_seconds": 33.84,
      "duration_seconds": 3.41,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.51,
      "end_seconds": 37.43,
      "duration_seconds": 2.92,
      "text": "Ever since... since last night, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.28,
      "end_seconds": 43.36,
      "duration_seconds": 2.08,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.15,
      "end_seconds": 68.28,
      "duration_seconds": 23.13,
      "text": "Honestly, a few times a day. I've been feeling washed out too, for three days. With feeling washed out, pretty moderate, if I'm being honest. I did have a tight chest in the morning at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.78,
      "end_seconds": 72.74,
      "duration_seconds": 2.96,
      "text": "Any leg swelling or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.41,
      "end_seconds": 79.48,
      "duration_seconds": 5.07,
      "text": "I haven't had leg swelling or weight loss, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.37,
      "end_seconds": 85.72,
      "duration_seconds": 5.35,
      "text": "Any fever, sharp chest pain, night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.94,
      "end_seconds": 92.83,
      "duration_seconds": 5.89,
      "text": "No, no fever, sharp chest pain, night sweats or coughing up blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.31,
      "end_seconds": 95.78,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.99,
      "end_seconds": 104.92,
      "duration_seconds": 2.93,
      "text": "Yeah, no, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 115.15,
      "duration_seconds": 4.93,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.17,
      "end_seconds": 126.18,
      "duration_seconds": 9.01,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.19,
      "end_seconds": 135.39,
      "duration_seconds": 1.2,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.05,
      "end_seconds": 139.3,
      "duration_seconds": 3.25,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.99,
      "end_seconds": 142.25,
      "duration_seconds": 2.26,
      "text": "Alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.19,
      "end_seconds": 146.75,
      "duration_seconds": 1.56,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.31,
      "end_seconds": 149.7,
      "duration_seconds": 2.39,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.43,
      "end_seconds": 154.7,
      "duration_seconds": 3.27,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.54,
      "end_seconds": 157.74,
      "duration_seconds": 2.2,
      "text": "Alright, have you retired yet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.68,
      "end_seconds": 164.78,
      "duration_seconds": 5.1,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.38,
      "end_seconds": 170.56,
      "duration_seconds": 4.18,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.31,
      "end_seconds": 177.8,
      "duration_seconds": 5.49,
      "text": "I have acid reflux. I have asthma, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.61,
      "end_seconds": 180.49,
      "duration_seconds": 0.88,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.49,
      "end_seconds": 200.87,
      "duration_seconds": 18.38,
      "text": "I have gout, for about a year. An enlarged prostate, for five years. I kept putting it off, which I know isn't sensible. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.73,
      "end_seconds": 205.2,
      "duration_seconds": 2.47,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.76,
      "end_seconds": 208.68,
      "duration_seconds": 2.92,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.27,
      "end_seconds": 213.64,
      "duration_seconds": 3.37,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.21,
      "end_seconds": 229.81,
      "duration_seconds": 14.6,
      "text": "Omeprazole. I take it 20 milligrams, once a day. Asthalin inhaler. I take it when needed. I take allopurinol, 100 milligrams, once a day for the gout. It's tamsulosin, at night."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.58,
      "end_seconds": 233.0,
      "duration_seconds": 2.42,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.09,
      "end_seconds": 239.32,
      "duration_seconds": 5.23,
      "text": "0.4 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.75,
      "end_seconds": 249.62,
      "duration_seconds": 3.87,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.41,
      "end_seconds": 255.86,
      "duration_seconds": 5.45,
      "text": "My father has Parkinson's disease. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.36,
      "end_seconds": 259.22,
      "duration_seconds": 2.86,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.13,
      "end_seconds": 272.43,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.16,
      "end_seconds": 298.84,
      "duration_seconds": 7.68,
      "text": "Okay: blood pressure 122 over 73, saturation 98 percent, respiratory rate 16, pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.24,
      "end_seconds": 304.95,
      "duration_seconds": 3.71,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.13,
      "end_seconds": 313.67,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.68,
      "end_seconds": 315.95,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.36,
      "end_seconds": 334.91,
      "duration_seconds": 4.55,
      "text": "The chest is clear and your oxygen level is normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.37,
      "end_seconds": 340.86,
      "duration_seconds": 2.49,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.45,
      "end_seconds": 369.43,
      "duration_seconds": 9.98,
      "text": "From what you've told me and what I found, this looks most like a lingering cough after a viral infection. We shouldn't forget cough-variant asthma."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.02,
      "end_seconds": 378.25,
      "duration_seconds": 3.23,
      "text": "Okay, so will it clear up?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.01,
      "end_seconds": 409.76,
      "duration_seconds": 30.75,
      "text": "I can't promise yet, but most people with a lingering cough after a viral infection do well once it's treated properly. We should do a chest X-ray for persistent cough. Let's get a breathing test, for breathlessness. I'd rather check than guess, and this is the quickest way to know more. Honey and lemon in warm water can ease it, and avoid smoky rooms. See me again in three weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.91,
      "end_seconds": 412.93,
      "duration_seconds": 2.02,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.57,
      "end_seconds": 420.51,
      "duration_seconds": 2.94,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.43,
      "end_seconds": 426.56,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}