{
  "schema_version": "1.0",
  "encounter_id": "01447",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.33,
      "duration_seconds": 4.47,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 11.16,
      "duration_seconds": 4.6,
      "text": "Of course, leave it it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.75,
      "end_seconds": 19.93,
      "duration_seconds": 8.18,
      "text": "well, I've been having a dry cough at night sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.54,
      "end_seconds": 24.48,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.31,
      "end_seconds": 34.8,
      "duration_seconds": 8.49,
      "text": "uh, for six months, I'd say. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.2,
      "end_seconds": 45.66,
      "duration_seconds": 10.46,
      "text": "I see, go ahead. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.04,
      "end_seconds": 51.79,
      "duration_seconds": 4.75,
      "text": "Warm drinks helps a bit. It's worse with laughing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.62,
      "end_seconds": 56.33,
      "duration_seconds": 3.71,
      "text": "any a runny nose in the mornings as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.52,
      "end_seconds": 60.0,
      "duration_seconds": 2.48,
      "text": "Yes, for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.06,
      "end_seconds": 63.69,
      "duration_seconds": 2.63,
      "text": "And what about fever or heartburn?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.41,
      "end_seconds": 69.99,
      "duration_seconds": 4.58,
      "text": "Ah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.54,
      "end_seconds": 75.48,
      "duration_seconds": 3.94,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.09,
      "end_seconds": 77.45,
      "duration_seconds": 1.36,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 87.32,
      "duration_seconds": 5.39,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.44,
      "end_seconds": 94.4,
      "duration_seconds": 5.96,
      "text": "not currently, uh, but as a youngster tramadol gave me vomiting"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.04,
      "end_seconds": 100.54,
      "duration_seconds": 4.5,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.1,
      "end_seconds": 104.53,
      "duration_seconds": 2.43,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.77,
      "end_seconds": 116.97,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.66,
      "end_seconds": 120.28,
      "duration_seconds": 1.62,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.22,
      "end_seconds": 122.51,
      "duration_seconds": 1.29,
      "text": "Alright, any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.88,
      "end_seconds": 127.5,
      "duration_seconds": 3.62,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.53,
      "end_seconds": 131.78,
      "duration_seconds": 3.25,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.53,
      "end_seconds": 136.94,
      "duration_seconds": 4.41,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.6,
      "end_seconds": 140.55,
      "duration_seconds": 1.95,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.44,
      "end_seconds": 147.28,
      "duration_seconds": 5.84,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.9,
      "end_seconds": 151.55,
      "duration_seconds": 2.65,
      "text": "So, do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.33,
      "end_seconds": 155.13,
      "duration_seconds": 2.8,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.17,
      "end_seconds": 160.81,
      "duration_seconds": 3.64,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.45,
      "end_seconds": 168.23,
      "duration_seconds": 5.78,
      "text": "I've got eczema. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.38,
      "end_seconds": 171.52,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.06,
      "end_seconds": 177.21,
      "duration_seconds": 5.15,
      "text": "Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.47,
      "end_seconds": 178.28,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.24,
      "end_seconds": 197.17,
      "duration_seconds": 2.93,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.1,
      "end_seconds": 209.93,
      "duration_seconds": 2.83,
      "text": "Nearly done with the the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.67,
      "end_seconds": 236.03,
      "duration_seconds": 9.36,
      "text": "Okay: heart rate 74, temperature is 36.8 degrees, respiratory rate 15. And oxygen saturation is 99 percent, pressure 118 over 68."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.43,
      "end_seconds": 240.82,
      "duration_seconds": 2.39,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.34,
      "end_seconds": 243.44,
      "duration_seconds": 1.1,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.97,
      "end_seconds": 246.82,
      "duration_seconds": 1.85,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.04,
      "end_seconds": 259.34,
      "duration_seconds": 4.3,
      "text": "a a faint wheeze when you breathe out forcefully"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.36,
      "end_seconds": 262.06,
      "duration_seconds": 1.7,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.53,
      "end_seconds": 269.18,
      "duration_seconds": 2.65,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.24,
      "end_seconds": 283.97,
      "duration_seconds": 4.73,
      "text": "Let's book a peak flow reading to look into chronic cough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 285.05,
      "end_seconds": 288.33,
      "duration_seconds": 3.28,
      "text": "The The earliest is Thursday, 10 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.45,
      "end_seconds": 290.47,
      "duration_seconds": 1.02,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.91,
      "end_seconds": 301.09,
      "duration_seconds": 9.18,
      "text": "The treatment will be salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. That's for cough and wheeze."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.9,
      "end_seconds": 303.59,
      "duration_seconds": 1.69,
      "text": "thank you, doctor"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.68,
      "end_seconds": 315.19,
      "duration_seconds": 9.51,
      "text": "try the inhaler before exercise and note whether the cough settles. Book a review in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.39,
      "end_seconds": 319.13,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.49,
      "end_seconds": 321.81,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}