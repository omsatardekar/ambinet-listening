    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.76,
      "end_seconds": 163.44,
      "duration_seconds": 4.68,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.96,
      "end_seconds": 166.94,
      "duration_seconds": 2.98,
      "text": "um, no, nothing at all"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.93,
      "end_seconds": 177.45,
      "duration_seconds": 2.52,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.75,
      "end_seconds": 200.29,
      "duration_seconds": 19.54,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I'm a hairdresser, on my feet all day. I do a yoga class on Thursdays. I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.23,
      "end_seconds": 204.84,
      "duration_seconds": 2.61,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.2,
      "end_seconds": 208.9,
      "duration_seconds": 2.7,
      "text": "no not that I know of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.54,
      "end_seconds": 214.44,
      "duration_seconds": 3.9,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.48,
      "end_seconds": 217.31,
      "duration_seconds": 1.83,
      "text": "Cetirizine when it flares"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.94,
      "end_seconds": 220.05,
      "duration_seconds": 2.11,
      "text": "how much do you take?"
