    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.12,
      "end_seconds": 246.33,
      "duration_seconds": 1.21,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.7,
      "end_seconds": 261.8,
      "duration_seconds": 2.1,
      "text": "chest is clear, no wheeze"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.73,
      "end_seconds": 276.72,
      "duration_seconds": 10.99,
      "text": "please sit back down right, here's what I'm thinking i don't have a clear answer today: allergic rhinitis is possible, and so is a viral cold"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.91,
      "end_seconds": 281.97,
      "duration_seconds": 3.06,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.34,
      "end_seconds": 309.96,
      "duration_seconds": 23.62,
      "text": "I understand the worry. At the moment I'd say it's allergic rhinitis, and we'll know more once the an allergy test is back. Let's get an allergy test, for allergic rhinitis. Let's use fluticasone nasal spray, 50 micrograms, one spray each side daily, for four weeks. It's for allergic rhinitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.88,
      "end_seconds": 317.41,
      "duration_seconds": 3.53,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.17,
      "end_seconds": 336.47,
      "duration_seconds": 18.3,
      "text": "keep the windows closed in the early morning and wash the bedsheets weekly in hot water one warning sign to remember: the symptoms get worse in that case don't wait i'd like to see you again in four weeks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.44,
      "end_seconds": 340.7,
      "duration_seconds": 3.26,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.52,
      "end_seconds": 346.63,
      "duration_seconds": 4.11,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
