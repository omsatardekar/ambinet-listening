      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.9,
      "end_seconds": 133.37,
      "duration_seconds": 5.47,
      "text": "A few quick ones: loss of smell, facial pain or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.18,
      "end_seconds": 140.54,
