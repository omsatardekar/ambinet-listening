      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.01,
      "end_seconds": 149.32,
      "duration_seconds": 4.31,
      "text": "no I haven't had any shortness of breath"
