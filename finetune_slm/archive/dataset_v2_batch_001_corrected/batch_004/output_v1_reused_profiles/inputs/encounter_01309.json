      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.86,
      "end_seconds": 221.9,
      "duration_seconds": 1.04,
      "text": "10 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.32,
      "end_seconds": 227.92,
      "duration_seconds": 3.6,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.08,
      "end_seconds": 243.43,
      "duration_seconds": 1.35,
      "text": "fine by me"
