{
  "schema_version": "1.0",
  "encounter_id": "01462",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 4.58,
      "duration_seconds": 3.54,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.96,
      "end_seconds": 9.72,
      "duration_seconds": 3.76,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.66,
      "end_seconds": 27.41,
      "duration_seconds": 15.75,
      "text": "So, you know, mainly dark urine. There's a couple of other things, but that's the main one. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.89,
      "end_seconds": 31.2,
      "duration_seconds": 2.31,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.26,
      "end_seconds": 34.21,
      "duration_seconds": 1.95,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.82,
      "end_seconds": 43.62,
      "duration_seconds": 1.8,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.32,
      "end_seconds": 47.24,
      "duration_seconds": 2.92,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.19,
      "end_seconds": 51.04,
      "duration_seconds": 1.85,
      "text": "Have you had tiredness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.69,
      "end_seconds": 54.31,
      "duration_seconds": 1.62,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.21,
      "end_seconds": 58.07,
      "duration_seconds": 2.86,
      "text": "Okay, have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.97,
      "end_seconds": 71.11,
      "duration_seconds": 11.14,
      "text": "Hmm, resting helps a bit. I, I did have no appetite at one point, you know, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 88.3,
      "duration_seconds": 1.84,
      "text": "Nothing like vomiting blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.91,
      "end_seconds": 93.49,
      "duration_seconds": 4.58,
      "text": "Okay, so no, none, no vomiting blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.49,
      "end_seconds": 99.5,
      "duration_seconds": 5.01,
      "text": "A few quick ones: itching, fever, severe abdominal pain or bleeding?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.39,
      "end_seconds": 106.28,
      "duration_seconds": 5.89,
      "text": "I haven't had itching, fever, severe abdominal pain or bleeding, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.13,
      "end_seconds": 109.37,
      "duration_seconds": 2.24,
      "text": "Right, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.22,
      "end_seconds": 111.23,
      "duration_seconds": 1.01,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.03,
      "end_seconds": 114.52,
      "duration_seconds": 1.49,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.65,
      "end_seconds": 119.03,
      "duration_seconds": 3.38,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.89,
      "end_seconds": 122.29,
      "duration_seconds": 1.4,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.08,
      "end_seconds": 128.12,
      "duration_seconds": 4.04,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.17,
      "end_seconds": 131.48,
      "duration_seconds": 2.31,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.74,
      "end_seconds": 139.38,
      "duration_seconds": 2.64,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.94,
      "end_seconds": 144.15,
      "duration_seconds": 2.21,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.61,
      "end_seconds": 154.01,
      "duration_seconds": 6.4,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.8,
      "end_seconds": 158.19,
      "duration_seconds": 2.39,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.08,
      "end_seconds": 166.33,
      "duration_seconds": 6.25,
      "text": "Yeah, I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.95,
      "end_seconds": 170.56,
      "duration_seconds": 3.61,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.54,
      "end_seconds": 174.27,
      "duration_seconds": 1.73,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.67,
      "end_seconds": 190.49,
      "duration_seconds": 2.82,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.97,
      "end_seconds": 199.23,
      "duration_seconds": 2.26,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.9,
      "end_seconds": 217.47,
      "duration_seconds": 7.57,
      "text": "Okay: heart rate 76, blood pressure 123 over 74, temperature is 37.0 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.61,
      "end_seconds": 222.11,
      "duration_seconds": 2.5,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.2,
      "end_seconds": 224.58,
      "duration_seconds": 1.38,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.67,
      "end_seconds": 242.6,
      "duration_seconds": 7.93,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.95,
      "end_seconds": 246.54,
      "duration_seconds": 2.59,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.04,
      "end_seconds": 260.51,
      "duration_seconds": 11.47,
      "text": "You can sit up now. Okay, thinking it through, my working impression is an acute viral hepatitis. I can't rule out a drug-related liver problem yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.16,
      "end_seconds": 262.8,
      "duration_seconds": 1.64,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.21,
      "end_seconds": 284.13,
      "duration_seconds": 19.92,
      "text": "It's reasonable to be concerned, but right now an acute viral hepatitis is my leading thought, not anything worse. I want liver blood tests done, that's for jaundice. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 289.23,
      "end_seconds": 294.19,
      "duration_seconds": 4.96,
      "text": "We have a slot Tuesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.03,
      "end_seconds": 299.7,
      "duration_seconds": 4.67,
      "text": "I want an ultrasound of the liver done, that's for jaundice."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.78,
      "end_seconds": 303.13,
      "duration_seconds": 1.35,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.01,
      "end_seconds": 324.07,
      "duration_seconds": 19.06,
      "text": "No alcohol at all and avoid paracetamol and other painkillers unless we say. Let's hold off on a hepatitis screen for now, and if there's no change next month we can revisit it. I'll want another look after the results."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.97,
      "end_seconds": 328.31,
      "duration_seconds": 2.34,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.09,
      "end_seconds": 334.85,
      "duration_seconds": 4.76,
      "text": "So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.19,
      "end_seconds": 340.48,
      "duration_seconds": 4.29,
      "text": "So, good, thanks, I'll see you then."
    }
  ]
}