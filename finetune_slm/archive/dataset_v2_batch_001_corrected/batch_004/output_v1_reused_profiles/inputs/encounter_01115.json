{
  "schema_version": "1.0",
  "encounter_id": "01115",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 2.63,
      "duration_seconds": 1.8,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.14,
      "end_seconds": 8.62,
      "duration_seconds": 4.48,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.53,
      "end_seconds": 20.02,
      "duration_seconds": 9.49,
      "text": "Mainly numbness on the left side of my face. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.26,
      "end_seconds": 22.96,
      "duration_seconds": 1.7,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.03,
      "end_seconds": 30.5,
      "duration_seconds": 3.47,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.77,
      "end_seconds": 40.57,
      "duration_seconds": 8.8,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.56,
      "end_seconds": 47.08,
      "duration_seconds": 5.52,
      "text": "well, you know, I'd say on and off mostly mild"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.62,
      "end_seconds": 49.99,
      "duration_seconds": 2.37,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.09,
      "end_seconds": 57.3,
      "duration_seconds": 6.21,
      "text": "Weakness in my left hand goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.55,
      "end_seconds": 72.95,
      "duration_seconds": 2.4,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.31,
      "end_seconds": 78.08,
      "duration_seconds": 3.77,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.06,
      "end_seconds": 83.64,
      "duration_seconds": 3.58,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.38,
      "end_seconds": 89.13,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.79,
      "end_seconds": 95.85,
      "duration_seconds": 5.06,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.47,
      "end_seconds": 100.97,
      "duration_seconds": 3.5,
      "text": "I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.91,
      "end_seconds": 105.4,
      "duration_seconds": 2.49,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.07,
      "end_seconds": 117.13,
      "duration_seconds": 11.06,
      "text": "it's metoprolol, 50 milligrams, twice a day for the heart rhythm let me think, I take aspirin, once a day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.01,
      "end_seconds": 121.91,
      "duration_seconds": 2.9,
      "text": "alright, and what strength is that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.39,
      "end_seconds": 125.03,
      "duration_seconds": 1.64,
      "text": "It's 75 milligrams."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.53,
      "end_seconds": 130.32,
      "duration_seconds": 3.79,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.64,
      "end_seconds": 134.31,
      "duration_seconds": 2.67,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.55,
      "end_seconds": 155.64,
      "duration_seconds": 4.09,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.67,
      "end_seconds": 165.83,
      "duration_seconds": 8.16,
      "text": "An irregular heartbeat, for about ten years. I didn't wanna bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.43,
      "end_seconds": 170.56,
      "duration_seconds": 4.13,
      "text": "I see, go ahead. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.2,
      "end_seconds": 177.69,
      "duration_seconds": 5.49,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.04,
      "end_seconds": 199.46,
      "duration_seconds": 6.42,
      "text": "let me check a few things any confusion, trouble swallowing, fall or palpitations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.04,
      "end_seconds": 206.77,
      "duration_seconds": 5.73,
      "text": "No confusion, trouble swallowing, fall or palpitations, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.13,
      "end_seconds": 211.26,
      "duration_seconds": 3.13,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.23,
      "end_seconds": 218.7,
      "duration_seconds": 5.47,
      "text": "Um, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.23,
      "end_seconds": 223.04,
      "duration_seconds": 2.81,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.83,
      "end_seconds": 239.0,
      "duration_seconds": 2.17,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.88,
      "end_seconds": 259.73,
      "duration_seconds": 10.85,
      "text": "Okay: oxygen saturation is 97 percent, temperature 36.6. And pulse is 78 beats a a minute, BP is 165 over 90."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.64,
      "end_seconds": 285.65,
      "duration_seconds": 12.01,
      "text": "so, based on your history, I'm honestly not certain yet it could be a possible mini-stroke, which we need to investigate urgently, or it might be a migraine variant"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.6,
      "end_seconds": 289.51,
      "duration_seconds": 2.91,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.85,
      "end_seconds": 323.35,
      "duration_seconds": 32.5,
      "text": "I can't promise yet, but most people with a possible mini-stroke, which we need to investigate urgently do well once it's treated properly. I want an MRI of the brain done, that's for possible stroke. Don't drive for now, and bring someone with you to the next visit. I think the stroke clinic should see you too. I'd like to see you again after the results are back. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.85,
      "end_seconds": 327.21,
      "duration_seconds": 3.36,
      "text": "Alright, you know, thanks, take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.09,
      "end_seconds": 330.97,
      "duration_seconds": 1.88,
      "text": "Have a good day."
    }
  ]
}