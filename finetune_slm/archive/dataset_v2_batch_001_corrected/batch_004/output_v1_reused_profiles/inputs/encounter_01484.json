{
  "schema_version": "1.0",
  "encounter_id": "01484",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.6,
      "end_seconds": 6.15,
      "duration_seconds": 5.55,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.45,
      "end_seconds": 12.63,
      "duration_seconds": 5.18,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.46,
      "end_seconds": 21.76,
      "duration_seconds": 8.3,
      "text": "Yeah, it's pain in my left wrist after a fall. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.01,
      "end_seconds": 26.53,
      "duration_seconds": 3.52,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.06,
      "end_seconds": 35.97,
      "duration_seconds": 8.91,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.32,
      "end_seconds": 40.9,
      "duration_seconds": 4.58,
      "text": "Okay, go on. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.37,
      "end_seconds": 57.49,
      "duration_seconds": 15.12,
      "text": "I'd call it mild. Sorry, what was I saying, I've had bruising too, for two weeks. I've had tingling in the fingers too, for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.31,
      "end_seconds": 65.74,
      "duration_seconds": 7.43,
      "text": "Have you had pain in your left wrist after a fall before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.17,
      "end_seconds": 71.9,
      "duration_seconds": 4.73,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.54,
      "end_seconds": 76.09,
      "duration_seconds": 2.55,
      "text": "Alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.06,
      "end_seconds": 84.73,
      "duration_seconds": 7.67,
      "text": "Just my tonsils removed, as a teenager. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.56,
      "end_seconds": 100.33,
      "duration_seconds": 3.77,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.29,
      "end_seconds": 106.82,
      "duration_seconds": 4.53,
      "text": "Let me think, my mother had a stroke."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.33,
      "end_seconds": 113.81,
      "duration_seconds": 3.48,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.14,
      "end_seconds": 118.23,
      "duration_seconds": 3.09,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.49,
      "end_seconds": 124.19,
      "duration_seconds": 4.7,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.28,
      "end_seconds": 139.53,
      "duration_seconds": 13.25,
      "text": "I gave up cigarettes last spring. I only drink at family occasions. Yes, I work in a bakery, early starts. My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.97,
      "end_seconds": 154.21,
      "duration_seconds": 2.24,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.12,
      "end_seconds": 161.98,
      "duration_seconds": 5.86,
      "text": "I've had thin bones for about a year now. I've got asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.99,
      "end_seconds": 174.33,
      "duration_seconds": 11.34,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.61,
      "end_seconds": 193.52,
      "duration_seconds": 13.91,
      "text": "I'm, I'm on alendronate, 70 milligrams, once a week for my bones. Asthalin inhaler, when needed for my asthma. Ah, it's paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.77,
      "end_seconds": 202.79,
      "duration_seconds": 8.02,
      "text": "Let me check a few things. Any deformity, pain in the elbow or pain in the shoulder?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.74,
      "end_seconds": 206.87,
      "duration_seconds": 2.13,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.29,
      "end_seconds": 214.25,
      "duration_seconds": 5.96,
      "text": "Any bump to the head, numbness or loss of consciousness at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.98,
      "end_seconds": 217.57,
      "duration_seconds": 2.59,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.54,
      "end_seconds": 221.12,
      "duration_seconds": 2.58,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.04,
      "end_seconds": 225.76,
      "duration_seconds": 3.72,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 226.87,
      "end_seconds": 235.95,
      "duration_seconds": 9.08,
      "text": "Here are the numbers, doctor. SpO2 99 percent on room air, pulse 79, BP is 122 over 71, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.55,
      "end_seconds": 238.97,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.81,
      "end_seconds": 243.37,
      "duration_seconds": 2.56,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.2,
      "end_seconds": 247.3,
      "duration_seconds": 2.1,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.86,
      "end_seconds": 261.65,
      "duration_seconds": 6.79,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.23,
      "end_seconds": 265.14,
      "duration_seconds": 1.91,
      "text": "Right, breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.09,
      "end_seconds": 284.72,
      "duration_seconds": 3.63,
      "text": "Fingers have good colour and the pulses are fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.55,
      "end_seconds": 303.21,
      "duration_seconds": 13.66,
      "text": "Please sit back down. Taking everything into account, I'd lean towards a wrist sprain, but a small fracture is possible. It could also be a scaphoid fracture, so we'll keep that open."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 316.66,
      "end_seconds": 321.12,
      "duration_seconds": 4.46,
      "text": "I've already done an X-ray of the wrist, it's ready for you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.28,
      "end_seconds": 334.44,
      "duration_seconds": 12.16,
      "text": "Good, thanks for doing that. I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. Let's review you after the X-ray."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.18,
      "end_seconds": 339.48,
      "duration_seconds": 4.3,
      "text": "Yeah, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.18,
      "end_seconds": 345.46,
      "duration_seconds": 4.28,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 345.97,
      "end_seconds": 348.09,
      "duration_seconds": 2.12,
      "text": "Alright, thanks, take care."
    }
  ]
}