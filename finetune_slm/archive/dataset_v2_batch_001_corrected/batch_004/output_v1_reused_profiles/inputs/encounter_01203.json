{
  "schema_version": "1.0",
  "encounter_id": "01203",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 2.85,
      "duration_seconds": 2.05,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.17,
      "end_seconds": 6.28,
      "duration_seconds": 2.11,
      "text": "Hello, uh, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.91,
      "end_seconds": 10.74,
      "duration_seconds": 2.83,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.73,
      "end_seconds": 19.5,
      "duration_seconds": 5.77,
      "text": "Good, that'll be useful. Pull up a chair. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.41,
      "end_seconds": 25.16,
      "duration_seconds": 3.75,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.24,
      "end_seconds": 29.2,
      "duration_seconds": 2.96,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 31.18,
      "end_seconds": 38.85,
      "duration_seconds": 7.67,
      "text": "It's a cut on my finger, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 42.61,
      "duration_seconds": 2.66,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.26,
      "end_seconds": 47.51,
      "duration_seconds": 4.25,
      "text": "I take omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.1,
      "end_seconds": 57.01,
      "duration_seconds": 3.91,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.19,
      "end_seconds": 60.54,
      "duration_seconds": 2.35,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.4,
      "end_seconds": 64.28,
      "duration_seconds": 2.88,
      "text": "Alright, does anything set it off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.61,
      "end_seconds": 76.93,
      "duration_seconds": 11.32,
      "text": "Yes, gripping. That makes it worse. Oh, and difficulty bending the finger. Okay, so I've had bleeding too, for about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.34,
      "end_seconds": 96.63,
      "duration_seconds": 4.29,
      "text": "And what about weakness of the hand or bite?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.1,
      "end_seconds": 102.95,
      "duration_seconds": 4.85,
      "text": "No weakness of the hand or bite, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.58,
      "end_seconds": 110.37,
      "duration_seconds": 2.79,
      "text": "And what about pus or redness spreading?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.52,
      "end_seconds": 118.59,
      "duration_seconds": 3.07,
      "text": "Um, none of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.11,
      "end_seconds": 124.37,
      "duration_seconds": 4.26,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 127.39,
      "duration_seconds": 2.43,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.87,
      "end_seconds": 133.85,
      "duration_seconds": 2.98,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.56,
      "end_seconds": 137.23,
      "duration_seconds": 1.67,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.96,
      "end_seconds": 141.05,
      "duration_seconds": 3.09,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.16,
      "end_seconds": 145.85,
      "duration_seconds": 3.69,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.07,
      "end_seconds": 149.52,
      "duration_seconds": 2.45,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.48,
      "end_seconds": 152.74,
      "duration_seconds": 2.26,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.44,
      "end_seconds": 162.04,
      "duration_seconds": 5.6,
      "text": "Right, right. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.95,
      "end_seconds": 166.63,
      "duration_seconds": 3.68,
      "text": "Um, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.58,
      "end_seconds": 183.5,
      "duration_seconds": 2.92,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.16,
      "end_seconds": 195.52,
      "duration_seconds": 10.36,
      "text": "I work in accounts at a hospital. My partner and our baby. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.22,
      "end_seconds": 199.8,
      "duration_seconds": 3.58,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.64,
      "end_seconds": 205.75,
      "duration_seconds": 4.11,
      "text": "Erythromycin. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.42,
      "end_seconds": 209.71,
      "duration_seconds": 3.29,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.14,
      "end_seconds": 222.12,
      "duration_seconds": 2.98,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.37,
      "end_seconds": 240.03,
      "duration_seconds": 6.66,
      "text": "Okay: pulse 82, BP is 109 over 77, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.74,
      "end_seconds": 243.08,
      "duration_seconds": 2.34,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.93,
      "end_seconds": 247.67,
      "duration_seconds": 2.74,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.56,
      "end_seconds": 253.28,
      "duration_seconds": 3.72,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.62,
      "end_seconds": 256.57,
      "duration_seconds": 1.95,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.07,
      "end_seconds": 272.94,
      "duration_seconds": 7.87,
      "text": "There is a two-centimetre clean cut over the first knuckle, the finger moves fully and the fingertip feels normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.62,
      "end_seconds": 278.59,
      "duration_seconds": 1.97,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.31,
      "end_seconds": 309.11,
      "duration_seconds": 12.8,
      "text": "Let's get an X-ray of the finger, for laceration. You'll be taking tetanus booster, 0.5 ml, once, for one day. That's for tetanus prevention."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.62,
      "end_seconds": 311.19,
      "duration_seconds": 1.57,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 327.4,
      "duration_seconds": 13.02,
      "text": "Keep the dressing dry for two days and watch for redness or pus. Please come and see me in five days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.47,
      "end_seconds": 332.95,
      "duration_seconds": 3.48,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.62,
      "end_seconds": 334.94,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}