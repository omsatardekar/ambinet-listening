{
  "schema_version": "1.0",
  "encounter_id": "01415",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.26,
      "duration_seconds": 3.31,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.13,
      "end_seconds": 11.34,
      "duration_seconds": 4.21,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.23,
      "end_seconds": 18.1,
      "duration_seconds": 5.87,
      "text": "Morning, doctor. I'll stay and and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.99,
      "end_seconds": 25.03,
      "duration_seconds": 5.04,
      "text": "So the thing is, I've got an itchy rash all over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.07,
      "end_seconds": 30.82,
      "duration_seconds": 3.75,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.54,
      "end_seconds": 35.95,
      "duration_seconds": 3.41,
      "text": "About three days, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.08,
      "end_seconds": 43.93,
      "duration_seconds": 3.85,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.54,
      "end_seconds": 49.57,
      "duration_seconds": 5.03,
      "text": "Okay, so roughly three to five days. Is that that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 53.28,
      "duration_seconds": 2.99,
      "text": "Ah, I suppose so, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.55,
      "end_seconds": 56.98,
      "duration_seconds": 2.43,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.72,
      "end_seconds": 68.97,
      "duration_seconds": 10.25,
      "text": "I'd say every other day. And swelling of my lips as well, since last night. There's hives as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.84,
      "end_seconds": 74.88,
      "duration_seconds": 4.04,
      "text": "Did you get new food, wheeze, fainting or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.99,
      "end_seconds": 78.69,
      "duration_seconds": 2.7,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.99,
      "end_seconds": 82.88,
      "duration_seconds": 2.89,
      "text": "Has there been any trouble breathing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.1,
      "end_seconds": 87.05,
      "duration_seconds": 2.95,
      "text": "No, none, no trouble breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.53,
      "end_seconds": 91.65,
      "duration_seconds": 3.12,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.24,
      "end_seconds": 94.92,
      "duration_seconds": 1.68,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.14,
      "end_seconds": 115.71,
      "duration_seconds": 2.57,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.27,
      "end_seconds": 124.2,
      "duration_seconds": 6.93,
      "text": "I have asthma, for about a year. Acid reflux, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.34,
      "end_seconds": 133.13,
      "duration_seconds": 7.79,
      "text": "Yes, acid reflux is known to us, good to have that clear. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.6,
      "end_seconds": 137.77,
      "duration_seconds": 3.17,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.22,
      "end_seconds": 140.66,
      "duration_seconds": 1.44,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.28,
      "end_seconds": 145.5,
      "duration_seconds": 3.22,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.36,
      "end_seconds": 153.31,
      "duration_seconds": 2.95,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.08,
      "end_seconds": 158.87,
      "duration_seconds": 3.79,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.39,
      "end_seconds": 162.1,
      "duration_seconds": 1.71,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.53,
      "end_seconds": 167.97,
      "duration_seconds": 2.44,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.88,
      "end_seconds": 180.17,
      "duration_seconds": 2.29,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.83,
      "end_seconds": 187.91,
      "duration_seconds": 4.08,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.58,
      "end_seconds": 190.78,
      "duration_seconds": 2.2,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.72,
      "end_seconds": 195.05,
      "duration_seconds": 3.33,
      "text": "Asthalin inhaler. I take it when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.75,
      "end_seconds": 201.42,
      "duration_seconds": 4.67,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.47,
      "end_seconds": 217.08,
      "duration_seconds": 13.61,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.93,
      "end_seconds": 221.7,
      "duration_seconds": 2.77,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 236.2,
      "duration_seconds": 1.95,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.64,
      "end_seconds": 254.08,
      "duration_seconds": 7.44,
      "text": "Okay: respiratory rate 17, temp 36.5 degrees, heart rate 75. And BP is 117 over 80."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.41,
      "end_seconds": 259.43,
      "duration_seconds": 4.02,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.22,
      "end_seconds": 263.17,
      "duration_seconds": 1.95,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.6,
      "end_seconds": 283.16,
      "duration_seconds": 11.56,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.12,
      "end_seconds": 288.78,
      "duration_seconds": 2.66,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.76,
      "end_seconds": 308.13,
      "duration_seconds": 11.37,
      "text": "Let me tell you where I've got to. I'd lean towards an allergic reaction, possibly to a recently started medicine. I'd also keep a viral rash in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.77,
      "end_seconds": 314.56,
      "duration_seconds": 5.79,
      "text": "sorry, what was I saying, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.19,
      "end_seconds": 336.42,
      "duration_seconds": 18.23,
      "text": "I understand the worry. At the moment I'd say it's an allergic reaction, possibly to a recently started medicine, and we'll watch how it goes. So, to recap quickly. You've had an itchy rash all over, and no vomiting or new food"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.5,
      "end_seconds": 341.18,
      "duration_seconds": 2.68,
      "text": "yes, you've got it it"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.45,
      "end_seconds": 360.36,
      "duration_seconds": 17.91,
      "text": "You'll be taking prednisolone, 30 milligrams, once a day, for three days. It's for allergic reaction. Stop the new tablet until we know what caused it and write down every medicine you took in the last week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.72,
      "end_seconds": 387.94,
      "duration_seconds": 27.22,
      "text": "I see, go ahead. If you smoke, this is a good moment to think about stopping, and we can help you with that. Do get help quickly if your throat tightens, your lips swell further or you get breathless. I'll want another look after the review. Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.75,
      "end_seconds": 391.43,
      "duration_seconds": 2.68,
      "text": "I think I understand everything. Thanks"
    }
  ]
}