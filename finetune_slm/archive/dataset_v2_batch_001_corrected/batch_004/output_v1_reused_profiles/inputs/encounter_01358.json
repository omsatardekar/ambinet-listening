{
  "schema_version": "1.0",
  "encounter_id": "01358",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 6.2,
      "duration_seconds": 5.2,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 12.51,
      "duration_seconds": 4.46,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.55,
      "end_seconds": 24.82,
      "duration_seconds": 11.27,
      "text": "Mainly burning when I pass urine. There's a couple of other things, but that's the main one. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.74,
      "end_seconds": 28.85,
      "duration_seconds": 3.11,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.95,
      "end_seconds": 32.57,
      "duration_seconds": 2.62,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.68,
      "end_seconds": 36.03,
      "duration_seconds": 2.35,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.06,
      "end_seconds": 40.74,
      "duration_seconds": 3.68,
      "text": "I get some relief from drinking water."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 58.08,
      "duration_seconds": 4.18,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.23,
      "end_seconds": 63.75,
      "duration_seconds": 4.52,
      "text": "I'm on gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.2,
      "end_seconds": 76.82,
      "duration_seconds": 2.62,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.77,
      "end_seconds": 82.66,
      "duration_seconds": 3.89,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 86.7,
      "duration_seconds": 2.8,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.48,
      "end_seconds": 92.43,
      "duration_seconds": 3.95,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.06,
      "end_seconds": 96.38,
      "duration_seconds": 2.32,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.64,
      "end_seconds": 101.59,
      "duration_seconds": 3.95,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.5,
      "end_seconds": 105.18,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.71,
      "end_seconds": 111.25,
      "duration_seconds": 4.54,
      "text": "Um, I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.36,
      "end_seconds": 115.84,
      "duration_seconds": 3.48,
      "text": "I follow. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.39,
      "end_seconds": 120.69,
      "duration_seconds": 4.3,
      "text": "I don't think I have any, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.78,
      "end_seconds": 128.2,
      "duration_seconds": 2.42,
      "text": "Did you notice any new partner?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.18,
      "end_seconds": 131.89,
      "duration_seconds": 2.71,
      "text": "I haven't noticed any new partner."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.57,
      "end_seconds": 137.17,
      "duration_seconds": 4.6,
      "text": "Have you noticed blood in the urine, vomiting or vaginal discharge?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.51,
      "end_seconds": 144.35,
      "duration_seconds": 5.84,
      "text": "No blood in the urine, vomiting or vaginal discharge, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.33,
      "end_seconds": 150.25,
      "duration_seconds": 4.92,
      "text": "So, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.18,
      "end_seconds": 154.83,
      "duration_seconds": 2.65,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.51,
      "end_seconds": 158.8,
      "duration_seconds": 3.29,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.14,
      "end_seconds": 170.22,
      "duration_seconds": 2.08,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.45,
      "end_seconds": 192.25,
      "duration_seconds": 8.8,
      "text": "Okay: saturation 99 percent, temperature 36.6. And heart rate 65, weight 59 kilos, height 186 centimetres, pressure 116 over 77."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.43,
      "end_seconds": 196.82,
      "duration_seconds": 2.39,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.87,
      "end_seconds": 205.89,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.08,
      "end_seconds": 208.34,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.33,
      "end_seconds": 232.57,
      "duration_seconds": 6.24,
      "text": "Your tummy is soft with mild tenderness low down and no pain in the loins."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.16,
      "end_seconds": 237.47,
      "duration_seconds": 2.31,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.03,
      "end_seconds": 261.68,
      "duration_seconds": 8.65,
      "text": "So, based on the history and the examination, the most likely explanation is a lower urinary tract infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.58,
      "end_seconds": 269.13,
      "duration_seconds": 3.55,
      "text": "Erm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.47,
      "end_seconds": 283.78,
      "duration_seconds": 13.31,
      "text": "Nothing I've seen today points to an emergency. It looks like a lower urinary tract infection, but I'd like to confirm. Let's get a urine culture, for recurrent urinary infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.24,
      "end_seconds": 287.92,
      "duration_seconds": 2.68,
      "text": "Erm, okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.61,
      "end_seconds": 315.66,
      "duration_seconds": 26.05,
      "text": "What I'm giving you is nitrofurantoin, 100 milligrams, twice a day, for three days. You take it by mouth. It's for urinary infection. Drink plenty of water and don't hold on when you need to go. One warning sign to remember: you get fever, loin pain or vomiting. In that case don't wait. See me again if it isn't better in three days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.58,
      "end_seconds": 317.28,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.93,
      "end_seconds": 322.45,
      "duration_seconds": 4.52,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.44,
      "end_seconds": 326.81,
      "duration_seconds": 3.37,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}