{
  "schema_version": "1.0",
  "encounter_id": "01361",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 10.06,
      "duration_seconds": 9.45,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.69,
      "end_seconds": 17.14,
      "duration_seconds": 5.45,
      "text": "Okay, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.01,
      "end_seconds": 23.8,
      "duration_seconds": 5.79,
      "text": "I'm here because of a burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.49,
      "end_seconds": 27.54,
      "duration_seconds": 3.05,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.66,
      "end_seconds": 31.84,
      "duration_seconds": 3.18,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.78,
      "end_seconds": 35.56,
      "duration_seconds": 2.78,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.81,
      "end_seconds": 40.15,
      "duration_seconds": 3.34,
      "text": "I get some relief from milk."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.77,
      "end_seconds": 48.49,
      "duration_seconds": 2.72,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.81,
      "end_seconds": 52.9,
      "duration_seconds": 3.09,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.96,
      "end_seconds": 56.27,
      "duration_seconds": 2.31,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.17,
      "end_seconds": 67.45,
      "duration_seconds": 9.28,
      "text": "A sour taste in the mouth goes along with it, most of the time. And bloating after meals, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.25,
      "end_seconds": 71.83,
      "duration_seconds": 2.58,
      "text": "Right, have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.85,
      "end_seconds": 77.11,
      "duration_seconds": 3.26,
      "text": "I notice it more with large meals."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.42,
      "end_seconds": 79.11,
      "duration_seconds": 1.69,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.88,
      "end_seconds": 96.83,
      "duration_seconds": 16.95,
      "text": "As for sour taste in the mouth, I honestly can't say when that began. It might have been last month or the month before. As for sour taste in the mouth, about a five out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.99,
      "end_seconds": 104.4,
      "duration_seconds": 3.41,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.14,
      "end_seconds": 111.03,
      "duration_seconds": 5.89,
      "text": "Right, not currently, but as a youngster trimethoprim gave me itching."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.3,
      "end_seconds": 123.0,
      "duration_seconds": 3.7,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.66,
      "end_seconds": 128.17,
      "duration_seconds": 3.51,
      "text": "It's naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 129.62,
      "end_seconds": 135.17,
      "duration_seconds": 5.55,
      "text": "Doctor, our chart from the last visit lists it as 500 milligrams."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.07,
      "end_seconds": 140.35,
      "duration_seconds": 4.28,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.69,
      "end_seconds": 151.95,
      "duration_seconds": 6.26,
      "text": "I don't think I have it with me. Lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.59,
      "end_seconds": 154.63,
      "duration_seconds": 2.04,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.87,
      "end_seconds": 157.24,
      "duration_seconds": 1.37,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.53,
      "end_seconds": 161.05,
      "duration_seconds": 2.52,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.76,
      "end_seconds": 169.36,
      "duration_seconds": 6.6,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.47,
      "end_seconds": 173.19,
      "duration_seconds": 2.72,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.85,
      "end_seconds": 181.82,
      "duration_seconds": 6.97,
      "text": "Ah, I've had arthritis in my knees, yes. Acid reflux, for nearly five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.42,
      "end_seconds": 186.71,
      "duration_seconds": 4.29,
      "text": "Sure. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.48,
      "end_seconds": 206.33,
      "duration_seconds": 17.85,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. I walk the dog every morning. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.42,
      "end_seconds": 211.99,
      "duration_seconds": 3.57,
      "text": "Have you had any weight loss or fever?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.96,
      "end_seconds": 217.79,
      "duration_seconds": 3.83,
      "text": "I haven't had weight loss or fever, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.14,
      "end_seconds": 223.23,
      "duration_seconds": 4.09,
      "text": "And what about trouble swallowing, black stools or jaundice?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.97,
      "end_seconds": 227.54,
      "duration_seconds": 2.57,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.57,
      "end_seconds": 230.58,
      "duration_seconds": 2.01,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.65,
      "end_seconds": 235.02,
      "duration_seconds": 2.37,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.16,
      "end_seconds": 239.08,
      "duration_seconds": 2.92,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.43,
      "end_seconds": 241.35,
      "duration_seconds": 0.92,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 242.03,
      "end_seconds": 254.18,
      "duration_seconds": 12.15,
      "text": "Doctor, I've got the readings for you. Pulse is 73 beats a minute, weight 71 kilos, temperature is 36.8 degrees, BP is 127 over 81, saturation 98 percent, height 163 centimetres."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.77,
      "end_seconds": 255.47,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.91,
      "end_seconds": 260.74,
      "duration_seconds": 3.83,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.58,
      "end_seconds": 265.4,
      "duration_seconds": 2.82,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 277.41,
      "duration_seconds": 1.95,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.38,
      "end_seconds": 281.56,
      "duration_seconds": 3.18,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.47,
      "end_seconds": 301.79,
      "duration_seconds": 5.32,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.07,
      "end_seconds": 306.56,
      "duration_seconds": 2.49,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.82,
      "end_seconds": 334.86,
      "duration_seconds": 11.04,
      "text": "So, based on the history and the examination, I think we're dealing with gastritis at this stage. I'd also keep acid reflux in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.83,
      "end_seconds": 340.65,
      "duration_seconds": 3.82,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.81,
      "end_seconds": 349.8,
      "duration_seconds": 7.99,
      "text": "Nothing I've seen today points to an emergency. It looks like gastritis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.14,
      "end_seconds": 363.8,
      "duration_seconds": 3.66,
      "text": "Blood tests is what I'd like next, for dyspepsia."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 365.29,
      "end_seconds": 366.36,
      "duration_seconds": 1.07,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.99,
      "end_seconds": 384.96,
      "duration_seconds": 17.97,
      "text": "I'm sending you for an H. pylori test because of dyspepsia. Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 385.82,
      "end_seconds": 387.43,
      "duration_seconds": 1.61,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.8,
      "end_seconds": 404.06,
      "duration_seconds": 15.26,
      "text": "Let's hold off on an upper endoscopy for now, and if there's no change next month we can revisit it. Do get help quickly if you vomit blood or pass black stools. I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.66,
      "end_seconds": 405.36,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.58,
      "end_seconds": 410.79,
      "duration_seconds": 4.21,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 412.15,
      "end_seconds": 414.39,
      "duration_seconds": 2.24,
      "text": "Alright, thanks, take care."
    }
  ]
}