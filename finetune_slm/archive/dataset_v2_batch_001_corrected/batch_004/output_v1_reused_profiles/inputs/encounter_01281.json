{
  "schema_version": "1.0",
  "encounter_id": "01281",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.55,
      "duration_seconds": 3.64,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.37,
      "end_seconds": 9.24,
      "duration_seconds": 3.87,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.15,
      "end_seconds": 16.04,
      "duration_seconds": 5.89,
      "text": "It's a dry cough. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.99,
      "end_seconds": 21.11,
      "duration_seconds": 3.12,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.87,
      "end_seconds": 30.14,
      "duration_seconds": 4.27,
      "text": "Hmm, it's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.7,
      "end_seconds": 34.06,
      "duration_seconds": 2.36,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.84,
      "end_seconds": 36.9,
      "duration_seconds": 2.06,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.96,
      "end_seconds": 42.15,
      "duration_seconds": 3.19,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.94,
      "end_seconds": 47.99,
      "duration_seconds": 5.05,
      "text": "A high temperature goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.59,
      "end_seconds": 56.21,
      "duration_seconds": 3.62,
      "text": "Okay, have you been feeling short of breath?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.99,
      "end_seconds": 79.2,
      "duration_seconds": 22.21,
      "text": "Yes, since last Tuesday. As for feeling short of breath, I'd give it a three, out of ten. The high temperature? That's been for ten days. Um, with high temperature, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.06,
      "end_seconds": 84.5,
      "duration_seconds": 4.44,
      "text": "Any vomiting, leg swelling, diarrhoea or chest pain at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.12,
      "end_seconds": 87.64,
      "duration_seconds": 2.52,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.55,
      "end_seconds": 92.51,
      "duration_seconds": 3.96,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.15,
      "end_seconds": 97.76,
      "duration_seconds": 1.61,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.76,
      "end_seconds": 101.72,
      "duration_seconds": 2.96,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.27,
      "end_seconds": 106.0,
      "duration_seconds": 2.73,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 111.1,
      "duration_seconds": 3.79,
      "text": "a a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.99,
      "end_seconds": 125.42,
      "duration_seconds": 12.43,
      "text": "No, I share a house with my brother. I hardly move around during the day. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.53,
      "end_seconds": 130.7,
      "duration_seconds": 4.17,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.22,
      "end_seconds": 134.02,
      "duration_seconds": 2.8,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.65,
      "end_seconds": 137.57,
      "duration_seconds": 2.92,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.29,
      "end_seconds": 154.01,
      "duration_seconds": 15.72,
      "text": "yes, I had two stents put in my heart, three years ago i didn't want to make a fuss, you know i'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.33,
      "end_seconds": 171.53,
      "duration_seconds": 4.2,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.9,
      "end_seconds": 179.37,
      "duration_seconds": 6.47,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. It's metformin, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.24,
      "end_seconds": 183.33,
      "duration_seconds": 2.09,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.66,
      "end_seconds": 190.44,
      "duration_seconds": 5.78,
      "text": "it's 500 milligrams i'm on metoprolol, 50 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.65,
      "end_seconds": 191.55,
      "duration_seconds": 0.9,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.57,
      "end_seconds": 210.18,
      "duration_seconds": 7.61,
      "text": "Tell me about any past illnesses or ongoing conditions. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.82,
      "end_seconds": 212.89,
      "duration_seconds": 2.07,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.74,
      "end_seconds": 216.14,
      "duration_seconds": 1.4,
      "text": "and besides that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.66,
      "end_seconds": 220.13,
      "duration_seconds": 3.47,
      "text": "I've got diabetes yes, heart disease"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.96,
      "end_seconds": 233.44,
      "duration_seconds": 11.48,
      "text": "Ah. Right, so high blood pressure and diabetes are already on your record. We'll keep that in mind today. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.13,
      "end_seconds": 242.26,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.8,
      "end_seconds": 267.01,
      "duration_seconds": 7.21,
      "text": "Okay: heart rate 102, pressure 142 over 78. And respiratory rate 25, temperature 36.7."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.37,
      "end_seconds": 273.04,
      "duration_seconds": 3.67,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.75,
      "end_seconds": 275.51,
      "duration_seconds": 1.76,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.4,
      "end_seconds": 279.83,
      "duration_seconds": 2.43,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.93,
      "end_seconds": 299.99,
      "duration_seconds": 9.06,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.16,
      "end_seconds": 304.1,
      "duration_seconds": 1.94,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.45,
      "end_seconds": 354.23,
      "duration_seconds": 31.78,
      "text": "So where does that leave us? It points towards a viral chest infection with mildly low oxygen. I can't rule out a a bacterial pneumonia yet. I want a chest X-ray done, that's for low oxygen and crackles. We should do a viral swab for fever and cough. Rest, keep your fluids up and lie on your tummy or side to help your breathing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.57,
      "end_seconds": 368.08,
      "duration_seconds": 12.51,
      "text": "try to get to bed and wake up at the same time each day, and keep your phone away from the bed i'll want another look in two days"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.48,
      "end_seconds": 371.41,
      "duration_seconds": 1.93,
      "text": "good, I'll return then"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.34,
      "end_seconds": 376.49,
      "duration_seconds": 4.15,
      "text": "so, I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.46,
      "end_seconds": 381.28,
      "duration_seconds": 3.82,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.32,
      "end_seconds": 386.89,
      "duration_seconds": 1.57,
      "text": "Have a good day."
    }
  ]
}