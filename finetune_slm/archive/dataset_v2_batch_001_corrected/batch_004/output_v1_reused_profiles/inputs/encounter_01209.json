{
  "schema_version": "1.0",
  "encounter_id": "01209",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 4.15,
      "duration_seconds": 3.21,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.08,
      "end_seconds": 6.14,
      "duration_seconds": 1.06,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.48,
      "end_seconds": 12.74,
      "duration_seconds": 5.26,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.68,
      "end_seconds": 16.93,
      "duration_seconds": 3.25,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.82,
      "end_seconds": 24.07,
      "duration_seconds": 6.25,
      "text": "Mainly swelling. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.92,
      "end_seconds": 29.15,
      "duration_seconds": 3.23,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.82,
      "end_seconds": 37.99,
      "duration_seconds": 8.17,
      "text": "Since last weekend, that's when it began. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.88,
      "end_seconds": 47.72,
      "duration_seconds": 7.84,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.49,
      "end_seconds": 69.17,
      "duration_seconds": 18.68,
      "text": "Elevation helps a bit. Maybe a eight out of ten on a bad day. I've had difficulty walking too, for ten days. With difficulty walking, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.23,
      "end_seconds": 73.09,
      "duration_seconds": 2.86,
      "text": "What about bruising, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.12,
      "end_seconds": 84.34,
      "duration_seconds": 10.22,
      "text": "Hmm, you know, yes, for two weeks. Mm, uh, and pain in my right ankle as well, since Friday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.52,
      "end_seconds": 87.91,
      "duration_seconds": 2.39,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.91,
      "end_seconds": 94.24,
      "duration_seconds": 4.33,
      "text": "Yeah, only ice and rest, and it's not much."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 118.26,
      "duration_seconds": 9.81,
      "text": "So, did you get pain at the back of the heel, pop or crack, pain in the knee or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.03,
      "end_seconds": 130.38,
      "duration_seconds": 10.35,
      "text": "I haven't had pain at the back of the heel, pop or crack, pain in the knee or numbness, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.4,
      "end_seconds": 132.94,
      "duration_seconds": 1.54,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.55,
      "end_seconds": 136.46,
      "duration_seconds": 1.91,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.45,
      "end_seconds": 142.49,
      "duration_seconds": 4.04,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 154.5,
      "duration_seconds": 10.36,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.13,
      "end_seconds": 159.38,
      "duration_seconds": 3.25,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.01,
      "end_seconds": 163.19,
      "duration_seconds": 3.18,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.95,
      "end_seconds": 167.79,
      "duration_seconds": 2.84,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.5,
      "end_seconds": 177.97,
      "duration_seconds": 9.47,
      "text": "I swim twice a week. I look after my grandchildren most days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.76,
      "end_seconds": 184.34,
      "duration_seconds": 2.58,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.89,
      "end_seconds": 188.22,
      "duration_seconds": 2.33,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.99,
      "end_seconds": 193.91,
      "duration_seconds": 3.92,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.23,
      "end_seconds": 203.37,
      "duration_seconds": 8.14,
      "text": "I've had COPD for five years now. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.96,
      "end_seconds": 205.13,
      "duration_seconds": 1.17,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.36,
      "end_seconds": 219.59,
      "duration_seconds": 13.23,
      "text": "Sorry, what was I saying, I've had low haemoglobin for about a year now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.63,
      "end_seconds": 224.54,
      "duration_seconds": 2.91,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.21,
      "end_seconds": 230.74,
      "duration_seconds": 5.53,
      "text": "Yes, low haemoglobin is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.52,
      "end_seconds": 242.36,
      "duration_seconds": 3.84,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.27,
      "end_seconds": 257.53,
      "duration_seconds": 13.26,
      "text": "Tiotropium inhaler, once a day for my chest. I take iron tablets, once a day for my blood count. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.09,
      "end_seconds": 261.28,
      "duration_seconds": 3.19,
      "text": "Right, right. I'll do your observations first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.65,
      "end_seconds": 272.21,
      "duration_seconds": 2.56,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.28,
      "end_seconds": 287.15,
      "duration_seconds": 3.87,
      "text": "Okay: BP is 112 over 75, pulse 68."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.14,
      "end_seconds": 291.48,
      "duration_seconds": 2.34,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.1,
      "end_seconds": 295.37,
      "duration_seconds": 3.27,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.06,
      "end_seconds": 303.31,
      "duration_seconds": 5.25,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.84,
      "end_seconds": 306.83,
      "duration_seconds": 1.99,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.88,
      "end_seconds": 327.82,
      "duration_seconds": 6.94,
      "text": "There's swelling and bruising on the outer side of the ankle, tender over the ligament."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.2,
      "end_seconds": 331.45,
      "duration_seconds": 2.25,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.97,
      "end_seconds": 355.39,
      "duration_seconds": 6.42,
      "text": "The bones themselves aren't tender and the ankle feels stable when I test it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.21,
      "end_seconds": 362.13,
      "duration_seconds": 2.92,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.58,
      "end_seconds": 381.08,
      "duration_seconds": 11.5,
      "text": "Let me repeat that back to make sure. You've had swelling, since last weekend, and no pain in the knee or pop or crack."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.16,
      "end_seconds": 384.93,
      "duration_seconds": 1.77,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.51,
      "end_seconds": 418.15,
      "duration_seconds": 31.64,
      "text": "I'm going to order an X-ray of the ankle, for ankle injury. I'm prescribing paracetamol, 650 milligrams, three times a day, for three days. You take it by mouth. It's for ankle pain. Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. I'd like you to see physiotherapy as well, and I'll write the referral. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.24,
      "end_seconds": 425.33,
      "duration_seconds": 5.09,
      "text": "Let's plan a check in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 426.46,
      "end_seconds": 430.37,
      "duration_seconds": 3.91,
      "text": "Mm, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.26,
      "end_seconds": 433.46,
      "duration_seconds": 1.2,
      "text": "Look after yourself."
    }
  ]
}