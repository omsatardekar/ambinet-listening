{
  "schema_version": "1.0",
  "encounter_id": "01194",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 7.81,
      "duration_seconds": 6.93,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.92,
      "end_seconds": 12.63,
      "duration_seconds": 3.71,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.48,
      "end_seconds": 19.92,
      "duration_seconds": 5.44,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.86,
      "end_seconds": 23.38,
      "duration_seconds": 2.52,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.47,
      "end_seconds": 29.87,
      "duration_seconds": 4.4,
      "text": "Um, so... shaky spells. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.83,
      "end_seconds": 33.59,
      "duration_seconds": 2.76,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.56,
      "end_seconds": 37.73,
      "duration_seconds": 2.17,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.16,
      "end_seconds": 48.5,
      "duration_seconds": 10.34,
      "text": "Mm-hmm. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.41,
      "end_seconds": 64.72,
      "duration_seconds": 15.31,
      "text": "Honestly, a couple of times a week. Eating something sweet helps a bit. I had a pounding heart with it before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.07,
      "end_seconds": 69.46,
      "duration_seconds": 3.39,
      "text": "Right, have you noticed confusion or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.7,
      "end_seconds": 74.95,
      "duration_seconds": 4.25,
      "text": "No, you know, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.84,
      "end_seconds": 77.81,
      "duration_seconds": 1.97,
      "text": "Any weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.94,
      "end_seconds": 86.59,
      "duration_seconds": 5.65,
      "text": "Right, uh, I haven't had weight loss or vomiting, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.2,
      "end_seconds": 91.67,
      "duration_seconds": 3.47,
      "text": "Have you had seizure, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.59,
      "end_seconds": 97.72,
      "duration_seconds": 3.13,
      "text": "Nope, you know, no seizure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.98,
      "end_seconds": 101.0,
      "duration_seconds": 2.02,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.46,
      "end_seconds": 104.23,
      "duration_seconds": 1.77,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.8,
      "end_seconds": 107.47,
      "duration_seconds": 2.67,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.86,
      "end_seconds": 126.86,
      "duration_seconds": 18.0,
      "text": "Well, I've had high blood pressure, yes. I've got diabetes. Hmm, uh, I've had thin bones for nearly five years now. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 143.19,
      "duration_seconds": 3.73,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.87,
      "end_seconds": 146.65,
      "duration_seconds": 2.78,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.66,
      "end_seconds": 152.57,
      "duration_seconds": 4.91,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.31,
      "end_seconds": 157.1,
      "duration_seconds": 3.79,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.28,
      "end_seconds": 160.46,
      "duration_seconds": 2.18,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 162.33,
      "end_seconds": 166.99,
      "duration_seconds": 4.66,
      "text": "Actually, she takes glimepiride, 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.82,
      "end_seconds": 186.58,
      "duration_seconds": 2.76,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.78,
      "end_seconds": 205.29,
      "duration_seconds": 13.51,
      "text": "Nothing, I'm teetotal. I drink a lot of tea and snack through the day. I swim twice a week. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.07,
      "end_seconds": 214.84,
      "duration_seconds": 3.77,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.31,
      "end_seconds": 230.32,
      "duration_seconds": 3.01,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 264.39,
      "duration_seconds": 14.64,
      "text": "Okay: height 158 centimetres, temperature is 36.9 degrees. And BMI works out to 28.8, respiratory rate 15, oxygen saturation is 97 percent, blood pressure 122 over 79, weight 72 kilos, heart rate 69."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.82,
      "end_seconds": 267.42,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.48,
      "end_seconds": 270.94,
      "duration_seconds": 2.46,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.14,
      "end_seconds": 276.74,
      "duration_seconds": 3.6,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.73,
      "end_seconds": 279.93,
      "duration_seconds": 2.2,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.81,
      "end_seconds": 297.34,
      "duration_seconds": 3.53,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.24,
      "end_seconds": 304.81,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.89,
      "end_seconds": 323.55,
      "duration_seconds": 7.66,
      "text": "So, based on the history and the examination, this is probably low sugar episodes related to diabetes medication."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.03,
      "end_seconds": 328.56,
      "duration_seconds": 3.53,
      "text": "Uh, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.32,
      "end_seconds": 357.97,
      "duration_seconds": 28.65,
      "text": "It's reasonable to be concerned, but right now low sugar episodes related to diabetes medication is my leading thought, not anything worse. An HbA1c is what I'd like next, for diabetes control. Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Let's review you in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.92,
      "end_seconds": 363.33,
      "duration_seconds": 3.41,
      "text": "I think I understand everything. Thanks."
    }
  ]
}