{
  "schema_version": "1.0",
  "encounter_id": "01459",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.13,
      "end_seconds": 5.33,
      "duration_seconds": 4.2,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 10.77,
      "duration_seconds": 3.88,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.61,
      "end_seconds": 18.44,
      "duration_seconds": 6.83,
      "text": "Well, I've been having a twisted ankle. I've also had swelling around the ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 31.83,
      "duration_seconds": 9.55,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.27,
      "end_seconds": 41.61,
      "duration_seconds": 8.34,
      "text": "It happens on and off. Mostly moderate. I've also had pain walking, for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 42.51,
      "end_seconds": 51.9,
      "duration_seconds": 9.39,
      "text": "Okay, so the vitals from earlier. BP is 122 over 80, pulse 76. Temp 36.9 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.55,
      "end_seconds": 54.25,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.65,
      "end_seconds": 58.91,
      "duration_seconds": 3.26,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.21,
      "end_seconds": 64.74,
      "duration_seconds": 1.53,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.29,
      "end_seconds": 67.99,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.32,
      "end_seconds": 86.83,
      "duration_seconds": 9.51,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.69,
      "end_seconds": 98.37,
      "duration_seconds": 6.68,
      "text": "Good, you can sit up again. Any numbness in the foot or knee pain at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.17,
      "end_seconds": 106.18,
      "duration_seconds": 6.01,
      "text": "I haven't had numbness in the foot or knee pain, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.86,
      "end_seconds": 115.45,
      "duration_seconds": 8.59,
      "text": "A few quick ones: calf pain, cracking sound at the time or pain at the base of the fifth toe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.63,
      "end_seconds": 128.7,
      "duration_seconds": 12.07,
      "text": "Hmm, no calf pain, cracking sound at the time or pain at the base of the fifth toe, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.45,
      "end_seconds": 134.51,
      "duration_seconds": 5.06,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.48,
      "end_seconds": 138.62,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.59,
      "end_seconds": 142.09,
      "duration_seconds": 2.5,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.65,
      "end_seconds": 144.73,
      "duration_seconds": 1.08,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.34,
      "end_seconds": 149.3,
      "duration_seconds": 3.96,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.16,
      "end_seconds": 159.69,
      "duration_seconds": 8.53,
      "text": "I take amlodipine, 5 milligrams, once a day for my pressure. Losartan I don't take anymore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.79,
      "end_seconds": 174.08,
      "duration_seconds": 4.29,
      "text": "Alright, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.67,
      "end_seconds": 178.49,
      "duration_seconds": 2.82,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.79,
      "end_seconds": 184.39,
      "duration_seconds": 2.6,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.43,
      "end_seconds": 188.16,
      "duration_seconds": 2.73,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.22,
      "end_seconds": 210.48,
      "duration_seconds": 4.26,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.42,
      "end_seconds": 214.09,
      "duration_seconds": 2.67,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.88,
      "end_seconds": 230.58,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.56,
      "end_seconds": 239.03,
      "duration_seconds": 3.47,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.94,
      "end_seconds": 242.29,
      "duration_seconds": 2.35,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.03,
      "end_seconds": 246.34,
      "duration_seconds": 3.31,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.35,
      "end_seconds": 261.75,
      "duration_seconds": 14.4,
      "text": "From what you've told me and what I found, it's hard to say. An ankle sprain without signs of a fracture is one possibility and a small fracture another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.52,
      "end_seconds": 264.52,
      "duration_seconds": 2.0,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 287.0,
      "duration_seconds": 21.24,
      "text": "I understand the worry. At the moment I'd say it's an ankle sprain without signs of a fracture, and we'll know more once the an ankle X-ray is back. Just to be sure I understood. You've had a twisted ankle, and no calf pain or pain at the base of the fifth toe."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.2,
      "end_seconds": 290.12,
      "duration_seconds": 1.92,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.86,
      "end_seconds": 295.18,
      "duration_seconds": 4.32,
      "text": "We should do an ankle X-ray for ankle injury."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.06,
      "end_seconds": 299.17,
      "duration_seconds": 2.11,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.18,
      "end_seconds": 310.62,
      "duration_seconds": 10.44,
      "text": "We'll begin with paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. That's for ankle pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.48,
      "end_seconds": 314.61,
      "duration_seconds": 3.13,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.77,
      "end_seconds": 333.62,
      "duration_seconds": 17.85,
      "text": "Rest, ice, a firm bandage and keep it raised, and start gentle movement after two days. I'll also refer you to physiotherapy. I'd like to see you again if it isn't better in a week. So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.48,
      "end_seconds": 337.9,
      "duration_seconds": 2.42,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}