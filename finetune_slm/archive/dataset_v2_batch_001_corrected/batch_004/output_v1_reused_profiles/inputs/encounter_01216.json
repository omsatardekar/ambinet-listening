{
  "schema_version": "1.0",
  "encounter_id": "01216",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.78,
      "duration_seconds": 3.52,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 10.98,
      "duration_seconds": 4.32,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.61,
      "end_seconds": 17.76,
      "duration_seconds": 6.15,
      "text": "Um, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.72,
      "end_seconds": 23.0,
      "duration_seconds": 4.28,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.42,
      "end_seconds": 30.91,
      "duration_seconds": 6.49,
      "text": "I, I wanted to get terrible itching at night looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.37,
      "end_seconds": 34.11,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.63,
      "end_seconds": 37.46,
      "duration_seconds": 2.83,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.05,
      "end_seconds": 46.18,
      "duration_seconds": 3.13,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.27,
      "end_seconds": 52.41,
      "duration_seconds": 4.14,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.03,
      "end_seconds": 60.21,
      "duration_seconds": 2.18,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.99,
      "end_seconds": 66.04,
      "duration_seconds": 5.05,
      "text": "Hmm, being warm in bed definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.73,
      "end_seconds": 69.78,
      "duration_seconds": 2.05,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.87,
      "end_seconds": 76.98,
      "duration_seconds": 6.11,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.6,
      "end_seconds": 83.74,
      "duration_seconds": 6.14,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.19,
      "end_seconds": 87.84,
      "duration_seconds": 2.65,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.52,
      "end_seconds": 91.94,
      "duration_seconds": 2.42,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.81,
      "end_seconds": 105.28,
      "duration_seconds": 8.47,
      "text": "When it starts I tend to get a rash that started in the finger webs as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.82,
      "end_seconds": 113.44,
      "duration_seconds": 7.62,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 113.54,
      "end_seconds": 119.84,
      "duration_seconds": 6.3,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.86,
      "end_seconds": 130.32,
      "duration_seconds": 9.46,
      "text": "So, I was getting to that! The rash that started in the finger webs? That's been for two months."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.12,
      "end_seconds": 133.93,
      "duration_seconds": 2.81,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.43,
      "end_seconds": 141.27,
      "duration_seconds": 5.84,
      "text": "Severe, really. There's trouble sleeping because of it as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.52,
      "end_seconds": 161.67,
      "duration_seconds": 3.15,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.19,
      "end_seconds": 167.14,
      "duration_seconds": 4.95,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.66,
      "end_seconds": 169.97,
      "duration_seconds": 2.31,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.63,
      "end_seconds": 175.84,
      "duration_seconds": 5.21,
      "text": "I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.57,
      "end_seconds": 180.0,
      "duration_seconds": 3.43,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.94,
      "end_seconds": 194.07,
      "duration_seconds": 12.13,
      "text": "Two months now. Allopurinol. I take it 100 milligrams, once a day. Metoprolol. I take it 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 195.59,
      "end_seconds": 205.24,
      "duration_seconds": 9.65,
      "text": "Yeah, doctor, I think the last prescription for the metoprolol was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.35,
      "end_seconds": 211.24,
      "duration_seconds": 4.89,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.77,
      "end_seconds": 221.27,
      "duration_seconds": 8.5,
      "text": "No, I left it at home. I mean, it's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.45,
      "end_seconds": 229.37,
      "duration_seconds": 6.92,
      "text": "Any health conditions I should have on record? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.43,
      "end_seconds": 246.05,
      "duration_seconds": 14.62,
      "text": "I've got eczema. Gout, for about ten years. Yes, heart disease. I just want to get back to normal, really. Thin bones, for about ten years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.14,
      "end_seconds": 255.72,
      "duration_seconds": 8.58,
      "text": "Hm, okay. Alright, heart disease and thin bones, that matches what I have here. How about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.23,
      "end_seconds": 260.6,
      "duration_seconds": 4.37,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.49,
      "end_seconds": 263.19,
      "duration_seconds": 1.7,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.12,
      "end_seconds": 270.72,
      "duration_seconds": 6.6,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.11,
      "end_seconds": 274.1,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.05,
      "end_seconds": 279.4,
      "duration_seconds": 4.35,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.08,
      "end_seconds": 283.69,
      "duration_seconds": 3.61,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.96,
      "end_seconds": 289.61,
      "duration_seconds": 4.65,
      "text": "Let me think, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 292.3,
      "end_seconds": 300.75,
      "duration_seconds": 8.45,
      "text": "Actually, I remember he had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.21,
      "end_seconds": 306.51,
      "duration_seconds": 4.3,
      "text": "I mean, really? I don't think so."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.97,
      "end_seconds": 315.49,
      "duration_seconds": 7.52,
      "text": "Alright, so that's unclear. I'll record what each of you said. Have you had any new soaps?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.64,
      "end_seconds": 319.05,
      "duration_seconds": 2.41,
      "text": "Nope, no new soaps."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.69,
      "end_seconds": 329.28,
      "duration_seconds": 5.59,
      "text": "A few quick ones: rash on the face, joint pain, fever or pus?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.39,
      "end_seconds": 339.13,
      "duration_seconds": 8.74,
      "text": "Uh, you know, I haven't had rash on the face, joint pain, fever or pus, no."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.98,
      "end_seconds": 342.25,
      "duration_seconds": 2.27,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.5,
      "end_seconds": 345.2,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.04,
      "end_seconds": 348.5,
      "duration_seconds": 2.46,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.43,
      "end_seconds": 351.01,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.97,
      "end_seconds": 370.36,
      "duration_seconds": 2.39,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.67,
      "end_seconds": 382.2,
      "duration_seconds": 2.53,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.25,
      "end_seconds": 407.38,
      "duration_seconds": 8.13,
      "text": "Okay: pressure 117 over 77, heart rate 81, saturation 97 percent. And temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.11,
      "end_seconds": 414.11,
      "duration_seconds": 4.0,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.82,
      "end_seconds": 416.61,
      "duration_seconds": 1.79,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.42,
      "end_seconds": 421.52,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.86,
      "end_seconds": 435.02,
      "duration_seconds": 5.16,
      "text": "Tiny linear burrows between the fingers and scratched papules on the wrists."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 437.09,
      "end_seconds": 438.12,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.06,
      "end_seconds": 478.1,
      "duration_seconds": 34.04,
      "text": "Thank you, you can get dressed. Having listened and examined, this is probably scabies. We shouldn't forget an insect-bite reaction. I'll start you on permethrin cream, applied once, repeated in a week, for two applications. That's for scabies. Everyone in the house should be treated at the same time, and bedding washed hot. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.62,
      "end_seconds": 488.28,
      "duration_seconds": 8.66,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 489.6,
      "end_seconds": 491.5,
      "duration_seconds": 1.9,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 492.04,
      "end_seconds": 496.25,
      "duration_seconds": 4.21,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 496.86,
      "end_seconds": 500.42,
      "duration_seconds": 3.56,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 501.34,
      "end_seconds": 502.66,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}