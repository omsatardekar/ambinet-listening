{
  "schema_version": "1.0",
  "encounter_id": "01256",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 6.12,
      "duration_seconds": 5.38,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.32,
      "end_seconds": 11.45,
      "duration_seconds": 4.13,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.98,
      "end_seconds": 20.57,
      "duration_seconds": 7.59,
      "text": "I've, I've been feeling dizzy when I stand up, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.1,
      "end_seconds": 24.87,
      "duration_seconds": 2.77,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.6,
      "end_seconds": 32.82,
      "duration_seconds": 4.22,
      "text": "Um, it's been going on for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.66,
      "end_seconds": 42.37,
      "duration_seconds": 8.71,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.68,
      "end_seconds": 58.95,
      "duration_seconds": 15.27,
      "text": "I get some relief from sitting back down. It's a couple of times a week. And And I've been feeling weak as well, uh, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.43,
      "end_seconds": 74.65,
      "duration_seconds": 4.22,
      "text": "Alright, and what about fainting, slurred speech or black stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 78.04,
      "duration_seconds": 2.03,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.81,
      "end_seconds": 81.42,
      "duration_seconds": 2.61,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.31,
      "end_seconds": 85.67,
      "duration_seconds": 2.36,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.24,
      "end_seconds": 105.99,
      "duration_seconds": 2.75,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.51,
      "end_seconds": 112.44,
      "duration_seconds": 4.93,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.81,
      "end_seconds": 116.72,
      "duration_seconds": 2.91,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.63,
      "end_seconds": 121.33,
      "duration_seconds": 2.7,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.51,
      "end_seconds": 124.23,
      "duration_seconds": 1.72,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.64,
      "end_seconds": 129.25,
      "duration_seconds": 3.61,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.51,
      "end_seconds": 132.88,
      "duration_seconds": 2.37,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.78,
      "end_seconds": 138.47,
      "duration_seconds": 4.69,
      "text": "Ah, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.33,
      "end_seconds": 141.8,
      "duration_seconds": 2.47,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.13,
      "end_seconds": 148.56,
      "duration_seconds": 5.43,
      "text": "Oh, it's amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.69,
      "end_seconds": 153.85,
      "duration_seconds": 4.16,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.12,
      "end_seconds": 160.85,
      "duration_seconds": 5.73,
      "text": "Sorry, what was I saying, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.26,
      "end_seconds": 167.49,
      "duration_seconds": 5.23,
      "text": "okay, I can see high blood pressure in your file as well"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.4,
      "end_seconds": 181.81,
      "duration_seconds": 3.41,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.07,
      "end_seconds": 197.55,
      "duration_seconds": 2.48,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.19,
      "end_seconds": 225.41,
      "duration_seconds": 11.22,
      "text": "Okay: pulse is 108 beats a minute, SpO2 96 percent on room air. And respiratory rate 16, pressure 101 over 60, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.14,
      "end_seconds": 229.58,
      "duration_seconds": 3.44,
      "text": "Okay, so is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.6,
      "end_seconds": 234.4,
      "duration_seconds": 2.8,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 241.27,
      "duration_seconds": 4.58,
      "text": "let me look at the the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.12,
      "end_seconds": 244.13,
      "duration_seconds": 1.01,
      "text": "of course"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.35,
      "end_seconds": 247.61,
      "duration_seconds": 2.26,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.46,
      "end_seconds": 266.82,
      "duration_seconds": 6.36,
      "text": "your blood pressure drops when you stand, from the lying reading to standing"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 270.01,
      "duration_seconds": 1.29,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.26,
      "end_seconds": 285.02,
      "duration_seconds": 3.76,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.41,
      "end_seconds": 305.7,
      "duration_seconds": 17.29,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. It's hard to say. Postural low blood pressure, possibly related to medicines or dehydration is one possibility and dehydration another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.77,
      "end_seconds": 311.25,
      "duration_seconds": 3.48,
      "text": "Is this serious, you know, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.89,
      "end_seconds": 321.46,
      "duration_seconds": 9.57,
      "text": "I can't promise yet, but most people with postural low blood pressure, possibly related to medicines or dehydration do well once it's treated properly"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.39,
      "end_seconds": 355.91,
      "duration_seconds": 16.52,
      "text": "let's book blood tests to look into dizziness get up slowly from lying and sitting, and keep drinking fluids through the day one warning sign to remember: you faint or have chest pain in that case don't wait"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.22,
      "end_seconds": 358.88,
      "duration_seconds": 1.66,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.39,
      "end_seconds": 366.99,
      "duration_seconds": 5.6,
      "text": "Book a review after the results are back. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.42,
      "end_seconds": 371.33,
      "duration_seconds": 2.91,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.08,
      "end_seconds": 373.65,
      "duration_seconds": 1.57,
      "text": "have a good day"
    }
  ]
}