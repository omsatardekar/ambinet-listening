{
  "schema_version": "1.0",
  "encounter_id": "01272",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 4.52,
      "duration_seconds": 3.41,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 10.22,
      "duration_seconds": 4.76,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 17.22,
      "duration_seconds": 5.55,
      "text": "Yeah, it's occasional dizziness. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.03,
      "end_seconds": 20.53,
      "duration_seconds": 2.5,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.18,
      "end_seconds": 31.72,
      "duration_seconds": 9.54,
      "text": "Actually, it's lisinopril, 10 milligrams, once a day for my pressure. Gliclazide, 80 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.43,
      "end_seconds": 38.36,
      "duration_seconds": 4.93,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.36,
      "end_seconds": 41.6,
      "duration_seconds": 2.24,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.31,
      "end_seconds": 45.48,
      "duration_seconds": 3.17,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.57,
      "end_seconds": 50.04,
      "duration_seconds": 2.47,
      "text": "It's been two years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.31,
      "end_seconds": 60.07,
      "duration_seconds": 9.76,
      "text": "Hm, okay. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.62,
      "end_seconds": 64.99,
      "duration_seconds": 4.37,
      "text": "It's once or twice a day. Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.75,
      "end_seconds": 74.26,
      "duration_seconds": 3.51,
      "text": "Any a ringing in the ears as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.64,
      "end_seconds": 90.51,
      "duration_seconds": 14.87,
      "text": "Yeah, that too. I've also had headaches in the mornings, for six months. Right, about headaches in the mornings, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.74,
      "end_seconds": 105.43,
      "duration_seconds": 4.69,
      "text": "A few quick ones: weakness, breathlessness, chest pain or vision changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.28,
      "end_seconds": 109.88,
      "duration_seconds": 2.6,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.91,
      "end_seconds": 112.86,
      "duration_seconds": 1.95,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.69,
      "end_seconds": 118.08,
      "duration_seconds": 2.39,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.0,
      "end_seconds": 120.22,
      "duration_seconds": 1.22,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.58,
      "end_seconds": 124.53,
      "duration_seconds": 2.95,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.72,
      "end_seconds": 129.29,
      "duration_seconds": 3.57,
      "text": "Alright, what do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.23,
      "end_seconds": 133.89,
      "duration_seconds": 3.66,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.11,
      "end_seconds": 137.53,
      "duration_seconds": 2.42,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.85,
      "end_seconds": 142.06,
      "duration_seconds": 3.21,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.77,
      "end_seconds": 144.79,
      "duration_seconds": 2.02,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.63,
      "end_seconds": 149.54,
      "duration_seconds": 3.91,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.71,
      "end_seconds": 153.36,
      "duration_seconds": 2.65,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.0,
      "end_seconds": 161.73,
      "duration_seconds": 7.73,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.8,
      "end_seconds": 165.67,
      "duration_seconds": 2.87,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.71,
      "end_seconds": 170.89,
      "duration_seconds": 3.18,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.97,
      "end_seconds": 187.48,
      "duration_seconds": 5.51,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.72,
      "end_seconds": 190.3,
      "duration_seconds": 1.58,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.12,
      "end_seconds": 193.61,
      "duration_seconds": 2.49,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.98,
      "end_seconds": 197.14,
      "duration_seconds": 2.16,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.93,
      "end_seconds": 199.75,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.74,
      "end_seconds": 204.09,
      "duration_seconds": 2.35,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.22,
      "end_seconds": 211.15,
      "duration_seconds": 5.93,
      "text": "Mm-hmm. Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.99,
      "end_seconds": 228.39,
      "duration_seconds": 3.4,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.29,
      "end_seconds": 242.28,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.31,
      "end_seconds": 268.28,
      "duration_seconds": 9.97,
      "text": "Okay: respiratory rate 14, oxygen saturation is 96 percent, blood pressure 161 over 91, pulse 92, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.13,
      "end_seconds": 271.49,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.9,
      "end_seconds": 276.79,
      "duration_seconds": 3.89,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.47,
      "end_seconds": 280.6,
      "duration_seconds": 2.13,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.15,
      "end_seconds": 284.93,
      "duration_seconds": 2.78,
      "text": "Right, tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.0,
      "end_seconds": 294.8,
      "duration_seconds": 1.8,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.56,
      "end_seconds": 306.71,
      "duration_seconds": 9.15,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: I'd lean towards hypertension that isn't well controlled."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.0,
      "end_seconds": 310.96,
      "duration_seconds": 2.96,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.78,
      "end_seconds": 331.36,
      "duration_seconds": 19.58,
      "text": "I understand the worry. At the moment I'd say it's hypertension that isn't well controlled, and we'll watch how it goes. What I'm giving you is telmisartan, 40 milligrams, once a day, long term. You take it by mouth. It's for high blood pressure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.1,
      "end_seconds": 333.63,
      "duration_seconds": 1.53,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.13,
      "end_seconds": 343.5,
      "duration_seconds": 9.37,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.17,
      "end_seconds": 346.53,
      "duration_seconds": 1.36,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.68,
      "end_seconds": 350.83,
      "duration_seconds": 3.15,
      "text": "Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.44,
      "end_seconds": 359.34,
      "duration_seconds": 2.9,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.07,
      "end_seconds": 361.41,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}