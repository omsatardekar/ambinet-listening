  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've been getting breathless lying flat, and I wanted to get it checked.",
      "start_timestamp": "00:11",
      "end_timestamp": "00:17",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you tell me when it first started?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since this morning, that's when it began.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. It helps to be thorough at this stage.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I mean, it settles a little with extra pillows. Lying flat definitely sets it off. Mild, really.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does anything else come with it?",
      "start_timestamp": "00:52",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right, when it starts I tend to get swollen ankles as well. The swollen ankles? That's been for about two weeks. As for swollen ankles, it's all the time. I notice it more with evening.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had tiredness?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mm, yes.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's talk a little about your daily life and habits.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:34",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]",
        "medical_history.social_history[3]",
        "medical_history.social_history[4]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I quit smoking around ten years ago. I used to drink heavily but I stopped four years ago. My husband and I live above the shop. I work in accounts at a hospital. Lots of rice, lentils and some fruit.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:54",
      "supports": [
