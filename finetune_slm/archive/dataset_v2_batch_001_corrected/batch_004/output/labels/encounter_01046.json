        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Yes, carry on. Right, so asthma is already on your record. We'll keep that in mind today. A few questions about your lifestyle now.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:07",
      "supports": [
