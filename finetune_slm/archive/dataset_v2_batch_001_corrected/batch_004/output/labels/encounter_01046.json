        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "You are using your neck muscles to breathe, and your oxygen is low.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:02",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "So where does that leave us? I don't have a clear answer today: a severe asthma attack is possible, and so is a chest infection.",
