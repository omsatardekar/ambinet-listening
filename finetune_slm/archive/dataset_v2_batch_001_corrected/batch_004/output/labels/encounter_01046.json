    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay: pressure 126 over 76, heart rate 92. And saturation 91 percent, temperature is 37.3 degrees, respiratory rate 22.",
