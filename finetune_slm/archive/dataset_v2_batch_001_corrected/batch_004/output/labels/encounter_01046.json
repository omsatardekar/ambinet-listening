    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I used to drink heavily but I stopped four years ago. I'm a bus driver, so I sit for long hours. I hardly move around during the day.",
