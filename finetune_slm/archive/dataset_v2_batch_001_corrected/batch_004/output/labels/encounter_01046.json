      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I understand the worry. At the moment I'd say it's a severe asthma attack, and we'll know more once the a peak flow is back. I'd like to arrange a peak flow for asthma attack. We should do a chest X-ray for severe breathlessness.",
      "start_timestamp": "04:48",
      "end_timestamp": "05:09",
      "supports": [
        "clinical_assessment[0]",
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
