        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps",
      "start_timestamp": "01:00",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It's a few times a day. I get some relief from dry biscuits. About a three out of ten.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "have you had a missed period before, or is this the first time?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I had a similar thing last winter. It went away.",
