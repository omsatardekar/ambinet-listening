      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yes, diclofenac, it gives me wheezing. Yes, cat fur. I get sneezing.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:04",
      "supports": [
        "allergies[0]",
