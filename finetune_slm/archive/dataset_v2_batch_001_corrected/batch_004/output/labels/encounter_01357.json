      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[2]",
        "medical_history.past_medical_history[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I've got high blood pressure. I wasn't sure whether to come in at all, to be honest. Yes, high cholesterol. It's a relief to finally sit down and talk about it.",
