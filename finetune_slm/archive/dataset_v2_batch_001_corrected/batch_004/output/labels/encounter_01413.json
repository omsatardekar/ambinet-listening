  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Honestly, it's a sore throat, and my family pushed me to come. I did try to ignore it for a while.",
