      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has this been going on for long?",
      "start_timestamp": "00:23",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Erm, uh, it's been going on for about three months. I told myself I'd wait and see, and here I am. I've never really been one for hospitals.",
