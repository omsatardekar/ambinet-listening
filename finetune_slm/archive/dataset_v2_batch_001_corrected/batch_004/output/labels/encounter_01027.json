    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "so, can you tell me when it first started?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "it's been three weeks now",
