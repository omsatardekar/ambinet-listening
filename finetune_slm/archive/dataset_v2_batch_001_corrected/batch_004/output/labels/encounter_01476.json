        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "how long has that been going on?",
      "start_timestamp": "02:40",
      "end_timestamp": "02:43",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nearly five years now. I'm, I'm on something called simv... simvastatin, 20 milligrams, maybe, at night.",
