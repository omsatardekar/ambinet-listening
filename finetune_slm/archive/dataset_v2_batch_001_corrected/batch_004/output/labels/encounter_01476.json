  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's no appetite, doctor. She didn't want to come, but I insisted.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:29",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's the timeline, when did it begin?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "it's been going on for four weeks. Oh, and pain that started around my belly button then moved to the right. That's been about the same, two months",
      "start_timestamp": "00:37",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps",
      "start_timestamp": "00:52",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I notice it more with moving and and coughing. Honestly, once or twice a day. Oh, and a low fever. Ah, as for low fever, moderate, I'd say.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, have you had no appetite before, or is this the the first time?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, something like this happened last year, and it went away on its own.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "so, a few questions about your lifestyle now",
      "start_timestamp": "01:34",
      "end_timestamp": "01:38",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I'm vegetarian and have been for years",
      "start_timestamp": "01:38",
      "end_timestamp": "01:48",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been to theatre before?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:52",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I had a triple bypass, eight years ago.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me ask about allergies, anything at all?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:07",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hmm, um, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did.",
      "start_timestamp": "02:09",
      "end_timestamp": "02:22",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "which medicines do you take at the moment?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:27",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm on paracetamol, 650 milligrams, when needed. Clopidogrel. I take it 75 milligrams, once a day.",
