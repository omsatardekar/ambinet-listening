      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "It happens a few times a day.",
