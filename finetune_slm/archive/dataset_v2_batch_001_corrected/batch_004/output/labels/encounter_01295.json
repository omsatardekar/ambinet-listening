    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had an enlarged prostate for five years now. A neighbour of mine said I should see someone about it. I didn't want to make a fuss, um, you know.",
