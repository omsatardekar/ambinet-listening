    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a bus driver, so I sit for long hours. My husband and I live above the shop. Lots of rice, lentils and some fruit.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:14",
      "supports": [
