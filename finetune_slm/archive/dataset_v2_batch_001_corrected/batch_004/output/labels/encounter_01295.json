    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, right. Okay, I can see an enlarged prostate in your file as well. Which medicines do you take at the moment?",
      "start_timestamp": "03:46",
      "end_timestamp": "03:55",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "clinical_conditions[0]"
