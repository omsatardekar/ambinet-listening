    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "do you take any prescribed or over-the-counter medicines?",
      "start_timestamp": "03:10",
      "end_timestamp": "03:14",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "Seretide inhaler. I take it twice a day.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:19",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me tell you where I've got to. I think we're dealing with anaphylaxis at this stage.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:43",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's reasonable to be concerned, but right now anaphylaxis is my leading thought, not anything worse.",
      "start_timestamp": "03:49",
      "end_timestamp": "03:56",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I think monitoring makes sense here, for anaphylaxis. That will help us see what's going on underneath and decide the next step. Let's use adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now.",
      "start_timestamp": "04:13",
      "end_timestamp": "04:36",
      "supports": [
        "medications[1]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, go on. Let's get you seen by the emergency team, I'll arrange the letter. If the symptoms return, or you feel really unwell, please come to the emergency department.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:50",
      "supports": [
        "clinical_actions[3]",
