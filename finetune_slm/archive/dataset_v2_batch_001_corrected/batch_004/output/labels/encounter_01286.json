    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, go on. Let's talk a little about your daily life and habits.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:45",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]",
        "medical_history.social_history[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "I gave up cigarettes last spring. I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours. I swim twice a week.",
      "start_timestamp": "02:46",
      "end_timestamp": "03:00",
      "supports": [
