    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Let me think, I have asthma, for two years. I'm hoping you can tell me something definite.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:50",
      "supports": [
        "medical_history.past_medical_history[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Sure. Right, yes, asthma is known to us, good to have that clear. What about your parents, brothers or sisters, any conditions?",
