        "medical_history.social_history[1]",
        "medical_history.social_history[2]",
        "medical_history.social_history[3]",
        "medical_history.social_history[4]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay: SpO2 93 percent on room air, weight 63 kilos, height 170 centimetres, BP is 122 over 77, heart rate 102, respiratory rate 21, temperature is 37.6 degrees.",
      "start_timestamp": "03:48",
      "end_timestamp": "04:00",
      "supports": [
