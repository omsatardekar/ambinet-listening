        "vital_signs[6]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "From what you've told me, I think we're dealing with a severe asthma attack at this stage.",
      "start_timestamp": "04:10",
      "end_timestamp": "04:18",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "It's reasonable to be concerned, but right now a severe asthma attack is my leading thought, not anything worse. Let's book a chest X-ray to look into severe breathlessness.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:37",
      "supports": [
        "clinical_assessment[0]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "What I'm giving you is prednisolone, 40 milligrams, once now, single dose. It's for asthma attack. Sit upright and take slow breaths while the nebuliser is set up. I think the emergency team should see you too.",
      "start_timestamp": "04:42",
