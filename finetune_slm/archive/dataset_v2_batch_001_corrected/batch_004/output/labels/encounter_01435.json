    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'm on Seretide inhaler, twice a day. I didn't want to make a fuss, you know.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:35",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let's talk a little about your daily life and habits.",
      "start_timestamp": "02:51",
      "end_timestamp": "02:56",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]",
        "medical_history.social_history[3]",
        "medical_history.social_history[4]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I'm vegetarian and have been for years. I live with my elderly mother. I hardly move around during the day.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:18",
      "supports": [
