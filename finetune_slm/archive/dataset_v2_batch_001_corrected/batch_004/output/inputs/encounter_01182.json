{
  "schema_version": "1.0",
  "encounter_id": "01182",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 2.71,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.8,
      "end_seconds": 12.85,
      "duration_seconds": 4.05,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.12,
      "end_seconds": 18.33,
      "duration_seconds": 4.21,
      "text": "Um, so... pelvic pain. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.71,
      "end_seconds": 23.49,
      "duration_seconds": 3.78,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.12,
      "end_seconds": 30.72,
      "duration_seconds": 5.6,
      "text": "I take Thyronorm, 50 micrograms, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 32.19,
      "end_seconds": 37.38,
      "duration_seconds": 5.19,
      "text": "Doctor, our chart from the last visit lists it as 25 micrograms."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.88,
      "end_seconds": 42.54,
      "duration_seconds": 3.66,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.33,
      "end_seconds": 48.49,
      "duration_seconds": 5.16,
      "text": "Well, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.29,
      "end_seconds": 52.52,
      "duration_seconds": 2.23,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.53,
      "end_seconds": 57.67,
      "duration_seconds": 3.14,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.54,
      "end_seconds": 61.6,
      "duration_seconds": 2.06,
      "text": "have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.46,
      "end_seconds": 66.34,
      "duration_seconds": 2.88,
      "text": "Right, moving definitely sets it off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.9,
      "end_seconds": 70.96,
      "duration_seconds": 3.06,
      "text": "okay, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.02,
      "end_seconds": 92.41,
      "duration_seconds": 20.39,
      "text": "When it starts I tend to get pain with sex as well. I've also had a smelly discharge, for two weeks. The pain with sex? That's been for three days. As for pain with sex, I'd say on and off."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.12,
      "end_seconds": 100.1,
      "duration_seconds": 2.98,
      "text": "have you noticed vomiting or recent pregnancy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 108.98,
      "duration_seconds": 2.48,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.54,
      "end_seconds": 114.0,
      "duration_seconds": 3.46,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.49,
      "end_seconds": 117.1,
      "duration_seconds": 1.61,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.44,
      "end_seconds": 125.55,
      "duration_seconds": 4.11,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.41,
      "end_seconds": 129.63,
      "duration_seconds": 2.22,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.66,
      "end_seconds": 134.19,
      "duration_seconds": 3.53,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.06,
      "end_seconds": 140.53,
      "duration_seconds": 1.47,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.28,
      "end_seconds": 142.61,
      "duration_seconds": 1.33,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.31,
      "end_seconds": 146.26,
      "duration_seconds": 1.95,
      "text": "yes, an underactive thyroid"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.38,
      "end_seconds": 150.3,
      "duration_seconds": 0.92,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.11,
      "end_seconds": 162.18,
      "duration_seconds": 3.07,
      "text": "so, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.93,
      "end_seconds": 167.6,
      "duration_seconds": 3.67,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.55,
      "end_seconds": 171.75,
      "duration_seconds": 3.2,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.75,
      "end_seconds": 176.13,
      "duration_seconds": 3.38,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.16,
      "end_seconds": 179.69,
      "duration_seconds": 2.53,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.14,
      "end_seconds": 185.36,
      "duration_seconds": 4.22,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.14,
      "end_seconds": 203.17,
      "duration_seconds": 4.03,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.88,
      "end_seconds": 208.57,
      "duration_seconds": 1.69,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.32,
      "end_seconds": 211.71,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.86,
      "end_seconds": 215.83,
      "duration_seconds": 2.97,
      "text": "okay, so no, not at all"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.09,
      "end_seconds": 220.48,
      "duration_seconds": 3.39,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.98,
      "end_seconds": 224.09,
      "duration_seconds": 3.11,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 225.09,
      "end_seconds": 233.79,
      "duration_seconds": 8.7,
      "text": "Here are the numbers, doctor. Saturation 95 percent, temp 38.1 degrees, pulse is 93 beats a minute, BP is 114 over 74."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.47,
      "end_seconds": 236.68,
      "duration_seconds": 2.21,
      "text": "okay, good, thank you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.35,
      "end_seconds": 241.75,
      "duration_seconds": 3.4,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.67,
      "end_seconds": 245.46,
      "duration_seconds": 1.79,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.9,
      "end_seconds": 269.58,
      "duration_seconds": 7.68,
      "text": "you are very tender low in the tummy, and and it hurts when I move the cervix"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.89,
      "end_seconds": 275.64,
      "duration_seconds": 1.75,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.09,
      "end_seconds": 317.25,
      "duration_seconds": 28.16,
      "text": "Okay, so my impression is this: It points towards severe pelvic inflammatory disease. I can't rule out an abscess yet. I'll request a pelvic scan, it'll help with pelvic pain. I'd rather check than guess, and this is the quickest way to know more. I think blood tests makes sense here, for fever. Let's use ceftriaxone, 1 gram, once now, single dose. It's for pelvic infection."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.39,
      "end_seconds": 322.82,
      "duration_seconds": 4.43,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.75,
      "end_seconds": 347.35,
      "duration_seconds": 22.6,
      "text": "You need hospital treatment today. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.71,
      "end_seconds": 349.77,
      "duration_seconds": 1.06,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.73,
      "end_seconds": 363.26,
      "duration_seconds": 7.53,
      "text": "Let's review you straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.98,
      "end_seconds": 372.94,
      "duration_seconds": 7.96,
      "text": "So, I take the ceftriaxone, 1 gram, once now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.04,
      "end_seconds": 380.55,
      "duration_seconds": 5.51,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.72,
      "end_seconds": 385.98,
      "duration_seconds": 4.26,
      "text": "Yeah, good, thanks, I'll see you then."
    }
  ]
}