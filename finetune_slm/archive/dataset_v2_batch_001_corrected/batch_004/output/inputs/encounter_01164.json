{
  "schema_version": "1.0",
  "encounter_id": "01164",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.69,
      "duration_seconds": 4.51,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 10.92,
      "duration_seconds": 4.22,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.45,
      "end_seconds": 19.28,
      "duration_seconds": 7.83,
      "text": "Mm, honestly, it's a burn on my forearm, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.47,
      "end_seconds": 21.71,
      "duration_seconds": 1.24,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.31,
      "end_seconds": 29.93,
      "duration_seconds": 7.62,
      "text": "Since Friday, that's when it began. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.47,
      "end_seconds": 33.56,
      "duration_seconds": 2.09,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.56,
      "end_seconds": 39.34,
      "duration_seconds": 4.78,
      "text": "So, only cool water, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.63,
      "end_seconds": 44.1,
      "duration_seconds": 4.47,
      "text": "Yes. What about stinging pain, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.15,
      "end_seconds": 53.4,
      "duration_seconds": 7.25,
      "text": "Yes, about the same, three weeks. About stinging pain, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.27,
      "end_seconds": 57.5,
      "duration_seconds": 3.23,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.28,
      "end_seconds": 61.1,
      "duration_seconds": 1.82,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.49,
      "end_seconds": 65.05,
      "duration_seconds": 2.56,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.45,
      "end_seconds": 67.69,
      "duration_seconds": 1.24,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.89,
      "end_seconds": 74.31,
      "duration_seconds": 1.42,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.24,
      "end_seconds": 79.81,
      "duration_seconds": 3.57,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.72,
      "end_seconds": 83.31,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.59,
      "end_seconds": 89.77,
      "duration_seconds": 5.18,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.89,
      "end_seconds": 93.84,
      "duration_seconds": 2.95,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.78,
      "end_seconds": 99.58,
      "duration_seconds": 4.8,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.35,
      "end_seconds": 101.62,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.72,
      "end_seconds": 105.48,
      "duration_seconds": 2.76,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.37,
      "end_seconds": 114.99,
      "duration_seconds": 8.62,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.03,
      "end_seconds": 120.24,
      "duration_seconds": 3.21,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.64,
      "end_seconds": 124.12,
      "duration_seconds": 2.48,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.28,
      "end_seconds": 126.54,
      "duration_seconds": 1.26,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.25,
      "end_seconds": 148.05,
      "duration_seconds": 5.8,
      "text": "Have you had any burn to the face, numbness at the burn or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.55,
      "end_seconds": 158.19,
      "duration_seconds": 8.64,
      "text": "Um, I haven't had burn to the face, numbness at the burn or fever, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.99,
      "end_seconds": 164.16,
      "duration_seconds": 5.17,
      "text": "Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.85,
      "end_seconds": 167.34,
      "duration_seconds": 1.49,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.81,
      "end_seconds": 180.82,
      "duration_seconds": 2.01,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.4,
      "end_seconds": 191.36,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.42,
      "end_seconds": 208.73,
      "duration_seconds": 6.31,
      "text": "Okay: temperature 36.5, pulse 68. And blood pressure 127 over 69, respiratory rate 17."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.39,
      "end_seconds": 212.52,
      "duration_seconds": 2.13,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.01,
      "end_seconds": 226.72,
      "duration_seconds": 1.71,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.51,
      "end_seconds": 229.83,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 251.09,
      "duration_seconds": 6.07,
      "text": "It's a small superficial burn with an intact blister, about the size of a palm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.56,
      "end_seconds": 255.15,
      "duration_seconds": 1.59,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.52,
      "end_seconds": 296.82,
      "duration_seconds": 32.3,
      "text": "Right, here's what I'm thinking. The most likely explanation is a minor superficial burn. I'll start you on paracetamol, 1 gram, every six hours when needed, three days. You take it by mouth. That's for burn pain. Cool it under running water for twenty minutes if it happens again, and leave the blister intact. Let's plan a check in two days. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.5,
      "end_seconds": 310.57,
      "duration_seconds": 12.07,
      "text": "So, I take the paracetamol, 1 gram, every six hours when needed and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.51,
      "end_seconds": 315.84,
      "duration_seconds": 4.33,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.45,
      "end_seconds": 324.1,
      "duration_seconds": 6.65,
      "text": "Sorry, what was I saying, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.59,
      "end_seconds": 327.39,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}