{
  "schema_version": "1.0",
  "encounter_id": "01290",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 2.4,
      "duration_seconds": 1.49,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.1,
      "end_seconds": 7.6,
      "duration_seconds": 4.5,
      "text": "Okay, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.55,
      "end_seconds": 11.83,
      "duration_seconds": 3.28,
      "text": "I'm here because of a blocked nose"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.32,
      "end_seconds": 15.14,
      "duration_seconds": 1.82,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.37,
      "end_seconds": 19.68,
      "duration_seconds": 3.31,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.26,
      "end_seconds": 29.11,
      "duration_seconds": 7.85,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.44,
      "end_seconds": 34.07,
      "duration_seconds": 3.63,
      "text": "Mostly moderate. It settles a little with steam."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.92,
      "end_seconds": 38.34,
      "duration_seconds": 2.42,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.26,
      "end_seconds": 47.78,
      "duration_seconds": 3.52,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.27,
      "end_seconds": 64.03,
      "duration_seconds": 1.76,
      "text": "okay, do you smoke?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.38,
      "end_seconds": 68.2,
      "duration_seconds": 2.82,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.26,
      "end_seconds": 71.61,
      "duration_seconds": 2.35,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.28,
      "end_seconds": 76.38,
      "duration_seconds": 4.1,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.05,
      "end_seconds": 80.88,
      "duration_seconds": 2.83,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.98,
      "end_seconds": 86.54,
      "duration_seconds": 4.56,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.09,
      "end_seconds": 106.53,
      "duration_seconds": 3.44,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.23,
      "end_seconds": 111.47,
      "duration_seconds": 3.24,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.0,
      "end_seconds": 118.64,
      "duration_seconds": 5.64,
      "text": "Any double vision, severe headache, fever or swelling around the eye at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 122.81,
      "duration_seconds": 2.82,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.11,
      "end_seconds": 128.31,
      "duration_seconds": 4.2,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 131.8,
      "duration_seconds": 2.03,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.36,
      "end_seconds": 135.44,
      "duration_seconds": 3.08,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.93,
      "end_seconds": 138.57,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.06,
      "end_seconds": 142.53,
      "duration_seconds": 2.47,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.48,
      "end_seconds": 151.95,
      "duration_seconds": 2.47,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.69,
      "end_seconds": 178.65,
      "duration_seconds": 4.96,
      "text": "Okay: blood pressure 109 over 80, pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.96,
      "end_seconds": 183.71,
      "duration_seconds": 3.75,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.65,
      "end_seconds": 201.15,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.53,
      "end_seconds": 203.78,
      "duration_seconds": 1.25,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.05,
      "end_seconds": 221.8,
      "duration_seconds": 4.75,
      "text": "There is tenderness over both cheeks and the nasal lining looks swollen."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.94,
      "end_seconds": 225.32,
      "duration_seconds": 2.38,
      "text": "okay, you know, doctor"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 230.87,
      "duration_seconds": 1.88,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.71,
      "end_seconds": 268.47,
      "duration_seconds": 24.76,
      "text": "putting it all together, I'd lean towards chronic sinusitis. I want to be honest that this is an impression, not a final answer. I'd like you to take mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for sinus inflammation. Rinse your nose with saline twice a day. Let's review you in eight weeks"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.43,
      "end_seconds": 272.47,
      "duration_seconds": 3.04,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.03,
      "end_seconds": 276.85,
      "duration_seconds": 3.82,
      "text": "what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.97,
      "end_seconds": 291.75,
      "duration_seconds": 13.78,
      "text": "So, I take the mometasone nasal spray, 50 micrograms, two sprays each side once a day and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.59,
      "end_seconds": 296.9,
      "duration_seconds": 4.31,
      "text": "Yes, exactly right. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.84,
      "end_seconds": 300.34,
      "duration_seconds": 2.5,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.78,
      "end_seconds": 303.0,
      "duration_seconds": 1.22,
      "text": "All the best."
    }
  ]
}