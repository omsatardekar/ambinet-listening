{
  "schema_version": "1.0",
  "encounter_id": "01123",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.25,
      "duration_seconds": 4.55,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.8,
      "end_seconds": 14.56,
      "duration_seconds": 4.76,
      "text": "So, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.84,
      "end_seconds": 22.99,
      "duration_seconds": 7.15,
      "text": "It's hard stools, mostly. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.59,
      "end_seconds": 31.04,
      "duration_seconds": 3.45,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.61,
      "end_seconds": 40.25,
      "duration_seconds": 7.64,
      "text": "I'd say about three months. Actually, no, closer to six months. And mild bloating, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.91,
      "end_seconds": 44.3,
      "duration_seconds": 3.39,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.42,
      "end_seconds": 47.83,
      "duration_seconds": 2.41,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.92,
      "end_seconds": 55.1,
      "duration_seconds": 6.18,
      "text": "Okay, have you had any vomiting, severe pain or blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.19,
      "end_seconds": 58.15,
      "duration_seconds": 1.96,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.44,
      "end_seconds": 61.28,
      "duration_seconds": 1.84,
      "text": "Nothing like weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.5,
      "end_seconds": 65.54,
      "duration_seconds": 3.04,
      "text": "Not at all, no weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.47,
      "end_seconds": 70.65,
      "duration_seconds": 3.18,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.44,
      "end_seconds": 74.9,
      "duration_seconds": 2.46,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.87,
      "end_seconds": 82.49,
      "duration_seconds": 5.62,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.4,
      "end_seconds": 96.57,
      "duration_seconds": 12.17,
      "text": "I'm a hairdresser, on my feet all day. I live with my elderly mother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.47,
      "end_seconds": 114.47,
      "duration_seconds": 5.0,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.97,
      "end_seconds": 118.82,
      "duration_seconds": 2.85,
      "text": "Yes, erythromycin. I get a rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.75,
      "end_seconds": 133.05,
      "duration_seconds": 3.3,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.89,
      "end_seconds": 138.52,
      "duration_seconds": 1.63,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.95,
      "end_seconds": 142.42,
      "duration_seconds": 2.47,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.91,
      "end_seconds": 146.5,
      "duration_seconds": 2.59,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.47,
      "end_seconds": 160.33,
      "duration_seconds": 2.86,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.4,
      "end_seconds": 170.92,
      "duration_seconds": 9.52,
      "text": "I had a wisdom tooth extraction under sedation five years ago. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.89,
      "end_seconds": 175.55,
      "duration_seconds": 3.66,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.44,
      "end_seconds": 186.8,
      "duration_seconds": 2.36,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.03,
      "end_seconds": 221.79,
      "duration_seconds": 13.76,
      "text": "Okay: temp 36.7 degrees, height 177 centimetres, pressure 108 over 76, pulse 83, weight 68 kilos, BMI works out to 21.7, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.44,
      "end_seconds": 227.9,
      "duration_seconds": 3.46,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.36,
      "end_seconds": 242.15,
      "duration_seconds": 1.79,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.75,
      "end_seconds": 246.18,
      "duration_seconds": 2.43,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.81,
      "end_seconds": 264.89,
      "duration_seconds": 3.08,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.57,
      "end_seconds": 279.82,
      "duration_seconds": 11.25,
      "text": "Good, you can sit up again. Let me tell you where I've got to. My working impression is simple constipation from low fibre."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.99,
      "end_seconds": 284.18,
      "duration_seconds": 3.19,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.05,
      "end_seconds": 318.85,
      "duration_seconds": 33.8,
      "text": "Nothing I've seen today points to an emergency. It looks like simple constipation from low fibre. Let's use lactulose, 15 ml, twice a day, two weeks. That's for constipation. Eat more fruit, vegetables and oats, and drink two litres of water. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please come and see me if it persists after a month."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.93,
      "end_seconds": 322.91,
      "duration_seconds": 2.98,
      "text": "So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.76,
      "end_seconds": 326.71,
      "duration_seconds": 2.95,
      "text": "I think I understand everything. Thanks."
    }
  ]
}