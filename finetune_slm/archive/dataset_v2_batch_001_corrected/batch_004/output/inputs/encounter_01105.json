{
  "schema_version": "1.0",
  "encounter_id": "01105",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.72,
      "duration_seconds": 6.45,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.58,
      "end_seconds": 13.71,
      "duration_seconds": 5.13,
      "text": "Alright, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.71,
      "end_seconds": 18.64,
      "duration_seconds": 3.93,
      "text": "Well, I've been having a severe headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 26.51,
      "duration_seconds": 6.48,
      "text": "Has this been going on for long? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.91,
      "end_seconds": 42.58,
      "duration_seconds": 11.67,
      "text": "Actually, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.27,
      "end_seconds": 48.82,
      "duration_seconds": 4.55,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.38,
      "end_seconds": 66.26,
      "duration_seconds": 15.88,
      "text": "Well, uh, it feels severe to me. It just comes and goes. And I've been feeling confused as well, you know, for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.53,
      "end_seconds": 76.7,
      "duration_seconds": 6.17,
      "text": "Have you had a severe headache before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.44,
      "end_seconds": 84.3,
      "duration_seconds": 6.86,
      "text": "Ah, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.34,
      "end_seconds": 91.94,
      "duration_seconds": 3.6,
      "text": "Have you had any diarrhoea, cough or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.69,
      "end_seconds": 98.59,
      "duration_seconds": 4.9,
      "text": "I haven't had diarrhoea, cough or rash, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.75,
      "end_seconds": 103.46,
      "duration_seconds": 3.71,
      "text": "So, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.84,
      "end_seconds": 108.63,
      "duration_seconds": 3.79,
      "text": "I mean, no, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.21,
      "end_seconds": 126.71,
      "duration_seconds": 2.5,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.69,
      "end_seconds": 134.24,
      "duration_seconds": 5.55,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 137.18,
      "duration_seconds": 2.3,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.01,
      "end_seconds": 144.88,
      "duration_seconds": 5.87,
      "text": "It's lisinopril, 10 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.65,
      "end_seconds": 151.61,
      "duration_seconds": 4.96,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.13,
      "end_seconds": 157.01,
      "duration_seconds": 3.88,
      "text": "Mm, yes, trimethoprim. I get itching."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.92,
      "end_seconds": 175.73,
      "duration_seconds": 1.81,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.24,
      "end_seconds": 183.53,
      "duration_seconds": 6.29,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.73,
      "end_seconds": 187.1,
      "duration_seconds": 2.37,
      "text": "Alright, how are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.04,
      "end_seconds": 192.39,
      "duration_seconds": 4.35,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.79,
      "end_seconds": 199.52,
      "duration_seconds": 2.73,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.36,
      "end_seconds": 205.35,
      "duration_seconds": 4.99,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.48,
      "end_seconds": 207.75,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.39,
      "end_seconds": 211.51,
      "duration_seconds": 3.12,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.24,
      "end_seconds": 216.52,
      "duration_seconds": 3.28,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.25,
      "end_seconds": 219.59,
      "duration_seconds": 2.34,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.34,
      "end_seconds": 226.09,
      "duration_seconds": 4.75,
      "text": "Yes, carry on. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.01,
      "end_seconds": 238.49,
      "duration_seconds": 2.48,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.71,
      "end_seconds": 260.71,
      "duration_seconds": 7.0,
      "text": "Okay: temperature is 38.7 degrees, saturation 96 percent, pulse 106. And pressure 118 over 71."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.17,
      "end_seconds": 264.26,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.11,
      "end_seconds": 270.13,
      "duration_seconds": 4.02,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.47,
      "end_seconds": 276.53,
      "duration_seconds": 4.06,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.71,
      "end_seconds": 279.78,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.92,
      "end_seconds": 300.38,
      "duration_seconds": 4.46,
      "text": "You are hot and jaundiced, and your spleen is tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.61,
      "end_seconds": 306.19,
      "duration_seconds": 1.58,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.78,
      "end_seconds": 328.64,
      "duration_seconds": 9.86,
      "text": "Let me tell you where I've got to. I can't pin this down yet. We're looking at possible malaria after travel or dengue."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.07,
      "end_seconds": 334.22,
      "duration_seconds": 4.15,
      "text": "Erm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.05,
      "end_seconds": 357.14,
      "duration_seconds": 17.09,
      "text": "I understand the worry. At the moment I'd say it's possible malaria after travel, and we'll know more once the blood tests is back. Blood tests is what I'd like next, for fever after travel."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 360.74,
      "end_seconds": 364.29,
      "duration_seconds": 3.55,
      "text": "I can book that for Monday at 10 am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.87,
      "end_seconds": 395.43,
      "duration_seconds": 30.56,
      "text": "I'd like to arrange urgent blood films for fever after travel. The result will help us decide whether anything more is needed. You need hospital assessment today, this can become serious fast. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please come and see me straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.48,
      "end_seconds": 402.39,
      "duration_seconds": 4.91,
      "text": "Yeah, uh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.49,
      "end_seconds": 405.73,
      "duration_seconds": 1.24,
      "text": "Take care now."
    }
  ]
}