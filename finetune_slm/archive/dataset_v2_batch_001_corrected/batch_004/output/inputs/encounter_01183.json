{
  "schema_version": "1.0",
  "encounter_id": "01183",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 5.06,
      "duration_seconds": 4.49,
      "text": "hello take a seat I'll be with you in a second"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.45,
      "end_seconds": 9.33,
      "duration_seconds": 2.88,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.04,
      "end_seconds": 12.21,
      "duration_seconds": 2.17,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.8,
      "end_seconds": 18.93,
      "duration_seconds": 5.13,
      "text": "I wanted to get a stiff painful shoulder looked at"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 22.52,
      "duration_seconds": 2.74,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.9,
      "end_seconds": 34.22,
      "duration_seconds": 2.32,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.21,
      "end_seconds": 60.41,
      "duration_seconds": 10.2,
      "text": "Okay: pulse is 79 beats a a minute, oxygen saturation is 98 percent, pressure 112 over 77, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.68,
      "end_seconds": 73.8,
      "duration_seconds": 3.12,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.27,
      "end_seconds": 78.61,
      "duration_seconds": 3.34,
      "text": "it's been going on for two weeks"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.74,
      "end_seconds": 82.0,
      "duration_seconds": 2.26,
      "text": "what eases it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.05,
      "end_seconds": 87.21,
      "duration_seconds": 3.16,
      "text": "Only rest, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.92,
      "end_seconds": 93.47,
      "duration_seconds": 5.55,
      "text": "Let me check a few things. Any fall, neck pain or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.84,
      "end_seconds": 98.64,
      "duration_seconds": 3.8,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.06,
      "end_seconds": 104.43,
      "duration_seconds": 3.37,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.48,
      "end_seconds": 108.57,
      "duration_seconds": 2.09,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.36,
      "end_seconds": 123.78,
      "duration_seconds": 1.42,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.63,
      "end_seconds": 126.27,
      "duration_seconds": 1.64,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.25,
      "end_seconds": 129.13,
      "duration_seconds": 0.88,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.79,
      "end_seconds": 133.21,
      "duration_seconds": 2.42,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.69,
      "end_seconds": 137.42,
      "duration_seconds": 2.73,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.15,
      "end_seconds": 143.12,
      "duration_seconds": 3.97,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.53,
      "end_seconds": 146.29,
      "duration_seconds": 1.76,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.73,
      "end_seconds": 150.31,
      "duration_seconds": 2.58,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.26,
      "end_seconds": 155.15,
      "duration_seconds": 2.89,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.18,
      "end_seconds": 160.38,
      "duration_seconds": 3.2,
      "text": "I take ibuprofen 400 milligrams when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.9,
      "end_seconds": 165.5,
      "duration_seconds": 3.6,
      "text": "any medical conditions anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.47,
      "end_seconds": 170.74,
      "duration_seconds": 3.27,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.71,
      "end_seconds": 176.39,
      "duration_seconds": 3.68,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.56,
      "end_seconds": 181.3,
      "duration_seconds": 3.74,
      "text": "No, I'm not allergic to to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.43,
      "end_seconds": 187.53,
      "duration_seconds": 4.1,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.41,
      "end_seconds": 191.01,
      "duration_seconds": 2.6,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.98,
      "end_seconds": 212.0,
      "duration_seconds": 4.02,
      "text": "Movement is limited in all directions, both active and passive."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.28,
      "end_seconds": 227.88,
      "duration_seconds": 1.6,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.34,
      "end_seconds": 244.99,
      "duration_seconds": 11.65,
      "text": "you can relax now taking everything into account, it points towards adhesive capsulitis, a frozen shoulder that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.92,
      "end_seconds": 250.36,
      "duration_seconds": 3.44,
      "text": "What are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.1,
      "end_seconds": 276.88,
      "duration_seconds": 24.78,
      "text": "I understand the worry. At the moment I'd say it's adhesive capsulitis, a frozen shoulder and we'll know more once the an X-ray of the shoulder is back. Stop me if I've got anything wrong. You've had a stiff painful shoulder for two weeks and no neck pain or numbness"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.88,
      "end_seconds": 279.58,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.4,
      "end_seconds": 301.74,
      "duration_seconds": 4.34,
      "text": "We should do an X-ray of the shoulder for shoulder pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.11,
      "end_seconds": 305.19,
      "duration_seconds": 2.08,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.57,
      "end_seconds": 312.5,
      "duration_seconds": 5.93,
      "text": "I'll want another look in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.49,
      "end_seconds": 319.85,
      "duration_seconds": 3.36,
      "text": "Good thanks I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.51,
      "end_seconds": 326.55,
      "duration_seconds": 2.04,
      "text": "Alright, look after yourself."
    }
  ]
}