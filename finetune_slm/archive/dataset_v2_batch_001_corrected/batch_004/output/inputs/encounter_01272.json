{
  "schema_version": "1.0",
  "encounter_id": "01272",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 6.37,
      "duration_seconds": 5.79,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 12.11,
      "duration_seconds": 4.53,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.51,
      "end_seconds": 16.71,
      "duration_seconds": 3.2,
      "text": "It's a red sticky eye, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.01,
      "end_seconds": 21.09,
      "duration_seconds": 3.08,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.14,
      "end_seconds": 32.08,
      "duration_seconds": 2.94,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.85,
      "end_seconds": 64.9,
      "duration_seconds": 11.05,
      "text": "Okay: temperature 36.9, pulse 64, pressure 115 over 68. And SpO2 98 percent on room air, weight 59 kilos, height 153 centimetres."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.27,
      "end_seconds": 67.95,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.34,
      "end_seconds": 74.63,
      "duration_seconds": 5.29,
      "text": "So, we'll go over that shortly. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 78.8,
      "duration_seconds": 2.76,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.31,
      "end_seconds": 82.4,
      "duration_seconds": 2.09,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.44,
      "end_seconds": 96.71,
      "duration_seconds": 13.27,
      "text": "It usually comes with crusting in the morning. The crusting in the morning? That's been since last Tuesday. Yeah, about crusting in the morning, mostly mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.69,
      "end_seconds": 100.94,
      "duration_seconds": 3.25,
      "text": "Okay, has there been a gritty feeling too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.93,
      "end_seconds": 109.76,
      "duration_seconds": 7.83,
      "text": "Yeah. Two months, I'd say. About gritty feeling, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.38,
      "end_seconds": 120.62,
      "duration_seconds": 9.24,
      "text": "Let me check a few things. Any blurred vision, contact lens, sensitivity to light or pain in the eye?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.57,
      "end_seconds": 124.72,
      "duration_seconds": 2.15,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.99,
      "end_seconds": 126.88,
      "duration_seconds": 1.89,
      "text": "Understood. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.93,
      "end_seconds": 131.04,
      "duration_seconds": 2.11,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.76,
      "end_seconds": 135.22,
      "duration_seconds": 3.46,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.36,
      "end_seconds": 140.73,
      "duration_seconds": 4.37,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.53,
      "end_seconds": 146.94,
      "duration_seconds": 5.41,
      "text": "Let's run through your medicines. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.48,
      "end_seconds": 155.14,
      "duration_seconds": 6.66,
      "text": "I'm on escitalopram, 10 milligrams, once a day. Tiotropium inhaler I don't take anymore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.77,
      "end_seconds": 162.3,
      "duration_seconds": 3.53,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.07,
      "end_seconds": 167.03,
      "duration_seconds": 3.96,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 171.78,
      "duration_seconds": 3.01,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.07,
      "end_seconds": 176.72,
      "duration_seconds": 3.65,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.61,
      "end_seconds": 181.2,
      "duration_seconds": 2.59,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.54,
      "end_seconds": 185.86,
      "duration_seconds": 3.32,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.08,
      "end_seconds": 190.89,
      "duration_seconds": 3.81,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.99,
      "end_seconds": 199.6,
      "duration_seconds": 7.61,
      "text": "I have anxiety, for about ten years. I have COPD, for nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.61,
      "end_seconds": 204.06,
      "duration_seconds": 3.45,
      "text": "Alright, COPD, that matches what I have here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.04,
      "end_seconds": 222.66,
      "duration_seconds": 2.62,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.81,
      "end_seconds": 226.61,
      "duration_seconds": 2.8,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.39,
      "end_seconds": 233.84,
      "duration_seconds": 4.45,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.14,
      "end_seconds": 249.88,
      "duration_seconds": 1.74,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.33,
      "end_seconds": 254.59,
      "duration_seconds": 3.26,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.92,
      "end_seconds": 269.76,
      "duration_seconds": 7.84,
      "text": "The white of the eye is pink with some sticky discharge, and your pupil is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.88,
      "end_seconds": 277.27,
      "duration_seconds": 2.39,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.63,
      "end_seconds": 293.37,
      "duration_seconds": 4.74,
      "text": "Right, here's what I'm thinking. This looks most like infective conjunctivitis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.9,
      "end_seconds": 296.89,
      "duration_seconds": 1.99,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.8,
      "end_seconds": 314.67,
      "duration_seconds": 15.87,
      "text": "Nothing I've seen today points to an emergency. It looks like infective conjunctivitis. Okay, I don't need to add any tests or treatment at this point. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.66,
      "end_seconds": 320.09,
      "duration_seconds": 3.43,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.73,
      "end_seconds": 323.13,
      "duration_seconds": 1.4,
      "text": "Look after yourself."
    }
  ]
}