{
  "schema_version": "1.0",
  "encounter_id": "01375",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.04,
      "duration_seconds": 2.14,
      "text": "Okay, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.13,
      "end_seconds": 12.47,
      "duration_seconds": 5.34,
      "text": "Well, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.17,
      "end_seconds": 17.19,
      "duration_seconds": 3.02,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.59,
      "end_seconds": 26.46,
      "duration_seconds": 4.87,
      "text": "We came because of a tight band around my head."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.07,
      "end_seconds": 35.55,
      "duration_seconds": 8.48,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.86,
      "end_seconds": 56.1,
      "duration_seconds": 16.24,
      "text": "I'd call it severe. I'd say a few times a day. Oh, and tired eyes. That's been about the same, about two weeks. I had a stiff neck before. That's settled now, though."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.8,
      "end_seconds": 62.44,
      "duration_seconds": 4.64,
      "text": "A few quick ones: sickness, sensitivity to light or weakness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.18,
      "end_seconds": 71.97,
      "duration_seconds": 7.79,
      "text": "Sorry, what was I saying, no, no sickness, sensitivity to light or weakness."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.81,
      "end_seconds": 74.37,
      "duration_seconds": 1.56,
      "text": "What about blurred vision?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.39,
      "end_seconds": 80.02,
      "duration_seconds": 3.63,
      "text": "Right, I haven't noticed any blurred vision."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.98,
      "end_seconds": 84.5,
      "duration_seconds": 2.52,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.34,
      "end_seconds": 88.26,
      "duration_seconds": 1.92,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.47,
      "end_seconds": 91.93,
      "duration_seconds": 2.46,
      "text": "Right, has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.95,
      "end_seconds": 94.9,
      "duration_seconds": 0.95,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.78,
      "end_seconds": 101.46,
      "duration_seconds": 4.68,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.09,
      "end_seconds": 105.47,
      "duration_seconds": 3.38,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.66,
      "end_seconds": 117.57,
      "duration_seconds": 3.91,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.16,
      "end_seconds": 119.99,
      "duration_seconds": 1.83,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.05,
      "end_seconds": 124.49,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.37,
      "end_seconds": 127.84,
      "duration_seconds": 1.47,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.99,
      "end_seconds": 145.76,
      "duration_seconds": 4.77,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.77,
      "end_seconds": 162.35,
      "duration_seconds": 15.58,
      "text": "I smoke roughly a pack every two days. I'm vegetarian and have been for years. I walk the dog every morning. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.32,
      "end_seconds": 167.87,
      "duration_seconds": 3.55,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.79,
      "end_seconds": 178.04,
      "duration_seconds": 8.25,
      "text": "An underactive thyroid, for about a year. I've, I've had depression for two years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 182.55,
      "duration_seconds": 2.85,
      "text": "Right, right. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.14,
      "end_seconds": 187.83,
      "duration_seconds": 3.69,
      "text": "Thyronorm. I take it 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.84,
      "end_seconds": 201.27,
      "duration_seconds": 8.43,
      "text": "Uh, it's meant to be every morning, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.32,
      "end_seconds": 209.4,
      "duration_seconds": 7.08,
      "text": "Let me think, um, I take sertraline, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 214.72,
      "duration_seconds": 4.01,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.12,
      "end_seconds": 223.54,
      "duration_seconds": 7.42,
      "text": "Not with me. I'll bring it next time. Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 240.06,
      "duration_seconds": 2.74,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.12,
      "end_seconds": 251.23,
      "duration_seconds": 2.11,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.0,
      "end_seconds": 270.08,
      "duration_seconds": 6.08,
      "text": "Okay: temperature is 36.7 degrees, heart rate 73, blood pressure 112 over 79."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.54,
      "end_seconds": 272.96,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.84,
      "end_seconds": 276.18,
      "duration_seconds": 2.34,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.61,
      "end_seconds": 282.43,
      "duration_seconds": 4.82,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.52,
      "end_seconds": 285.7,
      "duration_seconds": 1.18,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.71,
      "end_seconds": 287.89,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 306.73,
      "duration_seconds": 5.21,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.66,
      "end_seconds": 328.07,
      "duration_seconds": 16.41,
      "text": "Right, please sit back down. So where does that leave us? I can't pin this down yet. We're looking at tension-type headache or eye strain. I'm going to order an eye test, for eye strain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.63,
      "end_seconds": 332.34,
      "duration_seconds": 2.71,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.19,
      "end_seconds": 347.03,
      "duration_seconds": 13.84,
      "text": "Take screen breaks every hour and try regular neck stretches. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 347.79,
      "end_seconds": 349.5,
      "duration_seconds": 1.71,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.93,
      "end_seconds": 358.09,
      "duration_seconds": 7.16,
      "text": "I'd like you back in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.45,
      "end_seconds": 362.86,
      "duration_seconds": 3.41,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}