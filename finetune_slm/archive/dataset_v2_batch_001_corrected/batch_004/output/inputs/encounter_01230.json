      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.75,
      "end_seconds": 342.63,
      "duration_seconds": 17.88,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, it fits best with poorly controlled asthma. I'm going to order a peak flow reading, for asthma. I'm going to order spirometry, for asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.97,
      "end_seconds": 348.57,
      "duration_seconds": 4.6,
      "text": "sorry, what was I saying, okay, I'll do it"
    },
