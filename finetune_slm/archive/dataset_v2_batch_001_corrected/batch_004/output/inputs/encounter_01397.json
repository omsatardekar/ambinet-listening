{
  "schema_version": "1.0",
  "encounter_id": "01397",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 4.98,
      "duration_seconds": 4.28,
      "text": "Hi doctor, uh, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 10.95,
      "duration_seconds": 3.91,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.89,
      "end_seconds": 19.21,
      "duration_seconds": 6.32,
      "text": "Yeah, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 23.26,
      "duration_seconds": 2.57,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.11,
      "end_seconds": 35.81,
      "duration_seconds": 11.7,
      "text": "Yeah, it's pain that started around my belly button then moved to the right, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.54,
      "end_seconds": 39.74,
      "duration_seconds": 3.2,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 45.56,
      "duration_seconds": 4.4,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.29,
      "end_seconds": 49.24,
      "duration_seconds": 2.95,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.63,
      "end_seconds": 52.93,
      "duration_seconds": 1.3,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.48,
      "end_seconds": 56.91,
      "duration_seconds": 2.43,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.11,
      "end_seconds": 64.72,
      "duration_seconds": 6.61,
      "text": "When it starts I tend to get a low fever as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.39,
      "end_seconds": 72.25,
      "duration_seconds": 6.86,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 72.35,
      "end_seconds": 78.87,
      "duration_seconds": 6.52,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.9,
      "end_seconds": 88.73,
      "duration_seconds": 8.83,
      "text": "Actually, I was getting to that! Okay, so the low fever? That's been for two months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.65,
      "end_seconds": 101.02,
      "duration_seconds": 10.37,
      "text": "Have you had pain that started around your belly button then moved to the right before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.14,
      "end_seconds": 111.31,
      "duration_seconds": 9.17,
      "text": "Um, you know, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 111.88,
      "end_seconds": 116.09,
      "duration_seconds": 4.21,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.01,
      "end_seconds": 131.49,
      "duration_seconds": 3.48,
      "text": "Okay, have you noticed diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.87,
      "end_seconds": 144.38,
      "duration_seconds": 11.51,
      "text": "Actually, you know, no, no diarrhoea, no cough. I was feeling sick at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.36,
      "end_seconds": 148.9,
      "duration_seconds": 2.54,
      "text": "Have you had any urinary symptoms?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 152.11,
      "duration_seconds": 1.98,
      "text": "No. No urinary symptoms."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.71,
      "end_seconds": 155.25,
      "duration_seconds": 2.54,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.58,
      "end_seconds": 162.7,
      "duration_seconds": 3.12,
      "text": "Well, no, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.74,
      "end_seconds": 166.88,
      "duration_seconds": 3.14,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.97,
      "end_seconds": 171.18,
      "duration_seconds": 2.21,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.88,
      "end_seconds": 175.47,
      "duration_seconds": 3.59,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.13,
      "end_seconds": 180.9,
      "duration_seconds": 3.77,
      "text": "It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.43,
      "end_seconds": 183.84,
      "duration_seconds": 1.41,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.32,
      "end_seconds": 191.09,
      "duration_seconds": 5.77,
      "text": "For about a year. Rosuvastatin, 10 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.61,
      "end_seconds": 196.49,
      "duration_seconds": 4.88,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.43,
      "end_seconds": 207.94,
      "duration_seconds": 10.51,
      "text": "Mm, not with me. I'll bring it next time. Mm, I used to take simvastatin, but I stopped it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.89,
      "end_seconds": 213.73,
      "duration_seconds": 3.84,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.3,
      "end_seconds": 219.85,
      "duration_seconds": 4.55,
      "text": "Okay, uh, so my sister had breast cancer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.58,
      "end_seconds": 228.89,
      "duration_seconds": 3.31,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.35,
      "end_seconds": 242.42,
      "duration_seconds": 12.07,
      "text": "Sorry, you know, what was I saying, I've had thin bones, yes. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.17,
      "end_seconds": 245.13,
      "duration_seconds": 0.96,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.75,
      "end_seconds": 257.86,
      "duration_seconds": 12.11,
      "text": "I've had high cholesterol for five years now. I told myself I'd wait and see, um, and here I am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.19,
      "end_seconds": 264.43,
      "duration_seconds": 5.24,
      "text": "Yes, thin bones is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.66,
      "end_seconds": 276.05,
      "duration_seconds": 3.39,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.07,
      "end_seconds": 284.56,
      "duration_seconds": 6.49,
      "text": "Not currently, you know, but as a youngster tramadol gave me vomiting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.1,
      "end_seconds": 287.87,
      "duration_seconds": 2.77,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.22,
      "end_seconds": 297.26,
      "duration_seconds": 3.04,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 298.19,
      "end_seconds": 306.13,
      "duration_seconds": 7.94,
      "text": "Okay, so the vitals from earlier. BP is 104 over 73, temp 38.1 degrees. Heart rate 104, saturation 97 percent."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.9,
      "end_seconds": 309.79,
      "duration_seconds": 1.89,
      "text": "Right, good, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.04,
      "end_seconds": 314.92,
      "duration_seconds": 3.88,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.38,
      "end_seconds": 317.76,
      "duration_seconds": 1.38,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.19,
      "end_seconds": 334.82,
      "duration_seconds": 7.63,
      "text": "It hurts most low on the right and it hurts when I let go of the pressure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.63,
      "end_seconds": 337.85,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.23,
      "end_seconds": 369.48,
      "duration_seconds": 26.25,
      "text": "Okay, that's enough for me. So where does that leave us? I don't have a clear answer today: possible appendicitis is possible, and so is gynaecological pain. Stop me if I've got anything wrong. You've had pain that started around your belly button then moved to the right for one week, mild, and no cough or urinary symptoms."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.71,
      "end_seconds": 374.9,
      "duration_seconds": 4.19,
      "text": "Actually, uh, that's what happened, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.97,
      "end_seconds": 413.4,
      "duration_seconds": 34.43,
      "text": "Let's book an ultrasound or CT scan to look into possible appendicitis. That will help us see what's going on underneath and decide the next step. Let's book urgent blood tests to look into abdominal pain. You need to go to hospital now and not eat or drink. I'll also refer you to the surgical team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.31,
      "end_seconds": 422.32,
      "duration_seconds": 7.01,
      "text": "We'll catch up straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.8,
      "end_seconds": 427.47,
      "duration_seconds": 3.67,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}