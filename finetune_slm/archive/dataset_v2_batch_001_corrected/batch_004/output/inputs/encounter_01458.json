{
  "schema_version": "1.0",
  "encounter_id": "01458",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 5.57,
      "duration_seconds": 4.63,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 10.67,
      "duration_seconds": 4.25,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.67,
      "end_seconds": 19.63,
      "duration_seconds": 6.96,
      "text": "Hello, um, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.2,
      "end_seconds": 27.78,
      "duration_seconds": 3.58,
      "text": "Right, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.21,
      "end_seconds": 40.89,
      "duration_seconds": 11.68,
      "text": "Let me think, uh, I've been sweating a lot. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.68,
      "end_seconds": 47.67,
      "duration_seconds": 4.99,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.74,
      "end_seconds": 57.65,
      "duration_seconds": 8.91,
      "text": "It's, It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.68,
      "end_seconds": 62.08,
      "duration_seconds": 2.4,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.83,
      "end_seconds": 83.46,
      "duration_seconds": 20.63,
      "text": "For my blood pressure, I believe. My son sets them out for me, I just take what I'm given. Alendronate. I take it 70 milligrams, once a week for my bones. Aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.16,
      "end_seconds": 87.55,
      "duration_seconds": 3.39,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.21,
      "end_seconds": 91.77,
      "duration_seconds": 3.56,
      "text": "Around a week, uh, I think."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 92.31,
      "end_seconds": 97.73,
      "duration_seconds": 5.42,
      "text": "I think it's been nearer two weeks, um, actually"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.99,
      "end_seconds": 103.73,
      "duration_seconds": 4.74,
      "text": "okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 105.42,
      "duration_seconds": 1.01,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.88,
      "end_seconds": 112.11,
      "duration_seconds": 5.23,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.88,
      "end_seconds": 118.77,
      "duration_seconds": 4.89,
      "text": "I'd say every other day. It feels mild to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.35,
      "end_seconds": 127.61,
      "duration_seconds": 3.26,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.99,
      "end_seconds": 135.56,
      "duration_seconds": 6.57,
      "text": "when it starts I tend to get a racing heart as well"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 142.09,
      "duration_seconds": 5.71,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 142.19,
      "end_seconds": 148.69,
      "duration_seconds": 6.5,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.4,
      "end_seconds": 152.26,
      "duration_seconds": 2.86,
      "text": "Later, thanks. Please go on. Any diarrhoea?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.94,
      "end_seconds": 154.4,
      "duration_seconds": 1.46,
      "text": "definitely no diarrhoea"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 155.47,
      "end_seconds": 160.81,
      "duration_seconds": 5.34,
      "text": "actually, doctor, I did notice diarrhoea she doesn't always say"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 170.75,
      "duration_seconds": 8.05,
      "text": "Okay, so no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.69,
      "end_seconds": 180.89,
      "duration_seconds": 9.2,
      "text": "alright, I'll note both what you've said and what you've noticed okay, did you get chest pain or neck pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.71,
      "end_seconds": 192.62,
      "duration_seconds": 10.91,
      "text": "No, no chest pain, no neck pain. I did have bulging eyes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.44,
      "end_seconds": 197.68,
      "duration_seconds": 3.24,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.64,
      "end_seconds": 200.12,
      "duration_seconds": 1.48,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.75,
      "end_seconds": 202.73,
      "duration_seconds": 1.98,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.1,
      "end_seconds": 207.75,
      "duration_seconds": 2.65,
      "text": "Yeah, no, all normal there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.07,
      "end_seconds": 213.08,
      "duration_seconds": 4.01,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.58,
      "end_seconds": 218.48,
      "duration_seconds": 3.9,
      "text": "I have high blood pressure, for two years"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.51,
      "end_seconds": 220.36,
      "duration_seconds": 0.85,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.61,
      "end_seconds": 223.42,
      "duration_seconds": 1.81,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.82,
      "end_seconds": 226.25,
      "duration_seconds": 1.43,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.82,
      "end_seconds": 229.85,
      "duration_seconds": 2.03,
      "text": "I have heart disease"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.51,
      "end_seconds": 234.93,
      "duration_seconds": 1.42,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.05,
      "end_seconds": 246.52,
      "duration_seconds": 10.47,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.48,
      "end_seconds": 253.57,
      "duration_seconds": 6.09,
      "text": "Oh, my aunt has rheumatoid arthritis. Mm, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.85,
      "end_seconds": 271.77,
      "duration_seconds": 4.92,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.44,
      "end_seconds": 274.27,
      "duration_seconds": 1.83,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.5,
      "end_seconds": 279.35,
      "duration_seconds": 3.85,
      "text": "So, a a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.97,
      "end_seconds": 294.12,
      "duration_seconds": 13.15,
      "text": "I quit smoking around ten years ago. I'm a plumber, lots of bending and kneeling. I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.54,
      "end_seconds": 298.74,
      "duration_seconds": 3.2,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.67,
      "end_seconds": 305.42,
      "duration_seconds": 4.75,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 306.41,
      "end_seconds": 316.6,
      "duration_seconds": 10.19,
      "text": "Here are the numbers, doctor. Temperature is 36.9 degrees, saturation 98 percent, respiratory rate 16, pressure 128 over 81, pulse is 105 beats a minute."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.82,
      "end_seconds": 318.74,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.64,
      "end_seconds": 322.98,
      "duration_seconds": 2.34,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.74,
      "end_seconds": 327.63,
      "duration_seconds": 2.89,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.91,
      "end_seconds": 346.1,
      "duration_seconds": 5.19,
      "text": "You have a fine tremor and your pulse is fast and regular."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.83,
      "end_seconds": 347.86,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.07,
      "end_seconds": 368.56,
      "duration_seconds": 17.49,
      "text": "That's all I needed to check. From what you've told me and what I found, this looks most like an overactive thyroid. A heart rhythm problem is still possible. It could also be anxiety, so we'll keep that open."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.41,
      "end_seconds": 371.81,
      "duration_seconds": 1.4,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.56,
      "end_seconds": 388.3,
      "duration_seconds": 14.74,
      "text": "Nothing I've seen today points to an emergency. It looks like an overactive thyroid, but I'd like to confirm. Let me repeat that back to make sure. You've been sweating a lot, mild, and no chest pain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.46,
      "end_seconds": 391.08,
      "duration_seconds": 1.62,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 408.18,
      "end_seconds": 411.56,
      "duration_seconds": 3.38,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.4,
      "end_seconds": 445.36,
      "duration_seconds": 32.96,
      "text": "thanks, that helps i'd like to arrange thyroid blood tests for weight loss and palpitations the result will help us decide whether anything more is needed i'll start you on propranolol, 20 milligrams, twice a day, until review it's for racing heart and tremor avoid caffeine while the heart is racing let's get you seen by the endocrine clinic, I'll arrange the letter do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.03,
      "end_seconds": 451.07,
      "duration_seconds": 4.04,
      "text": "I'd like to see you again after the thyroid results."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.53,
      "end_seconds": 454.44,
      "duration_seconds": 1.91,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.67,
      "end_seconds": 460.63,
      "duration_seconds": 4.96,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 461.77,
      "end_seconds": 463.41,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    }
  ]
}