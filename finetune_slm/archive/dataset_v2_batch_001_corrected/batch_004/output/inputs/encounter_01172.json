{
  "schema_version": "1.0",
  "encounter_id": "01172",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 8.73,
      "duration_seconds": 7.49,
      "text": "Erm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.26,
      "end_seconds": 13.37,
      "duration_seconds": 4.11,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.3,
      "end_seconds": 20.28,
      "duration_seconds": 5.98,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.02,
      "end_seconds": 24.72,
      "duration_seconds": 3.7,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.0,
      "end_seconds": 31.47,
      "duration_seconds": 5.47,
      "text": "Doctor, it's hives all over. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.99,
      "end_seconds": 35.96,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.93,
      "end_seconds": 40.86,
      "duration_seconds": 2.93,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.35,
      "end_seconds": 45.69,
      "duration_seconds": 4.34,
      "text": "Okay, go on. How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.8,
      "end_seconds": 47.76,
      "duration_seconds": 0.96,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.82,
      "end_seconds": 52.52,
      "duration_seconds": 2.7,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.08,
      "end_seconds": 60.51,
      "duration_seconds": 7.43,
      "text": "It usually comes with swollen lips. And I've been feeling faint as well, for two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.36,
      "end_seconds": 65.45,
      "duration_seconds": 3.09,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.15,
      "end_seconds": 68.8,
      "duration_seconds": 1.65,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.39,
      "end_seconds": 70.09,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.62,
      "end_seconds": 80.39,
      "duration_seconds": 8.77,
      "text": "Uh, the swollen lips? That's been for two months. As for swollen lips, it's on and off."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.03,
      "end_seconds": 84.29,
      "duration_seconds": 3.26,
      "text": "And what about chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.54,
      "end_seconds": 90.4,
      "duration_seconds": 4.86,
      "text": "I mean, no, no chest pain or recent illness."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.94,
      "end_seconds": 95.3,
      "duration_seconds": 4.36,
      "text": "Alright, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.57,
      "end_seconds": 102.58,
      "duration_seconds": 3.01,
      "text": "Mm, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.25,
      "end_seconds": 105.93,
      "duration_seconds": 2.68,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.51,
      "end_seconds": 108.88,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.68,
      "end_seconds": 116.74,
      "duration_seconds": 7.06,
      "text": "Which medicines do you take at the moment? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.79,
      "end_seconds": 129.73,
      "duration_seconds": 10.94,
      "text": "I'm, I'm on Asthalin inhaler, when needed for my asthma. I'm on glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.46,
      "end_seconds": 133.51,
      "duration_seconds": 3.05,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.57,
      "end_seconds": 141.13,
      "duration_seconds": 5.56,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.23,
      "end_seconds": 147.0,
      "duration_seconds": 4.77,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.74,
      "end_seconds": 162.73,
      "duration_seconds": 14.99,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. I work in accounts at a hospital. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 176.85,
      "duration_seconds": 4.1,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.68,
      "end_seconds": 179.83,
      "duration_seconds": 2.15,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.47,
      "end_seconds": 184.69,
      "duration_seconds": 3.22,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.73,
      "end_seconds": 187.58,
      "duration_seconds": 1.85,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 193.95,
      "duration_seconds": 2.87,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.07,
      "end_seconds": 196.17,
      "duration_seconds": 1.1,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.29,
      "end_seconds": 198.6,
      "duration_seconds": 1.31,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.24,
      "end_seconds": 211.66,
      "duration_seconds": 9.42,
      "text": "I've had diabetes for nearly five years now. I didn't want to make a fuss, you know, you know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.69,
      "end_seconds": 217.68,
      "duration_seconds": 4.99,
      "text": "Alright, asthma and diabetes, that matches what I have here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.88,
      "end_seconds": 236.51,
      "duration_seconds": 4.63,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.95,
      "end_seconds": 250.33,
      "duration_seconds": 2.38,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.72,
      "end_seconds": 269.03,
      "duration_seconds": 8.31,
      "text": "Okay: pulse is 109 beats a minute, saturation 98 percent, temperature is 36.8 degrees, pressure 92 over 58."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.97,
      "end_seconds": 271.6,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.69,
      "end_seconds": 275.47,
      "duration_seconds": 2.78,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.75,
      "end_seconds": 280.85,
      "duration_seconds": 4.1,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.08,
      "end_seconds": 285.06,
      "duration_seconds": 2.98,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.9,
      "end_seconds": 309.17,
      "duration_seconds": 6.27,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.16,
      "end_seconds": 334.03,
      "duration_seconds": 20.87,
      "text": "You can sit up now. Okay, so my impression is this: I can't pin this down yet. We're looking at anaphylaxis or a severe allergic reaction. Just to be sure I understood. You've had hives all over for five days, severe, and no chest pain or recent illness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.73,
      "end_seconds": 336.66,
      "duration_seconds": 1.93,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.58,
      "end_seconds": 359.97,
      "duration_seconds": 9.39,
      "text": "I'm sending you for monitoring because of anaphylaxis. The treatment will be adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.83,
      "end_seconds": 363.81,
      "duration_seconds": 2.98,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.69,
      "end_seconds": 386.03,
      "duration_seconds": 20.34,
      "text": "Lie flat with your legs raised, I am giving the injection now. The thing that would worry me is if the symptoms return. If that happens, go to emergency. Book a review straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.76,
      "end_seconds": 388.47,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    }
  ]
}