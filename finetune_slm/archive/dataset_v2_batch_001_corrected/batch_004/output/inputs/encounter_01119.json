{
  "schema_version": "1.0",
  "encounter_id": "01119",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 4.93,
      "duration_seconds": 3.82,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 11.58,
      "duration_seconds": 5.45,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.58,
      "end_seconds": 17.87,
      "duration_seconds": 4.29,
      "text": "I've been dealing with loose stools after meals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 22.92,
      "duration_seconds": 3.31,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.6,
      "end_seconds": 37.63,
      "duration_seconds": 14.03,
      "text": "Right, about... well, four weeks. It's a relief to finally sit down and talk about it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.08,
      "end_seconds": 42.01,
      "duration_seconds": 3.93,
      "text": "Sure. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.79,
      "end_seconds": 44.25,
      "duration_seconds": 1.46,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.23,
      "end_seconds": 50.02,
      "duration_seconds": 4.79,
      "text": "Any fever, weight loss or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.47,
      "end_seconds": 55.43,
      "duration_seconds": 3.96,
      "text": "Actually, uh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.28,
      "end_seconds": 59.55,
      "duration_seconds": 2.27,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.44,
      "end_seconds": 62.08,
      "duration_seconds": 1.64,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.62,
      "end_seconds": 66.95,
      "duration_seconds": 3.33,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.86,
      "end_seconds": 71.17,
      "duration_seconds": 2.31,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 85.58,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.31,
      "end_seconds": 90.66,
      "duration_seconds": 4.35,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 93.63,
      "duration_seconds": 2.4,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.54,
      "end_seconds": 98.85,
      "duration_seconds": 4.31,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.02,
      "end_seconds": 101.21,
      "duration_seconds": 1.19,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.19,
      "end_seconds": 107.43,
      "duration_seconds": 4.24,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.77,
      "end_seconds": 110.96,
      "duration_seconds": 2.19,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.34,
      "end_seconds": 119.53,
      "duration_seconds": 7.19,
      "text": "Okay, so yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.99,
      "end_seconds": 141.86,
      "duration_seconds": 4.87,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.76,
      "end_seconds": 145.13,
      "duration_seconds": 2.37,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.68,
      "end_seconds": 148.65,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.32,
      "end_seconds": 153.55,
      "duration_seconds": 3.23,
      "text": "I have anxiety, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.91,
      "end_seconds": 159.29,
      "duration_seconds": 4.38,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.49,
      "end_seconds": 172.79,
      "duration_seconds": 12.3,
      "text": "I take escitalopram, 10 milligrams, once a day for the anxiety. I told my wife I'd come today. Loperamide. I take it 2 milligrams, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 192.7,
      "duration_seconds": 3.57,
      "text": "So, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.49,
      "end_seconds": 204.38,
      "duration_seconds": 2.89,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.99,
      "end_seconds": 234.2,
      "duration_seconds": 8.21,
      "text": "Okay: respiratory rate 18, pulse 64, temperature is 36.6 degrees, blood pressure 109 over 76."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.29,
      "end_seconds": 237.68,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.12,
      "end_seconds": 245.89,
      "duration_seconds": 3.77,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.44,
      "end_seconds": 250.8,
      "duration_seconds": 2.36,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.78,
      "end_seconds": 254.63,
      "duration_seconds": 2.85,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.76,
      "end_seconds": 271.7,
      "duration_seconds": 4.94,
      "text": "Your tummy is soft and only mildly tender on the left."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.67,
      "end_seconds": 284.19,
      "duration_seconds": 7.52,
      "text": "That's the examination finished. Okay, so my impression is this: It fits best with irritable bowel syndrome with diarrhoea."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.75,
      "end_seconds": 292.53,
      "duration_seconds": 2.78,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.62,
      "end_seconds": 302.03,
      "duration_seconds": 8.41,
      "text": "I can't promise yet, but most people with irritable bowel syndrome with diarrhoea do well once it's treated properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.3,
      "end_seconds": 338.42,
      "duration_seconds": 24.12,
      "text": "Let's book a stool test to look into diarrhoea. Keep a food diary and cut back on coffee. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. If the symptoms get worse, that's the point to come in urgently. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.02,
      "end_seconds": 343.41,
      "duration_seconds": 3.39,
      "text": "Well, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.66,
      "end_seconds": 349.61,
      "duration_seconds": 1.95,
      "text": "Right, all the best."
    }
  ]
}