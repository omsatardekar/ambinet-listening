  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.64,
      "duration_seconds": 3.54,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.11,
      "end_seconds": 10.83,
      "duration_seconds": 4.72,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.87,
      "end_seconds": 23.13,
      "duration_seconds": 7.26,
      "text": "I've been dealing with pelvic pain. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.65,
      "end_seconds": 29.44,
      "duration_seconds": 2.79,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.91,
      "end_seconds": 35.61,
      "duration_seconds": 2.7,
      "text": "It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.77,
      "end_seconds": 46.55,
      "duration_seconds": 9.78,
      "text": "Can you describe it a a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.5,
      "end_seconds": 57.32,
      "duration_seconds": 5.82,
      "text": "It happens once or twice a day. I notice it more with moving."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.33,
      "end_seconds": 62.77,
      "duration_seconds": 3.44,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.4,
      "end_seconds": 71.72,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.63,
      "end_seconds": 92.4,
      "duration_seconds": 7.77,
      "text": "Okay: saturation 97 percent, pulse 101, pressure 104 over 76, temperature 38.2, respiratory rate 21."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.11,
      "end_seconds": 97.35,
      "duration_seconds": 3.24,
      "text": "Hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 101.91,
      "duration_seconds": 2.64,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.7,
      "end_seconds": 108.28,
      "duration_seconds": 4.58,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.75,
      "end_seconds": 111.15,
      "duration_seconds": 1.4,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.56,
      "end_seconds": 126.26,
      "duration_seconds": 6.7,
      "text": "You are very tender low in the tummy, and it hurts when I move the cervix."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.54,
      "end_seconds": 130.83,
      "duration_seconds": 2.29,
      "text": "So, you can relax now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.08,
      "end_seconds": 147.46,
      "duration_seconds": 4.38,
      "text": "so, have you had any vomiting or recent pregnancy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.89,
      "end_seconds": 151.27,
      "duration_seconds": 2.38,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 154.26,
      "duration_seconds": 2.43,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.89,
      "end_seconds": 158.0,
      "duration_seconds": 2.11,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.63,
      "end_seconds": 161.68,
      "duration_seconds": 3.05,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.88,
      "end_seconds": 166.77,
      "duration_seconds": 3.89,
      "text": "I have heart failure, for about a year"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 186.62,
      "duration_seconds": 2.52,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.04,
      "end_seconds": 193.78,
      "duration_seconds": 5.74,
      "text": "Carvedilol, 6.25 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.42,
      "end_seconds": 196.99,
      "duration_seconds": 2.57,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.65,
      "end_seconds": 201.04,
      "duration_seconds": 3.39,
      "text": "yes, cat fur. I get wheezing"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.77,
      "end_seconds": 215.01,
      "duration_seconds": 1.24,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.13,
      "end_seconds": 220.16,
      "duration_seconds": 4.03,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.3,
      "end_seconds": 222.99,
      "duration_seconds": 1.69,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.38,
      "end_seconds": 227.9,
      "duration_seconds": 3.52,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.24,
      "end_seconds": 233.38,
      "duration_seconds": 4.14,
      "text": "what does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.53,
      "end_seconds": 238.16,
      "duration_seconds": 3.63,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.25,
      "end_seconds": 272.59,
      "duration_seconds": 22.34,
      "text": "so where does that leave us? I'm honestly not certain yet it could be severe pelvic inflammatory disease, or it might be an abscess let's book swabs to look into pelvic infection that will help us see what's going on underneath and decide the next step"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.21,
      "end_seconds": 276.18,
      "duration_seconds": 2.97,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.45,
      "end_seconds": 292.0,
      "duration_seconds": 14.55,
      "text": "The treatment will be ceftriaxone, 1 gram, once now, single dose. That should help with pelvic infection. You need hospital treatment today. Let's get you seen by the gynaecology team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.59,
      "end_seconds": 295.42,
      "duration_seconds": 2.83,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.24,
      "end_seconds": 306.67,
      "duration_seconds": 6.43,
      "text": "Let's plan a check straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.67,
      "end_seconds": 311.69,
      "duration_seconds": 4.02,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}