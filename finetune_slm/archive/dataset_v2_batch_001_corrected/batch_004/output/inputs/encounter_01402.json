{
  "schema_version": "1.0",
  "encounter_id": "01402",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.37,
      "end_seconds": 4.29,
      "duration_seconds": 2.92,
      "text": "Alright, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.3,
      "end_seconds": 11.19,
      "duration_seconds": 4.89,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.18,
      "end_seconds": 14.97,
      "duration_seconds": 2.79,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.77,
      "end_seconds": 27.33,
      "duration_seconds": 10.56,
      "text": "Yeah, so the thing is, I've got a missed period. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.22,
      "end_seconds": 30.13,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.93,
      "end_seconds": 44.69,
      "duration_seconds": 13.76,
      "text": "About... well, about a month. I didn't want to make a fuss, you know. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 48.51,
      "duration_seconds": 3.29,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.82,
      "end_seconds": 59.3,
      "duration_seconds": 9.48,
      "text": "Pretty mild, if I'm being honest. I mean, um, I've also been feeling sick in the mornings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.04,
      "end_seconds": 62.41,
      "duration_seconds": 2.37,
      "text": "Have you had tender breasts?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.95,
      "end_seconds": 65.86,
      "duration_seconds": 2.91,
      "text": "So, yes, for two days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.98,
      "end_seconds": 73.26,
      "duration_seconds": 6.28,
      "text": "Let me check a few things. Any bleeding, vomiting everything or severe pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.47,
      "end_seconds": 78.66,
      "duration_seconds": 4.19,
      "text": "No, no bleeding, vomiting everything or severe pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.92,
      "end_seconds": 83.32,
      "duration_seconds": 3.4,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.07,
      "end_seconds": 89.37,
      "duration_seconds": 5.3,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.29,
      "end_seconds": 93.52,
      "duration_seconds": 3.23,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.89,
      "end_seconds": 98.44,
      "duration_seconds": 3.55,
      "text": "No, uh, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.61,
      "end_seconds": 116.04,
      "duration_seconds": 3.43,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.09,
      "end_seconds": 137.32,
      "duration_seconds": 17.23,
      "text": "Mm, I take Asthalin inhaler, when needed for my asthma. Hydrocortisone cream, when needed for the eczema. It's a folic acid tablet, 400 micrograms, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 138.31,
      "end_seconds": 142.77,
      "duration_seconds": 4.46,
      "text": "Doctor, our chart from the last visit lists it as 200 micrograms."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.14,
      "end_seconds": 149.1,
      "duration_seconds": 4.96,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.35,
      "end_seconds": 154.9,
      "duration_seconds": 4.55,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.71,
      "end_seconds": 158.75,
      "duration_seconds": 3.04,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.4,
      "end_seconds": 164.52,
      "duration_seconds": 5.12,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.59,
      "end_seconds": 168.17,
      "duration_seconds": 2.58,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.84,
      "end_seconds": 174.02,
      "duration_seconds": 4.18,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.16,
      "end_seconds": 181.44,
      "duration_seconds": 3.28,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.95,
      "end_seconds": 185.16,
      "duration_seconds": 2.21,
      "text": "Yes, asthma. Yes, eczema."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.16,
      "end_seconds": 187.86,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 202.39,
      "end_seconds": 212.35,
      "duration_seconds": 9.96,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 98 percent, pressure 126 over 74, pulse is 65 beats a minute, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.08,
      "end_seconds": 214.08,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.18,
      "end_seconds": 219.95,
      "duration_seconds": 3.77,
      "text": "Alright, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.83,
      "end_seconds": 224.41,
      "duration_seconds": 2.58,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.47,
      "end_seconds": 243.92,
      "duration_seconds": 2.45,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.83,
      "end_seconds": 259.5,
      "duration_seconds": 9.67,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. The most likely explanation is a normal early pregnancy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.25,
      "end_seconds": 269.19,
      "duration_seconds": 5.94,
      "text": "So, uh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.11,
      "end_seconds": 278.01,
      "duration_seconds": 7.9,
      "text": "Nothing I've seen today points to an emergency. It looks like a normal early pregnancy, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 294.7,
      "end_seconds": 298.77,
      "duration_seconds": 4.07,
      "text": "We've already done a pregnancy test this morning, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.56,
      "end_seconds": 333.76,
      "duration_seconds": 33.2,
      "text": "Right, thank you. I think a booking blood test makes sense here, for pregnancy. Keep taking folic acid and book in with the midwife. The midwife would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. Book a review in four weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.09,
      "end_seconds": 338.96,
      "duration_seconds": 3.87,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 339.89,
      "end_seconds": 343.03,
      "duration_seconds": 3.14,
      "text": "I think I understand everything. Thanks."
    }
  ]
}