{
  "schema_version": "1.0",
  "encounter_id": "01070",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 6.47,
      "duration_seconds": 5.94,
      "text": "Well, you know, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.46,
      "end_seconds": 13.69,
      "duration_seconds": 4.23,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.98,
      "end_seconds": 21.46,
      "duration_seconds": 6.48,
      "text": "Um, so... throbbing headaches on one side. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.3,
      "end_seconds": 26.14,
      "duration_seconds": 2.84,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.29,
      "end_seconds": 30.97,
      "duration_seconds": 3.68,
      "text": "Alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.57,
      "end_seconds": 34.57,
      "duration_seconds": 2.0,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.12,
      "end_seconds": 41.82,
      "duration_seconds": 5.7,
      "text": "It's, It's 70 milligrams. Paracetamol, 1 gram, maybe, when needed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.46,
      "end_seconds": 45.55,
      "duration_seconds": 3.09,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.65,
      "end_seconds": 48.93,
      "duration_seconds": 2.28,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.34,
      "end_seconds": 61.84,
      "duration_seconds": 3.5,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.6,
      "end_seconds": 75.38,
      "duration_seconds": 11.78,
      "text": "Ah, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.47,
      "end_seconds": 84.92,
      "duration_seconds": 8.45,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.53,
      "end_seconds": 107.87,
      "duration_seconds": 21.34,
      "text": "Only a dark room, and it's not much. Yes, skipping meals and bright light. That makes it worse. I've, I've also had zigzag lights before it starts, for four weeks. So, I'd been feeling sick, but that went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.24,
      "end_seconds": 117.37,
      "duration_seconds": 5.13,
      "text": "Let me check a few things. Any head injury or stiff neck?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.67,
      "end_seconds": 121.87,
      "duration_seconds": 3.2,
      "text": "Actually, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.32,
      "end_seconds": 125.01,
      "duration_seconds": 1.69,
      "text": "Any weakness or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.65,
      "end_seconds": 130.29,
      "duration_seconds": 3.64,
      "text": "Oh, uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.99,
      "end_seconds": 134.46,
      "duration_seconds": 3.47,
      "text": "Right, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.41,
      "end_seconds": 138.69,
      "duration_seconds": 2.28,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.74,
      "end_seconds": 145.25,
      "duration_seconds": 4.51,
      "text": "Right, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.76,
      "end_seconds": 151.85,
      "duration_seconds": 5.09,
      "text": "I mean, I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.11,
      "end_seconds": 156.79,
      "duration_seconds": 1.68,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 167.1,
      "duration_seconds": 9.26,
      "text": "I've had thin bones for about a year now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.28,
      "end_seconds": 172.13,
      "duration_seconds": 3.85,
      "text": "Alright, thin bones, that matches what I have here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.81,
      "end_seconds": 189.97,
      "duration_seconds": 2.16,
      "text": "Right, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.18,
      "end_seconds": 197.57,
      "duration_seconds": 6.39,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.09,
      "end_seconds": 201.01,
      "duration_seconds": 1.92,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.9,
      "end_seconds": 206.4,
      "duration_seconds": 4.5,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.12,
      "end_seconds": 208.76,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.37,
      "end_seconds": 215.12,
      "duration_seconds": 4.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.67,
      "end_seconds": 216.85,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.96,
      "end_seconds": 221.41,
      "duration_seconds": 3.45,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 226.99,
      "duration_seconds": 4.35,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.93,
      "end_seconds": 235.68,
      "duration_seconds": 7.75,
      "text": "Uh, I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.93,
      "end_seconds": 254.5,
      "duration_seconds": 3.57,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.99,
      "end_seconds": 261.45,
      "duration_seconds": 5.46,
      "text": "My sister had breast cancer. Actually, my son has asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 265.51,
      "duration_seconds": 2.9,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.88,
      "end_seconds": 276.87,
      "duration_seconds": 2.99,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.78,
      "end_seconds": 300.6,
      "duration_seconds": 8.82,
      "text": "Okay: temperature is 36.7 degrees, oxygen saturation is 98 percent, heart rate 76, BP is 108 over 80."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.59,
      "end_seconds": 304.06,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.11,
      "end_seconds": 309.02,
      "duration_seconds": 2.91,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.02,
      "end_seconds": 314.56,
      "duration_seconds": 4.54,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.42,
      "end_seconds": 317.57,
      "duration_seconds": 2.15,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.52,
      "end_seconds": 333.31,
      "duration_seconds": 6.79,
      "text": "Your eye movements are normal and there is no weakness in your arms or legs."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.06,
      "end_seconds": 335.13,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.96,
      "end_seconds": 350.94,
      "duration_seconds": 10.98,
      "text": "Good, you can sit up again. Okay, so my impression is this: The most likely explanation is migraine with aura. Tension-type headache is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.89,
      "end_seconds": 355.43,
      "duration_seconds": 3.54,
      "text": "So, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.93,
      "end_seconds": 371.35,
      "duration_seconds": 15.42,
      "text": "I understand the worry. At the moment I'd say it's migraine with aura, and we'll watch how it goes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.33,
      "end_seconds": 373.94,
      "duration_seconds": 1.61,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.32,
      "end_seconds": 382.7,
      "duration_seconds": 7.38,
      "text": "I don't need to add any tests or treatment at this point. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.37,
      "end_seconds": 388.13,
      "duration_seconds": 3.76,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}