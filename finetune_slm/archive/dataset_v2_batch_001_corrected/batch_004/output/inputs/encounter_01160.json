{
  "schema_version": "1.0",
  "encounter_id": "01160",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 4.26,
      "duration_seconds": 3.13,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 10.26,
      "duration_seconds": 4.42,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.29,
      "end_seconds": 18.58,
      "duration_seconds": 7.29,
      "text": "Mainly severe lower back pain. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 22.56,
      "duration_seconds": 3.44,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.41,
      "end_seconds": 26.49,
      "duration_seconds": 2.08,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.53,
      "end_seconds": 34.05,
      "duration_seconds": 5.52,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.66,
      "end_seconds": 43.91,
      "duration_seconds": 8.25,
      "text": "It's moderate, honestly. I'd say a couple of times a week. It's worse with bending."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.48,
      "end_seconds": 47.14,
      "duration_seconds": 2.66,
      "text": "Okay, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.88,
      "end_seconds": 51.61,
      "duration_seconds": 3.73,
      "text": "It usually comes with trouble passing urine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.69,
      "end_seconds": 62.08,
      "duration_seconds": 2.39,
      "text": "Any fever or recent fall?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.13,
      "end_seconds": 68.19,
      "duration_seconds": 5.06,
      "text": "I, I haven't had fever or recent fall, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.4,
      "end_seconds": 77.0,
      "duration_seconds": 2.6,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.48,
      "end_seconds": 79.58,
      "duration_seconds": 1.1,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 95.84,
      "duration_seconds": 2.1,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.93,
      "end_seconds": 100.27,
      "duration_seconds": 2.34,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.02,
      "end_seconds": 109.42,
      "duration_seconds": 3.4,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.13,
      "end_seconds": 115.44,
      "duration_seconds": 5.31,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.58,
      "end_seconds": 120.8,
      "duration_seconds": 4.22,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.31,
      "end_seconds": 125.18,
      "duration_seconds": 3.87,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.85,
      "end_seconds": 131.05,
      "duration_seconds": 4.2,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.75,
      "end_seconds": 134.47,
      "duration_seconds": 1.72,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.24,
      "end_seconds": 137.97,
      "duration_seconds": 2.73,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.01,
      "end_seconds": 140.11,
      "duration_seconds": 1.1,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.06,
      "end_seconds": 159.2,
      "duration_seconds": 5.14,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.24,
      "end_seconds": 165.96,
      "duration_seconds": 4.72,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.75,
      "end_seconds": 171.47,
      "duration_seconds": 3.72,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 183.26,
      "duration_seconds": 2.47,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 203.04,
      "duration_seconds": 7.94,
      "text": "Okay: temperature is 36.6 degrees, BP is 126 over 75, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.02,
      "end_seconds": 208.52,
      "duration_seconds": 2.5,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.32,
      "end_seconds": 212.91,
      "duration_seconds": 1.59,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.61,
      "end_seconds": 217.06,
      "duration_seconds": 2.45,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.37,
      "end_seconds": 234.67,
      "duration_seconds": 6.3,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.19,
      "end_seconds": 254.59,
      "duration_seconds": 17.4,
      "text": "Good, you can sit up again. Let me tell you where I've got to. It's hard to say. Possible cauda equina syndrome needing an urgent scan is one possibility and a large disc prolapse another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.69,
      "end_seconds": 260.08,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.7,
      "end_seconds": 271.33,
      "duration_seconds": 10.63,
      "text": "It's reasonable to be concerned, but right now possible cauda equina syndrome needing an urgent scan is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.36,
      "end_seconds": 289.35,
      "duration_seconds": 5.99,
      "text": "Let's book an urgent MRI of the spine to look into possible cauda equina."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 291.29,
      "end_seconds": 294.88,
      "duration_seconds": 3.59,
      "text": "I can book that for Thursday at 10 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.96,
      "end_seconds": 296.86,
      "duration_seconds": 0.9,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.52,
      "end_seconds": 302.95,
      "duration_seconds": 4.43,
      "text": "You need to go to hospital now for an emergency scan."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.17,
      "end_seconds": 307.03,
      "duration_seconds": 3.86,
      "text": "Mm, okay. We'll refer you to the spinal team."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.99,
      "end_seconds": 309.67,
      "duration_seconds": 1.68,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.27,
      "end_seconds": 321.08,
      "duration_seconds": 9.81,
      "text": "I'll want another look straight away. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.91,
      "end_seconds": 326.23,
      "duration_seconds": 4.32,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.18,
      "end_seconds": 332.17,
      "duration_seconds": 3.99,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.2,
      "end_seconds": 337.65,
      "duration_seconds": 3.45,
      "text": "Thank you, uh, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.15,
      "end_seconds": 339.4,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}