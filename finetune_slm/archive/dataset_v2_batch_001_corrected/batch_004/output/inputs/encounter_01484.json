{
  "schema_version": "1.0",
  "encounter_id": "01484",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 4.37,
      "duration_seconds": 3.37,
      "text": "good morning. I've just opened your notes"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.14,
      "end_seconds": 9.51,
      "duration_seconds": 3.37,
      "text": "afternoon, you know, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.3,
      "end_seconds": 16.89,
      "duration_seconds": 5.59,
      "text": "hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.6,
      "end_seconds": 25.75,
      "duration_seconds": 7.15,
      "text": "that's fine, sit down. We'll go through it together. Is it your first time here?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.51,
      "end_seconds": 31.36,
      "duration_seconds": 4.85,
      "text": "no, uh, I came last year for something else"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.98,
      "end_seconds": 34.34,
      "duration_seconds": 2.36,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.24,
      "end_seconds": 54.87,
      "duration_seconds": 18.63,
      "text": "doctor it's a red warm patch on my shin. It's getting on my nerves now. I'm hoping you can tell me something definite. I looked a few things up online and that probably didn't help"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.01,
      "end_seconds": 59.59,
      "duration_seconds": 3.58,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.6,
      "end_seconds": 63.29,
      "duration_seconds": 2.69,
      "text": "it's been about two weeks now"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.35,
      "end_seconds": 67.72,
      "duration_seconds": 3.37,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.48,
      "end_seconds": 70.4,
      "duration_seconds": 0.92,
      "text": "mostly mild"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.91,
      "end_seconds": 75.18,
      "duration_seconds": 4.27,
      "text": "yes carry on. Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.75,
      "end_seconds": 94.07,
      "duration_seconds": 17.32,
      "text": "it settles a little with elevation. And I've been feeling shivery as well, for about four days. Oh, and and a sore leg. Okay, uh, so about sore leg, mostly severe"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.69,
      "end_seconds": 102.92,
      "duration_seconds": 8.23,
      "text": "have you had a a red warm patch on your shin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.06,
      "end_seconds": 109.58,
      "duration_seconds": 5.52,
      "text": "well, a bit, last year it settled by itself back then"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 115.5,
      "duration_seconds": 3.17,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.29,
      "end_seconds": 117.43,
      "duration_seconds": 1.14,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.78,
      "end_seconds": 122.09,
      "duration_seconds": 3.31,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.95,
      "end_seconds": 141.44,
      "duration_seconds": 9.49,
      "text": "the shin is red, warm and tender with a clear edge, and I've marked it it with a pen"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.58,
      "end_seconds": 153.51,
      "duration_seconds": 7.93,
      "text": "So, good, you can sit up again. Have you noticed cut, rash elsewhere or shortness of breath?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.33,
      "end_seconds": 161.69,
      "duration_seconds": 7.36,
      "text": "sorry what was I saying I haven't had cut rash elsewhere or shortness of breath no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.48,
      "end_seconds": 166.27,
      "duration_seconds": 2.79,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.34,
      "end_seconds": 171.78,
      "duration_seconds": 3.44,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.38,
      "end_seconds": 175.52,
      "duration_seconds": 3.14,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.49,
      "end_seconds": 177.51,
      "duration_seconds": 1.02,
      "text": "no none"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.87,
      "end_seconds": 197.71,
      "duration_seconds": 3.84,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.47,
      "end_seconds": 202.9,
      "duration_seconds": 3.43,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.79,
      "end_seconds": 208.11,
      "duration_seconds": 3.32,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.75,
      "end_seconds": 217.39,
      "duration_seconds": 3.64,
      "text": "I've had gout for five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.25,
      "end_seconds": 220.05,
      "duration_seconds": 0.8,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.11,
      "end_seconds": 230.56,
      "duration_seconds": 1.45,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.48,
      "end_seconds": 235.98,
      "duration_seconds": 3.5,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.08,
      "end_seconds": 238.38,
      "duration_seconds": 1.3,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.62,
      "end_seconds": 242.66,
      "duration_seconds": 3.04,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.41,
      "end_seconds": 263.6,
      "duration_seconds": 3.19,
      "text": "Have you been to to theatre before?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.11,
      "end_seconds": 279.06,
      "duration_seconds": 14.95,
      "text": "Uh yes I had part of my thyroid removed years back. I'd rather know what's going on than keep guessing. Sorry I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.93,
      "end_seconds": 292.06,
      "duration_seconds": 12.13,
      "text": "taking everything into account it's hard to say. Cellulitis of the leg is one possibility and a blood clot in the leg another and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.03,
      "end_seconds": 296.78,
      "duration_seconds": 2.75,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.76,
      "end_seconds": 319.19,
      "duration_seconds": 20.43,
      "text": "I can't promise yet but most people with cellulitis of the leg do well once it's treated properly. Just to be sure I understood. You've had a red warm patch on your shin for about two weeks mild and no cut or rash elsewhere."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.85,
      "end_seconds": 322.86,
      "duration_seconds": 3.01,
      "text": "Yeah, yes, you've got it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.42,
      "end_seconds": 340.14,
      "duration_seconds": 16.72,
      "text": "I'm sending you for blood tests because of cellulitis. The treatment will be flucloxacillin, 500 milligrams, four times a day, seven days. That's for cellulitis. The pharmacy will go through the details again when you pick it up"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.27,
      "end_seconds": 342.76,
      "duration_seconds": 1.49,
      "text": "okay I understand"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.12,
      "end_seconds": 357.9,
      "duration_seconds": 13.78,
      "text": "keep the leg raised and come back if the redness goes past the pen line. Please take the tablets with food so they don't upset your stomach. We'll catch up in two days"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.63,
      "end_seconds": 361.29,
      "duration_seconds": 2.66,
      "text": "okay, I'll arrange it it"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.81,
      "end_seconds": 366.25,
      "duration_seconds": 4.44,
      "text": "alright anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.36,
      "end_seconds": 370.54,
      "duration_seconds": 3.18,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.04,
      "end_seconds": 372.28,
      "duration_seconds": 1.24,
      "text": "Take care now."
    }
  ]
}