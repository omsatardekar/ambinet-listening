{
  "schema_version": "1.0",
  "encounter_id": "01394",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.82,
      "duration_seconds": 3.43,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 10.51,
      "duration_seconds": 4.71,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.59,
      "end_seconds": 21.01,
      "duration_seconds": 6.42,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.76,
      "end_seconds": 24.61,
      "duration_seconds": 2.85,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.39,
      "end_seconds": 33.68,
      "duration_seconds": 7.29,
      "text": "It's a stiff painful shoulder, mostly. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.6,
      "end_seconds": 39.16,
      "duration_seconds": 3.56,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.98,
      "end_seconds": 46.66,
      "duration_seconds": 5.68,
      "text": "I'm on mirtazapine, 15 milligrams, at night for my mood."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.17,
      "end_seconds": 48.4,
      "duration_seconds": 1.23,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.06,
      "end_seconds": 52.22,
      "duration_seconds": 2.16,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.99,
      "end_seconds": 56.05,
      "duration_seconds": 3.06,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.46,
      "end_seconds": 59.88,
      "duration_seconds": 2.42,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 61.66,
      "end_seconds": 65.81,
      "duration_seconds": 4.15,
      "text": "Uh, hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.33,
      "end_seconds": 74.07,
      "duration_seconds": 4.74,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.92,
      "end_seconds": 78.84,
      "duration_seconds": 2.92,
      "text": "mm, I suppose so, yes"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.69,
      "end_seconds": 89.26,
      "duration_seconds": 8.57,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.17,
      "end_seconds": 127.25,
      "duration_seconds": 34.08,
      "text": "Moderate, really. Yes, night and reaching. That makes it worse. It's a couple of times a week. Ah, I've had not being able to lift my arm too, for about four days. I've also had being woken at night by the pain. About being woken at night by the pain, I'd give it a four, out of ten. I'd say all the time. It's worse with lying on it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.68,
      "end_seconds": 132.72,
      "duration_seconds": 4.04,
      "text": "A few quick ones: numbness, neck pain or fall?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.73,
      "end_seconds": 138.93,
      "duration_seconds": 5.2,
      "text": "No numbness, neck pain or fall, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.57,
      "end_seconds": 143.42,
      "duration_seconds": 2.85,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.46,
      "end_seconds": 148.95,
      "duration_seconds": 4.49,
      "text": "Um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.67,
      "end_seconds": 154.61,
      "duration_seconds": 3.94,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.44,
      "end_seconds": 158.96,
      "duration_seconds": 2.52,
      "text": "Right, no, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.2,
      "end_seconds": 164.11,
      "duration_seconds": 3.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.6,
      "end_seconds": 166.94,
      "duration_seconds": 1.34,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.1,
      "end_seconds": 177.01,
      "duration_seconds": 2.91,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.84,
      "end_seconds": 183.21,
      "duration_seconds": 5.37,
      "text": "I have diabetes. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.23,
      "end_seconds": 185.83,
      "duration_seconds": 1.6,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.8,
      "end_seconds": 196.24,
      "duration_seconds": 8.44,
      "text": "I've had depression for about ten years now. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.96,
      "end_seconds": 204.88,
      "duration_seconds": 6.92,
      "text": "Okay, I can see depression in your file as well. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.77,
      "end_seconds": 217.39,
      "duration_seconds": 11.62,
      "text": "Just a mole taken off my arm, a few years ago. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.37,
      "end_seconds": 221.22,
      "duration_seconds": 2.85,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.83,
      "end_seconds": 236.41,
      "duration_seconds": 13.58,
      "text": "I quit smoking around ten years ago. I'm a plumber, lots of bending and kneeling. I hardly move around during the day. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.43,
      "end_seconds": 241.07,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.03,
      "end_seconds": 252.46,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.72,
      "end_seconds": 282.99,
      "duration_seconds": 13.27,
      "text": "Okay: heart rate 75, oxygen saturation is 97 percent. And BMI works out to 21.5, height 179 centimetres, temperature is 36.9 degrees, pressure 118 over 73, weight 69 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.17,
      "end_seconds": 289.16,
      "duration_seconds": 4.99,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.61,
      "end_seconds": 292.68,
      "duration_seconds": 2.07,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.43,
      "end_seconds": 304.93,
      "duration_seconds": 4.5,
      "text": "Movement is limited in all directions, both active and passive."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.8,
      "end_seconds": 318.98,
      "duration_seconds": 2.18,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.9,
      "end_seconds": 326.74,
      "duration_seconds": 2.84,
      "text": "okay, that's the the examination finished"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.98,
      "end_seconds": 349.83,
      "duration_seconds": 13.85,
      "text": "Okay, thinking it through, it points towards adhesive capsulitis, a frozen shoulder. Let me just check I've got this right. You've had a stiff painful shoulder, moderate, and no fall or neck pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.58,
      "end_seconds": 353.93,
      "duration_seconds": 2.35,
      "text": "that's what happened, yes"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.04,
      "end_seconds": 386.84,
      "duration_seconds": 31.8,
      "text": "I'm gonna order an X-ray of the shoulder, for shoulder pain. Gentle daily stretches within comfort, and heat before them. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I think physiotherapy should see you too. Let's review you in six weeks. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.18,
      "end_seconds": 393.3,
      "duration_seconds": 5.12,
      "text": "so, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.6,
      "end_seconds": 400.31,
      "duration_seconds": 5.71,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.02,
      "end_seconds": 406.42,
      "duration_seconds": 2.4,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}