{
  "schema_version": "1.0",
  "encounter_id": "01014",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.4,
      "duration_seconds": 4.38,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.13,
      "end_seconds": 12.06,
      "duration_seconds": 4.93,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.57,
      "end_seconds": 20.26,
      "duration_seconds": 6.69,
      "text": "Doctor, you know, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.07,
      "end_seconds": 26.58,
      "duration_seconds": 5.51,
      "text": "Yeah, it's loose stools after meals. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.21,
      "end_seconds": 30.36,
      "duration_seconds": 3.15,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.3,
      "end_seconds": 39.9,
      "duration_seconds": 2.6,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.54,
      "end_seconds": 72.9,
      "duration_seconds": 13.36,
      "text": "okay: BP is 116 over 72, SpO2 99 percent on room air and and weight 96 kilos, pulse 74, height 153 centimetres, respiratory rate 15, temp 36.9 degrees"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.95,
      "end_seconds": 76.58,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.73,
      "end_seconds": 82.42,
      "duration_seconds": 4.69,
      "text": "we'll look at it together shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.45,
      "end_seconds": 95.43,
      "duration_seconds": 8.98,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.34,
      "end_seconds": 100.46,
      "duration_seconds": 3.12,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.61,
      "end_seconds": 103.3,
      "duration_seconds": 1.69,
      "text": "it's severe, honestly"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.0,
      "end_seconds": 108.65,
      "duration_seconds": 4.65,
      "text": "What about cramping lower tummy pain, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 113.73,
      "duration_seconds": 3.48,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.76,
      "end_seconds": 116.68,
      "duration_seconds": 1.92,
      "text": "Any urgency as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.66,
      "end_seconds": 121.08,
      "duration_seconds": 3.42,
      "text": "hmm, yes, for about a month"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.36,
      "end_seconds": 126.45,
      "duration_seconds": 4.09,
      "text": "Any fever, weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.2,
      "end_seconds": 133.06,
      "duration_seconds": 5.86,
      "text": "I haven't had fever, weight loss or blood in the stool, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.53,
      "end_seconds": 137.54,
      "duration_seconds": 3.01,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.32,
      "end_seconds": 142.72,
      "duration_seconds": 3.4,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.47,
      "end_seconds": 148.15,
      "duration_seconds": 4.68,
      "text": "Alright, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.23,
      "end_seconds": 150.76,
      "duration_seconds": 1.53,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.25,
      "end_seconds": 172.86,
      "duration_seconds": 3.61,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.97,
      "end_seconds": 179.76,
      "duration_seconds": 5.79,
      "text": "Anxiety, for five years. I have epilepsy. I've got heart disease"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.2,
      "end_seconds": 188.13,
      "duration_seconds": 6.93,
      "text": "Alright, epilepsy, that matches what I have here. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.85,
      "end_seconds": 193.22,
      "duration_seconds": 3.37,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.83,
      "end_seconds": 194.71,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.34,
      "end_seconds": 199.01,
      "duration_seconds": 3.67,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.65,
      "end_seconds": 201.11,
      "duration_seconds": 1.46,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.34,
      "end_seconds": 205.7,
      "duration_seconds": 3.36,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.89,
      "end_seconds": 209.88,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.82,
      "end_seconds": 213.53,
      "duration_seconds": 2.71,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.68,
      "end_seconds": 215.95,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.87,
      "end_seconds": 219.82,
      "duration_seconds": 2.95,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.06,
      "end_seconds": 234.84,
      "duration_seconds": 2.78,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.61,
      "end_seconds": 245.58,
      "duration_seconds": 4.97,
      "text": "just two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.53,
      "end_seconds": 250.85,
      "duration_seconds": 4.32,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.2,
      "end_seconds": 271.49,
      "duration_seconds": 19.29,
      "text": "Carbamazepine. I take it 200 milligrams, twice a day. I wasn't sure whether to to come in at all, to be honest. It's, It's aspirin, 75 milligrams, once a day. Loperamide, 2 milligrams, when needed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 273.37,
      "end_seconds": 284.05,
      "duration_seconds": 10.68,
      "text": "Doctor, um, I think the last prescription for the loperamide was 4 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.8,
      "end_seconds": 288.87,
      "duration_seconds": 4.07,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.61,
      "end_seconds": 300.42,
      "duration_seconds": 9.81,
      "text": "I don't think I have it with me. I, I was on levetiracetam before. I stopped taking it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.55,
      "end_seconds": 307.13,
      "duration_seconds": 4.58,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.07,
      "end_seconds": 310.79,
      "duration_seconds": 1.72,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.88,
      "end_seconds": 314.9,
      "duration_seconds": 3.02,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.93,
      "end_seconds": 337.05,
      "duration_seconds": 5.12,
      "text": "Your tummy is soft and and only mildly tender on the left."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.93,
      "end_seconds": 357.43,
      "duration_seconds": 17.5,
      "text": "Good, you can sit up again. Taking everything into account, I think we're dealing with irritable bowel syndrome with diarrhoea at this stage. It could also be an inflammatory bowel condition, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.41,
      "end_seconds": 361.75,
      "duration_seconds": 2.34,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.3,
      "end_seconds": 372.44,
      "duration_seconds": 10.14,
      "text": "Nothing I've seen today points to an emergency. It looks like irritable bowel syndrome with diarrhoea, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.2,
      "end_seconds": 407.94,
      "duration_seconds": 24.74,
      "text": "let's get a coeliac blood test, for diarrhoea i'm going to order a stool test, for diarrhoea keep a food diary and cut back on coffee and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose see me again in six weeks that's all from me any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.79,
      "end_seconds": 412.86,
      "duration_seconds": 3.07,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.52,
      "end_seconds": 415.55,
      "duration_seconds": 2.03,
      "text": "Have a a good day."
    }
  ]
}