{
  "schema_version": "1.0",
  "encounter_id": "01116",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.7,
      "end_seconds": 5.31,
      "duration_seconds": 4.61,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.22,
      "duration_seconds": 4.16,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 24.53,
      "duration_seconds": 13.52,
      "text": "Yeah, it's tearing chest pain going to my back. I don't know what's causing it. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.38,
      "end_seconds": 28.87,
      "duration_seconds": 3.49,
      "text": "Alright, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.32,
      "end_seconds": 39.85,
      "duration_seconds": 6.53,
      "text": "It's been ten days now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.7,
      "end_seconds": 45.28,
      "duration_seconds": 3.58,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.18,
      "end_seconds": 52.53,
      "duration_seconds": 5.35,
      "text": "It's severe, honestly. I've also been feeling faint, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.55,
      "end_seconds": 63.29,
      "duration_seconds": 8.74,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.09,
      "end_seconds": 69.52,
      "duration_seconds": 5.43,
      "text": "It happens a few times a day. It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.39,
      "end_seconds": 93.45,
      "duration_seconds": 5.06,
      "text": "Let me check a few things. Any fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.46,
      "end_seconds": 99.07,
      "duration_seconds": 3.61,
      "text": "No, no fever, cough or leg swelling."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.98,
      "end_seconds": 102.08,
      "duration_seconds": 2.1,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.93,
      "end_seconds": 103.92,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.37,
      "end_seconds": 108.41,
      "duration_seconds": 3.04,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.09,
      "end_seconds": 112.06,
      "duration_seconds": 1.97,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.72,
      "end_seconds": 134.36,
      "duration_seconds": 4.64,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.79,
      "end_seconds": 138.64,
      "duration_seconds": 2.85,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.29,
      "end_seconds": 142.14,
      "duration_seconds": 2.85,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.82,
      "end_seconds": 145.19,
      "duration_seconds": 2.37,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.33,
      "end_seconds": 165.91,
      "duration_seconds": 5.58,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.13,
      "end_seconds": 177.22,
      "duration_seconds": 10.09,
      "text": "My partner and our baby. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.26,
      "end_seconds": 182.46,
      "duration_seconds": 3.2,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.9,
      "end_seconds": 186.47,
      "duration_seconds": 2.57,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.3,
      "end_seconds": 192.27,
      "duration_seconds": 3.97,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.81,
      "end_seconds": 197.16,
      "duration_seconds": 3.35,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 199.11,
      "end_seconds": 208.33,
      "duration_seconds": 9.22,
      "text": "Doctor, I've got the readings for you. SpO2 98 percent on room air, temperature 36.9. Blood pressure 144 over 99, heart rate 83."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.07,
      "end_seconds": 211.58,
      "duration_seconds": 1.51,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 214.96,
      "duration_seconds": 2.2,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.65,
      "end_seconds": 218.77,
      "duration_seconds": 2.12,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.77,
      "end_seconds": 233.12,
      "duration_seconds": 5.35,
      "text": "The blood pressure is different in your two arms and you are sweaty."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.04,
      "end_seconds": 241.14,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.07,
      "end_seconds": 268.31,
      "duration_seconds": 15.24,
      "text": "Let me tell you where I've got to. It fits best with a possible tear in the main artery. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.88,
      "end_seconds": 273.43,
      "duration_seconds": 3.55,
      "text": "Is it dangerous, you know, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.12,
      "end_seconds": 286.65,
      "duration_seconds": 12.53,
      "text": "I understand the worry. At the moment I'd say it's a possible tear in the main artery, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 288.13,
      "end_seconds": 292.19,
      "duration_seconds": 4.06,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.19,
      "end_seconds": 328.06,
      "duration_seconds": 34.87,
      "text": "Good, thanks for doing that. I'm going to order an urgent CT scan of the chest and abdomen, for tearing chest pain. The result will help us decide whether anything more is needed. Do not move, I am calling an ambulance and you are going to a specialist centre. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'll also refer you to the cardiac surgical team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.41,
      "end_seconds": 337.46,
      "duration_seconds": 4.05,
      "text": "Let me think, sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.45,
      "end_seconds": 346.61,
      "duration_seconds": 7.16,
      "text": "We'll catch up straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.07,
      "end_seconds": 350.45,
      "duration_seconds": 2.38,
      "text": "Alright, thanks, take care."
    }
  ]
}