{
  "schema_version": "1.0",
  "encounter_id": "01300",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 7.36,
      "duration_seconds": 6.26,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.93,
      "end_seconds": 13.45,
      "duration_seconds": 5.52,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.26,
      "end_seconds": 21.03,
      "duration_seconds": 6.77,
      "text": "Yeah, it's a red sticky eye. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 24.26,
      "duration_seconds": 1.98,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.08,
      "end_seconds": 27.63,
      "duration_seconds": 2.55,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.85,
      "end_seconds": 31.63,
      "duration_seconds": 2.78,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.41,
      "end_seconds": 40.24,
      "duration_seconds": 7.83,
      "text": "A clean cloth helps a bit. And a gritty feeling as well, since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.05,
      "end_seconds": 42.71,
      "duration_seconds": 1.66,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.78,
      "end_seconds": 48.36,
      "duration_seconds": 3.58,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.15,
      "end_seconds": 51.6,
      "duration_seconds": 1.45,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.44,
      "end_seconds": 56.42,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.23,
      "end_seconds": 60.57,
      "duration_seconds": 3.34,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.29,
      "end_seconds": 65.5,
      "duration_seconds": 3.21,
      "text": "Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.14,
      "end_seconds": 70.52,
      "duration_seconds": 3.38,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.2,
      "end_seconds": 74.86,
      "duration_seconds": 2.66,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.38,
      "end_seconds": 91.83,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.46,
      "end_seconds": 95.54,
      "duration_seconds": 3.08,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.78,
      "end_seconds": 103.57,
      "duration_seconds": 3.79,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.76,
      "end_seconds": 107.66,
      "duration_seconds": 2.9,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.76,
      "end_seconds": 128.9,
      "duration_seconds": 5.14,
      "text": "Have you had any sensitivity to light, contact lens or blurred vision?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.91,
      "end_seconds": 136.83,
      "duration_seconds": 5.92,
      "text": "No, no sensitivity to light, contact lens or blurred vision."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.82,
      "end_seconds": 140.71,
      "duration_seconds": 2.89,
      "text": "What about pain in the eye?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.94,
      "end_seconds": 144.92,
      "duration_seconds": 2.98,
      "text": "No pain in the eye, thankfully."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.03,
      "end_seconds": 149.62,
      "duration_seconds": 3.59,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.79,
      "end_seconds": 152.48,
      "duration_seconds": 1.69,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.57,
      "end_seconds": 155.92,
      "duration_seconds": 2.35,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.39,
      "end_seconds": 159.09,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.7,
      "end_seconds": 165.26,
      "duration_seconds": 4.56,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.81,
      "end_seconds": 173.92,
      "duration_seconds": 2.11,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.91,
      "end_seconds": 201.32,
      "duration_seconds": 10.41,
      "text": "Okay: BP is 113 over 74, heart rate 74, respiratory rate 15. And temperature is 36.5 degrees, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.11,
      "end_seconds": 206.46,
      "duration_seconds": 2.35,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.81,
      "end_seconds": 210.64,
      "duration_seconds": 2.83,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.59,
      "end_seconds": 234.64,
      "duration_seconds": 7.05,
      "text": "The white of the eye is pink with some sticky discharge, and your pupil is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.18,
      "end_seconds": 243.6,
      "duration_seconds": 3.42,
      "text": "Alright, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.79,
      "end_seconds": 263.33,
      "duration_seconds": 4.54,
      "text": "Okay, so my impression is this: I'd lean towards infective conjunctivitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.84,
      "end_seconds": 269.15,
      "duration_seconds": 2.31,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.54,
      "end_seconds": 276.41,
      "duration_seconds": 5.87,
      "text": "Nothing I've seen today points to an emergency. It looks like infective conjunctivitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.08,
      "end_seconds": 298.45,
      "duration_seconds": 5.37,
      "text": "Today I'm not changing anything. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.31,
      "end_seconds": 302.43,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}