{
  "schema_version": "1.0",
  "encounter_id": "01186",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 3.93,
      "duration_seconds": 2.87,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 9.49,
      "duration_seconds": 3.76,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.41,
      "end_seconds": 17.8,
      "duration_seconds": 5.39,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.86,
      "end_seconds": 22.06,
      "duration_seconds": 3.2,
      "text": "please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 31.02,
      "duration_seconds": 7.17,
      "text": "Let me think, it's hard stools. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.04,
      "end_seconds": 36.64,
      "duration_seconds": 3.6,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 38.47,
      "end_seconds": 46.65,
      "duration_seconds": 8.18,
      "text": "Ah, she takes Foracort inhaler, twice a day. Right, it's a fibre supplement, 1 sachet, daily, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.26,
      "end_seconds": 50.66,
      "duration_seconds": 3.4,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.91,
      "end_seconds": 54.32,
      "duration_seconds": 2.41,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 54.86,
      "end_seconds": 58.62,
      "duration_seconds": 3.76,
      "text": "I think it's been nearer three weeks, actually"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.14,
      "end_seconds": 63.87,
      "duration_seconds": 4.73,
      "text": "okay, so roughly two to three weeks is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.34,
      "end_seconds": 67.34,
      "duration_seconds": 2.0,
      "text": "Yeah, uh, roughly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 71.56,
      "duration_seconds": 3.64,
      "text": "Yes. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.8,
      "end_seconds": 80.35,
      "duration_seconds": 6.55,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.43,
      "end_seconds": 88.45,
      "duration_seconds": 6.02,
      "text": "Take your time. Mild, moderate, or severe, if you had to to pick?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.11,
      "end_seconds": 93.58,
      "duration_seconds": 3.47,
      "text": "a seven out of ten, I suppose"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.9,
      "end_seconds": 100.89,
      "duration_seconds": 2.99,
      "text": "so, does anything set it off?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.89,
      "end_seconds": 104.47,
      "duration_seconds": 2.58,
      "text": "it's worse with low fibre"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.03,
      "end_seconds": 106.62,
      "duration_seconds": 1.59,
      "text": "does anything help it?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.17,
      "end_seconds": 114.25,
      "duration_seconds": 3.08,
      "text": "It settles a little with water."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.73,
      "end_seconds": 121.18,
      "duration_seconds": 6.45,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 121.28,
      "end_seconds": 128.03,
      "duration_seconds": 6.75,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.09,
      "end_seconds": 131.8,
      "duration_seconds": 2.71,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.19,
      "end_seconds": 135.48,
      "duration_seconds": 2.29,
      "text": "Oh, and mild bloating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.27,
      "end_seconds": 141.44,
      "duration_seconds": 5.17,
      "text": "Have you noticed blood in the stool, severe pain or weight loss?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.43,
      "end_seconds": 159.41,
      "duration_seconds": 15.98,
      "text": "No, you know, no blood in the stool, no severe pain, no weight loss. I was going less often at one point, but that that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 162.3,
      "duration_seconds": 1.48,
      "text": "how about vomiting?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.1,
      "end_seconds": 167.44,
      "duration_seconds": 3.34,
      "text": "No, I haven't had any vomiting."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 167.98,
      "end_seconds": 173.35,
      "duration_seconds": 5.37,
      "text": "Actually, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.71,
      "end_seconds": 181.43,
      "duration_seconds": 6.72,
      "text": "Hmm, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 188.76,
      "duration_seconds": 6.65,
      "text": "Alright, I'll note both what you've said and what you've noticed. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.72,
      "end_seconds": 195.18,
      "duration_seconds": 4.46,
      "text": "Yeah, you know, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.22,
      "end_seconds": 200.72,
      "duration_seconds": 3.5,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.34,
      "end_seconds": 214.85,
      "duration_seconds": 13.51,
      "text": "I have asthma. I kept putting it off, which I know isn't sensible. I have depression, for about a year. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.88,
      "end_seconds": 221.39,
      "duration_seconds": 4.51,
      "text": "Okay, I can see asthma in your file as well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.14,
      "end_seconds": 239.82,
      "duration_seconds": 2.68,
      "text": "alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.51,
      "end_seconds": 243.63,
      "duration_seconds": 3.12,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.18,
      "end_seconds": 246.43,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.66,
      "end_seconds": 252.01,
      "duration_seconds": 4.35,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.54,
      "end_seconds": 254.98,
      "duration_seconds": 2.44,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.24,
      "end_seconds": 260.21,
      "duration_seconds": 3.97,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.01,
      "end_seconds": 264.6,
      "duration_seconds": 3.59,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.43,
      "end_seconds": 268.68,
      "duration_seconds": 3.25,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 269.82,
      "end_seconds": 275.13,
      "duration_seconds": 5.31,
      "text": "here are the numbers, doctor pulse 74, blood pressure 123 over 72."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.76,
      "end_seconds": 276.72,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.1,
      "end_seconds": 283.58,
      "duration_seconds": 4.48,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.96,
      "end_seconds": 291.87,
      "duration_seconds": 0.91,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.81,
      "end_seconds": 295.96,
      "duration_seconds": 2.15,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.42,
      "end_seconds": 317.22,
      "duration_seconds": 2.8,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.16,
      "end_seconds": 336.83,
      "duration_seconds": 14.67,
      "text": "Okay, that's enough for me. Taking everything into account, I'd lean towards simple constipation from low fibre. I'm going to put you on lactulose, 15 ml, twice a day, two weeks. That should help with constipation."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.5,
      "end_seconds": 341.95,
      "duration_seconds": 4.45,
      "text": "alright, you know, I'll pick it up today"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.54,
      "end_seconds": 356.18,
      "duration_seconds": 13.64,
      "text": "Eat more fruit, vegetables and oats, and drink two litres of water. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.45,
      "end_seconds": 359.08,
      "duration_seconds": 1.63,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.49,
      "end_seconds": 368.87,
      "duration_seconds": 8.38,
      "text": "we'll catch up if it persists after a month i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.7,
      "end_seconds": 377.32,
      "duration_seconds": 6.62,
      "text": "Sorry, what was I saying, good, thanks, I'll see you then."
    }
  ]
}