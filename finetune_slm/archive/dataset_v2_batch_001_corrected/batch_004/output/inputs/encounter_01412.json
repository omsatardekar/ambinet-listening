{
  "schema_version": "1.0",
  "encounter_id": "01412",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.89,
      "duration_seconds": 3.77,
      "text": "Well, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.93,
      "end_seconds": 11.56,
      "duration_seconds": 4.63,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.7,
      "end_seconds": 23.22,
      "duration_seconds": 6.52,
      "text": "I, I wanted to get a sore stiff knee looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.41,
      "end_seconds": 32.11,
      "duration_seconds": 7.7,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.67,
      "end_seconds": 40.91,
      "duration_seconds": 8.24,
      "text": "I'd say on and off. I'd say moderate. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.93,
      "end_seconds": 45.02,
      "duration_seconds": 3.09,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.71,
      "end_seconds": 66.31,
      "duration_seconds": 20.6,
      "text": "Stiffness in the morning goes along with it, most of the time. Erm, I've also had the knee giving way a little, for about three months. Yeah, with stiffness in the morning, it's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.79,
      "end_seconds": 76.76,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.48,
      "end_seconds": 88.88,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.52,
      "end_seconds": 114.95,
      "duration_seconds": 7.43,
      "text": "Okay: saturation 99 percent, respiratory rate 16, pulse 65. And blood pressure 122 over 75."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.22,
      "end_seconds": 121.05,
      "duration_seconds": 3.83,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.05,
      "end_seconds": 125.1,
      "duration_seconds": 3.05,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.53,
      "end_seconds": 149.41,
      "duration_seconds": 8.88,
      "text": "The joint line is tender, there is a bit of crunching, and the knee bends to ninety degrees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.71,
      "end_seconds": 159.56,
      "duration_seconds": 1.85,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 168.49,
      "duration_seconds": 6.01,
      "text": "That's all I needed to check. A few quick ones: locked knee, fever or fall?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.53,
      "end_seconds": 174.31,
      "duration_seconds": 4.78,
      "text": "Uh, no, no locked knee, fever or fall."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.58,
      "end_seconds": 177.64,
      "duration_seconds": 2.06,
      "text": "Did you notice any redness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.26,
      "end_seconds": 179.88,
      "duration_seconds": 1.62,
      "text": "Definitely no redness."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.7,
      "end_seconds": 183.18,
      "duration_seconds": 1.48,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.44,
      "end_seconds": 186.25,
      "duration_seconds": 1.81,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.92,
      "end_seconds": 189.87,
      "duration_seconds": 2.95,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.97,
      "end_seconds": 194.41,
      "duration_seconds": 3.44,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.3,
      "end_seconds": 198.97,
      "duration_seconds": 3.67,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.74,
      "end_seconds": 201.83,
      "duration_seconds": 2.09,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.52,
      "end_seconds": 223.59,
      "duration_seconds": 6.07,
      "text": "Let's run through your medicines. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.41,
      "end_seconds": 244.11,
      "duration_seconds": 19.7,
      "text": "It's diclofenac, 50 milligrams, when needed for the joint pain. Yeah, uh, I take ibuprofen gel, three times a day. Um, I was on naproxen before. I stopped taking it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.74,
      "end_seconds": 248.45,
      "duration_seconds": 2.71,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.46,
      "end_seconds": 254.44,
      "duration_seconds": 4.98,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.36,
      "end_seconds": 257.06,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.79,
      "end_seconds": 262.57,
      "duration_seconds": 3.78,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.09,
      "end_seconds": 266.66,
      "duration_seconds": 3.57,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.41,
      "end_seconds": 275.01,
      "duration_seconds": 6.6,
      "text": "I, I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.95,
      "end_seconds": 308.85,
      "duration_seconds": 29.9,
      "text": "Understood. Alright, arthritis in your knees, that matches what I have here. Let me tell you where I've got to. This is probably knee osteoarthritis flare. Let's get an X-ray of the knee, for knee pain. The treatment will be paracetamol, 1 gram, four times a day, two weeks. You take it by mouth. That's for knee pain. Strengthen the thigh muscles and lose a little weight if you can."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.87,
      "end_seconds": 327.81,
      "duration_seconds": 14.94,
      "text": "Please take the tablets with food so they don't upset your stomach. I'll also refer you to physiotherapy. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.9,
      "end_seconds": 331.57,
      "duration_seconds": 1.67,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.81,
      "end_seconds": 335.67,
      "duration_seconds": 2.86,
      "text": "Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.71,
      "end_seconds": 339.04,
      "duration_seconds": 2.33,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.15,
      "end_seconds": 344.03,
      "duration_seconds": 3.88,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.49,
      "end_seconds": 348.71,
      "duration_seconds": 3.22,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.52,
      "end_seconds": 351.7,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}