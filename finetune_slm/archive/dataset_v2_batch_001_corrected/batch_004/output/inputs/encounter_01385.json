{
  "schema_version": "1.0",
  "encounter_id": "01385",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 10.42,
      "duration_seconds": 9.57,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.98,
      "end_seconds": 17.46,
      "duration_seconds": 4.48,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.1,
      "end_seconds": 25.72,
      "duration_seconds": 6.62,
      "text": "Honestly, it's a lingering cough, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.26,
      "end_seconds": 29.18,
      "duration_seconds": 1.92,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.8,
      "end_seconds": 33.5,
      "duration_seconds": 2.7,
      "text": "For two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.23,
      "end_seconds": 43.54,
      "duration_seconds": 8.31,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.32,
      "end_seconds": 65.69,
      "duration_seconds": 20.37,
      "text": "It's worse with cold air. Honestly, once or twice a day. My sister suggested writing things down, but I forgot. I'm hoping you can tell me something definite. Oh, there was a tickle in my throat, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.16,
      "end_seconds": 68.66,
      "duration_seconds": 1.5,
      "text": "Okay, any smoking?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.56,
      "end_seconds": 77.84,
      "duration_seconds": 3.28,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.43,
      "end_seconds": 81.18,
      "duration_seconds": 1.75,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 83.73,
      "duration_seconds": 1.8,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.26,
      "end_seconds": 87.03,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.68,
      "end_seconds": 94.29,
      "duration_seconds": 2.61,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.53,
      "end_seconds": 98.43,
      "duration_seconds": 2.9,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.18,
      "end_seconds": 104.84,
      "duration_seconds": 5.66,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 114.89,
      "duration_seconds": 4.11,
      "text": "Right, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.58,
      "end_seconds": 118.81,
      "duration_seconds": 2.23,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.45,
      "end_seconds": 137.28,
      "duration_seconds": 5.83,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 140.65,
      "duration_seconds": 1.43,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.45,
      "end_seconds": 151.74,
      "duration_seconds": 3.29,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.68,
      "end_seconds": 158.65,
      "duration_seconds": 4.97,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.2,
      "end_seconds": 162.18,
      "duration_seconds": 2.98,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.92,
      "end_seconds": 168.42,
      "duration_seconds": 5.5,
      "text": "Two months now. Honey and lemon. I take it at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.31,
      "end_seconds": 172.97,
      "duration_seconds": 2.66,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.64,
      "end_seconds": 183.14,
      "duration_seconds": 9.5,
      "text": "Erm, I had an operation for a hernia last spring. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.91,
      "end_seconds": 204.31,
      "duration_seconds": 3.4,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.82,
      "end_seconds": 209.67,
      "duration_seconds": 3.85,
      "text": "I've had thin bones for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.2,
      "end_seconds": 217.03,
      "duration_seconds": 6.83,
      "text": "Alright, thin bones, that matches what I have here. Any sign of shortness of breath?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.51,
      "end_seconds": 222.23,
      "duration_seconds": 3.72,
      "text": "Erm, no, none, no shortness of breath."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.0,
      "end_seconds": 227.98,
      "duration_seconds": 4.98,
      "text": "And what about fever, weight loss or coughing up blood?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.37,
      "end_seconds": 233.08,
      "duration_seconds": 2.71,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.63,
      "end_seconds": 237.97,
      "duration_seconds": 3.34,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.52,
      "end_seconds": 241.03,
      "duration_seconds": 2.51,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 246.62,
      "duration_seconds": 3.63,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.14,
      "end_seconds": 251.46,
      "duration_seconds": 3.32,
      "text": "Hmm, no, that side's been fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 252.22,
      "end_seconds": 262.4,
      "duration_seconds": 10.18,
      "text": "Okay, so the vitals from earlier. Temp 36.8 degrees, saturation 98 percent. Respiratory rate 17, pulse 74, BP is 113 over 68."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.79,
      "end_seconds": 269.23,
      "duration_seconds": 1.44,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.37,
      "end_seconds": 273.45,
      "duration_seconds": 2.08,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.08,
      "end_seconds": 275.75,
      "duration_seconds": 1.67,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.25,
      "end_seconds": 278.49,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.06,
      "end_seconds": 300.86,
      "duration_seconds": 3.8,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.42,
      "end_seconds": 320.31,
      "duration_seconds": 13.89,
      "text": "Good, you can sit up again. So where does that leave us? I can't pin this down yet. We're looking at a post-viral cough that is settling or early asthma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 321.16,
      "end_seconds": 323.97,
      "duration_seconds": 2.81,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.92,
      "end_seconds": 359.58,
      "duration_seconds": 30.66,
      "text": "Nothing I've seen today points to an emergency. It looks like a post-viral cough that is settling. It should settle over the next two to three weeks; steam and honey can help. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Do get help quickly if you cough up blood. Book a review if it lasts beyond eight weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.34,
      "end_seconds": 365.23,
      "duration_seconds": 3.89,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 366.98,
      "end_seconds": 371.63,
      "duration_seconds": 4.65,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.19,
      "end_seconds": 374.94,
      "duration_seconds": 1.75,
      "text": "So, see you soon."
    }
  ]
}