{
  "schema_version": "1.0",
  "encounter_id": "01256",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 6.94,
      "duration_seconds": 6.27,
      "text": "Hello, good to see you. Please sit. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.47,
      "end_seconds": 16.23,
      "duration_seconds": 7.76,
      "text": "Sorry, what was I saying, so the thing is, I've got heartburn most days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.64,
      "end_seconds": 20.41,
      "duration_seconds": 2.77,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.05,
      "end_seconds": 24.59,
      "duration_seconds": 3.54,
      "text": "I've, I've had it for five days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.97,
      "end_seconds": 38.21,
      "duration_seconds": 10.24,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.87,
      "end_seconds": 70.11,
      "duration_seconds": 31.24,
      "text": "honestly, a couple of times a week i get some relief from antacids i didn't want to bother you but it keeps coming back it's a a relief to finally sit down and talk about it hmm, and there's food sticking sometimes as well, about a month now uh, about food sticking sometimes, moderate, really"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.25,
      "end_seconds": 73.69,
      "duration_seconds": 2.44,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.58,
      "end_seconds": 79.74,
      "duration_seconds": 4.16,
      "text": "Trimethoprim. I come out in... well, itching"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.22,
      "end_seconds": 93.12,
      "duration_seconds": 1.9,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.65,
      "end_seconds": 99.11,
      "duration_seconds": 4.46,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.84,
      "end_seconds": 104.88,
      "duration_seconds": 2.04,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.72,
      "end_seconds": 108.5,
      "duration_seconds": 2.78,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.04,
      "end_seconds": 128.82,
      "duration_seconds": 3.78,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 142.33,
      "duration_seconds": 11.99,
      "text": "I take lansoprazole, 30 milligrams, before breakfast for my acidity. Sorry, what was I saying, I'm on antacid liquid, after meals."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.69,
      "end_seconds": 146.3,
      "duration_seconds": 2.61,
      "text": "okay, how much do you take?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.07,
      "end_seconds": 152.07,
      "duration_seconds": 5.0,
      "text": "10 ml, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.96,
      "end_seconds": 157.85,
      "duration_seconds": 3.89,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.41,
      "end_seconds": 161.86,
      "duration_seconds": 2.45,
      "text": "my father had bowel cancer"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.48,
      "end_seconds": 167.54,
      "duration_seconds": 4.06,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.59,
      "end_seconds": 179.07,
      "duration_seconds": 9.48,
      "text": "I mean, I've got acid reflux. I kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.44,
      "end_seconds": 190.3,
      "duration_seconds": 9.86,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Any chest pain on exertion or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.41,
      "end_seconds": 196.26,
      "duration_seconds": 4.85,
      "text": "No, no chest pain on exertion or weight loss."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.25,
      "end_seconds": 200.58,
      "duration_seconds": 2.33,
      "text": "Any vomiting or black stools?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.21,
      "end_seconds": 203.8,
      "duration_seconds": 2.59,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.3,
      "end_seconds": 207.05,
      "duration_seconds": 2.75,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.92,
      "end_seconds": 210.01,
      "duration_seconds": 1.09,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.91,
      "end_seconds": 214.86,
      "duration_seconds": 3.95,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.76,
      "end_seconds": 228.2,
      "duration_seconds": 2.44,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.25,
      "end_seconds": 250.95,
      "duration_seconds": 9.7,
      "text": "Okay: respiratory rate 14, BP is 108 over 79, temp 36.6 degrees. And SpO2 98 percent on room air, pulse 76."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.38,
      "end_seconds": 256.36,
      "duration_seconds": 3.98,
      "text": "actually, uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.52,
      "end_seconds": 264.94,
      "duration_seconds": 3.42,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.75,
      "end_seconds": 270.66,
      "duration_seconds": 3.91,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.74,
      "end_seconds": 274.52,
      "duration_seconds": 2.78,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.08,
      "end_seconds": 291.84,
      "duration_seconds": 4.76,
      "text": "Your tummy is soft with mild tenderness at the top."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.26,
      "end_seconds": 309.13,
      "duration_seconds": 12.87,
      "text": "That's the examination finished. Taking everything into account, the most likely explanation is reflux with a swallowing symptom that needs a camera test. Another possibility is a narrowing of the gullet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.61,
      "end_seconds": 333.88,
      "duration_seconds": 10.27,
      "text": "Eat smaller meals and and avoid eating for three hours before bed. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.66,
      "end_seconds": 337.86,
      "duration_seconds": 2.2,
      "text": "Alright, thanks, take care."
    }
  ]
}