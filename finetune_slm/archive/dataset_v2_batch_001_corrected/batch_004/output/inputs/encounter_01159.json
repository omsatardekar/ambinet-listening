{
  "schema_version": "1.0",
  "encounter_id": "01159",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 8.1,
      "duration_seconds": 7.42,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.06,
      "end_seconds": 13.38,
      "duration_seconds": 4.32,
      "text": "Right, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 26.24,
      "duration_seconds": 12.15,
      "text": "I mean, mainly my face drooping on one side. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.72,
      "end_seconds": 30.69,
      "duration_seconds": 3.97,
      "text": "I follow. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.87,
      "end_seconds": 46.19,
      "duration_seconds": 14.32,
      "text": "Uh, a eight out of ten, I suppose. I've also had a sudden headache, since yesterday. With sudden headache, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.04,
      "end_seconds": 55.33,
      "duration_seconds": 3.29,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.69,
      "end_seconds": 65.72,
      "duration_seconds": 3.03,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.73,
      "end_seconds": 94.32,
      "duration_seconds": 9.59,
      "text": "Okay: saturation 98 percent, temperature 36.6. And BP is 159 over 96, pulse is 73 beats a minute."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.87,
      "end_seconds": 99.75,
      "duration_seconds": 3.88,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.93,
      "end_seconds": 103.71,
      "duration_seconds": 2.78,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.61,
      "end_seconds": 106.94,
      "duration_seconds": 2.33,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 128.56,
      "duration_seconds": 6.66,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.29,
      "end_seconds": 137.94,
      "duration_seconds": 3.65,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.1,
      "end_seconds": 153.27,
      "duration_seconds": 4.17,
      "text": "Any fever, loss of consciousness or seizure at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.31,
      "end_seconds": 157.48,
      "duration_seconds": 3.17,
      "text": "Mm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.09,
      "end_seconds": 161.69,
      "duration_seconds": 2.6,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.57,
      "end_seconds": 167.98,
      "duration_seconds": 4.41,
      "text": "Oh, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.85,
      "end_seconds": 170.93,
      "duration_seconds": 2.08,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.86,
      "end_seconds": 174.31,
      "duration_seconds": 2.45,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.26,
      "end_seconds": 178.94,
      "duration_seconds": 2.68,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.65,
      "end_seconds": 186.23,
      "duration_seconds": 6.58,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.04,
      "end_seconds": 192.69,
      "duration_seconds": 2.65,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.23,
      "end_seconds": 198.79,
      "duration_seconds": 4.56,
      "text": "Apixaban, 5 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.8,
      "end_seconds": 207.39,
      "duration_seconds": 4.59,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.52,
      "end_seconds": 210.77,
      "duration_seconds": 2.25,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.33,
      "end_seconds": 218.47,
      "duration_seconds": 6.14,
      "text": "Tell me about any past illnesses or ongoing conditions. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.99,
      "end_seconds": 236.62,
      "duration_seconds": 17.63,
      "text": "I've had high blood pressure, yes. I looked a few things up online, and that probably didn't help. Yeah, I've got an irregular heartbeat. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.6,
      "end_seconds": 255.65,
      "duration_seconds": 4.05,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.22,
      "end_seconds": 260.84,
      "duration_seconds": 3.62,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.81,
      "end_seconds": 265.04,
      "duration_seconds": 2.23,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.97,
      "end_seconds": 270.0,
      "duration_seconds": 4.03,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.67,
      "end_seconds": 274.69,
      "duration_seconds": 3.02,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.5,
      "end_seconds": 281.67,
      "duration_seconds": 5.17,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.34,
      "end_seconds": 303.32,
      "duration_seconds": 12.98,
      "text": "From what you've told me and what I found, my working impression is a possible stroke, within the treatment window. A migraine with aura is still possible."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.1,
      "end_seconds": 308.43,
      "duration_seconds": 3.33,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.27,
      "end_seconds": 333.59,
      "duration_seconds": 24.32,
      "text": "I understand the worry. At the moment I'd say it's a possible stroke, within the treatment window, and we'll watch how it goes. I'm going to send a referral to the stroke team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.56,
      "end_seconds": 343.95,
      "duration_seconds": 9.39,
      "text": "Ah, could I get an urgent CT scan of the head done? A friend had it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.94,
      "end_seconds": 356.33,
      "duration_seconds": 11.39,
      "text": "Not at this point, no. It isn't indicated yet. Keep an eye out, and if the symptoms change, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.35,
      "end_seconds": 361.19,
      "duration_seconds": 3.84,
      "text": "I, I know what to watch for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.32,
      "end_seconds": 364.98,
      "duration_seconds": 2.66,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.31,
      "end_seconds": 371.19,
      "duration_seconds": 4.88,
      "text": "Mm, uh, great, thank you for your help."
    }
  ]
}