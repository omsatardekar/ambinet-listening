{
  "schema_version": "1.0",
  "encounter_id": "01208",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.7,
      "duration_seconds": 3.63,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.1,
      "end_seconds": 11.12,
      "duration_seconds": 4.02,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.19,
      "end_seconds": 17.43,
      "duration_seconds": 5.24,
      "text": "So, I've been getting out of breath on the stairs, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.34,
      "end_seconds": 21.24,
      "duration_seconds": 2.9,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 36.62,
      "duration_seconds": 3.08,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.29,
      "end_seconds": 64.27,
      "duration_seconds": 10.98,
      "text": "Okay: oxygen saturation is 98 percent, heart rate 113, blood pressure 130 over 76, respiratory rate 19. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.86,
      "end_seconds": 68.41,
      "duration_seconds": 2.55,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.43,
      "end_seconds": 78.74,
      "duration_seconds": 9.31,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.29,
      "end_seconds": 84.67,
      "duration_seconds": 5.38,
      "text": "Let me think, it happens all the time. I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.29,
      "end_seconds": 87.78,
      "duration_seconds": 2.49,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.17,
      "end_seconds": 92.23,
      "duration_seconds": 3.06,
      "text": "It usually comes with craving ice."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.35,
      "end_seconds": 95.66,
      "duration_seconds": 2.31,
      "text": "Have you been looking pale?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.53,
      "end_seconds": 102.51,
      "duration_seconds": 5.98,
      "text": "Yeah. Six months, I'd say. The craving ice? That's been for six months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.57,
      "end_seconds": 106.75,
      "duration_seconds": 3.18,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.91,
      "end_seconds": 109.39,
      "duration_seconds": 1.48,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.22,
      "end_seconds": 115.41,
      "duration_seconds": 4.19,
      "text": "Any heavy periods, black stools or weight loss at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.34,
      "end_seconds": 122.49,
      "duration_seconds": 6.15,
      "text": "No heavy periods, black stools or weight loss, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 126.53,
      "duration_seconds": 3.07,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.6,
      "end_seconds": 129.67,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.01,
      "end_seconds": 133.69,
      "duration_seconds": 2.68,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.54,
      "end_seconds": 141.39,
      "duration_seconds": 5.85,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.6,
      "end_seconds": 147.48,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.38,
      "end_seconds": 152.18,
      "duration_seconds": 2.8,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.79,
      "end_seconds": 172.17,
      "duration_seconds": 3.38,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.28,
      "end_seconds": 189.54,
      "duration_seconds": 16.26,
      "text": "It's clopidogrel, 75 milligrams, once a day. I took the morning off to come in today. I did try to ignore it for a while. Valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.29,
      "end_seconds": 192.34,
      "duration_seconds": 2.05,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.95,
      "end_seconds": 197.98,
      "duration_seconds": 4.03,
      "text": "Six months now. A multivitamin. I take it daily."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.74,
      "end_seconds": 202.95,
      "duration_seconds": 4.21,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.79,
      "end_seconds": 207.23,
      "duration_seconds": 3.44,
      "text": "Yes, heart disease. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.41,
      "end_seconds": 216.41,
      "duration_seconds": 8.0,
      "text": "I follow. Okay, I can see heart disease in your file as well. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.81,
      "end_seconds": 229.62,
      "duration_seconds": 11.81,
      "text": "I gave up cigarettes last spring. Nothing, I'm teetotal. I do a yoga class on Thursdays. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.79,
      "end_seconds": 235.01,
      "duration_seconds": 4.22,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.84,
      "end_seconds": 239.01,
      "duration_seconds": 2.17,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.94,
      "end_seconds": 256.52,
      "duration_seconds": 5.58,
      "text": "Your inner eyelids look pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.12,
      "end_seconds": 263.8,
      "duration_seconds": 1.68,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.27,
      "end_seconds": 290.72,
      "duration_seconds": 17.45,
      "text": "Let me tell you where I've got to. This is probably tiredness probably from low iron. I want to be honest that this is an impression, not a final answer. Let's book a thyroid test to look into tiredness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.54,
      "end_seconds": 293.67,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.44,
      "end_seconds": 303.99,
      "duration_seconds": 8.55,
      "text": "A full blood count is what I'd like next, for tiredness. Let's book an iron study to look into pallor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.0,
      "end_seconds": 309.17,
      "duration_seconds": 1.17,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.13,
      "end_seconds": 333.71,
      "duration_seconds": 22.58,
      "text": "What I'm giving you is ferrous sulfate, 200 milligrams, once a day, three months. You take it by mouth. It's for low iron. Take the iron with orange juice, not with tea. Come back after the results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.68,
      "end_seconds": 341.19,
      "duration_seconds": 5.51,
      "text": "Sorry, what was I saying, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.44,
      "end_seconds": 347.43,
      "duration_seconds": 1.99,
      "text": "Okay, see you soon."
    }
  ]
}