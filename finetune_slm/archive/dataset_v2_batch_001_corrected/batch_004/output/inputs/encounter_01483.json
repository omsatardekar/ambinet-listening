{
  "schema_version": "1.0",
  "encounter_id": "01483",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.31,
      "duration_seconds": 4.18,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.89,
      "end_seconds": 10.41,
      "duration_seconds": 4.52,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.6,
      "end_seconds": 21.57,
      "duration_seconds": 9.97,
      "text": "Mainly sudden shortness of breath. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.91,
      "end_seconds": 24.38,
      "duration_seconds": 2.47,
      "text": "Understood. How frequently does it come?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.67,
      "end_seconds": 29.32,
      "duration_seconds": 3.65,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.38,
      "end_seconds": 34.64,
      "duration_seconds": 3.26,
      "text": "Have you been coughing up a little blood?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.39,
      "end_seconds": 40.19,
      "duration_seconds": 3.8,
      "text": "Ah, um, yes, for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.61,
      "end_seconds": 43.99,
      "duration_seconds": 2.38,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.0,
      "end_seconds": 53.36,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.86,
      "end_seconds": 77.8,
      "duration_seconds": 7.94,
      "text": "Okay: blood pressure 139 over 89, pulse 98, saturation 90 percent, temperature is 36.7 degrees, respiratory rate 24."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.12,
      "end_seconds": 80.63,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 84.11,
      "duration_seconds": 2.91,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.63,
      "end_seconds": 90.53,
      "duration_seconds": 3.9,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.31,
      "end_seconds": 93.66,
      "duration_seconds": 1.35,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.68,
      "end_seconds": 117.66,
      "duration_seconds": 6.98,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.41,
      "end_seconds": 125.11,
      "duration_seconds": 2.7,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.93,
      "end_seconds": 140.6,
      "duration_seconds": 3.67,
      "text": "A few quick ones: fever, chest tightness or wheeze?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.42,
      "end_seconds": 146.46,
      "duration_seconds": 5.04,
      "text": "I haven't had fever, chest tightness or wheeze, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.05,
      "end_seconds": 151.13,
      "duration_seconds": 4.08,
      "text": "Alright, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.69,
      "end_seconds": 155.75,
      "duration_seconds": 3.06,
      "text": "Actually, no, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.79,
      "end_seconds": 160.14,
      "duration_seconds": 2.35,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.23,
      "end_seconds": 165.22,
      "duration_seconds": 2.99,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.0,
      "end_seconds": 173.7,
      "duration_seconds": 4.7,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.22,
      "end_seconds": 183.38,
      "duration_seconds": 9.16,
      "text": "Allopurinol. I take it 100 milligrams, once a day. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.2,
      "end_seconds": 186.67,
      "duration_seconds": 2.47,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.7,
      "end_seconds": 198.15,
      "duration_seconds": 10.45,
      "text": "About about a year. I take something called napr... naproxen, 250 milligrams, maybe, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.09,
      "end_seconds": 203.07,
      "duration_seconds": 3.98,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.16,
      "end_seconds": 212.44,
      "duration_seconds": 7.28,
      "text": "No, it's at home. It's alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.71,
      "end_seconds": 217.3,
      "duration_seconds": 4.59,
      "text": "Yes, carry on. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.58,
      "end_seconds": 232.92,
      "duration_seconds": 14.34,
      "text": "I walk the dog every morning. I retired from the post office two years ago. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.06,
      "end_seconds": 235.43,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.18,
      "end_seconds": 239.25,
      "duration_seconds": 3.07,
      "text": "Well, no, not at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.9,
      "end_seconds": 246.09,
      "duration_seconds": 6.19,
      "text": "Any health conditions I should have on record? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.94,
      "end_seconds": 255.81,
      "duration_seconds": 8.87,
      "text": "I've, I've had gout, yes. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.61,
      "end_seconds": 257.99,
      "duration_seconds": 1.38,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.72,
      "end_seconds": 268.11,
      "duration_seconds": 8.39,
      "text": "I have arthritis in my knees, for nearly five years. Thin bones, for five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.82,
      "end_seconds": 278.62,
      "duration_seconds": 8.8,
      "text": "Mm, okay. Yes, arthritis in your knees and thin bones are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.35,
      "end_seconds": 296.0,
      "duration_seconds": 2.65,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.62,
      "end_seconds": 305.45,
      "duration_seconds": 8.83,
      "text": "Years back I got a rash all over from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.74,
      "end_seconds": 318.0,
      "duration_seconds": 11.26,
      "text": "From what you've told me and what I found, I think we're dealing with a possible blood clot in the lung at this stage."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.8,
      "end_seconds": 323.98,
      "duration_seconds": 4.18,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.22,
      "end_seconds": 355.5,
      "duration_seconds": 30.28,
      "text": "It's reasonable to be concerned, but right now a possible blood clot in the lung is my leading thought, not anything worse. Let's get a CT scan of the chest, for breathlessness. The result will help us decide whether anything more is needed. You need to go to hospital now for a scan. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.66,
      "end_seconds": 359.18,
      "duration_seconds": 2.52,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.7,
      "end_seconds": 366.6,
      "duration_seconds": 6.9,
      "text": "I'd like to see you again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.26,
      "end_seconds": 370.4,
      "duration_seconds": 3.14,
      "text": "Great, thank you for your help."
    }
  ]
}