  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 6.39,
      "duration_seconds": 5.29,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.59,
      "end_seconds": 12.09,
      "duration_seconds": 4.5,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.19,
      "end_seconds": 17.0,
      "duration_seconds": 2.81,
      "text": "It's no real problems, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.01,
      "end_seconds": 22.02,
      "duration_seconds": 3.01,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.26,
      "end_seconds": 35.94,
      "duration_seconds": 12.68,
      "text": "it feels mild to me as for bit of back stiffness, I honestly can't say when that began it might have been last month or the month before"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.9,
      "end_seconds": 40.62,
      "duration_seconds": 3.72,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.41,
      "end_seconds": 43.96,
      "duration_seconds": 1.55,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.84,
      "end_seconds": 50.72,
      "duration_seconds": 5.88,
      "text": "have you had no real problems before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.16,
      "end_seconds": 60.87,
      "duration_seconds": 8.71,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.03,
      "end_seconds": 74.59,
      "duration_seconds": 3.56,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.42,
      "end_seconds": 77.79,
      "duration_seconds": 2.37,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.99,
      "end_seconds": 82.93,
      "duration_seconds": 3.94,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.56,
      "end_seconds": 89.21,
      "duration_seconds": 3.65,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.21,
      "end_seconds": 93.11,
      "duration_seconds": 2.9,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.43,
      "end_seconds": 97.59,
      "duration_seconds": 3.16,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.66,
      "end_seconds": 102.61,
      "duration_seconds": 2.95,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.53,
      "end_seconds": 107.92,
      "duration_seconds": 3.39,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.59,
      "end_seconds": 112.35,
      "duration_seconds": 2.76,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.2,
      "end_seconds": 118.41,
      "duration_seconds": 4.21,
      "text": "erm, no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 128.76,
      "duration_seconds": 6.86,
      "text": "Has anyone ever diagnosed you with something? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.57,
      "end_seconds": 141.27,
      "duration_seconds": 10.7,
      "text": "High cholesterol, for five years. I'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.5,
      "end_seconds": 154.74,
      "duration_seconds": 10.24,
      "text": "Yes, high cholesterol is known to us, good to have that clear. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.35,
      "end_seconds": 160.91,
      "duration_seconds": 4.56,
      "text": "Hmm, no, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.77,
      "end_seconds": 181.3,
      "duration_seconds": 5.53,
      "text": "Did you get weight loss, chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.55,
      "end_seconds": 187.14,
      "duration_seconds": 4.59,
      "text": "no, you know, none of those at all"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.76,
      "end_seconds": 192.79,
      "duration_seconds": 4.03,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.8,
      "end_seconds": 195.92,
      "duration_seconds": 2.12,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.92,
      "end_seconds": 200.93,
      "duration_seconds": 3.01,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.26,
      "end_seconds": 213.55,
      "duration_seconds": 2.29,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.44,
      "end_seconds": 234.46,
      "duration_seconds": 9.02,
      "text": "Okay: blood pressure 112 over 73, SpO2 98 percent on room air. And temperature 36.6, pulse is 81 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.51,
      "end_seconds": 237.33,
      "duration_seconds": 1.82,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.94,
      "end_seconds": 243.56,
      "duration_seconds": 4.62,
      "text": "They help me see the the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.27,
      "end_seconds": 247.3,
      "duration_seconds": 2.03,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.26,
      "end_seconds": 250.62,
      "duration_seconds": 2.36,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.92,
      "end_seconds": 270.56,
      "duration_seconds": 2.64,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.54,
      "end_seconds": 285.11,
      "duration_seconds": 10.57,
      "text": "Good, you can sit up again. So, based on the history and the examination, it fits best with a healthy adult with no worrying findings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.15,
      "end_seconds": 292.56,
      "duration_seconds": 3.41,
      "text": "Is it dangerous, um, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.73,
      "end_seconds": 303.36,
      "duration_seconds": 9.63,
      "text": "Nothing I've seen today points to an emergency. It looks like a healthy adult with no worrying findings, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.77,
      "end_seconds": 328.38,
      "duration_seconds": 13.61,
      "text": "Let's book a fasting sugar test to look into routine check. Keep up regular exercise and a balanced diet. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.24,
      "end_seconds": 334.71,
      "duration_seconds": 4.47,
      "text": "good, uh, thanks, I'll see you then"
    }
  ]
}