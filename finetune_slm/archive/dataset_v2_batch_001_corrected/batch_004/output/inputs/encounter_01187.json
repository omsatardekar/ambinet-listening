{
  "schema_version": "1.0",
  "encounter_id": "01187",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 3.02,
      "duration_seconds": 2.3,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.98,
      "end_seconds": 8.92,
      "duration_seconds": 3.94,
      "text": "Okay, so good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.84,
      "end_seconds": 12.47,
      "duration_seconds": 1.63,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.36,
      "end_seconds": 16.53,
      "duration_seconds": 3.17,
      "text": "I'm here because of planning a trip."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.56,
      "end_seconds": 22.63,
      "duration_seconds": 5.07,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.19,
      "end_seconds": 26.73,
      "duration_seconds": 3.54,
      "text": "Yeah, I'm on losartan, once a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.76,
      "end_seconds": 30.78,
      "duration_seconds": 2.02,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.47,
      "end_seconds": 37.82,
      "duration_seconds": 5.35,
      "text": "50 milligrams. Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.67,
      "end_seconds": 43.08,
      "duration_seconds": 3.41,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.53,
      "end_seconds": 53.59,
      "duration_seconds": 9.06,
      "text": "Um, not with me. I'll bring it next time. Metoprolol. I take it twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.61,
      "end_seconds": 56.68,
      "duration_seconds": 2.07,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.62,
      "end_seconds": 62.79,
      "duration_seconds": 4.17,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.43,
      "end_seconds": 67.39,
      "duration_seconds": 2.96,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.37,
      "end_seconds": 75.22,
      "duration_seconds": 6.85,
      "text": "About about a month. Before this I was on valsartan; that's been stopped."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 79.44,
      "duration_seconds": 3.31,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.22,
      "end_seconds": 89.03,
      "duration_seconds": 7.81,
      "text": "Since Monday, that's when it began. There's a mild sore arm from last injection as well."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.76,
      "end_seconds": 110.41,
      "duration_seconds": 3.65,
      "text": "And what about recent illness, rash or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.14,
      "end_seconds": 115.48,
      "duration_seconds": 4.34,
      "text": "So, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.99,
      "end_seconds": 118.65,
      "duration_seconds": 2.66,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.28,
      "end_seconds": 122.77,
      "duration_seconds": 3.49,
      "text": "Nothing on the skin, you know, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 127.7,
      "duration_seconds": 4.06,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.5,
      "end_seconds": 134.7,
      "duration_seconds": 5.2,
      "text": "So, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.28,
      "end_seconds": 138.12,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 141.51,
      "duration_seconds": 2.17,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.03,
      "end_seconds": 153.72,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.49,
      "end_seconds": 158.76,
      "duration_seconds": 3.27,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.7,
      "end_seconds": 161.56,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.26,
      "end_seconds": 173.01,
      "duration_seconds": 9.75,
      "text": "I've had an underactive thyroid for about ten years now. I've had heart disease for about ten years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.12,
      "end_seconds": 186.45,
      "duration_seconds": 12.33,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.98,
      "end_seconds": 203.28,
      "duration_seconds": 15.3,
      "text": "I've never touched a cigarette. No, I share a house with my brother. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.77,
      "end_seconds": 208.29,
      "duration_seconds": 3.52,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.06,
      "end_seconds": 213.95,
      "duration_seconds": 4.89,
      "text": "My grandmother had dementia. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.83,
      "end_seconds": 218.7,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.21,
      "end_seconds": 231.52,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.1,
      "end_seconds": 260.59,
      "duration_seconds": 8.49,
      "text": "Okay: pulse 82, blood pressure 126 over 78, respiratory rate 15. And temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.56,
      "end_seconds": 264.26,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.15,
      "end_seconds": 274.76,
      "duration_seconds": 8.61,
      "text": "We'll go over that shortly. Putting together what you've described, it points towards fit to have travel vaccinations."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.73,
      "end_seconds": 318.51,
      "duration_seconds": 24.78,
      "text": "Let's use hepatitis A vaccine, 1 dose, once, single dose. It's for travel. The pharmacy will go through the details again when you pick it up. Drink bottled water and use insect repellent. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.77,
      "end_seconds": 322.82,
      "duration_seconds": 3.05,
      "text": "Thank you, you know, that's clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.79,
      "end_seconds": 327.53,
      "duration_seconds": 3.74,
      "text": "Come back in six months for the booster."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.06,
      "end_seconds": 329.95,
      "duration_seconds": 1.89,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.49,
      "end_seconds": 334.09,
      "duration_seconds": 2.6,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.43,
      "end_seconds": 338.68,
      "duration_seconds": 3.25,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}