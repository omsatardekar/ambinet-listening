{
  "schema_version": "1.0",
  "encounter_id": "01075",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 3.21,
      "duration_seconds": 2.68,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.61,
      "end_seconds": 9.28,
      "duration_seconds": 4.67,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.58,
      "end_seconds": 19.77,
      "duration_seconds": 9.19,
      "text": "It's pain on the outside of my elbow. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 24.44,
      "duration_seconds": 3.27,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.28,
      "end_seconds": 28.75,
      "duration_seconds": 3.47,
      "text": "Ever since... since last night, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.19,
      "end_seconds": 34.77,
      "duration_seconds": 4.58,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.25,
      "end_seconds": 47.61,
      "duration_seconds": 11.36,
      "text": "It happens every other day. I get some relief from rest. I notice it more with lifting the kettle and gripping."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 51.4,
      "duration_seconds": 2.78,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.95,
      "end_seconds": 64.02,
      "duration_seconds": 11.07,
      "text": "It usually comes with a weaker grip. The weaker grip? That's been since last night. About weaker grip, mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.12,
      "end_seconds": 81.5,
      "duration_seconds": 3.38,
      "text": "Alright, any numbness, swelling or neck pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.86,
      "end_seconds": 84.94,
      "duration_seconds": 2.08,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.84,
      "end_seconds": 89.54,
      "duration_seconds": 2.7,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.1,
      "end_seconds": 92.54,
      "duration_seconds": 2.44,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.5,
      "end_seconds": 96.57,
      "duration_seconds": 2.07,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.98,
      "end_seconds": 99.49,
      "duration_seconds": 1.51,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.21,
      "end_seconds": 108.4,
      "duration_seconds": 8.19,
      "text": "Any allergies to tablets, food or anything in the environment? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.09,
      "end_seconds": 118.75,
      "duration_seconds": 9.66,
      "text": "Okay, so years back I got a rash from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.56,
      "end_seconds": 138.0,
      "duration_seconds": 4.44,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.51,
      "end_seconds": 143.7,
      "duration_seconds": 4.19,
      "text": "Arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.26,
      "end_seconds": 154.9,
      "duration_seconds": 3.64,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.71,
      "end_seconds": 161.56,
      "duration_seconds": 5.85,
      "text": "Naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.52,
      "end_seconds": 178.32,
      "duration_seconds": 4.8,
      "text": "Right, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.37,
      "end_seconds": 183.21,
      "duration_seconds": 2.84,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.08,
      "end_seconds": 186.92,
      "duration_seconds": 1.84,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.96,
      "end_seconds": 191.93,
      "duration_seconds": 2.97,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.93,
      "end_seconds": 194.53,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.49,
      "end_seconds": 197.8,
      "duration_seconds": 2.31,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 200.09,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.09,
      "end_seconds": 204.47,
      "duration_seconds": 3.38,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.03,
      "end_seconds": 208.98,
      "duration_seconds": 2.95,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.52,
      "end_seconds": 224.6,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.53,
      "end_seconds": 258.12,
      "duration_seconds": 13.59,
      "text": "Okay: height 164 centimetres, weight 90 kilos. And temperature is 36.9 degrees, heart rate 75, oxygen saturation is 97 percent, pressure 127 over 77, respiratory rate 17."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.53,
      "end_seconds": 264.11,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.5,
      "end_seconds": 268.16,
      "duration_seconds": 2.66,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.99,
      "end_seconds": 273.44,
      "duration_seconds": 2.45,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.61,
      "end_seconds": 276.28,
      "duration_seconds": 1.67,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.08,
      "end_seconds": 279.26,
      "duration_seconds": 1.18,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.07,
      "end_seconds": 296.29,
      "duration_seconds": 9.22,
      "text": "It's tender over the bony point on the outside, and it hurts when I resist your wrist going up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.24,
      "end_seconds": 307.51,
      "duration_seconds": 6.27,
      "text": "You can relax now. Putting it all together, the most likely explanation is tennis elbow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.94,
      "end_seconds": 310.96,
      "duration_seconds": 2.02,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.15,
      "end_seconds": 327.18,
      "duration_seconds": 15.03,
      "text": "I understand the worry. At the moment I'd say it's tennis elbow, and we'll watch how it goes. Rest it, use a forearm strap and do the stretches I'll show you. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.24,
      "end_seconds": 332.78,
      "duration_seconds": 3.54,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}