{
  "schema_version": "1.0",
  "encounter_id": "01345",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.45,
      "duration_seconds": 5.25,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.42,
      "end_seconds": 12.17,
      "duration_seconds": 4.75,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.88,
      "end_seconds": 18.5,
      "duration_seconds": 5.62,
      "text": "So the thing is, I've got an itchy patch on my wrist."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 23.48,
      "duration_seconds": 3.9,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.16,
      "end_seconds": 26.46,
      "duration_seconds": 2.3,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.28,
      "end_seconds": 38.37,
      "duration_seconds": 10.09,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.01,
      "end_seconds": 45.72,
      "duration_seconds": 6.71,
      "text": "Honestly, once or twice a day. I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.01,
      "end_seconds": 50.32,
      "duration_seconds": 3.31,
      "text": "So, any dry flaky skin as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.37,
      "end_seconds": 57.76,
      "duration_seconds": 6.39,
      "text": "Yes, since last Tuesday. As for dry flaky skin, I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.38,
      "end_seconds": 61.76,
      "duration_seconds": 3.38,
      "text": "Have you had a bit of redness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.44,
      "end_seconds": 66.06,
      "duration_seconds": 2.62,
      "text": "Yes, uh, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.52,
      "end_seconds": 76.48,
      "duration_seconds": 2.96,
      "text": "Right, have you had any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.01,
      "end_seconds": 80.55,
      "duration_seconds": 2.54,
      "text": "Nope, um, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.13,
      "end_seconds": 86.08,
      "duration_seconds": 1.95,
      "text": "Any spreading or blisters?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.16,
      "end_seconds": 91.73,
      "duration_seconds": 3.57,
      "text": "Um, no, no spreading or blisters."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.93,
      "end_seconds": 95.36,
      "duration_seconds": 3.43,
      "text": "Hm, okay. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.21,
      "end_seconds": 99.09,
      "duration_seconds": 1.88,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.48,
      "end_seconds": 104.68,
      "duration_seconds": 4.2,
      "text": "Right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.64,
      "end_seconds": 114.03,
      "duration_seconds": 6.39,
      "text": "Gout, for nearly five years. I have heart failure, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.12,
      "end_seconds": 125.91,
      "duration_seconds": 9.79,
      "text": "Understood. Right, so heart failure is already on your record. We'll keep that in mind today. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.7,
      "end_seconds": 128.91,
      "duration_seconds": 2.21,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.37,
      "end_seconds": 144.82,
      "duration_seconds": 1.45,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.54,
      "end_seconds": 149.74,
      "duration_seconds": 3.2,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.14,
      "end_seconds": 153.02,
      "duration_seconds": 1.88,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.07,
      "end_seconds": 156.82,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.61,
      "end_seconds": 161.96,
      "duration_seconds": 3.35,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.36,
      "end_seconds": 166.36,
      "duration_seconds": 3.0,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.91,
      "end_seconds": 169.3,
      "duration_seconds": 2.39,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.38,
      "end_seconds": 173.87,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.73,
      "end_seconds": 177.63,
      "duration_seconds": 1.9,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.47,
      "end_seconds": 183.16,
      "duration_seconds": 4.69,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.83,
      "end_seconds": 186.3,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.98,
      "end_seconds": 204.4,
      "duration_seconds": 16.42,
      "text": "Spironolactone, 25 milligrams, once a day. I'm hoping you can tell me something definite. I take a plain moisturiser, twice a day. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.97,
      "end_seconds": 206.24,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.03,
      "end_seconds": 210.33,
      "duration_seconds": 3.3,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.29,
      "end_seconds": 216.57,
      "duration_seconds": 4.28,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.06,
      "end_seconds": 230.04,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.6,
      "end_seconds": 254.84,
      "duration_seconds": 6.24,
      "text": "Okay: pulse is 81 beats a minute, respiratory rate 14, blood pressure 128 over 79."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.45,
      "end_seconds": 259.69,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.1,
      "end_seconds": 263.19,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.36,
      "end_seconds": 277.06,
      "duration_seconds": 6.7,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.67,
      "end_seconds": 284.41,
      "duration_seconds": 1.74,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.6,
      "end_seconds": 326.97,
      "duration_seconds": 30.37,
      "text": "So where does that leave us? This is probably mild contact dermatitis from the watch strap. I'd like you to take hydrocortisone cream, 1%, once a day, one week. That's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. If you smoke, this is a good moment to think about stopping, and we can help you with that. I'd like you back if it has not cleared in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.51,
      "end_seconds": 329.63,
      "duration_seconds": 2.12,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.64,
      "end_seconds": 335.94,
      "duration_seconds": 4.3,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.99,
      "end_seconds": 341.51,
      "duration_seconds": 3.52,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}