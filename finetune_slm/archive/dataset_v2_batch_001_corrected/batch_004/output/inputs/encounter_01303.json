{
  "schema_version": "1.0",
  "encounter_id": "01303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 2.43,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.05,
      "end_seconds": 7.59,
      "duration_seconds": 4.54,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.91,
      "end_seconds": 14.9,
      "duration_seconds": 2.99,
      "text": "So, I've been losing weight, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.6,
      "end_seconds": 17.99,
      "duration_seconds": 2.39,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.37,
      "end_seconds": 21.41,
      "duration_seconds": 2.04,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.24,
      "end_seconds": 25.77,
      "duration_seconds": 2.53,
      "text": "Right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.81,
      "end_seconds": 38.13,
      "duration_seconds": 10.32,
      "text": "A racing heart goes along with it, most of the time. As for racing heart, it's a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 44.02,
      "duration_seconds": 3.96,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.09,
      "end_seconds": 46.67,
      "duration_seconds": 1.58,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.06,
      "end_seconds": 51.06,
      "duration_seconds": 3.0,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.88,
      "end_seconds": 59.2,
      "duration_seconds": 6.32,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.82,
      "end_seconds": 76.12,
      "duration_seconds": 5.3,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.49,
      "end_seconds": 80.87,
      "duration_seconds": 3.38,
      "text": "It's diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.5,
      "end_seconds": 84.71,
      "duration_seconds": 3.21,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.42,
      "end_seconds": 104.38,
      "duration_seconds": 18.96,
      "text": "I used to drink heavily but I stopped four years ago. I retired from the post office two years ago. My husband and I live above the shop. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.11,
      "end_seconds": 110.23,
      "duration_seconds": 4.12,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.03,
      "end_seconds": 115.15,
      "duration_seconds": 4.12,
      "text": "Arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.93,
      "end_seconds": 124.88,
      "duration_seconds": 8.95,
      "text": "Okay, I can see arthritis in your knees in your file as well. Any chest pain, neck pain or diarrhoea at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.65,
      "end_seconds": 133.56,
      "duration_seconds": 2.91,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.45,
      "end_seconds": 137.07,
      "duration_seconds": 2.62,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.69,
      "end_seconds": 138.82,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.74,
      "end_seconds": 144.71,
      "duration_seconds": 3.97,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.79,
      "end_seconds": 148.73,
      "duration_seconds": 1.94,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.44,
      "end_seconds": 151.96,
      "duration_seconds": 2.52,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.79,
      "end_seconds": 166.9,
      "duration_seconds": 3.11,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.81,
      "end_seconds": 192.32,
      "duration_seconds": 11.51,
      "text": "Okay: temperature 37.1, blood pressure 133 over 84, pulse is 126 beats a minute, height 172 centimetres, weight 71 kilos, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.32,
      "end_seconds": 195.24,
      "duration_seconds": 1.92,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.41,
      "end_seconds": 198.48,
      "duration_seconds": 2.07,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.89,
      "end_seconds": 202.39,
      "duration_seconds": 2.5,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.9,
      "end_seconds": 206.14,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.38,
      "end_seconds": 218.46,
      "duration_seconds": 5.08,
      "text": "You have a fine tremor and your pulse is fast and regular."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.14,
      "end_seconds": 223.74,
      "duration_seconds": 1.6,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.61,
      "end_seconds": 244.82,
      "duration_seconds": 11.21,
      "text": "Putting it all together, it's hard to say. An overactive thyroid is one possibility and anxiety another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.12,
      "end_seconds": 249.14,
      "duration_seconds": 3.02,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.28,
      "end_seconds": 263.35,
      "duration_seconds": 10.07,
      "text": "I can't promise yet, but most people with an overactive thyroid do well once it's treated properly. I want an ECG done, that's for palpitations."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 264.06,
      "end_seconds": 268.27,
      "duration_seconds": 4.21,
      "text": "I can book that for Monday at 3:30 pm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.03,
      "end_seconds": 296.34,
      "duration_seconds": 26.31,
      "text": "I'd like to arrange thyroid blood tests for weight loss and palpitations. We'll begin with propranolol, 20 milligrams, twice a day, until review. It's for racing heart and tremor. Avoid caffeine while the heart is racing. The endocrine clinic would be the right next step, I'll refer you. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.96,
      "end_seconds": 300.0,
      "duration_seconds": 2.04,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.32,
      "end_seconds": 302.87,
      "duration_seconds": 1.55,
      "text": "Have a good day."
    }
  ]
}