{
  "schema_version": "1.0",
  "encounter_id": "01326",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.01,
      "duration_seconds": 3.8,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 10.2,
      "duration_seconds": 4.33,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.4,
      "end_seconds": 18.3,
      "duration_seconds": 6.9,
      "text": "doctor, thank you for seeing us. Doctor, it's hard stools. That's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.02,
      "end_seconds": 20.81,
      "duration_seconds": 1.79,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.37,
      "end_seconds": 26.91,
      "duration_seconds": 4.54,
      "text": "I'd say about a month, you know, maybe"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.82,
      "end_seconds": 31.68,
      "duration_seconds": 3.86,
      "text": "hm, I'd say more like about two months"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 36.96,
      "duration_seconds": 4.77,
      "text": "okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.58,
      "end_seconds": 39.76,
      "duration_seconds": 2.18,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.3,
      "end_seconds": 41.95,
      "duration_seconds": 1.65,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.45,
      "end_seconds": 60.51,
      "duration_seconds": 12.06,
      "text": "I get some relief from water. And I've been going less often as well, for two weeks. And mild bloating, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.0,
      "end_seconds": 70.51,
      "duration_seconds": 4.51,
      "text": "alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.83,
      "end_seconds": 75.73,
      "duration_seconds": 3.9,
      "text": "She takes diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.21,
      "end_seconds": 76.91,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.75,
      "end_seconds": 91.92,
      "duration_seconds": 4.17,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.71,
      "end_seconds": 98.89,
      "duration_seconds": 6.18,
      "text": "I have arthritis in my knees, for two years. Yes, heart disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.9,
      "end_seconds": 112.51,
      "duration_seconds": 4.61,
      "text": "right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.45,
      "end_seconds": 118.85,
      "duration_seconds": 3.4,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.79,
      "end_seconds": 137.3,
      "duration_seconds": 2.51,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.2,
      "end_seconds": 145.85,
      "duration_seconds": 4.65,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.08,
      "end_seconds": 148.64,
      "duration_seconds": 1.56,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.84,
      "end_seconds": 158.59,
      "duration_seconds": 3.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.1,
      "end_seconds": 161.21,
      "duration_seconds": 2.11,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.81,
      "end_seconds": 165.27,
      "duration_seconds": 2.46,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.44,
      "end_seconds": 169.34,
      "duration_seconds": 2.9,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.83,
      "end_seconds": 173.91,
      "duration_seconds": 3.08,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.79,
      "end_seconds": 181.19,
      "duration_seconds": 6.4,
      "text": "Did you get weight loss, severe pain, blood in the stool or vomiting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.71,
      "end_seconds": 190.85,
      "duration_seconds": 8.14,
      "text": "I haven't had weight loss, severe pain, blood in the stool or vomiting, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.86,
      "end_seconds": 195.34,
      "duration_seconds": 3.48,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.0,
      "end_seconds": 199.07,
      "duration_seconds": 2.07,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.66,
      "end_seconds": 203.11,
      "duration_seconds": 3.45,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.88,
      "end_seconds": 218.45,
      "duration_seconds": 2.57,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.79,
      "end_seconds": 246.59,
      "duration_seconds": 13.8,
      "text": "Okay: pulse 68, BMI works out to 32.3. And saturation 97 percent, height 167 centimetres, respiratory rate 15, weight 90 kilos, BP is 108 over 73."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.6,
      "end_seconds": 252.75,
      "duration_seconds": 4.15,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.97,
      "end_seconds": 255.04,
      "duration_seconds": 1.07,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.19,
      "end_seconds": 257.6,
      "duration_seconds": 1.41,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.24,
      "end_seconds": 273.63,
      "duration_seconds": 3.39,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.71,
      "end_seconds": 287.01,
      "duration_seconds": 10.3,
      "text": "Good, you can sit up again. So, based on the history and the examination, this is probably simple constipation from low fibre."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.74,
      "end_seconds": 292.05,
      "duration_seconds": 4.31,
      "text": "I mean, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.8,
      "end_seconds": 313.83,
      "duration_seconds": 17.03,
      "text": "I understand the worry. At the moment I'd say it's simple constipation from low fibre, and we'll watch how it goes. I'm prescribing lactulose, 15 ml, twice a day, two weeks. That should help with constipation."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 317.49,
      "duration_seconds": 1.8,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.38,
      "end_seconds": 329.63,
      "duration_seconds": 11.25,
      "text": "eat more fruit, vegetables and oats, and drink two litres of water cut down on salt and fried food for now, it really does make a difference"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.84,
      "end_seconds": 340.9,
      "duration_seconds": 11.06,
      "text": "Right, right. I'd like you back if it persists after a month. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.46,
      "end_seconds": 354.77,
      "duration_seconds": 12.31,
      "text": "So, I take the lactulose, 15 ml, twice a day and come back if it persists after a month. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.37,
      "end_seconds": 361.36,
      "duration_seconds": 4.99,
      "text": "So, yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.83,
      "end_seconds": 364.6,
      "duration_seconds": 1.77,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.78,
      "end_seconds": 367.01,
      "duration_seconds": 1.23,
      "text": "Look after yourself."
    }
  ]
}