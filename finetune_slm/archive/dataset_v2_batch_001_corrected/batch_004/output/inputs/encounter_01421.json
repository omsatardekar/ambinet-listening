{
  "schema_version": "1.0",
  "encounter_id": "01421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 6.31,
      "duration_seconds": 5.63,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.08,
      "end_seconds": 12.49,
      "duration_seconds": 4.41,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.48,
      "end_seconds": 18.59,
      "duration_seconds": 4.11,
      "text": "I wanted to get drenching night sweats looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.48,
      "end_seconds": 22.98,
      "duration_seconds": 3.5,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.62,
      "end_seconds": 27.41,
      "duration_seconds": 2.79,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.95,
      "end_seconds": 38.32,
      "duration_seconds": 10.37,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.63,
      "end_seconds": 44.76,
      "duration_seconds": 5.13,
      "text": "It happens a couple of times a week. Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.91,
      "end_seconds": 56.29,
      "duration_seconds": 2.38,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.92,
      "end_seconds": 68.72,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.81,
      "end_seconds": 98.57,
      "duration_seconds": 15.76,
      "text": "Okay: pulse is 76 beats a minute, respiratory rate 17. And weight 97 kilos, height 172 centimetres, BMI works out to 32.8, pressure 112 over 81, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.17,
      "end_seconds": 102.37,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.03,
      "end_seconds": 107.42,
      "duration_seconds": 3.39,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.26,
      "end_seconds": 112.25,
      "duration_seconds": 1.99,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.34,
      "end_seconds": 115.79,
      "duration_seconds": 2.45,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.39,
      "end_seconds": 131.03,
      "duration_seconds": 6.64,
      "text": "There is a firm, painless lump in the left side of your neck about three centimetres."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.98,
      "end_seconds": 139.32,
      "duration_seconds": 2.34,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.19,
      "end_seconds": 150.15,
      "duration_seconds": 2.96,
      "text": "Any fever, chest pain or bone pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.22,
      "end_seconds": 157.08,
      "duration_seconds": 4.86,
      "text": "No fever, chest pain or bone pain, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.29,
      "end_seconds": 160.88,
      "duration_seconds": 2.59,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.76,
      "end_seconds": 165.07,
      "duration_seconds": 2.31,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.86,
      "end_seconds": 169.28,
      "duration_seconds": 2.42,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.48,
      "end_seconds": 174.91,
      "duration_seconds": 1.43,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.46,
      "end_seconds": 179.6,
      "duration_seconds": 4.14,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.01,
      "end_seconds": 186.6,
      "duration_seconds": 5.59,
      "text": "I take escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.98,
      "end_seconds": 209.24,
      "duration_seconds": 6.26,
      "text": "Alright, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.35,
      "end_seconds": 221.67,
      "duration_seconds": 11.32,
      "text": "I drink a lot of tea and snack through the day. My partner and our baby. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.5,
      "end_seconds": 228.22,
      "duration_seconds": 4.72,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.95,
      "end_seconds": 233.28,
      "duration_seconds": 3.33,
      "text": "I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.34,
      "end_seconds": 238.26,
      "duration_seconds": 3.92,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.82,
      "end_seconds": 239.91,
      "duration_seconds": 1.09,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.93,
      "end_seconds": 249.07,
      "duration_seconds": 8.14,
      "text": "From what you've told me and what I found, I'd lean towards symptoms that need an urgent cancer work-up."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.77,
      "end_seconds": 252.72,
      "duration_seconds": 1.95,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.54,
      "end_seconds": 265.06,
      "duration_seconds": 10.52,
      "text": "Nothing I've seen today points to an emergency. It looks like symptoms that need an urgent cancer work-up, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.36,
      "end_seconds": 310.06,
      "duration_seconds": 31.7,
      "text": "I want blood tests done, that's for weight loss. I'd rather check than guess, and this is the quickest way to know more. I want an urgent chest X-ray done, that's for cough and weight loss. I am referring you on an urgent pathway, which means an appointment within two weeks. If the symptoms get worse, that's the point to come in urgently. See me again after the scans."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.71,
      "end_seconds": 314.92,
      "duration_seconds": 3.21,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.9,
      "end_seconds": 321.69,
      "duration_seconds": 5.79,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.78,
      "end_seconds": 329.2,
      "duration_seconds": 5.42,
      "text": "So, I come back after the scans. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.87,
      "end_seconds": 336.45,
      "duration_seconds": 5.58,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.08,
      "end_seconds": 344.46,
      "duration_seconds": 3.38,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}