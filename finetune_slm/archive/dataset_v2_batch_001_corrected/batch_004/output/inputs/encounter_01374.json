{
  "schema_version": "1.0",
  "encounter_id": "01374",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 6.95,
      "duration_seconds": 5.8,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 13.03,
      "duration_seconds": 4.83,
      "text": "Right, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.8,
      "end_seconds": 17.6,
      "duration_seconds": 3.8,
      "text": "I'm, I'm here because of being thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.7,
      "end_seconds": 21.9,
      "duration_seconds": 3.2,
      "text": "Have you been passing urine at night?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.81,
      "end_seconds": 28.89,
      "duration_seconds": 6.08,
      "text": "Yes, that started yesterday. As for passing urine at night, severe, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.43,
      "end_seconds": 34.99,
      "duration_seconds": 5.56,
      "text": "Alright, a few quick ones: weight loss, abdominal pain or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.13,
      "end_seconds": 42.06,
      "duration_seconds": 2.93,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.55,
      "end_seconds": 47.65,
      "duration_seconds": 4.1,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.71,
      "end_seconds": 52.42,
      "duration_seconds": 2.71,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.49,
      "end_seconds": 57.83,
      "duration_seconds": 4.34,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.54,
      "end_seconds": 61.93,
      "duration_seconds": 2.39,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.01,
      "end_seconds": 68.0,
      "duration_seconds": 3.99,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.2,
      "end_seconds": 78.4,
      "duration_seconds": 9.2,
      "text": "I take glibenclamide, 5 milligrams, before breakfast. I take alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.93,
      "end_seconds": 83.96,
      "duration_seconds": 4.03,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.98,
      "end_seconds": 89.8,
      "duration_seconds": 3.82,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.42,
      "end_seconds": 104.29,
      "duration_seconds": 2.87,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.42,
      "end_seconds": 109.55,
      "duration_seconds": 4.13,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.37,
      "end_seconds": 118.49,
      "duration_seconds": 3.12,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.27,
      "end_seconds": 126.96,
      "duration_seconds": 4.69,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.14,
      "end_seconds": 129.7,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.08,
      "end_seconds": 133.36,
      "duration_seconds": 2.28,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 137.43,
      "duration_seconds": 2.55,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.41,
      "end_seconds": 142.72,
      "duration_seconds": 3.31,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.19,
      "end_seconds": 161.49,
      "duration_seconds": 3.3,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.37,
      "end_seconds": 166.39,
      "duration_seconds": 4.02,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.76,
      "end_seconds": 168.64,
      "duration_seconds": 0.88,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.65,
      "end_seconds": 174.25,
      "duration_seconds": 3.6,
      "text": "I've had thin bones for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.22,
      "end_seconds": 180.2,
      "duration_seconds": 3.98,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.74,
      "end_seconds": 184.54,
      "duration_seconds": 2.8,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.66,
      "end_seconds": 198.03,
      "duration_seconds": 2.37,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 212.88,
      "duration_seconds": 2.17,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.29,
      "end_seconds": 238.81,
      "duration_seconds": 7.52,
      "text": "Okay: pressure 169 over 94, SpO2 97 percent on room air, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.07,
      "end_seconds": 242.15,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.75,
      "end_seconds": 249.48,
      "duration_seconds": 2.73,
      "text": "Alright, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.69,
      "end_seconds": 253.64,
      "duration_seconds": 2.95,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.74,
      "end_seconds": 255.7,
      "duration_seconds": 0.96,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.87,
      "end_seconds": 259.62,
      "duration_seconds": 2.75,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.65,
      "end_seconds": 281.76,
      "duration_seconds": 6.11,
      "text": "Your weight is up a little and there are no sores on your feet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.4,
      "end_seconds": 304.69,
      "duration_seconds": 19.29,
      "text": "Right, that's all I needed to check. Right, here's what I'm thinking. This is probably possible type 2 diabetes pending blood tests. We should do a urine test for frequent urination. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.26,
      "end_seconds": 308.44,
      "duration_seconds": 2.18,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.24,
      "end_seconds": 341.24,
      "duration_seconds": 31.0,
      "text": "Cut sugary drinks and walk after meals while we wait for results. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Let's hold off on a fasting glucose for now, and if there's no change next month we can revisit it. See me again after the results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.83,
      "end_seconds": 345.62,
      "duration_seconds": 3.79,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.47,
      "end_seconds": 348.83,
      "duration_seconds": 1.36,
      "text": "See you soon."
    }
  ]
}