    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.99,
      "end_seconds": 213.18,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
