    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.29,
      "end_seconds": 234.6,
      "duration_seconds": 4.31,
      "text": "My husband and I live above the shop."
