    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.85,
      "end_seconds": 225.45,
      "duration_seconds": 4.6,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.29,
      "end_seconds": 228.3,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
