      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.69,
      "end_seconds": 249.89,
      "duration_seconds": 6.2,
      "text": "Alendronate. I take it 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.67,
      "end_seconds": 257.61,
      "duration_seconds": 6.94,
      "text": "Okay, thinking it through, my working impression is possible type 2 diabetes pending blood tests."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.51,
      "end_seconds": 273.7,
      "duration_seconds": 4.19,
      "text": "Let's book a fasting glucose to look into thirst."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.65,
      "end_seconds": 277.1,
      "duration_seconds": 2.45,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.58,
      "end_seconds": 283.13,
      "duration_seconds": 4.55,
      "text": "I think a urine test makes sense here, for frequent urination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.3,
      "end_seconds": 287.03,
      "duration_seconds": 2.73,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.75,
      "end_seconds": 298.5,
      "duration_seconds": 9.75,
      "text": "Cut sugary drinks and walk after meals while we wait for results. I'd like to see you again after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.11,
      "end_seconds": 300.84,
      "duration_seconds": 1.73,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.01,
      "end_seconds": 305.83,
      "duration_seconds": 3.82,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.55,
