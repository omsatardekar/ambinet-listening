    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.29,
      "end_seconds": 215.8,
      "duration_seconds": 1.51,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.74,
      "end_seconds": 218.98,
      "duration_seconds": 2.24,
      "text": "Do you get out much?"
