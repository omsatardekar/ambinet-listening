    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.86,
      "end_seconds": 241.8,
      "duration_seconds": 5.94,
      "text": "What's on your current medicine list? I'll explain everything as we go along."
