{
  "schema_version": "1.0",
  "encounter_id": "01151",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 7.44,
      "duration_seconds": 6.4,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.66,
      "end_seconds": 13.7,
      "duration_seconds": 5.04,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.76,
      "end_seconds": 23.85,
      "duration_seconds": 8.09,
      "text": "It's sharp pain low on one side. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.46,
      "end_seconds": 28.69,
      "duration_seconds": 3.23,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.52,
      "end_seconds": 36.21,
      "duration_seconds": 6.69,
      "text": "About a month, I think... sorry, six months, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.57,
      "end_seconds": 40.89,
      "duration_seconds": 4.32,
      "text": "Right, right. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.74,
      "end_seconds": 47.95,
      "duration_seconds": 4.21,
      "text": "It's severe, honestly. Oh, and shoulder tip pain."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.34,
      "end_seconds": 66.54,
      "duration_seconds": 3.2,
      "text": "Did you get vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.32,
      "end_seconds": 72.13,
      "duration_seconds": 4.81,
      "text": "Uh, no vaginal discharge or fever, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.02,
      "end_seconds": 77.52,
      "duration_seconds": 4.5,
      "text": "Right, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.73,
      "end_seconds": 81.67,
      "duration_seconds": 2.94,
      "text": "I mean, no, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.44,
      "end_seconds": 87.69,
      "duration_seconds": 4.25,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.41,
      "end_seconds": 92.84,
      "duration_seconds": 3.43,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.66,
      "end_seconds": 99.54,
      "duration_seconds": 4.88,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.17,
      "end_seconds": 103.55,
      "duration_seconds": 3.38,
      "text": "Actually, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.53,
      "end_seconds": 118.42,
      "duration_seconds": 2.89,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.75,
      "end_seconds": 120.87,
      "duration_seconds": 1.12,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.94,
      "end_seconds": 127.47,
      "duration_seconds": 5.53,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.37,
      "end_seconds": 141.15,
      "duration_seconds": 12.78,
      "text": "I hardly move around during the day. I'm a hairdresser, on my feet all day. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.43,
      "end_seconds": 149.49,
      "duration_seconds": 2.06,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.96,
      "end_seconds": 157.06,
      "duration_seconds": 6.1,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.55,
      "end_seconds": 161.88,
      "duration_seconds": 3.33,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.35,
      "end_seconds": 172.81,
      "duration_seconds": 2.46,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.37,
      "end_seconds": 199.78,
      "duration_seconds": 7.41,
      "text": "Okay: BP is 112 over 77, pulse is 125 beats a minute, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.86,
      "end_seconds": 202.55,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.08,
      "end_seconds": 208.38,
      "duration_seconds": 4.3,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.24,
      "end_seconds": 228.71,
      "duration_seconds": 11.47,
      "text": "Right, here's what I'm thinking. This is probably a possible ectopic pregnancy. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.6,
      "end_seconds": 233.47,
      "duration_seconds": 2.87,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.53,
      "end_seconds": 243.96,
      "duration_seconds": 9.43,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible ectopic pregnancy, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.93,
      "end_seconds": 262.06,
      "duration_seconds": 5.13,
      "text": "An urgent pelvic scan is what I'd like next, for possible ectopic."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.82,
      "end_seconds": 265.08,
      "duration_seconds": 2.26,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.66,
      "end_seconds": 286.44,
      "duration_seconds": 20.78,
      "text": "You need to go to the hospital now for an emergency scan. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. I'd like you to see the gynaecology team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.44,
      "end_seconds": 289.87,
      "duration_seconds": 2.43,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.63,
      "end_seconds": 305.37,
      "duration_seconds": 14.74,
      "text": "Keep an eye out, and if the pain gets worse or you faint, call us the same day or go to emergency. Book a review straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.76,
      "end_seconds": 308.31,
      "duration_seconds": 1.55,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.05,
      "end_seconds": 314.14,
      "duration_seconds": 2.09,
      "text": "Right, goodbye for now."
    }
  ]
}