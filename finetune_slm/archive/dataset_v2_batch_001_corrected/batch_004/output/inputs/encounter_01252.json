{
  "schema_version": "1.0",
  "encounter_id": "01252",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 3.93,
      "duration_seconds": 3.1,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.15,
      "end_seconds": 9.61,
      "duration_seconds": 4.46,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.5,
      "end_seconds": 16.64,
      "duration_seconds": 5.14,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.55,
      "end_seconds": 22.57,
      "duration_seconds": 5.02,
      "text": "Right, of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.37,
      "end_seconds": 29.95,
      "duration_seconds": 5.58,
      "text": "Doctor, it's been getting breathless lying flat. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.9,
      "end_seconds": 35.74,
      "duration_seconds": 3.84,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 40.38,
      "duration_seconds": 4.09,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.01,
      "end_seconds": 51.06,
      "duration_seconds": 9.05,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.97,
      "end_seconds": 58.55,
      "duration_seconds": 5.58,
      "text": "Lying flat definitely sets it off. It feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.12,
      "end_seconds": 66.93,
      "duration_seconds": 7.81,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 67.03,
      "end_seconds": 72.71,
      "duration_seconds": 5.68,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.56,
      "end_seconds": 76.01,
      "duration_seconds": 2.45,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.79,
      "end_seconds": 78.39,
      "duration_seconds": 1.6,
      "text": "Any tiredness as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.14,
      "end_seconds": 83.75,
      "duration_seconds": 1.61,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.62,
      "end_seconds": 88.97,
      "duration_seconds": 4.35,
      "text": "Okay, what about swollen ankles, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.32,
      "end_seconds": 91.86,
      "duration_seconds": 1.54,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.37,
      "end_seconds": 94.85,
      "duration_seconds": 2.48,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.2,
      "end_seconds": 102.31,
      "duration_seconds": 6.11,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.15,
      "end_seconds": 108.32,
      "duration_seconds": 5.17,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.23,
      "end_seconds": 111.97,
      "duration_seconds": 2.74,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.44,
      "end_seconds": 115.76,
      "duration_seconds": 2.32,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.71,
      "end_seconds": 119.73,
      "duration_seconds": 2.02,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.95,
      "end_seconds": 125.9,
      "duration_seconds": 4.95,
      "text": "Have you been getting breathless lying flat at any time before this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.65,
      "end_seconds": 131.45,
      "duration_seconds": 4.8,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.36,
      "end_seconds": 135.96,
      "duration_seconds": 2.6,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.53,
      "end_seconds": 146.42,
      "duration_seconds": 2.89,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.38,
      "end_seconds": 179.24,
      "duration_seconds": 15.86,
      "text": "Okay: pulse is 98 beats a minute, saturation 89 percent, respiratory rate 20. And BP is 139 over 89, temperature 37.0, weight 63 kilos, height 158 centimetres, BMI works out to 25.2."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.45,
      "end_seconds": 182.55,
      "duration_seconds": 2.1,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.6,
      "end_seconds": 187.46,
      "duration_seconds": 3.86,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.48,
      "end_seconds": 193.03,
      "duration_seconds": 3.55,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.74,
      "end_seconds": 196.21,
      "duration_seconds": 1.47,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.77,
      "end_seconds": 212.31,
      "duration_seconds": 6.54,
      "text": "There is pitting swelling of both ankles and a few crackles at the lung bases."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.16,
      "end_seconds": 225.88,
      "duration_seconds": 7.72,
      "text": "Alright, thank you, you can get dressed. Have you had any palpitations, chest pain or fainting?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.49,
      "end_seconds": 230.15,
      "duration_seconds": 3.66,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.56,
      "end_seconds": 233.98,
      "duration_seconds": 2.42,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.86,
      "end_seconds": 235.92,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 242.18,
      "duration_seconds": 4.86,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.82,
      "end_seconds": 246.02,
      "duration_seconds": 2.2,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.08,
      "end_seconds": 258.79,
      "duration_seconds": 3.71,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.34,
      "end_seconds": 264.33,
      "duration_seconds": 4.99,
      "text": "My grandfather had a stroke. My mother had a stroke."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.5,
      "end_seconds": 269.4,
      "duration_seconds": 3.9,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.05,
      "end_seconds": 279.49,
      "duration_seconds": 6.44,
      "text": "It's ramipril, 5 milligrams, every morning. Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 282.43,
      "end_seconds": 290.67,
      "duration_seconds": 8.24,
      "text": "He is supposed to take it twice a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.77,
      "end_seconds": 314.01,
      "duration_seconds": 22.24,
      "text": "I take alendronate, 70 milligrams, once a week. I'm not great at remembering details, so bear with me. Escitalopram. I take it 10 milligrams, once a day. I, I had fluoxetine at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.31,
      "end_seconds": 322.16,
      "duration_seconds": 3.85,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.73,
      "end_seconds": 331.41,
      "duration_seconds": 4.68,
      "text": "Yes, erythromycin, it gives me bad stomach cramps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.61,
      "end_seconds": 339.6,
      "duration_seconds": 3.99,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.51,
      "end_seconds": 345.25,
      "duration_seconds": 3.74,
      "text": "I've, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.89,
      "end_seconds": 346.67,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.55,
      "end_seconds": 351.44,
      "duration_seconds": 3.89,
      "text": "I have heart failure. Yes, thin bones."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.11,
      "end_seconds": 353.81,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.42,
      "end_seconds": 356.69,
      "duration_seconds": 2.27,
      "text": "Depression, for five years."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.69,
      "end_seconds": 368.44,
      "duration_seconds": 9.75,
      "text": "Mm-hmm. Alright, high blood pressure and heart failure, that matches what I have here. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.83,
      "end_seconds": 374.11,
      "duration_seconds": 4.28,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.55,
      "end_seconds": 380.55,
      "duration_seconds": 2.0,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.73,
      "end_seconds": 384.3,
      "duration_seconds": 2.57,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.18,
      "end_seconds": 395.66,
      "duration_seconds": 10.48,
      "text": "Taking everything into account, it fits best with heart failure with some fluid on board. A kidney problem is also on my list."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.68,
      "end_seconds": 401.04,
      "duration_seconds": 3.36,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.43,
      "end_seconds": 413.46,
      "duration_seconds": 11.03,
      "text": "It's reasonable to be concerned, but right now heart failure with some fluid on board is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.38,
      "end_seconds": 449.16,
      "duration_seconds": 16.78,
      "text": "I want an echocardiogram done, that's for heart failure. I want blood tests done, that's for heart failure. I'm prescribing furosemide, 40 milligrams, once a day in the morning, long term. That should help with fluid retention."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.04,
      "end_seconds": 453.83,
      "duration_seconds": 3.79,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.58,
      "end_seconds": 473.54,
      "duration_seconds": 17.96,
      "text": "Weigh yourself every morning and tell us if you gain two kilos in three days. We'll refer you to the heart failure nurse. One warning sign to remember: the symptoms get worse. In that case don't wait. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 475.29,
      "end_seconds": 477.53,
      "duration_seconds": 2.24,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.14,
      "end_seconds": 481.5,
      "duration_seconds": 2.36,
      "text": "Alright, have a good day."
    }
  ]
}