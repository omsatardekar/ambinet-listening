{
  "schema_version": "1.0",
  "encounter_id": "01248",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 5.25,
      "duration_seconds": 4.11,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.49,
      "duration_seconds": 4.79,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.36,
      "end_seconds": 26.05,
      "duration_seconds": 13.69,
      "text": "Sorry, what was I saying, doctor, it's pain that started around my belly button then moved to the right. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.68,
      "end_seconds": 32.88,
      "duration_seconds": 5.2,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.7,
      "end_seconds": 41.27,
      "duration_seconds": 7.57,
      "text": "Yes, coughing. That makes it worse. It settles a little with lying still. I'd say severe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.8,
      "end_seconds": 46.13,
      "duration_seconds": 3.33,
      "text": "So, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.77,
      "end_seconds": 50.68,
      "duration_seconds": 3.91,
      "text": "It usually comes with a low fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.31,
      "end_seconds": 54.22,
      "duration_seconds": 2.91,
      "text": "alright, have you been feeling sick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.44,
      "end_seconds": 60.74,
      "duration_seconds": 5.3,
      "text": "Yes, I have. The low fever? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.6,
      "end_seconds": 65.76,
      "duration_seconds": 4.16,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.85,
      "end_seconds": 81.21,
      "duration_seconds": 2.36,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.92,
      "end_seconds": 100.96,
      "duration_seconds": 9.04,
      "text": "Okay: respiratory rate 19, BP is 104 over 69, saturation 95 percent, pulse is 89 beats a minute, temp 38.8 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.91,
      "end_seconds": 103.86,
      "duration_seconds": 1.95,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.28,
      "end_seconds": 108.09,
      "duration_seconds": 2.81,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.66,
      "end_seconds": 113.81,
      "duration_seconds": 4.15,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.86,
      "end_seconds": 132.56,
      "duration_seconds": 1.7,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.8,
      "end_seconds": 136.71,
      "duration_seconds": 2.91,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.22,
      "end_seconds": 156.0,
      "duration_seconds": 7.78,
      "text": "It hurts most low on the right and it hurts when I let go of the pressure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.5,
      "end_seconds": 167.09,
      "duration_seconds": 5.59,
      "text": "Thank you, you can get dressed. So, has there been any urinary symptoms?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.77,
      "end_seconds": 171.7,
      "duration_seconds": 2.93,
      "text": "Not at all, no urinary symptoms."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.51,
      "end_seconds": 174.89,
      "duration_seconds": 2.38,
      "text": "Did you get diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.96,
      "end_seconds": 178.12,
      "duration_seconds": 2.16,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.35,
      "end_seconds": 181.63,
      "duration_seconds": 2.28,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.95,
      "end_seconds": 184.45,
      "duration_seconds": 1.5,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.56,
      "end_seconds": 190.44,
      "duration_seconds": 4.88,
      "text": "So, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.02,
      "end_seconds": 194.16,
      "duration_seconds": 2.14,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.89,
      "end_seconds": 205.08,
      "duration_seconds": 3.19,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.12,
      "end_seconds": 211.87,
      "duration_seconds": 5.75,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.62,
      "end_seconds": 216.02,
      "duration_seconds": 2.4,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.06,
      "end_seconds": 224.28,
      "duration_seconds": 6.22,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.17,
      "end_seconds": 227.44,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.3,
      "end_seconds": 231.58,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.34,
      "end_seconds": 243.21,
      "duration_seconds": 2.87,
      "text": "Okay, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.07,
      "end_seconds": 250.66,
      "duration_seconds": 5.59,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.69,
      "end_seconds": 254.3,
      "duration_seconds": 2.61,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.57,
      "end_seconds": 274.25,
      "duration_seconds": 18.68,
      "text": "I take sumatriptan, 50 milligrams, when needed for my migraines. I'd rather not end up on lots of tablets if I can avoid it. Escitalopram. I take it 10 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.22,
      "end_seconds": 279.2,
      "duration_seconds": 2.98,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.58,
      "end_seconds": 289.19,
      "duration_seconds": 8.61,
      "text": "Not with me. I'll bring it it next time. Before this I was on mirtazapine; that's been stopped."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.42,
      "end_seconds": 299.68,
      "duration_seconds": 4.26,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.52,
      "end_seconds": 302.95,
      "duration_seconds": 1.43,
      "text": "I have migraines"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.82,
      "end_seconds": 305.52,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.29,
      "end_seconds": 310.66,
      "duration_seconds": 3.37,
      "text": "I mean, I've had depression, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.45,
      "end_seconds": 343.77,
      "duration_seconds": 31.32,
      "text": "right, right right, so migraines is already on your record we'll keep that in mind today okay, so my impression is this: It's hard to say. Possible appendicitis is one possibility and a urine infection another, and I'd rather not commit yet let's book urgent blood tests to look into abdominal pain i want an ultrasound or CT scan done, that's for Possible appendicitis"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.84,
      "end_seconds": 346.89,
      "duration_seconds": 1.05,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.57,
      "end_seconds": 365.01,
      "duration_seconds": 16.44,
      "text": "you need to go to hospital now and not eat or drink. I'll also refer you to the surgical team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.28,
      "end_seconds": 369.54,
      "duration_seconds": 3.26,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.19,
      "end_seconds": 377.36,
      "duration_seconds": 7.17,
      "text": "Do get help quickly if the symptoms get worse. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.26,
      "end_seconds": 380.26,
      "duration_seconds": 2.0,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.16,
      "end_seconds": 383.63,
      "duration_seconds": 2.47,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.0,
      "end_seconds": 390.25,
      "duration_seconds": 3.25,
      "text": "okay, that makes sense thanks for explaining"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.03,
      "end_seconds": 392.2,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}