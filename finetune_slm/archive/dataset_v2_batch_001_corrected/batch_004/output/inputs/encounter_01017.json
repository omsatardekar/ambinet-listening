{
  "schema_version": "1.0",
  "encounter_id": "01017",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 3.61,
      "duration_seconds": 2.55,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 7.94,
      "end_seconds": 12.16,
      "duration_seconds": 4.22,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.8,
      "end_seconds": 16.38,
      "duration_seconds": 2.58,
      "text": "Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.33,
      "end_seconds": 22.48,
      "duration_seconds": 4.15,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.17,
      "end_seconds": 26.11,
      "duration_seconds": 2.94,
      "text": "Alright, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.5,
      "end_seconds": 37.5,
      "duration_seconds": 7.0,
      "text": "It's weakness in my right arm, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.16,
      "end_seconds": 42.34,
      "duration_seconds": 3.18,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.26,
      "end_seconds": 46.02,
      "duration_seconds": 2.76,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.73,
      "end_seconds": 52.43,
      "duration_seconds": 5.7,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 52.53,
      "end_seconds": 58.92,
      "duration_seconds": 6.39,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.41,
      "end_seconds": 62.57,
      "duration_seconds": 2.16,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.32,
      "end_seconds": 73.53,
      "duration_seconds": 10.21,
      "text": "Hmm, I've also had slurred speech. Um, I did have a sudden headache at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.43,
      "end_seconds": 81.56,
      "duration_seconds": 6.13,
      "text": "Have you had weakness in your right arm before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.11,
      "end_seconds": 91.03,
      "duration_seconds": 7.92,
      "text": "Hmm, a bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.69,
      "end_seconds": 96.07,
      "duration_seconds": 3.38,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.08,
      "end_seconds": 102.05,
      "duration_seconds": 3.97,
      "text": "Yeah, uh, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.81,
      "end_seconds": 109.31,
      "duration_seconds": 3.5,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.54,
      "end_seconds": 113.63,
      "duration_seconds": 3.09,
      "text": "So, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.2,
      "end_seconds": 116.98,
      "duration_seconds": 2.78,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 123.72,
      "duration_seconds": 5.79,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.01,
      "end_seconds": 145.63,
      "duration_seconds": 3.62,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.29,
      "end_seconds": 150.89,
      "duration_seconds": 3.6,
      "text": "Amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 151.63,
      "end_seconds": 159.82,
      "duration_seconds": 8.19,
      "text": "So, he is supposed to take it once a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.5,
      "end_seconds": 177.0,
      "duration_seconds": 16.5,
      "text": "Hmm, it's hydrocortisone cream, when needed. I'd rather not end up on lots of tablets if I can avoid it. I had telmisartan at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.24,
      "end_seconds": 192.63,
      "duration_seconds": 4.39,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.19,
      "end_seconds": 207.39,
      "duration_seconds": 13.2,
      "text": "I have high blood pressure. I have an irregular heartbeat, for nearly five years. I've had eczema for five years now. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.63,
      "end_seconds": 217.35,
      "duration_seconds": 6.72,
      "text": "Okay, I can see an irregular heartbeat in your file as well. How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.44,
      "end_seconds": 222.02,
      "duration_seconds": 2.58,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.72,
      "end_seconds": 226.07,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.99,
      "end_seconds": 232.0,
      "duration_seconds": 4.01,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.13,
      "end_seconds": 237.9,
      "duration_seconds": 4.77,
      "text": "Have you had any seizure, fever or loss of consciousness?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.25,
      "end_seconds": 244.78,
      "duration_seconds": 5.53,
      "text": "I haven't had seizure, fever or loss of consciousness, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.53,
      "end_seconds": 248.72,
      "duration_seconds": 2.19,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.41,
      "end_seconds": 250.31,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 251.35,
      "end_seconds": 261.2,
      "duration_seconds": 9.85,
      "text": "Doctor, I've got the readings for you. BP is 159 over 101, heart rate 90. Saturation 98 percent, temperature 36.7."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.1,
      "end_seconds": 264.09,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.32,
      "end_seconds": 270.36,
      "duration_seconds": 5.04,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.51,
      "end_seconds": 273.94,
      "duration_seconds": 2.43,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.06,
      "end_seconds": 298.32,
      "duration_seconds": 6.26,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.5,
      "end_seconds": 312.92,
      "duration_seconds": 11.42,
      "text": "Thank you, you can get dressed. Okay, thinking it through, it fits best with a possible stroke, within the treatment window. A migraine with aura is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.69,
      "end_seconds": 317.01,
      "duration_seconds": 2.32,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.88,
      "end_seconds": 342.5,
      "duration_seconds": 23.62,
      "text": "I can't promise yet, but most people with a possible stroke, within the treatment window do well once it's treated properly. I think a blood sugar test makes sense here, for stroke symptoms. I'll request an urgent CT scan of the head, it'll help with possible stroke."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 343.83,
      "end_seconds": 345.82,
      "duration_seconds": 1.99,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.26,
      "end_seconds": 370.57,
      "duration_seconds": 23.31,
      "text": "Call an ambulance now, you need hospital immediately. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Let's get you seen by the stroke team, I'll arrange the letter. I'll want another look straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 373.98,
      "end_seconds": 379.46,
      "duration_seconds": 5.48,
      "text": "So, uh, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.15,
      "end_seconds": 385.94,
      "duration_seconds": 4.79,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 387.5,
      "end_seconds": 390.68,
      "duration_seconds": 3.18,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.44,
      "end_seconds": 392.62,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}