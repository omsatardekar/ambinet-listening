{
  "schema_version": "1.0",
  "encounter_id": "01479",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.56,
      "end_seconds": 5.54,
      "duration_seconds": 4.98,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 11.71,
      "duration_seconds": 4.34,
      "text": "thank you good morning, tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.55,
      "end_seconds": 20.12,
      "duration_seconds": 6.57,
      "text": "Yeah, it's more breathless than usual. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.85,
      "end_seconds": 24.08,
      "duration_seconds": 2.23,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.08,
      "end_seconds": 33.92,
      "duration_seconds": 5.84,
      "text": "Two days, I think... sorry, ten days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.21,
      "end_seconds": 40.15,
      "duration_seconds": 4.94,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.04,
      "end_seconds": 45.09,
      "duration_seconds": 4.05,
      "text": "I'd say moderate. It happens all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.98,
      "end_seconds": 50.81,
      "duration_seconds": 3.83,
      "text": "so, what about a wheeze, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.57,
      "end_seconds": 62.11,
      "duration_seconds": 10.54,
      "text": "yes, for three weeks about wheeze, honestly, on and off there's more sputum, a bit yellow as well"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.76,
      "end_seconds": 67.72,
      "duration_seconds": 4.96,
      "text": "And what about fever, chest pain, coughing up blood or swollen ankles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.8,
      "end_seconds": 76.16,
      "duration_seconds": 6.36,
      "text": "I haven't had fever, chest pain, coughing up blood or swollen ankles, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.33,
      "end_seconds": 80.37,
      "duration_seconds": 3.04,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.47,
      "end_seconds": 83.45,
      "duration_seconds": 1.98,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.17,
      "end_seconds": 87.04,
      "duration_seconds": 2.87,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.8,
      "end_seconds": 90.97,
      "duration_seconds": 2.17,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.91,
      "end_seconds": 94.16,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.12,
      "end_seconds": 103.08,
      "duration_seconds": 2.96,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.32,
      "end_seconds": 121.49,
      "duration_seconds": 4.17,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.31,
      "end_seconds": 134.01,
      "duration_seconds": 10.7,
      "text": "I gave up cigarettes last spring. I retired from the post office two years ago. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.7,
      "end_seconds": 153.8,
      "duration_seconds": 4.1,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.78,
      "end_seconds": 169.33,
      "duration_seconds": 13.55,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.83,
      "end_seconds": 173.3,
      "duration_seconds": 2.47,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.22,
      "end_seconds": 190.88,
      "duration_seconds": 15.66,
      "text": "I, I take Tiotropium inhaler, once a day for my chest. I'm, I'm on glimepiride, 2 milligrams, before breakfast for my sugar. I'm on tamsulosin, at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.71,
      "end_seconds": 194.99,
      "duration_seconds": 2.28,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.11,
      "end_seconds": 201.69,
      "duration_seconds": 5.58,
      "text": "0.4 milligrams. Telmisartan i take it 40 milligrams, once a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 202.9,
      "end_seconds": 207.54,
      "duration_seconds": 4.64,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.63,
      "end_seconds": 213.74,
      "duration_seconds": 4.11,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.65,
      "end_seconds": 218.05,
      "duration_seconds": 3.4,
      "text": "no, I left it at home"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.57,
      "end_seconds": 238.58,
      "duration_seconds": 5.01,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.51,
      "end_seconds": 243.53,
      "duration_seconds": 3.02,
      "text": "I have COPD, for two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.61,
      "end_seconds": 245.4,
      "duration_seconds": 0.79,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 246.32,
      "end_seconds": 250.3,
      "duration_seconds": 3.98,
      "text": "I have diabetes, for about a year"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.95,
      "end_seconds": 252.96,
      "duration_seconds": 1.01,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 254.88,
      "end_seconds": 259.64,
      "duration_seconds": 4.76,
      "text": "I have an enlarged prostate, for about ten years"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.77,
      "end_seconds": 261.47,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.37,
      "end_seconds": 265.72,
      "duration_seconds": 2.35,
      "text": "I've got high blood pressure"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.97,
      "end_seconds": 274.42,
      "duration_seconds": 7.45,
      "text": "Right, so diabetes and an enlarged prostate are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 278.17,
      "end_seconds": 288.57,
      "duration_seconds": 10.4,
      "text": "Here are the numbers, doctor. Respiratory rate 22, oxygen saturation is 92 percent, BP is 131 over 88, pulse is 87 beats a minute, temperature 37.4."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.26,
      "end_seconds": 290.28,
      "duration_seconds": 1.02,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.62,
      "end_seconds": 294.63,
      "duration_seconds": 3.01,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.41,
      "end_seconds": 297.65,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.76,
      "end_seconds": 312.86,
      "duration_seconds": 5.1,
      "text": "There is wheeze at both bases and your oxygen is a little low."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.65,
      "end_seconds": 346.96,
      "duration_seconds": 31.31,
      "text": "You can relax now. So, based on the history and the examination, it fits best with a flare-up of COPD. The reason I say that is that your story and my examination fit together. A chest infection is still possible. Stop me if I've got anything wrong. You've had more breathless than usual for ten days, moderate, and no swollen ankles or fever."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.99,
      "end_seconds": 354.01,
      "duration_seconds": 2.02,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.77,
      "end_seconds": 386.61,
      "duration_seconds": 31.84,
      "text": "Let's book a chest X-ray to look into COPD flare. I'll request a sputum sample, it'll help with purulent sputum. I'm prescribing doxycycline, 100 milligrams, once a day, five days. That should help with chest infection. I'm prescribing prednisolone, 30 milligrams, once a day, five days. That should help with COPD flare. Use your inhaler regularly and get seen if you are not better in three days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.9,
      "end_seconds": 396.59,
      "duration_seconds": 8.69,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 399.24,
      "end_seconds": 400.22,
      "duration_seconds": 0.98,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.91,
      "end_seconds": 404.74,
      "duration_seconds": 3.83,
      "text": "do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 405.51,
      "end_seconds": 407.09,
      "duration_seconds": 1.58,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.05,
      "end_seconds": 410.55,
      "duration_seconds": 2.5,
      "text": "book a review in one week"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 411.27,
      "end_seconds": 414.46,
      "duration_seconds": 3.19,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.51,
      "end_seconds": 418.28,
      "duration_seconds": 2.77,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 422.51,
      "end_seconds": 425.6,
      "duration_seconds": 3.09,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.47,
      "end_seconds": 428.72,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}