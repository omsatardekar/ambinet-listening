{
  "schema_version": "1.0",
  "encounter_id": "01391",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.15,
      "duration_seconds": 4.97,
      "text": "Uh, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.23,
      "end_seconds": 12.04,
      "duration_seconds": 4.81,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.45,
      "end_seconds": 19.13,
      "duration_seconds": 5.68,
      "text": "Um, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.26,
      "end_seconds": 26.75,
      "duration_seconds": 6.49,
      "text": "So the thing is, I've got a mole that has got bigger."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.9,
      "end_seconds": 30.29,
      "duration_seconds": 2.39,
      "text": "Has there been occasional itching too?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.71,
      "end_seconds": 40.22,
      "duration_seconds": 8.51,
      "text": "Uh, you know, yes, that started yesterday. I had a darker edge before. That's settled now, though."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.19,
      "end_seconds": 44.69,
      "duration_seconds": 3.5,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.88,
      "end_seconds": 49.94,
      "duration_seconds": 4.06,
      "text": "I have arthritis in my knees. I've got gout."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.99,
      "end_seconds": 62.46,
      "duration_seconds": 11.47,
      "text": "I follow. Alright, yes, arthritis in your knees is known to us, good to have that clear. Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.05,
      "end_seconds": 64.09,
      "duration_seconds": 1.04,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.76,
      "end_seconds": 66.96,
      "duration_seconds": 2.2,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 68.63,
      "end_seconds": 73.97,
      "duration_seconds": 5.34,
      "text": "It's paracetamol, 650 milligrams, when needed for the knee pain, doctor."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.84,
      "end_seconds": 76.62,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.45,
      "end_seconds": 80.75,
      "duration_seconds": 3.3,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.59,
      "end_seconds": 83.95,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.81,
      "end_seconds": 88.67,
      "duration_seconds": 3.86,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.88,
      "end_seconds": 92.13,
      "duration_seconds": 2.25,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.61,
      "end_seconds": 101.8,
      "duration_seconds": 4.19,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.28,
      "end_seconds": 105.01,
      "duration_seconds": 1.73,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.35,
      "end_seconds": 109.07,
      "duration_seconds": 2.72,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.41,
      "end_seconds": 126.87,
      "duration_seconds": 4.46,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.71,
      "end_seconds": 141.15,
      "duration_seconds": 13.44,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.59,
      "end_seconds": 148.44,
      "duration_seconds": 3.85,
      "text": "Have you noticed crusting, bleeding or other new moles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.29,
      "end_seconds": 151.63,
      "duration_seconds": 2.34,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.74,
      "end_seconds": 157.87,
      "duration_seconds": 5.13,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.16,
      "end_seconds": 161.24,
      "duration_seconds": 2.08,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 168.09,
      "duration_seconds": 3.11,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.14,
      "end_seconds": 173.0,
      "duration_seconds": 2.86,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.49,
      "end_seconds": 184.81,
      "duration_seconds": 2.32,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.53,
      "end_seconds": 199.97,
      "duration_seconds": 2.44,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 227.99,
      "duration_seconds": 9.37,
      "text": "Okay: saturation 98 percent, pulse is 71 beats a minute, temperature is 36.4 degrees, blood pressure 126 over 75."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.08,
      "end_seconds": 231.71,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.54,
      "end_seconds": 240.06,
      "duration_seconds": 2.52,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.73,
      "end_seconds": 245.96,
      "duration_seconds": 3.23,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.07,
      "end_seconds": 250.41,
      "duration_seconds": 3.34,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.64,
      "end_seconds": 265.45,
      "duration_seconds": 5.81,
      "text": "The mole is seven millimetres with an irregular border and two shades of brown."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.43,
      "end_seconds": 272.97,
      "duration_seconds": 2.54,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.62,
      "end_seconds": 324.58,
      "duration_seconds": 36.96,
      "text": "Having listened and examined, my working impression is a mole with features that need specialist assessment. That's my thinking for now, and it may change as we learn more. It could also be a benign naevus, so we'll keep that open. Let's get a skin biopsy, for changing mole. Let's get a dermoscopy, for changing mole. Protect it from the sun until you are seen. I'm going to send a referral to the skin cancer clinic."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.4,
      "end_seconds": 329.0,
      "duration_seconds": 2.6,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.91,
      "end_seconds": 346.91,
      "duration_seconds": 17.0,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me after the biopsy. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.71,
      "end_seconds": 350.88,
      "duration_seconds": 3.17,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}