{
  "schema_version": "1.0",
  "encounter_id": "01124",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.02,
      "duration_seconds": 3.41,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.03,
      "end_seconds": 9.4,
      "duration_seconds": 4.37,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.95,
      "end_seconds": 13.9,
      "duration_seconds": 2.95,
      "text": "so, I've been dealing with vomiting"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.9,
      "end_seconds": 18.78,
      "duration_seconds": 3.88,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.24,
      "end_seconds": 31.61,
      "duration_seconds": 9.37,
      "text": "It's been about two weeks, I'm fairly sure. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.32,
      "end_seconds": 35.21,
      "duration_seconds": 2.89,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.83,
      "end_seconds": 37.17,
      "duration_seconds": 1.34,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 51.92,
      "duration_seconds": 3.3,
      "text": "Have you had any chest pain or cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.53,
      "end_seconds": 57.47,
      "duration_seconds": 3.94,
      "text": "No, uh, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.8,
      "end_seconds": 60.87,
      "duration_seconds": 2.07,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.82,
      "end_seconds": 63.52,
      "duration_seconds": 1.7,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.09,
      "end_seconds": 67.03,
      "duration_seconds": 2.94,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.11,
      "end_seconds": 72.17,
      "duration_seconds": 4.06,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.18,
      "end_seconds": 82.33,
      "duration_seconds": 8.15,
      "text": "so, do you react to any medicines or foods? Any allergies? I'm asking so that that we don't miss anything"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.97,
      "end_seconds": 92.5,
      "duration_seconds": 8.53,
      "text": "Um, not currently, but as a youngster diclofenac gave me swelling of my lips."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.47,
      "end_seconds": 108.04,
      "duration_seconds": 1.57,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.09,
      "end_seconds": 110.62,
      "duration_seconds": 1.53,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.23,
      "end_seconds": 113.6,
      "duration_seconds": 2.37,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.06,
      "end_seconds": 119.46,
      "duration_seconds": 4.4,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.96,
      "end_seconds": 124.13,
      "duration_seconds": 3.17,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.12,
      "end_seconds": 129.48,
      "duration_seconds": 3.36,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.37,
      "end_seconds": 131.83,
      "duration_seconds": 1.46,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.52,
      "end_seconds": 136.84,
      "duration_seconds": 3.32,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.23,
      "end_seconds": 143.14,
      "duration_seconds": 2.91,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.2,
      "end_seconds": 146.8,
      "duration_seconds": 1.6,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.31,
      "end_seconds": 157.46,
      "duration_seconds": 3.15,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.49,
      "end_seconds": 164.22,
      "duration_seconds": 4.73,
      "text": "I take glibenclamide, 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.71,
      "end_seconds": 167.77,
      "duration_seconds": 2.06,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.43,
      "end_seconds": 179.68,
      "duration_seconds": 2.25,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 214.4,
      "duration_seconds": 16.58,
      "text": "Okay: BMI works out to 16.8, respiratory rate 19, heart rate 112, height 186 centimetres, weight 58 kilos, BP is 137 over 87, temp 37.0 degrees, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.67,
      "end_seconds": 217.73,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.07,
      "end_seconds": 222.02,
      "duration_seconds": 2.95,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.78,
      "end_seconds": 244.21,
      "duration_seconds": 4.43,
      "text": "you are dry, breathing deeply and and your breath smells fruity"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.02,
      "end_seconds": 247.15,
      "duration_seconds": 1.13,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.85,
      "end_seconds": 253.97,
      "duration_seconds": 2.12,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.55,
      "end_seconds": 266.81,
      "duration_seconds": 5.26,
      "text": "okay, thinking it through, the most likely explanation is diabetic ketoacidosis"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.76,
      "end_seconds": 271.34,
      "duration_seconds": 3.58,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.6,
      "end_seconds": 290.99,
      "duration_seconds": 18.39,
      "text": "I understand the worry. At the moment I'd say it's diabetic ketoacidosis, and we'll know more once the blood gas and electrolytes is back. Let's get blood gas and electrolytes, for DKA. We should do a blood sugar and ketone test for thirst and vomiting."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.63,
      "end_seconds": 294.55,
      "duration_seconds": 1.92,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.63,
      "end_seconds": 304.65,
      "duration_seconds": 8.02,
      "text": "You need to go to hospital now for insulin and fluids. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.95,
      "end_seconds": 307.58,
      "duration_seconds": 1.63,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.62,
      "end_seconds": 317.0,
      "duration_seconds": 8.38,
      "text": "If you cannot get there now, that's the point to come in urgently. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.24,
      "end_seconds": 319.72,
      "duration_seconds": 1.48,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.11,
      "end_seconds": 327.47,
      "duration_seconds": 4.36,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.29,
      "end_seconds": 330.88,
      "duration_seconds": 2.59,
      "text": "That's clear, um, thanks."
    }
  ]
}