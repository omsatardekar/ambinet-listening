{
  "schema_version": "1.0",
  "encounter_id": "01192",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 3.46,
      "duration_seconds": 2.31,
      "text": "afternoon, thanks for coming in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.79,
      "end_seconds": 6.01,
      "duration_seconds": 1.22,
      "text": "hello, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 11.05,
      "duration_seconds": 4.05,
      "text": "sorry about the wait we're running a bit behind"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.27,
      "end_seconds": 18.0,
      "duration_seconds": 5.73,
      "text": "oh, that's fine i was just reading something on my phone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 23.16,
      "duration_seconds": 3.44,
      "text": "what would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.81,
      "end_seconds": 32.6,
      "duration_seconds": 7.79,
      "text": "it's a cough that won't go i thought I'd wait, but it it hasn't gone"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.4,
      "end_seconds": 40.02,
      "duration_seconds": 6.62,
      "text": "how long has it been like this? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.85,
      "end_seconds": 44.37,
      "duration_seconds": 3.52,
      "text": "it's been going on for ten days"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.41,
      "end_seconds": 48.25,
      "duration_seconds": 2.84,
      "text": "How much does it it limit you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.49,
      "end_seconds": 54.44,
      "duration_seconds": 0.95,
      "text": "Severe really"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 60.45,
      "duration_seconds": 5.43,
      "text": "Is it there all the the time or does it come and go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.19,
      "end_seconds": 77.58,
      "duration_seconds": 16.39,
      "text": "Honestly, a few times a day. As for lump in my neck, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.04,
      "end_seconds": 82.62,
      "duration_seconds": 3.58,
      "text": "what about drenching night sweats have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.96,
      "end_seconds": 90.08,
      "duration_seconds": 6.12,
      "text": "mm, yes ah, with drenching night sweats, it just comes and goes"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.18,
      "end_seconds": 98.56,
      "duration_seconds": 6.38,
      "text": "have you had a cough that won't go before or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.47,
      "end_seconds": 107.0,
      "duration_seconds": 6.53,
      "text": "Yes something like this happened last winter and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.63,
      "end_seconds": 112.37,
      "duration_seconds": 3.74,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.42,
      "end_seconds": 125.92,
      "duration_seconds": 2.5,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.41,
      "end_seconds": 152.19,
      "duration_seconds": 12.78,
      "text": "okay: SpO2 97 percent on room air temperature is 36.9 degrees pressure 109 over 76. And respiratory rate 18 pulse is 69 beats a minute"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.19,
      "end_seconds": 154.68,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.76,
      "end_seconds": 159.11,
      "duration_seconds": 2.35,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.0,
      "end_seconds": 164.34,
      "duration_seconds": 3.34,
      "text": "okay time for me to examine you"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.26,
      "end_seconds": 167.33,
      "duration_seconds": 2.07,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.8,
      "end_seconds": 184.29,
      "duration_seconds": 7.49,
      "text": "there is a firm, painless lump in the left side of your neck about three centimetres"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.63,
      "end_seconds": 191.62,
      "duration_seconds": 4.99,
      "text": "that's all I needed to check any chest pain or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.07,
      "end_seconds": 195.22,
      "duration_seconds": 2.15,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.41,
      "end_seconds": 200.82,
      "duration_seconds": 2.41,
      "text": "Did you notice any bone pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.35,
      "end_seconds": 207.36,
      "duration_seconds": 2.01,
      "text": "No bone pain, thankfully."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.25,
      "end_seconds": 212.1,
      "duration_seconds": 3.85,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.83,
      "end_seconds": 215.3,
      "duration_seconds": 2.47,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.96,
      "end_seconds": 218.94,
      "duration_seconds": 1.98,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.59,
      "end_seconds": 224.17,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.93,
      "end_seconds": 229.03,
      "duration_seconds": 4.1,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.85,
      "end_seconds": 238.56,
      "duration_seconds": 8.71,
      "text": "Depression, for nearly five years. I've had anxiety for two years now. I have heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.64,
      "end_seconds": 241.88,
      "duration_seconds": 1.24,
      "text": "and besides that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.0,
      "end_seconds": 253.0,
      "duration_seconds": 2.0,
      "text": "so, how about smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.29,
      "end_seconds": 257.15,
      "duration_seconds": 2.86,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.0,
      "end_seconds": 261.65,
      "duration_seconds": 2.65,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.42,
      "end_seconds": 267.79,
      "duration_seconds": 4.37,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.12,
      "end_seconds": 275.14,
      "duration_seconds": 2.02,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.04,
      "end_seconds": 280.92,
      "duration_seconds": 3.88,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.36,
      "end_seconds": 286.24,
      "duration_seconds": 3.88,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.01,
      "end_seconds": 291.05,
      "duration_seconds": 4.04,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.79,
      "end_seconds": 298.33,
      "duration_seconds": 2.54,
      "text": "okay, any surgery in the past?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.3,
      "end_seconds": 306.96,
      "duration_seconds": 6.66,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.39,
      "end_seconds": 329.97,
      "duration_seconds": 4.58,
      "text": "any allergies to tablets food or anything in the environment?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.35,
      "end_seconds": 337.22,
      "duration_seconds": 5.87,
      "text": "Sorry, what was I saying, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.61,
      "end_seconds": 343.47,
      "duration_seconds": 2.86,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.13,
      "end_seconds": 348.81,
      "duration_seconds": 4.68,
      "text": "I'm on sertraline, once a day for my mood."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.7,
      "end_seconds": 352.82,
      "duration_seconds": 2.12,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.45,
      "end_seconds": 355.39,
      "duration_seconds": 0.94,
      "text": "50 milligrams"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.16,
      "end_seconds": 358.93,
      "duration_seconds": 1.77,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.35,
      "end_seconds": 361.8,
      "duration_seconds": 1.45,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.13,
      "end_seconds": 362.83,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.56,
      "end_seconds": 379.37,
      "duration_seconds": 14.81,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety. Metoprolol. I take it it 50 milligrams, twice a day. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.2,
      "end_seconds": 402.2,
      "duration_seconds": 11.0,
      "text": "So where does that leave us? I'd lean towards symptoms that need an urgent cancer work-up. I'd also keep a chronic infection in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.24,
      "end_seconds": 406.27,
      "duration_seconds": 3.03,
      "text": "Is this serious, um, doctor?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.57,
      "end_seconds": 422.69,
      "duration_seconds": 12.12,
      "text": "I can't promise yet, but most people with symptoms that need an urgent cancer work-up do well once it's treated properly. Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 423.27,
      "end_seconds": 430.35,
      "duration_seconds": 7.08,
      "text": "I did have an urgent chest X-ray done last month, but the paper's at home."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 431.7,
      "end_seconds": 437.25,
      "duration_seconds": 5.55,
      "text": "An ultrasound of the neck is what I'd like next, for neck lump."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 439.09,
      "end_seconds": 442.86,
      "duration_seconds": 3.77,
      "text": "I can book that for Wednesday at 9 am."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 443.69,
      "end_seconds": 455.84,
      "duration_seconds": 12.15,
      "text": "I'm going to order blood tests, for weight loss. I am referring you on an urgent pathway, which means an appointment within two weeks. Book a review after the scans."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 456.77,
      "end_seconds": 458.35,
      "duration_seconds": 1.58,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 459.11,
      "end_seconds": 461.59,
      "duration_seconds": 2.48,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 462.64,
      "end_seconds": 465.49,
      "duration_seconds": 2.85,
      "text": "no that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 466.95,
      "end_seconds": 468.71,
      "duration_seconds": 1.76,
      "text": "right, see you soon"
    }
  ]
}