{
  "schema_version": "1.0",
  "encounter_id": "01242",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 3.88,
      "duration_seconds": 3.1,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 9.21,
      "duration_seconds": 3.77,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.05,
      "end_seconds": 16.25,
      "duration_seconds": 3.2,
      "text": "I've been getting breathless lying flat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.25,
      "end_seconds": 21.74,
      "duration_seconds": 3.49,
      "text": "Okay, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.54,
      "end_seconds": 30.43,
      "duration_seconds": 7.89,
      "text": "It's been going on for five days. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.88,
      "end_seconds": 44.62,
      "duration_seconds": 8.74,
      "text": "Right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.01,
      "end_seconds": 52.54,
      "duration_seconds": 6.53,
      "text": "Uh, about a eight out of ten. It's worse with lying flat."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.69,
      "end_seconds": 56.75,
      "duration_seconds": 3.06,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.42,
      "end_seconds": 74.02,
      "duration_seconds": 15.6,
      "text": "When it starts I tend to get tiredness as well. Oh, and swollen ankles. With swollen ankles, it settles a little with feet up. The tiredness? That's been for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.08,
      "end_seconds": 80.38,
      "duration_seconds": 5.3,
      "text": "Have you been getting breathless lying flat at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.61,
      "end_seconds": 86.33,
      "duration_seconds": 4.72,
      "text": "I had a similar thing last winter. It went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.31,
      "end_seconds": 105.29,
      "duration_seconds": 3.98,
      "text": "Which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.54,
      "end_seconds": 117.19,
      "duration_seconds": 10.65,
      "text": "well, it's lisinopril, 10 milligrams, once a day for my pressure i do miss it now and then, to be fair"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.93,
      "end_seconds": 121.79,
      "duration_seconds": 2.86,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.65,
      "end_seconds": 128.86,
      "duration_seconds": 1.21,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.25,
      "end_seconds": 132.78,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.95,
      "end_seconds": 138.49,
      "duration_seconds": 4.54,
      "text": "Um, no, not that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.13,
      "end_seconds": 155.29,
      "duration_seconds": 4.16,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.0,
      "end_seconds": 160.81,
      "duration_seconds": 3.81,
      "text": "High blood pressure, for about a year"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 164.51,
      "duration_seconds": 2.5,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.24,
      "end_seconds": 180.84,
      "duration_seconds": 10.6,
      "text": "I'm vegetarian and have been for years. I do a yoga class on Thursdays. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.82,
      "end_seconds": 186.2,
      "duration_seconds": 4.38,
      "text": "A few quick ones: palpitations, chest pain or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.43,
      "end_seconds": 191.11,
      "duration_seconds": 3.68,
      "text": "No, no palpitations, chest pain or fainting."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.03,
      "end_seconds": 194.77,
      "duration_seconds": 2.74,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.8,
      "end_seconds": 198.43,
      "duration_seconds": 2.63,
      "text": "Mm, no, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.57,
      "end_seconds": 202.51,
      "duration_seconds": 2.94,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.39,
      "end_seconds": 205.08,
      "duration_seconds": 1.69,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.0,
      "end_seconds": 208.03,
      "duration_seconds": 2.03,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.12,
      "end_seconds": 220.57,
      "duration_seconds": 2.45,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.85,
      "end_seconds": 247.47,
      "duration_seconds": 14.62,
      "text": "okay: weight 84 kilos, temp 37.1 degrees, height 151 centimetres, BMI works out to 36.8, pressure 134 over 81, heart rate 91, respiratory rate 23, SpO2 92 percent on room air"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.18,
      "end_seconds": 254.53,
      "duration_seconds": 4.35,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.08,
      "end_seconds": 274.61,
      "duration_seconds": 1.53,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.33,
      "end_seconds": 277.64,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.27,
      "end_seconds": 296.3,
      "duration_seconds": 7.03,
      "text": "There is pitting swelling of both ankles and a few crackles at the lung bases."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.69,
      "end_seconds": 305.64,
      "duration_seconds": 6.95,
      "text": "Thank you, you can get dressed. I'd like to arrange blood tests for heart failure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 307.04,
      "end_seconds": 311.03,
      "duration_seconds": 3.99,
      "text": "I can book that for Monday at 9 am"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.95,
      "end_seconds": 346.08,
      "duration_seconds": 34.13,
      "text": "I'll start you on furosemide, 40 milligrams, once a day in the morning, long term. That should help with fluid retention. Weigh yourself every morning and tell us if you gain two kilos in three days. I think the heart failure nurse should see you too. Do get help quickly if the symptoms get worse. Book a review in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.32,
      "end_seconds": 349.76,
      "duration_seconds": 2.44,
      "text": "alright, thanks, take care"
    }
  ]
}