{
  "schema_version": "1.0",
  "encounter_id": "01294",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.93,
      "duration_seconds": 4.14,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 10.57,
      "duration_seconds": 4.44,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.21,
      "end_seconds": 17.63,
      "duration_seconds": 6.42,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.52,
      "end_seconds": 23.38,
      "duration_seconds": 3.86,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.44,
      "end_seconds": 29.57,
      "duration_seconds": 4.13,
      "text": "So, she's been having a blocked ear, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.93,
      "end_seconds": 34.35,
      "duration_seconds": 3.42,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.95,
      "end_seconds": 46.42,
      "duration_seconds": 10.47,
      "text": "I'm not sure when it began, um, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.15,
      "end_seconds": 48.97,
      "duration_seconds": 1.82,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.18,
      "end_seconds": 52.13,
      "duration_seconds": 1.95,
      "text": "It's worse with showering."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.33,
      "end_seconds": 53.17,
      "duration_seconds": 0.84,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.22,
      "end_seconds": 59.11,
      "duration_seconds": 3.89,
      "text": "Oh, and and a feeling of fullness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.09,
      "end_seconds": 64.28,
      "duration_seconds": 3.19,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 76.36,
      "duration_seconds": 5.87,
      "text": "well, maybe a six out of ten on a bad day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.8,
      "end_seconds": 82.31,
      "duration_seconds": 5.51,
      "text": "I follow a few quick ones: ear pain, dizziness, ringing or discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.13,
      "end_seconds": 86.36,
      "duration_seconds": 3.23,
      "text": "Right, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.98,
      "end_seconds": 89.73,
      "duration_seconds": 1.75,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.45,
      "end_seconds": 92.66,
      "duration_seconds": 2.21,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.67,
      "end_seconds": 97.78,
      "duration_seconds": 4.11,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 102.19,
      "duration_seconds": 2.85,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.07,
      "end_seconds": 105.43,
      "duration_seconds": 2.36,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.03,
      "end_seconds": 110.82,
      "duration_seconds": 4.79,
      "text": "Trimethoprim. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.09,
      "end_seconds": 130.75,
      "duration_seconds": 2.66,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.38,
      "end_seconds": 139.8,
      "duration_seconds": 7.42,
      "text": "I have diabetes. I've had an underactive thyroid, yes. Yes, heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.81,
      "end_seconds": 143.33,
      "duration_seconds": 2.52,
      "text": "Alright, do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 148.17,
      "duration_seconds": 4.03,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.15,
      "end_seconds": 153.47,
      "duration_seconds": 3.32,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.18,
      "end_seconds": 158.76,
      "duration_seconds": 3.58,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.84,
      "end_seconds": 171.74,
      "duration_seconds": 3.9,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.09,
      "end_seconds": 179.81,
      "duration_seconds": 6.72,
      "text": "Hmm, it's something called glic... gliclazide, 80 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.62,
      "end_seconds": 184.62,
      "duration_seconds": 4.0,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.42,
      "end_seconds": 196.5,
      "duration_seconds": 10.08,
      "text": "um, um, no, it's at home. Oh, it's Eltroxin, 100 micrograms, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.86,
      "end_seconds": 203.57,
      "duration_seconds": 1.71,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.51,
      "end_seconds": 207.11,
      "duration_seconds": 1.6,
      "text": "Six months now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.43,
      "end_seconds": 208.98,
      "duration_seconds": 1.55,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.81,
      "end_seconds": 219.37,
      "duration_seconds": 8.56,
      "text": "well, I'm on aspirin, 75 milligrams, once a day. Olive oil drops, twice a day"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 224.11,
      "duration_seconds": 3.02,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.74,
      "end_seconds": 231.97,
      "duration_seconds": 7.23,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.33,
      "end_seconds": 235.97,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.2,
      "end_seconds": 249.13,
      "duration_seconds": 2.93,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.07,
      "end_seconds": 276.82,
      "duration_seconds": 9.75,
      "text": "Okay: blood pressure 118 over 75, respiratory rate 16, temp 36.9 degrees, heart rate 78, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.89,
      "end_seconds": 279.7,
      "duration_seconds": 1.81,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.25,
      "end_seconds": 283.89,
      "duration_seconds": 2.64,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.65,
      "end_seconds": 288.09,
      "duration_seconds": 2.44,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.67,
      "end_seconds": 291.12,
      "duration_seconds": 1.45,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.94,
      "end_seconds": 308.48,
      "duration_seconds": 4.54,
      "text": "There's a a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.17,
      "end_seconds": 317.02,
      "duration_seconds": 2.85,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.16,
      "end_seconds": 344.86,
      "duration_seconds": 19.7,
      "text": "We should do ear irrigation for wax. Use the olive oil drops for a week and then we'll syringe the ear. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.09,
      "end_seconds": 351.21,
      "duration_seconds": 5.12,
      "text": "Okay, you know, I'll look out for that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.4,
      "end_seconds": 358.42,
      "duration_seconds": 6.02,
      "text": "book a review in one week i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.51,
      "end_seconds": 362.15,
      "duration_seconds": 2.64,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}