{
  "schema_version": "1.0",
  "encounter_id": "01270",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.27,
      "duration_seconds": 3.5,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.93,
      "end_seconds": 10.94,
      "duration_seconds": 5.01,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.48,
      "end_seconds": 19.15,
      "duration_seconds": 6.67,
      "text": "Honestly, it's a sore stiff knee, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 24.37,
      "duration_seconds": 4.49,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.65,
      "end_seconds": 32.28,
      "duration_seconds": 6.63,
      "text": "Paracetamol, 650 milligrams, when needed. It's ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.51,
      "end_seconds": 37.5,
      "duration_seconds": 4.99,
      "text": "I see, go ahead. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.01,
      "end_seconds": 44.81,
      "duration_seconds": 6.8,
      "text": "Around three days... no wait, you know, it's more like about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.58,
      "end_seconds": 48.83,
      "duration_seconds": 3.25,
      "text": "So, how often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.89,
      "end_seconds": 52.53,
      "duration_seconds": 2.64,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.85,
      "end_seconds": 56.91,
      "duration_seconds": 3.06,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.39,
      "end_seconds": 62.21,
      "duration_seconds": 3.82,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 67.43,
      "duration_seconds": 2.07,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.1,
      "end_seconds": 73.27,
      "duration_seconds": 2.17,
      "text": "It's worse with stairs."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.51,
      "end_seconds": 75.97,
      "duration_seconds": 2.46,
      "text": "Mm, okay. How about locked knee?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.51,
      "end_seconds": 81.16,
      "duration_seconds": 3.65,
      "text": "Not that I've noticed, no locked knee."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.03,
      "end_seconds": 85.61,
      "duration_seconds": 3.58,
      "text": "Have you had any fall, redness or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.27,
      "end_seconds": 89.98,
      "duration_seconds": 3.71,
      "text": "Oh, no, no fall, redness or fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.68,
      "end_seconds": 94.33,
      "duration_seconds": 3.65,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.77,
      "end_seconds": 97.19,
      "duration_seconds": 1.42,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.77,
      "end_seconds": 100.55,
      "duration_seconds": 2.78,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.33,
      "end_seconds": 109.45,
      "duration_seconds": 5.12,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.0,
      "end_seconds": 113.99,
      "duration_seconds": 2.99,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.21,
      "end_seconds": 119.34,
      "duration_seconds": 4.13,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.03,
      "end_seconds": 122.62,
      "duration_seconds": 1.59,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.21,
      "end_seconds": 127.9,
      "duration_seconds": 3.69,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.29,
      "end_seconds": 147.83,
      "duration_seconds": 2.54,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.09,
      "end_seconds": 153.17,
      "duration_seconds": 4.08,
      "text": "Arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 159.36,
      "duration_seconds": 4.29,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.04,
      "end_seconds": 163.81,
      "duration_seconds": 2.77,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.15,
      "end_seconds": 180.94,
      "duration_seconds": 2.79,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.61,
      "end_seconds": 185.79,
      "duration_seconds": 3.18,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.08,
      "end_seconds": 191.63,
      "duration_seconds": 4.55,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 206.38,
      "duration_seconds": 2.44,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.9,
      "end_seconds": 225.75,
      "duration_seconds": 8.85,
      "text": "Okay: pressure 112 over 71, respiratory rate 14, oxygen saturation is 99 percent. And pulse is 69 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.53,
      "end_seconds": 228.96,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.8,
      "end_seconds": 232.47,
      "duration_seconds": 2.67,
      "text": "Alright, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.12,
      "end_seconds": 261.9,
      "duration_seconds": 12.78,
      "text": "Going by what you've described, this looks most like knee osteoarthritis flare. The reason I say that is that the way you describe it fits together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.45,
      "end_seconds": 266.91,
      "duration_seconds": 3.46,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.48,
      "end_seconds": 288.58,
      "duration_seconds": 18.1,
      "text": "I can't promise yet, but most people with knee osteoarthritis flare do well once it's treated properly. Stop me if I've got anything wrong. You've had a sore stiff knee for about four days, and no redness or fever."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.24,
      "end_seconds": 290.92,
      "duration_seconds": 1.68,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.35,
      "end_seconds": 307.08,
      "duration_seconds": 14.73,
      "text": "We should do an X-ray of the knee for knee pain. Strengthen the thigh muscles and lose a little weight if you can. I'd like you back in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.54,
      "end_seconds": 310.59,
      "duration_seconds": 2.05,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.58,
      "end_seconds": 317.23,
      "duration_seconds": 2.65,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.28,
      "end_seconds": 321.04,
      "duration_seconds": 1.76,
      "text": "That's clear, thanks."
    }
  ]
}