{
  "schema_version": "1.0",
  "encounter_id": "01043",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.76,
      "end_seconds": 6.4,
      "duration_seconds": 5.64,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.43,
      "end_seconds": 13.61,
      "duration_seconds": 5.18,
      "text": "Right, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.77,
      "end_seconds": 21.08,
      "duration_seconds": 6.31,
      "text": "I've been feeling well, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.89,
      "end_seconds": 26.19,
      "duration_seconds": 3.3,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.72,
      "end_seconds": 32.62,
      "duration_seconds": 5.9,
      "text": "About a week, I think... sorry, four weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.4,
      "end_seconds": 36.89,
      "duration_seconds": 3.49,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.47,
      "end_seconds": 39.71,
      "duration_seconds": 1.24,
      "text": "Mild, really"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.38,
      "end_seconds": 44.08,
      "duration_seconds": 3.7,
      "text": "What about slightly dry skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.06,
      "end_seconds": 48.6,
      "duration_seconds": 2.54,
      "text": "yes, for about three months"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.36,
      "end_seconds": 53.06,
      "duration_seconds": 3.7,
      "text": "any weight change or feeling cold at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.54,
      "end_seconds": 57.05,
      "duration_seconds": 2.51,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.96,
      "end_seconds": 61.86,
      "duration_seconds": 2.9,
      "text": "A few quick ones: constipation or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.55,
      "end_seconds": 65.99,
      "duration_seconds": 3.44,
      "text": "I haven't had constipation or palpitations, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.93,
      "end_seconds": 74.33,
      "duration_seconds": 2.4,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.89,
      "end_seconds": 80.96,
      "duration_seconds": 3.07,
      "text": "Ah, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.35,
      "end_seconds": 91.98,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.94,
      "end_seconds": 99.89,
      "duration_seconds": 5.95,
      "text": "Eltroxin. I take it 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.71,
      "end_seconds": 115.97,
      "duration_seconds": 3.26,
      "text": "what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.3,
      "end_seconds": 125.15,
      "duration_seconds": 3.85,
      "text": "just a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.42,
      "end_seconds": 134.43,
      "duration_seconds": 5.01,
      "text": "Are you allergic to anything? Any allergies to to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.29,
      "end_seconds": 137.31,
      "duration_seconds": 2.02,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.33,
      "end_seconds": 142.08,
      "duration_seconds": 3.75,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.15,
      "end_seconds": 145.75,
      "duration_seconds": 2.6,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.8,
      "end_seconds": 149.92,
      "duration_seconds": 2.12,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.51,
      "end_seconds": 156.62,
      "duration_seconds": 4.11,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.2,
      "end_seconds": 160.74,
      "duration_seconds": 2.54,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.73,
      "end_seconds": 166.2,
      "duration_seconds": 3.47,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.19,
      "end_seconds": 171.68,
      "duration_seconds": 3.49,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.92,
      "end_seconds": 176.02,
      "duration_seconds": 3.1,
      "text": "An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 176.59,
      "end_seconds": 186.66,
      "duration_seconds": 10.07,
      "text": "here are the numbers, doctor. Blood pressure 112 over 77, temperature 36.5, saturation 97 percent, heart rate 77, respiratory rate 16."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.6,
      "end_seconds": 189.89,
      "duration_seconds": 1.29,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.89,
      "end_seconds": 195.98,
      "duration_seconds": 4.09,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.92,
      "end_seconds": 199.26,
      "duration_seconds": 1.34,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.26,
      "end_seconds": 216.81,
      "duration_seconds": 4.55,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.73,
      "end_seconds": 218.63,
      "duration_seconds": 0.9,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.38,
      "end_seconds": 224.14,
      "duration_seconds": 2.76,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.38,
      "end_seconds": 245.26,
      "duration_seconds": 6.88,
      "text": "from what you've told me and what I found, this looks most like well-controlled thyroid replacement"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.8,
      "end_seconds": 247.19,
      "duration_seconds": 1.39,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.26,
      "end_seconds": 281.56,
      "duration_seconds": 32.3,
      "text": "It's reasonable to be concerned, but right now well-controlled thyroid replacement is my leading thought, not anything worse. I'll request a thyroid blood test, it'll help with annual review. Keep taking the tablet on an empty stomach, apart from coffee. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Keep an eye out, and if you notice palpitations or weight change, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.36,
      "end_seconds": 290.75,
      "duration_seconds": 7.39,
      "text": "I'd like you back in twelve months. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.1,
      "end_seconds": 297.88,
      "duration_seconds": 5.78,
      "text": "so, I come back in twelve months is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.82,
      "end_seconds": 304.69,
      "duration_seconds": 5.87,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.35,
      "end_seconds": 308.66,
      "duration_seconds": 2.31,
      "text": "Thank you, that's helpful."
    }
  ]
}