{
  "schema_version": "1.0",
  "encounter_id": "01024",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.75,
      "duration_seconds": 3.53,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 11.72,
      "duration_seconds": 5.48,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.07,
      "end_seconds": 17.02,
      "duration_seconds": 3.95,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.58,
      "end_seconds": 22.09,
      "duration_seconds": 3.51,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.98,
      "end_seconds": 28.05,
      "duration_seconds": 5.07,
      "text": "I've been dealing with sharp pain low on one side."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.99,
      "end_seconds": 33.14,
      "duration_seconds": 3.15,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.05,
      "end_seconds": 40.83,
      "duration_seconds": 6.78,
      "text": "For three weeks, I'd say. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.72,
      "end_seconds": 45.07,
      "duration_seconds": 2.35,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.7,
      "end_seconds": 52.52,
      "duration_seconds": 1.82,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.85,
      "end_seconds": 56.18,
      "duration_seconds": 3.33,
      "text": "Mm, okay. Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.34,
      "end_seconds": 59.94,
      "duration_seconds": 2.6,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.58,
      "end_seconds": 63.42,
      "duration_seconds": 2.84,
      "text": "Have you had light vaginal bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.31,
      "end_seconds": 67.16,
      "duration_seconds": 2.85,
      "text": "Yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.83,
      "end_seconds": 72.22,
      "duration_seconds": 3.39,
      "text": "And what about fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.18,
      "end_seconds": 77.97,
      "duration_seconds": 3.79,
      "text": "I haven't had fever or vaginal discharge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.81,
      "end_seconds": 82.71,
      "duration_seconds": 2.9,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.31,
      "end_seconds": 85.61,
      "duration_seconds": 2.3,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.44,
      "end_seconds": 89.81,
      "duration_seconds": 2.37,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.75,
      "end_seconds": 93.68,
      "duration_seconds": 2.93,
      "text": "no, uh, all normal there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.74,
      "end_seconds": 100.26,
      "duration_seconds": 4.52,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.91,
      "end_seconds": 103.98,
      "duration_seconds": 2.07,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.65,
      "end_seconds": 108.55,
      "duration_seconds": 3.9,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.18,
      "end_seconds": 112.91,
      "duration_seconds": 3.73,
      "text": "I have high cholesterol, for about ten years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.69,
      "end_seconds": 122.07,
      "duration_seconds": 7.38,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today. Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.04,
      "end_seconds": 126.39,
      "duration_seconds": 3.35,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.09,
      "end_seconds": 128.57,
      "duration_seconds": 1.48,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.88,
      "end_seconds": 132.8,
      "duration_seconds": 2.92,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.55,
      "end_seconds": 134.72,
      "duration_seconds": 1.17,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.65,
      "end_seconds": 143.52,
      "duration_seconds": 3.87,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.82,
      "end_seconds": 147.11,
      "duration_seconds": 2.29,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.09,
      "end_seconds": 154.33,
      "duration_seconds": 6.24,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.61,
      "end_seconds": 157.34,
      "duration_seconds": 1.73,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.41,
      "end_seconds": 161.66,
      "duration_seconds": 3.25,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.96,
      "end_seconds": 177.92,
      "duration_seconds": 2.96,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.66,
      "end_seconds": 183.96,
      "duration_seconds": 4.3,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.0,
      "end_seconds": 204.2,
      "duration_seconds": 2.2,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 205.14,
      "end_seconds": 212.45,
      "duration_seconds": 7.31,
      "text": "She is on atorvastatin, 20 milligrams, at night for my cholesterol, I give it to her."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.47,
      "end_seconds": 217.57,
      "duration_seconds": 3.1,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.24,
      "end_seconds": 227.58,
      "duration_seconds": 3.34,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.72,
      "end_seconds": 246.12,
      "duration_seconds": 8.4,
      "text": "Okay: pulse is 117 beats a minute, temperature 37.0, SpO2 96 percent on room air, pressure 130 over 78."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.84,
      "end_seconds": 252.27,
      "duration_seconds": 3.43,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.8,
      "end_seconds": 255.3,
      "duration_seconds": 1.5,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.05,
      "end_seconds": 259.64,
      "duration_seconds": 2.59,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.96,
      "end_seconds": 283.78,
      "duration_seconds": 5.82,
      "text": "your tummy is tender low on the right and you look pale"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.44,
      "end_seconds": 297.14,
      "duration_seconds": 7.7,
      "text": "You can sit up now. Putting it all together, this looks most like a possible ectopic pregnancy."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.89,
      "end_seconds": 301.1,
      "duration_seconds": 3.21,
      "text": "I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.01,
      "end_seconds": 326.23,
      "duration_seconds": 24.22,
      "text": "I understand the worry. At the moment I'd say it's a possible ectopic pregnancy, and we'll know more once the a pregnancy test is back. I think a pregnancy test makes sense here, for pelvic pain and bleeding. I'd like to arrange an urgent pelvic scan for possible ectopic. You need to go to the hospital now for an emergency scan."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.37,
      "end_seconds": 342.17,
      "duration_seconds": 14.8,
      "text": "If the pain gets worse or you faint, or you feel really unwell, please come to the emergency department. See me again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.42,
      "end_seconds": 346.6,
      "duration_seconds": 3.18,
      "text": "Great, thank you for your help."
    }
  ]
}