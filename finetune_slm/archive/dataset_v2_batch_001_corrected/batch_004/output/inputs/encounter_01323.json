{
  "schema_version": "1.0",
  "encounter_id": "01323",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 6.66,
      "duration_seconds": 5.87,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.7,
      "end_seconds": 13.59,
      "duration_seconds": 4.89,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.12,
      "end_seconds": 16.77,
      "duration_seconds": 2.65,
      "text": "It's dry gritty eyes, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.68,
      "end_seconds": 21.74,
      "duration_seconds": 3.06,
      "text": "So, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.2,
      "end_seconds": 27.67,
      "duration_seconds": 2.47,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.95,
      "end_seconds": 36.88,
      "duration_seconds": 8.93,
      "text": "Ah. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.8,
      "end_seconds": 43.6,
      "duration_seconds": 5.8,
      "text": "It's mild, honestly. It's worse with air conditioning and screens."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.14,
      "end_seconds": 48.47,
      "duration_seconds": 3.33,
      "text": "And loss of vision, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.15,
      "end_seconds": 53.14,
      "duration_seconds": 2.99,
      "text": "No, none, no loss of vision."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.82,
      "end_seconds": 61.65,
      "duration_seconds": 3.83,
      "text": "Any light sensitivity, redness or pain at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.33,
      "end_seconds": 64.49,
      "duration_seconds": 2.16,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.27,
      "end_seconds": 69.7,
      "duration_seconds": 3.43,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.24,
      "end_seconds": 75.63,
      "duration_seconds": 1.39,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.61,
      "end_seconds": 95.15,
      "duration_seconds": 3.54,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.13,
      "end_seconds": 99.22,
      "duration_seconds": 3.09,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.87,
      "end_seconds": 114.73,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.58,
      "end_seconds": 117.91,
      "duration_seconds": 2.33,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.57,
      "end_seconds": 123.75,
      "duration_seconds": 1.18,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.8,
      "end_seconds": 128.02,
      "duration_seconds": 3.22,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.46,
      "end_seconds": 148.85,
      "duration_seconds": 3.39,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.4,
      "end_seconds": 151.53,
      "duration_seconds": 2.13,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.35,
      "end_seconds": 154.71,
      "duration_seconds": 2.36,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.46,
      "end_seconds": 159.83,
      "duration_seconds": 3.37,
      "text": "No, um, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.69,
      "end_seconds": 165.03,
      "duration_seconds": 3.34,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.55,
      "end_seconds": 176.26,
      "duration_seconds": 2.71,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.51,
      "end_seconds": 211.6,
      "duration_seconds": 14.09,
      "text": "Okay: weight 78 kilos, saturation 98 percent, BMI works out to 28.0. And pulse 69, temperature is 36.8 degrees, BP is 122 over 79, height 167 centimetres."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.1,
      "end_seconds": 217.13,
      "duration_seconds": 4.03,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.56,
      "end_seconds": 226.56,
      "duration_seconds": 1.0,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.63,
      "end_seconds": 229.61,
      "duration_seconds": 1.98,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.52,
      "end_seconds": 253.2,
      "duration_seconds": 5.68,
      "text": "Your eyelids look slightly crusted but the white of the eye is clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.34,
      "end_seconds": 265.86,
      "duration_seconds": 10.52,
      "text": "Good, you can sit up again. Okay, thinking it through, I can't pin this down yet. We're looking at dry eye disease or blepharitis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.22,
      "end_seconds": 274.0,
      "duration_seconds": 3.78,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.24,
      "end_seconds": 301.75,
      "duration_seconds": 26.51,
      "text": "Nothing I've seen today points to an emergency. It looks like dry eye disease, but I'd like to confirm. Let's get an eye test, for eye strain. Take screen breaks every twenty minutes and use warm compresses on the lids. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.7,
      "end_seconds": 305.31,
      "duration_seconds": 1.61,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.72,
      "end_seconds": 315.21,
      "duration_seconds": 8.49,
      "text": "Come back in six weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.16,
      "end_seconds": 321.02,
      "duration_seconds": 4.86,
      "text": "So, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.85,
      "end_seconds": 326.92,
      "duration_seconds": 4.07,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.1,
      "end_seconds": 330.43,
      "duration_seconds": 2.33,
      "text": "Thank you, that's helpful."
    }
  ]
}