{
  "schema_version": "1.0",
  "encounter_id": "01413",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.67,
      "duration_seconds": 3.87,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.55,
      "duration_seconds": 4.85,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.56,
      "end_seconds": 22.46,
      "duration_seconds": 9.9,
      "text": "Honestly, it's a sore throat, and my family pushed me to come. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.48,
      "end_seconds": 26.41,
      "duration_seconds": 2.93,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.28,
      "end_seconds": 42.87,
      "duration_seconds": 15.59,
      "text": "Erm, uh, it's been going on for about three months. I told myself I'd wait and see, and here I am. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.71,
      "end_seconds": 53.36,
      "duration_seconds": 8.65,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.23,
      "end_seconds": 61.37,
      "duration_seconds": 7.14,
      "text": "It's mild, honestly. Warm drinks helps a bit. Yes, swallowing. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.09,
      "end_seconds": 65.78,
      "duration_seconds": 2.69,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.41,
      "end_seconds": 82.48,
      "duration_seconds": 16.07,
      "text": "When it starts I tend to get a mild cough as well. I've been feeling tired too, for five days. About feeling tired, about a six out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.57,
      "end_seconds": 90.42,
      "duration_seconds": 5.85,
      "text": "Have you had a sore throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.34,
      "end_seconds": 100.96,
      "duration_seconds": 8.62,
      "text": "yes, uh, something like this happened last year, and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.17,
      "end_seconds": 105.62,
      "duration_seconds": 3.45,
      "text": "Did you get chest pain, breathlessness or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.16,
      "end_seconds": 109.5,
      "duration_seconds": 3.34,
      "text": "Right, no, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.96,
      "end_seconds": 117.32,
      "duration_seconds": 2.36,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.94,
      "end_seconds": 119.04,
      "duration_seconds": 1.1,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.21,
      "end_seconds": 132.28,
      "duration_seconds": 2.07,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.07,
      "end_seconds": 148.73,
      "duration_seconds": 14.66,
      "text": "It's warfarin, 3 milligrams, in the evening for the blood thinning. I thought it would sort itself out, but it hasn't. I take paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.51,
      "end_seconds": 169.72,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.46,
      "end_seconds": 174.86,
      "duration_seconds": 4.4,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.7,
      "end_seconds": 178.46,
      "duration_seconds": 2.76,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.68,
      "end_seconds": 186.97,
      "duration_seconds": 3.29,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.03,
      "end_seconds": 193.71,
      "duration_seconds": 2.68,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.62,
      "end_seconds": 199.25,
      "duration_seconds": 3.63,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.12,
      "end_seconds": 202.96,
      "duration_seconds": 2.84,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.13,
      "end_seconds": 208.6,
      "duration_seconds": 4.47,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 225.23,
      "duration_seconds": 2.72,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.9,
      "end_seconds": 232.1,
      "duration_seconds": 5.2,
      "text": "I've had an irregular heartbeat for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.15,
      "end_seconds": 236.37,
      "duration_seconds": 3.22,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.4,
      "end_seconds": 240.67,
      "duration_seconds": 3.27,
      "text": "Uh, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.64,
      "end_seconds": 245.0,
      "duration_seconds": 3.36,
      "text": "okay, I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.0,
      "end_seconds": 256.1,
      "duration_seconds": 2.1,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.03,
      "end_seconds": 276.0,
      "duration_seconds": 7.97,
      "text": "Okay: pressure 111 over 81, saturation 97 percent, pulse is 68 beats a minute, respiratory rate 16."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.33,
      "end_seconds": 280.87,
      "duration_seconds": 3.54,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.78,
      "end_seconds": 284.21,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.63,
      "end_seconds": 299.68,
      "duration_seconds": 4.05,
      "text": "your oxygen is normal and your chest is clear"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.97,
      "end_seconds": 310.47,
      "duration_seconds": 8.5,
      "text": "Right, you can relax now. Having listened and examined, my working impression is a mild viral respiratory infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.23,
      "end_seconds": 315.53,
      "duration_seconds": 3.3,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.61,
      "end_seconds": 344.32,
      "duration_seconds": 26.71,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild viral respiratory infection, but I'd like to confirm. I'd like to arrange a COVID test for respiratory symptoms. Rest, fluids, and stay home until you feel well and the fever has settled. Let's plan a check if not improving in a week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.12,
      "end_seconds": 349.03,
      "duration_seconds": 2.91,
      "text": "I, I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.06,
      "end_seconds": 352.4,
      "duration_seconds": 2.34,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.24,
      "end_seconds": 357.7,
      "duration_seconds": 4.46,
      "text": "I mean, you know, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.89,
      "end_seconds": 360.11,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}