{
  "schema_version": "1.0",
  "encounter_id": "01320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.0,
      "duration_seconds": 3.31,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 10.19,
      "duration_seconds": 4.98,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.2,
      "end_seconds": 17.03,
      "duration_seconds": 5.83,
      "text": "Honestly, it's irregular periods, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.49,
      "end_seconds": 20.89,
      "duration_seconds": 2.4,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.77,
      "end_seconds": 30.07,
      "duration_seconds": 5.3,
      "text": "I, I take thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.56,
      "end_seconds": 33.41,
      "duration_seconds": 1.85,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.02,
      "end_seconds": 42.49,
      "duration_seconds": 8.47,
      "text": "About three months now. Tamsulosin. I take it 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.35,
      "end_seconds": 46.09,
      "duration_seconds": 2.74,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.95,
      "end_seconds": 54.92,
      "duration_seconds": 7.97,
      "text": "About... well, about a month. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.14,
      "end_seconds": 59.68,
      "duration_seconds": 3.54,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 70.02,
      "duration_seconds": 9.64,
      "text": "I'd call it moderate. Sorry, what was I saying, I've been putting on weight too, for two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.24,
      "end_seconds": 71.26,
      "duration_seconds": 1.02,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.22,
      "end_seconds": 75.36,
      "duration_seconds": 2.14,
      "text": "I've also had acne."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.53,
      "end_seconds": 81.62,
      "duration_seconds": 5.09,
      "text": "Have you had irregular periods before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.65,
      "end_seconds": 87.77,
      "duration_seconds": 5.12,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.1,
      "end_seconds": 93.54,
      "duration_seconds": 4.44,
      "text": "And what about palpitations, milky nipple discharge or headaches?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.09,
      "end_seconds": 106.41,
      "duration_seconds": 7.32,
      "text": "Sorry, what was I saying, I haven't had palpitations, milky nipple discharge or headaches, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.16,
      "end_seconds": 111.64,
      "duration_seconds": 3.48,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.91,
      "end_seconds": 115.48,
      "duration_seconds": 2.57,
      "text": "Mm, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.09,
      "end_seconds": 119.91,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.02,
      "end_seconds": 123.95,
      "duration_seconds": 2.93,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.49,
      "end_seconds": 125.8,
      "duration_seconds": 1.31,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.5,
      "end_seconds": 129.48,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.5,
      "end_seconds": 132.34,
      "duration_seconds": 1.84,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.0,
      "end_seconds": 137.95,
      "duration_seconds": 3.95,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.92,
      "end_seconds": 151.38,
      "duration_seconds": 1.46,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.39,
      "end_seconds": 160.39,
      "duration_seconds": 4.0,
      "text": "Hmm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.15,
      "end_seconds": 164.41,
      "duration_seconds": 3.26,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.51,
      "end_seconds": 186.34,
      "duration_seconds": 19.83,
      "text": "An underactive thyroid, for five years. Oh, you know, I've had an enlarged prostate for about ten years now. I'm not great at remembering details, so bear with me. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.82,
      "end_seconds": 189.16,
      "duration_seconds": 1.34,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.33,
      "end_seconds": 211.88,
      "duration_seconds": 4.55,
      "text": "Okay, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.65,
      "end_seconds": 228.39,
      "duration_seconds": 2.74,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.53,
      "end_seconds": 253.79,
      "duration_seconds": 9.26,
      "text": "Okay: blood pressure 117 over 82, pulse 81, SpO2 99 percent on room air, respiratory rate 15, temperature 36.5."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.94,
      "end_seconds": 260.87,
      "duration_seconds": 4.93,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.53,
      "end_seconds": 264.35,
      "duration_seconds": 1.82,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.44,
      "end_seconds": 287.14,
      "duration_seconds": 9.7,
      "text": "Your weight is up a little, and there is acne on the jaw and some coarse hairs on the chin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.2,
      "end_seconds": 308.83,
      "duration_seconds": 17.63,
      "text": "Right, that's the examination finished. So, based on the history and the examination, this is probably polycystic ovary syndrome. That's my thinking for now, and it may change as we learn more. High prolactin is also on my list."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.34,
      "end_seconds": 329.97,
      "duration_seconds": 4.63,
      "text": "I'm going to order a pelvic ultrasound, for irregular periods."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.33,
      "end_seconds": 335.24,
      "duration_seconds": 3.91,
      "text": "Ah, where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.22,
      "end_seconds": 348.44,
      "duration_seconds": 12.22,
      "text": "Let's get hormone blood tests, for irregular periods. It's a routine test and it'll give us a much clearer picture. I'm going to order a thyroid test, for irregular periods."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.41,
      "end_seconds": 351.36,
      "duration_seconds": 1.95,
      "text": "Mm, um, alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.76,
      "end_seconds": 374.41,
      "duration_seconds": 21.65,
      "text": "What I'm giving you is metformin, 500 milligrams, twice a day with food, long term. It's for polycystic ovaries. Regular exercise and a lower-sugar diet help the periods settle. Please come and see me after the results. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.29,
      "end_seconds": 386.31,
      "duration_seconds": 11.02,
      "text": "So, I take the metformin, 500 milligrams, twice a day with food and come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.64,
      "end_seconds": 396.55,
      "duration_seconds": 4.91,
      "text": "So, yes, exactly right. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.24,
      "end_seconds": 400.47,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    }
  ]
}