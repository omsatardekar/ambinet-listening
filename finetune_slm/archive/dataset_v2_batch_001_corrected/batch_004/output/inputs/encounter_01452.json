{
  "schema_version": "1.0",
  "encounter_id": "01452",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 7.75,
      "duration_seconds": 6.69,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 13.26,
      "duration_seconds": 4.87,
      "text": "So, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.01,
      "end_seconds": 22.85,
      "duration_seconds": 5.84,
      "text": "Doctor, it's severe lower back pain. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.51,
      "end_seconds": 25.95,
      "duration_seconds": 1.44,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.33,
      "end_seconds": 30.08,
      "duration_seconds": 2.75,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.16,
      "end_seconds": 37.3,
      "duration_seconds": 5.14,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.48,
      "end_seconds": 46.83,
      "duration_seconds": 8.35,
      "text": "Severe, I'd say. Bending definitely sets it off. I've also had weakness in both legs."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.7,
      "end_seconds": 68.31,
      "duration_seconds": 2.61,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.91,
      "end_seconds": 84.18,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.99,
      "end_seconds": 107.78,
      "duration_seconds": 7.79,
      "text": "Okay: blood pressure 115 over 70, pulse 64. And temp 36.8 degrees, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.47,
      "end_seconds": 115.26,
      "duration_seconds": 4.79,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.33,
      "end_seconds": 118.29,
      "duration_seconds": 1.96,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.08,
      "end_seconds": 132.44,
      "duration_seconds": 5.36,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.59,
      "end_seconds": 136.25,
      "duration_seconds": 1.66,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 147.15,
      "duration_seconds": 2.75,
      "text": "Have you noticed recent fall or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.31,
      "end_seconds": 152.08,
      "duration_seconds": 3.77,
      "text": "No recent fall or fever, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.81,
      "end_seconds": 161.78,
      "duration_seconds": 3.97,
      "text": "Right, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.81,
      "end_seconds": 165.65,
      "duration_seconds": 2.84,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.97,
      "end_seconds": 170.04,
      "duration_seconds": 2.07,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.99,
      "end_seconds": 174.4,
      "duration_seconds": 2.41,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.44,
      "end_seconds": 194.98,
      "duration_seconds": 3.54,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.03,
      "end_seconds": 202.28,
      "duration_seconds": 5.25,
      "text": "I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.25,
      "end_seconds": 214.78,
      "duration_seconds": 10.53,
      "text": "Hm, okay. Okay, I can see arthritis in your knees in your file as well. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.66,
      "end_seconds": 223.1,
      "duration_seconds": 6.44,
      "text": "Not currently, but as a youngster erythromycin gave me bad stomach cramps."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.67,
      "end_seconds": 225.85,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.93,
      "end_seconds": 231.76,
      "duration_seconds": 3.83,
      "text": "Um, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.74,
      "end_seconds": 235.13,
      "duration_seconds": 2.39,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.56,
      "end_seconds": 239.85,
      "duration_seconds": 3.29,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.63,
      "end_seconds": 243.27,
      "duration_seconds": 2.64,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.86,
      "end_seconds": 247.75,
      "duration_seconds": 3.89,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.72,
      "end_seconds": 252.67,
      "duration_seconds": 3.95,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.24,
      "end_seconds": 255.27,
      "duration_seconds": 2.03,
      "text": "It's diclofenac, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.9,
      "end_seconds": 259.13,
      "duration_seconds": 2.23,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.65,
      "end_seconds": 261.73,
      "duration_seconds": 1.08,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 276.32,
      "duration_seconds": 10.56,
      "text": "Okay, so my impression is this: I think we're dealing with possible cauda equina syndrome needing an urgent scan at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.11,
      "end_seconds": 307.15,
      "duration_seconds": 14.04,
      "text": "I'll request an urgent MRI of the spine, it'll help with possible cauda equina. You need to go to hospital now for an emergency scan. I'll also refer you to the spinal team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.42,
      "end_seconds": 312.28,
      "duration_seconds": 3.86,
      "text": "Sure, uh, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.76,
      "end_seconds": 315.87,
      "duration_seconds": 2.11,
      "text": "See me again straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.16,
      "end_seconds": 319.69,
      "duration_seconds": 2.53,
      "text": "Ah, that's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.76,
      "end_seconds": 326.7,
      "duration_seconds": 4.94,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.34,
      "end_seconds": 332.3,
      "duration_seconds": 3.96,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}