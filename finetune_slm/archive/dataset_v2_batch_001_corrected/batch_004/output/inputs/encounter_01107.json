{
  "schema_version": "1.0",
  "encounter_id": "01107",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.67,
      "duration_seconds": 4.06,
      "text": "hello, doctor i think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 11.21,
      "duration_seconds": 4.83,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.25,
      "end_seconds": 30.43,
      "duration_seconds": 17.18,
      "text": "Um, uh, so... a hot swollen painful knee. That's why I came. I did try to ignore it for a while. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.22,
      "end_seconds": 36.1,
      "duration_seconds": 3.88,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.65,
      "end_seconds": 44.82,
      "duration_seconds": 3.17,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.08,
      "end_seconds": 51.32,
      "duration_seconds": 6.24,
      "text": "I follow. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.85,
      "end_seconds": 71.3,
      "duration_seconds": 19.45,
      "text": "I'd say severe. I notice it more with any movement. I'd rather know what's going on than keep guessing. Oh, and not being able to walk on it. Had that since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.8,
      "end_seconds": 81.15,
      "duration_seconds": 2.35,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.04,
      "end_seconds": 88.51,
      "duration_seconds": 5.47,
      "text": "Let me think, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.84,
      "end_seconds": 92.35,
      "duration_seconds": 2.51,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.36,
      "end_seconds": 105.0,
      "duration_seconds": 11.64,
      "text": "sorry, what was I saying, it's lansoprazole, 30 milligrams, before breakfast i'd been on pantoprazole, not any more though, I stopped"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.12,
      "end_seconds": 111.35,
      "duration_seconds": 5.23,
      "text": "right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.36,
      "end_seconds": 139.18,
      "duration_seconds": 25.82,
      "text": "Mm, yes, low haemoglobin. My neighbour said I should get it looked at. I didn't want to bother you but it keeps coming back. I have acid reflux. I'm not great at remembering details, so bear with me. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.24,
      "end_seconds": 149.07,
      "duration_seconds": 8.83,
      "text": "alright, low haemoglobin and acid reflux, that matches what I have here. Let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.22,
      "end_seconds": 164.21,
      "duration_seconds": 13.99,
      "text": "I quit smoking around ten years ago. I hardly move around during the day. Yes, I work in a bakery, early starts. I live with my elderly mother"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.59,
      "end_seconds": 170.58,
      "duration_seconds": 4.99,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.23,
      "end_seconds": 174.43,
      "duration_seconds": 3.2,
      "text": "yes, I'm allergic to to kiwi"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.03,
      "end_seconds": 180.55,
      "duration_seconds": 4.52,
      "text": "A few quick ones: rash, recent injury or other joint pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.47,
      "end_seconds": 188.07,
      "duration_seconds": 5.6,
      "text": "no rash, recent injury or other joint pain, none of it"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.16,
      "end_seconds": 193.1,
      "duration_seconds": 2.94,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.94,
      "end_seconds": 196.01,
      "duration_seconds": 1.07,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.14,
      "end_seconds": 200.77,
      "duration_seconds": 3.63,
      "text": "So, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.36,
      "end_seconds": 203.05,
      "duration_seconds": 1.69,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.29,
      "end_seconds": 219.33,
      "duration_seconds": 4.04,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.01,
      "end_seconds": 232.32,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.0,
      "end_seconds": 258.66,
      "duration_seconds": 12.66,
      "text": "Okay: temp 38.9 degrees, height 167 centimetres. And pressure 108 over 71, weight 68 kilos, SpO2 96 percent on room air, pulse 101, BMI works out to 24.4."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.72,
      "end_seconds": 262.6,
      "duration_seconds": 2.88,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.11,
      "end_seconds": 266.04,
      "duration_seconds": 1.93,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.48,
      "end_seconds": 288.72,
      "duration_seconds": 6.24,
      "text": "The knee is hot, swollen and extremely painful when I move it even slightly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.55,
      "end_seconds": 294.63,
      "duration_seconds": 2.08,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.94,
      "end_seconds": 325.52,
      "duration_seconds": 21.58,
      "text": "Let's book a joint aspiration to look into hot swollen knee. Let's book urgent blood tests to look into septic arthritis. You need to go to hospital now for a joint washout assessment. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.07,
      "end_seconds": 328.9,
      "duration_seconds": 1.83,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.92,
      "end_seconds": 337.26,
      "duration_seconds": 7.34,
      "text": "I'd like you back straight away is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.17,
      "end_seconds": 342.75,
      "duration_seconds": 3.58,
      "text": "So, I think I understand everything. Thanks."
    }
  ]
}