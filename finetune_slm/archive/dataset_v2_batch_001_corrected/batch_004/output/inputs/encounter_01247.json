{
  "schema_version": "1.0",
  "encounter_id": "01247",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 4.06,
      "duration_seconds": 2.93,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.85,
      "end_seconds": 9.28,
      "duration_seconds": 4.43,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.74,
      "end_seconds": 15.34,
      "duration_seconds": 4.6,
      "text": "Well, I've been having a tight band around my head."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.32,
      "end_seconds": 19.68,
      "duration_seconds": 3.36,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.32,
      "end_seconds": 28.24,
      "duration_seconds": 6.92,
      "text": "I've had it for two weeks. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.79,
      "end_seconds": 35.54,
      "duration_seconds": 6.75,
      "text": "Hm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.15,
      "end_seconds": 45.38,
      "duration_seconds": 9.23,
      "text": "hmm, you know, I'd give it a five, out of ten it's worse with stress and long screen days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.67,
      "end_seconds": 61.56,
      "duration_seconds": 4.89,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.57,
      "end_seconds": 82.07,
      "duration_seconds": 19.5,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I swim twice a week. I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.61,
      "end_seconds": 85.28,
      "duration_seconds": 2.67,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.31,
      "end_seconds": 89.97,
      "duration_seconds": 2.66,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.55,
      "end_seconds": 91.92,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.95,
      "end_seconds": 99.46,
      "duration_seconds": 3.51,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.26,
      "end_seconds": 105.57,
      "duration_seconds": 4.31,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.98,
      "end_seconds": 109.62,
      "duration_seconds": 2.64,
      "text": "No, uh, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.0,
      "end_seconds": 116.13,
      "duration_seconds": 5.13,
      "text": "have you had any weakness, blurred vision, sensitivity to light or sickness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.65,
      "end_seconds": 125.53,
      "duration_seconds": 6.88,
      "text": "no weakness, blurred vision, sensitivity to light or sickness, none of it"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.8,
      "end_seconds": 129.07,
      "duration_seconds": 2.27,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.84,
      "end_seconds": 130.86,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.71,
      "end_seconds": 153.42,
      "duration_seconds": 3.71,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.31,
      "end_seconds": 163.67,
      "duration_seconds": 2.36,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.76,
      "end_seconds": 189.45,
      "duration_seconds": 7.69,
      "text": "Okay: heart rate 75, respiratory rate 16, temp 36.4 degrees, BP is 122 over 81."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.62,
      "end_seconds": 192.91,
      "duration_seconds": 2.29,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 196.08,
      "duration_seconds": 1.46,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.77,
      "end_seconds": 213.03,
      "duration_seconds": 5.26,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.56,
      "end_seconds": 220.15,
      "duration_seconds": 1.59,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.81,
      "end_seconds": 251.2,
      "duration_seconds": 13.39,
      "text": "so so where does that leave us? This looks most like tension-type headache. I want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.16,
      "end_seconds": 255.97,
      "duration_seconds": 3.81,
      "text": "Well, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.91,
      "end_seconds": 267.04,
      "duration_seconds": 10.13,
      "text": "I understand the worry. At the moment I'd say it's tension-type headache, and we'll know more once the an eye test is back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.89,
      "end_seconds": 309.54,
      "duration_seconds": 27.65,
      "text": "We should do an eye test for eye strain. I'd rather check than guess, and this is the quickest way to know more. Take screen breaks every hour and try regular neck stretches. If you smoke, this is a good moment to think about stopping, and we can help you with that. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.63,
      "end_seconds": 312.14,
      "duration_seconds": 1.51,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.22,
      "end_seconds": 318.54,
      "duration_seconds": 5.32,
      "text": "Alright, is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.49,
      "end_seconds": 323.83,
      "duration_seconds": 3.34,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.24,
      "end_seconds": 326.64,
      "duration_seconds": 1.4,
      "text": "Take care now."
    }
  ]
}