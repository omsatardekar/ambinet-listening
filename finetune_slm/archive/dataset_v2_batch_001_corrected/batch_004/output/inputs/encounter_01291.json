{
  "schema_version": "1.0",
  "encounter_id": "01291",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 5.07,
      "duration_seconds": 4.13,
      "text": "Sorry, uh, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.48,
      "end_seconds": 10.64,
      "duration_seconds": 4.16,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.28,
      "end_seconds": 17.36,
      "duration_seconds": 5.08,
      "text": "I wanted to get an irregular heartbeat looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.29,
      "end_seconds": 19.61,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.24,
      "end_seconds": 30.64,
      "duration_seconds": 10.4,
      "text": "Probably two days. Yeah. Work has been very busy so I kept ignoring it. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.59,
      "end_seconds": 34.69,
      "duration_seconds": 3.1,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.67,
      "end_seconds": 39.01,
      "duration_seconds": 3.34,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.67,
      "end_seconds": 43.05,
      "duration_seconds": 3.38,
      "text": "What about occasional bruising, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.81,
      "end_seconds": 46.76,
      "duration_seconds": 1.95,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.62,
      "end_seconds": 66.95,
      "duration_seconds": 3.33,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.26,
      "end_seconds": 74.29,
      "duration_seconds": 6.03,
      "text": "Metoprolol. I take it 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.62,
      "end_seconds": 92.82,
      "duration_seconds": 3.2,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.04,
      "end_seconds": 98.13,
      "duration_seconds": 4.09,
      "text": "I've, I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.74,
      "end_seconds": 100.44,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.39,
      "end_seconds": 111.85,
      "duration_seconds": 1.46,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.37,
      "end_seconds": 116.45,
      "duration_seconds": 3.08,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.45,
      "end_seconds": 123.41,
      "duration_seconds": 2.96,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.29,
      "end_seconds": 128.51,
      "duration_seconds": 3.22,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.06,
      "end_seconds": 131.54,
      "duration_seconds": 1.48,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.28,
      "end_seconds": 136.21,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.76,
      "end_seconds": 143.01,
      "duration_seconds": 5.25,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.86,
      "end_seconds": 147.74,
      "duration_seconds": 3.88,
      "text": "So, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.65,
      "end_seconds": 152.55,
      "duration_seconds": 2.9,
      "text": "Any nosebleeds or chest pain at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.45,
      "end_seconds": 160.22,
      "duration_seconds": 2.77,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.12,
      "end_seconds": 164.22,
      "duration_seconds": 3.1,
      "text": "Any fainting or black stools at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.74,
      "end_seconds": 171.0,
      "duration_seconds": 4.26,
      "text": "No fainting or black stools, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.8,
      "end_seconds": 176.42,
      "duration_seconds": 4.62,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.58,
      "end_seconds": 180.25,
      "duration_seconds": 2.67,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.77,
      "end_seconds": 183.56,
      "duration_seconds": 2.79,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.76,
      "end_seconds": 192.75,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.54,
      "end_seconds": 217.68,
      "duration_seconds": 6.14,
      "text": "Okay: pulse is 105 beats a minute, temperature 37.1, pressure 112 over 80."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.35,
      "end_seconds": 219.91,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 223.22,
      "duration_seconds": 2.74,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.77,
      "end_seconds": 229.39,
      "duration_seconds": 4.62,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.9,
      "end_seconds": 230.95,
      "duration_seconds": 1.05,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.82,
      "end_seconds": 234.78,
      "duration_seconds": 2.96,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.59,
      "end_seconds": 255.02,
      "duration_seconds": 5.43,
      "text": "Your pulse is irregular and your heart sounds are otherwise normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.63,
      "end_seconds": 257.59,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.36,
      "end_seconds": 274.55,
      "duration_seconds": 14.19,
      "text": "All finished, thank you. I want a full blood count done, that's for anticoagulant review. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 276.02,
      "end_seconds": 278.64,
      "duration_seconds": 2.62,
      "text": "The earliest is Wednesday, 9 am."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.03,
      "end_seconds": 309.47,
      "duration_seconds": 29.44,
      "text": "I want an ECG done, that's for irregular pulse. That will help us see what's going on underneath and decide the next step. Never skip the blood thinner, and tell any dentist or surgeon you take it. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. We'll catch up in three months. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.49,
      "end_seconds": 315.05,
      "duration_seconds": 3.56,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.49,
      "end_seconds": 317.86,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}