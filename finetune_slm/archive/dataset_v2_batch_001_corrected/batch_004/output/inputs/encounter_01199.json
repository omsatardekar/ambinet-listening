{
  "schema_version": "1.0",
  "encounter_id": "01199",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 6.66,
      "duration_seconds": 5.57,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.47,
      "end_seconds": 13.22,
      "duration_seconds": 4.75,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.26,
      "end_seconds": 19.92,
      "duration_seconds": 5.66,
      "text": "Doctor, it's no real problems. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.21,
      "end_seconds": 25.25,
      "duration_seconds": 4.04,
      "text": "So, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.21,
      "end_seconds": 30.68,
      "duration_seconds": 3.47,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.19,
      "end_seconds": 33.6,
      "duration_seconds": 2.41,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.34,
      "end_seconds": 45.34,
      "duration_seconds": 11.0,
      "text": "About a eight out of ten. There's a bit of back stiffness as well. About bit of back stiffness, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.61,
      "end_seconds": 51.15,
      "duration_seconds": 4.54,
      "text": "What about an occasional headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.42,
      "end_seconds": 60.33,
      "duration_seconds": 7.91,
      "text": "Yes, about the same, two weeks. As for occasional headache, it happens all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.53,
      "end_seconds": 65.6,
      "duration_seconds": 4.07,
      "text": "Have you noticed shortness of breath or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.85,
      "end_seconds": 73.41,
      "duration_seconds": 2.56,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.47,
      "end_seconds": 77.22,
      "duration_seconds": 2.75,
      "text": "Has there been any chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.16,
      "end_seconds": 81.18,
      "duration_seconds": 3.02,
      "text": "No, none, no chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.71,
      "end_seconds": 84.18,
      "duration_seconds": 2.47,
      "text": "So, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.2,
      "end_seconds": 86.73,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.16,
      "end_seconds": 91.97,
      "duration_seconds": 3.81,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.52,
      "end_seconds": 100.18,
      "duration_seconds": 6.66,
      "text": "Erm, I'm on carbamazepine, 200 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.8,
      "end_seconds": 104.21,
      "duration_seconds": 2.41,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.82,
      "end_seconds": 107.79,
      "duration_seconds": 1.97,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.53,
      "end_seconds": 128.89,
      "duration_seconds": 4.36,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.99,
      "end_seconds": 134.23,
      "duration_seconds": 4.24,
      "text": "I'm allergic to milk, I get a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.76,
      "end_seconds": 138.52,
      "duration_seconds": 3.76,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.83,
      "end_seconds": 153.98,
      "duration_seconds": 14.15,
      "text": "I've had high cholesterol for about ten years now. I told my wife I'd come today. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.78,
      "end_seconds": 156.48,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.12,
      "end_seconds": 166.75,
      "duration_seconds": 8.63,
      "text": "I have arthritis in my knees, for about ten years. I have epilepsy, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.17,
      "end_seconds": 169.5,
      "duration_seconds": 1.33,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.8,
      "end_seconds": 176.62,
      "duration_seconds": 5.82,
      "text": "Alright, high cholesterol and arthritis in your knees, that matches what I have here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.89,
      "end_seconds": 190.36,
      "duration_seconds": 2.47,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.14,
      "end_seconds": 193.56,
      "duration_seconds": 2.42,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.83,
      "end_seconds": 197.36,
      "duration_seconds": 2.53,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.02,
      "end_seconds": 202.34,
      "duration_seconds": 3.32,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.87,
      "end_seconds": 205.36,
      "duration_seconds": 2.49,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.44,
      "end_seconds": 210.4,
      "duration_seconds": 3.96,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.45,
      "end_seconds": 215.07,
      "duration_seconds": 2.62,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.64,
      "end_seconds": 219.43,
      "duration_seconds": 3.79,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 220.81,
      "end_seconds": 231.28,
      "duration_seconds": 10.47,
      "text": "Here are the numbers, doctor. Saturation 98 percent, respiratory rate 15. BP is 122 over 73, pulse 69, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.99,
      "end_seconds": 233.32,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.33,
      "end_seconds": 240.08,
      "duration_seconds": 4.75,
      "text": "Alright, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.98,
      "end_seconds": 257.68,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.71,
      "end_seconds": 259.89,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.67,
      "end_seconds": 271.3,
      "duration_seconds": 2.63,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.59,
      "end_seconds": 290.8,
      "duration_seconds": 14.21,
      "text": "You can relax now. So where does that leave us? It fits best with a healthy adult with no worrying findings. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.03,
      "end_seconds": 298.02,
      "duration_seconds": 1.99,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.24,
      "end_seconds": 320.86,
      "duration_seconds": 21.62,
      "text": "I understand the worry. At the moment I'd say it's a healthy adult with no worrying findings, and we'll watch how it goes. Keep up regular exercise and a balanced diet. I'll want another look in twelve months. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.13,
      "end_seconds": 323.67,
      "duration_seconds": 1.54,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.87,
      "end_seconds": 326.11,
      "duration_seconds": 1.24,
      "text": "Goodbye for now."
    }
  ]
}