{
  "schema_version": "1.0",
  "encounter_id": "01490",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 3.75,
      "duration_seconds": 2.9,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 11.13,
      "duration_seconds": 6.12,
      "text": "So, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.09,
      "end_seconds": 20.59,
      "duration_seconds": 7.5,
      "text": "Honestly, it's my throat closing up, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.16,
      "end_seconds": 24.84,
      "duration_seconds": 2.68,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.71,
      "end_seconds": 26.9,
      "duration_seconds": 1.19,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.88,
      "end_seconds": 32.16,
      "duration_seconds": 3.28,
      "text": "Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.3,
      "end_seconds": 43.37,
      "duration_seconds": 10.07,
      "text": "It's been five days, I'm fairly sure. I've been putting this off for weeks. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.31,
      "end_seconds": 49.88,
      "duration_seconds": 4.57,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.8,
      "end_seconds": 56.33,
      "duration_seconds": 4.53,
      "text": "Honestly, every other day. I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.8,
      "end_seconds": 77.52,
      "duration_seconds": 3.72,
      "text": "And what about chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.15,
      "end_seconds": 81.95,
      "duration_seconds": 2.8,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.96,
      "end_seconds": 86.11,
      "duration_seconds": 2.15,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.6,
      "end_seconds": 89.29,
      "duration_seconds": 1.69,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.07,
      "end_seconds": 94.09,
      "duration_seconds": 4.02,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.9,
      "end_seconds": 98.56,
      "duration_seconds": 2.66,
      "text": "Ah, no, nothing at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.9,
      "end_seconds": 107.65,
      "duration_seconds": 3.75,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 113.31,
      "duration_seconds": 3.81,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.1,
      "end_seconds": 117.98,
      "duration_seconds": 2.88,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.6,
      "end_seconds": 124.32,
      "duration_seconds": 4.72,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.78,
      "end_seconds": 127.46,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.83,
      "end_seconds": 132.37,
      "duration_seconds": 3.54,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.02,
      "end_seconds": 152.63,
      "duration_seconds": 2.61,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.65,
      "end_seconds": 158.77,
      "duration_seconds": 5.12,
      "text": "I don't think I have any, um, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.36,
      "end_seconds": 162.6,
      "duration_seconds": 2.24,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.73,
      "end_seconds": 172.39,
      "duration_seconds": 2.66,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.5,
      "end_seconds": 192.82,
      "duration_seconds": 4.32,
      "text": "Okay: pressure 93 over 64, pulse 112, temperature 37.1."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.42,
      "end_seconds": 199.88,
      "duration_seconds": 4.46,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.71,
      "end_seconds": 204.22,
      "duration_seconds": 3.51,
      "text": "Alright, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.83,
      "end_seconds": 225.93,
      "duration_seconds": 6.1,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.44,
      "end_seconds": 232.28,
      "duration_seconds": 1.84,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.0,
      "end_seconds": 251.68,
      "duration_seconds": 9.68,
      "text": "Okay, thinking it through, this is probably anaphylaxis. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.23,
      "end_seconds": 294.8,
      "duration_seconds": 28.57,
      "text": "I'd like to arrange monitoring for anaphylaxis. I'm prescribing adrenaline, 0.5 milligrams, once now, single dose. That's for anaphylaxis. It's a commonly used medicine and most people tolerate it well. Lie flat with your legs raised, I am giving the injection now. We'll refer you to the emergency team. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.23,
      "end_seconds": 298.06,
      "duration_seconds": 1.83,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.09,
      "end_seconds": 303.49,
      "duration_seconds": 4.4,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.42,
      "end_seconds": 306.68,
      "duration_seconds": 2.26,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}