{
  "schema_version": "1.0",
  "encounter_id": "01434",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.06,
      "duration_seconds": 2.84,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.57,
      "end_seconds": 9.12,
      "duration_seconds": 4.55,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.06,
      "end_seconds": 17.84,
      "duration_seconds": 5.78,
      "text": "So the the thing is, I've got a sore stiff knee."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.14,
      "end_seconds": 24.54,
      "duration_seconds": 5.4,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.24,
      "end_seconds": 27.14,
      "duration_seconds": 1.9,
      "text": "it's every other day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.13,
      "end_seconds": 31.12,
      "duration_seconds": 1.99,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.66,
      "end_seconds": 48.32,
      "duration_seconds": 16.66,
      "text": "It usually comes with stiffness in the morning. And the knee giving way a little as well, since yesterday. The stiffness in the morning? That's been for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.22,
      "end_seconds": 53.86,
      "duration_seconds": 3.64,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.8,
      "end_seconds": 56.01,
      "duration_seconds": 1.21,
      "text": "Moderate, really"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.63,
      "end_seconds": 77.49,
      "duration_seconds": 3.86,
      "text": "Okay, have you had fall, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.12,
      "end_seconds": 81.01,
      "duration_seconds": 2.89,
      "text": "No, I haven't had any fall."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.8,
      "end_seconds": 86.56,
      "duration_seconds": 3.76,
      "text": "A few quick ones: locked knee, fever or redness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.07,
      "end_seconds": 91.46,
      "duration_seconds": 3.39,
      "text": "no, no locked knee, fever or redness"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 97.67,
      "duration_seconds": 2.46,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.18,
      "end_seconds": 102.41,
      "duration_seconds": 3.23,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.62,
      "end_seconds": 124.73,
      "duration_seconds": 6.11,
      "text": "do you have any chronic illnesses? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.52,
      "end_seconds": 130.8,
      "duration_seconds": 4.28,
      "text": "Arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.07,
      "end_seconds": 132.85,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.84,
      "end_seconds": 142.74,
      "duration_seconds": 7.9,
      "text": "I've got high cholesterol. I have heart disease, for two years. I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.21,
      "end_seconds": 144.91,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.23,
      "end_seconds": 167.93,
      "duration_seconds": 4.7,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.76,
      "end_seconds": 185.99,
      "duration_seconds": 13.23,
      "text": "I only drink at family occasions. I quit smoking around ten years ago. I'm a plumber, lots of bending and kneeling. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.72,
      "end_seconds": 193.48,
      "duration_seconds": 2.76,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.81,
      "end_seconds": 200.17,
      "duration_seconds": 5.36,
      "text": "Mm, yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.01,
      "end_seconds": 206.01,
      "duration_seconds": 4.0,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.66,
      "end_seconds": 220.72,
      "duration_seconds": 13.06,
      "text": "hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.23,
      "end_seconds": 223.37,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.78,
      "end_seconds": 233.68,
      "duration_seconds": 7.9,
      "text": "it's something called para... paracetamol, 650 milligrams, maybe, when needed for the knee pain"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.39,
      "end_seconds": 238.88,
      "duration_seconds": 4.49,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.6,
      "end_seconds": 259.33,
      "duration_seconds": 19.73,
      "text": "No, it's at home. Simvastatin, 20 milligrams, at night. I'm not great at remembering details, so bear with me. Sorry, I know I'm rambling a bit. I'm on thyroxine, 75 micrograms, every morning. Ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.87,
      "end_seconds": 265.15,
      "duration_seconds": 4.28,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.01,
      "end_seconds": 268.04,
      "duration_seconds": 1.03,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.51,
      "end_seconds": 272.69,
      "duration_seconds": 3.18,
      "text": "I'll listen to to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.99,
      "end_seconds": 295.48,
      "duration_seconds": 8.49,
      "text": "The joint line is tender, there is a bit of crunching, and the knee bends to ninety degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.89,
      "end_seconds": 332.67,
      "duration_seconds": 34.78,
      "text": "all finished, thank you let me tell you where I've got to it points towards knee osteoarthritis flare we shouldn't forget a meniscal tear i'd like to arrange an X-ray of the knee for knee pain strengthen the thigh muscles and lose a little weight if you can if you smoke, this is a good moment to think about stopping, and we can help you with that i'll also refer you to physiotherapy"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.37,
      "end_seconds": 347.88,
      "duration_seconds": 14.51,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.65,
      "end_seconds": 351.53,
      "duration_seconds": 2.88,
      "text": "no, that's all thanks a lot"
    }
  ]
}