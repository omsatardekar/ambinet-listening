{
  "schema_version": "1.0",
  "encounter_id": "01472",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 3.26,
      "duration_seconds": 2.42,
      "text": "So, morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.04,
      "end_seconds": 7.99,
      "duration_seconds": 2.95,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.99,
      "end_seconds": 14.61,
      "duration_seconds": 4.62,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.6,
      "end_seconds": 17.44,
      "duration_seconds": 1.84,
      "text": "Did you come far?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.4,
      "end_seconds": 24.19,
      "duration_seconds": 5.79,
      "text": "actually, um, not too far, about half an hour by bus"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.46,
      "end_seconds": 28.43,
      "duration_seconds": 2.97,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.74,
      "end_seconds": 35.69,
      "duration_seconds": 5.95,
      "text": "yeah, it's a painful widespread rash i don't know what's causing it"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 36.62,
      "end_seconds": 45.98,
      "duration_seconds": 9.36,
      "text": "Okay, so the vitals from earlier. Pulse is 98 beats a minute, temperature is 38.0 degrees, BP is 118 over 77."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.35,
      "end_seconds": 48.34,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.02,
      "end_seconds": 68.93,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.42,
      "end_seconds": 72.95,
      "duration_seconds": 2.53,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.4,
      "end_seconds": 83.62,
      "duration_seconds": 9.22,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.39,
      "end_seconds": 89.85,
      "duration_seconds": 5.46,
      "text": "it happens every other day. Pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.12,
      "end_seconds": 93.28,
      "duration_seconds": 2.16,
      "text": "have you had a fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.18,
      "end_seconds": 104.59,
      "duration_seconds": 8.41,
      "text": "Yes, actually. Uh, I did have sores in my mouth at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.0,
      "end_seconds": 115.2,
      "duration_seconds": 3.2,
      "text": "And what about new medicine or insect bite?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.63,
      "end_seconds": 120.78,
      "duration_seconds": 4.15,
      "text": "No new medicine or insect bite, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 125.61,
      "duration_seconds": 3.36,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.5,
      "end_seconds": 129.41,
      "duration_seconds": 1.91,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.62,
      "end_seconds": 135.56,
      "duration_seconds": 4.94,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.38,
      "end_seconds": 139.09,
      "duration_seconds": 1.71,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.95,
      "end_seconds": 143.33,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.2,
      "end_seconds": 149.56,
      "duration_seconds": 4.36,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.52,
      "end_seconds": 152.08,
      "duration_seconds": 1.56,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.7,
      "end_seconds": 155.03,
      "duration_seconds": 2.33,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.97,
      "end_seconds": 158.57,
      "duration_seconds": 2.6,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.43,
      "end_seconds": 163.41,
      "duration_seconds": 3.98,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.66,
      "end_seconds": 184.97,
      "duration_seconds": 3.31,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.95,
      "end_seconds": 194.89,
      "duration_seconds": 8.94,
      "text": "I've had thin bones for nearly five years now. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.47,
      "end_seconds": 197.89,
      "duration_seconds": 1.42,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.25,
      "end_seconds": 206.62,
      "duration_seconds": 7.37,
      "text": "Yes, an enlarged prostate. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.13,
      "end_seconds": 209.83,
      "duration_seconds": 1.7,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.8,
      "end_seconds": 214.3,
      "duration_seconds": 3.5,
      "text": "I've had high blood pressure, yes"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.25,
      "end_seconds": 215.95,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.68,
      "end_seconds": 220.27,
      "duration_seconds": 2.59,
      "text": "I've had heart disease, yes"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.88,
      "end_seconds": 230.39,
      "duration_seconds": 9.51,
      "text": "okay, I can see an enlarged prostate in your file as well which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.49,
      "end_seconds": 238.48,
      "duration_seconds": 6.99,
      "text": "Erm, I take alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.89,
      "end_seconds": 239.98,
      "duration_seconds": 1.09,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.55,
      "end_seconds": 259.08,
      "duration_seconds": 18.53,
      "text": "Mm, it's tamsulosin, 0.4 milligrams, at night. Telmisartan. I take it 40 milligrams, once a day for my pressure. It's something called aspi... aspirin, 75 milligrams, maybe, once a day for my heart."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.99,
      "end_seconds": 263.3,
      "duration_seconds": 3.31,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.08,
      "end_seconds": 273.45,
      "duration_seconds": 9.37,
      "text": "Right, not with me. I'll bring it it next time. I'd been on metoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.0,
      "end_seconds": 278.05,
      "duration_seconds": 4.05,
      "text": "So, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.92,
      "end_seconds": 281.03,
      "duration_seconds": 2.11,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.56,
      "end_seconds": 286.96,
      "duration_seconds": 3.4,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.7,
      "end_seconds": 290.56,
      "duration_seconds": 1.86,
      "text": "okay, breathe out slowly"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.26,
      "end_seconds": 312.78,
      "duration_seconds": 6.52,
      "text": "There are dusky red patches with blistering and the skin peels when I rub it lightly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.19,
      "end_seconds": 337.91,
      "duration_seconds": 20.72,
      "text": "All finished, thank you. Let me tell you where I've got to. This is probably a severe drug reaction of the skin. The reason I say that is that your story and my examination fit together. It could also be a viral rash, so we'll keep that open."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.35,
      "end_seconds": 342.31,
      "duration_seconds": 2.96,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.0,
      "end_seconds": 359.26,
      "duration_seconds": 16.26,
      "text": "It's reasonable to be concerned, but right now a severe drug reaction of the skin is my leading thought, not anything worse. I'm sending you for an urgent dermatology review because of severe drug reaction."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.23,
      "end_seconds": 363.8,
      "duration_seconds": 2.57,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.55,
      "end_seconds": 394.6,
      "duration_seconds": 29.05,
      "text": "Let's book blood tests to look into severe drug reaction. Stop the antibiotic now and I am sending you to hospital immediately. Let's get you seen by the dermatology team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.25,
      "end_seconds": 397.84,
      "duration_seconds": 2.59,
      "text": "mm, thank you, doctor, goodbye"
    }
  ]
}