{
  "schema_version": "1.0",
  "encounter_id": "01217",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 3.96,
      "duration_seconds": 3.45,
      "text": "hello, good to see you. Please sit"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.46,
      "end_seconds": 8.48,
      "duration_seconds": 3.02,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.41,
      "end_seconds": 12.66,
      "duration_seconds": 2.25,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.59,
      "end_seconds": 22.55,
      "duration_seconds": 7.96,
      "text": "So, um, I wanted to to get I can't get my breath looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.84,
      "end_seconds": 25.9,
      "duration_seconds": 2.06,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.54,
      "end_seconds": 31.8,
      "duration_seconds": 5.26,
      "text": "Asthalin inhaler. I take it it when needed for my asthma."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.55,
      "end_seconds": 34.48,
      "duration_seconds": 1.93,
      "text": "So, since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.02,
      "end_seconds": 44.24,
      "duration_seconds": 3.22,
      "text": "well, it's been two months now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.26,
      "end_seconds": 55.91,
      "duration_seconds": 9.65,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.55,
      "end_seconds": 68.28,
      "duration_seconds": 11.73,
      "text": "Honestly, a couple of times a week. Pretty mild, if I'm being honest. And not being able to finish a sentence, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.1,
      "end_seconds": 91.02,
      "duration_seconds": 3.92,
      "text": "Have you noticed blue tinge or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.18,
      "end_seconds": 96.72,
      "duration_seconds": 4.54,
      "text": "Hmm, no, no blue tinge or chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.76,
      "end_seconds": 99.01,
      "duration_seconds": 1.25,
      "text": "how about fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.01,
      "end_seconds": 103.52,
      "duration_seconds": 3.51,
      "text": "Well, no, I haven't had any fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.27,
      "end_seconds": 108.88,
      "duration_seconds": 4.61,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.7,
      "end_seconds": 111.81,
      "duration_seconds": 2.11,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.41,
      "end_seconds": 115.77,
      "duration_seconds": 3.36,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.87,
      "end_seconds": 120.7,
      "duration_seconds": 2.83,
      "text": "Erm, no, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.15,
      "end_seconds": 123.83,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.39,
      "end_seconds": 127.81,
      "duration_seconds": 3.42,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.04,
      "end_seconds": 131.51,
      "duration_seconds": 2.47,
      "text": "okay, do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.85,
      "end_seconds": 137.21,
      "duration_seconds": 4.36,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.71,
      "end_seconds": 152.3,
      "duration_seconds": 4.59,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.42,
      "end_seconds": 158.66,
      "duration_seconds": 5.24,
      "text": "Actually, you know, yes, walnuts, it gives me hives."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.28,
      "end_seconds": 176.79,
      "duration_seconds": 2.51,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.59,
      "end_seconds": 187.05,
      "duration_seconds": 8.46,
      "text": "Ah, I have asthma. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.26,
      "end_seconds": 191.65,
      "duration_seconds": 3.39,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 193.05,
      "end_seconds": 201.7,
      "duration_seconds": 8.65,
      "text": "Okay, so so the vitals from earlier. Pulse 97, respiratory rate 26, saturation 94 percent. BP is 122 over 84."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.09,
      "end_seconds": 203.79,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 209.74,
      "duration_seconds": 4.12,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.09,
      "end_seconds": 213.1,
      "duration_seconds": 2.01,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.96,
      "end_seconds": 228.51,
      "duration_seconds": 5.55,
      "text": "you are using your neck muscles to breathe, and your oxygen is low"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.53,
      "end_seconds": 234.3,
      "duration_seconds": 1.77,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.17,
      "end_seconds": 273.71,
      "duration_seconds": 30.54,
      "text": "So where does that leave us? I can't pin this down yet. We're looking at a severe asthma attack or a chest infection. I'm sending you for a chest X-ray cos of severe breathlessness. Let's use prednisolone, 40 milligrams, once now, single dose. You take it by mouth. That should help with asthma attack. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.14,
      "end_seconds": 294.19,
      "duration_seconds": 16.05,
      "text": "Sit upright and take slow breaths while the nebuliser is set up. I'd like you to see the emergency team as well, and I'll write the referral. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.03,
      "end_seconds": 298.44,
      "duration_seconds": 3.41,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.12,
      "end_seconds": 300.53,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}