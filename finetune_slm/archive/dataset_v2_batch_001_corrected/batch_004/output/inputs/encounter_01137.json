{
  "schema_version": "1.0",
  "encounter_id": "01137",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 8.54,
      "duration_seconds": 7.66,
      "text": "Uh, you know, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.66,
      "end_seconds": 14.26,
      "duration_seconds": 4.6,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.32,
      "end_seconds": 23.97,
      "duration_seconds": 7.65,
      "text": "Oh, it's my throat closing up. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.51,
      "end_seconds": 28.66,
      "duration_seconds": 3.15,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.91,
      "end_seconds": 40.55,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.82,
      "end_seconds": 69.14,
      "duration_seconds": 9.32,
      "text": "Okay: pulse is 108 beats a minute, pressure 92 over 62, oxygen saturation is 99 percent. And temperature 36.6, respiratory rate 16."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 72.04,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.62,
      "end_seconds": 81.85,
      "duration_seconds": 4.23,
      "text": "I'll interpret them after the examination. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.1,
      "end_seconds": 84.54,
      "duration_seconds": 1.44,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.05,
      "end_seconds": 96.13,
      "duration_seconds": 10.08,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.41,
      "end_seconds": 110.3,
      "duration_seconds": 12.89,
      "text": "It comes and goes. I'd give it a four, out of ten. I mean, and I've been feeling faint as well, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.88,
      "end_seconds": 131.69,
      "duration_seconds": 3.81,
      "text": "Any chest pain or recent illness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.79,
      "end_seconds": 135.62,
      "duration_seconds": 2.83,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.88,
      "end_seconds": 139.92,
      "duration_seconds": 4.04,
      "text": "Okay, go on. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.82,
      "end_seconds": 142.84,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.43,
      "end_seconds": 147.84,
      "duration_seconds": 4.41,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.76,
      "end_seconds": 151.68,
      "duration_seconds": 2.92,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 168.3,
      "duration_seconds": 3.27,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.3,
      "end_seconds": 175.58,
      "duration_seconds": 5.28,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.83,
      "end_seconds": 178.41,
      "duration_seconds": 1.58,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.14,
      "end_seconds": 181.84,
      "duration_seconds": 2.7,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.99,
      "end_seconds": 199.23,
      "duration_seconds": 3.24,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.05,
      "end_seconds": 206.7,
      "duration_seconds": 5.65,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.1,
      "end_seconds": 222.96,
      "duration_seconds": 2.86,
      "text": "Okay, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.32,
      "end_seconds": 227.12,
      "duration_seconds": 2.8,
      "text": "Nothing regular, um, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.3,
      "end_seconds": 233.43,
      "duration_seconds": 5.13,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.26,
      "end_seconds": 237.89,
      "duration_seconds": 3.63,
      "text": "So, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.61,
      "end_seconds": 259.99,
      "duration_seconds": 7.38,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.63,
      "end_seconds": 277.65,
      "duration_seconds": 12.02,
      "text": "Thank you, you can get dressed. Right, here's what I'm thinking. I don't have a clear answer today: anaphylaxis is possible, and so is a severe allergic reaction."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.4,
      "end_seconds": 281.62,
      "duration_seconds": 3.22,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.89,
      "end_seconds": 301.05,
      "duration_seconds": 18.16,
      "text": "I can't promise yet, but most people with anaphylaxis do well once it's treated properly. Let me repeat that back to make sure. You've had your throat closing up, yesterday, and no chest pain or recent illness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.2,
      "end_seconds": 302.9,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.93,
      "end_seconds": 326.36,
      "duration_seconds": 22.43,
      "text": "I want monitoring done, that's for anaphylaxis. The result will help us decide whether anything more is needed. The treatment will be adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.57,
      "end_seconds": 331.24,
      "duration_seconds": 4.67,
      "text": "I follow. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.26,
      "end_seconds": 333.96,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.9,
      "end_seconds": 340.95,
      "duration_seconds": 5.05,
      "text": "If the symptoms return, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.72,
      "end_seconds": 344.4,
      "duration_seconds": 1.68,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.38,
      "end_seconds": 350.84,
      "duration_seconds": 4.46,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.82,
      "end_seconds": 356.34,
      "duration_seconds": 3.52,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.95,
      "end_seconds": 358.14,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
}