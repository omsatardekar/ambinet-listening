{
  "schema_version": "1.0",
  "encounter_id": "01157",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.06,
      "duration_seconds": 4.2,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.75,
      "end_seconds": 10.49,
      "duration_seconds": 3.74,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.73,
      "end_seconds": 19.94,
      "duration_seconds": 8.21,
      "text": "I mean, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.52,
      "end_seconds": 25.09,
      "duration_seconds": 3.57,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.21,
      "end_seconds": 33.69,
      "duration_seconds": 5.48,
      "text": "So, I wanted to get sores in my mouth looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.7,
      "end_seconds": 37.83,
      "duration_seconds": 3.13,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.06,
      "end_seconds": 42.14,
      "duration_seconds": 3.08,
      "text": "I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 43.87,
      "end_seconds": 49.83,
      "duration_seconds": 5.96,
      "text": "Okay, so I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.66,
      "end_seconds": 56.34,
      "duration_seconds": 4.68,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.52,
      "end_seconds": 60.69,
      "duration_seconds": 3.17,
      "text": "I, I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.35,
      "end_seconds": 64.48,
      "duration_seconds": 2.13,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.04,
      "end_seconds": 72.26,
      "duration_seconds": 6.22,
      "text": "Sore red eyes goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.73,
      "end_seconds": 79.44,
      "duration_seconds": 6.71,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 79.54,
      "end_seconds": 85.82,
      "duration_seconds": 6.28,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.97,
      "end_seconds": 89.44,
      "duration_seconds": 2.47,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.8,
      "end_seconds": 105.65,
      "duration_seconds": 14.85,
      "text": "Right, the sore red eyes? That's been for six months. Uh, with sore red eyes, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.15,
      "end_seconds": 112.83,
      "duration_seconds": 6.68,
      "text": "Have you had sores in your mouth before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.36,
      "end_seconds": 122.74,
      "duration_seconds": 9.38,
      "text": "Yes, you know, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.51,
      "end_seconds": 127.86,
      "duration_seconds": 3.35,
      "text": "And what about insect bite or new medicine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.0,
      "end_seconds": 142.3,
      "duration_seconds": 13.3,
      "text": "No, um, no insect bite, no new medicine. I did have a fever at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.56,
      "end_seconds": 150.71,
      "duration_seconds": 2.15,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.3,
      "end_seconds": 153.37,
      "duration_seconds": 2.07,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.76,
      "end_seconds": 158.13,
      "duration_seconds": 3.37,
      "text": "So, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.81,
      "end_seconds": 167.39,
      "duration_seconds": 7.58,
      "text": "I've had epilepsy for five years now. Thin bones, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.24,
      "end_seconds": 169.56,
      "duration_seconds": 1.32,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.97,
      "end_seconds": 178.89,
      "duration_seconds": 7.92,
      "text": "I have depression, for five years. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.89,
      "end_seconds": 184.07,
      "duration_seconds": 3.18,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.28,
      "end_seconds": 196.69,
      "duration_seconds": 11.41,
      "text": "Let me think, I'm on levetiracetam, 500 milligrams, twice a day. It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.03,
      "end_seconds": 197.83,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.0,
      "end_seconds": 204.04,
      "duration_seconds": 5.04,
      "text": "Let me think, I take mirtazapine, at night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.63,
      "end_seconds": 208.04,
      "duration_seconds": 2.41,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.41,
      "end_seconds": 214.8,
      "duration_seconds": 5.39,
      "text": "15 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.16,
      "end_seconds": 217.57,
      "duration_seconds": 1.41,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.32,
      "end_seconds": 226.68,
      "duration_seconds": 8.36,
      "text": "Two years now. It's, It's a new antibiotic, 960 milligrams, twice a day for a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.27,
      "end_seconds": 229.67,
      "duration_seconds": 2.4,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.1,
      "end_seconds": 236.11,
      "duration_seconds": 5.01,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.17,
      "end_seconds": 241.75,
      "duration_seconds": 3.58,
      "text": "Right, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.81,
      "end_seconds": 249.2,
      "duration_seconds": 5.39,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.27,
      "end_seconds": 260.91,
      "duration_seconds": 2.64,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.84,
      "end_seconds": 267.88,
      "duration_seconds": 5.04,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.03,
      "end_seconds": 271.02,
      "duration_seconds": 1.99,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.67,
      "end_seconds": 275.27,
      "duration_seconds": 2.6,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 276.43,
      "end_seconds": 289.43,
      "duration_seconds": 13.0,
      "text": "Here are the numbers, doctor. SpO2 96 percent on room air, BP is 125 over 79. Respiratory rate 18, pulse is 92 beats a minute, temperature 38.4."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.32,
      "end_seconds": 291.22,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.99,
      "end_seconds": 297.43,
      "duration_seconds": 3.44,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.6,
      "end_seconds": 300.95,
      "duration_seconds": 2.35,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.28,
      "end_seconds": 320.1,
      "duration_seconds": 7.82,
      "text": "There are dusky red patches with blistering and the skin peels when I rub it lightly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.63,
      "end_seconds": 341.28,
      "duration_seconds": 18.65,
      "text": "Please sit back down. Okay, so my impression is this: This is probably a severe drug reaction of the skin. I want to be honest that this is an impression, not a final answer. A viral rash is still possible."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.08,
      "end_seconds": 346.57,
      "duration_seconds": 3.49,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.61,
      "end_seconds": 367.46,
      "duration_seconds": 18.85,
      "text": "It's reasonable to be concerned, but right now a severe drug reaction of the skin is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had sores in your mouth, and no insect bite or new medicine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.19,
      "end_seconds": 370.82,
      "duration_seconds": 1.63,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.84,
      "end_seconds": 413.57,
      "duration_seconds": 24.73,
      "text": "I want an urgent dermatology review done, that's for severe drug reaction. I want blood tests done, that's for severe drug reaction. Stop the antibiotic now and I am sending you to hospital immediately. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I think the dermatology team should see you too."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.66,
      "end_seconds": 417.35,
      "duration_seconds": 2.69,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.66,
      "end_seconds": 421.58,
      "duration_seconds": 2.92,
      "text": "Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.25,
      "end_seconds": 427.82,
      "duration_seconds": 2.57,
      "text": "That's clear, uh, thanks."
    }
  ]
}