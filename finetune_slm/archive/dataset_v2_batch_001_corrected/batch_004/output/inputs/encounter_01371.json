{
  "schema_version": "1.0",
  "encounter_id": "01371",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.49,
      "duration_seconds": 3.44,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 9.7,
      "duration_seconds": 3.94,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.11,
      "end_seconds": 13.29,
      "duration_seconds": 2.18,
      "text": "I've been feeling well."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.52,
      "end_seconds": 17.25,
      "duration_seconds": 2.73,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.86,
      "end_seconds": 24.19,
      "duration_seconds": 5.33,
      "text": "Three weeks, I think... sorry, four weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.98,
      "end_seconds": 27.8,
      "duration_seconds": 2.82,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.33,
      "end_seconds": 30.35,
      "duration_seconds": 1.02,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.0,
      "end_seconds": 35.52,
      "duration_seconds": 3.52,
      "text": "Any palpitations, constipation, feeling cold or weight change?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.31,
      "end_seconds": 40.45,
      "duration_seconds": 4.14,
      "text": "Um, no, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.02,
      "end_seconds": 43.57,
      "duration_seconds": 2.55,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.26,
      "end_seconds": 48.2,
      "duration_seconds": 2.94,
      "text": "Uh, no, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.56,
      "end_seconds": 51.91,
      "duration_seconds": 2.35,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.16,
      "end_seconds": 54.08,
      "duration_seconds": 0.92,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.04,
      "end_seconds": 62.09,
      "duration_seconds": 3.05,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 68.23,
      "duration_seconds": 4.61,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.13,
      "end_seconds": 74.28,
      "duration_seconds": 4.15,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.39,
      "end_seconds": 78.25,
      "duration_seconds": 2.86,
      "text": "Actually, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.29,
      "end_seconds": 82.78,
      "duration_seconds": 2.49,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.94,
      "end_seconds": 85.0,
      "duration_seconds": 1.06,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.57,
      "end_seconds": 89.63,
      "duration_seconds": 4.06,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.77,
      "end_seconds": 92.19,
      "duration_seconds": 1.42,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.47,
      "end_seconds": 109.84,
      "duration_seconds": 3.37,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 113.53,
      "duration_seconds": 2.67,
      "text": "No, um, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.54,
      "end_seconds": 128.82,
      "duration_seconds": 2.28,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.66,
      "end_seconds": 134.54,
      "duration_seconds": 3.88,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.39,
      "end_seconds": 137.76,
      "duration_seconds": 1.37,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.24,
      "end_seconds": 145.68,
      "duration_seconds": 3.44,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.24,
      "end_seconds": 149.9,
      "duration_seconds": 2.66,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.89,
      "end_seconds": 161.08,
      "duration_seconds": 2.19,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.19,
      "end_seconds": 183.37,
      "duration_seconds": 9.18,
      "text": "Okay: pulse is 80 beats a minute, saturation 98 percent, respiratory rate 15, pressure 122 over 68, temperature 36.6."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.05,
      "end_seconds": 186.69,
      "duration_seconds": 1.64,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.96,
      "end_seconds": 191.56,
      "duration_seconds": 3.6,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.81,
      "end_seconds": 194.87,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.56,
      "end_seconds": 199.99,
      "duration_seconds": 3.43,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.22,
      "end_seconds": 221.24,
      "duration_seconds": 5.02,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.55,
      "end_seconds": 228.14,
      "duration_seconds": 1.59,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.59,
      "end_seconds": 267.22,
      "duration_seconds": 23.63,
      "text": "So where does that leave us? It points towards well-controlled thyroid replacement. I want to be honest that this is an impression, not a final answer. Let me just check I've got this right. You've been feeling well for four weeks, severe, and no feeling cold or palpitations."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.13,
      "end_seconds": 269.83,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.77,
      "end_seconds": 292.64,
      "duration_seconds": 4.87,
      "text": "I'm going to order a thyroid blood test, for annual review."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.52,
      "end_seconds": 297.83,
      "duration_seconds": 3.31,
      "text": "Okay, uh, I'll do it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.08,
      "end_seconds": 306.77,
      "duration_seconds": 7.69,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee. Let's plan a check in twelve months."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.83,
      "end_seconds": 311.23,
      "duration_seconds": 3.4,
      "text": "Uh, good, I'll return then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.39,
      "end_seconds": 314.8,
      "duration_seconds": 2.41,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.14,
      "end_seconds": 318.17,
      "duration_seconds": 2.03,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}