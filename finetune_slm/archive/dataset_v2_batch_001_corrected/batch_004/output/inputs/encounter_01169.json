{
  "schema_version": "1.0",
  "encounter_id": "01169",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 3.07,
      "duration_seconds": 1.76,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.73,
      "end_seconds": 6.94,
      "duration_seconds": 3.21,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.21,
      "end_seconds": 14.81,
      "duration_seconds": 6.6,
      "text": "good afternoon, doctor i look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.13,
      "end_seconds": 18.83,
      "duration_seconds": 2.7,
      "text": "you came on your own today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.82,
      "end_seconds": 22.97,
      "duration_seconds": 3.15,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.57,
      "end_seconds": 26.24,
      "duration_seconds": 1.67,
      "text": "where shall we begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.99,
      "end_seconds": 32.28,
      "duration_seconds": 4.29,
      "text": "It's sharp pain when I breathe in, mostly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.07,
      "end_seconds": 36.33,
      "duration_seconds": 3.26,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.84,
      "end_seconds": 44.64,
      "duration_seconds": 6.8,
      "text": "I'm on lamotrigine, 100 milligrams, twice a day. Eltroxin. I take it every morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.69,
      "end_seconds": 48.83,
      "duration_seconds": 2.14,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.49,
      "end_seconds": 63.63,
      "duration_seconds": 14.14,
      "text": "100 micrograms, I think that's what's on the box. Spironolactone. I take it 25 milligrams, once a day for my heart. Aspirin. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.36,
      "end_seconds": 74.79,
      "duration_seconds": 3.43,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.47,
      "end_seconds": 78.98,
      "duration_seconds": 3.51,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.79,
      "end_seconds": 81.77,
      "duration_seconds": 1.98,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.47,
      "end_seconds": 91.56,
      "duration_seconds": 8.09,
      "text": "It's worse with deep breaths. I've also been coughing up a little blood, since Friday."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.23,
      "end_seconds": 104.01,
      "duration_seconds": 3.78,
      "text": "So, did you get chest tightness, fever or wheeze?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.3,
      "end_seconds": 107.75,
      "duration_seconds": 2.45,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.77,
      "end_seconds": 112.54,
      "duration_seconds": 2.77,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.06,
      "end_seconds": 118.03,
      "duration_seconds": 3.97,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.22,
      "end_seconds": 123.27,
      "duration_seconds": 4.05,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.14,
      "end_seconds": 139.99,
      "duration_seconds": 15.85,
      "text": "Epilepsy, for nearly five years i didn't want to bother you but it keeps coming back it's the not knowing that gets to me i have an underactive thyroid"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.03,
      "end_seconds": 147.31,
      "duration_seconds": 1.28,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.56,
      "end_seconds": 151.92,
      "duration_seconds": 3.36,
      "text": "I have heart failure, for two years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.56,
      "end_seconds": 153.26,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.2,
      "end_seconds": 157.15,
      "duration_seconds": 1.95,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.96,
      "end_seconds": 159.23,
      "duration_seconds": 1.27,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.81,
      "end_seconds": 169.65,
      "duration_seconds": 9.84,
      "text": "Right, so epilepsy and an underactive thyroid are already on your record. We'll keep that in mind today. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.25,
      "end_seconds": 183.74,
      "duration_seconds": 11.49,
      "text": "Not much, I mostly stay in these days. Lots of rice, lentils and some fruit. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.5,
      "end_seconds": 205.23,
      "duration_seconds": 3.73,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.17,
      "end_seconds": 210.09,
      "duration_seconds": 2.92,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.87,
      "end_seconds": 213.61,
      "duration_seconds": 2.74,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.16,
      "end_seconds": 219.94,
      "duration_seconds": 4.78,
      "text": "just two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 224.07,
      "duration_seconds": 2.98,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.49,
      "end_seconds": 234.95,
      "duration_seconds": 2.46,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.12,
      "end_seconds": 257.46,
      "duration_seconds": 12.34,
      "text": "Okay: temp 37.4 degrees, respiratory rate 20, pulse is 94 beats a minute. And pressure 123 over 73, SpO2 92 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.47,
      "end_seconds": 260.83,
      "duration_seconds": 2.36,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.06,
      "end_seconds": 268.49,
      "duration_seconds": 3.43,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.89,
      "end_seconds": 272.7,
      "duration_seconds": 2.81,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.68,
      "end_seconds": 276.07,
      "duration_seconds": 1.39,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.98,
      "end_seconds": 292.97,
      "duration_seconds": 5.99,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.58,
      "end_seconds": 302.38,
      "duration_seconds": 6.8,
      "text": "Okay, that's enough for me. I want a D-dimer blood test done, that's for possible clot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.06,
      "end_seconds": 305.15,
      "duration_seconds": 2.09,
      "text": "Right, uh, understood."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.77,
      "end_seconds": 309.82,
      "duration_seconds": 4.05,
      "text": "you need to go to hospital now for a scan"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.33,
      "end_seconds": 314.37,
      "duration_seconds": 4.04,
      "text": "Ah. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.96,
      "end_seconds": 318.65,
      "duration_seconds": 3.69,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.21,
      "end_seconds": 320.56,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}