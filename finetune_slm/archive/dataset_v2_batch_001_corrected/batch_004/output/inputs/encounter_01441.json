{
  "schema_version": "1.0",
  "encounter_id": "01441",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 3.84,
      "duration_seconds": 2.94,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.26,
      "end_seconds": 9.77,
      "duration_seconds": 4.51,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.22,
      "end_seconds": 17.11,
      "duration_seconds": 5.89,
      "text": "Doctor, it's a runny nose. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.94,
      "end_seconds": 20.92,
      "duration_seconds": 2.98,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.56,
      "end_seconds": 29.91,
      "duration_seconds": 3.35,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.75,
      "end_seconds": 34.05,
      "duration_seconds": 3.3,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.81,
      "end_seconds": 46.65,
      "duration_seconds": 10.84,
      "text": "Hmm, it settles a little with tissues. Oh, and a mild cough. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.23,
      "end_seconds": 50.6,
      "duration_seconds": 3.37,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.15,
      "end_seconds": 61.5,
      "duration_seconds": 2.35,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.26,
      "end_seconds": 84.78,
      "duration_seconds": 5.52,
      "text": "Okay: oxygen saturation is 99 percent, BP is 119 over 77, pulse 82."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.83,
      "end_seconds": 88.46,
      "duration_seconds": 2.63,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.64,
      "end_seconds": 92.45,
      "duration_seconds": 2.81,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.59,
      "end_seconds": 105.97,
      "duration_seconds": 4.38,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.74,
      "end_seconds": 112.29,
      "duration_seconds": 1.55,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.88,
      "end_seconds": 128.36,
      "duration_seconds": 5.48,
      "text": "Did you get shortness of breath, chest pain, ear pain or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.88,
      "end_seconds": 131.8,
      "duration_seconds": 1.92,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.34,
      "end_seconds": 135.96,
      "duration_seconds": 3.62,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.75,
      "end_seconds": 139.53,
      "duration_seconds": 2.78,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.17,
      "end_seconds": 146.86,
      "duration_seconds": 3.69,
      "text": "Right, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.22,
      "end_seconds": 149.75,
      "duration_seconds": 1.53,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.58,
      "end_seconds": 156.58,
      "duration_seconds": 5.0,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.11,
      "end_seconds": 163.98,
      "duration_seconds": 3.87,
      "text": "Yes, walnuts. I get my lips swelling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.9,
      "end_seconds": 166.34,
      "duration_seconds": 1.44,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.65,
      "end_seconds": 175.54,
      "duration_seconds": 3.89,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.49,
      "end_seconds": 180.25,
      "duration_seconds": 2.76,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.64,
      "end_seconds": 184.78,
      "duration_seconds": 3.14,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.29,
      "end_seconds": 189.39,
      "duration_seconds": 3.1,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.92,
      "end_seconds": 195.55,
      "duration_seconds": 4.63,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 199.0,
      "duration_seconds": 2.34,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.21,
      "end_seconds": 204.71,
      "duration_seconds": 4.5,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.43,
      "end_seconds": 207.69,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.22,
      "end_seconds": 212.62,
      "duration_seconds": 3.4,
      "text": "So, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.8,
      "end_seconds": 226.09,
      "duration_seconds": 4.29,
      "text": "So, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.26,
      "end_seconds": 230.07,
      "duration_seconds": 2.81,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.21,
      "end_seconds": 234.78,
      "duration_seconds": 3.57,
      "text": "Alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.69,
      "end_seconds": 237.71,
      "duration_seconds": 2.02,
      "text": "Throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.54,
      "end_seconds": 254.98,
      "duration_seconds": 3.44,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.02,
      "end_seconds": 259.57,
      "duration_seconds": 2.55,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.04,
      "end_seconds": 287.28,
      "duration_seconds": 16.24,
      "text": "So where does that leave us? My working impression is a simple viral cold. The reason I say that is that your story and my examination fit together. Rest, plenty of fluids, and paracetamol if you ache."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.57,
      "end_seconds": 297.82,
      "duration_seconds": 10.25,
      "text": "I follow. If you develop a high fever or trouble breathing, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.17,
      "end_seconds": 303.52,
      "duration_seconds": 1.35,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.01,
      "end_seconds": 316.91,
      "duration_seconds": 9.9,
      "text": "Book a review if it is not better in ten days. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.23,
      "end_seconds": 323.54,
      "duration_seconds": 3.31,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}