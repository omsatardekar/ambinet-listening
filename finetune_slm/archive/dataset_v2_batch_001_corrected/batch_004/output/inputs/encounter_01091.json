{
  "schema_version": "1.0",
  "encounter_id": "01091",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 3.93,
      "duration_seconds": 3.26,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.75,
      "end_seconds": 8.73,
      "duration_seconds": 3.98,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.41,
      "end_seconds": 20.23,
      "duration_seconds": 10.82,
      "text": "I mean, honestly, it's pain on the outside of my elbow, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 24.52,
      "duration_seconds": 2.87,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.3,
      "end_seconds": 31.81,
      "duration_seconds": 6.51,
      "text": "Probably one week. Yeah. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.84,
      "end_seconds": 44.18,
      "duration_seconds": 10.34,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.71,
      "end_seconds": 58.36,
      "duration_seconds": 12.65,
      "text": "Only rest, and it's not much. Honestly, a couple of times a week. There was a weaker grip, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.83,
      "end_seconds": 77.19,
      "duration_seconds": 2.36,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.95,
      "end_seconds": 88.42,
      "duration_seconds": 10.47,
      "text": "Mm, I take iron tablets, once a day for my blood count. I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.11,
      "end_seconds": 100.76,
      "duration_seconds": 2.65,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.33,
      "end_seconds": 113.85,
      "duration_seconds": 11.52,
      "text": "Just a mole taken off my arm, a few years ago. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.51,
      "end_seconds": 118.39,
      "duration_seconds": 2.88,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.97,
      "end_seconds": 135.66,
      "duration_seconds": 15.69,
      "text": "I used to drink heavily but I stopped four years ago. I work in accounts at a hospital. My partner and our baby. I swim twice a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.51,
      "end_seconds": 139.08,
      "duration_seconds": 2.57,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.34,
      "end_seconds": 151.02,
      "duration_seconds": 10.68,
      "text": "Hmm, yes, diclofenac. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.37,
      "end_seconds": 155.98,
      "duration_seconds": 3.61,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.86,
      "end_seconds": 162.08,
      "duration_seconds": 5.22,
      "text": "Low haemoglobin, for about ten years. I've got thin bones."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.81,
      "end_seconds": 170.04,
      "duration_seconds": 7.23,
      "text": "Alright, low haemoglobin and thin bones, that matches what I have here. So, what about swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.55,
      "end_seconds": 174.36,
      "duration_seconds": 2.81,
      "text": "Nope, you know, no swelling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.23,
      "end_seconds": 179.38,
      "duration_seconds": 3.15,
      "text": "A few quick ones: numbness or neck pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.18,
      "end_seconds": 184.24,
      "duration_seconds": 4.06,
      "text": "No numbness or neck pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.89,
      "end_seconds": 188.69,
      "duration_seconds": 3.8,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.83,
      "end_seconds": 191.39,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.49,
      "end_seconds": 194.77,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.42,
      "end_seconds": 206.73,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.39,
      "end_seconds": 235.59,
      "duration_seconds": 7.2,
      "text": "Okay: respiratory rate 15, blood pressure 118 over 76. And pulse 71, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.84,
      "end_seconds": 239.53,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.18,
      "end_seconds": 243.64,
      "duration_seconds": 3.46,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.63,
      "end_seconds": 250.78,
      "duration_seconds": 4.15,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 255.27,
      "duration_seconds": 3.4,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.69,
      "end_seconds": 273.31,
      "duration_seconds": 7.62,
      "text": "It's tender over the bony point on the outside, and it hurts when I resist your wrist going up."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.64,
      "end_seconds": 286.25,
      "duration_seconds": 1.61,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 310.5,
      "duration_seconds": 18.5,
      "text": "You can relax now. So where does that leave us? This is probably tennis elbow. Rest it, use a forearm strap and do the stretches I'll show you. We'll catch up if it is not better in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.53,
      "end_seconds": 313.78,
      "duration_seconds": 2.25,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.66,
      "end_seconds": 317.07,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
}