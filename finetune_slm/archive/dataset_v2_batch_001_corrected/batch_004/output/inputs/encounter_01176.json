{
  "schema_version": "1.0",
  "encounter_id": "01176",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.6,
      "duration_seconds": 3.34,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.74,
      "end_seconds": 9.57,
      "duration_seconds": 3.83,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.26,
      "end_seconds": 14.85,
      "duration_seconds": 3.59,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.1,
      "end_seconds": 18.68,
      "duration_seconds": 2.58,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.73,
      "end_seconds": 23.12,
      "duration_seconds": 3.39,
      "text": "I've been feeling a bit muddled."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.53,
      "end_seconds": 27.43,
      "duration_seconds": 2.9,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.63,
      "end_seconds": 40.74,
      "duration_seconds": 2.11,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.99,
      "end_seconds": 60.1,
      "duration_seconds": 6.11,
      "text": "Okay: pulse is 98 beats a minute, temperature 36.7, blood pressure 98 over 59."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.57,
      "end_seconds": 78.95,
      "duration_seconds": 4.38,
      "text": "Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.66,
      "end_seconds": 91.96,
      "duration_seconds": 11.3,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 95.45,
      "duration_seconds": 1.56,
      "text": "Any constipation as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.5,
      "end_seconds": 103.47,
      "duration_seconds": 2.97,
      "text": "Yes, about the same, two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.17,
      "end_seconds": 108.87,
      "duration_seconds": 3.7,
      "text": "What about a dry mouth, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.69,
      "end_seconds": 111.16,
      "duration_seconds": 1.47,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.41,
      "end_seconds": 116.76,
      "duration_seconds": 5.35,
      "text": "Ah. Have you been feeling a bit muddled at any time before this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 124.41,
      "duration_seconds": 6.48,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.96,
      "end_seconds": 128.47,
      "duration_seconds": 3.51,
      "text": "And what about fever, falls or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.56,
      "end_seconds": 133.15,
      "duration_seconds": 3.59,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.02,
      "end_seconds": 140.0,
      "duration_seconds": 1.98,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.98,
      "end_seconds": 144.39,
      "duration_seconds": 2.41,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.36,
      "end_seconds": 149.23,
      "duration_seconds": 2.87,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.23,
      "end_seconds": 156.01,
      "duration_seconds": 4.78,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 161.28,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.2,
      "end_seconds": 164.28,
      "duration_seconds": 2.08,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.25,
      "end_seconds": 170.26,
      "duration_seconds": 5.01,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.04,
      "end_seconds": 177.48,
      "duration_seconds": 6.44,
      "text": "Years back I got itching from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.83,
      "end_seconds": 180.1,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.7,
      "end_seconds": 183.62,
      "duration_seconds": 2.92,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 188.39,
      "duration_seconds": 2.89,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.01,
      "end_seconds": 193.56,
      "duration_seconds": 4.55,
      "text": "Arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 198.48,
      "duration_seconds": 2.84,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.39,
      "end_seconds": 202.09,
      "duration_seconds": 2.7,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.82,
      "end_seconds": 213.58,
      "duration_seconds": 9.76,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.08,
      "end_seconds": 226.54,
      "duration_seconds": 12.46,
      "text": "Diclofenac, 50 milligrams, when needed. I take hydrochlorothiazide, 12.5 milligrams, every morning. I'm on a sleeping tablet, 3.75 milligrams, at night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.53,
      "end_seconds": 245.39,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.41,
      "end_seconds": 248.82,
      "duration_seconds": 2.41,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.56,
      "end_seconds": 253.45,
      "duration_seconds": 3.89,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.5,
      "end_seconds": 259.5,
      "duration_seconds": 4.0,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.09,
      "end_seconds": 261.43,
      "duration_seconds": 1.34,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.96,
      "end_seconds": 269.22,
      "duration_seconds": 3.26,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.6,
      "end_seconds": 273.61,
      "duration_seconds": 2.01,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.82,
      "end_seconds": 286.52,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.88,
      "end_seconds": 289.64,
      "duration_seconds": 1.76,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.36,
      "end_seconds": 310.18,
      "duration_seconds": 3.82,
      "text": "Your blood pressure drops a little on standing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.46,
      "end_seconds": 325.49,
      "duration_seconds": 11.03,
      "text": "Good, you can sit up again. Taking everything into account, my working impression is side effects from several medicines taken together. Dehydration is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.76,
      "end_seconds": 330.69,
      "duration_seconds": 1.93,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.87,
      "end_seconds": 346.73,
      "duration_seconds": 14.86,
      "text": "I can't promise yet, but most people with side effects from several medicines taken together do well once it's treated properly. I'm going to order a medication review, for polypharmacy."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.15,
      "end_seconds": 354.65,
      "duration_seconds": 2.5,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.69,
      "end_seconds": 367.13,
      "duration_seconds": 10.44,
      "text": "We will stop the sleeping tablet slowly over two weeks. I think the pharmacist should see you too. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.05,
      "end_seconds": 371.96,
      "duration_seconds": 3.91,
      "text": "Erm, no, that's all. Thanks a lot."
    }
  ]
}