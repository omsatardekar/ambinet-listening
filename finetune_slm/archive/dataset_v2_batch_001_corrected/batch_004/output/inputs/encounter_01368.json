{
  "schema_version": "1.0",
  "encounter_id": "01368",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 5.82,
      "duration_seconds": 5.11,
      "text": "Well, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.75,
      "end_seconds": 11.57,
      "duration_seconds": 3.82,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.61,
      "end_seconds": 27.64,
      "duration_seconds": 14.03,
      "text": "So, mainly numbness in my feet. There's a couple of other things, but that's the main one. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.15,
      "end_seconds": 32.96,
      "duration_seconds": 3.81,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.45,
      "end_seconds": 38.29,
      "duration_seconds": 3.84,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.78,
      "end_seconds": 41.95,
      "duration_seconds": 3.17,
      "text": "Mm-hmm. Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.9,
      "end_seconds": 56.56,
      "duration_seconds": 12.66,
      "text": "Yes, night. That makes it worse. And there's burning pain in my toes as well, you know, three days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.1,
      "end_seconds": 57.8,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.61,
      "end_seconds": 75.76,
      "duration_seconds": 4.15,
      "text": "A few quick ones: back pain, weakness or bladder problems?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.46,
      "end_seconds": 79.7,
      "duration_seconds": 3.24,
      "text": "Ah, none of those, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.65,
      "end_seconds": 85.7,
      "duration_seconds": 4.05,
      "text": "Okay, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.34,
      "end_seconds": 90.95,
      "duration_seconds": 4.61,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.67,
      "end_seconds": 94.08,
      "duration_seconds": 2.41,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.75,
      "end_seconds": 95.94,
      "duration_seconds": 1.19,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.03,
      "end_seconds": 99.7,
      "duration_seconds": 2.67,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 109.15,
      "duration_seconds": 5.86,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.58,
      "end_seconds": 113.49,
      "duration_seconds": 2.91,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.36,
      "end_seconds": 130.29,
      "duration_seconds": 14.93,
      "text": "I, I take glibenclamide, 5 milligrams, before breakfast for my sugar. It's febuxostat, 80 milligrams, once a day. Okay, so it's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.91,
      "end_seconds": 138.05,
      "duration_seconds": 4.14,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.82,
      "end_seconds": 147.83,
      "duration_seconds": 8.01,
      "text": "Um, you know, I'm allergic to erythromycin, I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.24,
      "end_seconds": 150.81,
      "duration_seconds": 1.57,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.75,
      "end_seconds": 159.54,
      "duration_seconds": 6.79,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.04,
      "end_seconds": 167.29,
      "duration_seconds": 1.25,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.83,
      "end_seconds": 172.98,
      "duration_seconds": 4.15,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.98,
      "end_seconds": 178.36,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.37,
      "end_seconds": 183.53,
      "duration_seconds": 3.16,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.43,
      "end_seconds": 189.89,
      "duration_seconds": 2.46,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.19,
      "end_seconds": 195.59,
      "duration_seconds": 4.4,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.64,
      "end_seconds": 198.35,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.52,
      "end_seconds": 202.96,
      "duration_seconds": 3.44,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.9,
      "end_seconds": 207.77,
      "duration_seconds": 2.87,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.44,
      "end_seconds": 214.91,
      "duration_seconds": 6.47,
      "text": "I have diabetes. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.22,
      "end_seconds": 216.98,
      "duration_seconds": 0.76,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.6,
      "end_seconds": 226.14,
      "duration_seconds": 8.54,
      "text": "I've had gout for two years now. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.67,
      "end_seconds": 227.75,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.59,
      "end_seconds": 230.55,
      "duration_seconds": 1.96,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.08,
      "end_seconds": 245.32,
      "duration_seconds": 10.24,
      "text": "Right, so diabetes and gout are already on your record. We'll keep that in mind today. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.41,
      "end_seconds": 256.87,
      "duration_seconds": 2.46,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.22,
      "end_seconds": 277.08,
      "duration_seconds": 6.86,
      "text": "Okay: SpO2 99 percent on room air, pulse 83, temperature 36.7, pressure 123 over 77."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.15,
      "end_seconds": 280.17,
      "duration_seconds": 2.02,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.57,
      "end_seconds": 283.65,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.65,
      "end_seconds": 303.73,
      "duration_seconds": 5.08,
      "text": "The ankle reflexes are reduced and the feeling is dulled below the knees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.27,
      "end_seconds": 310.74,
      "duration_seconds": 2.47,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.5,
      "end_seconds": 337.07,
      "duration_seconds": 12.57,
      "text": "Putting it all together, it points towards a peripheral neuropathy, probably related to diabetes. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.0,
      "end_seconds": 342.03,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.58,
      "end_seconds": 352.78,
      "duration_seconds": 10.2,
      "text": "I can't promise yet, but most people with a peripheral neuropathy, probably related to diabetes do well once it's treated properly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.46,
      "end_seconds": 372.53,
      "duration_seconds": 5.07,
      "text": "I think a nerve conduction study makes sense here, for neuropathy."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.36,
      "end_seconds": 376.32,
      "duration_seconds": 1.96,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.18,
      "end_seconds": 385.61,
      "duration_seconds": 7.43,
      "text": "I'd like you to take amitriptyline, 10 milligrams, at night, long term. It's for nerve pain."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.37,
      "end_seconds": 392.13,
      "duration_seconds": 4.76,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.08,
      "end_seconds": 408.95,
      "duration_seconds": 15.87,
      "text": "Check both feet daily and wear well-fitting shoes. Come back or go to emergency straight away if the symptoms get worse. See me again in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.4,
      "end_seconds": 414.31,
      "duration_seconds": 3.91,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}