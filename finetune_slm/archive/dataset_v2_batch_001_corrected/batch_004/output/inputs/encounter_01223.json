{
  "schema_version": "1.0",
  "encounter_id": "01223",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.14,
      "duration_seconds": 3.37,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 12.71,
      "duration_seconds": 4.46,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.59,
      "end_seconds": 21.07,
      "duration_seconds": 7.48,
      "text": "Doctor, thank you for seeing us. Doctor, it's hot flushes. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.97,
      "end_seconds": 23.19,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.2,
      "end_seconds": 28.72,
      "duration_seconds": 3.52,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.87,
      "end_seconds": 32.24,
      "duration_seconds": 2.37,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.14,
      "end_seconds": 36.96,
      "duration_seconds": 2.82,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 41.4,
      "duration_seconds": 3.43,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.98,
      "end_seconds": 45.39,
      "duration_seconds": 2.41,
      "text": "I, I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.37,
      "end_seconds": 49.84,
      "duration_seconds": 2.47,
      "text": "So, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.09,
      "end_seconds": 54.17,
      "duration_seconds": 3.08,
      "text": "It usually comes with vaginal dryness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.12,
      "end_seconds": 61.88,
      "duration_seconds": 6.76,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 61.98,
      "end_seconds": 67.0,
      "duration_seconds": 5.02,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.08,
      "end_seconds": 76.89,
      "duration_seconds": 7.81,
      "text": "I was getting to that! The vaginal dryness? That's been for about four days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.19,
      "end_seconds": 81.0,
      "duration_seconds": 2.81,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.72,
      "end_seconds": 83.89,
      "duration_seconds": 2.17,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.67,
      "end_seconds": 87.41,
      "duration_seconds": 2.74,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.43,
      "end_seconds": 95.89,
      "duration_seconds": 2.46,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.01,
      "end_seconds": 126.03,
      "duration_seconds": 10.02,
      "text": "Okay: respiratory rate 15, oxygen saturation is 99 percent, heart rate 66, blood pressure 123 over 74, temperature 36.5."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.18,
      "end_seconds": 130.56,
      "duration_seconds": 2.38,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.99,
      "end_seconds": 133.6,
      "duration_seconds": 1.61,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.35,
      "end_seconds": 151.42,
      "duration_seconds": 2.07,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.27,
      "end_seconds": 153.42,
      "duration_seconds": 1.15,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.7,
      "end_seconds": 163.59,
      "duration_seconds": 6.89,
      "text": "Good, you can sit up again. And what about heavy bleeding, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.07,
      "end_seconds": 177.02,
      "duration_seconds": 11.95,
      "text": "No, no heavy bleeding, no weight loss, no chest pain. I did have night sweats at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.66,
      "end_seconds": 181.45,
      "duration_seconds": 3.79,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.34,
      "end_seconds": 183.9,
      "duration_seconds": 1.56,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.92,
      "end_seconds": 189.56,
      "duration_seconds": 4.64,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.9,
      "end_seconds": 204.09,
      "duration_seconds": 13.19,
      "text": "I used to drink heavily but I stopped four years ago. My husband and I live above the shop. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.81,
      "end_seconds": 207.78,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.43,
      "end_seconds": 210.68,
      "duration_seconds": 2.25,
      "text": "I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.34,
      "end_seconds": 215.57,
      "duration_seconds": 1.23,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.16,
      "end_seconds": 218.54,
      "duration_seconds": 1.38,
      "text": "I've got migraines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.34,
      "end_seconds": 220.72,
      "duration_seconds": 1.38,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.04,
      "end_seconds": 224.06,
      "duration_seconds": 2.02,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.39,
      "end_seconds": 229.37,
      "duration_seconds": 3.98,
      "text": "Alright, migraines, that matches what I have here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.82,
      "end_seconds": 250.15,
      "duration_seconds": 2.33,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.97,
      "end_seconds": 258.6,
      "duration_seconds": 7.63,
      "text": "Escitalopram, 10 milligrams, once a day. I take lansoprazole, 30 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.54,
      "end_seconds": 263.46,
      "duration_seconds": 3.92,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.3,
      "end_seconds": 273.53,
      "duration_seconds": 9.23,
      "text": "No, you know, it's at home. I had propranolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.21,
      "end_seconds": 277.41,
      "duration_seconds": 3.2,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.37,
      "end_seconds": 285.25,
      "duration_seconds": 3.88,
      "text": "My cousin has psoriasis. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.29,
      "end_seconds": 291.68,
      "duration_seconds": 4.39,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.38,
      "end_seconds": 304.06,
      "duration_seconds": 10.68,
      "text": "I, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.06,
      "end_seconds": 316.66,
      "duration_seconds": 10.6,
      "text": "Okay, so my impression is this: The most likely explanation is menopausal symptoms. It could also be an overactive thyroid, so we'll keep that open."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.78,
      "end_seconds": 321.63,
      "duration_seconds": 3.85,
      "text": "Uh, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.61,
      "end_seconds": 330.13,
      "duration_seconds": 6.52,
      "text": "I can't promise yet, but most people with menopausal symptoms do well once it's treated properly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.18,
      "end_seconds": 379.37,
      "duration_seconds": 34.19,
      "text": "I'm going to order a thyroid test, for hot flushes. I'd like you to take estradiol patch, 50 micrograms, twice weekly, long term. That's for menopausal symptoms. Dress in layers and keep the bedroom cool. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.67,
      "end_seconds": 386.16,
      "duration_seconds": 5.49,
      "text": "Come back in three months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.82,
      "end_seconds": 390.85,
      "duration_seconds": 4.03,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.62,
      "end_seconds": 394.07,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}