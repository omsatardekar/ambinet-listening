{
  "schema_version": "1.0",
  "encounter_id": "01329",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 5.44,
      "duration_seconds": 4.27,
      "text": "Sorry I'm a little late, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.49,
      "end_seconds": 11.44,
      "duration_seconds": 3.95,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.22,
      "end_seconds": 18.2,
      "duration_seconds": 5.98,
      "text": "Honestly, it's an irregular heartbeat, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.85,
      "end_seconds": 26.68,
      "duration_seconds": 6.83,
      "text": "When was the first time you noticed it? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.33,
      "end_seconds": 30.4,
      "duration_seconds": 2.07,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.22,
      "end_seconds": 33.38,
      "duration_seconds": 2.16,
      "text": "Any occasional bruising as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 45.11,
      "duration_seconds": 10.04,
      "text": "Yes, for ten days. Being short of breath on slopes was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.07,
      "end_seconds": 51.57,
      "duration_seconds": 4.5,
      "text": "Any fainting, chest pain, nosebleeds or black stools at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.1,
      "end_seconds": 58.56,
      "duration_seconds": 6.46,
      "text": "I mean, I haven't had fainting, chest pain, nosebleeds or black stools, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.39,
      "end_seconds": 64.21,
      "duration_seconds": 3.82,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.95,
      "end_seconds": 67.58,
      "duration_seconds": 1.63,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.99,
      "end_seconds": 73.57,
      "duration_seconds": 4.58,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.36,
      "end_seconds": 83.99,
      "duration_seconds": 9.63,
      "text": "I've never touched a cigarette. I live with my elderly mother. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.83,
      "end_seconds": 87.62,
      "duration_seconds": 2.79,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.62,
      "end_seconds": 92.94,
      "duration_seconds": 3.32,
      "text": "An irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.67,
      "end_seconds": 96.52,
      "duration_seconds": 1.85,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.78,
      "end_seconds": 111.63,
      "duration_seconds": 13.85,
      "text": "I've had depression for about a year now. My family kept telling me to get it checked. Yes, thin bones. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.44,
      "end_seconds": 116.17,
      "duration_seconds": 3.73,
      "text": "Alright, depression, that matches what I have here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.67,
      "end_seconds": 132.88,
      "duration_seconds": 3.21,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.38,
      "end_seconds": 141.69,
      "duration_seconds": 4.31,
      "text": "My cousin has psoriasis. My son has asthma."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.08,
      "end_seconds": 161.65,
      "duration_seconds": 3.57,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.48,
      "end_seconds": 167.42,
      "duration_seconds": 3.94,
      "text": "I take apixaban, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 168.5,
      "end_seconds": 173.4,
      "duration_seconds": 4.9,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.61,
      "end_seconds": 179.31,
      "duration_seconds": 4.7,
      "text": "Okay, I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.72,
      "end_seconds": 189.59,
      "duration_seconds": 8.87,
      "text": "Not with me. I'll bring it next time. I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.6,
      "end_seconds": 192.9,
      "duration_seconds": 1.3,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.91,
      "end_seconds": 200.75,
      "duration_seconds": 1.84,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.64,
      "end_seconds": 207.26,
      "duration_seconds": 4.62,
      "text": "Okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.08,
      "end_seconds": 220.52,
      "duration_seconds": 11.44,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 221.52,
      "end_seconds": 229.99,
      "duration_seconds": 8.47,
      "text": "Here are the numbers, doctor. Oxygen saturation is 98 percent, BP is 132 over 79, heart rate 115."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.28,
      "end_seconds": 231.98,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.5,
      "end_seconds": 238.49,
      "duration_seconds": 4.99,
      "text": "Right, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.71,
      "end_seconds": 240.72,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.64,
      "end_seconds": 244.45,
      "duration_seconds": 2.81,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.76,
      "end_seconds": 263.36,
      "duration_seconds": 4.6,
      "text": "Your pulse is irregular and your heart sounds are otherwise normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.06,
      "end_seconds": 266.44,
      "duration_seconds": 1.38,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.95,
      "end_seconds": 281.24,
      "duration_seconds": 11.29,
      "text": "That's the examination finished. Right, here's what I'm thinking. It points towards atrial fibrillation, rate reasonably controlled. Another possibility is anaemia from bleeding."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.69,
      "end_seconds": 284.17,
      "duration_seconds": 1.48,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 302.84,
      "duration_seconds": 16.87,
      "text": "It's reasonable to be concerned, but right now atrial fibrillation, rate reasonably controlled is my leading thought, not anything worse. So, to recap quickly. You've had an irregular heartbeat for four weeks, and no fainting or black stools."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.42,
      "end_seconds": 309.64,
      "duration_seconds": 2.22,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 318.6,
      "end_seconds": 322.15,
      "duration_seconds": 3.55,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.13,
      "end_seconds": 330.82,
      "duration_seconds": 6.69,
      "text": "Okay, good, thanks for doing that. I'm going to order kidney function tests, for anticoagulant dosing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.02,
      "end_seconds": 334.29,
      "duration_seconds": 2.27,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.08,
      "end_seconds": 339.91,
      "duration_seconds": 4.83,
      "text": "I'm going to order a full blood count, for anticoagulant review."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.6,
      "end_seconds": 343.08,
      "duration_seconds": 2.48,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.38,
      "end_seconds": 367.1,
      "duration_seconds": 22.72,
      "text": "Never skip the blood thinner, and tell any dentist or surgeon you take it. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you in three months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.94,
      "end_seconds": 371.81,
      "duration_seconds": 2.87,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.43,
      "end_seconds": 373.66,
      "duration_seconds": 1.23,
      "text": "See you soon."
    }
  ]
}