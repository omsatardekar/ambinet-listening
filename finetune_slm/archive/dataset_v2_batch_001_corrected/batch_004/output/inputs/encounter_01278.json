{
  "schema_version": "1.0",
  "encounter_id": "01278",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.45,
      "duration_seconds": 5.27,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.56,
      "end_seconds": 12.07,
      "duration_seconds": 4.51,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.22,
      "end_seconds": 21.1,
      "duration_seconds": 3.88,
      "text": "Yeah, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.63,
      "end_seconds": 32.71,
      "duration_seconds": 10.08,
      "text": "Ah, it's I can't get my breath, mostly. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.62,
      "end_seconds": 38.06,
      "duration_seconds": 3.44,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.99,
      "end_seconds": 43.19,
      "duration_seconds": 3.2,
      "text": "I've had it for about a month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.73,
      "end_seconds": 48.64,
      "duration_seconds": 3.91,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.38,
      "end_seconds": 62.55,
      "duration_seconds": 12.17,
      "text": "It feels mild to me. Oh, and not being able to finish a sentence. As for not being able to finish a sentence, mostly severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.1,
      "end_seconds": 67.12,
      "duration_seconds": 3.02,
      "text": "What about wheezing, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.03,
      "end_seconds": 83.58,
      "duration_seconds": 15.55,
      "text": "Yes, for two weeks. About wheezing, about a seven out of ten. Honestly, once or twice a day. I had a very tight chest before. That's settled now, you know, though."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.08,
      "end_seconds": 88.37,
      "duration_seconds": 3.29,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.02,
      "end_seconds": 98.27,
      "duration_seconds": 4.25,
      "text": "My son has asthma. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.76,
      "end_seconds": 111.46,
      "duration_seconds": 4.7,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.34,
      "end_seconds": 118.54,
      "duration_seconds": 5.2,
      "text": "I'm allergic to amoxicillin, I get a rash all over."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.76,
      "end_seconds": 122.2,
      "duration_seconds": 2.44,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.47,
      "end_seconds": 129.39,
      "duration_seconds": 5.92,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.28,
      "end_seconds": 134.76,
      "duration_seconds": 3.48,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.66,
      "end_seconds": 145.61,
      "duration_seconds": 9.95,
      "text": "I'm on Foracort inhaler, twice a day. I'm, I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.11,
      "end_seconds": 162.86,
      "duration_seconds": 3.75,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.63,
      "end_seconds": 168.85,
      "duration_seconds": 5.22,
      "text": "I have asthma, for nearly five years. I have eczema."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.5,
      "end_seconds": 178.87,
      "duration_seconds": 8.37,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.46,
      "end_seconds": 184.93,
      "duration_seconds": 5.47,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.64,
      "end_seconds": 188.11,
      "duration_seconds": 2.47,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.81,
      "end_seconds": 192.63,
      "duration_seconds": 3.82,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.7,
      "end_seconds": 200.34,
      "duration_seconds": 5.64,
      "text": "Let me check a few things. Any blue tinge or chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.86,
      "end_seconds": 206.74,
      "duration_seconds": 5.88,
      "text": "Let me think, no blue tinge or chest pain, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.08,
      "end_seconds": 209.98,
      "duration_seconds": 1.9,
      "text": "Any sign of fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.62,
      "end_seconds": 212.01,
      "duration_seconds": 1.39,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 214.06,
      "end_seconds": 219.77,
      "duration_seconds": 5.71,
      "text": "Actually, uh, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.25,
      "end_seconds": 227.18,
      "duration_seconds": 5.93,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.83,
      "end_seconds": 236.84,
      "duration_seconds": 8.01,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.23,
      "end_seconds": 239.14,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.4,
      "end_seconds": 249.79,
      "duration_seconds": 3.39,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.23,
      "end_seconds": 259.62,
      "duration_seconds": 2.39,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.13,
      "end_seconds": 292.35,
      "duration_seconds": 14.22,
      "text": "Okay: heart rate 98, height 171 centimetres, respiratory rate 23. And weight 65 kilos, BMI works out to 22.2, BP is 123 over 82, SpO2 91 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.88,
      "end_seconds": 296.85,
      "duration_seconds": 1.97,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.06,
      "end_seconds": 299.52,
      "duration_seconds": 1.46,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.75,
      "end_seconds": 303.42,
      "duration_seconds": 2.67,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.65,
      "end_seconds": 320.62,
      "duration_seconds": 5.97,
      "text": "You are using your neck muscles to breathe, and your oxygen is low."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.38,
      "end_seconds": 334.08,
      "duration_seconds": 10.7,
      "text": "That's all I needed to check. Okay, thinking it through, it fits best with a severe asthma attack. A chest infection is also on my list."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.4,
      "end_seconds": 338.57,
      "duration_seconds": 3.17,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.5,
      "end_seconds": 376.02,
      "duration_seconds": 35.52,
      "text": "It's reasonable to be concerned, but right now a severe asthma attack is my leading thought, not anything worse. I'd like to arrange a peak flow for asthma attack. I'm sending you for a chest X-ray because of severe breathlessness. We'll begin with prednisolone, 40 milligrams, once now, single dose. That's for asthma attack. Sit upright and take slow breaths while the nebuliser is set up. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.86,
      "end_seconds": 383.51,
      "duration_seconds": 6.65,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.8,
      "end_seconds": 387.5,
      "duration_seconds": 1.7,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.44,
      "end_seconds": 391.11,
      "duration_seconds": 2.67,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.95,
      "end_seconds": 395.3,
      "duration_seconds": 3.35,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.8,
      "end_seconds": 401.23,
      "duration_seconds": 5.43,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.13,
      "end_seconds": 405.0,
      "duration_seconds": 2.87,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.1,
      "end_seconds": 408.36,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}