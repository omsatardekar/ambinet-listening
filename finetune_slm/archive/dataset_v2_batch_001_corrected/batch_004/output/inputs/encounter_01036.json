{
  "schema_version": "1.0",
  "encounter_id": "01036",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 7.41,
      "duration_seconds": 6.54,
      "text": "Hello, sorry about the delay, do sit. Okay, how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.0,
      "end_seconds": 11.04,
      "duration_seconds": 3.04,
      "text": "I've been feeling extremely weak."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.44,
      "end_seconds": 20.38,
      "duration_seconds": 2.94,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.05,
      "end_seconds": 30.06,
      "duration_seconds": 8.01,
      "text": "About... well, three days. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.39,
      "end_seconds": 35.71,
      "duration_seconds": 4.32,
      "text": "So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.29,
      "end_seconds": 45.55,
      "duration_seconds": 5.26,
      "text": "So, um, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.29,
      "end_seconds": 50.72,
      "duration_seconds": 3.43,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.4,
      "end_seconds": 70.69,
      "duration_seconds": 18.29,
      "text": "It usually comes with vomiting. The vomiting? That's been for ten days. And, And dizzy when I stand, too. Mm, you know, with dizzy when I stand, yes, standing. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 75.61,
      "duration_seconds": 3.18,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.55,
      "end_seconds": 80.37,
      "duration_seconds": 3.82,
      "text": "Sumatriptan, when needed for my migraines."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.69,
      "end_seconds": 84.63,
      "duration_seconds": 2.94,
      "text": "So, do you know the dose?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.42,
      "end_seconds": 88.56,
      "duration_seconds": 2.14,
      "text": "It's, It's 50 milligrams."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.2,
      "end_seconds": 92.04,
      "duration_seconds": 2.84,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.6,
      "end_seconds": 100.07,
      "duration_seconds": 6.47,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.79,
      "end_seconds": 106.03,
      "duration_seconds": 4.24,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.42,
      "end_seconds": 113.59,
      "duration_seconds": 4.17,
      "text": "Mm, uh, I've never had an allergy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.52,
      "end_seconds": 124.09,
      "duration_seconds": 2.57,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.08,
      "end_seconds": 128.52,
      "duration_seconds": 2.44,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.22,
      "end_seconds": 132.31,
      "duration_seconds": 3.09,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.28,
      "end_seconds": 137.61,
      "duration_seconds": 4.33,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.82,
      "end_seconds": 141.54,
      "duration_seconds": 2.72,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.73,
      "end_seconds": 146.33,
      "duration_seconds": 3.6,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.37,
      "end_seconds": 149.31,
      "duration_seconds": 1.94,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.6,
      "end_seconds": 152.77,
      "duration_seconds": 2.17,
      "text": "Migraines, for five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.5,
      "end_seconds": 161.35,
      "duration_seconds": 6.85,
      "text": "Alright, migraines, that matches what I have here. Did you get fever or chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.07,
      "end_seconds": 166.55,
      "duration_seconds": 4.48,
      "text": "Okay, so no, nothing to report there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.4,
      "end_seconds": 169.56,
      "duration_seconds": 2.16,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.41,
      "end_seconds": 174.18,
      "duration_seconds": 2.77,
      "text": "So, I move fine otherwise."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.72,
      "end_seconds": 177.31,
      "duration_seconds": 2.59,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.04,
      "end_seconds": 181.6,
      "duration_seconds": 2.56,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 197.66,
      "end_seconds": 209.74,
      "duration_seconds": 12.08,
      "text": "Doctor, I've got the readings for you. Temp 36.7 degrees, pulse is 110 beats a minute, SpO2 99 percent on room air, blood pressure 93 over 58."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 212.35,
      "duration_seconds": 0.94,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.35,
      "end_seconds": 218.97,
      "duration_seconds": 4.62,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.88,
      "end_seconds": 220.58,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.07,
      "end_seconds": 224.0,
      "duration_seconds": 1.93,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.91,
      "end_seconds": 248.24,
      "duration_seconds": 5.33,
      "text": "Your blood pressure is very low and your skin is cool."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.45,
      "end_seconds": 252.32,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.56,
      "end_seconds": 297.6,
      "duration_seconds": 31.04,
      "text": "Let me tell you where I've got to. I don't have a clear answer today: a possible adrenal crisis after stopping steroids is possible, and so is a severe infection. Blood tests is what I'd like next, for adrenal crisis. What I'm giving you is hydrocortisone, 100 milligrams, once now, single dose. That's for adrenal crisis. I am giving an injection now and calling an ambulance. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.64,
      "end_seconds": 310.73,
      "duration_seconds": 11.09,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.09,
      "end_seconds": 315.99,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}