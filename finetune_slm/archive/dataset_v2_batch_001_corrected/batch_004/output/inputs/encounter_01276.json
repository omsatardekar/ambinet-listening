{
  "schema_version": "1.0",
  "encounter_id": "01276",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.92,
      "duration_seconds": 5.79,
      "text": "Yeah, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.24,
      "end_seconds": 13.01,
      "duration_seconds": 4.77,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.65,
      "end_seconds": 21.47,
      "duration_seconds": 6.82,
      "text": "Yeah, it's a cut on my finger. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.18,
      "end_seconds": 25.42,
      "duration_seconds": 3.24,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.99,
      "end_seconds": 29.85,
      "duration_seconds": 1.86,
      "text": "Glibenclamide, before breakfast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.39,
      "end_seconds": 33.41,
      "duration_seconds": 2.02,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.85,
      "end_seconds": 44.62,
      "duration_seconds": 9.77,
      "text": "It's 5 milligrams. Well, um, I'm on thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 51.53,
      "duration_seconds": 3.11,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.4,
      "end_seconds": 67.42,
      "duration_seconds": 14.02,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.51,
      "end_seconds": 72.49,
      "duration_seconds": 2.98,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.35,
      "end_seconds": 81.31,
      "duration_seconds": 3.96,
      "text": "It usually comes with a little bleeding."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.94,
      "end_seconds": 86.18,
      "duration_seconds": 3.24,
      "text": "A few quick ones: dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.8,
      "end_seconds": 93.37,
      "duration_seconds": 5.57,
      "text": "Okay, uh, so no, no dirty blade or numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.89,
      "end_seconds": 98.89,
      "duration_seconds": 4.0,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.7,
      "end_seconds": 101.86,
      "duration_seconds": 2.16,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.86,
      "end_seconds": 105.22,
      "duration_seconds": 2.36,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.21,
      "end_seconds": 113.04,
      "duration_seconds": 5.83,
      "text": "I mean, uh, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.96,
      "end_seconds": 119.24,
      "duration_seconds": 4.28,
      "text": "Right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.19,
      "end_seconds": 137.98,
      "duration_seconds": 14.79,
      "text": "Uh, I've had diabetes, yes. Right, yes, heart failure. I wasn't sure whether to come in at all, to be honest. An underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.9,
      "end_seconds": 154.15,
      "duration_seconds": 14.25,
      "text": "Right, so diabetes and an underactive thyroid are already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.4,
      "end_seconds": 168.37,
      "duration_seconds": 12.97,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.88,
      "end_seconds": 171.49,
      "duration_seconds": 1.61,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.56,
      "end_seconds": 177.76,
      "duration_seconds": 4.2,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 180.23,
      "duration_seconds": 1.73,
      "text": "Right, how about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.28,
      "end_seconds": 185.23,
      "duration_seconds": 2.95,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.07,
      "end_seconds": 189.12,
      "duration_seconds": 3.05,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.44,
      "end_seconds": 195.59,
      "duration_seconds": 5.15,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.38,
      "end_seconds": 199.16,
      "duration_seconds": 1.78,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.67,
      "end_seconds": 202.19,
      "duration_seconds": 2.52,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.03,
      "end_seconds": 208.07,
      "duration_seconds": 4.04,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.39,
      "end_seconds": 215.33,
      "duration_seconds": 2.94,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.68,
      "end_seconds": 225.82,
      "duration_seconds": 3.14,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.84,
      "end_seconds": 240.41,
      "duration_seconds": 2.57,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.47,
      "end_seconds": 258.35,
      "duration_seconds": 5.88,
      "text": "Okay: blood pressure 127 over 71, pulse is 64 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.33,
      "end_seconds": 261.83,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.6,
      "end_seconds": 265.99,
      "duration_seconds": 2.39,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.03,
      "end_seconds": 271.39,
      "duration_seconds": 4.36,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.5,
      "end_seconds": 289.55,
      "duration_seconds": 1.05,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.39,
      "end_seconds": 292.11,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.17,
      "end_seconds": 305.04,
      "duration_seconds": 5.87,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.06,
      "end_seconds": 309.92,
      "duration_seconds": 2.86,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.25,
      "end_seconds": 343.35,
      "duration_seconds": 17.1,
      "text": "Let me tell you where I've got to. The most likely explanation is a minor clean wound that needs only dressing. I'll close it with adhesive strips and keep it dry for two days. Let's plan a check if it looks red or swollen."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 344.47,
      "end_seconds": 348.03,
      "duration_seconds": 3.56,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.08,
      "end_seconds": 351.83,
      "duration_seconds": 2.75,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.84,
      "end_seconds": 356.85,
      "duration_seconds": 3.01,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.57,
      "end_seconds": 359.77,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}