{
  "schema_version": "1.0",
  "encounter_id": "01117",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 3.72,
      "duration_seconds": 2.94,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.91,
      "end_seconds": 11.29,
      "duration_seconds": 6.38,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.67,
      "end_seconds": 19.03,
      "duration_seconds": 6.36,
      "text": "Right, absolutely, come and sit beside them. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 20.7,
      "end_seconds": 26.05,
      "duration_seconds": 5.35,
      "text": "doctor, it's my throat closing up that's what we're worried about"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.69,
      "end_seconds": 29.88,
      "duration_seconds": 3.19,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.5,
      "end_seconds": 34.37,
      "duration_seconds": 3.87,
      "text": "about about a month, give or take"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 35.71,
      "end_seconds": 41.39,
      "duration_seconds": 5.68,
      "text": "I think it's been nearer about two months, uh, actually"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.03,
      "end_seconds": 46.7,
      "duration_seconds": 4.67,
      "text": "okay, so so roughly one to two months is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.31,
      "end_seconds": 49.59,
      "duration_seconds": 1.28,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.73,
      "end_seconds": 54.18,
      "duration_seconds": 3.45,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.83,
      "end_seconds": 56.56,
      "duration_seconds": 1.73,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.7,
      "end_seconds": 60.2,
      "duration_seconds": 2.5,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.87,
      "end_seconds": 64.76,
      "duration_seconds": 3.89,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.55,
      "end_seconds": 69.35,
      "duration_seconds": 2.8,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.79,
      "end_seconds": 78.51,
      "duration_seconds": 7.72,
      "text": "It usually comes with hives all over. I've also been feeling faint, for five days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.07,
      "end_seconds": 83.01,
      "duration_seconds": 2.94,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.08,
      "end_seconds": 92.56,
      "duration_seconds": 7.48,
      "text": "it's every other day. Ah, the the hives all over? That's been for ten days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.41,
      "end_seconds": 96.76,
      "duration_seconds": 2.35,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.69,
      "end_seconds": 109.35,
      "duration_seconds": 2.66,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.07,
      "end_seconds": 132.91,
      "duration_seconds": 8.84,
      "text": "okay: pulse is 93 beats a minute, oxygen saturation is 97 percent, pressure 94 over 66. And temperature is 36.6 degrees"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.25,
      "end_seconds": 140.08,
      "duration_seconds": 3.83,
      "text": "Let me think, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.14,
      "end_seconds": 144.52,
      "duration_seconds": 2.38,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.89,
      "end_seconds": 150.64,
      "duration_seconds": 3.75,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.1,
      "end_seconds": 153.09,
      "duration_seconds": 0.99,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.31,
      "end_seconds": 155.51,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.49,
      "end_seconds": 173.34,
      "duration_seconds": 6.85,
      "text": "your lips are swollen, you have hives, you are wheezing and your pressure is low"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.89,
      "end_seconds": 184.74,
      "duration_seconds": 5.85,
      "text": "that's all I needed to check. And what about chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.51,
      "end_seconds": 195.13,
      "duration_seconds": 5.62,
      "text": "well, no chest pain or recent illness, none of it"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.47,
      "end_seconds": 198.65,
      "duration_seconds": 3.18,
      "text": "Sure. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.49,
      "end_seconds": 201.04,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.63,
      "end_seconds": 205.38,
      "duration_seconds": 2.75,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.61,
      "end_seconds": 217.57,
      "duration_seconds": 10.96,
      "text": "I've had asthma, yes. Mm, I have eczema. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.17,
      "end_seconds": 220.98,
      "duration_seconds": 2.81,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.6,
      "end_seconds": 231.85,
      "duration_seconds": 9.25,
      "text": "Right, so asthma and eczema are already on your record. We'll keep that in mind today. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.94,
      "end_seconds": 238.32,
      "duration_seconds": 5.38,
      "text": "Erm, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.85,
      "end_seconds": 253.8,
      "duration_seconds": 2.95,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.09,
      "end_seconds": 265.32,
      "duration_seconds": 10.23,
      "text": "Foracort inhaler. I take it twice a day. Sorry, what was I saying, I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.89,
      "end_seconds": 269.43,
      "duration_seconds": 3.54,
      "text": "Mm, okay. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.33,
      "end_seconds": 275.99,
      "duration_seconds": 4.66,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.18,
      "end_seconds": 294.49,
      "duration_seconds": 2.31,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.63,
      "end_seconds": 300.9,
      "duration_seconds": 3.27,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.53,
      "end_seconds": 304.43,
      "duration_seconds": 1.9,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.59,
      "end_seconds": 308.47,
      "duration_seconds": 2.88,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.29,
      "end_seconds": 312.68,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.47,
      "end_seconds": 318.71,
      "duration_seconds": 4.24,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.29,
      "end_seconds": 321.52,
      "duration_seconds": 2.23,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.28,
      "end_seconds": 327.45,
      "duration_seconds": 4.17,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.53,
      "end_seconds": 336.21,
      "duration_seconds": 7.68,
      "text": "having listened and examined, it points towards anaphylaxis i can't rule out a severe allergic reaction yet"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.12,
      "end_seconds": 342.15,
      "duration_seconds": 4.03,
      "text": "Um, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.23,
      "end_seconds": 350.31,
      "duration_seconds": 7.08,
      "text": "Nothing I've seen today points to an emergency. It looks like anaphylaxis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.53,
      "end_seconds": 368.83,
      "duration_seconds": 3.3,
      "text": "I want monitoring done, that's for anaphylaxis."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 369.45,
      "end_seconds": 373.47,
      "duration_seconds": 4.02,
      "text": "Hmm, where would I go for that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.44,
      "end_seconds": 386.77,
      "duration_seconds": 12.33,
      "text": "You'll be taking adrenaline, 0.5 milligrams, once now, single dose. That should help with anaphylaxis. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 388.72,
      "end_seconds": 393.61,
      "duration_seconds": 4.89,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.73,
      "end_seconds": 416.84,
      "duration_seconds": 22.11,
      "text": "Lie flat with your legs raised, I am giving the injection now. Try to get to bed and wake up at the same time each day, and keep your phone away from the the bed. I'll want another look straight away. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 417.43,
      "end_seconds": 421.99,
      "duration_seconds": 4.56,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}