    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.05,
      "end_seconds": 23.16,
      "duration_seconds": 13.11,
      "text": "it's my face drooping on one side, mostly my neighbour said I should get it looked at sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
