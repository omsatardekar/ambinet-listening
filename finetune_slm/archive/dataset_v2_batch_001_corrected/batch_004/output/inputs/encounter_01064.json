      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.64,
      "end_seconds": 310.46,
      "duration_seconds": 7.82,
      "text": "nothing I've seen today points to an emergency it looks like a possible stroke, within the treatment window"
