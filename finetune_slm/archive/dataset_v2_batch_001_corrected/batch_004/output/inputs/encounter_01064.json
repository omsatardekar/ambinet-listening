      "role": "DOCTOR",
      "start_seconds": 66.79,
      "end_seconds": 74.11,
      "duration_seconds": 7.32,
      "text": "Have you had your face drooping on one side before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.72,
      "end_seconds": 82.21,
      "duration_seconds": 6.49,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.29,
      "end_seconds": 101.51,
      "duration_seconds": 6.22,
      "text": "let me check a few things. Any seizure, loss of consciousness or fever?"
