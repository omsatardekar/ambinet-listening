{
  "schema_version": "1.0",
  "encounter_id": "01464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.96,
      "duration_seconds": 4.58,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.71,
      "end_seconds": 12.08,
      "duration_seconds": 4.37,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 18.4,
      "duration_seconds": 5.08,
      "text": "Mainly I've been wanting contraception. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.36,
      "end_seconds": 22.3,
      "duration_seconds": 2.94,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.45,
      "end_seconds": 26.55,
      "duration_seconds": 3.1,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.37,
      "end_seconds": 30.82,
      "duration_seconds": 3.45,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.54,
      "end_seconds": 36.98,
      "duration_seconds": 4.44,
      "text": "So, about a three out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.69,
      "end_seconds": 41.24,
      "duration_seconds": 2.55,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.1,
      "end_seconds": 55.33,
      "duration_seconds": 12.23,
      "text": "Slightly heavy periods goes along with it, most of the time. Uh, the slightly heavy periods? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.69,
      "end_seconds": 60.79,
      "duration_seconds": 4.1,
      "text": "Have you been wanting contraception at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.54,
      "end_seconds": 69.38,
      "duration_seconds": 6.84,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.51,
      "end_seconds": 73.48,
      "duration_seconds": 2.97,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.96,
      "end_seconds": 78.7,
      "duration_seconds": 3.74,
      "text": "Well, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.9,
      "end_seconds": 97.43,
      "duration_seconds": 3.53,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.57,
      "end_seconds": 102.1,
      "duration_seconds": 3.53,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.49,
      "end_seconds": 119.98,
      "duration_seconds": 2.49,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.36,
      "end_seconds": 124.77,
      "duration_seconds": 3.41,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.3,
      "end_seconds": 127.85,
      "duration_seconds": 2.55,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.49,
      "end_seconds": 131.39,
      "duration_seconds": 2.9,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.0,
      "end_seconds": 134.38,
      "duration_seconds": 2.38,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.81,
      "end_seconds": 139.66,
      "duration_seconds": 3.85,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 144.77,
      "duration_seconds": 3.43,
      "text": "So, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.45,
      "end_seconds": 155.44,
      "duration_seconds": 6.99,
      "text": "Well, I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.31,
      "end_seconds": 160.38,
      "duration_seconds": 4.07,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 164.02,
      "duration_seconds": 2.47,
      "text": "I, I have asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.78,
      "end_seconds": 170.7,
      "duration_seconds": 5.92,
      "text": "Sure. Right, any smoking, breast lumps or migraine with aura at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.39,
      "end_seconds": 176.9,
      "duration_seconds": 5.51,
      "text": "Well, you know, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.66,
      "end_seconds": 184.11,
      "duration_seconds": 3.45,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.94,
      "end_seconds": 188.12,
      "duration_seconds": 2.18,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.1,
      "end_seconds": 192.8,
      "duration_seconds": 3.7,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.53,
      "end_seconds": 197.14,
      "duration_seconds": 3.61,
      "text": "Oh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.7,
      "end_seconds": 203.1,
      "duration_seconds": 4.4,
      "text": "Okay, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.43,
      "end_seconds": 205.51,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.4,
      "end_seconds": 208.85,
      "duration_seconds": 1.45,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.14,
      "end_seconds": 228.31,
      "duration_seconds": 2.17,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.8,
      "end_seconds": 235.22,
      "duration_seconds": 2.42,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.29,
      "end_seconds": 260.27,
      "duration_seconds": 7.98,
      "text": "Okay, so my impression is this: This is probably suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.79,
      "end_seconds": 263.99,
      "duration_seconds": 3.2,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.75,
      "end_seconds": 300.8,
      "duration_seconds": 35.05,
      "text": "Nothing I've seen today points to an emergency. It looks like suitable for hormonal contraception with no risk factors. I'll start you on levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That's for contraception. Take the pill at the same time each day and use condoms if you miss two. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.18,
      "end_seconds": 313.82,
      "duration_seconds": 11.64,
      "text": "If you get leg swelling or severe headaches, or you feel really unwell, please come to the emergency department. Let's plan a check in three months."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 314.56,
      "end_seconds": 317.89,
      "duration_seconds": 3.33,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.88,
      "end_seconds": 322.77,
      "duration_seconds": 2.89,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.62,
      "end_seconds": 329.29,
      "duration_seconds": 4.67,
      "text": "Well, okay, that makes sense. Thanks for explaining."
    }
  ]
}