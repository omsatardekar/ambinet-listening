{
  "schema_version": "1.0",
  "encounter_id": "01227",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.22,
      "end_seconds": 4.37,
      "duration_seconds": 3.15,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 9.56,
      "end_seconds": 16.43,
      "duration_seconds": 6.87,
      "text": "Yeah, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.1,
      "end_seconds": 20.74,
      "duration_seconds": 2.64,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 22.59,
      "end_seconds": 25.48,
      "duration_seconds": 2.89,
      "text": "We came because of tummy pain."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.08,
      "end_seconds": 29.38,
      "duration_seconds": 3.3,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.99,
      "end_seconds": 51.45,
      "duration_seconds": 20.46,
      "text": "Sertraline, 50 milligrams, once a day. Allopurinol, 100 milligrams, once a day. It's telmisartan, 40 milligrams, once a day for my pressure. Well, it's iron tablets, once a day for my blood count. I was on losartan before. I stopped taking it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.6,
      "end_seconds": 57.39,
      "duration_seconds": 1.79,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.11,
      "end_seconds": 69.24,
      "duration_seconds": 10.13,
      "text": "About... well, ten days. I've never really been one for hospitals. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.86,
      "end_seconds": 75.61,
      "duration_seconds": 2.75,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.64,
      "end_seconds": 81.37,
      "duration_seconds": 3.73,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.9,
      "end_seconds": 88.32,
      "duration_seconds": 6.42,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 88.42,
      "end_seconds": 94.2,
      "duration_seconds": 5.78,
      "text": "okay, so tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.77,
      "end_seconds": 99.18,
      "duration_seconds": 3.41,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.06,
      "end_seconds": 103.55,
      "duration_seconds": 2.49,
      "text": "Have you been feeling very low?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.52,
      "end_seconds": 112.79,
      "duration_seconds": 7.27,
      "text": "Yes, about the same, two months. I'd been feeling sick, but that went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 118.88,
      "duration_seconds": 5.38,
      "text": "Have you had tummy pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 124.8,
      "duration_seconds": 4.81,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 130.07,
      "duration_seconds": 3.42,
      "text": "And what about chest pain or drowsiness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.64,
      "end_seconds": 136.04,
      "duration_seconds": 4.4,
      "text": "I haven't had chest pain or drowsiness, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.26,
      "end_seconds": 140.93,
      "duration_seconds": 3.67,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.46,
      "end_seconds": 144.84,
      "duration_seconds": 2.38,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.77,
      "end_seconds": 150.21,
      "duration_seconds": 4.44,
      "text": "okay, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.16,
      "end_seconds": 155.17,
      "duration_seconds": 3.01,
      "text": "I have depression. I have gout."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.41,
      "end_seconds": 159.82,
      "duration_seconds": 1.41,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.04,
      "end_seconds": 170.47,
      "duration_seconds": 9.43,
      "text": "High blood pressure, for about a year. I've got low haemoglobin. My sister suggested writing things down, but I forgot"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.82,
      "end_seconds": 172.67,
      "duration_seconds": 0.85,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.7,
      "end_seconds": 180.56,
      "duration_seconds": 5.86,
      "text": "I have high cholesterol, for about a year. I've got heart disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.07,
      "end_seconds": 191.83,
      "duration_seconds": 9.76,
      "text": "right, so gout and low haemoglobin are already on your record. We'll keep that in mind today. Alright, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.35,
      "end_seconds": 196.16,
      "duration_seconds": 3.81,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.94,
      "end_seconds": 199.99,
      "duration_seconds": 2.05,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.76,
      "end_seconds": 204.84,
      "duration_seconds": 4.08,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.46,
      "end_seconds": 208.71,
      "duration_seconds": 3.25,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.26,
      "end_seconds": 213.16,
      "duration_seconds": 3.9,
      "text": "oh, just a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.9,
      "end_seconds": 220.21,
      "duration_seconds": 4.31,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.47,
      "end_seconds": 230.81,
      "duration_seconds": 9.34,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.96,
      "end_seconds": 252.65,
      "duration_seconds": 3.69,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.41,
      "end_seconds": 264.09,
      "duration_seconds": 5.68,
      "text": "My grandfather had a stroke. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.89,
      "end_seconds": 267.42,
      "duration_seconds": 2.53,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.5,
      "end_seconds": 280.43,
      "duration_seconds": 2.93,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.13,
      "end_seconds": 303.63,
      "duration_seconds": 8.5,
      "text": "Okay: respiratory rate 18, blood pressure 117 over 75. And pulse 86, saturation 97 percent, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.4,
      "end_seconds": 308.29,
      "duration_seconds": 2.89,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.84,
      "end_seconds": 312.31,
      "duration_seconds": 2.47,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.25,
      "end_seconds": 328.5,
      "duration_seconds": 5.25,
      "text": "You are awake and alert, with some tenderness under the right ribs."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.48,
      "end_seconds": 336.44,
      "duration_seconds": 2.96,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.81,
      "end_seconds": 362.82,
      "duration_seconds": 14.01,
      "text": "right, here's what I'm thinking it fits best with a significant paracetamol overdose needing urgent treatment i can't rule out a mixed overdose yet i'm sending you for a paracetamol level because of overdose"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 363.66,
      "end_seconds": 366.53,
      "duration_seconds": 2.87,
      "text": "The earliest is Monday, 3:30 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 367.56,
      "end_seconds": 369.66,
      "duration_seconds": 2.1,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.62,
      "end_seconds": 406.89,
      "duration_seconds": 35.27,
      "text": "let's get liver function tests, for overdose the result will help us decide whether anything more is needed i'd like you to take acetylcysteine, per protocol, over 21 hours, per protocol it's for paracetamol overdose you need to stay in hospital for treatment, and someone will speak to you about how you are feeling i'd like you back straight away right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 408.19,
      "end_seconds": 411.64,
      "duration_seconds": 3.45,
      "text": "oh, no, that's all thanks a lot"
    }
  ]
