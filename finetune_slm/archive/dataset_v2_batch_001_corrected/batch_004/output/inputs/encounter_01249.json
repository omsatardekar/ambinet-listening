{
  "schema_version": "1.0",
  "encounter_id": "01249",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.65,
      "end_seconds": 5.34,
      "duration_seconds": 4.69,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 11.15,
      "duration_seconds": 3.93,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.22,
      "end_seconds": 16.04,
      "duration_seconds": 3.82,
      "text": "Um, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 16.71,
      "end_seconds": 23.39,
      "duration_seconds": 6.68,
      "text": "Um, so... a hot swollen painful knee. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.8,
      "end_seconds": 28.3,
      "duration_seconds": 3.5,
      "text": "Okay, how much does it limit you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.56,
      "end_seconds": 31.3,
      "duration_seconds": 1.74,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.72,
      "end_seconds": 32.7,
      "duration_seconds": 0.98,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.66,
      "end_seconds": 40.79,
      "duration_seconds": 7.13,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.89,
      "end_seconds": 46.84,
      "duration_seconds": 5.95,
      "text": "Tell the doctor about the other thing, you know, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.79,
      "end_seconds": 60.52,
      "duration_seconds": 11.73,
      "text": "I was getting to that! Oh, you know, and fever and chills. Oh, and not being able to walk on it. Had that since yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.59,
      "end_seconds": 68.39,
      "duration_seconds": 6.8,
      "text": "Have you had a hot swollen painful knee before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.84,
      "end_seconds": 78.56,
      "duration_seconds": 5.72,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.25,
      "end_seconds": 82.56,
      "duration_seconds": 3.31,
      "text": "Any other joint pain or recent injury?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.72,
      "end_seconds": 88.49,
      "duration_seconds": 4.77,
      "text": "Let me think, um, none of those, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.73,
      "end_seconds": 91.06,
      "duration_seconds": 1.33,
      "text": "What about rash?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.82,
      "end_seconds": 94.46,
      "duration_seconds": 1.64,
      "text": "No. No rash."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 96.27,
      "end_seconds": 101.07,
      "duration_seconds": 4.8,
      "text": "Actually, doctor, I did notice rash. He doesn't always say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.8,
      "end_seconds": 108.74,
      "duration_seconds": 5.94,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.78,
      "end_seconds": 115.01,
      "duration_seconds": 5.23,
      "text": "Alright, I'll note both what you've said and what you've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.29,
      "end_seconds": 119.94,
      "duration_seconds": 4.65,
      "text": "I see, go ahead. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.89,
      "end_seconds": 123.48,
      "duration_seconds": 1.59,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.46,
      "end_seconds": 128.73,
      "duration_seconds": 4.27,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.8,
      "end_seconds": 144.26,
      "duration_seconds": 13.46,
      "text": "Let me think, uh, I have an enlarged prostate, for about ten years. I, I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.95,
      "end_seconds": 147.03,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.29,
      "end_seconds": 156.77,
      "duration_seconds": 8.48,
      "text": "I have anxiety. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.33,
      "end_seconds": 160.21,
      "duration_seconds": 1.88,
      "text": "Alright, and besides that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.79,
      "end_seconds": 164.25,
      "duration_seconds": 2.46,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.34,
      "end_seconds": 166.7,
      "duration_seconds": 1.36,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 181.17,
      "duration_seconds": 13.38,
      "text": "Yes, heart disease. I've been reading about it online and it worried me. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.21,
      "end_seconds": 190.94,
      "duration_seconds": 6.73,
      "text": "Okay, I can see an enlarged prostate and an irregular heartbeat in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.95,
      "end_seconds": 211.16,
      "duration_seconds": 3.21,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.52,
      "end_seconds": 218.87,
      "duration_seconds": 3.35,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.93,
      "end_seconds": 221.62,
      "duration_seconds": 1.69,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.81,
      "end_seconds": 227.34,
      "duration_seconds": 4.53,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.16,
      "end_seconds": 230.9,
      "duration_seconds": 2.74,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.82,
      "end_seconds": 236.06,
      "duration_seconds": 3.24,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.91,
      "end_seconds": 240.36,
      "duration_seconds": 2.45,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 245.02,
      "end_seconds": 250.34,
      "duration_seconds": 5.32,
      "text": "He is on tamsulosin, at night, I give it to him."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.54,
      "end_seconds": 253.49,
      "duration_seconds": 1.95,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 254.77,
      "end_seconds": 268.83,
      "duration_seconds": 14.06,
      "text": "0.4 milligrams, I think that's what's on the box. He is on paracetamol, 650 milligrams, when needed, I give it to him. He takes escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.67,
      "end_seconds": 289.1,
      "duration_seconds": 3.43,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.78,
      "end_seconds": 296.85,
      "duration_seconds": 6.07,
      "text": "My daughter has type 1 diabetes. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.46,
      "end_seconds": 300.24,
      "duration_seconds": 2.78,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.67,
      "end_seconds": 308.15,
      "duration_seconds": 6.48,
      "text": "Erm, um, I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 309.21,
      "end_seconds": 318.17,
      "duration_seconds": 8.96,
      "text": "Doctor, I've got the readings for you. Temperature 38.5, pressure 104 over 74, pulse is 104 beats a minute."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.61,
      "end_seconds": 322.94,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.03,
      "end_seconds": 326.09,
      "duration_seconds": 2.06,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.04,
      "end_seconds": 329.34,
      "duration_seconds": 1.3,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.97,
      "end_seconds": 343.27,
      "duration_seconds": 6.3,
      "text": "The knee is hot, swollen and extremely painful when I move it even slightly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.5,
      "end_seconds": 356.0,
      "duration_seconds": 10.5,
      "text": "Okay, that's enough for me. Taking everything into account, the most likely explanation is possible septic arthritis. We shouldn't forget a gout attack."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 357.97,
      "end_seconds": 360.66,
      "duration_seconds": 2.69,
      "text": "Right, will it clear up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.93,
      "end_seconds": 381.99,
      "duration_seconds": 20.06,
      "text": "I understand the worry. At the moment I'd say it's possible septic arthritis, and we'll know more once the a joint aspiration is back. I think a joint aspiration makes sense here, for hot swollen knee. Let's book urgent blood tests to look into septic arthritis."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.85,
      "end_seconds": 389.93,
      "duration_seconds": 2.08,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.0,
      "end_seconds": 408.09,
      "duration_seconds": 17.09,
      "text": "You need to go to hospital now for a joint washout assessment. Please don't wait if the symptoms get worse. That's when to be seen urgently. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.24,
      "end_seconds": 413.15,
      "duration_seconds": 3.91,
      "text": "Uh, great, thank you for your help."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.79,
      "end_seconds": 416.04,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}