{
  "schema_version": "1.0",
  "encounter_id": "01488",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 4.42,
      "duration_seconds": 3.14,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.06,
      "duration_seconds": 4.0,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.8,
      "end_seconds": 16.76,
      "duration_seconds": 5.96,
      "text": "Doctor, it's throbbing headaches on one side. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.74,
      "end_seconds": 28.18,
      "duration_seconds": 9.44,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.09,
      "end_seconds": 38.09,
      "duration_seconds": 9.0,
      "text": "Moderate, I'd say. It's a couple of times a week. Only a dark room, and it's not much."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.08,
      "end_seconds": 41.8,
      "duration_seconds": 2.72,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.46,
      "end_seconds": 48.43,
      "duration_seconds": 5.97,
      "text": "When it starts I tend to get hating bright light as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.62,
      "end_seconds": 53.81,
      "duration_seconds": 4.19,
      "text": "Has there been zigzag lights before it starts too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.34,
      "end_seconds": 63.36,
      "duration_seconds": 8.02,
      "text": "Yes, about the same, three days. The hating bright light? That's been for one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.88,
      "end_seconds": 67.12,
      "duration_seconds": 2.24,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 77.37,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.97,
      "end_seconds": 81.21,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.0,
      "end_seconds": 94.89,
      "duration_seconds": 5.89,
      "text": "Your eye movements are normal and there is no weakness in your arms or legs."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.89,
      "end_seconds": 107.01,
      "duration_seconds": 7.12,
      "text": "You can sit up now. And what about stiff neck, head injury, weakness or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.92,
      "end_seconds": 111.73,
      "duration_seconds": 2.81,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.02,
      "end_seconds": 118.61,
      "duration_seconds": 2.59,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.49,
      "end_seconds": 121.92,
      "duration_seconds": 1.43,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.77,
      "end_seconds": 126.7,
      "duration_seconds": 2.93,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.66,
      "end_seconds": 129.56,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.54,
      "end_seconds": 132.72,
      "duration_seconds": 2.18,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.21,
      "end_seconds": 140.67,
      "duration_seconds": 6.46,
      "text": "I'm on paracetamol, 1 gram, when needed. Propranolol I don't take anymore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 145.8,
      "duration_seconds": 4.19,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.82,
      "end_seconds": 159.4,
      "duration_seconds": 12.58,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.09,
      "end_seconds": 163.95,
      "duration_seconds": 3.86,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.7,
      "end_seconds": 169.89,
      "duration_seconds": 4.19,
      "text": "My cousin has psoriasis. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.6,
      "end_seconds": 173.29,
      "duration_seconds": 1.69,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.98,
      "end_seconds": 178.27,
      "duration_seconds": 3.29,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.8,
      "end_seconds": 181.31,
      "duration_seconds": 2.51,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.21,
      "end_seconds": 187.08,
      "duration_seconds": 3.87,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.34,
      "end_seconds": 191.54,
      "duration_seconds": 3.2,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.94,
      "end_seconds": 196.26,
      "duration_seconds": 3.32,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.36,
      "end_seconds": 199.81,
      "duration_seconds": 2.45,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.54,
      "end_seconds": 211.86,
      "duration_seconds": 10.32,
      "text": "I have migraines, for about ten years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.04,
      "end_seconds": 219.99,
      "duration_seconds": 6.95,
      "text": "Right, so migraines is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.67,
      "end_seconds": 231.12,
      "duration_seconds": 2.45,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.6,
      "end_seconds": 238.34,
      "duration_seconds": 5.74,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.81,
      "end_seconds": 247.84,
      "duration_seconds": 8.03,
      "text": "Taking everything into account, the most likely explanation is migraine with aura. I can't rule out tension-type headache yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.55,
      "end_seconds": 298.48,
      "duration_seconds": 31.93,
      "text": "I think a headache diary makes sense here, for migraine. We'll begin with sumatriptan, 50 milligrams, at onset, repeat once after two hours if needed, when needed. You take it by mouth. That should help with migraine. Keep a headache diary and avoid skipping meals. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. See me again in six weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.8,
      "end_seconds": 308.97,
      "duration_seconds": 4.17,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.21,
      "end_seconds": 313.21,
      "duration_seconds": 3.0,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.2,
      "end_seconds": 316.55,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}