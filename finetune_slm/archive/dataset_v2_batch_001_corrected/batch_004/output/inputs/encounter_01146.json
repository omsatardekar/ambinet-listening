{
  "schema_version": "1.0",
  "encounter_id": "01146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 7.31,
      "duration_seconds": 6.59,
      "text": "Sorry, what was I saying, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.23,
      "end_seconds": 13.32,
      "duration_seconds": 4.09,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.17,
      "end_seconds": 19.54,
      "duration_seconds": 4.37,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.32,
      "end_seconds": 24.53,
      "duration_seconds": 4.21,
      "text": "Alright, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.2,
      "end_seconds": 30.37,
      "duration_seconds": 4.17,
      "text": "Um, so... hard stools. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.15,
      "end_seconds": 34.5,
      "duration_seconds": 3.35,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.19,
      "end_seconds": 42.96,
      "duration_seconds": 7.77,
      "text": "For about two weeks, I'd say. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.04,
      "end_seconds": 46.26,
      "duration_seconds": 2.22,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.91,
      "end_seconds": 49.15,
      "duration_seconds": 2.24,
      "text": "It's worse with low fibre."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.3,
      "end_seconds": 53.12,
      "duration_seconds": 2.82,
      "text": "Have you been going less often?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.63,
      "end_seconds": 64.1,
      "duration_seconds": 10.47,
      "text": "Yeah, that too. About going less often, pretty mild, if I'm being honest. Actually, there's mild bloating as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.64,
      "end_seconds": 68.88,
      "duration_seconds": 3.24,
      "text": "Has there been any blood in the stool?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.71,
      "end_seconds": 74.07,
      "duration_seconds": 3.36,
      "text": "No. No blood in the stool."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.21,
      "end_seconds": 79.53,
      "duration_seconds": 4.32,
      "text": "Have you had any vomiting, severe pain or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 83.61,
      "duration_seconds": 2.88,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.3,
      "end_seconds": 87.69,
      "duration_seconds": 2.39,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.43,
      "end_seconds": 90.85,
      "duration_seconds": 2.42,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.58,
      "end_seconds": 94.04,
      "duration_seconds": 2.46,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.8,
      "end_seconds": 98.49,
      "duration_seconds": 2.69,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.21,
      "end_seconds": 103.04,
      "duration_seconds": 2.83,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.69,
      "end_seconds": 108.12,
      "duration_seconds": 3.43,
      "text": "An enlarged prostate, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.21,
      "end_seconds": 117.2,
      "duration_seconds": 2.99,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.65,
      "end_seconds": 129.89,
      "duration_seconds": 11.24,
      "text": "I've had depression, yes. I've been putting this off for weeks. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.75,
      "end_seconds": 136.81,
      "duration_seconds": 5.06,
      "text": "Hm, okay. Alright, an enlarged prostate, that matches what I have here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.11,
      "end_seconds": 155.05,
      "duration_seconds": 1.94,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.65,
      "end_seconds": 158.42,
      "duration_seconds": 1.77,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.26,
      "end_seconds": 161.18,
      "duration_seconds": 0.92,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.91,
      "end_seconds": 165.7,
      "duration_seconds": 3.79,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.88,
      "end_seconds": 168.2,
      "duration_seconds": 1.32,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.51,
      "end_seconds": 172.33,
      "duration_seconds": 2.82,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.21,
      "end_seconds": 176.97,
      "duration_seconds": 2.76,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.64,
      "end_seconds": 181.53,
      "duration_seconds": 3.89,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.5,
      "end_seconds": 185.76,
      "duration_seconds": 3.26,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.01,
      "end_seconds": 189.79,
      "duration_seconds": 2.78,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.1,
      "end_seconds": 208.46,
      "duration_seconds": 3.36,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 212.3,
      "end_seconds": 235.24,
      "duration_seconds": 22.94,
      "text": "Uh, he is on tamsulosin, 0.4 milligrams, at night, I give it to him. He is on escitalopram, 10 milligrams, once a day for my mood, I give it to him. He is on a fibre supplement, 1 sachet, daily, I give it to him."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.2,
      "end_seconds": 240.33,
      "duration_seconds": 4.13,
      "text": "Before this I was on mirtazapine; that's been stopped."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.84,
      "end_seconds": 243.57,
      "duration_seconds": 2.73,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.39,
      "end_seconds": 259.2,
      "duration_seconds": 13.81,
      "text": "Okay, you know, so I had a meniscus repair on my knee four years ago. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.31,
      "end_seconds": 275.58,
      "duration_seconds": 5.27,
      "text": "Alright, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.15,
      "end_seconds": 288.42,
      "duration_seconds": 11.27,
      "text": "Erm, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.01,
      "end_seconds": 292.77,
      "duration_seconds": 2.76,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.6,
      "end_seconds": 306.17,
      "duration_seconds": 2.57,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.32,
      "end_seconds": 330.67,
      "duration_seconds": 8.35,
      "text": "Okay: saturation 99 percent, temperature 36.5, pulse is 84 beats a minute. And BP is 112 over 82."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.12,
      "end_seconds": 337.49,
      "duration_seconds": 4.37,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.39,
      "end_seconds": 341.75,
      "duration_seconds": 2.36,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.08,
      "end_seconds": 355.11,
      "duration_seconds": 3.03,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.22,
      "end_seconds": 392.99,
      "duration_seconds": 34.77,
      "text": "That's all I needed to check. From what you've told me and what I found, the most likely explanation is simple constipation from low fibre. You'll be taking lactulose, 15 ml, twice a day, two weeks. It's for constipation. It's a commonly used medicine and most people tolerate it well. Eat more fruit, vegetables and oats, and drink two litres of water. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.61,
      "end_seconds": 396.43,
      "duration_seconds": 2.82,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.48,
      "end_seconds": 401.99,
      "duration_seconds": 3.51,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.07,
      "end_seconds": 405.32,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}