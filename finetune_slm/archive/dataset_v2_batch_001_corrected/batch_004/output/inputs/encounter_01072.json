{
  "schema_version": "1.0",
  "encounter_id": "01072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.58,
      "end_seconds": 4.73,
      "duration_seconds": 4.15,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 9.81,
      "duration_seconds": 3.39,
      "text": "okay, thanks hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 19.37,
      "duration_seconds": 5.38,
      "text": "Yeah, it's being very thirsty. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.96,
      "end_seconds": 23.86,
      "duration_seconds": 2.9,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.38,
      "end_seconds": 27.25,
      "duration_seconds": 2.87,
      "text": "For two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.92,
      "end_seconds": 36.92,
      "duration_seconds": 9.0,
      "text": "Can you describe it a bit more for me? How strong it is what the pattern is what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.01,
      "end_seconds": 45.97,
      "duration_seconds": 6.96,
      "text": "a four out of ten, I suppose. I get some relief from water"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.26,
      "end_seconds": 49.75,
      "duration_seconds": 2.49,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.14,
      "end_seconds": 67.21,
      "duration_seconds": 16.07,
      "text": "When it starts I tend to get tummy pain as well. About tummy pain, it's severe, honestly. I was passing a lot of urine at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.78,
      "end_seconds": 78.6,
      "duration_seconds": 2.82,
      "text": "Any cough or chest pain at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.37,
      "end_seconds": 82.42,
      "duration_seconds": 3.05,
      "text": "no, none that that I've noticed"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.97,
      "end_seconds": 87.68,
      "duration_seconds": 4.71,
      "text": "I follow. Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.62,
      "end_seconds": 90.25,
      "duration_seconds": 1.63,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.99,
      "end_seconds": 94.77,
      "duration_seconds": 2.78,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.4,
      "end_seconds": 104.44,
      "duration_seconds": 8.04,
      "text": "Diabetes, for nearly five years. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.31,
      "end_seconds": 106.01,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.92,
      "end_seconds": 110.79,
      "duration_seconds": 3.87,
      "text": "I've had migraines for five years now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.59,
      "end_seconds": 117.0,
      "duration_seconds": 5.41,
      "text": "Yes, diabetes and migraines are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.28,
      "end_seconds": 138.39,
      "duration_seconds": 3.11,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.96,
      "end_seconds": 141.76,
      "duration_seconds": 2.8,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.83,
      "end_seconds": 144.82,
      "duration_seconds": 1.99,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.34,
      "end_seconds": 149.77,
      "duration_seconds": 4.43,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.77,
      "end_seconds": 153.12,
      "duration_seconds": 2.35,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.22,
      "end_seconds": 158.73,
      "duration_seconds": 4.51,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.36,
      "end_seconds": 166.08,
      "duration_seconds": 3.72,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.68,
      "end_seconds": 169.5,
      "duration_seconds": 2.82,
      "text": "Not to my knowledge no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.53,
      "end_seconds": 173.82,
      "duration_seconds": 3.29,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.61,
      "end_seconds": 178.94,
      "duration_seconds": 4.33,
      "text": "Glibenclamide i take it 5 milligrams, maybe, before breakfast"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.96,
      "end_seconds": 184.74,
      "duration_seconds": 4.78,
      "text": "do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.98,
      "end_seconds": 194.8,
      "duration_seconds": 3.82,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 195.56,
      "end_seconds": 202.13,
      "duration_seconds": 6.57,
      "text": "Doctor, I've got the readings for you. Respiratory rate 16, heart rate 104, pressure 138 over 80."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.95,
      "end_seconds": 206.87,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.55,
      "end_seconds": 212.3,
      "duration_seconds": 3.75,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.49,
      "end_seconds": 214.87,
      "duration_seconds": 1.38,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.56,
      "end_seconds": 233.7,
      "duration_seconds": 4.14,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.72,
      "end_seconds": 237.37,
      "duration_seconds": 1.65,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.09,
      "end_seconds": 265.95,
      "duration_seconds": 10.86,
      "text": "Let me tell you where I've got to. It fits best with diabetic ketoacidosis. A severe infection is also on my list."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.58,
      "end_seconds": 269.79,
      "duration_seconds": 2.21,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.54,
      "end_seconds": 276.87,
      "duration_seconds": 6.33,
      "text": "I can't promise yet but most people with diabetic ketoacidosis do well once it's treated properly"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 278.82,
      "end_seconds": 284.15,
      "duration_seconds": 5.33,
      "text": "I've already done a blood sugar and ketone test, it's ready for you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.16,
      "end_seconds": 318.64,
      "duration_seconds": 29.48,
      "text": "great that's useful. You need to go to hospital now for insulin and fluids. The emergency team would be the right next step I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose. If you cannot get there now or you feel really unwell please come to the emergency department"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.2,
      "end_seconds": 321.95,
      "duration_seconds": 2.75,
      "text": "I know what to watch for"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.66,
      "end_seconds": 330.16,
      "duration_seconds": 7.5,
      "text": "we'll catch up straight away is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.53,
      "end_seconds": 335.34,
      "duration_seconds": 3.81,
      "text": "right, I'll do that. Thank you, doctor"
    }
  ]
}