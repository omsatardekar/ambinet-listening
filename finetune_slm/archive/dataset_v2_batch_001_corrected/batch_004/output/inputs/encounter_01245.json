{
  "schema_version": "1.0",
  "encounter_id": "01245",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.78,
      "duration_seconds": 4.17,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.47,
      "end_seconds": 10.98,
      "duration_seconds": 4.51,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.66,
      "end_seconds": 19.66,
      "duration_seconds": 8.0,
      "text": "Mainly bloating after meals. There's a couple of other things, but that's the the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.73,
      "end_seconds": 22.68,
      "duration_seconds": 1.95,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.56,
      "end_seconds": 26.3,
      "duration_seconds": 2.74,
      "text": "about... well, about two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.76,
      "end_seconds": 33.02,
      "duration_seconds": 6.26,
      "text": "mm, okay. Okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.98,
      "end_seconds": 39.58,
      "duration_seconds": 4.6,
      "text": "mostly severe. I notice it more with fizzy drinks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.69,
      "end_seconds": 43.88,
      "duration_seconds": 3.19,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.68,
      "end_seconds": 52.27,
      "duration_seconds": 6.59,
      "text": "A lot of wind goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.13,
      "end_seconds": 66.35,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.88,
      "end_seconds": 71.19,
      "duration_seconds": 3.31,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.03,
      "end_seconds": 77.42,
      "duration_seconds": 4.39,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.28,
      "end_seconds": 89.74,
      "duration_seconds": 11.46,
      "text": "I live with my elderly mother. I'm a plumber, lots of bending and kneeling. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 102.82,
      "duration_seconds": 2.89,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 108.39,
      "duration_seconds": 4.84,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.98,
      "end_seconds": 113.38,
      "duration_seconds": 4.4,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.98,
      "end_seconds": 119.04,
      "duration_seconds": 4.06,
      "text": "I, I take peppermint capsules, after meals."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.71,
      "end_seconds": 123.66,
      "duration_seconds": 3.95,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.03,
      "end_seconds": 131.28,
      "duration_seconds": 3.25,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.11,
      "end_seconds": 146.96,
      "duration_seconds": 3.85,
      "text": "Have you noticed weight loss, night-time diarrhoea or vomiting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.93,
      "end_seconds": 152.3,
      "duration_seconds": 4.37,
      "text": "No, no weight loss, night-time diarrhoea or vomiting."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.59,
      "end_seconds": 157.13,
      "duration_seconds": 3.54,
      "text": "Has there been any blood in the stool?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.18,
      "end_seconds": 161.31,
      "duration_seconds": 3.13,
      "text": "No, no blood in the stool."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.99,
      "end_seconds": 165.94,
      "duration_seconds": 3.95,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.02,
      "end_seconds": 170.38,
      "duration_seconds": 2.36,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.41,
      "end_seconds": 177.85,
      "duration_seconds": 2.44,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.74,
      "end_seconds": 190.76,
      "duration_seconds": 2.02,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.05,
      "end_seconds": 213.39,
      "duration_seconds": 8.34,
      "text": "okay: BP is 112 over 73, temp 37.0 degrees. And heart rate 68, saturation 98 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.92,
      "end_seconds": 215.35,
      "duration_seconds": 1.43,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.41,
      "end_seconds": 220.68,
      "duration_seconds": 4.27,
      "text": "so, I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.01,
      "end_seconds": 224.49,
      "duration_seconds": 2.48,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.11,
      "end_seconds": 228.29,
      "duration_seconds": 2.18,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.69,
      "end_seconds": 245.64,
      "duration_seconds": 6.95,
      "text": "Your tummy is soft and not tender, and and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.31,
      "end_seconds": 258.37,
      "duration_seconds": 10.06,
      "text": "You can relax now. So where does that leave us? This looks most like a functional bowel pattern, with no alarm features."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.97,
      "end_seconds": 262.97,
      "duration_seconds": 3.0,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.45,
      "end_seconds": 274.81,
      "duration_seconds": 10.36,
      "text": "I can't promise yet, but most people with a functional bowel pattern, with no alarm features do well once it's treated properly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.26,
      "end_seconds": 317.41,
      "duration_seconds": 29.15,
      "text": "Let's book a coeliac blood test to look into bloating. Try smaller meals and keep a food and symptom diary for four weeks. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Do get help quickly if you see blood in the stool or lose weight. Come back in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.26,
      "end_seconds": 321.57,
      "duration_seconds": 2.31,
      "text": "thank you, that's helpful"
    }
  ]
}