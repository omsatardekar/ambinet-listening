{
  "schema_version": "1.0",
  "encounter_id": "01102",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 3.96,
      "duration_seconds": 3.3,
      "text": "Sorry I'm a little late doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 9.56,
      "duration_seconds": 4.1,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.31,
      "end_seconds": 15.39,
      "duration_seconds": 5.08,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.36,
      "end_seconds": 19.81,
      "duration_seconds": 3.45,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.32,
      "end_seconds": 23.73,
      "duration_seconds": 3.41,
      "text": "she's been having a sore ankle, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.9,
      "end_seconds": 28.52,
      "duration_seconds": 3.62,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.78,
      "end_seconds": 38.19,
      "duration_seconds": 4.41,
      "text": "Naproxen, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.03,
      "end_seconds": 42.48,
      "duration_seconds": 2.45,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.4,
      "end_seconds": 60.3,
      "duration_seconds": 15.9,
      "text": "250 milligrams, I think that's what's on the box. Rosuvastatin, 10 milligrams, at night for my cholesterol. Allopurinol. I take it 100 milligrams, once a day for the gout. It's aspirin, once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.92,
      "end_seconds": 64.36,
      "duration_seconds": 2.44,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.65,
      "end_seconds": 67.13,
      "duration_seconds": 1.48,
      "text": "it's 75 milligrams"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.86,
      "end_seconds": 72.0,
      "duration_seconds": 3.14,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.19,
      "end_seconds": 76.86,
      "duration_seconds": 3.67,
      "text": "Um, around two weeks, I think."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.84,
      "end_seconds": 81.75,
      "duration_seconds": 3.91,
      "text": "yeah it was closer to three weeks doctor"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.85,
      "end_seconds": 88.81,
      "duration_seconds": 4.96,
      "text": "okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.79,
      "end_seconds": 92.64,
      "duration_seconds": 1.85,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.18,
      "end_seconds": 98.5,
      "duration_seconds": 4.32,
      "text": "so, is it bearing on you a a lot?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.58,
      "end_seconds": 102.06,
      "duration_seconds": 1.48,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.05,
      "end_seconds": 105.48,
      "duration_seconds": 2.43,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 117.89,
      "duration_seconds": 8.39,
      "text": "It sort of comes and goes. And a little swelling, too. With little swelling, mostly severe."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.05,
      "end_seconds": 132.78,
      "duration_seconds": 7.73,
      "text": "let me check a few things any numbness, pain in the foot or crack or pop?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.63,
      "end_seconds": 140.49,
      "duration_seconds": 5.86,
      "text": "no numbness pain in the foot or crack or pop none of it"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.04,
      "end_seconds": 144.74,
      "duration_seconds": 3.7,
      "text": "anything with your heart like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.61,
      "end_seconds": 151.46,
      "duration_seconds": 5.85,
      "text": "sorry, what was I saying, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.38,
      "end_seconds": 156.01,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.02,
      "end_seconds": 159.44,
      "duration_seconds": 1.42,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.26,
      "end_seconds": 165.84,
      "duration_seconds": 4.58,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.61,
      "end_seconds": 169.54,
      "duration_seconds": 1.93,
      "text": "my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.08,
      "end_seconds": 175.4,
      "duration_seconds": 4.32,
      "text": "tell me about your routine work habits that sort of thing"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.16,
      "end_seconds": 187.82,
      "duration_seconds": 11.66,
      "text": "I grab fast food at lunch most days. My husband and I live above the shop. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.67,
      "end_seconds": 190.95,
      "duration_seconds": 2.28,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.31,
      "end_seconds": 211.29,
      "duration_seconds": 18.98,
      "text": "I have arthritis in my knees, for about a year. I've got high cholesterol. I've never really been one for hospitals. I've had gout for about ten years now. I have heart disease. It's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.51,
      "end_seconds": 223.51,
      "duration_seconds": 11.0,
      "text": "right, so arthritis in your knees and high cholesterol are already on your record we'll keep that in mind today okay, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.39,
      "end_seconds": 230.58,
      "duration_seconds": 6.19,
      "text": "uh yes I had two stents put in my heart three years ago"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.03,
      "end_seconds": 242.61,
      "duration_seconds": 2.58,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.81,
      "end_seconds": 251.77,
      "duration_seconds": 1.96,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.66,
      "end_seconds": 272.22,
      "duration_seconds": 8.56,
      "text": "okay: temperature 36.8, pressure 120 over 77, heart rate 64. And saturation 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.7,
      "end_seconds": 275.29,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.96,
      "end_seconds": 279.86,
      "duration_seconds": 2.9,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.0,
      "end_seconds": 284.19,
      "duration_seconds": 3.19,
      "text": "right let's have a proper look at you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.03,
      "end_seconds": 287.06,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.32,
      "end_seconds": 304.22,
      "duration_seconds": 7.9,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.96,
      "end_seconds": 310.66,
      "duration_seconds": 2.7,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.4,
      "end_seconds": 342.75,
      "duration_seconds": 23.35,
      "text": "so, based on the history and the examination, I think we're dealing with a mild ankle sprain at this stage. We shouldn't forget a minor fracture. Rest, ice, a compression bandage and keep it raised for two days. Come back if it is not better in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.15,
      "end_seconds": 348.67,
      "duration_seconds": 4.52,
      "text": "great, um, thank you for your help"
    }
  ]
}