{
  "schema_version": "1.0",
  "encounter_id": "01167",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.02,
      "duration_seconds": 4.11,
      "text": "hi doctor, um, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 11.6,
      "duration_seconds": 4.91,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 19.56,
      "duration_seconds": 6.27,
      "text": "Yeah, it's a stiff neck. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.2,
      "end_seconds": 23.88,
      "duration_seconds": 3.68,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.71,
      "end_seconds": 36.22,
      "duration_seconds": 2.51,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.87,
      "end_seconds": 60.47,
      "duration_seconds": 11.6,
      "text": "Okay: respiratory rate 21, temp 38.0 degrees, pulse 103, BP is 110 over 73. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.24,
      "end_seconds": 73.9,
      "duration_seconds": 11.66,
      "text": "It's been going on for about a week. I took the morning off to come in today. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.96,
      "end_seconds": 79.49,
      "duration_seconds": 3.53,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.13,
      "end_seconds": 86.15,
      "duration_seconds": 1.02,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 87.21,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.07,
      "end_seconds": 98.03,
      "duration_seconds": 8.96,
      "text": "Erm, there's a severe headache as well. As for severe headache, I notice it more with light."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.32,
      "end_seconds": 103.45,
      "duration_seconds": 4.13,
      "text": "Okay, have you had a rash that does not fade?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.61,
      "end_seconds": 110.84,
      "duration_seconds": 6.23,
      "text": "yes, actually about rash that does not fade, I'd call it mild"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.89,
      "end_seconds": 115.47,
      "duration_seconds": 3.58,
      "text": "a few quick ones: recent head injury or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.99,
      "end_seconds": 120.0,
      "duration_seconds": 4.01,
      "text": "Okay, so no, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.73,
      "end_seconds": 125.64,
      "duration_seconds": 4.91,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.16,
      "end_seconds": 127.78,
      "duration_seconds": 1.62,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.73,
      "end_seconds": 133.42,
      "duration_seconds": 3.69,
      "text": "On the the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.91,
      "end_seconds": 140.89,
      "duration_seconds": 5.98,
      "text": "um, my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.89,
      "end_seconds": 145.67,
      "duration_seconds": 3.78,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.27,
      "end_seconds": 148.39,
      "duration_seconds": 1.12,
      "text": "yes, gout"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.8,
      "end_seconds": 152.42,
      "duration_seconds": 2.62,
      "text": "So, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.71,
      "end_seconds": 159.1,
      "duration_seconds": 5.39,
      "text": "Actually, I'm on allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.62,
      "end_seconds": 179.52,
      "duration_seconds": 2.9,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.2,
      "end_seconds": 186.44,
      "duration_seconds": 6.24,
      "text": "I had a caesarean for my second baby nine years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.4,
      "end_seconds": 189.73,
      "duration_seconds": 2.33,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.39,
      "end_seconds": 196.08,
      "duration_seconds": 5.69,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.88,
      "end_seconds": 200.88,
      "duration_seconds": 3.0,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.57,
      "end_seconds": 204.89,
      "duration_seconds": 3.32,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.9,
      "end_seconds": 227.17,
      "duration_seconds": 4.27,
      "text": "So, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.14,
      "end_seconds": 232.53,
      "duration_seconds": 4.39,
      "text": "I mean, um, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.58,
      "end_seconds": 238.81,
      "duration_seconds": 5.23,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.17,
      "end_seconds": 242.03,
      "duration_seconds": 1.86,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.55,
      "end_seconds": 269.08,
      "duration_seconds": 8.53,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.73,
      "end_seconds": 275.71,
      "duration_seconds": 1.98,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.53,
      "end_seconds": 307.5,
      "duration_seconds": 14.97,
      "text": "so where does that leave us? It's hard to say. Possible bacterial meningitis is one possibility and meningococcal septicaemia another, and I'd rather not commit yet. We should do blood cultures for possible meningitis"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 309.1,
      "end_seconds": 313.0,
      "duration_seconds": 3.9,
      "text": "I can book that for Tuesday at 11:30 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.42,
      "end_seconds": 317.02,
      "duration_seconds": 2.6,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.85,
      "end_seconds": 342.08,
      "duration_seconds": 23.23,
      "text": "we'll begin with benzylpenicillin, 1.2 grams, once now, single dose it's for possible meningitis the pharmacy will go through the details again when you pick it up call an ambulance now, this is an emergency if you cannot go now, or you feel really unwell, please come to the emergency department"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.62,
      "end_seconds": 345.92,
      "duration_seconds": 2.3,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.45,
      "end_seconds": 350.32,
      "duration_seconds": 2.87,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.23,
      "end_seconds": 361.54,
      "duration_seconds": 5.31,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.46,
      "end_seconds": 364.65,
      "duration_seconds": 1.19,
      "text": "take care now"
    }
  ]
}