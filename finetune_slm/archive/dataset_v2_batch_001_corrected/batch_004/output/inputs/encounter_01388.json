{
  "schema_version": "1.0",
  "encounter_id": "01388",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 5.24,
      "duration_seconds": 4.34,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.98,
      "end_seconds": 13.85,
      "duration_seconds": 3.87,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.87,
      "end_seconds": 20.97,
      "duration_seconds": 6.1,
      "text": "Doctor, it's planning a trip. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.06,
      "end_seconds": 27.16,
      "duration_seconds": 4.1,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.74,
      "end_seconds": 29.25,
      "duration_seconds": 1.51,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.3,
      "end_seconds": 32.84,
      "duration_seconds": 2.54,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.97,
      "end_seconds": 49.41,
      "duration_seconds": 15.44,
      "text": "A mild sore arm from last injection goes along with it, most of the time. The mild sore arm from last injection? That's been for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.43,
      "end_seconds": 53.78,
      "duration_seconds": 3.35,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.75,
      "end_seconds": 57.88,
      "duration_seconds": 3.13,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.88,
      "end_seconds": 79.5,
      "duration_seconds": 3.62,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.9,
      "end_seconds": 82.08,
      "duration_seconds": 1.18,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.08,
      "end_seconds": 85.06,
      "duration_seconds": 0.98,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.81,
      "end_seconds": 90.91,
      "duration_seconds": 4.1,
      "text": "I have COPD. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.01,
      "end_seconds": 94.85,
      "duration_seconds": 2.84,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.94,
      "end_seconds": 99.77,
      "duration_seconds": 3.83,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.42,
      "end_seconds": 113.97,
      "duration_seconds": 2.55,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.55,
      "end_seconds": 130.3,
      "duration_seconds": 14.75,
      "text": "I gave up cigarettes last spring. My husband and I live above the shop. I swim twice a week. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.08,
      "end_seconds": 134.83,
      "duration_seconds": 3.75,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.91,
      "end_seconds": 150.03,
      "duration_seconds": 13.12,
      "text": "I take allopurinol, 100 milligrams, once a day for the gout. Tiotropium inhaler, once a day. Aspirin, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.91,
      "end_seconds": 156.64,
      "duration_seconds": 4.73,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.3,
      "end_seconds": 161.52,
      "duration_seconds": 4.22,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.24,
      "end_seconds": 169.11,
      "duration_seconds": 3.87,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.5,
      "end_seconds": 173.26,
      "duration_seconds": 2.76,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.97,
      "end_seconds": 186.25,
      "duration_seconds": 3.28,
      "text": "Have you noticed rash, fever or recent illness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.57,
      "end_seconds": 190.05,
      "duration_seconds": 2.48,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.5,
      "end_seconds": 194.42,
      "duration_seconds": 2.92,
      "text": "Right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.82,
      "end_seconds": 196.73,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.74,
      "end_seconds": 201.1,
      "duration_seconds": 3.36,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.92,
      "end_seconds": 211.35,
      "duration_seconds": 3.43,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.91,
      "end_seconds": 235.89,
      "duration_seconds": 6.98,
      "text": "Okay: saturation 97 percent, heart rate 82, temp 37.0 degrees, blood pressure 126 over 77."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.76,
      "end_seconds": 238.44,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.13,
      "end_seconds": 241.51,
      "duration_seconds": 2.38,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 246.43,
      "duration_seconds": 3.68,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.15,
      "end_seconds": 248.64,
      "duration_seconds": 1.49,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.57,
      "end_seconds": 251.77,
      "duration_seconds": 2.2,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.42,
      "end_seconds": 272.18,
      "duration_seconds": 3.76,
      "text": "Your temperature is normal and you look well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.45,
      "end_seconds": 277.98,
      "duration_seconds": 1.53,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.89,
      "end_seconds": 315.17,
      "duration_seconds": 32.28,
      "text": "Thank you, you can get dressed. So where does that leave us? My working impression is fit to have travel vaccinations. You'll be taking hepatitis A vaccine, 1 dose, once, single dose. That should help with travel. Drink bottled water and use insect repellent. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'll want another look in six months for the booster."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.17,
      "end_seconds": 317.87,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.56,
      "end_seconds": 321.43,
      "duration_seconds": 2.87,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.98,
      "end_seconds": 329.12,
      "duration_seconds": 3.14,
      "text": "Yeah, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.29,
      "end_seconds": 331.87,
      "duration_seconds": 1.58,
      "text": "Have a good day."
    }
  ]
}