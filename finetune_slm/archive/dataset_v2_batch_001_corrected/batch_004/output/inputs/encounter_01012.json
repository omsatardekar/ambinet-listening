{
  "schema_version": "1.0",
  "encounter_id": "01012",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 6.36,
      "duration_seconds": 5.61,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.22,
      "end_seconds": 13.18,
      "duration_seconds": 4.96,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.76,
      "end_seconds": 21.87,
      "duration_seconds": 8.11,
      "text": "Well, I've been having trouble passing urine. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.26,
      "end_seconds": 26.19,
      "duration_seconds": 2.93,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.65,
      "end_seconds": 30.56,
      "duration_seconds": 2.91,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.72,
      "end_seconds": 34.62,
      "duration_seconds": 2.9,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.39,
      "end_seconds": 42.66,
      "duration_seconds": 4.27,
      "text": "Oh, a a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.3,
      "end_seconds": 48.73,
      "duration_seconds": 4.43,
      "text": "Let me check a few things. Any fever or recent fall?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.75,
      "end_seconds": 54.73,
      "duration_seconds": 3.98,
      "text": "I haven't had fever or recent fall, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.62,
      "end_seconds": 61.53,
      "duration_seconds": 1.91,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.52,
      "end_seconds": 65.2,
      "duration_seconds": 1.68,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.14,
      "end_seconds": 84.11,
      "duration_seconds": 4.97,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.72,
      "end_seconds": 92.05,
      "duration_seconds": 6.33,
      "text": "Not currently, but as a a youngster erythromycin gave me a rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.76,
      "end_seconds": 95.09,
      "duration_seconds": 1.33,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.81,
      "end_seconds": 98.97,
      "duration_seconds": 3.16,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.97,
      "end_seconds": 102.51,
      "duration_seconds": 2.54,
      "text": "alright, is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.65,
      "end_seconds": 107.64,
      "duration_seconds": 3.99,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.0,
      "end_seconds": 127.79,
      "duration_seconds": 3.79,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.1,
      "end_seconds": 130.76,
      "duration_seconds": 1.66,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.24,
      "end_seconds": 136.6,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.67,
      "end_seconds": 140.68,
      "duration_seconds": 3.01,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.59,
      "end_seconds": 147.65,
      "duration_seconds": 3.06,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.29,
      "end_seconds": 149.9,
      "duration_seconds": 1.61,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.64,
      "end_seconds": 171.13,
      "duration_seconds": 4.49,
      "text": "Can I check a a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.6,
      "end_seconds": 183.11,
      "duration_seconds": 2.51,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.62,
      "end_seconds": 211.37,
      "duration_seconds": 7.75,
      "text": "Okay: saturation 97 percent, blood pressure 118 over 80, temp 36.6 degrees. And pulse 67, respiratory rate 14."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.18,
      "end_seconds": 219.92,
      "duration_seconds": 2.74,
      "text": "Is that that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.77,
      "end_seconds": 224.57,
      "duration_seconds": 2.8,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.66,
      "end_seconds": 230.11,
      "duration_seconds": 4.45,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.19,
      "end_seconds": 248.09,
      "duration_seconds": 0.9,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.6,
      "end_seconds": 250.82,
      "duration_seconds": 1.22,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.65,
      "end_seconds": 267.57,
      "duration_seconds": 5.92,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.88,
      "end_seconds": 290.86,
      "duration_seconds": 18.98,
      "text": "Right, thank you, you can get dressed. Right, here's what I'm thinking. It fits best with possible cauda equina syndrome needing an urgent scan. You need to go to hospital now for an emergency scan. Come back or go to emergency straight away if the numbness spreads."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.19,
      "end_seconds": 293.89,
      "duration_seconds": 1.7,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.93,
      "end_seconds": 298.92,
      "duration_seconds": 3.99,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.54,
      "end_seconds": 302.7,
      "duration_seconds": 2.16,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.62,
      "end_seconds": 306.55,
      "duration_seconds": 1.93,
      "text": "So, look after yourself."
    }
  ]
}