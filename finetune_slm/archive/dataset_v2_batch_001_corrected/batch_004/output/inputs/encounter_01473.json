{
  "schema_version": "1.0",
  "encounter_id": "01473",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 5.3,
      "duration_seconds": 4.57,
      "text": "Erm, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.51,
      "duration_seconds": 3.69,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.38,
      "end_seconds": 17.55,
      "duration_seconds": 5.17,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 22.12,
      "duration_seconds": 2.54,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.75,
      "end_seconds": 28.22,
      "duration_seconds": 5.47,
      "text": "doctor, it's been feeling well. That's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.71,
      "end_seconds": 31.65,
      "duration_seconds": 1.94,
      "text": "so, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.28,
      "end_seconds": 34.71,
      "duration_seconds": 2.43,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.72,
      "end_seconds": 39.31,
      "duration_seconds": 3.59,
      "text": "It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.98,
      "end_seconds": 44.54,
      "duration_seconds": 4.56,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.47,
      "end_seconds": 48.78,
      "duration_seconds": 2.31,
      "text": "Yeah, you know, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.92,
      "end_seconds": 52.75,
      "duration_seconds": 2.83,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.77,
      "end_seconds": 64.84,
      "duration_seconds": 10.07,
      "text": "When it starts I tend to get slightly dry skin as well. The slightly dry skin? That's been since yesterday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.04,
      "end_seconds": 72.32,
      "duration_seconds": 7.28,
      "text": "I see, go ahead. Okay, have you been feeling well at any time before this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.9,
      "end_seconds": 77.84,
      "duration_seconds": 4.94,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 92.0,
      "duration_seconds": 2.92,
      "text": "so, and what about palpitations or constipation?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.51,
      "end_seconds": 96.04,
      "duration_seconds": 2.53,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.68,
      "end_seconds": 101.2,
      "duration_seconds": 3.52,
      "text": "Did you get feeling cold or weight change?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.41,
      "end_seconds": 105.88,
      "duration_seconds": 3.47,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.69,
      "end_seconds": 109.63,
      "duration_seconds": 2.94,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.66,
      "end_seconds": 113.24,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.78,
      "end_seconds": 120.04,
      "duration_seconds": 2.26,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.82,
      "end_seconds": 122.91,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.5,
      "end_seconds": 127.89,
      "duration_seconds": 3.39,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.5,
      "end_seconds": 133.91,
      "duration_seconds": 5.41,
      "text": "I've had an underactive thyroid for about a year now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.4,
      "end_seconds": 140.35,
      "duration_seconds": 4.95,
      "text": "okay, I can see an underactive thyroid in your file as well"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.41,
      "end_seconds": 153.93,
      "duration_seconds": 5.52,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.61,
      "end_seconds": 168.3,
      "duration_seconds": 12.69,
      "text": "No, I share a house with my brother. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.7,
      "end_seconds": 170.88,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.83,
      "end_seconds": 173.96,
      "duration_seconds": 1.13,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.67,
      "end_seconds": 192.48,
      "duration_seconds": 4.81,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.2,
      "end_seconds": 196.53,
      "duration_seconds": 3.33,
      "text": "Yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.51,
      "end_seconds": 201.25,
      "duration_seconds": 3.74,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.18,
      "end_seconds": 208.1,
      "duration_seconds": 4.92,
      "text": "Eltroxin. I take it every morning for my thyroid"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.49,
      "end_seconds": 211.85,
      "duration_seconds": 2.36,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.83,
      "end_seconds": 214.95,
      "duration_seconds": 1.12,
      "text": "100 micrograms."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.88,
      "end_seconds": 219.34,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.06,
      "end_seconds": 228.23,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.45,
      "end_seconds": 253.33,
      "duration_seconds": 8.88,
      "text": "Okay: temperature is 37.0 degrees, pulse 84, respiratory rate 14, pressure 111 over 81, saturation 97 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.9,
      "end_seconds": 255.3,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.92,
      "end_seconds": 258.91,
      "duration_seconds": 2.99,
      "text": "Okay, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.18,
      "end_seconds": 264.8,
      "duration_seconds": 3.62,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.08,
      "end_seconds": 268.03,
      "duration_seconds": 1.95,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.54,
      "end_seconds": 284.87,
      "duration_seconds": 5.33,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.5,
      "end_seconds": 314.79,
      "duration_seconds": 24.29,
      "text": "So, good, you can sit up again. So where does that leave us? It fits best with well-controlled thyroid replacement. Let's get a thyroid blood test, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. I'd like you back in twelve months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.53,
      "end_seconds": 318.67,
      "duration_seconds": 3.14,
      "text": "I think I understand everything. Thanks"
    }
  ]
}