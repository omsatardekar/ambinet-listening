{
  "schema_version": "1.0",
  "encounter_id": "01097",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.37,
      "duration_seconds": 3.65,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 10.04,
      "duration_seconds": 4.51,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.34,
      "end_seconds": 14.92,
      "duration_seconds": 3.58,
      "text": "Well, I've been having crushing chest pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.81,
      "end_seconds": 23.15,
      "duration_seconds": 3.34,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.55,
      "end_seconds": 28.22,
      "duration_seconds": 3.67,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.14,
      "end_seconds": 32.83,
      "duration_seconds": 2.69,
      "text": "So, what eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.18,
      "end_seconds": 37.34,
      "duration_seconds": 3.16,
      "text": "I get some relief from rest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.74,
      "end_seconds": 41.16,
      "duration_seconds": 2.42,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.85,
      "end_seconds": 47.45,
      "duration_seconds": 5.6,
      "text": "Yeah, that too. With feeling sick, it's on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.25,
      "end_seconds": 53.52,
      "duration_seconds": 5.27,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.44,
      "end_seconds": 66.91,
      "duration_seconds": 2.47,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.86,
      "end_seconds": 96.04,
      "duration_seconds": 13.18,
      "text": "Okay: height 180 centimetres, weight 62 kilos, oxygen saturation is 98 percent. And pressure 130 over 82, pulse 107. Let me check a few things. Any cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.8,
      "end_seconds": 100.99,
      "duration_seconds": 4.19,
      "text": "No, no cough, leg swelling or fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.45,
      "end_seconds": 103.9,
      "duration_seconds": 1.45,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.74,
      "end_seconds": 107.53,
      "duration_seconds": 2.79,
      "text": "Mm, no, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.58,
      "end_seconds": 119.6,
      "duration_seconds": 5.02,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.98,
      "end_seconds": 123.86,
      "duration_seconds": 2.88,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.35,
      "end_seconds": 136.61,
      "duration_seconds": 1.26,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.14,
      "end_seconds": 141.34,
      "duration_seconds": 3.2,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.9,
      "end_seconds": 143.82,
      "duration_seconds": 0.92,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.64,
      "end_seconds": 148.44,
      "duration_seconds": 3.8,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.16,
      "end_seconds": 152.6,
      "duration_seconds": 2.44,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.88,
      "end_seconds": 159.73,
      "duration_seconds": 3.85,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.77,
      "end_seconds": 163.06,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.72,
      "end_seconds": 167.62,
      "duration_seconds": 2.9,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.1,
      "end_seconds": 173.05,
      "duration_seconds": 3.95,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.82,
      "end_seconds": 177.22,
      "duration_seconds": 3.4,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 193.47,
      "duration_seconds": 3.76,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.74,
      "end_seconds": 200.26,
      "duration_seconds": 2.52,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.11,
      "end_seconds": 203.85,
      "duration_seconds": 2.74,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.59,
      "end_seconds": 206.17,
      "duration_seconds": 1.58,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.89,
      "end_seconds": 235.75,
      "duration_seconds": 10.86,
      "text": "Putting together what you've described, the most likely explanation is a possible heart attack. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.97,
      "end_seconds": 239.04,
      "duration_seconds": 2.07,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.95,
      "end_seconds": 252.84,
      "duration_seconds": 11.89,
      "text": "It's reasonable to be concerned, but right now a possible heart attack is my leading thought, not anything worse. I'll request an ECG, it'll help with chest pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 253.91,
      "end_seconds": 256.67,
      "duration_seconds": 2.76,
      "text": "The earliest is Monday, 2 pm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.25,
      "end_seconds": 269.15,
      "duration_seconds": 7.9,
      "text": "The treatment will be aspirin, 300 milligrams, once now, single dose. It's for possible heart attack."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.96,
      "end_seconds": 275.85,
      "duration_seconds": 4.89,
      "text": "Erm, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.83,
      "end_seconds": 286.62,
      "duration_seconds": 9.79,
      "text": "Stay lying down and do not eat or drink. Come back or go to emergency straight away if the pain returns."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.64,
      "end_seconds": 288.57,
      "duration_seconds": 0.93,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.62,
      "end_seconds": 297.95,
      "duration_seconds": 7.33,
      "text": "I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.48,
      "end_seconds": 304.13,
      "duration_seconds": 4.65,
      "text": "Good, um, thanks, I'll see you then."
    }
  ]
}