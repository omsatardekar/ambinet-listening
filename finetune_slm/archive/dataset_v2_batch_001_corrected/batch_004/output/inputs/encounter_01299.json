{
  "schema_version": "1.0",
  "encounter_id": "01299",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 4.42,
      "duration_seconds": 3.09,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.92,
      "end_seconds": 12.14,
      "duration_seconds": 1.22,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.44,
      "end_seconds": 16.62,
      "duration_seconds": 3.18,
      "text": "right, how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.54,
      "end_seconds": 24.36,
      "duration_seconds": 6.82,
      "text": "yeah, it's an itchy patch on my wrist i don't know what's causing it"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 28.48,
      "end_seconds": 38.55,
      "duration_seconds": 10.07,
      "text": "Here are the numbers, doctor. Pressure 114 over 78, respiratory rate 16, temperature is 36.4 degrees, heart rate 85, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.46,
      "end_seconds": 47.43,
      "duration_seconds": 7.97,
      "text": "thanks can you tell me when it first started? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.27,
      "end_seconds": 51.46,
      "duration_seconds": 3.19,
      "text": "it's been like this since Monday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 61.67,
      "duration_seconds": 8.76,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.71,
      "end_seconds": 68.39,
      "duration_seconds": 5.68,
      "text": "I'd say moderate. My new watch strap definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.2,
      "end_seconds": 72.1,
      "duration_seconds": 2.9,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.38,
      "end_seconds": 79.38,
      "duration_seconds": 6.0,
      "text": "Dry flaky skin goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.28,
      "end_seconds": 84.85,
      "duration_seconds": 3.57,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.04,
      "end_seconds": 88.33,
      "duration_seconds": 2.29,
      "text": "I'd call it it moderate"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.64,
      "end_seconds": 109.11,
      "duration_seconds": 4.47,
      "text": "Let me check a few things. Any blisters or spreading?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.95,
      "end_seconds": 114.07,
      "duration_seconds": 4.12,
      "text": "Um, no, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.31,
      "end_seconds": 117.68,
      "duration_seconds": 2.37,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.86,
      "end_seconds": 120.31,
      "duration_seconds": 1.45,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.19,
      "end_seconds": 124.83,
      "duration_seconds": 3.64,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.4,
      "end_seconds": 127.53,
      "duration_seconds": 2.13,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.39,
      "end_seconds": 130.58,
      "duration_seconds": 1.19,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.62,
      "end_seconds": 134.88,
      "duration_seconds": 3.26,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.69,
      "end_seconds": 137.96,
      "duration_seconds": 1.27,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.03,
      "end_seconds": 143.33,
      "duration_seconds": 4.3,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.0,
      "end_seconds": 147.01,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.41,
      "end_seconds": 152.54,
      "duration_seconds": 4.13,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.07,
      "end_seconds": 155.13,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.29,
      "end_seconds": 162.46,
      "duration_seconds": 6.17,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.87,
      "end_seconds": 174.75,
      "duration_seconds": 3.88,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.4,
      "end_seconds": 182.49,
      "duration_seconds": 5.09,
      "text": "Yeah, I'm on a plain moisturiser, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.93,
      "end_seconds": 201.07,
      "duration_seconds": 4.14,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.73,
      "end_seconds": 204.18,
      "duration_seconds": 2.45,
      "text": "Not really, um, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.1,
      "end_seconds": 211.4,
      "duration_seconds": 5.3,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.32,
      "end_seconds": 215.08,
      "duration_seconds": 2.76,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.7,
      "end_seconds": 220.01,
      "duration_seconds": 3.31,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.57,
      "end_seconds": 223.16,
      "duration_seconds": 1.59,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.15,
      "end_seconds": 226.42,
      "duration_seconds": 2.27,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.04,
      "end_seconds": 250.05,
      "duration_seconds": 6.01,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.46,
      "end_seconds": 257.31,
      "duration_seconds": 1.85,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.93,
      "end_seconds": 282.42,
      "duration_seconds": 7.49,
      "text": "So where does that leave us? This looks most like mild contact dermatitis from the watch strap."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.0,
      "end_seconds": 287.17,
      "duration_seconds": 3.17,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.02,
      "end_seconds": 320.68,
      "duration_seconds": 32.66,
      "text": "I understand the worry. At the moment I'd say it's mild contact dermatitis from the watch strap, and we'll watch how it goes. What I'm giving you is hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. I'd like you back if it has not cleared in two weeks. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.56,
      "end_seconds": 336.24,
      "duration_seconds": 13.68,
      "text": "So, I take the hydrocortisone cream, 1%, once a day and come back if it has not cleared in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.31,
      "end_seconds": 343.7,
      "duration_seconds": 5.39,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.33,
      "end_seconds": 348.88,
      "duration_seconds": 3.55,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.87,
      "end_seconds": 355.33,
      "duration_seconds": 1.46,
      "text": "Look after yourself."
    }
  ]
}