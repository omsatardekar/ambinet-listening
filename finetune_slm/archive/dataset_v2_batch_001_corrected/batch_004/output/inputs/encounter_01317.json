{
  "schema_version": "1.0",
  "encounter_id": "01317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 6.32,
      "duration_seconds": 5.08,
      "text": "Doctor? Hello, I hope this is the the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.98,
      "end_seconds": 14.04,
      "duration_seconds": 6.06,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.34,
      "end_seconds": 24.33,
      "duration_seconds": 8.99,
      "text": "Honestly, it's shaking chills and a high temperature, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.28,
      "end_seconds": 26.7,
      "duration_seconds": 1.42,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.48,
      "end_seconds": 37.72,
      "duration_seconds": 10.24,
      "text": "Oh, ever since... since last weekend, really. Hmm, and there's a racing heart as well, about a month now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.67,
      "end_seconds": 46.34,
      "duration_seconds": 6.67,
      "text": "Have you had shaking chills and a high temperature before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.2,
      "end_seconds": 58.64,
      "duration_seconds": 11.44,
      "text": "yes, you know, something like this happened about six months ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.13,
      "end_seconds": 65.97,
      "duration_seconds": 2.84,
      "text": "And what about stiff neck or rash?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.12,
      "end_seconds": 70.98,
      "duration_seconds": 3.86,
      "text": "Right, no, no stiff neck or rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.28,
      "end_seconds": 78.97,
      "duration_seconds": 2.69,
      "text": "And chest pain, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 84.22,
      "duration_seconds": 3.82,
      "text": "Right, I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.82,
      "end_seconds": 87.77,
      "duration_seconds": 1.95,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.51,
      "end_seconds": 89.57,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.13,
      "end_seconds": 93.78,
      "duration_seconds": 2.65,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.35,
      "end_seconds": 100.7,
      "duration_seconds": 3.35,
      "text": "Ah, no, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.08,
      "end_seconds": 107.6,
      "duration_seconds": 2.52,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.68,
      "end_seconds": 116.78,
      "duration_seconds": 4.1,
      "text": "I've had eczema for about a year now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.54,
      "end_seconds": 119.81,
      "duration_seconds": 1.27,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.46,
      "end_seconds": 126.33,
      "duration_seconds": 4.87,
      "text": "mm, uh, no, I've never been operated on"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.47,
      "end_seconds": 130.79,
      "duration_seconds": 3.32,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.62,
      "end_seconds": 135.57,
      "duration_seconds": 2.95,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.61,
      "end_seconds": 147.01,
      "duration_seconds": 3.4,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.76,
      "end_seconds": 152.35,
      "duration_seconds": 3.59,
      "text": "It's, It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.84,
      "end_seconds": 170.02,
      "duration_seconds": 2.18,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.95,
      "end_seconds": 175.13,
      "duration_seconds": 4.18,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.94,
      "end_seconds": 178.8,
      "duration_seconds": 1.86,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.6,
      "end_seconds": 185.08,
      "duration_seconds": 4.48,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.62,
      "end_seconds": 189.39,
      "duration_seconds": 2.77,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.88,
      "end_seconds": 196.08,
      "duration_seconds": 5.2,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.69,
      "end_seconds": 215.55,
      "duration_seconds": 2.86,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.15,
      "end_seconds": 224.7,
      "duration_seconds": 2.55,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.6,
      "end_seconds": 247.38,
      "duration_seconds": 10.78,
      "text": "Okay: blood pressure 110 over 70, pulse is 104 beats a minute, respiratory rate 18. And SpO2 95 percent on room air, temperature 38.2."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.0,
      "end_seconds": 250.48,
      "duration_seconds": 1.48,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.19,
      "end_seconds": 254.8,
      "duration_seconds": 2.61,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.68,
      "end_seconds": 260.96,
      "duration_seconds": 4.28,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.27,
      "end_seconds": 264.43,
      "duration_seconds": 2.16,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.24,
      "end_seconds": 279.9,
      "duration_seconds": 6.66,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.17,
      "end_seconds": 309.18,
      "duration_seconds": 24.01,
      "text": "That's all I needed to check. Having listened and examined, I'd lean towards possible sepsis needing urgent treatment. I want blood cultures done, that's for fever with low blood pressure. I want to admit you to hospital now for fluids and antibiotics. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.41,
      "end_seconds": 311.99,
      "duration_seconds": 1.58,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.62,
      "end_seconds": 316.48,
      "duration_seconds": 2.86,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.54,
      "end_seconds": 322.07,
      "duration_seconds": 3.53,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}