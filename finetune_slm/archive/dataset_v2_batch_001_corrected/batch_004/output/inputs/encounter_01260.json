{
  "schema_version": "1.0",
  "encounter_id": "01260",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 3.34,
      "duration_seconds": 2.81,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 9.17,
      "duration_seconds": 3.96,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.84,
      "end_seconds": 12.17,
      "duration_seconds": 2.33,
      "text": "It's shaking chills, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.05,
      "end_seconds": 16.71,
      "duration_seconds": 3.66,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.19,
      "end_seconds": 28.85,
      "duration_seconds": 10.66,
      "text": "Yesterday, it came on out of nowhere. I'm hoping you can tell me something definite. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.37,
      "end_seconds": 31.96,
      "duration_seconds": 2.59,
      "text": "Yes. How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.96,
      "end_seconds": 36.38,
      "duration_seconds": 3.42,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.52,
      "end_seconds": 40.67,
      "duration_seconds": 3.15,
      "text": "A few quick ones: rash or diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.26,
      "end_seconds": 45.7,
      "duration_seconds": 3.44,
      "text": "I haven't had rash or diarrhoea, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.91,
      "end_seconds": 52.08,
      "duration_seconds": 1.17,
      "text": "How about cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.17,
      "end_seconds": 56.68,
      "duration_seconds": 2.51,
      "text": "Not at all, no cough."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.13,
      "end_seconds": 61.35,
      "duration_seconds": 3.22,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.21,
      "end_seconds": 65.49,
      "duration_seconds": 2.28,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.41,
      "end_seconds": 78.75,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.23,
      "end_seconds": 83.73,
      "duration_seconds": 3.5,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.67,
      "end_seconds": 88.24,
      "duration_seconds": 3.57,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.64,
      "end_seconds": 93.31,
      "duration_seconds": 3.67,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.64,
      "end_seconds": 100.25,
      "duration_seconds": 2.61,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.6,
      "end_seconds": 105.69,
      "duration_seconds": 4.09,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.15,
      "end_seconds": 125.15,
      "duration_seconds": 4.0,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.79,
      "end_seconds": 128.71,
      "duration_seconds": 1.92,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.06,
      "end_seconds": 148.37,
      "duration_seconds": 2.31,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.87,
      "end_seconds": 153.18,
      "duration_seconds": 3.31,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.01,
      "end_seconds": 167.21,
      "duration_seconds": 4.2,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.62,
      "end_seconds": 176.2,
      "duration_seconds": 2.58,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.57,
      "end_seconds": 194.1,
      "duration_seconds": 6.53,
      "text": "Okay: pulse 88, oxygen saturation is 96 percent, blood pressure 104 over 74."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.75,
      "end_seconds": 203.0,
      "duration_seconds": 3.25,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.05,
      "end_seconds": 212.5,
      "duration_seconds": 4.45,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.19,
      "end_seconds": 219.6,
      "duration_seconds": 4.41,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.33,
      "end_seconds": 222.03,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.01,
      "end_seconds": 224.44,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.71,
      "end_seconds": 246.37,
      "duration_seconds": 4.66,
      "text": "You are hot and jaundiced, and your spleen is tender."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.39,
      "end_seconds": 261.37,
      "duration_seconds": 10.98,
      "text": "Okay, that's all I needed to check. From what you've told me and what I found, this looks most like possible malaria after travel."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.1,
      "end_seconds": 265.0,
      "duration_seconds": 2.9,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.55,
      "end_seconds": 298.02,
      "duration_seconds": 31.47,
      "text": "I can't promise yet, but most people with possible malaria after travel do well once it's treated properly. I'm going to order blood tests, for fever after travel. It's a routine test and it'll give us a much clearer picture. You need hospital assessment today, this can become serious fast. I think the infectious diseases team should see you too. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.78,
      "end_seconds": 301.08,
      "duration_seconds": 2.3,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.3,
      "end_seconds": 308.43,
      "duration_seconds": 6.13,
      "text": "Let's plan a check straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.44,
      "end_seconds": 312.86,
      "duration_seconds": 3.42,
      "text": "Great, thank you for your help."
    }
  ]
}