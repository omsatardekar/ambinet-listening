{
  "schema_version": "1.0",
  "encounter_id": "01444",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 8.89,
      "duration_seconds": 7.86,
      "text": "Ah, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 15.34,
      "duration_seconds": 5.32,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.88,
      "end_seconds": 21.97,
      "duration_seconds": 5.09,
      "text": "Mainly I've been feeling faint. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.0,
      "end_seconds": 33.78,
      "duration_seconds": 9.78,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.03,
      "end_seconds": 40.81,
      "duration_seconds": 5.78,
      "text": "I get some relief from lying down. It's on and off."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 44.43,
      "duration_seconds": 1.95,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.34,
      "end_seconds": 52.14,
      "duration_seconds": 6.8,
      "text": "Okay, so it usually comes with stomach pain. There's vomiting blood as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.96,
      "end_seconds": 55.82,
      "duration_seconds": 2.86,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.08,
      "end_seconds": 58.91,
      "duration_seconds": 1.83,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.48,
      "end_seconds": 69.47,
      "duration_seconds": 2.99,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.07,
      "end_seconds": 71.58,
      "duration_seconds": 1.51,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.56,
      "end_seconds": 79.22,
      "duration_seconds": 5.66,
      "text": "Okay, go on. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.96,
      "end_seconds": 88.5,
      "duration_seconds": 7.54,
      "text": "Well, uh, I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.86,
      "end_seconds": 95.93,
      "duration_seconds": 6.07,
      "text": "Let's run through your medicines. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.46,
      "end_seconds": 107.8,
      "duration_seconds": 10.34,
      "text": "I mean, I'm on escitalopram, 10 milligrams, once a day. I take ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.09,
      "end_seconds": 121.43,
      "duration_seconds": 3.34,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.67,
      "end_seconds": 127.24,
      "duration_seconds": 2.57,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.25,
      "end_seconds": 130.67,
      "duration_seconds": 1.42,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.15,
      "end_seconds": 135.85,
      "duration_seconds": 3.7,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.42,
      "end_seconds": 140.11,
      "duration_seconds": 2.69,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.47,
      "end_seconds": 145.36,
      "duration_seconds": 3.89,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.18,
      "end_seconds": 148.89,
      "duration_seconds": 2.71,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.27,
      "end_seconds": 154.46,
      "duration_seconds": 4.19,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.7,
      "end_seconds": 158.52,
      "duration_seconds": 2.82,
      "text": "Right, is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.46,
      "end_seconds": 164.35,
      "duration_seconds": 4.89,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 167.41,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.08,
      "end_seconds": 171.31,
      "duration_seconds": 2.23,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.35,
      "end_seconds": 174.29,
      "duration_seconds": 1.94,
      "text": "Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.74,
      "end_seconds": 185.48,
      "duration_seconds": 6.74,
      "text": "Oh, um, no chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.81,
      "end_seconds": 190.2,
      "duration_seconds": 3.39,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.52,
      "end_seconds": 194.09,
      "duration_seconds": 2.57,
      "text": "Actually, I move fine otherwise."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.26,
      "end_seconds": 199.46,
      "duration_seconds": 4.2,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.65,
      "end_seconds": 213.73,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.95,
      "end_seconds": 237.53,
      "duration_seconds": 7.58,
      "text": "Okay: pulse 112, oxygen saturation is 96 percent. And temp 36.8 degrees, blood pressure 114 over 77."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.06,
      "end_seconds": 240.84,
      "duration_seconds": 1.78,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.55,
      "end_seconds": 245.28,
      "duration_seconds": 3.73,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.16,
      "end_seconds": 251.43,
      "duration_seconds": 3.27,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.03,
      "end_seconds": 260.76,
      "duration_seconds": 1.73,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 265.36,
      "duration_seconds": 2.75,
      "text": "Alright, tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.08,
      "end_seconds": 281.35,
      "duration_seconds": 7.27,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.55,
      "end_seconds": 310.75,
      "duration_seconds": 24.2,
      "text": "That's the examination finished. From what you've told me and what I found, my working impression is a possible bleeding stomach ulcer. The reason I say that is that your story and my examination fit together. It could also be a bleed from the gullet, so we'll keep that open."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.26,
      "end_seconds": 316.74,
      "duration_seconds": 4.48,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.63,
      "end_seconds": 344.51,
      "duration_seconds": 25.88,
      "text": "It's reasonable to be concerned, but right now a possible bleeding stomach ulcer is my leading thought, not anything worse. I'm going to order an endoscopy, for bleeding. I'm sending you for urgent blood tests because of bleeding. Please stop the ibuprofen and do not eat or drink. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.01,
      "end_seconds": 354.65,
      "duration_seconds": 8.64,
      "text": "Keep an eye out, and if you vomit again, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.46,
      "end_seconds": 359.77,
      "duration_seconds": 3.31,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.33,
      "end_seconds": 363.41,
      "duration_seconds": 3.08,
      "text": "Please come and see me straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.3,
      "end_seconds": 368.85,
      "duration_seconds": 3.55,
      "text": "Hmm, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.37,
      "end_seconds": 376.83,
      "duration_seconds": 6.46,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.88,
      "end_seconds": 387.95,
      "duration_seconds": 6.07,
      "text": "So, you know, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.71,
      "end_seconds": 394.73,
      "duration_seconds": 6.02,
      "text": "Yes, exactly right. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.52,
      "end_seconds": 398.8,
      "duration_seconds": 3.28,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.04,
      "end_seconds": 401.83,
      "duration_seconds": 1.79,
      "text": "Have a good day."
    }
  ]
}