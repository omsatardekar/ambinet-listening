{
  "schema_version": "1.0",
  "encounter_id": "01156",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 4.33,
      "duration_seconds": 3.43,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.81,
      "end_seconds": 10.83,
      "duration_seconds": 5.02,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 26.31,
      "duration_seconds": 14.28,
      "text": "mainly I've been feeling faint that's why I came i've been putting this off for weeks i've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.33,
      "end_seconds": 30.23,
      "duration_seconds": 2.9,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.71,
      "end_seconds": 34.92,
      "duration_seconds": 3.21,
      "text": "Well, it's been two months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.37,
      "end_seconds": 38.52,
      "duration_seconds": 2.15,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.95,
      "end_seconds": 42.77,
      "duration_seconds": 2.82,
      "text": "Standing definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.43,
      "end_seconds": 46.83,
      "duration_seconds": 2.4,
      "text": "have you had black tarry stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.9,
      "end_seconds": 52.25,
      "duration_seconds": 3.35,
      "text": "yes, about the same, ten days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.13,
      "end_seconds": 57.72,
      "duration_seconds": 3.59,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.48,
      "end_seconds": 63.2,
      "duration_seconds": 3.72,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.4,
      "end_seconds": 66.8,
      "duration_seconds": 2.4,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.71,
      "end_seconds": 70.15,
      "duration_seconds": 1.44,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.94,
      "end_seconds": 89.16,
      "duration_seconds": 3.22,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.31,
      "end_seconds": 97.61,
      "duration_seconds": 7.3,
      "text": "Anxiety, for two years. I have an irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.27,
      "end_seconds": 102.06,
      "duration_seconds": 0.79,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.03,
      "end_seconds": 104.63,
      "duration_seconds": 1.6,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.97,
      "end_seconds": 108.84,
      "duration_seconds": 2.87,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.57,
      "end_seconds": 115.76,
      "duration_seconds": 6.19,
      "text": "okay, I can see an irregular heartbeat and thin bones in your file as well"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.84,
      "end_seconds": 130.08,
      "duration_seconds": 3.24,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.73,
      "end_seconds": 138.98,
      "duration_seconds": 4.25,
      "text": "Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.3,
      "end_seconds": 145.29,
      "duration_seconds": 1.99,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.45,
      "end_seconds": 150.88,
      "duration_seconds": 4.43,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.64,
      "end_seconds": 154.73,
      "duration_seconds": 2.09,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.46,
      "end_seconds": 161.7,
      "duration_seconds": 6.24,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.03,
      "end_seconds": 166.88,
      "duration_seconds": 3.85,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.38,
      "end_seconds": 171.16,
      "duration_seconds": 2.78,
      "text": "my father had bowel cancer"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.56,
      "end_seconds": 189.08,
      "duration_seconds": 3.52,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.98,
      "end_seconds": 215.68,
      "duration_seconds": 25.7,
      "text": "I'm on escitalopram, 10 milligrams, once a day for the anxiety. I kept putting it off, which I know isn't sensible. I've never really been one for hospitals. Warfarin. I take it 3 milligrams, in the evening. I take ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.09,
      "end_seconds": 219.56,
      "duration_seconds": 2.47,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.07,
      "end_seconds": 222.55,
      "duration_seconds": 1.48,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.03,
      "end_seconds": 226.49,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 240.05,
      "duration_seconds": 2.94,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.1,
      "end_seconds": 261.57,
      "duration_seconds": 6.47,
      "text": "Okay: temp 36.8 degrees, blood pressure 135 over 73. And respiratory rate 20, pulse 119."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.08,
      "end_seconds": 264.53,
      "duration_seconds": 1.45,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.5,
      "end_seconds": 268.97,
      "duration_seconds": 3.47,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.45,
      "end_seconds": 274.79,
      "duration_seconds": 4.34,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.1,
      "end_seconds": 279.39,
      "duration_seconds": 3.29,
      "text": "right, I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.71,
      "end_seconds": 304.21,
      "duration_seconds": 7.5,
      "text": "you look pale, your pulse is fast and your tummy is tender at the top"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.7,
      "end_seconds": 337.46,
      "duration_seconds": 27.76,
      "text": "Okay, that's enough for me. Okay, thinking it through, I'd lean towards a possible bleeding stomach ulcer. We shouldn't forget a bleed from the gullet. I'm sending you for urgent blood tests because of bleeding. Please stop the ibuprofen and do not eat or drink. Please take the tablets with food so they don't upset your stomach. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.24,
      "end_seconds": 340.4,
      "duration_seconds": 2.16,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.38,
      "end_seconds": 345.58,
      "duration_seconds": 4.2,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.28,
      "end_seconds": 350.73,
      "duration_seconds": 3.45,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}