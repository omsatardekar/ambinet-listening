{
  "schema_version": "1.0",
  "encounter_id": "01246",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.55,
      "duration_seconds": 3.38,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 9.21,
      "duration_seconds": 3.68,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.96,
      "end_seconds": 14.74,
      "duration_seconds": 3.78,
      "text": "I've been dealing with bloating after meals"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.4,
      "end_seconds": 18.33,
      "duration_seconds": 2.93,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.48,
      "end_seconds": 32.03,
      "duration_seconds": 9.55,
      "text": "Yesterday, it came on out of nowhere. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.47,
      "end_seconds": 38.72,
      "duration_seconds": 5.25,
      "text": "Did you get night-time diarrhoea, blood in the stool or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.8,
      "end_seconds": 45.08,
      "duration_seconds": 3.28,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.59,
      "end_seconds": 49.58,
      "duration_seconds": 2.99,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.89,
      "end_seconds": 54.14,
      "duration_seconds": 3.25,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.93,
      "end_seconds": 66.38,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.53,
      "end_seconds": 70.62,
      "duration_seconds": 3.09,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.28,
      "end_seconds": 74.36,
      "duration_seconds": 2.08,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.65,
      "end_seconds": 84.96,
      "duration_seconds": 7.31,
      "text": "It's escitalopram, 10 milligrams, once a day. I didn't wanna make a fuss, you know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.65,
      "end_seconds": 90.95,
      "duration_seconds": 4.3,
      "text": "What conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.0,
      "end_seconds": 97.65,
      "duration_seconds": 4.65,
      "text": "So, I've had anxiety for five years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.52,
      "end_seconds": 101.82,
      "duration_seconds": 3.3,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.42,
      "end_seconds": 106.59,
      "duration_seconds": 4.17,
      "text": "I'm allergic to kiwi, I get an itchy mouth"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.61,
      "end_seconds": 110.39,
      "duration_seconds": 2.78,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.04,
      "end_seconds": 126.19,
      "duration_seconds": 12.15,
      "text": "I have about eight cigarettes in a day. Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.32,
      "end_seconds": 147.09,
      "duration_seconds": 3.77,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.07,
      "end_seconds": 163.3,
      "duration_seconds": 2.23,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 186.64,
      "duration_seconds": 6.54,
      "text": "Okay: pulse 83, blood pressure 117 over 82, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.24,
      "end_seconds": 188.69,
      "duration_seconds": 1.45,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.82,
      "end_seconds": 197.51,
      "duration_seconds": 3.69,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.83,
      "end_seconds": 201.26,
      "duration_seconds": 2.43,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.17,
      "end_seconds": 203.23,
      "duration_seconds": 1.06,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.87,
      "end_seconds": 206.11,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.72,
      "end_seconds": 228.51,
      "duration_seconds": 5.79,
      "text": "your tummy is soft and not tender, and I can't feel any lumps"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.76,
      "end_seconds": 236.06,
      "duration_seconds": 3.3,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.0,
      "end_seconds": 260.36,
      "duration_seconds": 14.36,
      "text": "so where does that leave us? I think we're dealing with a functional bowel pattern, with no alarm features at this stage. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.27,
      "end_seconds": 283.88,
      "duration_seconds": 4.61,
      "text": "I think a coeliac blood test makes sense here, for bloating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.98,
      "end_seconds": 287.34,
      "duration_seconds": 1.36,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.13,
      "end_seconds": 293.99,
      "duration_seconds": 2.86,
      "text": "Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.68,
      "end_seconds": 298.62,
      "duration_seconds": 3.94,
      "text": "right, I'll do that thank you, doctor"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.02,
      "end_seconds": 301.22,
      "duration_seconds": 1.2,
      "text": "Look after yourself."
    }
  ]
}