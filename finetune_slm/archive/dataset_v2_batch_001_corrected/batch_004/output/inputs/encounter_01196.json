{
  "schema_version": "1.0",
  "encounter_id": "01196",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 2.19,
      "duration_seconds": 1.54,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.71,
      "end_seconds": 6.93,
      "duration_seconds": 4.22,
      "text": "Okay, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.49,
      "end_seconds": 14.44,
      "duration_seconds": 6.95,
      "text": "I mean, doctor, it's a burn on my forearm it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.03,
      "end_seconds": 19.28,
      "duration_seconds": 3.25,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.11,
      "end_seconds": 31.29,
      "duration_seconds": 10.18,
      "text": "probably ten days. Yeah. I've also had a blister. Stinging pain was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.19,
      "end_seconds": 44.57,
      "duration_seconds": 2.38,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.65,
      "end_seconds": 59.78,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.13,
      "end_seconds": 87.01,
      "duration_seconds": 14.88,
      "text": "Okay: weight 54 kilos, temperature 36.9. And BMI works out to 18.5, pulse 78, saturation 99 percent, height 171 centimetres, pressure 119 over 73, respiratory rate 17."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.48,
      "end_seconds": 93.64,
      "duration_seconds": 4.16,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.08,
      "end_seconds": 96.36,
      "duration_seconds": 1.28,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.94,
      "end_seconds": 118.92,
      "duration_seconds": 5.98,
      "text": "it's a small superficial burn with an intact blister, about the size of a palm"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.02,
      "end_seconds": 123.63,
      "duration_seconds": 1.61,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.88,
      "end_seconds": 143.31,
      "duration_seconds": 5.43,
      "text": "Any burn to the face, numbness at the burn or fever at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.13,
      "end_seconds": 146.2,
      "duration_seconds": 2.07,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.86,
      "end_seconds": 152.59,
      "duration_seconds": 4.73,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.97,
      "end_seconds": 155.34,
      "duration_seconds": 1.37,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.63,
      "end_seconds": 159.82,
      "duration_seconds": 3.19,
      "text": "what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.34,
      "end_seconds": 165.22,
      "duration_seconds": 4.88,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.92,
      "end_seconds": 168.16,
      "duration_seconds": 2.24,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.89,
      "end_seconds": 170.42,
      "duration_seconds": 1.53,
      "text": "I've got depression"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.73,
      "end_seconds": 177.62,
      "duration_seconds": 1.89,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.66,
      "end_seconds": 181.78,
      "duration_seconds": 2.12,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 191.5,
      "duration_seconds": 7.96,
      "text": "Yes, depression and asthma are known to us, good to have that clear. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.6,
      "end_seconds": 196.82,
      "duration_seconds": 4.22,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 199.31,
      "duration_seconds": 1.21,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.47,
      "end_seconds": 202.72,
      "duration_seconds": 2.25,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.61,
      "end_seconds": 205.86,
      "duration_seconds": 2.25,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.78,
      "end_seconds": 212.66,
      "duration_seconds": 3.88,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.65,
      "end_seconds": 216.94,
      "duration_seconds": 3.29,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.78,
      "end_seconds": 223.3,
      "duration_seconds": 3.52,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.28,
      "end_seconds": 226.46,
      "duration_seconds": 2.18,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.0,
      "end_seconds": 232.59,
      "duration_seconds": 2.59,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 237.47,
      "duration_seconds": 3.84,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.32,
      "end_seconds": 246.97,
      "duration_seconds": 7.65,
      "text": "Sertraline, 50 milligrams, once a day. I take Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.78,
      "end_seconds": 256.04,
      "duration_seconds": 7.26,
      "text": "From what you've told me and what I found, I'd lean towards a minor superficial burn."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.34,
      "end_seconds": 261.69,
      "duration_seconds": 1.35,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.73,
      "end_seconds": 271.08,
      "duration_seconds": 7.35,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor superficial burn."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.41,
      "end_seconds": 289.66,
      "duration_seconds": 8.25,
      "text": "I'll start you on paracetamol, 1 gram, every six hours when needed, three days. That should help with burn pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.43,
      "end_seconds": 293.05,
      "duration_seconds": 2.62,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.37,
      "end_seconds": 299.47,
      "duration_seconds": 5.1,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.01,
      "end_seconds": 303.36,
      "duration_seconds": 3.35,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}