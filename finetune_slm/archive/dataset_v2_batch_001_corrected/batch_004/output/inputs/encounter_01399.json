{
  "schema_version": "1.0",
  "encounter_id": "01399",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 6.8,
      "duration_seconds": 5.9,
      "text": "Well, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.5,
      "end_seconds": 11.62,
      "duration_seconds": 4.12,
      "text": "not at all please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.36,
      "end_seconds": 29.91,
      "duration_seconds": 16.55,
      "text": "yeah, it's a lingering cough. I don't know what's causing it. I took the morning off to come in today. I've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.99,
      "end_seconds": 37.46,
      "duration_seconds": 5.47,
      "text": "right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.48,
      "end_seconds": 45.6,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.79,
      "end_seconds": 66.07,
      "duration_seconds": 10.28,
      "text": "okay: temperature 36.4 pulse is 85 beats a a minute respiratory rate 16 saturation 98 percent pressure 127 over 78."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.95,
      "end_seconds": 71.57,
      "duration_seconds": 1.62,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.29,
      "end_seconds": 85.22,
      "duration_seconds": 11.93,
      "text": "we'll go over that shortly can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.83,
      "end_seconds": 100.45,
      "duration_seconds": 14.62,
      "text": "Oh, only honey, and it's not much. It feels moderate to me. A tickle in my throat was there, um, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.49,
      "end_seconds": 108.05,
      "duration_seconds": 5.56,
      "text": "have you had a lingering cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.42,
      "end_seconds": 124.25,
      "duration_seconds": 9.83,
      "text": "so, you know, I had a similar thing a couple of years ago it went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.19,
      "end_seconds": 127.99,
      "duration_seconds": 2.8,
      "text": "Right what about coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.6,
      "end_seconds": 133.2,
      "duration_seconds": 4.6,
      "text": "Yeah not at all no coughing up blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.73,
      "end_seconds": 139.56,
      "duration_seconds": 4.83,
      "text": "have you had any shortness of breath, weight loss or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.82,
      "end_seconds": 145.49,
      "duration_seconds": 4.67,
      "text": "No, no shortness of breath, weight loss or fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.78,
      "end_seconds": 149.47,
      "duration_seconds": 2.69,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.44,
      "end_seconds": 152.23,
      "duration_seconds": 1.79,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.71,
      "end_seconds": 156.96,
      "duration_seconds": 3.25,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.11,
      "end_seconds": 162.03,
      "duration_seconds": 3.92,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.43,
      "end_seconds": 183.44,
      "duration_seconds": 3.01,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.54,
      "end_seconds": 188.13,
      "duration_seconds": 3.59,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.92,
      "end_seconds": 193.83,
      "duration_seconds": 3.91,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.86,
      "end_seconds": 196.93,
      "duration_seconds": 2.07,
      "text": "no nothing at all"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 202.19,
      "duration_seconds": 3.23,
      "text": "what operations have you had if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.4,
      "end_seconds": 208.3,
      "duration_seconds": 4.9,
      "text": "just an operation for a hernia, last spring"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.28,
      "end_seconds": 220.57,
      "duration_seconds": 4.29,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.55,
      "end_seconds": 238.35,
      "duration_seconds": 15.8,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I'm a plumber, lots of bending and kneeling. I swim twice a week"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.21,
      "end_seconds": 244.09,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.79,
      "end_seconds": 247.81,
      "duration_seconds": 3.02,
      "text": "no I've never reacted to anything"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.06,
      "end_seconds": 251.02,
      "duration_seconds": 1.96,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.16,
      "end_seconds": 255.67,
      "duration_seconds": 3.51,
      "text": "no, um, I'm not on anything"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.76,
      "end_seconds": 261.16,
      "duration_seconds": 4.4,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.06,
      "end_seconds": 263.29,
      "duration_seconds": 1.23,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.59,
      "end_seconds": 279.22,
      "duration_seconds": 3.63,
      "text": "your chest is clear and your oxygen is normal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.39,
      "end_seconds": 292.73,
      "duration_seconds": 8.34,
      "text": "Thank you, you can get dressed. Okay, thinking it through, this is probably a post-viral cough that is settling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.3,
      "end_seconds": 321.28,
      "duration_seconds": 12.98,
      "text": "It should settle over the next two to three weeks; steam and honey can help. Don't skip meals and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.88,
      "end_seconds": 335.89,
      "duration_seconds": 14.01,
      "text": "yes carry on the thing that would worry me is if you cough up blood if that happens go to emergency i'll want another look if it lasts beyond eight weeks"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.53,
      "end_seconds": 339.54,
      "duration_seconds": 2.01,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.35,
      "end_seconds": 345.5,
      "duration_seconds": 4.15,
      "text": "what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.05,
      "end_seconds": 354.42,
      "duration_seconds": 8.37,
      "text": "So, I come back if it lasts beyond eight weeks. Is that that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.93,
      "end_seconds": 360.31,
      "duration_seconds": 4.38,
      "text": "yes exactly right alright have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.95,
      "end_seconds": 362.59,
      "duration_seconds": 1.64,
      "text": "That's clear thanks."
    }
  ]
}