{
  "schema_version": "1.0",
  "encounter_id": "01022",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.28,
      "duration_seconds": 3.05,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.24,
      "end_seconds": 12.4,
      "duration_seconds": 4.16,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.22,
      "end_seconds": 19.1,
      "duration_seconds": 5.88,
      "text": "Okay, so hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 24.34,
      "duration_seconds": 4.31,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.33,
      "end_seconds": 36.41,
      "duration_seconds": 6.08,
      "text": "Right, doctor, it's a scratchy throat. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.1,
      "end_seconds": 40.94,
      "duration_seconds": 2.84,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.89,
      "end_seconds": 45.31,
      "duration_seconds": 3.42,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.99,
      "end_seconds": 47.73,
      "duration_seconds": 1.74,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.91,
      "end_seconds": 52.87,
      "duration_seconds": 3.96,
      "text": "I get some relief from warm drinks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.32,
      "end_seconds": 57.31,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.67,
      "end_seconds": 67.03,
      "duration_seconds": 8.36,
      "text": "Mild, I'd say. I did have a mild cough at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.09,
      "end_seconds": 72.18,
      "duration_seconds": 3.09,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.79,
      "end_seconds": 77.52,
      "duration_seconds": 3.73,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.21,
      "end_seconds": 81.52,
      "duration_seconds": 2.31,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.43,
      "end_seconds": 86.59,
      "duration_seconds": 4.16,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.4,
      "end_seconds": 101.15,
      "duration_seconds": 4.75,
      "text": "So, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.67,
      "end_seconds": 105.49,
      "duration_seconds": 2.82,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.08,
      "end_seconds": 109.84,
      "duration_seconds": 2.76,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 111.06,
      "end_seconds": 128.49,
      "duration_seconds": 17.43,
      "text": "Sorry, uh, what was I saying, she is on amlodipine, 5 milligrams, once a day for my pressure, I give it to her. It's carbamazepine, twice a day for the seizures, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.53,
      "end_seconds": 131.84,
      "duration_seconds": 2.31,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 133.93,
      "end_seconds": 138.3,
      "duration_seconds": 4.37,
      "text": "200 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 144.36,
      "duration_seconds": 5.02,
      "text": "I used to take levetiracetam, but I stopped it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.53,
      "end_seconds": 161.06,
      "duration_seconds": 4.53,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.91,
      "end_seconds": 164.43,
      "duration_seconds": 1.52,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.97,
      "end_seconds": 180.89,
      "duration_seconds": 2.92,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.18,
      "end_seconds": 190.54,
      "duration_seconds": 8.36,
      "text": "I've had high blood pressure for two years now. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.12,
      "end_seconds": 192.82,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.85,
      "end_seconds": 197.37,
      "duration_seconds": 3.52,
      "text": "I have epilepsy, for five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.0,
      "end_seconds": 200.34,
      "duration_seconds": 1.34,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.06,
      "end_seconds": 203.82,
      "duration_seconds": 2.76,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.68,
      "end_seconds": 206.71,
      "duration_seconds": 2.03,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.72,
      "end_seconds": 211.78,
      "duration_seconds": 4.06,
      "text": "And what about shortness of breath, fever or chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.76,
      "end_seconds": 217.71,
      "duration_seconds": 1.95,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.59,
      "end_seconds": 220.24,
      "duration_seconds": 1.65,
      "text": "Nothing like ear pain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.16,
      "end_seconds": 229.16,
      "duration_seconds": 3.0,
      "text": "I haven't noticed any ear pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.04,
      "end_seconds": 235.1,
      "duration_seconds": 5.06,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.46,
      "end_seconds": 240.48,
      "duration_seconds": 4.02,
      "text": "Well, uh, no, that's all normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.12,
      "end_seconds": 244.47,
      "duration_seconds": 3.35,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.47,
      "end_seconds": 250.54,
      "duration_seconds": 5.07,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.38,
      "end_seconds": 254.74,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.19,
      "end_seconds": 264.59,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.04,
      "end_seconds": 287.87,
      "duration_seconds": 8.83,
      "text": "Okay: pulse 72, pressure 117 over 73, oxygen saturation is 97 percent. And temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.94,
      "end_seconds": 291.51,
      "duration_seconds": 1.57,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.53,
      "end_seconds": 294.87,
      "duration_seconds": 2.34,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.29,
      "end_seconds": 298.94,
      "duration_seconds": 2.65,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.0,
      "end_seconds": 302.51,
      "duration_seconds": 2.51,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.35,
      "end_seconds": 323.74,
      "duration_seconds": 4.39,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.03,
      "end_seconds": 344.03,
      "duration_seconds": 15.0,
      "text": "That's all I needed to check. Right, here's what I'm thinking. It's hard to say. A simple viral cold is one possibility and early flu another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.25,
      "end_seconds": 351.22,
      "duration_seconds": 1.97,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.8,
      "end_seconds": 371.88,
      "duration_seconds": 20.08,
      "text": "I understand the worry. At the moment I'd say it's a simple viral cold, and we'll watch how it goes. Rest, plenty of fluids, and paracetamol if you ache. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.16,
      "end_seconds": 387.76,
      "duration_seconds": 15.6,
      "text": "I see, go ahead. If you develop a high fever or trouble breathing, or you feel really unwell, please come to the emergency department. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.74,
      "end_seconds": 390.28,
      "duration_seconds": 1.54,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.11,
      "end_seconds": 393.43,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}