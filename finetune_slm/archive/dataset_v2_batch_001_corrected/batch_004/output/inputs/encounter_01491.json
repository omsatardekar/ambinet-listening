{
  "schema_version": "1.0",
  "encounter_id": "01491",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 7.63,
      "duration_seconds": 6.77,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.17,
      "end_seconds": 13.25,
      "duration_seconds": 4.08,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 20.02,
      "duration_seconds": 5.93,
      "text": "Yeah, it's a long seizure. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.1,
      "end_seconds": 33.93,
      "duration_seconds": 11.83,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 42.66,
      "duration_seconds": 8.17,
      "text": "Ah, it comes and goes. I'd say mild. I've also been biting my tongue, for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.96,
      "end_seconds": 48.39,
      "duration_seconds": 4.43,
      "text": "So, any being drowsy and confused afterwards as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.11,
      "end_seconds": 53.26,
      "duration_seconds": 4.15,
      "text": "Yeah, yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.83,
      "end_seconds": 56.92,
      "duration_seconds": 3.09,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.61,
      "end_seconds": 71.01,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 91.69,
      "duration_seconds": 6.76,
      "text": "Okay: temperature 36.9, heart rate 118, respiratory rate 16. And blood pressure 128 over 71."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.29,
      "end_seconds": 94.63,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.99,
      "end_seconds": 100.54,
      "duration_seconds": 2.55,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.29,
      "end_seconds": 106.05,
      "duration_seconds": 3.76,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.83,
      "end_seconds": 120.94,
      "duration_seconds": 1.11,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.26,
      "end_seconds": 124.59,
      "duration_seconds": 2.33,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.7,
      "end_seconds": 138.48,
      "duration_seconds": 5.78,
      "text": "You are drowsy and confused, and there is blood on your tongue."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.1,
      "end_seconds": 140.14,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.42,
      "end_seconds": 147.65,
      "duration_seconds": 5.23,
      "text": "All finished, thank you. Have you noticed head injury or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.45,
      "end_seconds": 151.83,
      "duration_seconds": 3.38,
      "text": "Well, no, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.55,
      "end_seconds": 155.53,
      "duration_seconds": 1.98,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.31,
      "end_seconds": 157.33,
      "duration_seconds": 1.02,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.18,
      "end_seconds": 178.63,
      "duration_seconds": 4.45,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.31,
      "end_seconds": 186.52,
      "duration_seconds": 7.21,
      "text": "Years back I got hives from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.86,
      "end_seconds": 190.81,
      "duration_seconds": 2.95,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.65,
      "end_seconds": 196.29,
      "duration_seconds": 4.64,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.71,
      "end_seconds": 199.68,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.71,
      "end_seconds": 206.06,
      "duration_seconds": 5.35,
      "text": "Epilepsy, for two years. I have gout, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.71,
      "end_seconds": 208.11,
      "duration_seconds": 1.4,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.72,
      "end_seconds": 216.44,
      "duration_seconds": 6.72,
      "text": "Okay, I can see gout in your file as well. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.65,
      "end_seconds": 227.23,
      "duration_seconds": 9.58,
      "text": "I grab fast food at lunch most days. I hardly move around during the day. My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.44,
      "end_seconds": 239.52,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.45,
      "end_seconds": 245.09,
      "duration_seconds": 4.64,
      "text": "I take lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.17,
      "end_seconds": 248.32,
      "duration_seconds": 2.15,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.46,
      "end_seconds": 259.69,
      "duration_seconds": 6.23,
      "text": "About three months now. Allopurinol, 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.49,
      "end_seconds": 263.06,
      "duration_seconds": 1.57,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.98,
      "end_seconds": 267.19,
      "duration_seconds": 2.21,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.42,
      "end_seconds": 296.98,
      "duration_seconds": 24.56,
      "text": "From what you've told me and what I found, I'm honestly not certain yet. It could be a prolonged seizure in a person with epilepsy, or it might be a missed dose of medicine. Let's get a blood sugar, for seizure. Let's get blood tests including drug levels, for seizure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.78,
      "end_seconds": 299.9,
      "duration_seconds": 1.12,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.66,
      "end_seconds": 323.2,
      "duration_seconds": 21.54,
      "text": "I'll start you on lorazepam, 4 milligrams, once now, single dose. That's for prolonged seizure. Lie on your side while we monitor you. Do get help quickly if the symptoms get worse. Please come and see me straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.45,
      "end_seconds": 327.73,
      "duration_seconds": 3.28,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.44,
      "end_seconds": 330.04,
      "duration_seconds": 1.6,
      "text": "Have a good day."
    }
  ]
}