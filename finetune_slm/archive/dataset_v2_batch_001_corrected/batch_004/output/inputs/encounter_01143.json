{
  "schema_version": "1.0",
  "encounter_id": "01143",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 7.0,
      "duration_seconds": 6.46,
      "text": "Morning, come on through. Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.44,
      "end_seconds": 13.16,
      "duration_seconds": 4.72,
      "text": "I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.98,
      "end_seconds": 17.48,
      "duration_seconds": 3.5,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.03,
      "end_seconds": 30.12,
      "duration_seconds": 11.09,
      "text": "I, I wanted to get a tight band around my head looked at. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.7,
      "end_seconds": 31.97,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.57,
      "end_seconds": 37.86,
      "duration_seconds": 5.29,
      "text": "Around about four days... no wait, it's more like five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.45,
      "end_seconds": 50.08,
      "duration_seconds": 8.63,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.93,
      "end_seconds": 62.3,
      "duration_seconds": 10.37,
      "text": "Um, it happens a few times a day. I get some relief from a warm shower and a walk."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.53,
      "end_seconds": 66.06,
      "duration_seconds": 2.53,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.72,
      "end_seconds": 73.19,
      "duration_seconds": 6.47,
      "text": "When it starts I tend to get a stiff neck as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.91,
      "end_seconds": 78.2,
      "duration_seconds": 3.29,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.89,
      "end_seconds": 83.93,
      "duration_seconds": 4.04,
      "text": "I mean, only stretching, and it's not much."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.27,
      "end_seconds": 98.89,
      "duration_seconds": 3.62,
      "text": "Any sickness or sensitivity to light at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.49,
      "end_seconds": 102.4,
      "duration_seconds": 2.91,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.27,
      "end_seconds": 106.69,
      "duration_seconds": 2.42,
      "text": "Has there been any weakness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.32,
      "end_seconds": 109.9,
      "duration_seconds": 1.58,
      "text": "No. No weakness."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.21,
      "end_seconds": 117.39,
      "duration_seconds": 3.18,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.52,
      "end_seconds": 119.53,
      "duration_seconds": 1.01,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.48,
      "end_seconds": 121.72,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.27,
      "end_seconds": 126.25,
      "duration_seconds": 2.98,
      "text": "No, um, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.11,
      "end_seconds": 129.57,
      "duration_seconds": 2.46,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.24,
      "end_seconds": 135.74,
      "duration_seconds": 4.5,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.63,
      "end_seconds": 139.96,
      "duration_seconds": 2.33,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.42,
      "end_seconds": 144.75,
      "duration_seconds": 3.33,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.33,
      "end_seconds": 161.24,
      "duration_seconds": 2.91,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.39,
      "end_seconds": 166.02,
      "duration_seconds": 3.63,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.84,
      "end_seconds": 177.22,
      "duration_seconds": 3.38,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.04,
      "end_seconds": 182.33,
      "duration_seconds": 3.29,
      "text": "No, uh, nothing at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.63,
      "end_seconds": 187.44,
      "duration_seconds": 3.81,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.28,
      "end_seconds": 193.08,
      "duration_seconds": 4.8,
      "text": "Actually, I'm on paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.14,
      "end_seconds": 199.16,
      "duration_seconds": 4.02,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.2,
      "end_seconds": 207.69,
      "duration_seconds": 2.49,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.58,
      "end_seconds": 236.15,
      "duration_seconds": 8.57,
      "text": "Okay: pulse is 67 beats a minute, blood pressure 126 over 79, oxygen saturation is 99 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.87,
      "end_seconds": 239.39,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.12,
      "end_seconds": 248.0,
      "duration_seconds": 2.88,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.83,
      "end_seconds": 253.76,
      "duration_seconds": 3.93,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.37,
      "end_seconds": 258.95,
      "duration_seconds": 1.58,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.74,
      "end_seconds": 262.78,
      "duration_seconds": 2.04,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.91,
      "end_seconds": 281.14,
      "duration_seconds": 6.23,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.89,
      "end_seconds": 294.77,
      "duration_seconds": 8.88,
      "text": "Thank you, you can get dressed. Let me tell you where I've got to. It points towards tension-type headache."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.05,
      "end_seconds": 330.03,
      "duration_seconds": 22.98,
      "text": "I'd like to arrange an eye test for eye strain. It's a routine test and it'll give us a much clearer picture. Take screen breaks every hour and try regular neck stretches. Let's plan a check in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.57,
      "end_seconds": 333.35,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    }
  ]
}