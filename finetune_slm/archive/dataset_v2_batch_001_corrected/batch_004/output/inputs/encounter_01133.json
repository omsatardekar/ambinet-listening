{
  "schema_version": "1.0",
  "encounter_id": "01133",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 6.3,
      "duration_seconds": 5.32,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.18,
      "end_seconds": 11.19,
      "duration_seconds": 4.01,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.8,
      "end_seconds": 16.9,
      "duration_seconds": 4.1,
      "text": "So the thing is, I've got pelvic pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.0,
      "end_seconds": 22.29,
      "duration_seconds": 3.29,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.93,
      "end_seconds": 25.42,
      "duration_seconds": 2.49,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.8,
      "end_seconds": 29.15,
      "duration_seconds": 2.35,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.13,
      "end_seconds": 33.13,
      "duration_seconds": 2.0,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.38,
      "end_seconds": 40.65,
      "duration_seconds": 2.27,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.26,
      "end_seconds": 46.03,
      "duration_seconds": 3.77,
      "text": "It usually comes with a smelly discharge."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.18,
      "end_seconds": 53.14,
      "duration_seconds": 5.96,
      "text": "Have you had pelvic pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.09,
      "end_seconds": 62.01,
      "duration_seconds": 6.92,
      "text": "Okay, so I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.98,
      "end_seconds": 65.15,
      "duration_seconds": 2.17,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.84,
      "end_seconds": 80.98,
      "duration_seconds": 14.14,
      "text": "Tiotropium inhaler. I take it once a day. Erm, I'm supposed to take it regularly, but I don't always manage. Aspirin I don't take anymore."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.85,
      "end_seconds": 99.23,
      "duration_seconds": 1.38,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.17,
      "end_seconds": 103.58,
      "duration_seconds": 3.41,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.44,
      "end_seconds": 106.8,
      "duration_seconds": 2.36,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.73,
      "end_seconds": 120.05,
      "duration_seconds": 12.32,
      "text": "I have COPD. I kept putting it off, which I know isn't sensible. Sorry, I know I'm rambling a bit. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.39,
      "end_seconds": 131.56,
      "duration_seconds": 10.17,
      "text": "Hm, okay. Alright, COPD, that matches what I have here. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.58,
      "end_seconds": 134.77,
      "duration_seconds": 1.19,
      "text": "Yes, erythromycin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.86,
      "end_seconds": 141.72,
      "duration_seconds": 4.86,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.41,
      "end_seconds": 145.4,
      "duration_seconds": 2.99,
      "text": "Um, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.33,
      "end_seconds": 148.55,
      "duration_seconds": 1.22,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.31,
      "end_seconds": 153.57,
      "duration_seconds": 3.26,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.61,
      "end_seconds": 157.71,
      "duration_seconds": 2.1,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.3,
      "end_seconds": 159.82,
      "duration_seconds": 1.52,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 163.15,
      "duration_seconds": 2.24,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.82,
      "end_seconds": 169.83,
      "duration_seconds": 5.01,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.53,
      "end_seconds": 171.81,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.3,
      "end_seconds": 176.79,
      "duration_seconds": 3.49,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.8,
      "end_seconds": 180.81,
      "duration_seconds": 2.01,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.72,
      "end_seconds": 184.38,
      "duration_seconds": 2.66,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.82,
      "end_seconds": 188.08,
      "duration_seconds": 2.26,
      "text": "Any recent pregnancy or vomiting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.55,
      "end_seconds": 192.86,
      "duration_seconds": 3.31,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.16,
      "end_seconds": 197.9,
      "duration_seconds": 3.74,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.99,
      "end_seconds": 201.34,
      "duration_seconds": 2.35,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.14,
      "end_seconds": 206.45,
      "duration_seconds": 3.31,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.35,
      "end_seconds": 210.52,
      "duration_seconds": 2.17,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.77,
      "end_seconds": 216.59,
      "duration_seconds": 3.82,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.59,
      "end_seconds": 220.58,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.58,
      "end_seconds": 236.57,
      "duration_seconds": 6.99,
      "text": "You are very tender low in the tummy, and it hurts when I move the cervix."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.65,
      "end_seconds": 243.17,
      "duration_seconds": 2.52,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.62,
      "end_seconds": 268.74,
      "duration_seconds": 10.12,
      "text": "Let me tell you where I've got to. It points towards severe pelvic inflammatory disease. I'd also keep an abscess in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.52,
      "end_seconds": 288.82,
      "duration_seconds": 6.3,
      "text": "Let's book blood tests to look into fever. I'd like to arrange swabs for pelvic infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.75,
      "end_seconds": 291.9,
      "duration_seconds": 1.15,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.08,
      "end_seconds": 302.25,
      "duration_seconds": 9.17,
      "text": "You'll be taking ceftriaxone, 1 gram, once now, single dose. It's for pelvic infection. You need hospital treatment today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.54,
      "end_seconds": 314.04,
      "duration_seconds": 11.5,
      "text": "Understood. I'd like you to see the gynaecology team as well, and I'll write the referral. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.7,
      "end_seconds": 317.62,
      "duration_seconds": 0.92,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.57,
      "end_seconds": 325.28,
      "duration_seconds": 6.71,
      "text": "Let's review you straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.04,
      "end_seconds": 329.28,
      "duration_seconds": 2.24,
      "text": "Alright, thanks, take care."
    }
  ]
}