{
  "schema_version": "1.0",
  "encounter_id": "01188",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 6.54,
      "duration_seconds": 5.14,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.17,
      "end_seconds": 11.01,
      "duration_seconds": 3.84,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 22.85,
      "duration_seconds": 10.64,
      "text": "Yeah, it's a pink spotty rash. I don't know what's causing it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.48,
      "end_seconds": 26.86,
      "duration_seconds": 3.38,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.02,
      "end_seconds": 43.45,
      "duration_seconds": 15.43,
      "text": "it's been about a month now i took the morning off to come in today i'd rather not end up on lots of tablets if I can avoid it it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.63,
      "end_seconds": 47.97,
      "duration_seconds": 3.34,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.83,
      "end_seconds": 50.85,
      "duration_seconds": 1.02,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.31,
      "end_seconds": 69.31,
      "duration_seconds": 3.0,
      "text": "And what about stiff neck or breathlessness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.4,
      "end_seconds": 74.13,
      "duration_seconds": 3.73,
      "text": "No, uh, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.5,
      "end_seconds": 78.78,
      "duration_seconds": 3.28,
      "text": "So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.04,
      "end_seconds": 82.23,
      "duration_seconds": 2.19,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.16,
      "end_seconds": 86.98,
      "duration_seconds": 3.82,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.88,
      "end_seconds": 90.86,
      "duration_seconds": 2.98,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.47,
      "end_seconds": 98.74,
      "duration_seconds": 4.27,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.65,
      "end_seconds": 108.89,
      "duration_seconds": 5.24,
      "text": "Erm, I'm on paracetamol syrup, 5 ml, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.09,
      "end_seconds": 123.13,
      "duration_seconds": 3.04,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.0,
      "end_seconds": 128.6,
      "duration_seconds": 4.6,
      "text": "I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.99,
      "end_seconds": 146.14,
      "duration_seconds": 4.15,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.0,
      "end_seconds": 150.9,
      "duration_seconds": 3.9,
      "text": "Mm, I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.5,
      "end_seconds": 157.76,
      "duration_seconds": 5.26,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.36,
      "end_seconds": 178.18,
      "duration_seconds": 18.82,
      "text": "I used to drink heavily but I stopped four years ago. No, I've never smoked in my life. Lots of rice, lentils and some fruit. I hardly move around during the day. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.88,
      "end_seconds": 189.77,
      "duration_seconds": 2.89,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.12,
      "end_seconds": 198.46,
      "duration_seconds": 2.34,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.21,
      "end_seconds": 225.28,
      "duration_seconds": 10.07,
      "text": "Okay: blood pressure 117 over 69, pulse is 76 beats a minute, temperature is 37.0 degrees, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.54,
      "end_seconds": 230.47,
      "duration_seconds": 2.93,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.98,
      "end_seconds": 234.58,
      "duration_seconds": 2.6,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.57,
      "end_seconds": 256.89,
      "duration_seconds": 5.32,
      "text": "The spots fade when pressed and he is playful and drinking well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.08,
      "end_seconds": 267.74,
      "duration_seconds": 7.66,
      "text": "That's the examination finished. Right, here's what I'm thinking. My working impression is a harmless viral rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.48,
      "end_seconds": 272.49,
      "duration_seconds": 3.01,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.89,
      "end_seconds": 304.27,
      "duration_seconds": 28.38,
      "text": "I understand the worry. At the moment I'd say it's a harmless viral rash, and we'll watch how it goes. Fluids and paracetamol if he is hot or uncomfortable. Come back or go to emergency straight away if the spots do not fade when pressed or he becomes drowsy. See me again if it lasts more than a week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.29,
      "end_seconds": 309.41,
      "duration_seconds": 4.12,
      "text": "great, uh, thank you for your help"
    }
  ]
}