{
  "schema_version": "1.0",
  "encounter_id": "01228",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.33,
      "end_seconds": 5.87,
      "duration_seconds": 4.54,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.81,
      "end_seconds": 15.74,
      "duration_seconds": 4.93,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.09,
      "end_seconds": 22.33,
      "duration_seconds": 5.24,
      "text": "Uh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.41,
      "end_seconds": 27.07,
      "duration_seconds": 3.66,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.58,
      "end_seconds": 32.54,
      "duration_seconds": 4.96,
      "text": "Uh, doctor, it's skipped beats. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.03,
      "end_seconds": 38.01,
      "duration_seconds": 3.98,
      "text": "Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.08,
      "end_seconds": 42.91,
      "duration_seconds": 3.83,
      "text": "It's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.6,
      "end_seconds": 45.63,
      "duration_seconds": 2.03,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.1,
      "end_seconds": 51.36,
      "duration_seconds": 4.26,
      "text": "I notice it more with caffeine and lying down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.33,
      "end_seconds": 54.94,
      "duration_seconds": 2.61,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.93,
      "end_seconds": 67.12,
      "duration_seconds": 11.19,
      "text": "Being a bit anxious goes along with it, most of the time. The being a bit anxious? That's been for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.97,
      "end_seconds": 71.99,
      "duration_seconds": 3.02,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.68,
      "end_seconds": 77.13,
      "duration_seconds": 3.45,
      "text": "Actually, about a five out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 79.01,
      "end_seconds": 90.16,
      "duration_seconds": 11.15,
      "text": "Here are the numbers, doctor. SpO2 97 percent on room air, pulse is 71 beats a minute, temperature 36.6, pressure 117 over 79."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 95.88,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.73,
      "end_seconds": 101.43,
      "duration_seconds": 3.7,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.33,
      "end_seconds": 105.91,
      "duration_seconds": 2.58,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.87,
      "end_seconds": 120.33,
      "duration_seconds": 4.46,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.0,
      "end_seconds": 124.66,
      "duration_seconds": 1.66,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.17,
      "end_seconds": 142.64,
      "duration_seconds": 4.47,
      "text": "Any shortness of breath, fainting or chest pain at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.25,
      "end_seconds": 160.09,
      "duration_seconds": 15.84,
      "text": "Oh, um, no, no shortness of breath, no fainting, no chest pain. I did have a flutter in my chest at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.48,
      "end_seconds": 162.93,
      "duration_seconds": 1.45,
      "text": "Nothing like dizziness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.35,
      "end_seconds": 169.03,
      "duration_seconds": 1.68,
      "text": "Nope, no dizziness."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 169.82,
      "end_seconds": 175.34,
      "duration_seconds": 5.52,
      "text": "Actually, doctor, I did notice dizziness. He doesn't always say."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.9,
      "end_seconds": 184.86,
      "duration_seconds": 7.96,
      "text": "No, um, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.57,
      "end_seconds": 195.5,
      "duration_seconds": 9.93,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.1,
      "end_seconds": 197.55,
      "duration_seconds": 1.45,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.82,
      "end_seconds": 202.1,
      "duration_seconds": 3.28,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.96,
      "end_seconds": 207.56,
      "duration_seconds": 3.6,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 208.21,
      "end_seconds": 213.93,
      "duration_seconds": 5.72,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.78,
      "end_seconds": 216.58,
      "duration_seconds": 1.8,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.1,
      "end_seconds": 228.2,
      "duration_seconds": 7.1,
      "text": "Fair enough, I'll write down both versions. Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.4,
      "end_seconds": 242.46,
      "duration_seconds": 13.06,
      "text": "I smoke roughly a pack every two days. I work in accounts at a hospital. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.06,
      "end_seconds": 245.24,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.83,
      "end_seconds": 247.0,
      "duration_seconds": 1.17,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.99,
      "end_seconds": 258.65,
      "duration_seconds": 3.66,
      "text": "Okay, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.71,
      "end_seconds": 264.85,
      "duration_seconds": 3.14,
      "text": "I'm on apixaban, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 268.38,
      "duration_seconds": 2.12,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 270.16,
      "end_seconds": 288.58,
      "duration_seconds": 18.42,
      "text": "5 milligrams, I think that's what's on the box. Mirtazapine. I take it 15 milligrams, at night. Propranolol, 40 milligrams, twice a day. Sorry, what was I saying, I'm on thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.25,
      "end_seconds": 293.48,
      "duration_seconds": 3.23,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 298.49,
      "end_seconds": 305.22,
      "duration_seconds": 6.73,
      "text": "Erm, um, I have an irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.0,
      "end_seconds": 306.7,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.32,
      "end_seconds": 312.5,
      "duration_seconds": 5.18,
      "text": "I've got depression. I've got migraines. I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.67,
      "end_seconds": 316.6,
      "duration_seconds": 0.93,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.47,
      "end_seconds": 321.66,
      "duration_seconds": 3.19,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.66,
      "end_seconds": 336.51,
      "duration_seconds": 13.85,
      "text": "Mm-hmm. Yes, an underactive thyroid is known to us, good to have that clear. Okay, so my impression is this: This is probably harmless extra heartbeats. Another possibility is an anxiety-related palpitation."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 338.13,
      "end_seconds": 341.86,
      "duration_seconds": 3.73,
      "text": "Well, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.53,
      "end_seconds": 359.7,
      "duration_seconds": 17.17,
      "text": "I understand the worry. At the moment I'd say it's harmless extra heartbeats, and we'll know more once the an ECG is back. Let me just check I've got this right. You've had skipped beats for about a month, and no chest pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.56,
      "end_seconds": 363.95,
      "duration_seconds": 2.39,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.93,
      "end_seconds": 369.64,
      "duration_seconds": 3.71,
      "text": "Let's book an ECG to look into palpitations."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 370.53,
      "end_seconds": 373.03,
      "duration_seconds": 2.5,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 373.72,
      "end_seconds": 376.57,
      "duration_seconds": 2.85,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.65,
      "end_seconds": 399.79,
      "duration_seconds": 21.14,
      "text": "Cut back on coffee and energy drinks and keep a diary of when it happens. Keep an eye out, and if you faint or have chest pain, call us the same day or go to emergency. Let's review you if it carries on after a month. Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 401.56,
      "end_seconds": 403.9,
      "duration_seconds": 2.34,
      "text": "Alright, thanks, take care."
    }
  ]
}