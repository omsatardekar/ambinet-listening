{
  "schema_version": "1.0",
  "encounter_id": "01493",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 5.35,
      "duration_seconds": 4.52,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.4,
      "end_seconds": 11.32,
      "duration_seconds": 4.92,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.11,
      "end_seconds": 23.35,
      "duration_seconds": 10.24,
      "text": "Doctor, it's a long seizure. It's getting on my nerves now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.21,
      "end_seconds": 29.48,
      "duration_seconds": 5.27,
      "text": "Did it come on recently? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.5,
      "end_seconds": 40.09,
      "duration_seconds": 8.59,
      "text": "Ever since... since last weekend, really. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.04,
      "end_seconds": 44.98,
      "duration_seconds": 3.94,
      "text": "Right, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.86,
      "end_seconds": 48.19,
      "duration_seconds": 2.33,
      "text": "it feels moderate to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.89,
      "end_seconds": 65.74,
      "duration_seconds": 2.85,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.12,
      "end_seconds": 80.12,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.81,
      "end_seconds": 100.9,
      "duration_seconds": 10.09,
      "text": "okay: pulse is 120 beats a minute, BP is 134 over 79, temperature 36.6, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.92,
      "end_seconds": 104.47,
      "duration_seconds": 1.55,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.4,
      "end_seconds": 108.75,
      "duration_seconds": 2.35,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.02,
      "end_seconds": 114.93,
      "duration_seconds": 3.91,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.14,
      "end_seconds": 117.21,
      "duration_seconds": 1.07,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.09,
      "end_seconds": 121.18,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.94,
      "end_seconds": 138.33,
      "duration_seconds": 5.39,
      "text": "You are drowsy and confused, and there is blood on your tongue."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 143.43,
      "duration_seconds": 2.13,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.84,
      "end_seconds": 164.02,
      "duration_seconds": 3.18,
      "text": "Did you get head injury or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.62,
      "end_seconds": 167.08,
      "duration_seconds": 2.46,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.07,
      "end_seconds": 170.89,
      "duration_seconds": 2.82,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.66,
      "end_seconds": 174.25,
      "duration_seconds": 2.59,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.4,
      "end_seconds": 178.12,
      "duration_seconds": 2.72,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.84,
      "end_seconds": 182.56,
      "duration_seconds": 3.72,
      "text": "It's lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.82,
      "end_seconds": 186.14,
      "duration_seconds": 3.32,
      "text": "ah what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.86,
      "end_seconds": 192.33,
      "duration_seconds": 5.47,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.49,
      "end_seconds": 210.31,
      "duration_seconds": 2.82,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.29,
      "end_seconds": 215.57,
      "duration_seconds": 3.28,
      "text": "Well, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 237.16,
      "duration_seconds": 4.79,
      "text": "Right, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.07,
      "end_seconds": 242.01,
      "duration_seconds": 2.94,
      "text": "Epilepsy, for about ten years"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.31,
      "end_seconds": 252.07,
      "duration_seconds": 8.76,
      "text": "Right, so epilepsy is already on your record. We'll keep that in mind today. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.18,
      "end_seconds": 256.77,
      "duration_seconds": 3.59,
      "text": "Trimethoprim. I come out in... well, itching."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.09,
      "end_seconds": 261.41,
      "duration_seconds": 3.32,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.18,
      "end_seconds": 265.39,
      "duration_seconds": 3.21,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.91,
      "end_seconds": 268.07,
      "duration_seconds": 2.16,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.78,
      "end_seconds": 274.73,
      "duration_seconds": 4.95,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 281.63,
      "duration_seconds": 6.17,
      "text": "taking everything into account, I'd lean towards a prolonged seizure in a person with epilepsy"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.86,
      "end_seconds": 286.15,
      "duration_seconds": 3.29,
      "text": "Is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.08,
      "end_seconds": 305.9,
      "duration_seconds": 18.82,
      "text": "Nothing I've seen today points to an emergency. It looks like a prolonged seizure in a person with epilepsy, but I'd like to confirm. Let me repeat that back to make sure. You've had a long seizure, since last weekend, moderate, and no fever or head injury."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.32,
      "end_seconds": 309.04,
      "duration_seconds": 1.72,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.08,
      "end_seconds": 335.79,
      "duration_seconds": 25.71,
      "text": "We should do blood tests including drug levels for seizure. I'd like you to take lorazepam, 4 milligrams, once now, single dose. It's for prolonged seizure. Lie on your side while we monitor you. We'll refer you to the emergency team. We'll catch up straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.97,
      "end_seconds": 342.21,
      "duration_seconds": 3.24,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.21,
      "end_seconds": 344.65,
      "duration_seconds": 1.44,
      "text": "all the best"
    }
  ]
}