{
  "schema_version": "1.0",
  "encounter_id": "01120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 9.51,
      "duration_seconds": 8.52,
      "text": "Hello, good to see you. Please sit. Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.93,
      "end_seconds": 17.36,
      "duration_seconds": 6.43,
      "text": "Erm, I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.68,
      "end_seconds": 21.23,
      "duration_seconds": 2.55,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.09,
      "end_seconds": 27.83,
      "duration_seconds": 5.74,
      "text": "I wanted to get burning when I pass urine looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.99,
      "end_seconds": 30.89,
      "duration_seconds": 1.9,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.03,
      "end_seconds": 44.95,
      "duration_seconds": 12.92,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.45,
      "end_seconds": 51.86,
      "duration_seconds": 5.41,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.05,
      "end_seconds": 65.18,
      "duration_seconds": 12.13,
      "text": "It happens on and off. Drinking water helps a bit. I've had a dull ache low in my tummy too, for about a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.79,
      "end_seconds": 71.27,
      "duration_seconds": 4.48,
      "text": "Have you had any fever, back pain or vaginal discharge?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.55,
      "end_seconds": 77.97,
      "duration_seconds": 2.42,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.74,
      "end_seconds": 83.48,
      "duration_seconds": 3.74,
      "text": "Did you notice any blood in the urine?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.58,
      "end_seconds": 87.92,
      "duration_seconds": 3.34,
      "text": "No blood in the urine, thankfully."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.84,
      "end_seconds": 92.57,
      "duration_seconds": 2.73,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.55,
      "end_seconds": 96.6,
      "duration_seconds": 2.05,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.72,
      "end_seconds": 99.09,
      "duration_seconds": 1.37,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.35,
      "end_seconds": 103.53,
      "duration_seconds": 3.18,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.19,
      "end_seconds": 108.37,
      "duration_seconds": 4.18,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.09,
      "end_seconds": 113.58,
      "duration_seconds": 3.49,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.42,
      "end_seconds": 117.12,
      "duration_seconds": 2.7,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.63,
      "end_seconds": 122.58,
      "duration_seconds": 3.95,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.3,
      "end_seconds": 137.83,
      "duration_seconds": 2.53,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.76,
      "end_seconds": 142.29,
      "duration_seconds": 3.53,
      "text": "Omeprazole, once a day for the reflux."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.36,
      "end_seconds": 145.35,
      "duration_seconds": 1.99,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.94,
      "end_seconds": 153.49,
      "duration_seconds": 7.55,
      "text": "20 milligrams, I think that's what's on the box. I take sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.15,
      "end_seconds": 157.01,
      "duration_seconds": 2.86,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 162.46,
      "duration_seconds": 4.62,
      "text": "About two months. Cranberry juice. I take it daily."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.91,
      "end_seconds": 177.43,
      "duration_seconds": 5.52,
      "text": "Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.66,
      "end_seconds": 180.99,
      "duration_seconds": 2.33,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.51,
      "end_seconds": 183.9,
      "duration_seconds": 2.39,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.74,
      "end_seconds": 190.41,
      "duration_seconds": 5.67,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.21,
      "end_seconds": 195.26,
      "duration_seconds": 2.05,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.44,
      "end_seconds": 204.26,
      "duration_seconds": 3.82,
      "text": "I've had acid reflux for five years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 207.32,
      "duration_seconds": 1.72,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.04,
      "end_seconds": 209.65,
      "duration_seconds": 1.61,
      "text": "I've got migraines."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.27,
      "end_seconds": 212.68,
      "duration_seconds": 1.41,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.7,
      "end_seconds": 222.33,
      "duration_seconds": 8.63,
      "text": "Okay, I can see acid reflux in your file as well. Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.52,
      "end_seconds": 237.67,
      "duration_seconds": 2.15,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.2,
      "end_seconds": 262.05,
      "duration_seconds": 10.85,
      "text": "Okay: respiratory rate 15, height 181 centimetres, pulse 78, saturation 99 percent, temperature is 36.6 degrees, BP is 116 over 79, weight 80 kilos."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.56,
      "end_seconds": 265.25,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.91,
      "end_seconds": 268.28,
      "duration_seconds": 2.37,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.26,
      "end_seconds": 274.16,
      "duration_seconds": 2.9,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.5,
      "end_seconds": 277.02,
      "duration_seconds": 1.52,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.72,
      "end_seconds": 280.72,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.11,
      "end_seconds": 294.85,
      "duration_seconds": 4.74,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.46,
      "end_seconds": 314.36,
      "duration_seconds": 13.9,
      "text": "Please sit back down. From what you've told me and what I found, the most likely explanation is an uncomplicated urinary infection. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.13,
      "end_seconds": 321.19,
      "duration_seconds": 3.06,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.06,
      "end_seconds": 331.86,
      "duration_seconds": 8.8,
      "text": "I can't promise yet, but most people with an uncomplicated urinary infection do well once it's treated properly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.7,
      "end_seconds": 352.66,
      "duration_seconds": 4.96,
      "text": "I'll request a urine dipstick, it'll help with burning urine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 353.18,
      "end_seconds": 357.61,
      "duration_seconds": 4.43,
      "text": "I can book that for Wednesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.21,
      "end_seconds": 374.33,
      "duration_seconds": 16.12,
      "text": "I'll start you on nitrofurantoin, 100 milligrams, twice a day, three days. That should help with urinary infection. Drink plenty of water and avoid holding urine. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.24,
      "end_seconds": 378.5,
      "duration_seconds": 3.26,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.32,
      "end_seconds": 381.74,
      "duration_seconds": 1.42,
      "text": "See you soon."
    }
  ]
}