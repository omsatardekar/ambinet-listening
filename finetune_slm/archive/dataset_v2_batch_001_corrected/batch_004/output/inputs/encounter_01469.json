{
  "schema_version": "1.0",
  "encounter_id": "01469",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.78,
      "end_seconds": 5.11,
      "duration_seconds": 4.33,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.6,
      "end_seconds": 11.99,
      "duration_seconds": 3.39,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.52,
      "end_seconds": 17.45,
      "duration_seconds": 4.93,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.15,
      "end_seconds": 23.36,
      "duration_seconds": 4.21,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.96,
      "end_seconds": 28.49,
      "duration_seconds": 4.53,
      "text": "Doctor, it's planning a trip. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.01,
      "end_seconds": 30.26,
      "duration_seconds": 1.25,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.93,
      "end_seconds": 36.05,
      "duration_seconds": 5.12,
      "text": "Um, it's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.12,
      "end_seconds": 40.08,
      "duration_seconds": 2.96,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.63,
      "end_seconds": 43.4,
      "duration_seconds": 1.77,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.06,
      "end_seconds": 49.77,
      "duration_seconds": 5.71,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 49.87,
      "end_seconds": 56.06,
      "duration_seconds": 6.19,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.42,
      "end_seconds": 63.17,
      "duration_seconds": 2.75,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.27,
      "end_seconds": 72.22,
      "duration_seconds": 7.95,
      "text": "There was a mild sore arm from last injection, yes, but that went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 72.97,
      "end_seconds": 75.26,
      "duration_seconds": 2.29,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.33,
      "end_seconds": 78.79,
      "duration_seconds": 2.46,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.33,
      "end_seconds": 91.28,
      "duration_seconds": 8.95,
      "text": "Yeah, just my tonsils removed, as a teenager. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.4,
      "end_seconds": 97.21,
      "duration_seconds": 4.81,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.17,
      "end_seconds": 105.68,
      "duration_seconds": 6.51,
      "text": "I have migraines, for nearly five years. Well, I've had COPD, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.9,
      "end_seconds": 119.15,
      "duration_seconds": 12.25,
      "text": "I follow. Right, so migraines is already on your record. We'll keep that in mind today. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.02,
      "end_seconds": 124.02,
      "duration_seconds": 4.0,
      "text": "Okay, so my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.73,
      "end_seconds": 129.01,
      "duration_seconds": 4.28,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 134.08,
      "end_seconds": 140.03,
      "duration_seconds": 5.95,
      "text": "Sorry, uh, what was I saying, I've never had an allergy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 140.97,
      "end_seconds": 149.16,
      "duration_seconds": 8.19,
      "text": "Actually, I remember he had some kind of reaction to amoxicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.08,
      "end_seconds": 152.08,
      "duration_seconds": 2.0,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.26,
      "end_seconds": 164.19,
      "duration_seconds": 10.93,
      "text": "Alright, so that's unclear. I'll record what each of you said. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.33,
      "end_seconds": 178.12,
      "duration_seconds": 12.79,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. I'm vegetarian and have been for years. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 198.97,
      "duration_seconds": 3.33,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.69,
      "end_seconds": 206.15,
      "duration_seconds": 6.46,
      "text": "I take propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 206.89,
      "end_seconds": 215.7,
      "duration_seconds": 8.81,
      "text": "Doctor, I think the last prescription for the propranolol was 80 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 222.11,
      "duration_seconds": 5.51,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.08,
      "end_seconds": 233.88,
      "duration_seconds": 9.8,
      "text": "Oh, I don't think I have it with me. Ah, um, I take Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.52,
      "end_seconds": 238.82,
      "duration_seconds": 3.3,
      "text": "Have you noticed rash, fever or recent illness?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.65,
      "end_seconds": 243.43,
      "duration_seconds": 2.78,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.98,
      "end_seconds": 247.08,
      "duration_seconds": 2.1,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.85,
      "end_seconds": 249.32,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.37,
      "end_seconds": 253.62,
      "duration_seconds": 2.25,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.45,
      "end_seconds": 257.09,
      "duration_seconds": 2.64,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 257.75,
      "end_seconds": 266.97,
      "duration_seconds": 9.22,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 98 percent, pulse 71, BP is 109 over 80, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.36,
      "end_seconds": 269.35,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 275.31,
      "duration_seconds": 3.35,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 277.37,
      "end_seconds": 278.58,
      "duration_seconds": 1.21,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.77,
      "end_seconds": 281.09,
      "duration_seconds": 1.32,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.81,
      "end_seconds": 292.03,
      "duration_seconds": 3.22,
      "text": "Your temperature is normal and you look well."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.93,
      "end_seconds": 304.64,
      "duration_seconds": 7.71,
      "text": "All finished, thank you. Taking everything into account, the most likely explanation is fit to have travel vaccinations."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.03,
      "end_seconds": 307.71,
      "duration_seconds": 1.68,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.74,
      "end_seconds": 319.06,
      "duration_seconds": 6.32,
      "text": "Nothing I've seen today points to an emergency. It looks like fit to have travel vaccinations."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.87,
      "end_seconds": 361.04,
      "duration_seconds": 29.17,
      "text": "You'll be taking hepatitis A vaccine, 1 dose, once, single dose. That should help with travel. It's a commonly used medicine and most people tolerate it well. Drink bottled water and use insect repellent. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.76,
      "end_seconds": 365.13,
      "duration_seconds": 3.37,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}