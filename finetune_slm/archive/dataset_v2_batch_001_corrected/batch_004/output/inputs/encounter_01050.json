{
  "schema_version": "1.0",
  "encounter_id": "01050",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 6.54,
      "duration_seconds": 5.28,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.56,
      "end_seconds": 13.63,
      "duration_seconds": 1.07,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.39,
      "end_seconds": 19.05,
      "duration_seconds": 3.66,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.52,
      "end_seconds": 24.65,
      "duration_seconds": 3.13,
      "text": "I've been dealing with hard stools."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.26,
      "end_seconds": 28.71,
      "duration_seconds": 2.45,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.81,
      "end_seconds": 33.81,
      "duration_seconds": 3.0,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.84,
      "end_seconds": 44.75,
      "duration_seconds": 8.91,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.62,
      "end_seconds": 67.36,
      "duration_seconds": 16.74,
      "text": "Only water, and it's not much. Moderate, really. Oh, and mild bloating. That's been about the same, five days. With mild bloating, maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.45,
      "end_seconds": 72.64,
      "duration_seconds": 4.19,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.19,
      "end_seconds": 76.31,
      "duration_seconds": 3.12,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.43,
      "end_seconds": 96.19,
      "duration_seconds": 3.76,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.22,
      "end_seconds": 101.25,
      "duration_seconds": 4.03,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.06,
      "end_seconds": 105.25,
      "duration_seconds": 2.19,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.87,
      "end_seconds": 115.37,
      "duration_seconds": 4.5,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.06,
      "end_seconds": 119.24,
      "duration_seconds": 2.18,
      "text": "So, how are your meals?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.24,
      "end_seconds": 124.37,
      "duration_seconds": 4.13,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.57,
      "end_seconds": 138.41,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.09,
      "end_seconds": 147.36,
      "duration_seconds": 7.27,
      "text": "A fibre supplement, 1 sachet, daily. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.26,
      "end_seconds": 154.33,
      "duration_seconds": 5.07,
      "text": "So, any severe pain, blood in the stool or vomiting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.87,
      "end_seconds": 158.46,
      "duration_seconds": 3.59,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.01,
      "end_seconds": 162.88,
      "duration_seconds": 2.87,
      "text": "So, any sign of weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.58,
      "end_seconds": 166.99,
      "duration_seconds": 3.41,
      "text": "Not at all, no weight loss."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.94,
      "end_seconds": 171.45,
      "duration_seconds": 3.51,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.84,
      "end_seconds": 174.24,
      "duration_seconds": 1.4,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.1,
      "end_seconds": 190.98,
      "duration_seconds": 4.88,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.16,
      "end_seconds": 200.29,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.06,
      "end_seconds": 223.2,
      "duration_seconds": 9.14,
      "text": "Okay: temperature 36.9, saturation 99 percent, pulse is 81 beats a minute, BP is 116 over 77, respiratory rate 14."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.13,
      "end_seconds": 228.42,
      "duration_seconds": 3.29,
      "text": "Um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.55,
      "end_seconds": 232.15,
      "duration_seconds": 2.6,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.2,
      "end_seconds": 237.18,
      "duration_seconds": 3.98,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.01,
      "end_seconds": 241.87,
      "duration_seconds": 2.86,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.81,
      "end_seconds": 263.65,
      "duration_seconds": 2.84,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.3,
      "end_seconds": 268.71,
      "duration_seconds": 2.41,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.94,
      "end_seconds": 281.2,
      "duration_seconds": 5.26,
      "text": "Okay, thinking it through, this is probably simple constipation from low fibre."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.9,
      "end_seconds": 284.78,
      "duration_seconds": 2.88,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 308.59,
      "duration_seconds": 22.62,
      "text": "I understand the worry. At the moment I'd say it's simple constipation from low fibre, and we'll watch how it goes. For this, lactulose, 15 ml, twice a day, two weeks. You take it by mouth. That should help with constipation. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.0,
      "end_seconds": 311.63,
      "duration_seconds": 1.63,
      "text": "That's clear, thanks."
    }
  ]
}