{
  "schema_version": "1.0",
  "encounter_id": "01010",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 7.15,
      "duration_seconds": 6.44,
      "text": "Erm, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.22,
      "end_seconds": 12.91,
      "duration_seconds": 3.69,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.27,
      "end_seconds": 27.7,
      "duration_seconds": 13.43,
      "text": "I've been dealing with a mole that has got bigger. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.62,
      "end_seconds": 37.82,
      "duration_seconds": 6.2,
      "text": "Alright, what's on your current medicine list? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.58,
      "end_seconds": 50.13,
      "duration_seconds": 11.55,
      "text": "I'm, I'm on carvedilol, 6.25 milligrams, twice a day. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.62,
      "end_seconds": 54.94,
      "duration_seconds": 3.32,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.79,
      "end_seconds": 69.59,
      "duration_seconds": 12.8,
      "text": "About about a year. Okay, so I'm on alendronate, 70 milligrams, once a week. Yeah, I'm on warfarin, 3 milligrams, maybe, in the evening."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.87,
      "end_seconds": 80.73,
      "duration_seconds": 4.86,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.02,
      "end_seconds": 86.78,
      "duration_seconds": 4.76,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.8,
      "end_seconds": 91.53,
      "duration_seconds": 2.73,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.08,
      "end_seconds": 99.57,
      "duration_seconds": 3.49,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.11,
      "end_seconds": 102.53,
      "duration_seconds": 2.42,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.31,
      "end_seconds": 118.47,
      "duration_seconds": 14.16,
      "text": "It usually comes with occasional itching. Right, the occasional itching? That's been for three days. Oh, I had a darker edge before. That's settled now, though."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.48,
      "end_seconds": 138.26,
      "duration_seconds": 1.78,
      "text": "Any other new moles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.07,
      "end_seconds": 142.21,
      "duration_seconds": 3.14,
      "text": "Nope, no other new moles."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.84,
      "end_seconds": 146.03,
      "duration_seconds": 2.19,
      "text": "Alright, any crusting or bleeding?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.84,
      "end_seconds": 150.53,
      "duration_seconds": 3.69,
      "text": "I haven't had crusting or bleeding, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.48,
      "end_seconds": 153.25,
      "duration_seconds": 1.77,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.59,
      "end_seconds": 156.69,
      "duration_seconds": 2.1,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.74,
      "end_seconds": 170.54,
      "duration_seconds": 3.8,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.63,
      "end_seconds": 191.26,
      "duration_seconds": 18.63,
      "text": "Erm, you know, yes, heart failure. I'd rather not end up on lots of tablets if I can avoid it. Uh, I have thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.44,
      "end_seconds": 196.81,
      "duration_seconds": 1.37,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.72,
      "end_seconds": 201.59,
      "duration_seconds": 3.87,
      "text": "Actually, I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.48,
      "end_seconds": 213.81,
      "duration_seconds": 7.33,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.47,
      "end_seconds": 224.17,
      "duration_seconds": 8.7,
      "text": "Right, yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.5,
      "end_seconds": 228.26,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.67,
      "end_seconds": 242.59,
      "duration_seconds": 12.92,
      "text": "I only drink at family occasions. I've never touched a cigarette. I swim twice a week. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.43,
      "end_seconds": 249.84,
      "duration_seconds": 6.41,
      "text": "Before we go further, any allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.0,
      "end_seconds": 256.97,
      "duration_seconds": 5.97,
      "text": "Actually, um, I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.22,
      "end_seconds": 268.07,
      "duration_seconds": 2.85,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.79,
      "end_seconds": 284.28,
      "duration_seconds": 2.49,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.21,
      "end_seconds": 314.86,
      "duration_seconds": 8.65,
      "text": "Okay: temperature 37.0, BP is 118 over 80, heart rate 84, respiratory rate 17, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.88,
      "end_seconds": 318.57,
      "duration_seconds": 2.69,
      "text": "Well, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.98,
      "end_seconds": 324.88,
      "duration_seconds": 3.9,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.32,
      "end_seconds": 332.29,
      "duration_seconds": 4.97,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.13,
      "end_seconds": 335.25,
      "duration_seconds": 1.12,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.66,
      "end_seconds": 338.96,
      "duration_seconds": 2.3,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.15,
      "end_seconds": 362.89,
      "duration_seconds": 6.74,
      "text": "The mole is seven millimetres with an irregular border and two shades of brown."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.69,
      "end_seconds": 364.8,
      "duration_seconds": 1.11,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.42,
      "end_seconds": 388.35,
      "duration_seconds": 19.93,
      "text": "You can relax now. Right, here's what I'm thinking. I think we're dealing with a mole with features that need specialist assessment at this stage. The reason I say that is that your story and my examination fit together. A benign naevus is also on my list."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.06,
      "end_seconds": 392.53,
      "duration_seconds": 3.47,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.07,
      "end_seconds": 412.42,
      "duration_seconds": 19.35,
      "text": "It's reasonable to be concerned, but right now a mole with features that need specialist assessment is my leading thought, not anything worse. Let me repeat that back to make sure. You've had a mole that has got bigger, since last night, and no crusting or bleeding."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.07,
      "end_seconds": 417.89,
      "duration_seconds": 3.82,
      "text": "Yes, you know, you've got it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.72,
      "end_seconds": 426.65,
      "duration_seconds": 6.93,
      "text": "Let's get a skin biopsy, for changing mole. Let's book a dermoscopy to look into changing mole."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.45,
      "end_seconds": 428.73,
      "duration_seconds": 1.28,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.53,
      "end_seconds": 448.13,
      "duration_seconds": 17.6,
      "text": "Protect it from the sun until you are seen. Let's get you seen by the skin cancer clinic, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 449.02,
      "end_seconds": 450.88,
      "duration_seconds": 1.86,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.42,
      "end_seconds": 462.09,
      "duration_seconds": 6.67,
      "text": "Do get help quickly if the symptoms get worse. Please come and see me after the biopsy."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 462.6,
      "end_seconds": 465.7,
      "duration_seconds": 3.1,
      "text": "Ah, I can manage that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 467.74,
      "end_seconds": 470.82,
      "duration_seconds": 3.08,
      "text": "So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 472.82,
      "end_seconds": 476.54,
      "duration_seconds": 3.72,
      "text": "I mean, thank you, that's helpful."
    }
  ]
}