{
  "schema_version": "1.0",
  "encounter_id": "01126",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 4.28,
      "duration_seconds": 3.13,
      "text": "Okay, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.19,
      "end_seconds": 6.22,
      "duration_seconds": 1.03,
      "text": "hi, thanks"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.52,
      "end_seconds": 9.55,
      "duration_seconds": 2.03,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.18,
      "end_seconds": 16.77,
      "duration_seconds": 5.59,
      "text": "So, I've been getting out of breath on the stairs, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.45,
      "end_seconds": 19.59,
      "duration_seconds": 2.14,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.9,
      "end_seconds": 23.76,
      "duration_seconds": 2.86,
      "text": "Yes, stairs. That makes it worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.32,
      "end_seconds": 29.1,
      "duration_seconds": 4.78,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.06,
      "end_seconds": 38.22,
      "duration_seconds": 7.16,
      "text": "it just comes and goes. I've also been looking pale, for about three months"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.3,
      "end_seconds": 45.99,
      "duration_seconds": 6.69,
      "text": "have you been getting out of breath on the stairs at any time before this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.23,
      "end_seconds": 57.21,
      "duration_seconds": 4.98,
      "text": "I had a similar thing last year it went away"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.99,
      "end_seconds": 59.82,
      "duration_seconds": 1.83,
      "text": "So, what's your work?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.13,
      "end_seconds": 65.47,
      "duration_seconds": 4.34,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.63,
      "end_seconds": 69.62,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.74,
      "end_seconds": 73.73,
      "duration_seconds": 2.99,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.43,
      "end_seconds": 78.06,
      "duration_seconds": 3.63,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.13,
      "end_seconds": 82.93,
      "duration_seconds": 2.8,
      "text": "it's hydrocortisone cream, when needed"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.89,
      "end_seconds": 87.52,
      "duration_seconds": 2.63,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.33,
      "end_seconds": 92.71,
      "duration_seconds": 3.38,
      "text": "Uh, I've had eczema, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.79,
      "end_seconds": 112.23,
      "duration_seconds": 2.44,
      "text": "Any black stools or heavy periods?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.64,
      "end_seconds": 118.33,
      "duration_seconds": 4.69,
      "text": "no, you know, none of those at all"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.74,
      "end_seconds": 122.12,
      "duration_seconds": 2.38,
      "text": "Did you notice any weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.2,
      "end_seconds": 126.42,
      "duration_seconds": 2.22,
      "text": "Definitely no weight loss."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.65,
      "end_seconds": 129.83,
      "duration_seconds": 2.18,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.54,
      "end_seconds": 132.0,
      "duration_seconds": 1.46,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.67,
      "end_seconds": 136.48,
      "duration_seconds": 2.81,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.54,
      "end_seconds": 140.7,
      "duration_seconds": 3.16,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.09,
      "end_seconds": 154.5,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.17,
      "end_seconds": 163.89,
      "duration_seconds": 2.72,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.24,
      "end_seconds": 186.47,
      "duration_seconds": 10.23,
      "text": "Okay: BP is 127 over 88, saturation 96 percent, temperature is 36.7 degrees, pulse is 119 beats a minute, respiratory rate 17."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.83,
      "end_seconds": 189.48,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.12,
      "end_seconds": 192.85,
      "duration_seconds": 2.73,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.79,
      "end_seconds": 199.25,
      "duration_seconds": 3.46,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.87,
      "end_seconds": 209.94,
      "duration_seconds": 2.07,
      "text": "okay, you know, doctor"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.76,
      "end_seconds": 212.05,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.34,
      "end_seconds": 228.2,
      "duration_seconds": 4.86,
      "text": "Your inner eyelids look pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.61,
      "end_seconds": 252.7,
      "duration_seconds": 20.09,
      "text": "Please sit back down. Putting it all together, it points towards tiredness probably from low iron. I can't rule out an underactive thyroid yet. We should do a full blood count for tiredness. I'd rather check than guess, and and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.3,
      "end_seconds": 255.61,
      "duration_seconds": 2.31,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.27,
      "end_seconds": 261.2,
      "duration_seconds": 4.93,
      "text": "A thyroid test is what I'd like next, for tiredness"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.93,
      "end_seconds": 265.33,
      "duration_seconds": 2.4,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.86,
      "end_seconds": 291.02,
      "duration_seconds": 22.16,
      "text": "I'm sending you for an iron study because of pallor. The treatment will be ferrous sulfate, 200 milligrams, once a day, three months. You take it by mouth. That's for low iron. I'll put all of this in writing so you don't have to remember it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.23,
      "end_seconds": 295.85,
      "duration_seconds": 3.62,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.94,
      "end_seconds": 312.51,
      "duration_seconds": 15.57,
      "text": "take the iron with orange juice, not with tea. Do get help quickly if the symptoms get worse. Let's review you in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.35,
      "end_seconds": 318.45,
      "duration_seconds": 4.1,
      "text": "right, I'll do that thank you, doctor"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.64,
      "end_seconds": 320.89,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}