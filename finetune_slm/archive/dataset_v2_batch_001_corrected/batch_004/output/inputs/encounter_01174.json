{
  "schema_version": "1.0",
  "encounter_id": "01174",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 5.17,
      "duration_seconds": 3.89,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 11.27,
      "duration_seconds": 4.44,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.4,
      "end_seconds": 17.87,
      "duration_seconds": 5.47,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.71,
      "end_seconds": 21.64,
      "duration_seconds": 2.93,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.36,
      "end_seconds": 29.57,
      "duration_seconds": 6.21,
      "text": "It's been passing clots, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.35,
      "end_seconds": 34.91,
      "duration_seconds": 4.56,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.48,
      "end_seconds": 56.66,
      "duration_seconds": 21.18,
      "text": "Um, I've had it for ten days. As for very heavy periods, I honestly can't say when that began. It might have been last month or the month before. And I've been feeling tired as well, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.22,
      "end_seconds": 60.67,
      "duration_seconds": 3.45,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.28,
      "end_seconds": 62.96,
      "duration_seconds": 1.68,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.4,
      "end_seconds": 68.39,
      "duration_seconds": 4.99,
      "text": "Mm, okay. A few quick ones: pain with sex or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.36,
      "end_seconds": 75.13,
      "duration_seconds": 4.77,
      "text": "No pain with sex or weight loss, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.91,
      "end_seconds": 79.18,
      "duration_seconds": 2.27,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.49,
      "end_seconds": 81.4,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.47,
      "end_seconds": 85.61,
      "duration_seconds": 2.14,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.8,
      "end_seconds": 92.55,
      "duration_seconds": 2.75,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.15,
      "end_seconds": 98.11,
      "duration_seconds": 4.96,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.75,
      "end_seconds": 102.29,
      "duration_seconds": 3.54,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.07,
      "end_seconds": 106.16,
      "duration_seconds": 3.09,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.08,
      "end_seconds": 113.43,
      "duration_seconds": 5.35,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.31,
      "end_seconds": 132.13,
      "duration_seconds": 1.82,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.23,
      "end_seconds": 139.37,
      "duration_seconds": 5.14,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.68,
      "end_seconds": 142.16,
      "duration_seconds": 1.48,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.23,
      "end_seconds": 147.81,
      "duration_seconds": 3.58,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.97,
      "end_seconds": 151.77,
      "duration_seconds": 2.8,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.44,
      "end_seconds": 156.23,
      "duration_seconds": 2.79,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.1,
      "end_seconds": 165.22,
      "duration_seconds": 4.12,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.06,
      "end_seconds": 170.87,
      "duration_seconds": 3.81,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.8,
      "end_seconds": 189.38,
      "duration_seconds": 4.58,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.4,
      "end_seconds": 196.72,
      "duration_seconds": 5.32,
      "text": "I've had an irregular heartbeat for nearly five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.28,
      "end_seconds": 211.1,
      "duration_seconds": 12.82,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. Okay, can you list what you take, tablets, creams or inhalers? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 212.57,
      "end_seconds": 218.81,
      "duration_seconds": 6.24,
      "text": "Ah, she takes metoprolol, 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.8,
      "end_seconds": 223.65,
      "duration_seconds": 2.85,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 225.7,
      "end_seconds": 231.83,
      "duration_seconds": 6.13,
      "text": "Six months now. It's tranexamic acid, 500 milligrams, during periods, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.86,
      "end_seconds": 237.6,
      "duration_seconds": 4.74,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.23,
      "end_seconds": 245.64,
      "duration_seconds": 2.41,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.27,
      "end_seconds": 263.01,
      "duration_seconds": 2.74,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.66,
      "end_seconds": 276.5,
      "duration_seconds": 2.84,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.67,
      "end_seconds": 298.93,
      "duration_seconds": 11.26,
      "text": "Okay: pressure 115 over 80, respiratory rate 17, oxygen saturation is 99 percent, pulse is 73 beats a minute, temperature 36.6."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.23,
      "end_seconds": 302.37,
      "duration_seconds": 2.14,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.99,
      "end_seconds": 306.1,
      "duration_seconds": 2.11,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.75,
      "end_seconds": 327.19,
      "duration_seconds": 5.44,
      "text": "The uterus feels enlarged and firm, about the size of a ten-week pregnancy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.46,
      "end_seconds": 329.45,
      "duration_seconds": 0.99,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.63,
      "end_seconds": 353.86,
      "duration_seconds": 22.23,
      "text": "Good, you can sit up again. Okay, so my impression is this: The most likely explanation is heavy periods, possibly from fibroids. I think a ferritin level makes sense here, for heavy periods. Please come and see me after the scan. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.73,
      "end_seconds": 357.78,
      "duration_seconds": 3.05,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.37,
      "end_seconds": 359.55,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}