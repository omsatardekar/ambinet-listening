{
  "schema_version": "1.0",
  "encounter_id": "01090",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.91,
      "end_seconds": 7.03,
      "duration_seconds": 6.12,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.59,
      "end_seconds": 11.07,
      "duration_seconds": 3.48,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.17,
      "end_seconds": 19.88,
      "duration_seconds": 7.71,
      "text": "Thank you for fitting us in, doctor. She's been having a racing heart, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.54,
      "end_seconds": 30.57,
      "duration_seconds": 9.03,
      "text": "Okay, give me more detail on it, whatever comes to mind. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.29,
      "end_seconds": 44.36,
      "duration_seconds": 12.07,
      "text": "I'd say once or twice a day. A eight out of ten, I suppose. I mean, and there's bulging eyes as well, four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.99,
      "end_seconds": 46.89,
      "duration_seconds": 1.9,
      "text": "What about neck pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.15,
      "end_seconds": 50.83,
      "duration_seconds": 2.68,
      "text": "No, none, no neck pain."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.42,
      "end_seconds": 55.74,
      "duration_seconds": 4.32,
      "text": "Let me check a few things. Any chest pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.79,
      "end_seconds": 67.87,
      "duration_seconds": 10.08,
      "text": "No, no chest pain, no diarrhoea. I did have shaky hands at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.76,
      "end_seconds": 72.45,
      "duration_seconds": 3.69,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.37,
      "end_seconds": 76.35,
      "duration_seconds": 1.98,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.74,
      "end_seconds": 79.52,
      "duration_seconds": 1.78,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 83.03,
      "duration_seconds": 2.47,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.25,
      "end_seconds": 87.63,
      "duration_seconds": 3.38,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.39,
      "end_seconds": 94.75,
      "duration_seconds": 6.36,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 101.31,
      "duration_seconds": 5.3,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 106.35,
      "duration_seconds": 3.69,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.78,
      "end_seconds": 110.13,
      "duration_seconds": 2.35,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.99,
      "end_seconds": 113.83,
      "duration_seconds": 2.84,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.91,
      "end_seconds": 119.19,
      "duration_seconds": 3.28,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.65,
      "end_seconds": 124.48,
      "duration_seconds": 3.83,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.47,
      "end_seconds": 143.83,
      "duration_seconds": 4.36,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.64,
      "end_seconds": 149.21,
      "duration_seconds": 4.57,
      "text": "Thyroxine. I take it 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 151.16,
      "end_seconds": 159.07,
      "duration_seconds": 7.91,
      "text": "Well, it's meant to be every morning, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.13,
      "end_seconds": 169.14,
      "duration_seconds": 8.01,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.15,
      "end_seconds": 173.83,
      "duration_seconds": 2.68,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.26,
      "end_seconds": 183.56,
      "duration_seconds": 8.3,
      "text": "For my mood, I believe. My wife sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.92,
      "end_seconds": 189.29,
      "duration_seconds": 4.37,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.32,
      "end_seconds": 198.76,
      "duration_seconds": 7.44,
      "text": "I've had an underactive thyroid for about ten years now. Depression, for two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.41,
      "end_seconds": 210.8,
      "duration_seconds": 10.39,
      "text": "Ah. Yes, an underactive thyroid and depression are known to us, good to have that clear. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.75,
      "end_seconds": 216.34,
      "duration_seconds": 4.59,
      "text": "My sister had breast cancer. My son has asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 222.2,
      "end_seconds": 233.72,
      "duration_seconds": 11.52,
      "text": "Here are the numbers, doctor. Pressure 123 over 81, oxygen saturation is 99 percent, pulse is 126 beats a minute. Height 156 centimetres, weight 86 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.52,
      "end_seconds": 235.86,
      "duration_seconds": 1.34,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.12,
      "end_seconds": 240.8,
      "duration_seconds": 3.68,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.19,
      "end_seconds": 243.49,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.43,
      "end_seconds": 262.18,
      "duration_seconds": 5.75,
      "text": "You have a fine tremor and your pulse is fast and regular."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.34,
      "end_seconds": 266.82,
      "duration_seconds": 2.48,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.0,
      "end_seconds": 286.86,
      "duration_seconds": 7.86,
      "text": "Let me tell you where I've got to. It fits best with an overactive thyroid. We shouldn't forget anxiety."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 288.1,
      "end_seconds": 290.88,
      "duration_seconds": 2.78,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 301.11,
      "duration_seconds": 9.11,
      "text": "I understand the worry. At the moment I'd say it's an overactive thyroid, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 302.11,
      "end_seconds": 305.82,
      "duration_seconds": 3.71,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.74,
      "end_seconds": 313.98,
      "duration_seconds": 7.24,
      "text": "Thanks, I'll have a look. I think thyroid blood tests makes sense here, for weight loss and palpitations."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.35,
      "end_seconds": 317.04,
      "duration_seconds": 1.69,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.87,
      "end_seconds": 327.02,
      "duration_seconds": 9.15,
      "text": "The treatment will be propranolol, 20 milligrams, twice a day, until review. That should help with racing heart and tremor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.1,
      "end_seconds": 331.33,
      "duration_seconds": 1.23,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.66,
      "end_seconds": 338.9,
      "duration_seconds": 3.24,
      "text": "Avoid caffeine while the heart is racing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.3,
      "end_seconds": 352.79,
      "duration_seconds": 13.49,
      "text": "Ah. We'll refer you to the endocrine clinic. Please come and see me after the thyroid results. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.18,
      "end_seconds": 356.34,
      "duration_seconds": 2.16,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.14,
      "end_seconds": 362.69,
      "duration_seconds": 1.55,
      "text": "Have a good day."
    }
  ]
}