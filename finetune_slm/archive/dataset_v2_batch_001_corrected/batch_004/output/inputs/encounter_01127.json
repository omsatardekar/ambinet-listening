{
  "schema_version": "1.0",
  "encounter_id": "01127",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.01,
      "end_seconds": 5.26,
      "duration_seconds": 4.25,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 10.78,
      "duration_seconds": 3.44,
      "text": "okay thanks hi how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.67,
      "end_seconds": 20.0,
      "duration_seconds": 7.33,
      "text": "honestly it's a sore stiff knee and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.93,
      "end_seconds": 23.88,
      "duration_seconds": 1.95,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 28.16,
      "duration_seconds": 3.12,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.94,
      "end_seconds": 40.12,
      "duration_seconds": 10.18,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.37,
      "end_seconds": 52.52,
      "duration_seconds": 11.15,
      "text": "I'd call it mild i'd say on and off oh and the knee giving way a little that's been about the same two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 58.59,
      "duration_seconds": 4.34,
      "text": "Alright, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.54,
      "end_seconds": 70.57,
      "duration_seconds": 10.03,
      "text": "I'd give it a four out of ten there was stiffness in the morning yes but that went away"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.1,
      "end_seconds": 75.56,
      "duration_seconds": 4.46,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.13,
      "end_seconds": 97.1,
      "duration_seconds": 19.97,
      "text": "I've never touched a cigarette. I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. I'm a bus driver, so I sit for long hours. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.47,
      "end_seconds": 102.38,
      "duration_seconds": 3.91,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.47,
      "end_seconds": 108.64,
      "duration_seconds": 5.17,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 110.2,
      "end_seconds": 114.74,
      "duration_seconds": 4.54,
      "text": "Doctor, our chart from the last visit lists it as 1300 milligrams."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.72,
      "end_seconds": 120.24,
      "duration_seconds": 4.52,
      "text": "hm, that's different is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.93,
      "end_seconds": 136.73,
      "duration_seconds": 12.8,
      "text": "not with me i'll bring it next time. Hydrocortisone cream i take it when needed. Ibuprofen gel i take it three times a day"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.46,
      "end_seconds": 156.52,
      "duration_seconds": 3.06,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 160.27,
      "duration_seconds": 2.43,
      "text": "yes, walnuts. I get hives"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.89,
      "end_seconds": 178.3,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.05,
      "end_seconds": 183.59,
      "duration_seconds": 4.54,
      "text": "My mother has an underactive thyroid. My son has asthma."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.03,
      "end_seconds": 188.59,
      "duration_seconds": 3.56,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.65,
      "end_seconds": 196.97,
      "duration_seconds": 6.32,
      "text": "I have arthritis in my knees, for five years. I have eczema."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.78,
      "end_seconds": 206.89,
      "duration_seconds": 9.11,
      "text": "alright, arthritis in your knees, that that matches what I have here. Have you had any redness, locked knee or fall?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.51,
      "end_seconds": 211.02,
      "duration_seconds": 2.51,
      "text": "no none that I've noticed"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.34,
      "end_seconds": 213.29,
      "duration_seconds": 1.95,
      "text": "Hm okay. What about fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.06,
      "end_seconds": 215.76,
      "duration_seconds": 1.7,
      "text": "nope, no fever"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.57,
      "end_seconds": 219.23,
      "duration_seconds": 2.66,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.51,
      "end_seconds": 225.87,
      "duration_seconds": 1.36,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.61,
      "end_seconds": 229.0,
      "duration_seconds": 2.39,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.62,
      "end_seconds": 232.24,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 234.0,
      "end_seconds": 245.25,
      "duration_seconds": 11.25,
      "text": "doctor, I've got the readings for you pulse is 81 beats a minute, oxygen saturation is 99 percent, respiratory rate 18, temperature 36.5, BP is 126 over 80."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.35,
      "end_seconds": 249.27,
      "duration_seconds": 1.92,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 255.98,
      "duration_seconds": 3.91,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 258.21,
      "duration_seconds": 1.17,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.05,
      "end_seconds": 277.61,
      "duration_seconds": 7.56,
      "text": "the joint line is tender, there is a bit of crunching, and the knee bends to ninety degrees"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.89,
      "end_seconds": 282.94,
      "duration_seconds": 3.05,
      "text": "So, good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.87,
      "end_seconds": 310.3,
      "duration_seconds": 19.43,
      "text": "okay, so my impression is this: The most likely explanation is knee osteoarthritis flare that's my thinking for now, and it may change as we learn more it could also be a meniscal tear, so we'll keep that open"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.7,
      "end_seconds": 313.25,
      "duration_seconds": 1.55,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.99,
      "end_seconds": 334.65,
      "duration_seconds": 19.66,
      "text": "nothing I've seen today points to an emergency. It looks like knee osteoarthritis flare. I'd like you to see physiotherapy as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.66,
      "end_seconds": 339.72,
      "duration_seconds": 3.06,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.24,
      "end_seconds": 345.17,
      "duration_seconds": 4.93,
      "text": "Let's review you in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 345.68,
      "end_seconds": 349.01,
      "duration_seconds": 3.33,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.86,
      "end_seconds": 352.39,
      "duration_seconds": 2.53,
      "text": "okay, have a good day"
    }
  ]
