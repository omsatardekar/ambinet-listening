  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 3.91,
      "duration_seconds": 3.12,
      "text": "morning, doctor lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 9.77,
      "duration_seconds": 4.31,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.63,
      "end_seconds": 14.7,
      "duration_seconds": 4.07,
      "text": "Ah, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.88,
      "end_seconds": 26.53,
      "duration_seconds": 7.65,
      "text": "doctor, um, it's a sore throat. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 30.77,
      "duration_seconds": 3.62,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.43,
      "end_seconds": 45.23,
      "duration_seconds": 12.8,
      "text": "it's been about a week, I'm fairly sure my neighbour said I should get it looked at my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.73,
      "end_seconds": 55.75,
      "duration_seconds": 10.02,
      "text": "yes, carry on tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.61,
      "end_seconds": 61.0,
      "duration_seconds": 4.39,
      "text": "Moderate, really. Yes, swallowing. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.47,
      "end_seconds": 65.4,
      "duration_seconds": 2.93,
      "text": "Has there been a headache too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.47,
      "end_seconds": 71.81,
      "duration_seconds": 3.34,
      "text": "yeah, I've had that since Monday"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.63,
      "end_seconds": 75.37,
      "duration_seconds": 2.74,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.65,
      "end_seconds": 89.15,
      "duration_seconds": 2.5,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.77,
      "end_seconds": 103.99,
      "duration_seconds": 4.22,
      "text": "okay: saturation 97 percent, pressure 122 over 78, pulse 65."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.27,
      "end_seconds": 108.81,
      "duration_seconds": 3.54,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 111.06,
      "duration_seconds": 1.43,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.61,
      "end_seconds": 123.82,
      "duration_seconds": 4.21,
      "text": "your oxygen is normal and your chest is clear"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.48,
      "end_seconds": 131.72,
      "duration_seconds": 2.24,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.85,
      "end_seconds": 145.92,
      "duration_seconds": 5.07,
      "text": "Let me check a few things. Any breathlessness, confusion or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.58,
      "end_seconds": 151.84,
      "duration_seconds": 4.26,
      "text": "Actually, um, no, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.36,
      "end_seconds": 155.83,
      "duration_seconds": 2.47,
      "text": "Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.38,
      "end_seconds": 161.51,
      "duration_seconds": 4.13,
      "text": "Uh, you know, no, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.02,
      "end_seconds": 165.92,
      "duration_seconds": 2.9,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.04,
      "end_seconds": 168.9,
      "duration_seconds": 1.86,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.7,
      "end_seconds": 173.32,
      "duration_seconds": 3.62,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.81,
      "end_seconds": 181.45,
      "duration_seconds": 3.64,
      "text": "Warfarin, 3 milligrams, in the evening."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 182.54,
      "end_seconds": 190.44,
      "duration_seconds": 7.9,
      "text": "she is supposed to take it in the evening, but I can't say she always does"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.73,
      "end_seconds": 195.93,
      "duration_seconds": 4.2,
      "text": "Paracetamol. I take it 1 gram, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.5,
      "end_seconds": 197.91,
      "duration_seconds": 1.41,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.6,
      "end_seconds": 201.86,
      "duration_seconds": 3.26,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.8,
      "end_seconds": 206.04,
      "duration_seconds": 3.24,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.75,
      "end_seconds": 211.04,
      "duration_seconds": 4.29,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.79,
      "end_seconds": 216.47,
      "duration_seconds": 3.68,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.9,
      "end_seconds": 221.59,
      "duration_seconds": 3.69,
      "text": "Yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.42,
      "end_seconds": 238.81,
      "duration_seconds": 7.39,
      "text": "right, anything in your past medical history I should know? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.9,
      "end_seconds": 247.05,
      "duration_seconds": 3.15,
      "text": "I've had an irregular heartbeat, yes"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.89,
      "end_seconds": 258.57,
      "duration_seconds": 9.68,
      "text": "let me tell you where I've got to i think we're dealing with a mild viral respiratory infection at this stage"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.18,
      "end_seconds": 263.59,
      "duration_seconds": 3.41,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.19,
      "end_seconds": 274.39,
      "duration_seconds": 9.2,
      "text": "it's reasonable to be concerned, but right now a mild viral respiratory infection is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.4,
      "end_seconds": 301.45,
      "duration_seconds": 14.05,
      "text": "Let's get a COVID test, for respiratory symptoms. Rest, fluids, and stay home until you feel well and the fever has settled. Is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.27,
      "end_seconds": 306.66,
      "duration_seconds": 3.39,
      "text": "thank you, um, doctor, goodbye"
    }
  ]
}