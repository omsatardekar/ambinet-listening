{
  "schema_version": "1.0",
  "encounter_id": "01497",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 3.95,
      "duration_seconds": 2.82,
      "text": "sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 10.6,
      "duration_seconds": 4.69,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.63,
      "end_seconds": 22.42,
      "duration_seconds": 9.79,
      "text": "Yeah, it's a high fever. I don't know what's causing it. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.59,
      "end_seconds": 29.74,
      "duration_seconds": 3.15,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.96,
      "end_seconds": 34.42,
      "duration_seconds": 3.46,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.09,
      "end_seconds": 39.78,
      "duration_seconds": 4.69,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.49,
      "end_seconds": 43.33,
      "duration_seconds": 1.84,
      "text": "it's all the time"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.65,
      "end_seconds": 47.64,
      "duration_seconds": 2.99,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.46,
      "end_seconds": 60.97,
      "duration_seconds": 11.51,
      "text": "When it starts I tend to get a stiff neck as well. Erm, the stiff neck? That's been for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.98,
      "end_seconds": 68.89,
      "duration_seconds": 5.91,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.46,
      "end_seconds": 71.95,
      "duration_seconds": 2.49,
      "text": "it just comes and goes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.52,
      "end_seconds": 83.14,
      "duration_seconds": 1.62,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.01,
      "end_seconds": 88.95,
      "duration_seconds": 4.94,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.87,
      "end_seconds": 91.94,
      "duration_seconds": 2.07,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.56,
      "end_seconds": 102.65,
      "duration_seconds": 6.09,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.47,
      "end_seconds": 105.72,
      "duration_seconds": 1.25,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.88,
      "end_seconds": 112.85,
      "duration_seconds": 2.97,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.63,
      "end_seconds": 119.99,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 125.05,
      "duration_seconds": 4.44,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.52,
      "end_seconds": 144.03,
      "duration_seconds": 3.51,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 149.78,
      "duration_seconds": 3.94,
      "text": "I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.97,
      "end_seconds": 155.11,
      "duration_seconds": 4.14,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.89,
      "end_seconds": 171.04,
      "duration_seconds": 14.15,
      "text": "I've had thin bones for five years now. Work has been very busy so I kept ignoring it. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.64,
      "end_seconds": 185.18,
      "duration_seconds": 12.54,
      "text": "I see, go ahead. Okay, I can see thin bones in your file as well. Has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.69,
      "end_seconds": 188.39,
      "duration_seconds": 1.7,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.78,
      "end_seconds": 203.38,
      "duration_seconds": 3.6,
      "text": "Any cough or recent head injury at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.71,
      "end_seconds": 207.46,
      "duration_seconds": 2.75,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.68,
      "end_seconds": 212.39,
      "duration_seconds": 3.71,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.86,
      "end_seconds": 216.07,
      "duration_seconds": 2.21,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.19,
      "end_seconds": 221.04,
      "duration_seconds": 3.85,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.92,
      "end_seconds": 226.35,
      "duration_seconds": 4.43,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.22,
      "end_seconds": 231.7,
      "duration_seconds": 4.48,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.09,
      "end_seconds": 243.24,
      "duration_seconds": 2.15,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.29,
      "end_seconds": 267.59,
      "duration_seconds": 7.3,
      "text": "okay: saturation 97 percent, pulse 107. And temperature 39.1, BP is 116 over 74."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.31,
      "end_seconds": 274.73,
      "duration_seconds": 4.42,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.5,
      "end_seconds": 276.41,
      "duration_seconds": 0.91,
      "text": "of course"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.97,
      "end_seconds": 280.56,
      "duration_seconds": 2.59,
      "text": "so, tell me if that's sore"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.75,
      "end_seconds": 304.96,
      "duration_seconds": 8.21,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.07,
      "end_seconds": 335.07,
      "duration_seconds": 27.0,
      "text": "You can sit up now. Taking everything into account, it's hard to say. Possible bacterial meningitis is one possibility and meningococcal septicaemia another, and I'd rather not commit yet. I'm sending you for blood cultures because of possible meningitis. The result will help us decide whether anything more is needed. Let's use benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.56,
      "end_seconds": 338.04,
      "duration_seconds": 1.48,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.71,
      "end_seconds": 346.34,
      "duration_seconds": 6.63,
      "text": "Call an ambulance now, this is an emergency. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.91,
      "end_seconds": 350.03,
      "duration_seconds": 2.12,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.09,
      "end_seconds": 354.81,
      "duration_seconds": 3.72,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.17,
      "end_seconds": 363.64,
      "duration_seconds": 3.47,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}