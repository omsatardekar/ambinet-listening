{
  "schema_version": "1.0",
  "encounter_id": "01021",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.54,
      "duration_seconds": 3.56,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 9.6,
      "duration_seconds": 4.15,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.53,
      "end_seconds": 20.25,
      "duration_seconds": 8.72,
      "text": "Well, I've been having sudden shortness of breath. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 24.22,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.81,
      "end_seconds": 27.31,
      "duration_seconds": 2.5,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.2,
      "end_seconds": 33.15,
      "duration_seconds": 4.95,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.56,
      "end_seconds": 50.81,
      "duration_seconds": 16.25,
      "text": "Breathing in definitely sets it off. I get some relief from sitting up. I've been coughing up a little blood too. As for coughing up a little blood, I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.33,
      "end_seconds": 62.01,
      "duration_seconds": 2.68,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.93,
      "end_seconds": 65.29,
      "duration_seconds": 2.36,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.04,
      "end_seconds": 68.99,
      "duration_seconds": 2.95,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.84,
      "end_seconds": 71.93,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.54,
      "end_seconds": 76.96,
      "duration_seconds": 3.42,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.02,
      "end_seconds": 79.95,
      "duration_seconds": 1.93,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 102.1,
      "duration_seconds": 4.84,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.37,
      "end_seconds": 105.56,
      "duration_seconds": 2.19,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.4,
      "end_seconds": 111.05,
      "duration_seconds": 4.65,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.12,
      "end_seconds": 116.76,
      "duration_seconds": 4.64,
      "text": "Not currently, but as a youngster tramadol gave me vomiting."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.55,
      "end_seconds": 123.25,
      "duration_seconds": 1.7,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.69,
      "end_seconds": 127.4,
      "duration_seconds": 2.71,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.39,
      "end_seconds": 132.53,
      "duration_seconds": 3.14,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.03,
      "end_seconds": 142.12,
      "duration_seconds": 4.09,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.14,
      "end_seconds": 146.1,
      "duration_seconds": 1.96,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.29,
      "end_seconds": 151.59,
      "duration_seconds": 4.3,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.45,
      "end_seconds": 157.39,
      "duration_seconds": 3.94,
      "text": "Any wheeze, chest tightness or fever at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.9,
      "end_seconds": 160.89,
      "duration_seconds": 1.99,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.71,
      "end_seconds": 165.74,
      "duration_seconds": 3.03,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.26,
      "end_seconds": 169.38,
      "duration_seconds": 2.12,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.29,
      "end_seconds": 185.8,
      "duration_seconds": 3.51,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.97,
      "end_seconds": 195.52,
      "duration_seconds": 2.55,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 218.95,
      "duration_seconds": 12.59,
      "text": "Okay: SpO2 93 percent on room air, temperature is 36.6 degrees. And BP is 130 over 81, respiratory rate 22, pulse is 89 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.35,
      "end_seconds": 222.57,
      "duration_seconds": 2.22,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.66,
      "end_seconds": 227.72,
      "duration_seconds": 4.06,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.5,
      "end_seconds": 233.01,
      "duration_seconds": 3.51,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.97,
      "end_seconds": 236.13,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.68,
      "end_seconds": 254.18,
      "duration_seconds": 7.5,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.64,
      "end_seconds": 268.72,
      "duration_seconds": 9.08,
      "text": "That's the examination finished. Okay, thinking it through, this looks most like a possible blood clot in the lung."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.94,
      "end_seconds": 273.22,
      "duration_seconds": 3.28,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 285.21,
      "duration_seconds": 9.16,
      "text": "I can't promise yet, but most people with a possible blood clot in the lung do well once it's treated properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.62,
      "end_seconds": 299.45,
      "duration_seconds": 4.83,
      "text": "I'm sending you for a D-dimer blood test because of possible clot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.22,
      "end_seconds": 303.24,
      "duration_seconds": 2.02,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.15,
      "end_seconds": 313.56,
      "duration_seconds": 9.41,
      "text": "I'm sending you for a CT scan of the chest because of breathlessness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.11,
      "end_seconds": 317.38,
      "duration_seconds": 2.27,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.77,
      "end_seconds": 346.49,
      "duration_seconds": 27.72,
      "text": "You need to go to hospital now for a scan. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I'm going to send a referral to the medical team. The thing that would worry me is if you feel faint. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.24,
      "end_seconds": 350.47,
      "duration_seconds": 2.23,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.12,
      "end_seconds": 355.59,
      "duration_seconds": 3.47,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.33,
      "end_seconds": 358.79,
      "duration_seconds": 1.46,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.42,
      "end_seconds": 366.21,
      "duration_seconds": 5.79,
      "text": "Okay, can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.94,
      "end_seconds": 372.41,
      "duration_seconds": 4.47,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.65,
      "end_seconds": 379.51,
      "duration_seconds": 5.86,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.46,
      "end_seconds": 383.33,
      "duration_seconds": 2.87,
      "text": "I think I understand everything. Thanks."
    }
  ]
}