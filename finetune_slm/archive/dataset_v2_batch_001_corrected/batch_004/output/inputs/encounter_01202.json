{
  "schema_version": "1.0",
  "encounter_id": "01202",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 7.15,
      "duration_seconds": 5.85,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.88,
      "end_seconds": 12.67,
      "duration_seconds": 4.79,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.6,
      "end_seconds": 26.24,
      "duration_seconds": 11.64,
      "text": "Hello, doctor, I came in with them, if that's okay. It's irregular periods, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.3,
      "end_seconds": 31.02,
      "duration_seconds": 3.72,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.39,
      "end_seconds": 36.13,
      "duration_seconds": 3.74,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.58,
      "end_seconds": 40.66,
      "duration_seconds": 3.08,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.32,
      "end_seconds": 48.55,
      "duration_seconds": 6.23,
      "text": "Mostly mild. I've been putting on weight too, since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.7,
      "end_seconds": 52.28,
      "duration_seconds": 2.58,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.16,
      "end_seconds": 62.64,
      "duration_seconds": 2.48,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.25,
      "end_seconds": 88.67,
      "duration_seconds": 5.42,
      "text": "Okay: pressure 121 over 71, temperature is 36.7 degrees, heart rate 71."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.04,
      "end_seconds": 91.59,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.37,
      "end_seconds": 95.93,
      "duration_seconds": 2.56,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.56,
      "end_seconds": 101.8,
      "duration_seconds": 4.24,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.81,
      "end_seconds": 105.62,
      "duration_seconds": 2.81,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.59,
      "end_seconds": 123.06,
      "duration_seconds": 8.47,
      "text": "Your weight is up a little, and there is acne on the jaw and some coarse hairs on the chin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.85,
      "end_seconds": 127.5,
      "duration_seconds": 1.65,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.66,
      "end_seconds": 145.74,
      "duration_seconds": 4.08,
      "text": "And what about palpitations, headaches or milky nipple discharge?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.76,
      "end_seconds": 161.11,
      "duration_seconds": 13.35,
      "text": "Mm, uh, no, no palpitations, no headaches, no milky nipple discharge. I did have acne at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.61,
      "end_seconds": 164.56,
      "duration_seconds": 2.95,
      "text": "Yes, carry on. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.59,
      "end_seconds": 167.19,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.96,
      "end_seconds": 172.23,
      "duration_seconds": 3.27,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.5,
      "end_seconds": 175.06,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 179.41,
      "duration_seconds": 2.44,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.76,
      "end_seconds": 185.17,
      "duration_seconds": 4.41,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.15,
      "end_seconds": 189.99,
      "duration_seconds": 3.84,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.75,
      "end_seconds": 197.4,
      "duration_seconds": 5.65,
      "text": "So, my grandfather had a stroke. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.41,
      "end_seconds": 200.29,
      "duration_seconds": 1.88,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.83,
      "end_seconds": 205.61,
      "duration_seconds": 3.78,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.4,
      "end_seconds": 209.3,
      "duration_seconds": 1.9,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.27,
      "end_seconds": 214.04,
      "duration_seconds": 3.77,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.69,
      "end_seconds": 217.35,
      "duration_seconds": 2.66,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.12,
      "end_seconds": 222.52,
      "duration_seconds": 3.4,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.13,
      "end_seconds": 228.6,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.41,
      "end_seconds": 236.04,
      "duration_seconds": 6.63,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.67,
      "end_seconds": 241.11,
      "duration_seconds": 3.44,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.47,
      "end_seconds": 248.89,
      "duration_seconds": 6.42,
      "text": "Erm, not with me. I'll bring it next time. Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.64,
      "end_seconds": 253.51,
      "duration_seconds": 3.87,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.26,
      "end_seconds": 256.8,
      "duration_seconds": 1.54,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.49,
      "end_seconds": 259.85,
      "duration_seconds": 1.36,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.58,
      "end_seconds": 268.64,
      "duration_seconds": 8.06,
      "text": "I have asthma, for nearly five years. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.47,
      "end_seconds": 270.72,
      "duration_seconds": 1.25,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.58,
      "end_seconds": 277.63,
      "duration_seconds": 5.05,
      "text": "Okay, I can see anxiety and asthma in your file as well."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.83,
      "end_seconds": 300.7,
      "duration_seconds": 4.87,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.43,
      "end_seconds": 314.32,
      "duration_seconds": 12.89,
      "text": "Yes, walnuts, it gives me my lips swelling. Yes, nickel. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.35,
      "end_seconds": 335.74,
      "duration_seconds": 20.39,
      "text": "Taking everything into account, it fits best with polycystic ovary syndrome. That's my thinking for now, and it may change as we learn more. Another possibility is a thyroid problem. Another possibility is high prolactin. We should do a thyroid test for irregular periods."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 336.56,
      "end_seconds": 339.02,
      "duration_seconds": 2.46,
      "text": "The earliest is Friday, 2 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.75,
      "end_seconds": 345.09,
      "duration_seconds": 5.34,
      "text": "I think hormone blood tests makes sense here, for irregular periods."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.92,
      "end_seconds": 348.32,
      "duration_seconds": 2.4,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.1,
      "end_seconds": 384.02,
      "duration_seconds": 33.92,
      "text": "Let's use metformin, 500 milligrams, twice a day with food, long term. It's for polycystic ovaries. Regular exercise and a lower-sugar diet help the periods settle. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.3,
      "end_seconds": 390.94,
      "duration_seconds": 5.64,
      "text": "Let me think, you know, I think I understand everything. Thanks."
    }
  ]
}