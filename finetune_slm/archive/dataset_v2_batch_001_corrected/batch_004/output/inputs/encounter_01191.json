{
  "schema_version": "1.0",
  "encounter_id": "01191",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.7,
      "duration_seconds": 5.83,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.46,
      "end_seconds": 12.76,
      "duration_seconds": 4.3,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 20.81,
      "duration_seconds": 7.06,
      "text": "I wanted to get a red itchy lump on my arm looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.84,
      "end_seconds": 25.88,
      "duration_seconds": 3.04,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.88,
      "end_seconds": 32.96,
      "duration_seconds": 6.08,
      "text": "I'd say about a week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.4,
      "end_seconds": 37.14,
      "duration_seconds": 2.74,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.74,
      "end_seconds": 41.53,
      "duration_seconds": 2.79,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.32,
      "end_seconds": 46.93,
      "duration_seconds": 3.61,
      "text": "What about mild swelling, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.1,
      "end_seconds": 49.17,
      "duration_seconds": 1.07,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.68,
      "end_seconds": 52.3,
      "duration_seconds": 2.62,
      "text": "Has there been any lip swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.12,
      "end_seconds": 57.27,
      "duration_seconds": 3.15,
      "text": "Not at all, no lip swelling."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.95,
      "end_seconds": 61.78,
      "duration_seconds": 3.83,
      "text": "Did you get breathing trouble, dizziness or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.75,
      "end_seconds": 66.79,
      "duration_seconds": 4.04,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.99,
      "end_seconds": 73.96,
      "duration_seconds": 3.97,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.51,
      "end_seconds": 77.22,
      "duration_seconds": 1.71,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.63,
      "end_seconds": 91.04,
      "duration_seconds": 2.41,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.82,
      "end_seconds": 97.91,
      "duration_seconds": 5.09,
      "text": "It's escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.62,
      "end_seconds": 102.07,
      "duration_seconds": 3.45,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.02,
      "end_seconds": 109.93,
      "duration_seconds": 5.91,
      "text": "For two years. I take an antihistamine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.83,
      "end_seconds": 118.68,
      "duration_seconds": 3.85,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.25,
      "end_seconds": 126.38,
      "duration_seconds": 6.13,
      "text": "I've got anxiety. I've had heart disease for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.36,
      "end_seconds": 133.16,
      "duration_seconds": 5.8,
      "text": "Yes, anxiety is known to us, good to have that clear. Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.05,
      "end_seconds": 138.29,
      "duration_seconds": 3.24,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.08,
      "end_seconds": 142.74,
      "duration_seconds": 2.66,
      "text": "Okay, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.83,
      "end_seconds": 146.49,
      "duration_seconds": 1.66,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.48,
      "end_seconds": 151.47,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.09,
      "end_seconds": 156.39,
      "duration_seconds": 3.3,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 159.26,
      "duration_seconds": 1.23,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.97,
      "end_seconds": 164.59,
      "duration_seconds": 3.62,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.3,
      "end_seconds": 169.01,
      "duration_seconds": 2.71,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.7,
      "end_seconds": 173.87,
      "duration_seconds": 3.17,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.27,
      "end_seconds": 177.77,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.33,
      "end_seconds": 182.23,
      "duration_seconds": 2.9,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.87,
      "end_seconds": 205.15,
      "duration_seconds": 5.28,
      "text": "So, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.77,
      "end_seconds": 212.22,
      "duration_seconds": 2.45,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.32,
      "end_seconds": 216.19,
      "duration_seconds": 2.87,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.38,
      "end_seconds": 224.69,
      "duration_seconds": 2.31,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.68,
      "end_seconds": 256.99,
      "duration_seconds": 11.31,
      "text": "Okay: respiratory rate 15, pulse is 68 beats a minute, oxygen saturation is 99 percent, pressure 118 over 80, temperature 36.7."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.04,
      "end_seconds": 263.95,
      "duration_seconds": 1.91,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.58,
      "end_seconds": 268.2,
      "duration_seconds": 2.62,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.84,
      "end_seconds": 274.5,
      "duration_seconds": 4.66,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.44,
      "end_seconds": 278.01,
      "duration_seconds": 1.57,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.04,
      "end_seconds": 281.27,
      "duration_seconds": 2.23,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.39,
      "end_seconds": 304.31,
      "duration_seconds": 7.92,
      "text": "There is a small red lump with a central punctum and a little swelling around it, and no spreading redness."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.78,
      "end_seconds": 317.87,
      "duration_seconds": 10.09,
      "text": "You can sit up now. Okay, so my impression is this: My working impression is a local insect bite reaction. Early cellulitis is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.4,
      "end_seconds": 325.62,
      "duration_seconds": 2.22,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.06,
      "end_seconds": 333.85,
      "duration_seconds": 6.79,
      "text": "Nothing I've seen today points to an emergency. It looks like a local insect bite reaction."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.64,
      "end_seconds": 348.43,
      "duration_seconds": 5.79,
      "text": "Cool it with ice and avoid scratching. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.44,
      "end_seconds": 353.89,
      "duration_seconds": 3.45,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.59,
      "end_seconds": 356.8,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}