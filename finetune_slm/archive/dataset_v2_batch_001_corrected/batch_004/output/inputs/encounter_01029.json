    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.14,
      "end_seconds": 71.67,
      "duration_seconds": 2.53,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.63,
      "end_seconds": 101.06,
      "duration_seconds": 7.43,
      "text": "okay: temperature 36.6 heart rate 70 BP is 121 over 81. And saturation 98 percent"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.88,
      "end_seconds": 105.84,
      "duration_seconds": 1.96,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.07,
      "end_seconds": 109.24,
      "duration_seconds": 2.17,
      "text": "I'm just checking this side"
    },
