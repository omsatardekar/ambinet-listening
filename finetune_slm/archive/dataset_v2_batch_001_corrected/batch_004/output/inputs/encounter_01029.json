    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.95,
      "end_seconds": 59.62,
      "duration_seconds": 4.67,
      "text": "can I check a few measurements before we carry on?"
