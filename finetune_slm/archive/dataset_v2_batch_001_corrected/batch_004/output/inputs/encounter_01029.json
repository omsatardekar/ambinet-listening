    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.88,
      "end_seconds": 28.57,
      "duration_seconds": 2.69,
      "text": "how much does it limit you?"
