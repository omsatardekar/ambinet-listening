{
  "schema_version": "1.0",
  "encounter_id": "01129",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 5.64,
      "duration_seconds": 4.91,
      "text": "So, you know, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.57,
      "end_seconds": 11.56,
      "duration_seconds": 3.99,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.87,
      "end_seconds": 19.37,
      "duration_seconds": 6.5,
      "text": "Mainly I've been getting breathless lying flat. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.15,
      "end_seconds": 23.48,
      "duration_seconds": 2.33,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.92,
      "end_seconds": 26.93,
      "duration_seconds": 2.01,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.9,
      "end_seconds": 31.2,
      "duration_seconds": 2.3,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.76,
      "end_seconds": 36.94,
      "duration_seconds": 5.18,
      "text": "Oh, um, lying flat definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.29,
      "end_seconds": 41.34,
      "duration_seconds": 3.05,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 63.2,
      "duration_seconds": 21.1,
      "text": "Swollen ankles goes along with it, most of the time. Let me think, uh, with Swollen ankles, a four out of ten, I suppose. So, um, and there's tiredness as well, four weeks now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.15,
      "end_seconds": 70.49,
      "duration_seconds": 5.34,
      "text": "Have you been getting breathless lying flat at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.05,
      "end_seconds": 76.73,
      "duration_seconds": 5.68,
      "text": "a bit, last year it settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.43,
      "end_seconds": 81.91,
      "duration_seconds": 3.48,
      "text": "Have you noticed palpitations, fainting or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.48,
      "end_seconds": 89.01,
      "duration_seconds": 5.53,
      "text": "No palpitations, fainting or chest pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.27,
      "end_seconds": 91.38,
      "duration_seconds": 2.11,
      "text": "I follow. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.75,
      "end_seconds": 95.04,
      "duration_seconds": 2.29,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.28,
      "end_seconds": 98.99,
      "duration_seconds": 2.71,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.85,
      "end_seconds": 105.0,
      "duration_seconds": 5.15,
      "text": "I, I take telmisartan, 40 milligrams, once a day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.42,
      "end_seconds": 106.12,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.57,
      "end_seconds": 113.67,
      "duration_seconds": 6.1,
      "text": "It's metoprolol, 50 milligrams, maybe, twice a day for my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.92,
      "end_seconds": 118.41,
      "duration_seconds": 3.49,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.33,
      "end_seconds": 124.24,
      "duration_seconds": 3.91,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.88,
      "end_seconds": 141.16,
      "duration_seconds": 4.28,
      "text": "Right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.98,
      "end_seconds": 144.44,
      "duration_seconds": 2.46,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.16,
      "end_seconds": 161.79,
      "duration_seconds": 6.63,
      "text": "Do you have any long-term conditions? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.39,
      "end_seconds": 181.94,
      "duration_seconds": 18.55,
      "text": "I've got high blood pressure. Heart failure, for nearly five years. Work has been very busy so I kept ignoring it. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.52,
      "end_seconds": 185.27,
      "duration_seconds": 1.75,
      "text": "So, any other things?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.06,
      "end_seconds": 199.01,
      "duration_seconds": 12.95,
      "text": "okay, I can see high blood pressure and heart failure in your file as well. Alright, tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.7,
      "end_seconds": 214.17,
      "duration_seconds": 13.47,
      "text": "I'm vegetarian and have been for years. My husband and I live above the shop. I hardly move around during the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.56,
      "end_seconds": 226.89,
      "duration_seconds": 2.33,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.75,
      "end_seconds": 233.39,
      "duration_seconds": 5.64,
      "text": "yes, plasters, it gives me a red itchy rash"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.07,
      "end_seconds": 239.43,
      "duration_seconds": 4.36,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.49,
      "end_seconds": 249.81,
      "duration_seconds": 2.32,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.98,
      "end_seconds": 267.26,
      "duration_seconds": 7.28,
      "text": "Okay: oxygen saturation is 92 percent, heart rate 85, BP is 132 over 88. And respiratory rate 23."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.86,
      "end_seconds": 269.63,
      "duration_seconds": 1.77,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.05,
      "end_seconds": 296.5,
      "duration_seconds": 25.45,
      "text": "I'll interpret them after the examination going by what you've described, I don't have a clear answer today: heart failure with some fluid on board is possible, and so is a kidney problem i'd like to arrange an echocardiogram for heart failure that will help us see what's going on underneath and decide the next step"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 297.63,
      "end_seconds": 302.05,
      "duration_seconds": 4.42,
      "text": "we have a slot Friday at 11:30 am, if that works"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.56,
      "end_seconds": 311.34,
      "duration_seconds": 8.78,
      "text": "I'd like to arrange blood tests for heart failure. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.24,
      "end_seconds": 316.65,
      "duration_seconds": 4.41,
      "text": "Let me think, how long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.43,
      "end_seconds": 324.68,
      "duration_seconds": 7.25,
      "text": "Let's use furosemide, 40 milligrams, once a day in the morning, long term. That's for fluid retention."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.96,
      "end_seconds": 333.11,
      "duration_seconds": 5.15,
      "text": "I mean, alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.83,
      "end_seconds": 344.51,
      "duration_seconds": 10.68,
      "text": "Weigh yourself every morning and tell us if you gain two kilos in three days. We'll refer you to the heart failure nurse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.6,
      "end_seconds": 349.7,
      "duration_seconds": 3.1,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.37,
      "end_seconds": 367.89,
      "duration_seconds": 16.52,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait. Come back in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.11,
      "end_seconds": 369.81,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.38,
      "end_seconds": 374.33,
      "duration_seconds": 3.95,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.73,
      "end_seconds": 380.47,
      "duration_seconds": 4.74,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    }
  ]
}