{
  "schema_version": "1.0",
  "encounter_id": "01177",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.91,
      "duration_seconds": 5.71,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.35,
      "end_seconds": 12.48,
      "duration_seconds": 4.13,
      "text": "Right, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.58,
      "end_seconds": 19.63,
      "duration_seconds": 5.05,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.45,
      "end_seconds": 23.27,
      "duration_seconds": 2.82,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.7,
      "end_seconds": 31.11,
      "duration_seconds": 6.41,
      "text": "Actually, it's a severe headache, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.82,
      "end_seconds": 35.49,
      "duration_seconds": 3.67,
      "text": "So, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.42,
      "end_seconds": 49.57,
      "duration_seconds": 2.15,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.02,
      "end_seconds": 80.97,
      "duration_seconds": 14.95,
      "text": "Okay: oxygen saturation is 96 percent, respiratory rate 16. And blood pressure 104 over 76, pulse is 104 beats a minute, temp 38.8 degrees. So, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.1,
      "end_seconds": 87.31,
      "duration_seconds": 2.21,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.69,
      "end_seconds": 91.76,
      "duration_seconds": 3.07,
      "text": "So, is it worse at certain times?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.62,
      "end_seconds": 95.43,
      "duration_seconds": 2.81,
      "text": "I notice it more with light."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 103.14,
      "duration_seconds": 3.14,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.03,
      "end_seconds": 115.56,
      "duration_seconds": 11.53,
      "text": "Mostly severe. I've, I've had a rash that does not fade too, for four weeks. And there's a high fever as well, two months now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.14,
      "end_seconds": 121.91,
      "duration_seconds": 5.77,
      "text": "Have you had a severe headache before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.24,
      "end_seconds": 127.96,
      "duration_seconds": 4.72,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.26,
      "end_seconds": 134.47,
      "duration_seconds": 3.21,
      "text": "And what about cough or recent head injury?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.78,
      "end_seconds": 139.8,
      "duration_seconds": 4.02,
      "text": "Let me think, no, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.17,
      "end_seconds": 143.48,
      "duration_seconds": 2.31,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.61,
      "end_seconds": 149.22,
      "duration_seconds": 4.61,
      "text": "Hmm, uh, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.17,
      "end_seconds": 152.57,
      "duration_seconds": 1.4,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.99,
      "end_seconds": 155.67,
      "duration_seconds": 1.68,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.01,
      "end_seconds": 157.86,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.23,
      "end_seconds": 163.35,
      "duration_seconds": 4.12,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.47,
      "end_seconds": 166.9,
      "duration_seconds": 2.43,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.8,
      "end_seconds": 172.32,
      "duration_seconds": 3.52,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.33,
      "end_seconds": 181.14,
      "duration_seconds": 2.81,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.51,
      "end_seconds": 186.13,
      "duration_seconds": 3.62,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.96,
      "end_seconds": 192.04,
      "duration_seconds": 5.08,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.04,
      "end_seconds": 198.96,
      "duration_seconds": 5.92,
      "text": "Right, I'm on simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 199.57,
      "end_seconds": 209.8,
      "duration_seconds": 10.23,
      "text": "Doctor, I think the last prescription for the simvastatin was 40 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.9,
      "end_seconds": 214.97,
      "duration_seconds": 4.07,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.66,
      "end_seconds": 219.84,
      "duration_seconds": 4.18,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 231.27,
      "duration_seconds": 4.16,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.09,
      "end_seconds": 235.17,
      "duration_seconds": 2.08,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.09,
      "end_seconds": 238.72,
      "duration_seconds": 2.63,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.24,
      "end_seconds": 242.79,
      "duration_seconds": 3.55,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.32,
      "end_seconds": 256.66,
      "duration_seconds": 2.34,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.83,
      "end_seconds": 260.73,
      "duration_seconds": 2.9,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 261.64,
      "end_seconds": 269.27,
      "duration_seconds": 7.63,
      "text": "Hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.26,
      "end_seconds": 272.83,
      "duration_seconds": 2.57,
      "text": "Right, I don't remember that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.65,
      "end_seconds": 277.31,
      "duration_seconds": 2.66,
      "text": "Okay, I'll note both of those."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.98,
      "end_seconds": 284.27,
      "duration_seconds": 4.29,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 288.44,
      "duration_seconds": 2.35,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.33,
      "end_seconds": 308.14,
      "duration_seconds": 7.81,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.78,
      "end_seconds": 312.66,
      "duration_seconds": 1.88,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.82,
      "end_seconds": 348.6,
      "duration_seconds": 20.78,
      "text": "From what you've told me and what I found, I don't have a clear answer today: possible bacterial meningitis is possible, and so is meningococcal septicaemia. Let me repeat that back to make sure. You've had a severe headache for three days, severe, and no cough or recent head injury."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.73,
      "end_seconds": 351.92,
      "duration_seconds": 2.19,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.86,
      "end_seconds": 379.83,
      "duration_seconds": 26.97,
      "text": "A lumbar puncture is what I'd like next, for possible meningitis. Blood cultures is what I'd like next, for possible meningitis. It's a routine test and it'll give us a much clearer picture. Let's use benzylpenicillin, 1.2 grams, once now, single dose. It's for possible meningitis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.01,
      "end_seconds": 384.19,
      "duration_seconds": 3.18,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.36,
      "end_seconds": 397.87,
      "duration_seconds": 12.51,
      "text": "Call an ambulance now, this is an emergency. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.67,
      "end_seconds": 401.82,
      "duration_seconds": 2.15,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.5,
      "end_seconds": 408.81,
      "duration_seconds": 6.31,
      "text": "I'd like to see you again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.24,
      "end_seconds": 413.16,
      "duration_seconds": 2.92,
      "text": "I think I understand everything. Thanks."
    }
  ]
}