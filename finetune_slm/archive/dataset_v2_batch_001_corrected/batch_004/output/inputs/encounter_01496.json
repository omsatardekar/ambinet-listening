{
  "schema_version": "1.0",
  "encounter_id": "01496",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 6.31,
      "duration_seconds": 5.77,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.94,
      "end_seconds": 15.2,
      "duration_seconds": 4.26,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.07,
      "end_seconds": 22.95,
      "duration_seconds": 2.88,
      "text": "It's a long seizure, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.84,
      "end_seconds": 25.82,
      "duration_seconds": 1.98,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.85,
      "end_seconds": 40.53,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.77,
      "end_seconds": 72.17,
      "duration_seconds": 12.4,
      "text": "Okay: pulse is 117 beats a minute, pressure 115 over 79, respiratory rate 16. And temperature is 36.9 degrees, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.37,
      "end_seconds": 95.27,
      "duration_seconds": 6.9,
      "text": "When was the first time you noticed it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.87,
      "end_seconds": 99.52,
      "duration_seconds": 3.65,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.11,
      "end_seconds": 104.55,
      "duration_seconds": 3.44,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.48,
      "end_seconds": 110.12,
      "duration_seconds": 3.64,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.65,
      "end_seconds": 115.56,
      "duration_seconds": 4.91,
      "text": "What about being drowsy and confused afterwards, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.12,
      "end_seconds": 122.05,
      "duration_seconds": 2.93,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.27,
      "end_seconds": 123.3,
      "duration_seconds": 1.03,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.52,
      "end_seconds": 144.91,
      "duration_seconds": 3.39,
      "text": "Alright, did you get fever or head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.06,
      "end_seconds": 149.06,
      "duration_seconds": 3.0,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.64,
      "end_seconds": 154.28,
      "duration_seconds": 3.64,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.7,
      "end_seconds": 157.63,
      "duration_seconds": 1.93,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.8,
      "end_seconds": 165.06,
      "duration_seconds": 4.26,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.75,
      "end_seconds": 169.99,
      "duration_seconds": 4.24,
      "text": "I've had epilepsy for about a year now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.92,
      "end_seconds": 173.69,
      "duration_seconds": 1.77,
      "text": "Mm, okay. Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.17,
      "end_seconds": 178.81,
      "duration_seconds": 3.64,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 182.76,
      "duration_seconds": 1.97,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.8,
      "end_seconds": 186.26,
      "duration_seconds": 1.46,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.27,
      "end_seconds": 188.75,
      "duration_seconds": 1.48,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.47,
      "end_seconds": 194.05,
      "duration_seconds": 3.58,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.2,
      "end_seconds": 201.3,
      "duration_seconds": 2.1,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.77,
      "end_seconds": 208.53,
      "duration_seconds": 5.76,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.4,
      "end_seconds": 211.86,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.77,
      "end_seconds": 215.02,
      "duration_seconds": 1.25,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.77,
      "end_seconds": 219.05,
      "duration_seconds": 3.28,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.1,
      "end_seconds": 226.44,
      "duration_seconds": 6.34,
      "text": "Levetiracetam. I take it 500 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.93,
      "end_seconds": 263.28,
      "duration_seconds": 18.35,
      "text": "Listening to the whole story, this is probably a prolonged seizure in a person with epilepsy. I'm going to order blood tests including drug levels, for seizure. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 263.93,
      "end_seconds": 268.08,
      "duration_seconds": 4.15,
      "text": "I can book that for Monday at 11:30 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.95,
      "end_seconds": 277.64,
      "duration_seconds": 8.69,
      "text": "I'm going to put you on lorazepam, 4 milligrams, once now, single dose. It's for prolonged seizure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.65,
      "end_seconds": 281.36,
      "duration_seconds": 1.71,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.11,
      "end_seconds": 301.3,
      "duration_seconds": 18.19,
      "text": "Lie on your side while we monitor you. The emergency team would be the right next step, I'll refer you. Do get help quickly if the symptoms get worse. I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.24,
      "end_seconds": 306.09,
      "duration_seconds": 2.85,
      "text": "Great, thank you for your help."
    }
  ]
}