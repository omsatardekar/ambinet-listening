{
  "schema_version": "1.0",
  "encounter_id": "01390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.6,
      "duration_seconds": 3.28,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 11.15,
      "duration_seconds": 5.35,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.04,
      "end_seconds": 19.04,
      "duration_seconds": 7.0,
      "text": "Actually, so the thing is, I've got a tight band around my head."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.86,
      "end_seconds": 22.31,
      "duration_seconds": 2.45,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.1,
      "end_seconds": 37.52,
      "duration_seconds": 2.42,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.07,
      "end_seconds": 55.05,
      "duration_seconds": 7.98,
      "text": "Okay: temp 36.4 degrees, pressure 108 over 80, SpO2 98 percent on room air, heart rate 84."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.4,
      "end_seconds": 58.48,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.42,
      "end_seconds": 67.96,
      "duration_seconds": 8.54,
      "text": "They help me see the whole picture, more shortly. Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.66,
      "end_seconds": 80.75,
      "duration_seconds": 11.09,
      "text": "I've had it for about two weeks. I've never really been one for hospitals. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.18,
      "end_seconds": 84.84,
      "duration_seconds": 2.66,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.89,
      "end_seconds": 97.45,
      "duration_seconds": 11.56,
      "text": "I, I'd say a few times a day. I've also had a stiff neck. I mean, with stiff neck, I'd say all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.78,
      "end_seconds": 102.33,
      "duration_seconds": 4.55,
      "text": "Understood. Okay, have you had any sickness or blurred vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.06,
      "end_seconds": 109.81,
      "duration_seconds": 2.75,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 114.32,
      "duration_seconds": 3.54,
      "text": "Have you had any weakness or sensitivity to light?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.09,
      "end_seconds": 119.46,
      "duration_seconds": 4.37,
      "text": "I haven't had weakness or sensitivity to light, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.61,
      "end_seconds": 124.47,
      "duration_seconds": 3.86,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.47,
      "end_seconds": 127.86,
      "duration_seconds": 1.39,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.23,
      "end_seconds": 144.7,
      "duration_seconds": 2.47,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.94,
      "end_seconds": 148.98,
      "duration_seconds": 3.04,
      "text": "High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.37,
      "end_seconds": 156.05,
      "duration_seconds": 5.68,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.53,
      "end_seconds": 168.06,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.81,
      "end_seconds": 173.3,
      "duration_seconds": 3.49,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.24,
      "end_seconds": 175.9,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.36,
      "end_seconds": 180.2,
      "duration_seconds": 2.84,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.7,
      "end_seconds": 182.13,
      "duration_seconds": 1.43,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.51,
      "end_seconds": 186.22,
      "duration_seconds": 2.71,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.46,
      "end_seconds": 207.48,
      "duration_seconds": 3.02,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.31,
      "end_seconds": 211.14,
      "duration_seconds": 2.83,
      "text": "Well, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.17,
      "end_seconds": 225.31,
      "duration_seconds": 4.14,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.88,
      "end_seconds": 229.43,
      "duration_seconds": 2.55,
      "text": "I'm on paracetamol, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.37,
      "end_seconds": 233.59,
      "duration_seconds": 2.22,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.25,
      "end_seconds": 240.12,
      "duration_seconds": 4.87,
      "text": "1 gram, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.63,
      "end_seconds": 246.14,
      "duration_seconds": 5.51,
      "text": "Mm-hmm. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.85,
      "end_seconds": 249.93,
      "duration_seconds": 3.08,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.2,
      "end_seconds": 254.23,
      "duration_seconds": 3.03,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.42,
      "end_seconds": 256.61,
      "duration_seconds": 1.19,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.39,
      "end_seconds": 271.27,
      "duration_seconds": 5.88,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.65,
      "end_seconds": 293.59,
      "duration_seconds": 16.94,
      "text": "You can sit up now. Okay, so my impression is this: It's hard to say. Tension-type headache is one possibility and eye strain another, and I'd rather not commit yet. I'm going to order an eye test, for eye strain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.25,
      "end_seconds": 299.32,
      "duration_seconds": 5.07,
      "text": "We have a slot Thursday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.12,
      "end_seconds": 302.1,
      "duration_seconds": 1.98,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.25,
      "end_seconds": 310.88,
      "duration_seconds": 7.63,
      "text": "Take screen breaks every hour and try regular neck stretches. Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.9,
      "end_seconds": 314.54,
      "duration_seconds": 1.64,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.52,
      "end_seconds": 318.95,
      "duration_seconds": 2.43,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.01,
      "end_seconds": 325.85,
      "duration_seconds": 2.84,
      "text": "I think I understand everything. Thanks."
    }
  ]
}