{
  "schema_version": "1.0",
  "encounter_id": "01134",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 7.65,
      "duration_seconds": 6.72,
      "text": "Come in, have a seat by the desk. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.84,
      "end_seconds": 13.31,
      "duration_seconds": 4.47,
      "text": "I'm here because of sores in my mouth."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.8,
      "end_seconds": 17.86,
      "duration_seconds": 3.06,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.66,
      "end_seconds": 30.02,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.23,
      "end_seconds": 61.46,
      "duration_seconds": 11.23,
      "text": "Okay: pulse is 103 beats a minute, oxygen saturation is 97 percent, BP is 121 over 66. And temperature is 39.3 degrees."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.57,
      "end_seconds": 71.51,
      "duration_seconds": 2.94,
      "text": "Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.4,
      "end_seconds": 74.89,
      "duration_seconds": 1.49,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.43,
      "end_seconds": 78.62,
      "duration_seconds": 3.19,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.67,
      "end_seconds": 85.37,
      "duration_seconds": 4.7,
      "text": "Oh, it usually comes with a painful widespread rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.11,
      "end_seconds": 89.17,
      "duration_seconds": 3.06,
      "text": "Alright, has there been a fever too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.06,
      "end_seconds": 99.52,
      "duration_seconds": 9.46,
      "text": "Yeah, that too. About fever, a six out of ten, I suppose. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.32,
      "end_seconds": 103.07,
      "duration_seconds": 2.75,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.77,
      "end_seconds": 104.85,
      "duration_seconds": 1.08,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.49,
      "end_seconds": 109.02,
      "duration_seconds": 2.53,
      "text": "Any insect bite or new medicine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.89,
      "end_seconds": 113.76,
      "duration_seconds": 2.87,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.52,
      "end_seconds": 117.2,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.19,
      "end_seconds": 120.9,
      "duration_seconds": 2.71,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.57,
      "end_seconds": 128.18,
      "duration_seconds": 1.61,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.17,
      "end_seconds": 130.25,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.16,
      "end_seconds": 135.06,
      "duration_seconds": 2.9,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.84,
      "end_seconds": 138.76,
      "duration_seconds": 2.92,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.91,
      "end_seconds": 141.59,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.29,
      "end_seconds": 145.58,
      "duration_seconds": 3.29,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.15,
      "end_seconds": 147.44,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.97,
      "end_seconds": 152.15,
      "duration_seconds": 3.18,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.68,
      "end_seconds": 158.07,
      "duration_seconds": 4.39,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.69,
      "end_seconds": 163.88,
      "duration_seconds": 4.19,
      "text": "Ah, yes, naproxen, it gives me a rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.65,
      "end_seconds": 167.49,
      "duration_seconds": 2.84,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.49,
      "end_seconds": 183.55,
      "duration_seconds": 14.06,
      "text": "Aspirin, 75 milligrams, once a day. It's a relief to finally sit down and talk about it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.88,
      "end_seconds": 189.01,
      "duration_seconds": 4.13,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.77,
      "end_seconds": 192.95,
      "duration_seconds": 2.18,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.07,
      "end_seconds": 198.97,
      "duration_seconds": 4.9,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.64,
      "end_seconds": 201.7,
      "duration_seconds": 1.06,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.53,
      "end_seconds": 204.92,
      "duration_seconds": 2.39,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.03,
      "end_seconds": 223.77,
      "duration_seconds": 6.74,
      "text": "There are dusky red patches with blistering and the skin peels when I rub it lightly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.98,
      "end_seconds": 230.87,
      "duration_seconds": 2.89,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.3,
      "end_seconds": 256.55,
      "duration_seconds": 8.25,
      "text": "So where does that leave us? This looks most like a severe drug reaction of the skin."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.02,
      "end_seconds": 262.69,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.25,
      "end_seconds": 276.75,
      "duration_seconds": 12.5,
      "text": "I understand the worry. At the moment I'd say it's a severe drug reaction of the skin, and we'll know more once the an urgent dermatology review is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.89,
      "end_seconds": 316.56,
      "duration_seconds": 32.67,
      "text": "We should do an urgent dermatology review for severe drug reaction. The result will help us decide whether anything more is needed. Stop the antibiotic now and I am sending you to hospital immediately. I'd like you to see the dermatology team as well, and I'll write the referral. I'm not ordering blood tests today. If things carry on in a month, we'll consider it. Please come and see me straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.75,
      "end_seconds": 322.26,
      "duration_seconds": 4.51,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.59,
      "end_seconds": 324.86,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}