{
  "schema_version": "1.0",
  "encounter_id": "01393",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 3.37,
      "duration_seconds": 2.58,
      "text": "right then, come on in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.81,
      "end_seconds": 8.59,
      "duration_seconds": 3.78,
      "text": "thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.68,
      "end_seconds": 12.47,
      "duration_seconds": 2.79,
      "text": "Is it your first time here?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.3,
      "end_seconds": 19.36,
      "duration_seconds": 5.06,
      "text": "Hmm, no, I came last year for something else."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.51,
      "end_seconds": 23.45,
      "duration_seconds": 2.94,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.15,
      "end_seconds": 30.91,
      "duration_seconds": 5.76,
      "text": "Doctor, it's a stiff neck. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.13,
      "end_seconds": 35.21,
      "duration_seconds": 3.08,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.04,
      "end_seconds": 45.54,
      "duration_seconds": 2.5,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.56,
      "end_seconds": 80.42,
      "duration_seconds": 15.86,
      "text": "Okay: BMI works out to 25.3, height 164 centimetres, respiratory rate 22, pressure 113 over 69, saturation 95 percent, pulse is 102 beats a minute, weight 68 kilos, temperature is 39.0 degrees."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.4,
      "end_seconds": 82.92,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.91,
      "end_seconds": 92.32,
      "duration_seconds": 7.41,
      "text": "I'll explain what these mean in a moment. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.68,
      "end_seconds": 98.37,
      "duration_seconds": 4.69,
      "text": "Oh, it's been like this since this morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.09,
      "end_seconds": 109.54,
      "duration_seconds": 10.45,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 126.3,
      "duration_seconds": 15.44,
      "text": "it just comes and goes. I'd say mild. I've had a high fever too, for about three months. I mean, I've also had hating the light, for four weeks"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.36,
      "end_seconds": 132.42,
      "duration_seconds": 4.06,
      "text": "A few quick ones: cough or recent head injury?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.92,
      "end_seconds": 137.51,
      "duration_seconds": 4.59,
      "text": "Uh, um, no, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.23,
      "end_seconds": 141.25,
      "duration_seconds": 3.02,
      "text": "So, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.28,
      "end_seconds": 146.38,
      "duration_seconds": 4.1,
      "text": "Hmm, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.96,
      "end_seconds": 150.38,
      "duration_seconds": 2.42,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.87,
      "end_seconds": 153.7,
      "duration_seconds": 1.83,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.52,
      "end_seconds": 157.95,
      "duration_seconds": 2.43,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.93,
      "end_seconds": 163.57,
      "duration_seconds": 1.64,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.65,
      "end_seconds": 172.01,
      "duration_seconds": 3.36,
      "text": "right, right have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.65,
      "end_seconds": 176.8,
      "duration_seconds": 4.15,
      "text": "ah, no, I've never been operated on"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.15,
      "end_seconds": 186.42,
      "duration_seconds": 5.27,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.45,
      "end_seconds": 193.62,
      "duration_seconds": 6.17,
      "text": "Uh, you know, yes, walnuts. I get my lips swelling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.69,
      "end_seconds": 198.08,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 199.19,
      "end_seconds": 206.45,
      "duration_seconds": 7.26,
      "text": "she is on mirtazapine, 15 milligrams, at night, I give it to her"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.16,
      "end_seconds": 218.92,
      "duration_seconds": 1.76,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.74,
      "end_seconds": 222.9,
      "duration_seconds": 3.16,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.5,
      "end_seconds": 226.58,
      "duration_seconds": 2.08,
      "text": "Okay, how about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.54,
      "end_seconds": 232.09,
      "duration_seconds": 3.55,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.48,
      "end_seconds": 237.11,
      "duration_seconds": 3.63,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.73,
      "end_seconds": 244.36,
      "duration_seconds": 3.63,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.54,
      "end_seconds": 250.56,
      "duration_seconds": 2.02,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.04,
      "end_seconds": 255.98,
      "duration_seconds": 3.94,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.92,
      "end_seconds": 262.96,
      "duration_seconds": 4.04,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.48,
      "end_seconds": 267.21,
      "duration_seconds": 2.73,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.89,
      "end_seconds": 286.32,
      "duration_seconds": 8.43,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.67,
      "end_seconds": 291.38,
      "duration_seconds": 1.71,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.2,
      "end_seconds": 318.3,
      "duration_seconds": 12.1,
      "text": "So, based on the history and the examination, it's hard to say. Possible bacterial meningitis is one possibility and meningococcal septicaemia another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.42,
      "end_seconds": 339.07,
      "duration_seconds": 4.65,
      "text": "Let's book a lumbar puncture to look into possible meningitis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 340.26,
      "end_seconds": 344.36,
      "duration_seconds": 4.1,
      "text": "Right, uh, when would that take place?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.89,
      "end_seconds": 358.72,
      "duration_seconds": 13.83,
      "text": "I'll request blood cultures, it'll help with possible meningitis i'm going to put you on benzylpenicillin, 1.2 grams, once now, single dose that should help with possible meningitis"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 360.48,
      "end_seconds": 363.86,
      "duration_seconds": 3.38,
      "text": "should I take that with food?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.72,
      "end_seconds": 378.25,
      "duration_seconds": 12.53,
      "text": "Call an ambulance now, this is an emergency. Come back or go to emergency straight away if you cannot go now. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.9,
      "end_seconds": 382.56,
      "duration_seconds": 3.66,
      "text": "oh, uh, that's fine with me"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.26,
      "end_seconds": 386.95,
      "duration_seconds": 2.69,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 390.38,
      "end_seconds": 394.75,
      "duration_seconds": 4.37,
      "text": "Okay, so great, thank you for your help."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.77,
      "end_seconds": 398.58,
      "duration_seconds": 1.81,
      "text": "Alright, look after yourself."
    }
  ]
}