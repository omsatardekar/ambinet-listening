{
  "schema_version": "1.0",
  "encounter_id": "01465",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 4.28,
      "duration_seconds": 2.92,
      "text": "hello, come in. Mind the step"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.78,
      "end_seconds": 12.0,
      "duration_seconds": 6.22,
      "text": "Sorry, what was I saying, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.91,
      "end_seconds": 19.84,
      "duration_seconds": 5.93,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.98,
      "end_seconds": 24.71,
      "duration_seconds": 3.73,
      "text": "Absolutely, come and sit beside them. What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.41,
      "end_seconds": 31.68,
      "duration_seconds": 6.27,
      "text": "Doctor, it's burning when I pass urine. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.26,
      "end_seconds": 34.61,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.7,
      "end_seconds": 39.13,
      "duration_seconds": 2.43,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.76,
      "end_seconds": 44.31,
      "duration_seconds": 3.55,
      "text": "it was closer to five days, doctor"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.57,
      "end_seconds": 50.52,
      "duration_seconds": 4.95,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.52,
      "end_seconds": 54.57,
      "duration_seconds": 2.05,
      "text": "Yeah, uh, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.66,
      "end_seconds": 58.83,
      "duration_seconds": 3.17,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.27,
      "end_seconds": 71.76,
      "duration_seconds": 11.49,
      "text": "I mean, only drinking water, and it's not much. I've had a dull ache low in my tummy too, for six months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.31,
      "end_seconds": 77.19,
      "duration_seconds": 3.88,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.75,
      "end_seconds": 86.8,
      "duration_seconds": 8.05,
      "text": "Mostly severe. Um, I've been going to the toilet often too, for about four days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.58,
      "end_seconds": 92.15,
      "duration_seconds": 4.57,
      "text": "any fever, vaginal discharge, back pain or blood in the urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.0,
      "end_seconds": 100.65,
      "duration_seconds": 3.65,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.13,
      "end_seconds": 106.55,
      "duration_seconds": 5.42,
      "text": "Understood. Right, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.84,
      "end_seconds": 110.21,
      "duration_seconds": 2.37,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.89,
      "end_seconds": 115.04,
      "duration_seconds": 3.15,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.96,
      "end_seconds": 119.58,
      "duration_seconds": 3.62,
      "text": "nothing on the skin, um, no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.57,
      "end_seconds": 137.77,
      "duration_seconds": 3.2,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.72,
      "end_seconds": 152.16,
      "duration_seconds": 12.44,
      "text": "I only drink at family occasions. I've never touched a cigarette. I retired from the post office two years ago. My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.14,
      "end_seconds": 172.51,
      "duration_seconds": 3.37,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.03,
      "end_seconds": 178.8,
      "duration_seconds": 4.77,
      "text": "Mm, my grandmother had dementia. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.56,
      "end_seconds": 182.27,
      "duration_seconds": 1.71,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.16,
      "end_seconds": 186.52,
      "duration_seconds": 3.36,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.28,
      "end_seconds": 191.0,
      "duration_seconds": 3.72,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.82,
      "end_seconds": 199.38,
      "duration_seconds": 7.56,
      "text": "I'm allergic to kiwi, I get an itchy mouth. Yes, naproxen, it gives me a rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.26,
      "end_seconds": 202.48,
      "duration_seconds": 2.22,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.99,
      "end_seconds": 211.77,
      "duration_seconds": 8.78,
      "text": "it's sitagliptin, 100 milligrams, once a day i take aspirin, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.87,
      "end_seconds": 216.17,
      "duration_seconds": 3.3,
      "text": "So, since when have you been taking it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.41,
      "end_seconds": 221.95,
      "duration_seconds": 4.54,
      "text": "about about three months it's cranberry juice, daily"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.55,
      "end_seconds": 229.1,
      "duration_seconds": 6.55,
      "text": "Do you have any long-term conditions? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.69,
      "end_seconds": 237.4,
      "duration_seconds": 6.71,
      "text": "Diabetes, for five years i have heart disease, for nearly five years"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 250.73,
      "end_seconds": 257.92,
      "duration_seconds": 7.19,
      "text": "Doctor, I've got the readings for you. Heart rate 77, BP is 113 over 82, temperature 36.8."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.54,
      "end_seconds": 260.55,
      "duration_seconds": 1.01,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.91,
      "end_seconds": 265.28,
      "duration_seconds": 2.37,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.43,
      "end_seconds": 267.95,
      "duration_seconds": 1.52,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.37,
      "end_seconds": 272.6,
      "duration_seconds": 3.23,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.58,
      "end_seconds": 291.63,
      "duration_seconds": 5.05,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.03,
      "end_seconds": 318.95,
      "duration_seconds": 24.92,
      "text": "that's all I needed to check so, based on the history and the examination, the most likely explanation is an uncomplicated urinary infection i'd also keep vaginal irritation in mind stop me if I've got anything wrong you've had burning when you pass urine, and no vaginal discharge or back pain"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.5,
      "end_seconds": 321.21,
      "duration_seconds": 1.71,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 324.89,
      "end_seconds": 331.4,
      "duration_seconds": 6.51,
      "text": "Doctor, I did a urine dipstick before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.78,
      "end_seconds": 364.43,
      "duration_seconds": 31.65,
      "text": "Right, thank you. We'll begin with nitrofurantoin, 100 milligrams, twice a day, three days. That's for urinary infection. Drink plenty of water and avoid holding urine. Cut down on salt and fried food for now, it really does make a difference. If you get a fever or back pain, or you feel really unwell, please come to the emergency department. See me again if it is not better in three days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.68,
      "end_seconds": 369.46,
      "duration_seconds": 3.78,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.03,
      "end_seconds": 374.37,
      "duration_seconds": 3.34,
      "text": "Alright, um, thanks, take care."
    }
  ]
}