{
  "schema_version": "1.0",
  "encounter_id": "01435",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 5.09,
      "duration_seconds": 4.1,
      "text": "Right, thanks for waiting, come in. Was parking alright?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.69,
      "end_seconds": 13.73,
      "duration_seconds": 8.04,
      "text": "Sorry, what was I saying, not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.18,
      "end_seconds": 17.08,
      "duration_seconds": 1.9,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.75,
      "end_seconds": 24.65,
      "duration_seconds": 5.9,
      "text": "I wanted to get I can't get my breath looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.48,
      "end_seconds": 27.52,
      "duration_seconds": 2.04,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.14,
      "end_seconds": 35.18,
      "duration_seconds": 7.04,
      "text": "About... well, three days. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.93,
      "end_seconds": 45.98,
      "duration_seconds": 9.05,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.18,
      "end_seconds": 52.75,
      "duration_seconds": 5.57,
      "text": "Mm, it settles a little with sitting up. I'd call it severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.42,
      "end_seconds": 58.64,
      "duration_seconds": 4.22,
      "text": "Have you noticed blue tinge, fever or chest pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.38,
      "end_seconds": 68.1,
      "duration_seconds": 5.72,
      "text": "I haven't had blue tinge, fever or chest pain, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.88,
      "end_seconds": 72.71,
      "duration_seconds": 3.83,
      "text": "Right, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.25,
      "end_seconds": 75.26,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.02,
      "end_seconds": 79.13,
      "duration_seconds": 3.11,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.69,
      "end_seconds": 82.33,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.94,
      "end_seconds": 87.66,
      "duration_seconds": 3.72,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.77,
      "end_seconds": 92.25,
      "duration_seconds": 3.48,
      "text": "Diclofenac. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.29,
      "end_seconds": 100.42,
      "duration_seconds": 5.13,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.08,
      "end_seconds": 110.89,
      "duration_seconds": 8.81,
      "text": "Let me think, I have asthma, for two years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 122.29,
      "duration_seconds": 9.36,
      "text": "Sure. Right, yes, asthma is known to us, good to have that clear. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.14,
      "end_seconds": 127.44,
      "duration_seconds": 3.3,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.23,
      "end_seconds": 146.46,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.03,
      "end_seconds": 155.86,
      "duration_seconds": 7.83,
      "text": "I'm on Seretide inhaler, twice a day. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.99,
      "end_seconds": 176.17,
      "duration_seconds": 4.18,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.79,
      "end_seconds": 198.9,
      "duration_seconds": 21.11,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I'm vegetarian and have been for years. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.97,
      "end_seconds": 204.24,
      "duration_seconds": 4.27,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.77,
      "end_seconds": 215.19,
      "duration_seconds": 2.42,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.43,
      "end_seconds": 240.76,
      "duration_seconds": 12.33,
      "text": "Okay: SpO2 93 percent on room air, weight 63 kilos, height 170 centimetres, BP is 122 over 77, heart rate 102, respiratory rate 21, temperature is 37.6 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.32,
      "end_seconds": 258.17,
      "duration_seconds": 7.85,
      "text": "From what you've told me, I think we're dealing with a severe asthma attack at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.69,
      "end_seconds": 261.58,
      "duration_seconds": 2.89,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.3,
      "end_seconds": 277.57,
      "duration_seconds": 14.27,
      "text": "It's reasonable to be concerned, but right now a severe asthma attack is my leading thought, not anything worse. Let's book a chest X-ray to look into severe breathlessness."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.71,
      "end_seconds": 280.95,
      "duration_seconds": 2.24,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.26,
      "end_seconds": 298.39,
      "duration_seconds": 16.13,
      "text": "What I'm giving you is prednisolone, 40 milligrams, once now, single dose. It's for asthma attack. Sit upright and take slow breaths while the nebuliser is set up. I think the emergency team should see you too."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.03,
      "end_seconds": 300.73,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.5,
      "end_seconds": 307.18,
      "duration_seconds": 5.68,
      "text": "Please come and see me straight away. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.84,
      "end_seconds": 312.2,
      "duration_seconds": 3.36,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.26,
      "end_seconds": 314.59,
      "duration_seconds": 1.33,
      "text": "Take care now."
    }
  ]
}