{
  "schema_version": "1.0",
  "encounter_id": "01301",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 6.95,
      "duration_seconds": 6.34,
      "text": "all set here doctor chart's updated and I'll read the readings out when you're ready"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.83,
      "end_seconds": 13.57,
      "duration_seconds": 4.74,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.51,
      "end_seconds": 31.66,
      "duration_seconds": 12.15,
      "text": "Hello, doctor. I'm here with them in case I can help. It's headaches in the morning, doctor. She didn't wanna come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.68,
      "end_seconds": 36.77,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.14,
      "end_seconds": 44.94,
      "duration_seconds": 6.8,
      "text": "probably about a month yeah sorry I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.75,
      "end_seconds": 48.5,
      "duration_seconds": 2.75,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.35,
      "end_seconds": 51.32,
      "duration_seconds": 1.97,
      "text": "I, I'd say severe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.22,
      "end_seconds": 54.38,
      "duration_seconds": 2.16,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.56,
      "end_seconds": 62.77,
      "duration_seconds": 7.21,
      "text": "yeah. Three days I'd say. I've also had a pounding in my ears"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.0,
      "end_seconds": 69.96,
      "duration_seconds": 5.96,
      "text": "Have you had headaches in the morning before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.65,
      "end_seconds": 78.05,
      "duration_seconds": 6.4,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.46,
      "end_seconds": 84.05,
      "duration_seconds": 4.59,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.75,
      "end_seconds": 90.05,
      "duration_seconds": 5.3,
      "text": "my father has Parkinson's disease. My father had bowel cancer"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.34,
      "end_seconds": 94.79,
      "duration_seconds": 3.45,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.67,
      "end_seconds": 100.67,
      "duration_seconds": 4.0,
      "text": "right I'm allergic to amoxicillin I get hives"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.74,
      "end_seconds": 105.51,
      "duration_seconds": 3.77,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.01,
      "end_seconds": 118.76,
      "duration_seconds": 11.75,
      "text": "High blood pressure, for about ten years. My neighbour said I should get it looked at. Right, I have heart disease, for about ten years"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.42,
      "end_seconds": 124.3,
      "duration_seconds": 4.88,
      "text": "okay, I can see heart disease in your file as well"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.66,
      "end_seconds": 146.16,
      "duration_seconds": 4.5,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.26,
      "end_seconds": 154.42,
      "duration_seconds": 7.16,
      "text": "I take something called losa... losartan, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.24,
      "end_seconds": 159.77,
      "duration_seconds": 4.53,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.41,
      "end_seconds": 168.56,
      "duration_seconds": 7.15,
      "text": "No it's at home. Metoprolol. I take it 50 milligrams twice a day for my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 169.31,
      "end_seconds": 178.5,
      "duration_seconds": 9.19,
      "text": "Doctor, I think the last prescription for the metoprolol was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.48,
      "end_seconds": 182.98,
      "duration_seconds": 3.5,
      "text": "hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.61,
      "end_seconds": 189.77,
      "duration_seconds": 3.16,
      "text": "no I left it at home"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 195.87,
      "duration_seconds": 4.29,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.94,
      "end_seconds": 200.2,
      "duration_seconds": 3.26,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.92,
      "end_seconds": 203.08,
      "duration_seconds": 2.16,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.92,
      "end_seconds": 207.47,
      "duration_seconds": 3.55,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.24,
      "end_seconds": 212.48,
      "duration_seconds": 3.24,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.41,
      "end_seconds": 217.47,
      "duration_seconds": 3.06,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.61,
      "end_seconds": 231.83,
      "duration_seconds": 5.22,
      "text": "let me check a a few things any visual changes or chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.82,
      "end_seconds": 235.75,
      "duration_seconds": 1.93,
      "text": "nope nothing like that"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.63,
      "end_seconds": 243.37,
      "duration_seconds": 3.74,
      "text": "okay, have you noticed leg swelling or breathlessness?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.24,
      "end_seconds": 248.23,
      "duration_seconds": 3.99,
      "text": "No leg swelling or breathlessness, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 253.1,
      "duration_seconds": 3.08,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.88,
      "end_seconds": 256.47,
      "duration_seconds": 2.59,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 257.14,
      "end_seconds": 268.46,
      "duration_seconds": 11.32,
      "text": "okay, so the vitals from earlier. Heart rate 94, blood pressure 152 over 96, oxygen saturation is 98 percent, temperature is 36.9 degrees"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.54,
      "end_seconds": 270.44,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.08,
      "end_seconds": 277.45,
      "duration_seconds": 4.37,
      "text": "Okay, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.11,
      "end_seconds": 280.43,
      "duration_seconds": 1.32,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.25,
      "end_seconds": 297.12,
      "duration_seconds": 5.87,
      "text": "your heart sounds are normal and there is no swelling in your ankles"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.81,
      "end_seconds": 305.88,
      "duration_seconds": 3.07,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.03,
      "end_seconds": 343.87,
      "duration_seconds": 25.84,
      "text": "Having listened and examined this is probably blood pressure above target on current treatment. I want to be honest that this is an impression not a final answer. I can't rule out poor adherence yet. Let's book a 24-hour blood pressure monitor to look into hypertension. It's a routine test and it'll give us a much clearer picture. Let's book an ECG to look into hypertension."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.69,
      "end_seconds": 363.66,
      "duration_seconds": 18.97,
      "text": "let's book kidney function blood tests to look into hypertension. The result will help us decide whether anything more is needed. What I'm giving you is amlodipine, 5 milligrams, once a day, long term. You take it by mouth. That should help with blood pressure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.81,
      "end_seconds": 365.81,
      "duration_seconds": 1.0,
      "text": "mm alright"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.22,
      "end_seconds": 393.71,
      "duration_seconds": 26.49,
      "text": "cut down on salty foods and keep a home blood pressure diary. A short walk every day, even twenty minutes, will help more than you'd think. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.94,
      "end_seconds": 396.49,
      "duration_seconds": 1.55,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.11,
      "end_seconds": 399.77,
      "duration_seconds": 2.66,
      "text": "See me again after the monitor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.61,
      "end_seconds": 402.41,
      "duration_seconds": 1.8,
      "text": "good I'll return then"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.81,
      "end_seconds": 411.18,
      "duration_seconds": 2.37,
      "text": "that's all from me any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 413.27,
      "end_seconds": 416.65,
      "duration_seconds": 3.38,
      "text": "great, thank you for your help"
    }
  ]
}