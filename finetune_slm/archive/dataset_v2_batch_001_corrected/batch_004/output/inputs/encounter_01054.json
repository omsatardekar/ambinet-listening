{
  "schema_version": "1.0",
  "encounter_id": "01054",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 3.88,
      "duration_seconds": 3.1,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 12.61,
      "duration_seconds": 4.07,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.37,
      "end_seconds": 18.55,
      "duration_seconds": 5.18,
      "text": "I mean, uh, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.56,
      "end_seconds": 23.65,
      "duration_seconds": 4.09,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.92,
      "end_seconds": 32.46,
      "duration_seconds": 7.54,
      "text": "It's been feeling well, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.59,
      "end_seconds": 36.05,
      "duration_seconds": 2.46,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.0,
      "end_seconds": 45.08,
      "duration_seconds": 8.08,
      "text": "Mild, really. And, And there's slightly dry skin as well, two days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.99,
      "end_seconds": 50.6,
      "duration_seconds": 4.61,
      "text": "Have you been feeling well at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.87,
      "end_seconds": 63.93,
      "duration_seconds": 12.06,
      "text": "Yes, you know, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.19,
      "end_seconds": 67.76,
      "duration_seconds": 2.57,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.57,
      "end_seconds": 71.37,
      "duration_seconds": 1.8,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.61,
      "end_seconds": 75.93,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.59,
      "end_seconds": 82.08,
      "duration_seconds": 4.49,
      "text": "Right, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 82.9,
      "end_seconds": 89.87,
      "duration_seconds": 6.97,
      "text": "Hold on, doctor, I think he reacted to erythromycin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.67,
      "end_seconds": 94.75,
      "duration_seconds": 3.08,
      "text": "I, I don't remember that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.05,
      "end_seconds": 102.13,
      "duration_seconds": 6.08,
      "text": "Alright, so that's unclear. I'll record what each of you said. Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.69,
      "end_seconds": 106.68,
      "duration_seconds": 2.99,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.51,
      "end_seconds": 109.45,
      "duration_seconds": 1.94,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.04,
      "end_seconds": 112.85,
      "duration_seconds": 2.81,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.31,
      "end_seconds": 118.82,
      "duration_seconds": 4.51,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.29,
      "end_seconds": 126.2,
      "duration_seconds": 3.91,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.26,
      "end_seconds": 139.21,
      "duration_seconds": 2.95,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.84,
      "end_seconds": 149.53,
      "duration_seconds": 5.69,
      "text": "My aunt has rheumatoid arthritis. Ah, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.21,
      "end_seconds": 158.23,
      "duration_seconds": 6.02,
      "text": "Tell me your medicines, please. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.56,
      "end_seconds": 164.38,
      "duration_seconds": 4.82,
      "text": "I'm, I'm on Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.42,
      "end_seconds": 169.24,
      "duration_seconds": 2.82,
      "text": "Right, when did you start it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.23,
      "end_seconds": 183.75,
      "duration_seconds": 12.52,
      "text": "About a year now. I'm on hydrocortisone cream, when needed. Mm, before this I was on escitalopram; that's been stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.88,
      "end_seconds": 188.03,
      "duration_seconds": 3.15,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.08,
      "end_seconds": 199.29,
      "duration_seconds": 9.21,
      "text": "Well, you know, I've had an underactive thyroid, yes. I've had eczema for nearly five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.34,
      "end_seconds": 201.73,
      "duration_seconds": 1.39,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.41,
      "end_seconds": 205.62,
      "duration_seconds": 2.21,
      "text": "Anxiety, for two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.82,
      "end_seconds": 217.14,
      "duration_seconds": 10.32,
      "text": "Right, right. Yes, an underactive thyroid and anxiety are known to us, good to have that clear. Have you noticed constipation or palpitations?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.04,
      "end_seconds": 220.3,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.17,
      "end_seconds": 224.85,
      "duration_seconds": 3.68,
      "text": "Any weight change or feeling cold at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.67,
      "end_seconds": 230.36,
      "duration_seconds": 3.69,
      "text": "No, no weight change or feeling cold."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 235.15,
      "duration_seconds": 3.69,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.17,
      "end_seconds": 243.05,
      "duration_seconds": 6.88,
      "text": "Sorry, uh, what was I saying, no, nothing like that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 244.3,
      "end_seconds": 250.84,
      "duration_seconds": 6.54,
      "text": "Here are the numbers, doctor. Pulse 67, temperature 37.0, blood pressure 110 over 78."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 252.65,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.62,
      "end_seconds": 258.65,
      "duration_seconds": 3.03,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.65,
      "end_seconds": 263.68,
      "duration_seconds": 3.03,
      "text": "Right, take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.46,
      "end_seconds": 277.79,
      "duration_seconds": 5.33,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.83,
      "end_seconds": 283.61,
      "duration_seconds": 1.78,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.61,
      "end_seconds": 300.09,
      "duration_seconds": 4.48,
      "text": "Taking everything into account, this looks most like well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.79,
      "end_seconds": 306.35,
      "duration_seconds": 4.56,
      "text": "I mean, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.13,
      "end_seconds": 341.19,
      "duration_seconds": 34.06,
      "text": "Nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement, but I'd like to confirm. I'm sending you for a thyroid blood test because of annual review. It's a routine test and it'll give us a much clearer picture. Keep taking the tablet on an empty stomach, apart from coffee. Please don't wait if you notice palpitations or weight change. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.81,
      "end_seconds": 346.54,
      "duration_seconds": 4.73,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.95,
      "end_seconds": 351.26,
      "duration_seconds": 3.31,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}