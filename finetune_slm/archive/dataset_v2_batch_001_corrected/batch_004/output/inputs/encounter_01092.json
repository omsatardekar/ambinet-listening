{
  "schema_version": "1.0",
  "encounter_id": "01092",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.73,
      "duration_seconds": 4.38,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.28,
      "end_seconds": 12.31,
      "duration_seconds": 5.03,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.48,
      "end_seconds": 20.27,
      "duration_seconds": 6.79,
      "text": "Yeah, it's headaches in the morning. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.81,
      "end_seconds": 23.41,
      "duration_seconds": 1.6,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.79,
      "end_seconds": 28.13,
      "duration_seconds": 3.34,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.15,
      "end_seconds": 32.48,
      "duration_seconds": 3.33,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.68,
      "end_seconds": 35.1,
      "duration_seconds": 1.42,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.48,
      "end_seconds": 38.89,
      "duration_seconds": 2.41,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.8,
      "end_seconds": 45.97,
      "duration_seconds": 6.17,
      "text": "A pounding in my ears goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.72,
      "end_seconds": 49.16,
      "duration_seconds": 2.44,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.94,
      "end_seconds": 57.82,
      "duration_seconds": 7.88,
      "text": "Yes, for six months. Um, the pounding in my ears? That's been for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.62,
      "end_seconds": 62.52,
      "duration_seconds": 3.9,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.49,
      "end_seconds": 72.21,
      "duration_seconds": 7.72,
      "text": "I have high blood pressure, for two years. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.59,
      "end_seconds": 80.28,
      "duration_seconds": 6.69,
      "text": "Yes. Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.81,
      "end_seconds": 99.07,
      "duration_seconds": 3.26,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.0,
      "end_seconds": 111.44,
      "duration_seconds": 10.44,
      "text": "I walk the dog every morning. No, I share a house with my brother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.91,
      "end_seconds": 117.75,
      "duration_seconds": 4.84,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.76,
      "end_seconds": 121.18,
      "duration_seconds": 2.42,
      "text": "I take hydrochlorothiazide, every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.36,
      "end_seconds": 124.38,
      "duration_seconds": 2.02,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.23,
      "end_seconds": 131.6,
      "duration_seconds": 5.37,
      "text": "12.5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.94,
      "end_seconds": 137.1,
      "duration_seconds": 4.16,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.4,
      "end_seconds": 145.14,
      "duration_seconds": 3.74,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.24,
      "end_seconds": 163.96,
      "duration_seconds": 2.72,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.6,
      "end_seconds": 170.2,
      "duration_seconds": 5.6,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.31,
      "end_seconds": 174.53,
      "duration_seconds": 3.22,
      "text": "Have you had any leg swelling or breathlessness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.06,
      "end_seconds": 177.97,
      "duration_seconds": 1.91,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.88,
      "end_seconds": 184.78,
      "duration_seconds": 5.9,
      "text": "Let me check a few things. Any visual changes or chest pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.83,
      "end_seconds": 189.46,
      "duration_seconds": 3.63,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.75,
      "end_seconds": 193.86,
      "duration_seconds": 4.11,
      "text": "Yes. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.16,
      "end_seconds": 197.86,
      "duration_seconds": 2.7,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.58,
      "end_seconds": 200.69,
      "duration_seconds": 2.11,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.62,
      "end_seconds": 205.37,
      "duration_seconds": 2.75,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.24,
      "end_seconds": 208.82,
      "duration_seconds": 2.58,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.69,
      "end_seconds": 220.07,
      "duration_seconds": 2.38,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.81,
      "end_seconds": 239.64,
      "duration_seconds": 7.83,
      "text": "Okay: BP is 164 over 92, oxygen saturation is 98 percent, pulse 89, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.02,
      "end_seconds": 245.24,
      "duration_seconds": 4.22,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.34,
      "end_seconds": 248.47,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.82,
      "end_seconds": 273.0,
      "duration_seconds": 6.18,
      "text": "Your heart sounds are normal and there is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 276.68,
      "duration_seconds": 1.65,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.57,
      "end_seconds": 324.15,
      "duration_seconds": 29.58,
      "text": "Having listened and examined, it's hard to say. Blood pressure above target on current treatment is one possibility and salt intake another, and I'd rather not commit yet. I'd like to arrange a 24-hour blood pressure monitor for hypertension. I'd like you to take amlodipine, 5 milligrams, once a day, long term. You take it by mouth. It's for blood pressure. Cut down on salty foods and keep a home blood pressure diary."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.51,
      "end_seconds": 332.45,
      "duration_seconds": 6.94,
      "text": "I'd like you back after the monitor. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.1,
      "end_seconds": 335.48,
      "duration_seconds": 2.38,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.27,
      "end_seconds": 338.95,
      "duration_seconds": 1.68,
      "text": "Have a good day."
    }
  ]
}