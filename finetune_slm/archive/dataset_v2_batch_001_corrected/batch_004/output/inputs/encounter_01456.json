{
  "schema_version": "1.0",
  "encounter_id": "01456",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.75,
      "duration_seconds": 4.4,
      "text": "Actually, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.53,
      "end_seconds": 11.05,
      "duration_seconds": 3.52,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.08,
      "end_seconds": 18.9,
      "duration_seconds": 6.82,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.89,
      "end_seconds": 24.02,
      "duration_seconds": 3.13,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.47,
      "end_seconds": 33.06,
      "duration_seconds": 7.59,
      "text": "We came because of the room spinning when I turn over in bed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 37.76,
      "duration_seconds": 3.11,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.46,
      "end_seconds": 42.97,
      "duration_seconds": 2.51,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.6,
      "end_seconds": 49.41,
      "duration_seconds": 4.81,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.03,
      "end_seconds": 90.77,
      "duration_seconds": 40.74,
      "text": "It just comes and goes. It's worse with looking up. I'd call it mild. Okay, you know, so as for feeling sick, I honestly can't say when that began. It might have been last month or the month before. I mean, as for feeling sick, moderate, I'd say. I'd say a couple of times a week. Oh, and being unsteady for a few minutes. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.26,
      "end_seconds": 99.1,
      "duration_seconds": 6.84,
      "text": "About being unsteady for a few minutes, I'd call it severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.96,
      "end_seconds": 110.03,
      "duration_seconds": 5.07,
      "text": "Have you noticed ringing in the ear, hearing loss or double vision?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.75,
      "end_seconds": 118.0,
      "duration_seconds": 6.25,
      "text": "Well, no, no ringing in the ear, hearing loss or double vision."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.56,
      "end_seconds": 121.78,
      "duration_seconds": 3.22,
      "text": "Have you had weakness, by any chance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.41,
      "end_seconds": 125.62,
      "duration_seconds": 3.21,
      "text": "No, I haven't had any weakness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.11,
      "end_seconds": 129.27,
      "duration_seconds": 2.16,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.18,
      "end_seconds": 132.82,
      "duration_seconds": 2.64,
      "text": "Nothing there, um, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.21,
      "end_seconds": 138.24,
      "duration_seconds": 4.03,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.05,
      "end_seconds": 141.53,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.7,
      "end_seconds": 146.5,
      "duration_seconds": 3.8,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.63,
      "end_seconds": 150.16,
      "duration_seconds": 2.53,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.74,
      "end_seconds": 152.84,
      "duration_seconds": 2.1,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.17,
      "end_seconds": 159.14,
      "duration_seconds": 4.97,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.91,
      "end_seconds": 160.77,
      "duration_seconds": 0.86,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 165.77,
      "duration_seconds": 4.22,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.27,
      "end_seconds": 174.27,
      "duration_seconds": 4.0,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.39,
      "end_seconds": 179.44,
      "duration_seconds": 4.05,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.47,
      "end_seconds": 187.91,
      "duration_seconds": 3.44,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.5,
      "end_seconds": 192.44,
      "duration_seconds": 2.94,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.24,
      "end_seconds": 208.18,
      "duration_seconds": 2.94,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.26,
      "end_seconds": 212.36,
      "duration_seconds": 3.1,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.08,
      "end_seconds": 214.05,
      "duration_seconds": 0.97,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.11,
      "end_seconds": 229.73,
      "duration_seconds": 14.62,
      "text": "I have an underactive thyroid, for two years. I've got high blood pressure. I took the morning off to come in today. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.81,
      "end_seconds": 239.3,
      "duration_seconds": 7.49,
      "text": "Okay, I can see an underactive thyroid in your file as well. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.36,
      "end_seconds": 243.83,
      "duration_seconds": 3.47,
      "text": "Oh, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.24,
      "end_seconds": 248.99,
      "duration_seconds": 3.75,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.07,
      "end_seconds": 252.6,
      "duration_seconds": 2.53,
      "text": "Alendronate, once a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.31,
      "end_seconds": 256.47,
      "duration_seconds": 2.16,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.05,
      "end_seconds": 262.24,
      "duration_seconds": 5.19,
      "text": "It's 70 milligrams. I take Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 262.94,
      "end_seconds": 270.24,
      "duration_seconds": 7.3,
      "text": "It's meant to be every morning, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.97,
      "end_seconds": 284.06,
      "duration_seconds": 2.09,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.46,
      "end_seconds": 294.23,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.13,
      "end_seconds": 320.57,
      "duration_seconds": 8.44,
      "text": "Okay: height 181 centimetres, pulse 66, BP is 112 over 76, temperature is 36.4 degrees, weight 60 kilos."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.87,
      "end_seconds": 323.92,
      "duration_seconds": 2.05,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.3,
      "end_seconds": 326.51,
      "duration_seconds": 1.21,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.03,
      "end_seconds": 331.05,
      "duration_seconds": 3.02,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.24,
      "end_seconds": 349.22,
      "duration_seconds": 6.98,
      "text": "When I tip you back, the eyes flick for about twenty seconds, and the hearing is normal."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.05,
      "end_seconds": 356.69,
      "duration_seconds": 1.64,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.64,
      "end_seconds": 397.28,
      "duration_seconds": 27.64,
      "text": "From what you've told me and what I found, this looks most like benign positional vertigo. That's my thinking for now, and it may change as we learn more. I'd also keep a vestibular neuritis in mind. Stop me if I've got anything wrong. You've had the room spinning when you turn over in bed for ten days, mild, and no ringing in the ear or double vision."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.63,
      "end_seconds": 399.33,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.69,
      "end_seconds": 417.15,
      "duration_seconds": 16.46,
      "text": "I'll do a repositioning manoeuvre now and show you exercises for home. Come back or go to emergency straight away if the symptoms get worse. Let's review you in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.45,
      "end_seconds": 422.22,
      "duration_seconds": 3.77,
      "text": "Oh, good, thanks, I'll see you then."
    }
  ]
}