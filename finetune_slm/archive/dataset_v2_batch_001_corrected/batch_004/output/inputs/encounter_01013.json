{
  "schema_version": "1.0",
  "encounter_id": "01013",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.08,
      "end_seconds": 5.44,
      "duration_seconds": 4.36,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 11.07,
      "duration_seconds": 5.0,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.74,
      "end_seconds": 27.09,
      "duration_seconds": 14.35,
      "text": "Erm, so the thing is, I've got hot flushes. I didn't want to make a fuss, you know. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.01,
      "end_seconds": 32.3,
      "duration_seconds": 3.29,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.89,
      "end_seconds": 38.59,
      "duration_seconds": 5.7,
      "text": "Iron tablets, once a day. It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.54,
      "end_seconds": 43.41,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.03,
      "end_seconds": 46.79,
      "duration_seconds": 1.76,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.3,
      "end_seconds": 55.46,
      "duration_seconds": 8.16,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.19,
      "end_seconds": 69.75,
      "duration_seconds": 13.56,
      "text": "Let me think, only a fan, and it's not much. A seven out of ten, I suppose. It's worse with spicy food. It's all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.62,
      "end_seconds": 73.44,
      "duration_seconds": 2.82,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.71,
      "end_seconds": 97.09,
      "duration_seconds": 22.38,
      "text": "Night sweats goes along with it, most of the time. Erm, um, and vaginal dryness as well, since last weekend. As for night sweats, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.33,
      "end_seconds": 111.23,
      "duration_seconds": 7.9,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.05,
      "end_seconds": 126.0,
      "duration_seconds": 13.95,
      "text": "I'd give it a six, out of ten. I'd say once or twice a day. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.44,
      "end_seconds": 132.82,
      "duration_seconds": 5.38,
      "text": "Have you had hot flushes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.26,
      "end_seconds": 142.0,
      "duration_seconds": 7.74,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.32,
      "end_seconds": 148.25,
      "duration_seconds": 4.93,
      "text": "And what about chest pain, weight loss or heavy bleeding?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.89,
      "end_seconds": 152.58,
      "duration_seconds": 2.69,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.58,
      "end_seconds": 159.95,
      "duration_seconds": 5.37,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.74,
      "end_seconds": 163.46,
      "duration_seconds": 1.72,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 167.02,
      "duration_seconds": 1.99,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.87,
      "end_seconds": 170.91,
      "duration_seconds": 3.04,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.18,
      "end_seconds": 174.1,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.93,
      "end_seconds": 180.35,
      "duration_seconds": 4.42,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.48,
      "end_seconds": 183.25,
      "duration_seconds": 1.77,
      "text": "So, what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.62,
      "end_seconds": 188.7,
      "duration_seconds": 4.08,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.57,
      "end_seconds": 207.12,
      "duration_seconds": 3.55,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.62,
      "end_seconds": 210.85,
      "duration_seconds": 2.23,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.39,
      "end_seconds": 215.1,
      "duration_seconds": 2.71,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.83,
      "end_seconds": 219.51,
      "duration_seconds": 2.68,
      "text": "Yes, low haemoglobin. Yes, COPD."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 229.97,
      "duration_seconds": 9.49,
      "text": "Yes, COPD is known to us, good to have that clear. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.32,
      "end_seconds": 234.94,
      "duration_seconds": 3.62,
      "text": "I'm allergic to trimethoprim, I get itching."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 237.66,
      "duration_seconds": 1.78,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.58,
      "end_seconds": 244.03,
      "duration_seconds": 4.45,
      "text": "Ah, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 244.79,
      "end_seconds": 251.68,
      "duration_seconds": 6.89,
      "text": "Here are the numbers, doctor. Heart rate 84, SpO2 98 percent on room air, pressure 122 over 71."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.03,
      "end_seconds": 254.04,
      "duration_seconds": 1.01,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.4,
      "end_seconds": 260.31,
      "duration_seconds": 3.91,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.4,
      "end_seconds": 279.1,
      "duration_seconds": 1.7,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.8,
      "end_seconds": 282.1,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.85,
      "end_seconds": 292.88,
      "duration_seconds": 2.03,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.53,
      "end_seconds": 298.23,
      "duration_seconds": 2.7,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.2,
      "end_seconds": 319.28,
      "duration_seconds": 4.08,
      "text": "Taking everything into account, this looks most like menopausal symptoms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.89,
      "end_seconds": 323.72,
      "duration_seconds": 3.83,
      "text": "Is it dangerous, you know, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.07,
      "end_seconds": 336.22,
      "duration_seconds": 11.15,
      "text": "Nothing I've seen today points to an emergency. It looks like menopausal symptoms. Dress in layers and keep the bedroom cool. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.42,
      "end_seconds": 341.23,
      "duration_seconds": 3.81,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}