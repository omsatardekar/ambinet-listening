{
  "schema_version": "1.0",
  "encounter_id": "01370",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.47,
      "duration_seconds": 4.32,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.19,
      "duration_seconds": 4.49,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.81,
      "end_seconds": 17.33,
      "duration_seconds": 5.52,
      "text": "Ah, I've been dealing with burning when I pass urine."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.38,
      "end_seconds": 20.47,
      "duration_seconds": 2.09,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.24,
      "end_seconds": 33.66,
      "duration_seconds": 2.42,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.62,
      "end_seconds": 63.67,
      "duration_seconds": 10.05,
      "text": "Okay: heart rate 67, temperature 36.8, oxygen saturation is 98 percent, blood pressure 109 over 75, respiratory rate 16."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.11,
      "end_seconds": 65.58,
      "duration_seconds": 1.47,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.34,
      "end_seconds": 80.94,
      "duration_seconds": 1.6,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.04,
      "end_seconds": 90.36,
      "duration_seconds": 8.32,
      "text": "It settles a little with drinking water. There's a dull ache low in my tummy as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.28,
      "end_seconds": 94.25,
      "duration_seconds": 2.97,
      "text": "Did you get fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.76,
      "end_seconds": 98.63,
      "duration_seconds": 2.87,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.2,
      "end_seconds": 104.36,
      "duration_seconds": 4.16,
      "text": "Alright, any blood in the urine or back pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.04,
      "end_seconds": 108.89,
      "duration_seconds": 2.85,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.52,
      "end_seconds": 112.03,
      "duration_seconds": 2.51,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.58,
      "end_seconds": 114.11,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.69,
      "end_seconds": 118.38,
      "duration_seconds": 2.69,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.69,
      "end_seconds": 123.2,
      "duration_seconds": 3.51,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.63,
      "end_seconds": 127.85,
      "duration_seconds": 3.22,
      "text": "So, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.32,
      "end_seconds": 131.33,
      "duration_seconds": 2.01,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.26,
      "end_seconds": 135.63,
      "duration_seconds": 3.37,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.71,
      "end_seconds": 139.6,
      "duration_seconds": 2.89,
      "text": "Mm, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.13,
      "end_seconds": 143.41,
      "duration_seconds": 2.28,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.13,
      "end_seconds": 152.02,
      "duration_seconds": 7.89,
      "text": "I've got migraines. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.07,
      "end_seconds": 158.24,
      "duration_seconds": 4.17,
      "text": "Alright, migraines, that matches what I have here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.68,
      "end_seconds": 166.58,
      "duration_seconds": 0.9,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.11,
      "end_seconds": 169.88,
      "duration_seconds": 2.77,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.43,
      "end_seconds": 171.85,
      "duration_seconds": 1.42,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.4,
      "end_seconds": 176.68,
      "duration_seconds": 3.28,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.79,
      "end_seconds": 181.72,
      "duration_seconds": 3.93,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.72,
      "end_seconds": 190.73,
      "duration_seconds": 4.01,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.93,
      "end_seconds": 194.14,
      "duration_seconds": 2.21,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.7,
      "end_seconds": 198.39,
      "duration_seconds": 3.69,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.97,
      "end_seconds": 202.1,
      "duration_seconds": 3.13,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.73,
      "end_seconds": 207.42,
      "duration_seconds": 3.69,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.33,
      "end_seconds": 212.83,
      "duration_seconds": 2.5,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.14,
      "end_seconds": 216.21,
      "duration_seconds": 2.07,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.46,
      "end_seconds": 234.63,
      "duration_seconds": 5.17,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.51,
      "end_seconds": 246.06,
      "duration_seconds": 1.55,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.06,
      "end_seconds": 264.11,
      "duration_seconds": 14.05,
      "text": "Right, thank you, you can get dressed. Having listened and examined, this looks most like an uncomplicated urinary infection. It could also be vaginal irritation, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.05,
      "end_seconds": 268.95,
      "duration_seconds": 2.9,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.65,
      "end_seconds": 294.4,
      "duration_seconds": 24.75,
      "text": "I understand the worry. At the moment I'd say it's an uncomplicated urinary infection, and we'll know more once the a urine dipstick is back. Let's book a urine dipstick to look into burning urine. I'm going to put you on nitrofurantoin, 100 milligrams, twice a day, three days. That should help with urinary infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.33,
      "end_seconds": 296.88,
      "duration_seconds": 1.55,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.84,
      "end_seconds": 311.22,
      "duration_seconds": 12.38,
      "text": "Drink plenty of water and avoid holding urine. If you get a fever or back pain, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.83,
      "end_seconds": 315.0,
      "duration_seconds": 3.17,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.25,
      "end_seconds": 324.97,
      "duration_seconds": 8.72,
      "text": "I'd like you back if it is not better in three days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.08,
      "end_seconds": 328.9,
      "duration_seconds": 2.82,
      "text": "I think I understand everything. Thanks."
    }
  ]
}