{
  "schema_version": "1.0",
  "encounter_id": "01190",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 3.61,
      "duration_seconds": 2.36,
      "text": "good morning, grab a seat"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.35,
      "end_seconds": 10.41,
      "duration_seconds": 5.06,
      "text": "morning, doctor. I'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.33,
      "end_seconds": 16.3,
      "duration_seconds": 1.97,
      "text": "have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.07,
      "end_seconds": 23.23,
      "duration_seconds": 3.16,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.7,
      "end_seconds": 26.34,
      "duration_seconds": 1.64,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.01,
      "end_seconds": 39.8,
      "duration_seconds": 12.79,
      "text": "I wanted to get a hot swollen painful knee looked at. I've never really been one for hospitals. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.46,
      "end_seconds": 41.91,
      "duration_seconds": 1.45,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.51,
      "end_seconds": 55.11,
      "duration_seconds": 11.6,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.76,
      "end_seconds": 64.19,
      "duration_seconds": 8.43,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.83,
      "end_seconds": 70.27,
      "duration_seconds": 4.44,
      "text": "I'd call it severe. It's on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.28,
      "end_seconds": 75.14,
      "duration_seconds": 2.86,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.07,
      "end_seconds": 98.11,
      "duration_seconds": 21.04,
      "text": "When it starts I tend to get not being able to walk on it as well. Oh, and fever and chills. About fever and chills, I'd call it mild. The not being able to walk on it? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.03,
      "end_seconds": 106.62,
      "duration_seconds": 6.59,
      "text": "have you had a hot swollen painful knee before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.88,
      "end_seconds": 113.6,
      "duration_seconds": 5.72,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.16,
      "end_seconds": 119.73,
      "duration_seconds": 2.57,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.31,
      "end_seconds": 123.03,
      "duration_seconds": 1.72,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.08,
      "end_seconds": 128.01,
      "duration_seconds": 3.93,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.25,
      "end_seconds": 134.81,
      "duration_seconds": 5.56,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.78,
      "end_seconds": 139.09,
      "duration_seconds": 3.31,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.05,
      "end_seconds": 144.03,
      "duration_seconds": 3.98,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.92,
      "end_seconds": 148.54,
      "duration_seconds": 2.62,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.63,
      "end_seconds": 154.18,
      "duration_seconds": 3.55,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.06,
      "end_seconds": 157.36,
      "duration_seconds": 2.3,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.9,
      "end_seconds": 162.69,
      "duration_seconds": 3.79,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.43,
      "end_seconds": 167.71,
      "duration_seconds": 3.28,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.4,
      "end_seconds": 180.6,
      "duration_seconds": 10.2,
      "text": "I take omeprazole, 20 milligrams, once a day. Let me think, uh, I'm on propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 181.94,
      "end_seconds": 189.44,
      "duration_seconds": 7.5,
      "text": "Oh, it's meant to be twice a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.97,
      "end_seconds": 193.3,
      "duration_seconds": 2.33,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.11,
      "end_seconds": 200.28,
      "duration_seconds": 6.17,
      "text": "I've had acid reflux, yes. I have migraines, for about ten years"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.07,
      "end_seconds": 206.37,
      "duration_seconds": 5.3,
      "text": "sure. Yes, acid reflux is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.38,
      "end_seconds": 221.18,
      "duration_seconds": 3.8,
      "text": "Have you had recent injury, by any chance?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.12,
      "end_seconds": 228.06,
      "duration_seconds": 1.94,
      "text": "No recent injury, thankfully."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.94,
      "end_seconds": 233.63,
      "duration_seconds": 3.69,
      "text": "a few quick ones: other joint pain or rash?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.95,
      "end_seconds": 240.77,
      "duration_seconds": 2.82,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.63,
      "end_seconds": 245.6,
      "duration_seconds": 3.97,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 246.16,
      "end_seconds": 250.42,
      "duration_seconds": 4.26,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.49,
      "end_seconds": 254.38,
      "duration_seconds": 2.89,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.88,
      "end_seconds": 263.93,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.62,
      "end_seconds": 283.12,
      "duration_seconds": 7.5,
      "text": "Okay: pulse is 106 beats a minute, pressure 124 over 74, temp 38.5 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.07,
      "end_seconds": 288.45,
      "duration_seconds": 2.38,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.37,
      "end_seconds": 290.56,
      "duration_seconds": 1.19,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.94,
      "end_seconds": 310.21,
      "duration_seconds": 6.27,
      "text": "The knee is hot, swollen and extremely painful when I move it even slightly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.48,
      "end_seconds": 317.8,
      "duration_seconds": 2.32,
      "text": "right, you can relax now"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.35,
      "end_seconds": 346.54,
      "duration_seconds": 15.19,
      "text": "Taking everything into account, it points towards possible septic arthritis. We shouldn't forget a gout attack. Stop me if I've got anything wrong. You've had a hot swollen painful knee, severe, and no rash or recent injury."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.19,
      "end_seconds": 349.74,
      "duration_seconds": 1.55,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.86,
      "end_seconds": 372.52,
      "duration_seconds": 9.66,
      "text": "I'd like to arrange urgent blood tests for septic arthritis. I'm sending you for a joint aspiration because of hot swollen knee."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 373.3,
      "end_seconds": 375.93,
      "duration_seconds": 2.63,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.84,
      "end_seconds": 388.21,
      "duration_seconds": 10.37,
      "text": "you need to go to hospital now for a joint washout assessment. The orthopaedic team would be the right next step, I'll refer you"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 389.56,
      "end_seconds": 390.26,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.65,
      "end_seconds": 397.33,
      "duration_seconds": 5.68,
      "text": "I'd like you back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 399.3,
      "end_seconds": 403.21,
      "duration_seconds": 3.91,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.04,
      "end_seconds": 406.34,
      "duration_seconds": 1.3,
      "text": "see you soon"
    }
  ]
}