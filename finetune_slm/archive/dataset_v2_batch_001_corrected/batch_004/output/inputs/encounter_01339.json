{
  "schema_version": "1.0",
  "encounter_id": "01339",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 5.19,
      "duration_seconds": 4.57,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.05,
      "end_seconds": 10.04,
      "duration_seconds": 3.99,
      "text": "that's fine, sit down. Tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.98,
      "end_seconds": 14.16,
      "duration_seconds": 3.18,
      "text": "I'm here because of a lingering cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.24,
      "end_seconds": 17.26,
      "duration_seconds": 2.02,
      "text": "Right, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.9,
      "end_seconds": 20.44,
      "duration_seconds": 1.54,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.19,
      "end_seconds": 29.94,
      "duration_seconds": 7.75,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.52,
      "end_seconds": 41.68,
      "duration_seconds": 9.16,
      "text": "It settles a little with honey. Pretty mild, if I'm being honest. There's a tickle in my throat as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.75,
      "end_seconds": 45.18,
      "duration_seconds": 2.43,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.47,
      "end_seconds": 57.46,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.83,
      "end_seconds": 75.98,
      "duration_seconds": 9.15,
      "text": "okay: pressure 114 over 76, heart rate 81, oxygen saturation is 97 percent. And temperature 36.5, respiratory rate 18."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.33,
      "end_seconds": 82.07,
      "duration_seconds": 3.74,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.84,
      "end_seconds": 85.18,
      "duration_seconds": 1.34,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.08,
      "end_seconds": 100.88,
      "duration_seconds": 3.8,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.9,
      "end_seconds": 104.48,
      "duration_seconds": 1.58,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.04,
      "end_seconds": 124.9,
      "duration_seconds": 3.86,
      "text": "Have you had coughing up blood, by any chance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.71,
      "end_seconds": 128.97,
      "duration_seconds": 2.26,
      "text": "Definitely no coughing up blood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.82,
      "end_seconds": 134.77,
      "duration_seconds": 3.95,
      "text": "A few quick ones: fever or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.38,
      "end_seconds": 139.42,
      "duration_seconds": 4.04,
      "text": "Erm, no, no fever or weight loss."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.15,
      "end_seconds": 143.23,
      "duration_seconds": 2.08,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.08,
      "end_seconds": 147.0,
      "duration_seconds": 1.92,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.37,
      "end_seconds": 157.5,
      "duration_seconds": 4.13,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.42,
      "end_seconds": 162.09,
      "duration_seconds": 3.67,
      "text": "No, uh, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.42,
      "end_seconds": 165.5,
      "duration_seconds": 2.08,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.71,
      "end_seconds": 170.31,
      "duration_seconds": 1.6,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.8,
      "end_seconds": 178.89,
      "duration_seconds": 4.09,
      "text": "I see, go ahead have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.26,
      "end_seconds": 183.03,
      "duration_seconds": 2.77,
      "text": "yes, diclofenac i get wheezing"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.19,
      "end_seconds": 202.19,
      "duration_seconds": 4.0,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.38,
      "end_seconds": 207.08,
      "duration_seconds": 3.7,
      "text": "Um, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.62,
      "end_seconds": 216.43,
      "duration_seconds": 5.81,
      "text": "tell me about your routine, work, habits, that that sort of thing"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.15,
      "end_seconds": 231.52,
      "duration_seconds": 13.37,
      "text": "I'm a bus driver, so I sit for long hours. I live with my elderly mother. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.06,
      "end_seconds": 249.76,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.67,
      "end_seconds": 251.72,
      "duration_seconds": 1.05,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.93,
      "end_seconds": 261.46,
      "duration_seconds": 2.53,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.64,
      "end_seconds": 266.58,
      "duration_seconds": 3.94,
      "text": "Honey and lemon i take it at night"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.96,
      "end_seconds": 273.96,
      "duration_seconds": 6.0,
      "text": "Taking everything into account, this looks most like a post-viral cough that is settling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.61,
      "end_seconds": 277.49,
      "duration_seconds": 1.88,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.32,
      "end_seconds": 302.77,
      "duration_seconds": 21.45,
      "text": "nothing I've seen today points to an emergency it looks like a post-viral cough that is settling it should settle over the next two to three weeks; steam and honey can help come back if it lasts beyond eight weeks i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.7,
      "end_seconds": 307.69,
      "duration_seconds": 2.99,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.6,
      "end_seconds": 311.25,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
