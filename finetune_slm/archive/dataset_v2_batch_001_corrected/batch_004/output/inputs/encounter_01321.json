{
  "schema_version": "1.0",
  "encounter_id": "01321",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 6.4,
      "duration_seconds": 5.63,
      "text": "Doctor? Hello, um, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 12.52,
      "duration_seconds": 4.91,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.48,
      "end_seconds": 19.08,
      "duration_seconds": 5.6,
      "text": "Doctor, it's a pink spotty rash. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.94,
      "end_seconds": 23.03,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.25,
      "end_seconds": 35.13,
      "duration_seconds": 10.88,
      "text": "Sorry, what was I saying, I've had it since last weekend. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.46,
      "end_seconds": 40.28,
      "duration_seconds": 3.82,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.63,
      "end_seconds": 48.21,
      "duration_seconds": 2.58,
      "text": "Erm, I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.2,
      "end_seconds": 54.32,
      "duration_seconds": 4.12,
      "text": "What about a runny nose, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.24,
      "end_seconds": 57.98,
      "duration_seconds": 1.74,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.8,
      "end_seconds": 64.75,
      "duration_seconds": 4.95,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.53,
      "end_seconds": 74.9,
      "duration_seconds": 8.37,
      "text": "I had a reaction to erythromycin when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.16,
      "end_seconds": 77.79,
      "duration_seconds": 1.63,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.12,
      "end_seconds": 82.85,
      "duration_seconds": 3.73,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.4,
      "end_seconds": 84.7,
      "duration_seconds": 1.3,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.43,
      "end_seconds": 90.76,
      "duration_seconds": 4.33,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.57,
      "end_seconds": 94.81,
      "duration_seconds": 2.24,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.63,
      "end_seconds": 101.36,
      "duration_seconds": 5.73,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.65,
      "end_seconds": 104.85,
      "duration_seconds": 2.2,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.02,
      "end_seconds": 109.86,
      "duration_seconds": 3.84,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.09,
      "end_seconds": 113.31,
      "duration_seconds": 2.22,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.28,
      "end_seconds": 117.0,
      "duration_seconds": 2.72,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.19,
      "end_seconds": 135.45,
      "duration_seconds": 4.26,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.04,
      "end_seconds": 140.46,
      "duration_seconds": 4.42,
      "text": "I take paracetamol syrup, 5 ml, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.02,
      "end_seconds": 145.21,
      "duration_seconds": 4.19,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.77,
      "end_seconds": 151.59,
      "duration_seconds": 5.82,
      "text": "Sorry, what was I saying, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.31,
      "end_seconds": 160.58,
      "duration_seconds": 7.27,
      "text": "Let me check a few things. Any rash that does not fade, stiff neck or breathlessness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.97,
      "end_seconds": 168.38,
      "duration_seconds": 6.41,
      "text": "I haven't had rash that does not fade, stiff neck or breathlessness, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.16,
      "end_seconds": 173.2,
      "duration_seconds": 3.04,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.48,
      "end_seconds": 179.0,
      "duration_seconds": 1.52,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.69,
      "end_seconds": 191.08,
      "duration_seconds": 2.39,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.49,
      "end_seconds": 205.84,
      "duration_seconds": 3.35,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.29,
      "end_seconds": 228.87,
      "duration_seconds": 8.58,
      "text": "Okay: saturation 99 percent, temperature is 36.7 degrees, pulse 67, BP is 110 over 82, respiratory rate 16."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.82,
      "end_seconds": 232.21,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.49,
      "end_seconds": 239.51,
      "duration_seconds": 3.02,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.47,
      "end_seconds": 265.31,
      "duration_seconds": 14.84,
      "text": "Putting together what you've described, I think we're dealing with a harmless viral rash at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.87,
      "end_seconds": 269.71,
      "duration_seconds": 3.84,
      "text": "Um, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.71,
      "end_seconds": 297.73,
      "duration_seconds": 26.02,
      "text": "I understand the worry. At the moment I'd say it's a harmless viral rash, and we'll watch how it goes. Fluids and paracetamol if he is hot or uncomfortable. If the spots do not fade when pressed or he becomes drowsy, or you feel really unwell, please come to the emergency department. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.99,
      "end_seconds": 300.91,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    }
  ]
}