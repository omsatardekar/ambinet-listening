{
  "schema_version": "1.0",
  "encounter_id": "01445",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.52,
      "duration_seconds": 4.84,
      "text": "Morning, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 11.06,
      "duration_seconds": 4.64,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.66,
      "end_seconds": 19.42,
      "duration_seconds": 7.76,
      "text": "Let me think, I've been feeling a bit muddled, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.46,
      "end_seconds": 24.22,
      "duration_seconds": 3.76,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.9,
      "end_seconds": 37.53,
      "duration_seconds": 12.63,
      "text": "well, for about two weeks, I'd say i've been putting this off for weeks i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.33,
      "end_seconds": 42.41,
      "duration_seconds": 4.08,
      "text": "Is it a lot or only a a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.22,
      "end_seconds": 44.71,
      "duration_seconds": 1.49,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.11,
      "end_seconds": 48.09,
      "duration_seconds": 1.98,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.91,
      "end_seconds": 57.5,
      "duration_seconds": 8.59,
      "text": "Constipation goes along with it, most of the time. Actually, the Constipation? That's been for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.02,
      "end_seconds": 63.07,
      "duration_seconds": 5.05,
      "text": "sure do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 68.29,
      "duration_seconds": 3.32,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.5,
      "end_seconds": 72.46,
      "duration_seconds": 2.96,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.39,
      "end_seconds": 74.48,
      "duration_seconds": 1.09,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.17,
      "end_seconds": 77.89,
      "duration_seconds": 2.72,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.97,
      "end_seconds": 83.3,
      "duration_seconds": 4.33,
      "text": "Oh, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.38,
      "end_seconds": 86.2,
      "duration_seconds": 1.82,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.04,
      "end_seconds": 91.38,
      "duration_seconds": 3.34,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.51,
      "end_seconds": 94.89,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.09,
      "end_seconds": 101.25,
      "duration_seconds": 5.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.27,
      "end_seconds": 112.38,
      "duration_seconds": 4.11,
      "text": "A few quick ones: falls, chest pain or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.92,
      "end_seconds": 115.73,
      "duration_seconds": 2.81,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 124.29,
      "duration_seconds": 2.39,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.14,
      "end_seconds": 128.76,
      "duration_seconds": 2.62,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.67,
      "end_seconds": 133.88,
      "duration_seconds": 4.21,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.16,
      "end_seconds": 142.56,
      "duration_seconds": 3.4,
      "text": "um, no, that's been fine"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.62,
      "end_seconds": 148.09,
      "duration_seconds": 4.47,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.51,
      "end_seconds": 159.04,
      "duration_seconds": 2.53,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.17,
      "end_seconds": 189.49,
      "duration_seconds": 10.32,
      "text": "Okay: temperature 36.8, respiratory rate 19, SpO2 98 percent on room air. And blood pressure 94 over 59, pulse 107."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.87,
      "end_seconds": 195.1,
      "duration_seconds": 3.23,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.17,
      "end_seconds": 197.61,
      "duration_seconds": 1.44,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.27,
      "end_seconds": 215.51,
      "duration_seconds": 3.24,
      "text": "Your blood pressure drops a little on standing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.41,
      "end_seconds": 220.62,
      "duration_seconds": 2.21,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.69,
      "end_seconds": 242.98,
      "duration_seconds": 7.29,
      "text": "Putting it all together, the most likely explanation is side effects from several medicines taken together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.98,
      "end_seconds": 250.83,
      "duration_seconds": 2.85,
      "text": "is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.16,
      "end_seconds": 266.76,
      "duration_seconds": 10.6,
      "text": "Nothing I've seen today points to an emergency. It looks like side effects from several medicines taken together, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.6,
      "end_seconds": 287.37,
      "duration_seconds": 3.77,
      "text": "I want blood tests done, that's for dizziness"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 289.31,
      "end_seconds": 292.55,
      "duration_seconds": 3.24,
      "text": "The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.37,
      "end_seconds": 302.3,
      "duration_seconds": 7.93,
      "text": "we will stop the sleeping tablet slowly over two weeks i'd like to see you again in two weeks"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.05,
      "end_seconds": 306.2,
      "duration_seconds": 2.15,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.82,
      "end_seconds": 309.29,
      "duration_seconds": 2.47,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.54,
      "end_seconds": 312.62,
      "duration_seconds": 2.08,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.46,
      "end_seconds": 315.47,
      "duration_seconds": 2.01,
      "text": "Okay, take care now."
    }
  ]
}