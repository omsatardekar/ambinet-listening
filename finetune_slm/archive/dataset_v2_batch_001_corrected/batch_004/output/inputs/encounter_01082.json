{
  "schema_version": "1.0",
  "encounter_id": "01082",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 3.71,
      "duration_seconds": 2.45,
      "text": "Okay, morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.74,
      "end_seconds": 6.81,
      "duration_seconds": 1.07,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.68,
      "end_seconds": 11.42,
      "duration_seconds": 3.74,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 19.87,
      "duration_seconds": 6.93,
      "text": "Oh, um, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.23,
      "end_seconds": 24.38,
      "duration_seconds": 3.15,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.52,
      "end_seconds": 39.56,
      "duration_seconds": 14.04,
      "text": "I've, I've been feeling extremely weak, and I wanted to get it checked. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.48,
      "end_seconds": 43.21,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.81,
      "end_seconds": 55.21,
      "duration_seconds": 10.4,
      "text": "It's been two months, I'm fairly sure. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.34,
      "end_seconds": 58.73,
      "duration_seconds": 2.39,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.18,
      "end_seconds": 73.73,
      "duration_seconds": 13.55,
      "text": "It usually comes with tummy pain. And vomiting, too. Okay, uh, so the tummy pain? That's been for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.81,
      "end_seconds": 78.92,
      "duration_seconds": 3.11,
      "text": "A few quick ones: fever or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.69,
      "end_seconds": 88.0,
      "duration_seconds": 8.31,
      "text": "Sorry, what was I saying, I haven't had fever or chest pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.42,
      "end_seconds": 96.39,
      "duration_seconds": 2.97,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.39,
      "end_seconds": 100.46,
      "duration_seconds": 3.07,
      "text": "Okay, so I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.22,
      "end_seconds": 106.79,
      "duration_seconds": 4.57,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.34,
      "end_seconds": 124.39,
      "duration_seconds": 16.05,
      "text": "I only drink at family occasions. Not much, I mostly stay in these days. I'm vegetarian and have been for years. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.53,
      "end_seconds": 129.15,
      "duration_seconds": 3.62,
      "text": "Alright, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.68,
      "end_seconds": 140.55,
      "duration_seconds": 6.87,
      "text": "I mean, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.53,
      "end_seconds": 153.73,
      "duration_seconds": 2.2,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.85,
      "end_seconds": 160.34,
      "duration_seconds": 5.49,
      "text": "I've got high blood pressure. Thin bones, for five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.16,
      "end_seconds": 176.23,
      "duration_seconds": 3.07,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.04,
      "end_seconds": 179.95,
      "duration_seconds": 2.91,
      "text": "Right, my son has asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.94,
      "end_seconds": 185.53,
      "duration_seconds": 2.59,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.52,
      "end_seconds": 207.2,
      "duration_seconds": 19.68,
      "text": "Uh, it's valsartan, 80 milligrams, once a day for my blood pressure. Let me think, I take alendronate, 70 milligrams, once a week for my bones. My steroid tablets, stopped last week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.47,
      "end_seconds": 212.47,
      "duration_seconds": 2.0,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.48,
      "end_seconds": 219.15,
      "duration_seconds": 4.67,
      "text": "5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.67,
      "end_seconds": 229.84,
      "duration_seconds": 5.17,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.42,
      "end_seconds": 233.97,
      "duration_seconds": 3.55,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.76,
      "end_seconds": 238.41,
      "duration_seconds": 2.65,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.63,
      "end_seconds": 247.35,
      "duration_seconds": 2.72,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.94,
      "end_seconds": 283.69,
      "duration_seconds": 16.75,
      "text": "Okay: BMI works out to 27.1, temp 37.2 degrees, oxygen saturation is 96 percent. And pulse is 107 beats a minute, height 164 centimetres, blood pressure 92 over 58, weight 73 kilos."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.85,
      "end_seconds": 289.38,
      "duration_seconds": 4.53,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.41,
      "end_seconds": 293.0,
      "duration_seconds": 1.59,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.72,
      "end_seconds": 296.01,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.8,
      "end_seconds": 315.35,
      "duration_seconds": 4.55,
      "text": "Your blood pressure is very low and your skin is cool."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.8,
      "end_seconds": 318.72,
      "duration_seconds": 1.92,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.87,
      "end_seconds": 325.49,
      "duration_seconds": 1.62,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.51,
      "end_seconds": 351.24,
      "duration_seconds": 9.73,
      "text": "From what you've told me and what I found, my working impression is a possible adrenal crisis after stopping steroids."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.0,
      "end_seconds": 356.18,
      "duration_seconds": 3.18,
      "text": "I mean, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.92,
      "end_seconds": 393.07,
      "duration_seconds": 36.15,
      "text": "It's reasonable to be concerned, but right now a possible adrenal crisis after stopping steroids is my leading thought, not anything worse. I'm going to order blood tests, for adrenal crisis. The result will help us decide whether anything more is needed. The treatment will be hydrocortisone, 100 milligrams, once now, single dose. That should help with adrenal crisis. I am giving an injection now and calling an ambulance. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.61,
      "end_seconds": 399.12,
      "duration_seconds": 5.51,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 401.22,
      "end_seconds": 405.65,
      "duration_seconds": 4.43,
      "text": "Well, you know, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.2,
      "end_seconds": 408.4,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}