{
  "schema_version": "1.0",
  "encounter_id": "01141",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 8.89,
      "duration_seconds": 8.0,
      "text": "Hello doctor, um, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.47,
      "end_seconds": 13.62,
      "duration_seconds": 4.15,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.58,
      "end_seconds": 19.58,
      "duration_seconds": 5.0,
      "text": "So the thing is, I've got a missed period."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.74,
      "end_seconds": 24.16,
      "duration_seconds": 3.42,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.5,
      "end_seconds": 29.09,
      "duration_seconds": 3.59,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.82,
      "end_seconds": 33.38,
      "duration_seconds": 3.56,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.95,
      "end_seconds": 38.61,
      "duration_seconds": 4.66,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.13,
      "end_seconds": 42.79,
      "duration_seconds": 3.66,
      "text": "Have you been feeling sick in the mornings?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.72,
      "end_seconds": 62.81,
      "duration_seconds": 19.09,
      "text": "Um, yeah. Three days, I'd say. So, with feeling sick in the mornings, I'd call it moderate. Honestly, a few times a day. Let me think, I've also had tender breasts."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.43,
      "end_seconds": 67.29,
      "duration_seconds": 3.86,
      "text": "Right, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.97,
      "end_seconds": 69.64,
      "duration_seconds": 1.67,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.34,
      "end_seconds": 84.43,
      "duration_seconds": 4.09,
      "text": "Have you noticed bleeding, severe pain or vomiting everything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.0,
      "end_seconds": 89.38,
      "duration_seconds": 4.38,
      "text": "No, no bleeding, severe pain or vomiting everything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.37,
      "end_seconds": 94.09,
      "duration_seconds": 2.72,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.15,
      "end_seconds": 96.26,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.66,
      "end_seconds": 101.3,
      "duration_seconds": 3.64,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.07,
      "end_seconds": 111.42,
      "duration_seconds": 9.35,
      "text": "Sorry, what was I saying, I take apixaban, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.75,
      "end_seconds": 115.21,
      "duration_seconds": 2.46,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.91,
      "end_seconds": 129.87,
      "duration_seconds": 13.96,
      "text": "It's, It's 5 milligrams. Actually, I take glibenclamide, 5 milligrams, before breakfast. Uh, I'm on a folic acid tablet, 400 micrograms, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.83,
      "end_seconds": 133.72,
      "duration_seconds": 2.89,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.78,
      "end_seconds": 139.73,
      "duration_seconds": 4.95,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.56,
      "end_seconds": 143.77,
      "duration_seconds": 2.21,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.53,
      "end_seconds": 153.44,
      "duration_seconds": 5.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.71,
      "end_seconds": 167.73,
      "duration_seconds": 2.02,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.17,
      "end_seconds": 173.9,
      "duration_seconds": 4.73,
      "text": "Erm, I have an irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.48,
      "end_seconds": 176.94,
      "duration_seconds": 1.46,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.73,
      "end_seconds": 189.77,
      "duration_seconds": 11.04,
      "text": "Diabetes, for five years. I'd rather know what's going on than keep guessing. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.3,
      "end_seconds": 199.26,
      "duration_seconds": 7.96,
      "text": "Okay, I can see an irregular heartbeat and diabetes in your file as well. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.17,
      "end_seconds": 205.42,
      "duration_seconds": 4.25,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.11,
      "end_seconds": 208.78,
      "duration_seconds": 2.67,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.32,
      "end_seconds": 211.33,
      "duration_seconds": 2.01,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 212.5,
      "end_seconds": 222.04,
      "duration_seconds": 9.54,
      "text": "Okay, so the vitals from earlier. Pulse is 78 beats a minute, respiratory rate 16, temperature is 36.9 degrees. BP is 120 over 72."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.87,
      "end_seconds": 225.39,
      "duration_seconds": 1.52,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.13,
      "end_seconds": 229.18,
      "duration_seconds": 2.05,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.1,
      "end_seconds": 233.08,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.98,
      "end_seconds": 243.33,
      "duration_seconds": 2.35,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.35,
      "end_seconds": 250.02,
      "duration_seconds": 2.67,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.35,
      "end_seconds": 282.62,
      "duration_seconds": 17.27,
      "text": "Putting it all together, it points towards a normal early pregnancy. I think a booking blood test makes sense here, for pregnancy. Keep taking folic acid and book in with the midwife. I'm going to send a referral to the midwife."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.33,
      "end_seconds": 284.03,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.6,
      "end_seconds": 290.9,
      "duration_seconds": 6.3,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.58,
      "end_seconds": 300.0,
      "duration_seconds": 5.42,
      "text": "So, um, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.91,
      "end_seconds": 305.72,
      "duration_seconds": 4.81,
      "text": "Let's review you in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.08,
      "end_seconds": 311.34,
      "duration_seconds": 4.26,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.18,
      "end_seconds": 313.38,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}