{
  "schema_version": "1.0",
  "encounter_id": "01262",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.16,
      "duration_seconds": 3.58,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 10.29,
      "duration_seconds": 4.93,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.61,
      "end_seconds": 25.53,
      "duration_seconds": 13.92,
      "text": "I wanted to to get a severe sore throat looked at i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.13,
      "end_seconds": 29.21,
      "duration_seconds": 2.08,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.45,
      "end_seconds": 33.46,
      "duration_seconds": 3.01,
      "text": "Since Monday, that's when it began"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.47,
      "end_seconds": 36.79,
      "duration_seconds": 2.32,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.31,
      "end_seconds": 41.44,
      "duration_seconds": 3.13,
      "text": "yes, swallowing that makes it worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.94,
      "end_seconds": 61.65,
      "duration_seconds": 2.71,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.47,
      "end_seconds": 75.83,
      "duration_seconds": 13.36,
      "text": "I smoke roughly a pack every two days. Lots of rice, lentils and some fruit. My husband and I live above the shop. I swim twice a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.88,
      "end_seconds": 81.95,
      "duration_seconds": 4.07,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.59,
      "end_seconds": 86.32,
      "duration_seconds": 3.73,
      "text": "mm, no, nothing I can think of"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.79,
      "end_seconds": 93.29,
      "duration_seconds": 2.5,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.28,
      "end_seconds": 97.97,
      "duration_seconds": 2.69,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.94,
      "end_seconds": 104.66,
      "duration_seconds": 5.72,
      "text": "Before we go further, any allergies? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.22,
      "end_seconds": 112.68,
      "duration_seconds": 2.46,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 127.59,
      "duration_seconds": 2.91,
      "text": "Have you had any cough or rash?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.05,
      "end_seconds": 132.01,
      "duration_seconds": 2.96,
      "text": "Nope, you know, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.63,
      "end_seconds": 134.58,
      "duration_seconds": 1.95,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.24,
      "end_seconds": 138.83,
      "duration_seconds": 2.59,
      "text": "Oh, no, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.65,
      "end_seconds": 143.72,
      "duration_seconds": 4.07,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.14,
      "end_seconds": 159.72,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.77,
      "end_seconds": 184.53,
      "duration_seconds": 9.76,
      "text": "Okay: temperature is 37.0 degrees, oxygen saturation is 90 percent. And respiratory rate 25, BP is 126 over 83, pulse 96."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.38,
      "end_seconds": 190.58,
      "duration_seconds": 4.2,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.35,
      "end_seconds": 205.35,
      "duration_seconds": 1.0,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.59,
      "end_seconds": 208.73,
      "duration_seconds": 2.14,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.71,
      "end_seconds": 229.19,
      "duration_seconds": 4.48,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.2,
      "end_seconds": 232.3,
      "duration_seconds": 1.1,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.95,
      "end_seconds": 238.73,
      "duration_seconds": 1.78,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 269.86,
      "duration_seconds": 15.05,
      "text": "so, based on the history and the examination, the most likely explanation is a possible airway infection that needs emergency care that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.8,
      "end_seconds": 276.72,
      "duration_seconds": 2.92,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.53,
      "end_seconds": 295.42,
      "duration_seconds": 17.89,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible airway infection that needs emergency care, but I'd like to confirm. I'll request an urgent airway assessment, it'll help with stridor and drooling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 300.66,
      "end_seconds": 305.7,
      "duration_seconds": 5.04,
      "text": "we have a slot Tuesday at 2 pm, if that works"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.15,
      "end_seconds": 320.34,
      "duration_seconds": 13.19,
      "text": "Do not lie flat, I am calling an ambulance now. The emergency ENT team would be the right next step, I'll refer you. Do get help quickly if the breathing gets harder."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.74,
      "end_seconds": 325.91,
      "duration_seconds": 2.17,
      "text": "that's fine by me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.19,
      "end_seconds": 333.52,
      "duration_seconds": 6.33,
      "text": "Let's plan a a check straight away. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.83,
      "end_seconds": 336.96,
      "duration_seconds": 2.13,
      "text": "thank you, that's helpful"
    }
  ]
}