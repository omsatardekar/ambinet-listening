  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 5.68,
      "duration_seconds": 4.46,
      "text": "Hi doctor, um, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 11.63,
      "duration_seconds": 4.48,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.91,
      "end_seconds": 25.03,
      "duration_seconds": 12.12,
      "text": "Sorry, uh, what was I saying, it's being thirsty. I thought I'd wait, but it hasn't gone. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.38,
      "end_seconds": 28.77,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.31,
      "end_seconds": 35.37,
      "duration_seconds": 5.06,
      "text": "Glibenclamide. I take it 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.59,
      "end_seconds": 40.33,
      "duration_seconds": 4.74,
      "text": "Right, right. Has there been tingling in your toes too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.74,
      "end_seconds": 60.04,
      "duration_seconds": 18.3,
      "text": "Yeah, um, I've had that since yesterday. Sorry, um, what was I saying, with tingling in my toes, a four out of ten, I suppose. It happens every other day. I notice it more with night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.24,
      "end_seconds": 66.05,
      "duration_seconds": 4.81,
      "text": "A few quick ones: foot ulcers, chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.39,
      "end_seconds": 73.19,
      "duration_seconds": 5.8,
      "text": "No foot ulcers, chest pain or vomiting, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.82,
      "end_seconds": 76.58,
      "duration_seconds": 2.76,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.81,
      "end_seconds": 80.29,
      "duration_seconds": 2.48,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.25,
      "end_seconds": 84.42,
      "duration_seconds": 2.17,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.42,
      "end_seconds": 89.41,
      "duration_seconds": 1.99,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.83,
      "end_seconds": 102.98,
      "duration_seconds": 9.15,
      "text": "Do you react to any medicines or foods? Any allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 108.33,
      "duration_seconds": 4.19,
      "text": "Hmm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.64,
      "end_seconds": 113.69,
      "duration_seconds": 4.05,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.2,
      "end_seconds": 119.13,
      "duration_seconds": 3.93,
      "text": "I have diabetes, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.84,
      "end_seconds": 124.22,
      "duration_seconds": 3.38,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.44,
      "end_seconds": 138.4,
      "duration_seconds": 8.96,
      "text": "I walk the dog every morning. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.43,
      "end_seconds": 141.78,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.28,
      "end_seconds": 144.33,
      "duration_seconds": 2.05,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.68,
      "end_seconds": 153.77,
      "duration_seconds": 2.09,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.86,
      "end_seconds": 164.9,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.87,
      "end_seconds": 188.83,
      "duration_seconds": 12.96,
      "text": "Okay: BP is 155 over 90, pulse is 82 beats a minute, saturation 98 percent, BMI works out to 27.4, weight 80 kilos, height 171 centimetres."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.33,
      "end_seconds": 194.21,
      "duration_seconds": 3.88,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.82,
      "end_seconds": 198.36,
      "duration_seconds": 2.54,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.38,
      "end_seconds": 212.87,
      "duration_seconds": 7.49,
      "text": "The feeling at the tips of your toes is reduced and the foot pulses are present."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.42,
      "end_seconds": 217.79,
      "duration_seconds": 2.37,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.61,
      "end_seconds": 236.48,
      "duration_seconds": 8.87,
      "text": "From what you've told me and what I found, my working impression is diabetes not well controlled on current treatment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.16,
      "end_seconds": 241.22,
      "duration_seconds": 4.06,
      "text": "Well, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.76,
      "end_seconds": 254.08,
      "duration_seconds": 10.32,
      "text": "I can't promise yet, but most people with diabetes not well controlled on current treatment do well once it's treated properly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.31,
      "end_seconds": 276.52,
      "duration_seconds": 4.21,
      "text": "I'm sending you for an HbA1c because of diabetes review."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 278.3,
      "end_seconds": 280.66,
      "duration_seconds": 2.36,
      "text": "The earliest is Thursday, 9 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.98,
      "end_seconds": 291.3,
      "duration_seconds": 9.32,
      "text": "We should do a urine albumin test for diabetes review. I think kidney function tests makes sense here, for diabetes review."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.01,
      "end_seconds": 293.14,
      "duration_seconds": 1.13,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.14,
      "end_seconds": 299.14,
      "duration_seconds": 4.0,
      "text": "Check your feet daily and book the eye screening."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.62,
      "end_seconds": 305.69,
      "duration_seconds": 6.07,
      "text": "Yes, carry on. See me again in three months. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.38,
      "end_seconds": 309.73,
      "duration_seconds": 3.35,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.34,
      "end_seconds": 311.52,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
