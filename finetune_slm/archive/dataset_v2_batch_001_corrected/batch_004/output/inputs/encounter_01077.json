{
  "schema_version": "1.0",
  "encounter_id": "01077",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.28,
      "duration_seconds": 2.38,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.7,
      "end_seconds": 5.95,
      "duration_seconds": 1.25,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.07,
      "end_seconds": 8.96,
      "duration_seconds": 1.89,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.27,
      "end_seconds": 21.48,
      "duration_seconds": 11.21,
      "text": "Well, I've been having pain much worse than it looks. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.67,
      "end_seconds": 27.81,
      "duration_seconds": 3.14,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.15,
      "end_seconds": 32.51,
      "duration_seconds": 3.36,
      "text": "I mean, I've had it since Monday"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.4,
      "end_seconds": 43.96,
      "duration_seconds": 9.56,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.21,
      "end_seconds": 52.51,
      "duration_seconds": 7.3,
      "text": "It, It feels mild to me. It comes and goes. I've also had dark blisters."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.93,
      "end_seconds": 56.84,
      "duration_seconds": 2.91,
      "text": "Has there been a high fever too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.7,
      "end_seconds": 60.64,
      "duration_seconds": 2.94,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.62,
      "end_seconds": 67.84,
      "duration_seconds": 5.22,
      "text": "Let me check a a few things. Any insect bite or cut?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.55,
      "end_seconds": 73.75,
      "duration_seconds": 4.2,
      "text": "No insect bite or cut, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.3,
      "end_seconds": 77.59,
      "duration_seconds": 3.29,
      "text": "I follow anything different when you pass water?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.45,
      "end_seconds": 81.21,
      "duration_seconds": 1.76,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.32,
      "end_seconds": 85.73,
      "duration_seconds": 3.41,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.34,
      "end_seconds": 96.78,
      "duration_seconds": 10.44,
      "text": "I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.38,
      "end_seconds": 100.25,
      "duration_seconds": 2.87,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.2,
      "end_seconds": 105.6,
      "duration_seconds": 3.4,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.72,
      "end_seconds": 122.7,
      "duration_seconds": 2.98,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.3,
      "end_seconds": 124.47,
      "duration_seconds": 1.17,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.45,
      "end_seconds": 126.81,
      "duration_seconds": 1.36,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.51,
      "end_seconds": 130.98,
      "duration_seconds": 2.47,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.42,
      "end_seconds": 141.67,
      "duration_seconds": 9.25,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.09,
      "end_seconds": 144.24,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.22,
      "end_seconds": 157.12,
      "duration_seconds": 3.9,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.33,
      "end_seconds": 163.17,
      "duration_seconds": 4.84,
      "text": "Alendronate, 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.92,
      "end_seconds": 169.78,
      "duration_seconds": 4.86,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.89,
      "end_seconds": 179.28,
      "duration_seconds": 8.39,
      "text": "Not with me. I'll bring it next time. I was on metformin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.47,
      "end_seconds": 182.72,
      "duration_seconds": 2.25,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.32,
      "end_seconds": 198.05,
      "duration_seconds": 2.73,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.76,
      "end_seconds": 222.07,
      "duration_seconds": 7.31,
      "text": "okay: BP is 106 over 73, pulse 106. And saturation 95 percent, temperature 38.6."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.29,
      "end_seconds": 224.66,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.52,
      "end_seconds": 229.39,
      "duration_seconds": 2.87,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.22,
      "end_seconds": 236.31,
      "duration_seconds": 4.09,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.6,
      "end_seconds": 239.96,
      "duration_seconds": 2.36,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 262.81,
      "duration_seconds": 7.53,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.35,
      "end_seconds": 268.91,
      "duration_seconds": 2.56,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.51,
      "end_seconds": 288.74,
      "duration_seconds": 12.23,
      "text": "Putting it all together, I'd lean towards a severe deep skin infection needing urgent surgery review. We should do urgent blood tests for severe skin infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 290.04,
      "end_seconds": 292.95,
      "duration_seconds": 2.91,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.18,
      "end_seconds": 327.37,
      "duration_seconds": 33.19,
      "text": "Let's get an urgent surgical review, for possible necrotising infection. I am sending you to hospital now, do not wait. I'm going to send a referral to the surgical team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if you cannot go now. Book a review straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.44,
      "end_seconds": 331.28,
      "duration_seconds": 2.84,
      "text": "great, thank you for your help"
    }
  ]
}