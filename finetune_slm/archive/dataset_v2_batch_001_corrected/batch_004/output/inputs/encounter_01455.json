{
  "schema_version": "1.0",
  "encounter_id": "01455",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 3.84,
      "duration_seconds": 3.3,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.4,
      "end_seconds": 9.82,
      "duration_seconds": 4.42,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.53,
      "end_seconds": 17.88,
      "duration_seconds": 6.35,
      "text": "Doctor, it's very heavy periods. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.71,
      "end_seconds": 21.49,
      "duration_seconds": 2.78,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.91,
      "end_seconds": 27.72,
      "duration_seconds": 4.81,
      "text": "I'd say three weeks. Actually, no, closer to one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.2,
      "end_seconds": 32.46,
      "duration_seconds": 3.26,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.46,
      "end_seconds": 37.39,
      "duration_seconds": 3.93,
      "text": "Erm, only extra pads, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.99,
      "end_seconds": 49.22,
      "duration_seconds": 3.23,
      "text": "Right, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.29,
      "end_seconds": 53.04,
      "duration_seconds": 1.75,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.25,
      "end_seconds": 71.2,
      "duration_seconds": 4.95,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.72,
      "end_seconds": 75.14,
      "duration_seconds": 2.42,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.13,
      "end_seconds": 78.37,
      "duration_seconds": 1.24,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.15,
      "end_seconds": 84.36,
      "duration_seconds": 4.21,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.31,
      "end_seconds": 90.45,
      "duration_seconds": 2.14,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.71,
      "end_seconds": 95.68,
      "duration_seconds": 3.97,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.47,
      "end_seconds": 99.71,
      "duration_seconds": 2.24,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.92,
      "end_seconds": 105.38,
      "duration_seconds": 4.46,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.93,
      "end_seconds": 127.5,
      "duration_seconds": 3.57,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.1,
      "end_seconds": 129.56,
      "duration_seconds": 1.46,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.96,
      "end_seconds": 133.63,
      "duration_seconds": 2.67,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.67,
      "end_seconds": 142.52,
      "duration_seconds": 2.85,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.54,
      "end_seconds": 148.81,
      "duration_seconds": 4.27,
      "text": "Any pain with sex or weight loss at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.95,
      "end_seconds": 155.5,
      "duration_seconds": 5.55,
      "text": "I haven't had pain with sex or weight loss, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.48,
      "end_seconds": 159.86,
      "duration_seconds": 2.38,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.18,
      "end_seconds": 163.27,
      "duration_seconds": 2.09,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.26,
      "end_seconds": 166.42,
      "duration_seconds": 2.16,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 179.93,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.23,
      "end_seconds": 204.11,
      "duration_seconds": 8.88,
      "text": "Okay: height 164 centimetres, temperature 36.6, saturation 98 percent, pulse 86, weight 80 kilos, pressure 115 over 70."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.32,
      "end_seconds": 209.91,
      "duration_seconds": 4.59,
      "text": "Sorry, what was I saying, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.46,
      "end_seconds": 213.36,
      "duration_seconds": 2.9,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.97,
      "end_seconds": 219.53,
      "duration_seconds": 4.56,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.66,
      "end_seconds": 222.81,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.0,
      "end_seconds": 235.43,
      "duration_seconds": 5.43,
      "text": "The uterus feels enlarged and firm, about the size of a ten-week pregnancy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.6,
      "end_seconds": 241.24,
      "duration_seconds": 3.64,
      "text": "So, good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.76,
      "end_seconds": 259.37,
      "duration_seconds": 4.61,
      "text": "A pelvic ultrasound is what I'd like next, for heavy periods."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.46,
      "end_seconds": 265.42,
      "duration_seconds": 2.96,
      "text": "Actually, that's fine with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.9,
      "end_seconds": 296.65,
      "duration_seconds": 29.75,
      "text": "A ferritin level is what I'd like next, for heavy periods. Keep a record of the bleeding with the pad count. The gynaecology clinic would be the right next step, I'll refer you. A blood count is something we might do if this doesn't improve in a month. Come back or go to emergency straight away if the symptoms get worse. I'd like to see you again after the scan. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.21,
      "end_seconds": 300.22,
      "duration_seconds": 3.01,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}