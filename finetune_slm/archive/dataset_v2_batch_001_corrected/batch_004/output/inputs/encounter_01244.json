{
  "schema_version": "1.0",
  "encounter_id": "01244",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 5.53,
      "duration_seconds": 4.8,
      "text": "Hi, sit anywhere you like. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.26,
      "end_seconds": 11.84,
      "duration_seconds": 4.58,
      "text": "Erm, I'm here cos of more breathless than usual."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.2,
      "end_seconds": 16.02,
      "duration_seconds": 2.82,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.19,
      "end_seconds": 21.62,
      "duration_seconds": 4.43,
      "text": "it's been about four days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.98,
      "end_seconds": 30.83,
      "duration_seconds": 8.85,
      "text": "Ah. Can you describe it a bit more for me? How strong it is what the pattern is what helps."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.53,
      "end_seconds": 41.32,
      "duration_seconds": 8.79,
      "text": "honestly, all the time. It It feels severe to me. I've also had more sputum, a bit yellow"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 48.82,
      "duration_seconds": 6.34,
      "text": "have you had more breathless than usual before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.51,
      "end_seconds": 58.53,
      "duration_seconds": 8.02,
      "text": "yes, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.94,
      "end_seconds": 66.58,
      "duration_seconds": 3.64,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.92,
      "end_seconds": 72.91,
      "duration_seconds": 4.99,
      "text": "I'm on Tiotropium inhaler once a day for my chest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.92,
      "end_seconds": 91.34,
      "duration_seconds": 2.42,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.57,
      "end_seconds": 97.77,
      "duration_seconds": 5.2,
      "text": "yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.37,
      "end_seconds": 102.73,
      "duration_seconds": 3.36,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.39,
      "end_seconds": 106.62,
      "duration_seconds": 3.23,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.27,
      "end_seconds": 112.52,
      "duration_seconds": 2.25,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.34,
      "end_seconds": 115.68,
      "duration_seconds": 2.34,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.33,
      "end_seconds": 118.26,
      "duration_seconds": 1.93,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.49,
      "end_seconds": 121.8,
      "duration_seconds": 2.31,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 124.96,
      "duration_seconds": 2.58,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.6,
      "end_seconds": 132.56,
      "duration_seconds": 6.96,
      "text": "sorry, what was I saying, I have COPD, for about a year"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.79,
      "end_seconds": 139.83,
      "duration_seconds": 5.04,
      "text": "are you allergic to to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.47,
      "end_seconds": 144.53,
      "duration_seconds": 4.06,
      "text": "Tramadol. I come out in... well feeling very drowsy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.48,
      "end_seconds": 162.9,
      "duration_seconds": 3.42,
      "text": "And what about swollen ankles or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.76,
      "end_seconds": 166.33,
      "duration_seconds": 2.57,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.9,
      "end_seconds": 171.03,
      "duration_seconds": 4.13,
      "text": "and and what about chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.83,
      "end_seconds": 178.17,
      "duration_seconds": 5.34,
      "text": "right, no chest pain or coughing up blood, none of it"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.59,
      "end_seconds": 182.29,
      "duration_seconds": 2.7,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.92,
      "end_seconds": 185.19,
      "duration_seconds": 2.27,
      "text": "no that's all fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.06,
      "end_seconds": 189.3,
      "duration_seconds": 3.24,
      "text": "okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.1,
      "end_seconds": 191.11,
      "duration_seconds": 1.01,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.99,
      "end_seconds": 196.13,
      "duration_seconds": 4.14,
      "text": "shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.24,
      "end_seconds": 207.61,
      "duration_seconds": 2.37,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.91,
      "end_seconds": 235.45,
      "duration_seconds": 8.54,
      "text": "okay: respiratory rate 24, pulse is 103 beats a minute, saturation 92 percent and blood pressure 125 over 81."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 242.26,
      "duration_seconds": 4.05,
      "text": "could you come over to to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.97,
      "end_seconds": 252.51,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.25,
      "end_seconds": 256.22,
      "duration_seconds": 1.97,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.85,
      "end_seconds": 271.55,
      "duration_seconds": 5.7,
      "text": "there is wheeze at both bases and and your oxygen is a little low"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.77,
      "end_seconds": 284.34,
      "duration_seconds": 10.57,
      "text": "you can relax now. Okay, so my impression is this: My working impression is a flare-up of COPD. We shouldn't forget a a chest infection"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.32,
      "end_seconds": 288.6,
      "duration_seconds": 3.28,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.65,
      "end_seconds": 310.44,
      "duration_seconds": 19.79,
      "text": "It's reasonable to to be concerned, but right now a flare-up of COPD is my leading thought, not anything worse. Just to be sure I understood. You've had more breathless than usual for about four days, severe, and no chest pain or coughing up blood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.25,
      "end_seconds": 312.67,
      "duration_seconds": 1.42,
      "text": "mm that's right"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.41,
      "end_seconds": 342.32,
      "duration_seconds": 28.91,
      "text": "A chest X-ray is what I'd like next, for COPD flare. I'd like to arrange a sputum sample for purulent sputum. I'm going to put you on prednisolone, 30 milligrams, once a day, five days. It's for COPD flare. What I'm giving you is doxycycline, 100 milligrams, once a day, five days. That's for chest infection. Use your inhaler regularly and get seen if you are not better in three days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.22,
      "end_seconds": 359.46,
      "duration_seconds": 15.24,
      "text": "try to get to bed and wake up at the same time each day, and keep your phone away from the bed one warning sign to remember: the symptoms get worse in that case don't wait"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.07,
      "end_seconds": 365.85,
      "duration_seconds": 4.78,
      "text": "Let me think, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.82,
      "end_seconds": 374.18,
      "duration_seconds": 6.36,
      "text": "See me again in one week. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.62,
      "end_seconds": 387.86,
      "duration_seconds": 12.24,
      "text": "so, I take the prednisolone, 30 milligrams, once a day and take the doxycycline, 100 milligrams, once a day is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.7,
      "end_seconds": 394.03,
      "duration_seconds": 5.33,
      "text": "yes, exactly right i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.54,
      "end_seconds": 398.45,
      "duration_seconds": 2.91,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.98,
      "end_seconds": 400.16,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
