{
  "schema_version": "1.0",
  "encounter_id": "01229",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 7.32,
      "duration_seconds": 6.48,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.02,
      "end_seconds": 13.07,
      "duration_seconds": 4.05,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.86,
      "end_seconds": 18.24,
      "duration_seconds": 4.38,
      "text": "Well, I've been having headaches in the morning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.87,
      "end_seconds": 23.14,
      "duration_seconds": 3.27,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.62,
      "end_seconds": 33.54,
      "duration_seconds": 8.92,
      "text": "Sorry, what was I saying, it's been three days now. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.77,
      "end_seconds": 37.61,
      "duration_seconds": 3.84,
      "text": "Sure. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.44,
      "end_seconds": 40.23,
      "duration_seconds": 1.79,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.95,
      "end_seconds": 45.58,
      "duration_seconds": 4.63,
      "text": "What about a pounding in your ears, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.32,
      "end_seconds": 60.08,
      "duration_seconds": 12.76,
      "text": "Yeah, you know, I've had that since yesterday. Um, you know, with pounding in my ears, I'd call it mild. It happens all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.25,
      "end_seconds": 65.54,
      "duration_seconds": 4.29,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.53,
      "end_seconds": 72.38,
      "duration_seconds": 5.85,
      "text": "Hmm, I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.24,
      "end_seconds": 86.11,
      "duration_seconds": 12.87,
      "text": "Okay, go on. Right, so high blood pressure is already on your record. We'll keep that in mind today. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.6,
      "end_seconds": 92.42,
      "duration_seconds": 4.82,
      "text": "It's, It's telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.46,
      "end_seconds": 102.78,
      "duration_seconds": 4.32,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.09,
      "end_seconds": 110.29,
      "duration_seconds": 6.2,
      "text": "Actually, yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.62,
      "end_seconds": 114.44,
      "duration_seconds": 2.82,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.35,
      "end_seconds": 118.62,
      "duration_seconds": 3.27,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.31,
      "end_seconds": 121.52,
      "duration_seconds": 1.21,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.47,
      "end_seconds": 126.22,
      "duration_seconds": 2.75,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.64,
      "end_seconds": 148.71,
      "duration_seconds": 4.07,
      "text": "Any breathlessness, chest pain or visual changes at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.28,
      "end_seconds": 152.7,
      "duration_seconds": 2.42,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.5,
      "end_seconds": 158.53,
      "duration_seconds": 4.03,
      "text": "Right, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.31,
      "end_seconds": 164.65,
      "duration_seconds": 5.34,
      "text": "Ah, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 177.47,
      "end_seconds": 187.66,
      "duration_seconds": 10.19,
      "text": "Doctor, I've got the readings for you. Blood pressure 171 over 100, pulse is 82 beats a minute, SpO2 97 percent on room air. Respiratory rate 18."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.33,
      "end_seconds": 189.75,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.31,
      "end_seconds": 195.17,
      "duration_seconds": 2.86,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.76,
      "end_seconds": 211.23,
      "duration_seconds": 1.47,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.14,
      "end_seconds": 213.42,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.49,
      "end_seconds": 232.25,
      "duration_seconds": 5.76,
      "text": "Your heart sounds are normal and there is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.52,
      "end_seconds": 235.05,
      "duration_seconds": 1.53,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.92,
      "end_seconds": 239.48,
      "duration_seconds": 1.56,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 250.31,
      "end_seconds": 253.75,
      "duration_seconds": 3.44,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.84,
      "end_seconds": 261.96,
      "duration_seconds": 6.12,
      "text": "Good, thanks for doing that. Let's book kidney function blood tests to look into hypertension."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.9,
      "end_seconds": 265.02,
      "duration_seconds": 1.12,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.07,
      "end_seconds": 293.92,
      "duration_seconds": 27.85,
      "text": "You'll be taking amlodipine, 5 milligrams, once a day, long term. That should help with blood pressure. Cut down on salty foods and keep a home blood pressure diary. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. I'm not ordering a 24-hour blood pressure monitor today. If things carry on in two weeks, we'll consider it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.66,
      "end_seconds": 301.99,
      "duration_seconds": 6.33,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.75,
      "end_seconds": 304.95,
      "duration_seconds": 2.2,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.66,
      "end_seconds": 313.51,
      "duration_seconds": 6.85,
      "text": "See me again in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.57,
      "end_seconds": 317.74,
      "duration_seconds": 2.17,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.45,
      "end_seconds": 320.68,
      "duration_seconds": 1.23,
      "text": "See you soon."
    }
  ]
}