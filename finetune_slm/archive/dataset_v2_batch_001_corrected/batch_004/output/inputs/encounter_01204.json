{
  "schema_version": "1.0",
  "encounter_id": "01204",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.97,
      "duration_seconds": 4.88,
      "text": "Morning, um, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.77,
      "end_seconds": 12.01,
      "duration_seconds": 5.24,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.08,
      "end_seconds": 25.17,
      "duration_seconds": 11.09,
      "text": "I mean, I've been waking at night with wheeze, and I wanted to get it checked. I've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.76,
      "end_seconds": 29.1,
      "duration_seconds": 3.34,
      "text": "right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.21,
      "end_seconds": 33.02,
      "duration_seconds": 2.81,
      "text": "no I don't take any tablets"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.42,
      "end_seconds": 36.5,
      "duration_seconds": 2.08,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.1,
      "end_seconds": 40.65,
      "duration_seconds": 3.55,
      "text": "I've had it for about two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.47,
      "end_seconds": 44.17,
      "duration_seconds": 1.7,
      "text": "does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.08,
      "end_seconds": 48.92,
      "duration_seconds": 2.84,
      "text": "I get some relief from inhaler"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.94,
      "end_seconds": 53.83,
      "duration_seconds": 3.89,
      "text": "Right, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.68,
      "end_seconds": 59.11,
      "duration_seconds": 3.43,
      "text": "pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.4,
      "end_seconds": 64.19,
      "duration_seconds": 4.79,
      "text": "Yes. And what about fever leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.93,
      "end_seconds": 68.21,
      "duration_seconds": 3.28,
      "text": "no I haven't had any of them"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.57,
      "end_seconds": 74.17,
      "duration_seconds": 4.6,
      "text": "Have you noticed any weakness or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.38,
      "end_seconds": 77.28,
      "duration_seconds": 1.9,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.24,
      "end_seconds": 84.0,
      "duration_seconds": 2.76,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.27,
      "end_seconds": 87.31,
      "duration_seconds": 2.04,
      "text": "no that's been fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.42,
      "end_seconds": 91.85,
      "duration_seconds": 3.43,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.7,
      "end_seconds": 96.5,
      "duration_seconds": 3.8,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.89,
      "end_seconds": 100.86,
      "duration_seconds": 2.97,
      "text": "Alright, do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.45,
      "end_seconds": 105.25,
      "duration_seconds": 3.8,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.94,
      "end_seconds": 108.21,
      "duration_seconds": 2.27,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.24,
      "end_seconds": 115.17,
      "duration_seconds": 4.93,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.47,
      "end_seconds": 135.79,
      "duration_seconds": 4.32,
      "text": "what about your parents brothers or sisters any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.66,
      "end_seconds": 140.32,
      "duration_seconds": 2.66,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.57,
      "end_seconds": 152.41,
      "duration_seconds": 4.84,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.23,
      "end_seconds": 157.49,
      "duration_seconds": 3.26,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.86,
      "end_seconds": 176.31,
      "duration_seconds": 3.45,
      "text": "Any medical conditions anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.45,
      "end_seconds": 183.82,
      "duration_seconds": 3.37,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.88,
      "end_seconds": 187.81,
      "duration_seconds": 2.93,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.54,
      "end_seconds": 197.53,
      "duration_seconds": 1.99,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.12,
      "end_seconds": 228.19,
      "duration_seconds": 15.07,
      "text": "okay: temp 36.6 degrees, oxygen saturation is 98 percent, height 185 centimetres, weight 75 kilos, pulse 86, respiratory rate 18, pressure 122 over 74, BMI works out to 21.9."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.01,
      "end_seconds": 231.65,
      "duration_seconds": 1.64,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.25,
      "end_seconds": 234.82,
      "duration_seconds": 2.57,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.13,
      "end_seconds": 240.97,
      "duration_seconds": 4.84,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.14,
      "end_seconds": 243.85,
      "duration_seconds": 1.71,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.15,
      "end_seconds": 263.13,
      "duration_seconds": 4.98,
      "text": "there is a little wheeze at the end of each breath out"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.84,
      "end_seconds": 279.54,
      "duration_seconds": 10.7,
      "text": "You can relax now. Having listened and examined I don't have a clear answer today: poorly controlled asthma is possible and so is an inhaler technique problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.99,
      "end_seconds": 318.48,
      "duration_seconds": 28.49,
      "text": "we should do spirometry for asthma. A peak flow reading is what I'd like next, for asthma let's use beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term that should help with asthma control use the spacer and rinse your mouth after the preventer come back or go to emergency straight away if the symptoms get worse"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.6,
      "end_seconds": 321.46,
      "duration_seconds": 1.86,
      "text": "that's fine by me"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.53,
      "end_seconds": 328.83,
      "duration_seconds": 6.3,
      "text": "I'd like to see you again in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.39,
      "end_seconds": 332.43,
      "duration_seconds": 3.04,
      "text": "good thanks I'll see you then"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.76,
      "end_seconds": 335.17,
      "duration_seconds": 1.41,
      "text": "Goodbye for now."
    }
  ]
}