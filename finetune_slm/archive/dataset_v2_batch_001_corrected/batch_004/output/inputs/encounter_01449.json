{
  "schema_version": "1.0",
  "encounter_id": "01449",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.33,
      "end_seconds": 8.68,
      "duration_seconds": 7.35,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.99,
      "end_seconds": 13.83,
      "duration_seconds": 3.84,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.88,
      "end_seconds": 21.86,
      "duration_seconds": 6.98,
      "text": "Mainly a lingering cough. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 23.51,
      "end_seconds": 34.78,
      "duration_seconds": 11.27,
      "text": "Here are the numbers, doctor. SpO2 99 percent on room air, BP is 113 over 70, pulse is 81 beats a minute. Respiratory rate 18, temperature 37.0."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.43,
      "end_seconds": 43.65,
      "duration_seconds": 4.22,
      "text": "Okay, noted. How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 51.21,
      "duration_seconds": 5.59,
      "text": "Two days, I think... sorry, ten days, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.19,
      "end_seconds": 59.89,
      "duration_seconds": 7.7,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.49,
      "end_seconds": 69.44,
      "duration_seconds": 8.95,
      "text": "Severe, really. I notice it more with cold air and talking. I've also had a tickle in my throat."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.06,
      "end_seconds": 76.7,
      "duration_seconds": 5.64,
      "text": "Have you had a lingering cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.77,
      "end_seconds": 86.91,
      "duration_seconds": 8.14,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.97,
      "end_seconds": 103.55,
      "duration_seconds": 4.58,
      "text": "Have you noticed fever, shortness of breath or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.36,
      "end_seconds": 111.15,
      "duration_seconds": 5.79,
      "text": "I haven't had fever, shortness of breath or weight loss, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.36,
      "end_seconds": 114.31,
      "duration_seconds": 1.95,
      "text": "How about coughing up blood?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.39,
      "end_seconds": 118.68,
      "duration_seconds": 3.29,
      "text": "Not at all, no coughing up blood."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.77,
      "end_seconds": 123.48,
      "duration_seconds": 2.71,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.18,
      "end_seconds": 125.81,
      "duration_seconds": 1.63,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.4,
      "end_seconds": 129.74,
      "duration_seconds": 3.34,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.66,
      "end_seconds": 133.65,
      "duration_seconds": 1.99,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.06,
      "end_seconds": 138.11,
      "duration_seconds": 3.05,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.65,
      "end_seconds": 143.04,
      "duration_seconds": 3.39,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.8,
      "end_seconds": 147.14,
      "duration_seconds": 3.34,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.9,
      "end_seconds": 154.74,
      "duration_seconds": 5.84,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.5,
      "end_seconds": 161.44,
      "duration_seconds": 2.94,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.2,
      "end_seconds": 168.02,
      "duration_seconds": 4.82,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.27,
      "end_seconds": 171.71,
      "duration_seconds": 2.44,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.55,
      "end_seconds": 176.16,
      "duration_seconds": 2.61,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.08,
      "end_seconds": 179.64,
      "duration_seconds": 2.56,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.26,
      "end_seconds": 183.73,
      "duration_seconds": 3.47,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 189.23,
      "duration_seconds": 3.73,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.27,
      "end_seconds": 197.41,
      "duration_seconds": 6.14,
      "text": "I have epilepsy, for about ten years. I've got heart disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.35,
      "end_seconds": 204.21,
      "duration_seconds": 4.86,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.03,
      "end_seconds": 211.12,
      "duration_seconds": 3.09,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.0,
      "end_seconds": 216.55,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.44,
      "end_seconds": 230.7,
      "duration_seconds": 12.26,
      "text": "It's lamotrigine, 100 milligrams, twice a day. Clopidogrel, 75 milligrams, once a day. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.61,
      "end_seconds": 235.93,
      "duration_seconds": 2.32,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.91,
      "end_seconds": 239.34,
      "duration_seconds": 1.43,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 259.67,
      "duration_seconds": 4.35,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.66,
      "end_seconds": 275.73,
      "duration_seconds": 1.07,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.16,
      "end_seconds": 290.44,
      "duration_seconds": 12.28,
      "text": "You can sit up now. Having listened and examined, the most likely explanation is a post-viral cough that is settling. I can't rule out early asthma yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.22,
      "end_seconds": 309.53,
      "duration_seconds": 6.31,
      "text": "It should settle over the next two to three weeks; steam and honey can help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.02,
      "end_seconds": 313.57,
      "duration_seconds": 3.55,
      "text": "Mm, okay. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.41,
      "end_seconds": 317.77,
      "duration_seconds": 3.36,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.32,
      "end_seconds": 319.66,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
  ]
}