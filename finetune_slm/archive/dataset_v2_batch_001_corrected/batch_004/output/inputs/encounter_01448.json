{
  "schema_version": "1.0",
  "encounter_id": "01448",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 3.7,
      "duration_seconds": 2.95,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.52,
      "end_seconds": 10.59,
      "duration_seconds": 5.07,
      "text": "Okay, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.48,
      "end_seconds": 18.76,
      "duration_seconds": 6.28,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.03,
      "end_seconds": 21.82,
      "duration_seconds": 1.79,
      "text": "I've been feeling sick"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.75,
      "end_seconds": 25.93,
      "duration_seconds": 3.18,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.95,
      "end_seconds": 29.96,
      "duration_seconds": 2.01,
      "text": "about... well, one week"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.22,
      "end_seconds": 33.7,
      "duration_seconds": 2.48,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.58,
      "end_seconds": 36.4,
      "duration_seconds": 1.82,
      "text": "Severe, I'd say"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.08,
      "end_seconds": 39.81,
      "duration_seconds": 2.73,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.35,
      "end_seconds": 49.04,
      "duration_seconds": 8.69,
      "text": "When it starts I tend to get no appetite as well. The no appetite? That's been for five days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.98,
      "end_seconds": 52.51,
      "duration_seconds": 2.53,
      "text": "Any urinary symptoms, cough or diarrhoea?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.24,
      "end_seconds": 56.97,
      "duration_seconds": 3.73,
      "text": "No, um, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.52,
      "end_seconds": 61.9,
      "duration_seconds": 4.38,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.82,
      "end_seconds": 66.0,
      "duration_seconds": 2.18,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.61,
      "end_seconds": 68.99,
      "duration_seconds": 2.38,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.77,
      "end_seconds": 72.39,
      "duration_seconds": 1.62,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.72,
      "end_seconds": 81.02,
      "duration_seconds": 4.3,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.84,
      "end_seconds": 102.93,
      "duration_seconds": 21.09,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.02,
      "end_seconds": 107.37,
      "duration_seconds": 2.35,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.08,
      "end_seconds": 117.03,
      "duration_seconds": 7.95,
      "text": "I'm on bisoprolol, 2.5 milligrams, once a day. It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.86,
      "end_seconds": 122.09,
      "duration_seconds": 4.23,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.5,
      "end_seconds": 127.32,
      "duration_seconds": 3.82,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.93,
      "end_seconds": 149.25,
      "duration_seconds": 3.32,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.17,
      "end_seconds": 152.46,
      "duration_seconds": 2.29,
      "text": "I've got an irregular heartbeat"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.34,
      "end_seconds": 154.74,
      "duration_seconds": 1.4,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.11,
      "end_seconds": 159.02,
      "duration_seconds": 2.91,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.58,
      "end_seconds": 163.24,
      "duration_seconds": 3.66,
      "text": "Yes, carry on. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.58,
      "end_seconds": 173.29,
      "duration_seconds": 6.71,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.81,
      "end_seconds": 189.4,
      "duration_seconds": 3.59,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.86,
      "end_seconds": 192.92,
      "duration_seconds": 2.06,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.41,
      "end_seconds": 209.86,
      "duration_seconds": 3.45,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.86,
      "end_seconds": 225.21,
      "duration_seconds": 2.35,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.44,
      "end_seconds": 257.91,
      "duration_seconds": 12.47,
      "text": "okay: temperature is 38.5 degrees, pressure 108 over 76. And pulse is 102 beats a minute, respiratory rate 21, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.48,
      "end_seconds": 264.31,
      "duration_seconds": 3.83,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.06,
      "end_seconds": 267.34,
      "duration_seconds": 1.28,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.19,
      "end_seconds": 292.27,
      "duration_seconds": 7.08,
      "text": "It hurts most low on the right and it hurts when I let go of the pressure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.98,
      "end_seconds": 308.88,
      "duration_seconds": 12.9,
      "text": "thank you, you can get dressed right, here's what I'm thinking i'm honestly not certain yet it could be possible appendicitis, or it might be a urine infection"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.45,
      "end_seconds": 314.12,
      "duration_seconds": 4.67,
      "text": "Okay, so I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.46,
      "end_seconds": 338.15,
      "duration_seconds": 22.69,
      "text": "I can't promise yet, but most people with possible appendicitis do well once it's treated properly. I'd like to arrange an ultrasound or CT scan for possible appendicitis. I'd rather check than guess, and this is the quickest way to know more. I'd like to arrange urgent blood tests for abdominal pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.97,
      "end_seconds": 341.7,
      "duration_seconds": 2.73,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.01,
      "end_seconds": 359.05,
      "duration_seconds": 16.04,
      "text": "You need to go to hospital now and not eat or drink. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.9,
      "end_seconds": 362.95,
      "duration_seconds": 2.05,
      "text": "Alright, thanks, take care."
    }
  ]
}