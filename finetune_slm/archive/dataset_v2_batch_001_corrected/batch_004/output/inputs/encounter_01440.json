  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 5.46,
      "duration_seconds": 4.58,
      "text": "Right then, come on in. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.43,
      "end_seconds": 15.4,
      "duration_seconds": 4.97,
      "text": "I wanted to get dry gritty eyes looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 24.48,
      "duration_seconds": 3.79,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.29,
      "end_seconds": 27.84,
      "duration_seconds": 1.55,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.81,
      "end_seconds": 31.48,
      "duration_seconds": 1.67,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.88,
      "end_seconds": 42.14,
      "duration_seconds": 9.26,
      "text": "It's worse with screens and air conditioning. And there's tired eyes by evening as well, three days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.76,
      "end_seconds": 61.82,
      "duration_seconds": 3.06,
      "text": "And And redness, any of that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.47,
      "end_seconds": 63.92,
      "duration_seconds": 1.45,
      "text": "Definitely no redness."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.42,
      "end_seconds": 69.23,
      "duration_seconds": 4.81,
      "text": "sure have you noticed loss of vision, light sensitivity or pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.72,
      "end_seconds": 72.81,
      "duration_seconds": 2.09,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.0,
      "end_seconds": 82.29,
      "duration_seconds": 3.29,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.28,
      "end_seconds": 87.21,
      "duration_seconds": 2.93,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.97,
      "end_seconds": 110.83,
      "duration_seconds": 4.86,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.87,
      "end_seconds": 114.16,
      "duration_seconds": 2.29,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.88,
      "end_seconds": 118.3,
      "duration_seconds": 2.42,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.14,
      "end_seconds": 123.47,
      "duration_seconds": 4.33,
      "text": "no, uh, I don't take any tablets"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.67,
      "end_seconds": 126.15,
      "duration_seconds": 1.48,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.2,
      "end_seconds": 129.37,
      "duration_seconds": 1.17,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.84,
      "end_seconds": 147.04,
      "duration_seconds": 5.2,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.97,
      "end_seconds": 165.29,
      "duration_seconds": 16.32,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. I walk the dog every morning. My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.36,
      "end_seconds": 170.21,
      "duration_seconds": 3.85,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.72,
      "end_seconds": 181.46,
      "duration_seconds": 10.74,
      "text": "I mean, yes, plasters. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.05,
      "end_seconds": 185.83,
      "duration_seconds": 2.78,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.19,
      "end_seconds": 197.4,
      "duration_seconds": 2.21,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.41,
      "end_seconds": 224.73,
      "duration_seconds": 12.32,
      "text": "Okay: respiratory rate 18, height 151 centimetres. And saturation 98 percent, weight 55 kilos, heart rate 69, BMI works out to 24.1, blood pressure 126 over 79."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.47,
      "end_seconds": 226.82,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.67,
      "end_seconds": 232.92,
      "duration_seconds": 4.25,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.63,
      "end_seconds": 239.66,
      "duration_seconds": 4.03,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.51,
      "end_seconds": 241.44,
      "duration_seconds": 0.93,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 246.37,
      "duration_seconds": 3.38,
      "text": "I'll listen to to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.82,
      "end_seconds": 262.77,
      "duration_seconds": 5.95,
      "text": "Your eyelids look slightly crusted but the white of the eye is clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.55,
      "end_seconds": 270.47,
      "duration_seconds": 1.92,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.76,
      "end_seconds": 291.33,
      "duration_seconds": 7.57,
      "text": "from what you've told me and and what I found, it fits best with dry eye disease"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.22,
      "end_seconds": 296.64,
      "duration_seconds": 3.42,
      "text": "Is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.97,
      "end_seconds": 315.88,
      "duration_seconds": 17.91,
      "text": "nothing I've seen today points to an emergency. It looks like dry eye disease, but I'd like to confirm. I think an eye test makes sense here, for eye strain. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.71,
      "end_seconds": 320.0,
      "duration_seconds": 2.29,
      "text": "thank you, doctor, goodbye"
    }
  ]
}