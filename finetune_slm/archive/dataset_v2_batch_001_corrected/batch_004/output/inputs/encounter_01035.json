    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.49,
      "end_seconds": 135.93,
      "duration_seconds": 3.44,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.53,
      "end_seconds": 140.35,
      "duration_seconds": 2.82,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.27,
      "end_seconds": 145.88,
      "duration_seconds": 4.61,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.84,
      "end_seconds": 160.89,
      "duration_seconds": 4.05,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.93,
      "end_seconds": 174.05,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.74,
      "end_seconds": 199.66,
      "duration_seconds": 14.92,
      "text": "Okay: pulse 84, blood pressure 119 over 82, temperature is 36.5 degrees. And BMI works out to 23.2, respiratory rate 16, height 181 centimetres, weight 76 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.05,
      "end_seconds": 202.51,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.98,
      "end_seconds": 207.28,
      "duration_seconds": 3.3,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.62,
      "end_seconds": 212.91,
      "duration_seconds": 4.29,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.33,
      "end_seconds": 216.32,
      "duration_seconds": 1.99,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.39,
      "end_seconds": 235.8,
      "duration_seconds": 2.41,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.12,
      "end_seconds": 238.13,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.92,
      "end_seconds": 262.03,
      "duration_seconds": 21.11,
      "text": "That's all I needed to check. From what you've told me and what I found, this is probably a healthy adult with no worrying findings. Let me just check I've got this right. You've had no real problems for five days, mild, and no chest pain or weight loss."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.85,
      "end_seconds": 263.55,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.08,
      "end_seconds": 285.5,
      "duration_seconds": 5.42,
      "text": "I want a fasting sugar test done, that's for routine check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.6,
      "end_seconds": 288.89,
      "duration_seconds": 2.29,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.61,
      "end_seconds": 300.91,
      "duration_seconds": 10.3,
      "text": "Keep up regular exercise and a balanced diet. Please don't wait if new symptoms appear. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.97,
      "end_seconds": 305.8,
      "duration_seconds": 2.83,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.46,
      "end_seconds": 309.69,
      "duration_seconds": 3.23,
      "text": "Please come and see me in twelve months."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.38,
      "end_seconds": 312.36,
      "duration_seconds": 1.98,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.3,
      "end_seconds": 319.47,
      "duration_seconds": 4.17,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.03,
      "end_seconds": 322.9,
      "duration_seconds": 2.87,
      "text": "No, that's all. Thanks a lot."
