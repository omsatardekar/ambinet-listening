    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.86,
      "end_seconds": 60.71,
      "duration_seconds": 3.85,
      "text": "Let me ask about allergies, anything at all?"
