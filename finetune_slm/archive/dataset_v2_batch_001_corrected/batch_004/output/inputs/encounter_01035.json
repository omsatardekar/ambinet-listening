      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.59,
      "end_seconds": 35.16,
      "duration_seconds": 4.57,
      "text": "Any chest pain, shortness of breath or weight loss at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.31,
      "end_seconds": 41.53,
      "duration_seconds": 5.22,
      "text": "No, no chest pain, shortness of breath or weight loss."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.04,
      "end_seconds": 45.14,
      "duration_seconds": 3.1,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.8,
      "end_seconds": 48.41,
      "duration_seconds": 1.61,
      "text": "No, nothing there."
