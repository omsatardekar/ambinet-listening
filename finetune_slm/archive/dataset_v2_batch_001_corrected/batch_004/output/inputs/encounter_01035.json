      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.65,
      "end_seconds": 22.6,
      "duration_seconds": 1.95,
      "text": "Probably five days. Yeah."
