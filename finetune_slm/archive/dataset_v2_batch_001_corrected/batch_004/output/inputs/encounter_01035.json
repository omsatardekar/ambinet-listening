      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.91,
      "end_seconds": 27.82,
      "duration_seconds": 3.91,
      "text": "Rate it for me, mild, moderate or severe?"
