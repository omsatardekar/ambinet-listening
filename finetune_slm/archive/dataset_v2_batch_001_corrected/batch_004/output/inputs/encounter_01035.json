    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.04,
      "end_seconds": 51.88,
      "duration_seconds": 2.84,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.64,
      "end_seconds": 55.44,
      "duration_seconds": 1.8,
      "text": "No, nothing there."
