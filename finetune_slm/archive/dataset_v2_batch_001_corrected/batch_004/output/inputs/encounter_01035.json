    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.37,
      "end_seconds": 64.8,
      "duration_seconds": 2.43,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.5,
      "end_seconds": 77.33,
      "duration_seconds": 2.83,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.21,
      "end_seconds": 81.81,
      "duration_seconds": 2.6,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 87.79,
      "duration_seconds": 3.89,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.99,
      "end_seconds": 92.79,
      "duration_seconds": 3.8,
      "text": "Hmm, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.5,
      "end_seconds": 99.13,
      "duration_seconds": 4.63,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.01,
      "end_seconds": 103.16,
      "duration_seconds": 3.15,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.03,
      "end_seconds": 123.18,
      "duration_seconds": 2.15,
      "text": "Alright, how are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.74,
      "end_seconds": 127.39,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.98,
      "end_seconds": 130.72,
      "duration_seconds": 2.74,
      "text": "What do you do during the day?"
