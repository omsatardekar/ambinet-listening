    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.25,
      "end_seconds": 19.49,
      "duration_seconds": 1.24,
      "text": "Since when exactly?"
