{
  "schema_version": "1.0",
  "encounter_id": "01108",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.26,
      "end_seconds": 5.68,
      "duration_seconds": 4.42,
      "text": "ready for you, doctor i'll stay in case you need anything"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 9.74,
      "duration_seconds": 3.04,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 20.21,
      "duration_seconds": 8.88,
      "text": "I wanted to get heartburn most days looked at. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.44,
      "end_seconds": 25.06,
      "duration_seconds": 3.62,
      "text": "So, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.49,
      "end_seconds": 28.91,
      "duration_seconds": 2.42,
      "text": "it's been three weeks now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.26,
      "end_seconds": 33.58,
      "duration_seconds": 3.32,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.21,
      "end_seconds": 44.19,
      "duration_seconds": 9.98,
      "text": "Let me think, antacids helps a bit. Erm, and there's food sticking sometimes as well, two months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.24,
      "end_seconds": 50.08,
      "duration_seconds": 4.84,
      "text": "So, what about a sour taste, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.68,
      "end_seconds": 51.83,
      "duration_seconds": 1.15,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.67,
      "end_seconds": 58.3,
      "duration_seconds": 5.63,
      "text": "have you had heartburn most days before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.66,
      "end_seconds": 66.87,
      "duration_seconds": 7.21,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.43,
      "end_seconds": 76.3,
      "duration_seconds": 8.87,
      "text": "doctor, I've got the readings for you blood pressure 118 over 71, oxygen saturation is 99 percent, pulse is 78 beats a minute"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.89,
      "end_seconds": 77.81,
      "duration_seconds": 0.92,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.61,
      "end_seconds": 85.3,
      "duration_seconds": 4.69,
      "text": "I'll examine you in a a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.04,
      "end_seconds": 87.7,
      "duration_seconds": 1.66,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.29,
      "end_seconds": 91.65,
      "duration_seconds": 2.36,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.75,
      "end_seconds": 103.68,
      "duration_seconds": 3.93,
      "text": "Your tummy is soft with mild tenderness at the top."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.34,
      "end_seconds": 108.09,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.88,
      "end_seconds": 126.91,
      "duration_seconds": 6.03,
      "text": "Right, any vomiting, black stools, chest pain on exertion or weight loss at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.05,
      "end_seconds": 131.86,
      "duration_seconds": 3.81,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.92,
      "end_seconds": 135.74,
      "duration_seconds": 1.82,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.45,
      "end_seconds": 141.5,
      "duration_seconds": 4.05,
      "text": "actually, um, no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.2,
      "end_seconds": 145.06,
      "duration_seconds": 2.86,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.47,
      "end_seconds": 150.81,
      "duration_seconds": 4.34,
      "text": "So, uh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.81,
      "end_seconds": 167.98,
      "duration_seconds": 3.17,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.32,
      "end_seconds": 172.26,
      "duration_seconds": 2.94,
      "text": "My grandfather had a a stroke."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.98,
      "end_seconds": 175.59,
      "duration_seconds": 2.61,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.13,
      "end_seconds": 181.98,
      "duration_seconds": 4.85,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.57,
      "end_seconds": 188.48,
      "duration_seconds": 4.91,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.18,
      "end_seconds": 206.76,
      "duration_seconds": 17.58,
      "text": "Nothing, I'm teetotal. I gave up cigarettes last spring. No, I share a house with my brother. I drink a lot of tea and snack through the day. I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.13,
      "end_seconds": 212.08,
      "duration_seconds": 3.95,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.71,
      "end_seconds": 216.11,
      "duration_seconds": 2.4,
      "text": "Yes, I'm allergic to walnuts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.1,
      "end_seconds": 220.31,
      "duration_seconds": 2.21,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.93,
      "end_seconds": 233.98,
      "duration_seconds": 12.05,
      "text": "it's omeprazole, 20 milligrams, once a day i mean, I'm on iron tablets, once a day i, I take antacid liquid, 10 ml, after meals"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.57,
      "end_seconds": 252.72,
      "duration_seconds": 4.15,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 254.74,
      "end_seconds": 259.07,
      "duration_seconds": 4.33,
      "text": "I've had acid reflux for five years now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.77,
      "end_seconds": 261.47,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.03,
      "end_seconds": 272.07,
      "duration_seconds": 9.04,
      "text": "Low haemoglobin, for two years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.59,
      "end_seconds": 280.89,
      "duration_seconds": 8.3,
      "text": "right, right putting it all together, it fits best with reflux with a swallowing symptom that needs a camera test"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.46,
      "end_seconds": 285.99,
      "duration_seconds": 3.53,
      "text": "Okay, so is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.47,
      "end_seconds": 311.42,
      "duration_seconds": 23.95,
      "text": "nothing I've seen today points to an emergency it looks like reflux with a swallowing symptom that needs a camera test, but I'd like to confirm we should do a blood count for reflux we should do an endoscopy for dysphagia and reflux that will help us see what's going on underneath and decide the next step"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 313.09,
      "end_seconds": 314.34,
      "duration_seconds": 1.25,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.58,
      "end_seconds": 320.04,
      "duration_seconds": 4.46,
      "text": "Eat smaller meals and avoid eating for three hours before bed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.24,
      "end_seconds": 324.78,
      "duration_seconds": 4.54,
      "text": "yes. Do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.79,
      "end_seconds": 327.55,
      "duration_seconds": 1.76,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.3,
      "end_seconds": 338.73,
      "duration_seconds": 9.43,
      "text": "I'd like you back after the endoscopy. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 339.76,
      "end_seconds": 344.67,
      "duration_seconds": 4.91,
      "text": "So, I come back after the endoscopy. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.37,
      "end_seconds": 355.44,
      "duration_seconds": 6.07,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 357.45,
      "end_seconds": 361.57,
      "duration_seconds": 4.12,
      "text": "Good, uh, thanks, I'll see you then."
    }
  ]
}