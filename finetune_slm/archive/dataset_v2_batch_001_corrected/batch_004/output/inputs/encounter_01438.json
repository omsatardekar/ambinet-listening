{
  "schema_version": "1.0",
  "encounter_id": "01438",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 5.91,
      "duration_seconds": 5.21,
      "text": "Right, thanks for waiting, come in. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.15,
      "end_seconds": 37.26,
      "duration_seconds": 30.11,
      "text": "Okay, so so the thing is, I've got light vaginal bleeding. I've never really been one for hospitals. Oh, and sharp pain low on one side. With sharp pain low on one side, it sort of comes and goes. And I've been feeling faint as well. I had shoulder tip pain before. That's settled now, though."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 37.84,
      "end_seconds": 46.04,
      "duration_seconds": 8.2,
      "text": "Here are the the numbers, doctor. BP is 138 over 76, heart rate 115, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.73,
      "end_seconds": 47.66,
      "duration_seconds": 0.93,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.33,
      "end_seconds": 53.64,
      "duration_seconds": 4.31,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.93,
      "end_seconds": 58.5,
      "duration_seconds": 1.57,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.55,
      "end_seconds": 61.28,
      "duration_seconds": 1.73,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.26,
      "end_seconds": 81.41,
      "duration_seconds": 5.15,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.29,
      "end_seconds": 85.88,
      "duration_seconds": 1.59,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.35,
      "end_seconds": 101.34,
      "duration_seconds": 2.99,
      "text": "and what about vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.43,
      "end_seconds": 108.19,
      "duration_seconds": 3.76,
      "text": "um, no, none of those at all"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.82,
      "end_seconds": 113.5,
      "duration_seconds": 3.68,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.62,
      "end_seconds": 121.46,
      "duration_seconds": 3.84,
      "text": "Um, uh, no, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.84,
      "end_seconds": 124.3,
      "duration_seconds": 1.46,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.19,
      "end_seconds": 130.11,
      "duration_seconds": 3.92,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.78,
      "end_seconds": 134.61,
      "duration_seconds": 3.83,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.29,
      "end_seconds": 138.92,
      "duration_seconds": 3.63,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.37,
      "end_seconds": 143.15,
      "duration_seconds": 2.78,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.69,
      "end_seconds": 145.5,
      "duration_seconds": 1.81,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.11,
      "end_seconds": 146.94,
      "duration_seconds": 0.83,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.85,
      "end_seconds": 152.31,
      "duration_seconds": 3.46,
      "text": "High cholesterol, for nearly five years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.79,
      "end_seconds": 161.7,
      "duration_seconds": 7.91,
      "text": "Right, so heart disease and high cholesterol are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.83,
      "end_seconds": 173.34,
      "duration_seconds": 3.51,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.22,
      "end_seconds": 190.44,
      "duration_seconds": 15.22,
      "text": "Uh, I take aspirin, 75 milligrams, once a day. Though honestly, uh, some days I forget to take it. I take rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.97,
      "end_seconds": 195.77,
      "duration_seconds": 3.8,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.45,
      "end_seconds": 203.56,
      "duration_seconds": 6.11,
      "text": "Erm, my aunt has rheumatoid arthritis. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.25,
      "end_seconds": 224.73,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.37,
      "end_seconds": 230.15,
      "duration_seconds": 3.78,
      "text": "Naproxen. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 241.95,
      "duration_seconds": 10.49,
      "text": "So, based on the history and the examination, I'd lean towards a possible ectopic pregnancy. We shouldn't forget a ruptured ovarian cyst."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 243.39,
      "end_seconds": 247.77,
      "duration_seconds": 4.38,
      "text": "I've already done a pregnancy test, it's ready for you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.95,
      "end_seconds": 258.1,
      "duration_seconds": 7.15,
      "text": "Thanks, I'll have a look. I'd like to arrange an urgent pelvic scan for possible ectopic."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.12,
      "end_seconds": 266.4,
      "duration_seconds": 2.28,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.44,
      "end_seconds": 290.24,
      "duration_seconds": 21.8,
      "text": "You need to go to the hospital now for an emergency scan. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'd like you to see the gynaecology team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.35,
      "end_seconds": 294.0,
      "duration_seconds": 2.65,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.76,
      "end_seconds": 298.82,
      "duration_seconds": 2.06,
      "text": "book a review straight away"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.62,
      "end_seconds": 302.71,
      "duration_seconds": 2.09,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.25,
      "end_seconds": 312.45,
      "duration_seconds": 5.2,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.7,
      "end_seconds": 317.09,
      "duration_seconds": 3.39,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.95,
      "end_seconds": 320.22,
      "duration_seconds": 1.27,
      "text": "see you soon"
    }
  ]
}