{
  "schema_version": "1.0",
  "encounter_id": "01058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 2.99,
      "duration_seconds": 1.88,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.45,
      "end_seconds": 9.01,
      "duration_seconds": 4.56,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.46,
      "end_seconds": 13.21,
      "duration_seconds": 2.75,
      "text": "It's an irregular heartbeat, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.14,
      "end_seconds": 17.69,
      "duration_seconds": 3.55,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.34,
      "end_seconds": 25.16,
      "duration_seconds": 5.82,
      "text": "ah, I'm on warfarin, in the evening for the blood thinning"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.9,
      "end_seconds": 27.99,
      "duration_seconds": 2.09,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.4,
      "end_seconds": 41.03,
      "duration_seconds": 11.63,
      "text": "3 milligrams, I think that's what's on the box. Okay, um, so I take metoprolol, 50 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.06,
      "end_seconds": 54.9,
      "duration_seconds": 2.84,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.19,
      "end_seconds": 58.76,
      "duration_seconds": 2.57,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.64,
      "end_seconds": 63.7,
      "duration_seconds": 3.06,
      "text": "Right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.54,
      "end_seconds": 73.71,
      "duration_seconds": 9.17,
      "text": "When it starts I tend to get being short of breath on slopes as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.53,
      "end_seconds": 78.29,
      "duration_seconds": 2.76,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.14,
      "end_seconds": 87.09,
      "duration_seconds": 3.95,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.28,
      "end_seconds": 92.97,
      "duration_seconds": 4.69,
      "text": "let me check a few things any chest pain or black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.5,
      "end_seconds": 97.55,
      "duration_seconds": 3.05,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.97,
      "end_seconds": 102.33,
      "duration_seconds": 3.36,
      "text": "a few quick ones: nosebleeds or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.36,
      "end_seconds": 107.57,
      "duration_seconds": 4.21,
      "text": "So, I haven't had nosebleeds or fainting, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.67,
      "end_seconds": 113.08,
      "duration_seconds": 3.41,
      "text": "Okay, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.99,
      "end_seconds": 115.46,
      "duration_seconds": 1.47,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.45,
      "end_seconds": 120.63,
      "duration_seconds": 3.18,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.44,
      "end_seconds": 123.52,
      "duration_seconds": 1.08,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.5,
      "end_seconds": 129.64,
      "duration_seconds": 5.14,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.82,
      "end_seconds": 142.71,
      "duration_seconds": 11.89,
      "text": "No, I share a house with my brother. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.61,
      "end_seconds": 158.42,
      "duration_seconds": 2.81,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 164.08,
      "duration_seconds": 5.11,
      "text": "I've got an irregular heartbeat. I've got heart disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 168.54,
      "duration_seconds": 3.61,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.34,
      "end_seconds": 174.83,
      "duration_seconds": 5.49,
      "text": "no, uh, nothing as far as I know"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.21,
      "end_seconds": 178.97,
      "duration_seconds": 2.76,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.23,
      "end_seconds": 187.49,
      "duration_seconds": 7.26,
      "text": "Ah, you know, yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.37,
      "end_seconds": 193.63,
      "duration_seconds": 4.26,
      "text": "Shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.95,
      "end_seconds": 209.29,
      "duration_seconds": 2.34,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.87,
      "end_seconds": 236.76,
      "duration_seconds": 6.89,
      "text": "Okay: oxygen saturation is 99 percent, temperature 36.7. And pulse 107, blood pressure 117 over 75."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.24,
      "end_seconds": 243.16,
      "duration_seconds": 3.92,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.81,
      "end_seconds": 246.01,
      "duration_seconds": 1.2,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.76,
      "end_seconds": 269.26,
      "duration_seconds": 5.5,
      "text": "your pulse is irregular and and your heart sounds are otherwise normal"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.86,
      "end_seconds": 273.98,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.65,
      "end_seconds": 306.89,
      "duration_seconds": 17.24,
      "text": "From what you've told me and what I found, it's hard to say. Atrial fibrillation, rate reasonably controlled is one possibility and anaemia from bleeding another, and I'd rather not commit yet. Let's book a full blood count to look into anticoagulant review."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.54,
      "end_seconds": 310.0,
      "duration_seconds": 1.46,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.6,
      "end_seconds": 338.01,
      "duration_seconds": 27.41,
      "text": "An ECG is what I'd like next, for irregular pulse. Never skip the blood thinner, and tell any dentist or surgeon you take it. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Let's plan a check in three months. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.61,
      "end_seconds": 341.85,
      "duration_seconds": 3.24,
      "text": "Oh, alright, thanks, take care."
    }
  ]
}