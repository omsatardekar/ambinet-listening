{
  "schema_version": "1.0",
  "encounter_id": "01258",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.06,
      "duration_seconds": 3.69,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 11.47,
      "duration_seconds": 4.55,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.24,
      "end_seconds": 18.39,
      "duration_seconds": 5.15,
      "text": "I, I wanted to get a high fever looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 24.77,
      "duration_seconds": 5.57,
      "text": "Did it come on recently? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 29.12,
      "duration_seconds": 3.24,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.7,
      "end_seconds": 32.44,
      "duration_seconds": 2.74,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.92,
      "end_seconds": 44.34,
      "duration_seconds": 10.42,
      "text": "It happens every other day. Pain much worse than it looks was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.23,
      "end_seconds": 49.29,
      "duration_seconds": 3.06,
      "text": "And what about insect bite or cut?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.26,
      "end_seconds": 53.56,
      "duration_seconds": 3.3,
      "text": "No, no insect bite or cut."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.08,
      "end_seconds": 57.31,
      "duration_seconds": 2.23,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.31,
      "end_seconds": 59.79,
      "duration_seconds": 1.48,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.85,
      "end_seconds": 64.86,
      "duration_seconds": 3.01,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.59,
      "end_seconds": 67.74,
      "duration_seconds": 2.15,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.84,
      "end_seconds": 72.56,
      "duration_seconds": 3.72,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.37,
      "end_seconds": 78.11,
      "duration_seconds": 4.74,
      "text": "Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.8,
      "end_seconds": 95.68,
      "duration_seconds": 2.88,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.51,
      "end_seconds": 100.92,
      "duration_seconds": 3.41,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.02,
      "end_seconds": 107.66,
      "duration_seconds": 4.64,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.7,
      "end_seconds": 112.14,
      "duration_seconds": 3.44,
      "text": "Yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.11,
      "end_seconds": 121.52,
      "duration_seconds": 4.41,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.89,
      "end_seconds": 138.9,
      "duration_seconds": 14.01,
      "text": "I've never touched a cigarette. I'm vegetarian and have been for years. I'm a hairdresser, on my feet all day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.75,
      "end_seconds": 144.44,
      "duration_seconds": 3.69,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.58,
      "end_seconds": 147.76,
      "duration_seconds": 2.18,
      "text": "Diabetes, for two years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.68,
      "end_seconds": 152.39,
      "duration_seconds": 3.71,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.87,
      "end_seconds": 168.39,
      "duration_seconds": 2.52,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.01,
      "end_seconds": 196.54,
      "duration_seconds": 6.53,
      "text": "Okay: temperature 38.1, pulse is 92 beats a minute, BP is 113 over 76."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.35,
      "end_seconds": 198.74,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.43,
      "end_seconds": 202.1,
      "duration_seconds": 2.67,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.21,
      "end_seconds": 207.05,
      "duration_seconds": 3.84,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.32,
      "end_seconds": 211.88,
      "duration_seconds": 3.56,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.11,
      "end_seconds": 228.19,
      "duration_seconds": 7.08,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.15,
      "end_seconds": 235.59,
      "duration_seconds": 2.44,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.91,
      "end_seconds": 256.59,
      "duration_seconds": 8.68,
      "text": "Taking everything into account, I'd lean towards a severe deep skin infection needing urgent surgery review. We shouldn't forget severe cellulitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.39,
      "end_seconds": 260.39,
      "duration_seconds": 3.0,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.26,
      "end_seconds": 278.09,
      "duration_seconds": 16.83,
      "text": "Nothing I've seen today points to an emergency. It looks like a severe deep skin infection needing urgent surgery review, but I'd like to confirm. I think urgent blood tests makes sense here, for severe skin infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 279.99,
      "end_seconds": 283.78,
      "duration_seconds": 3.79,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.87,
      "end_seconds": 286.78,
      "duration_seconds": 0.91,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.24,
      "end_seconds": 305.43,
      "duration_seconds": 17.19,
      "text": "Let's book an urgent surgical review to look into possible necrotising infection. I am sending you to hospital now, do not wait. I'd like you to see the surgical team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.74,
      "end_seconds": 307.44,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.16,
      "end_seconds": 324.32,
      "duration_seconds": 15.16,
      "text": "One warning sign to remember: you cannot go now. In that case don't wait. I'd like to see you again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.24,
      "end_seconds": 328.31,
      "duration_seconds": 2.07,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}