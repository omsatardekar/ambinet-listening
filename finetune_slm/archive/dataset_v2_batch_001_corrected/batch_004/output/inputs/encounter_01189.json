{
  "schema_version": "1.0",
  "encounter_id": "01189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.5,
      "duration_seconds": 3.95,
      "text": "Right, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.49,
      "end_seconds": 11.31,
      "duration_seconds": 4.82,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.19,
      "end_seconds": 16.22,
      "duration_seconds": 4.03,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.62,
      "end_seconds": 23.73,
      "duration_seconds": 6.11,
      "text": "I wanted to get an itchy patch on my wrist looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.56,
      "end_seconds": 26.03,
      "duration_seconds": 1.47,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.21,
      "end_seconds": 32.29,
      "duration_seconds": 5.08,
      "text": "Okay, so it's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.36,
      "end_seconds": 36.86,
      "duration_seconds": 2.5,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.65,
      "end_seconds": 40.76,
      "duration_seconds": 2.11,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.3,
      "end_seconds": 47.56,
      "duration_seconds": 3.26,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.05,
      "end_seconds": 56.11,
      "duration_seconds": 6.06,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.09,
      "end_seconds": 64.11,
      "duration_seconds": 6.02,
      "text": "So, take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.91,
      "end_seconds": 86.15,
      "duration_seconds": 21.24,
      "text": "Maybe a three out of ten on a bad day. As for bit of redness, I honestly can't say when that began. It might have been last month or the month before. Dry flaky skin was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 87.21,
      "end_seconds": 91.42,
      "duration_seconds": 4.21,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.95,
      "end_seconds": 95.45,
      "duration_seconds": 3.5,
      "text": "Any spreading, fever or blisters at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.29,
      "end_seconds": 99.41,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.63,
      "end_seconds": 102.16,
      "duration_seconds": 1.53,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.37,
      "end_seconds": 104.94,
      "duration_seconds": 1.57,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.72,
      "end_seconds": 111.18,
      "duration_seconds": 4.46,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.94,
      "end_seconds": 128.62,
      "duration_seconds": 16.68,
      "text": "I, I have an irregular heartbeat, for about ten years. Yeah, I've had high blood pressure for about ten years now. Arthritis in my knees, for five years. High cholesterol, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.57,
      "end_seconds": 139.31,
      "duration_seconds": 8.74,
      "text": "Mm-hmm. Okay, I can see an irregular heartbeat in your file as well. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.0,
      "end_seconds": 144.37,
      "duration_seconds": 4.37,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.89,
      "end_seconds": 149.88,
      "duration_seconds": 3.99,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.76,
      "end_seconds": 156.11,
      "duration_seconds": 5.35,
      "text": "My uncle has high cholesterol. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.54,
      "end_seconds": 178.62,
      "duration_seconds": 4.08,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.48,
      "end_seconds": 190.95,
      "duration_seconds": 10.47,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.14,
      "end_seconds": 207.09,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.04,
      "end_seconds": 217.5,
      "duration_seconds": 9.46,
      "text": "Paracetamol, 650 milligrams, when needed. Atorvastatin. I take it 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.76,
      "end_seconds": 222.72,
      "duration_seconds": 3.96,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.67,
      "end_seconds": 233.85,
      "duration_seconds": 9.18,
      "text": "Not with me. I'll bring it next time. A plain moisturiser. I take it twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.59,
      "end_seconds": 236.92,
      "duration_seconds": 2.33,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.32,
      "end_seconds": 246.88,
      "duration_seconds": 2.56,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.5,
      "end_seconds": 265.02,
      "duration_seconds": 4.52,
      "text": "Okay: BP is 126 over 78, heart rate 80."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.74,
      "end_seconds": 270.07,
      "duration_seconds": 3.33,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.46,
      "end_seconds": 272.93,
      "duration_seconds": 1.47,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.39,
      "end_seconds": 289.54,
      "duration_seconds": 6.15,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.28,
      "end_seconds": 332.03,
      "duration_seconds": 36.75,
      "text": "Okay, that's enough for me. Okay, thinking it through, it's hard to say. Mild contact dermatitis from the watch strap is one possibility and eczema another, and I'd rather not commit yet. The treatment will be hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.19,
      "end_seconds": 340.06,
      "duration_seconds": 6.87,
      "text": "Please don't wait if it spreads or blisters. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.01,
      "end_seconds": 344.95,
      "duration_seconds": 3.94,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.44,
      "end_seconds": 351.78,
      "duration_seconds": 5.34,
      "text": "I'll want another look if it has not cleared in two weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 353.71,
      "end_seconds": 356.94,
      "duration_seconds": 3.23,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.33,
      "end_seconds": 361.26,
      "duration_seconds": 2.93,
      "text": "Yeah, that's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.63,
      "end_seconds": 371.15,
      "duration_seconds": 3.52,
      "text": "So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.04,
      "end_seconds": 376.15,
      "duration_seconds": 3.11,
      "text": "I think I understand everything. Thanks."
    }
  ]
}