{
  "schema_version": "1.0",
  "encounter_id": "01427",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.78,
      "duration_seconds": 4.4,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.48,
      "duration_seconds": 4.12,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 21.49,
      "duration_seconds": 9.81,
      "text": "So the thing is, I've got an itchy patch on my wrist. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.5,
      "end_seconds": 26.36,
      "duration_seconds": 2.86,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.95,
      "end_seconds": 41.25,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 62.49,
      "duration_seconds": 7.44,
      "text": "Okay: pressure 126 over 81, temperature 36.7, heart rate 80. And SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.19,
      "end_seconds": 65.8,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.42,
      "end_seconds": 70.36,
      "duration_seconds": 3.94,
      "text": "We'll look at it together shortly. When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.93,
      "end_seconds": 75.9,
      "duration_seconds": 3.97,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.21,
      "end_seconds": 80.52,
      "duration_seconds": 3.31,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.97,
      "end_seconds": 84.55,
      "duration_seconds": 2.58,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.58,
      "end_seconds": 91.16,
      "duration_seconds": 5.58,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.24,
      "end_seconds": 95.59,
      "duration_seconds": 2.35,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.03,
      "end_seconds": 99.26,
      "duration_seconds": 2.23,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.27,
      "end_seconds": 113.46,
      "duration_seconds": 12.19,
      "text": "Moisturiser helps a bit. Oh, and a bit of redness. That's been about the same, about a week. I've also had dry flaky skin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.33,
      "end_seconds": 130.49,
      "duration_seconds": 3.16,
      "text": "Did you get fever, spreading or blisters?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.28,
      "end_seconds": 135.42,
      "duration_seconds": 4.14,
      "text": "I haven't had fever, spreading or blisters, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.31,
      "end_seconds": 140.64,
      "duration_seconds": 3.33,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.85,
      "end_seconds": 144.24,
      "duration_seconds": 2.39,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.3,
      "end_seconds": 148.92,
      "duration_seconds": 3.62,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.23,
      "end_seconds": 152.58,
      "duration_seconds": 2.35,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.85,
      "end_seconds": 157.42,
      "duration_seconds": 2.57,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.92,
      "end_seconds": 162.18,
      "duration_seconds": 3.26,
      "text": "It's a plain moisturiser, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.76,
      "end_seconds": 166.53,
      "duration_seconds": 2.77,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.18,
      "end_seconds": 174.25,
      "duration_seconds": 6.07,
      "text": "Well, I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.29,
      "end_seconds": 195.57,
      "duration_seconds": 3.28,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.11,
      "end_seconds": 197.8,
      "duration_seconds": 1.69,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 201.82,
      "duration_seconds": 3.31,
      "text": "Okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.64,
      "end_seconds": 204.15,
      "duration_seconds": 1.51,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 212.74,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.77,
      "end_seconds": 219.08,
      "duration_seconds": 4.31,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.81,
      "end_seconds": 224.07,
      "duration_seconds": 3.26,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.14,
      "end_seconds": 227.83,
      "duration_seconds": 2.69,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.77,
      "end_seconds": 230.84,
      "duration_seconds": 2.07,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.63,
      "end_seconds": 235.82,
      "duration_seconds": 4.19,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.33,
      "end_seconds": 240.71,
      "duration_seconds": 2.38,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.77,
      "end_seconds": 242.81,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.07,
      "end_seconds": 246.51,
      "duration_seconds": 2.44,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.93,
      "end_seconds": 267.67,
      "duration_seconds": 6.74,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.88,
      "end_seconds": 289.66,
      "duration_seconds": 17.78,
      "text": "Good, you can sit up again. So where does that leave us? My working impression is mild contact dermatitis from the watch strap. I'm prescribing hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.78,
      "end_seconds": 293.65,
      "duration_seconds": 2.87,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.61,
      "end_seconds": 312.63,
      "duration_seconds": 17.02,
      "text": "Stop wearing that strap and keep the skin moisturised. One warning sign to remember: it spreads or blisters. In that case don't wait. Please come and see me if it has not cleared in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.65,
      "end_seconds": 316.86,
      "duration_seconds": 2.21,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.78,
      "end_seconds": 323.95,
      "duration_seconds": 5.17,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.04,
      "end_seconds": 338.74,
      "duration_seconds": 11.7,
      "text": "So, I take the hydrocortisone cream, 1%, once a day and come back if it has not cleared in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.17,
      "end_seconds": 343.81,
      "duration_seconds": 3.64,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.55,
      "end_seconds": 348.66,
      "duration_seconds": 3.11,
      "text": "So, alright, thanks, take care."
    }
  ]
}