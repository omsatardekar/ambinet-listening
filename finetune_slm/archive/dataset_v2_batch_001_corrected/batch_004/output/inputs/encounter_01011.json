{
  "schema_version": "1.0",
  "encounter_id": "01011",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 4.98,
      "duration_seconds": 3.85,
      "text": "So, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 11.0,
      "duration_seconds": 4.05,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.74,
      "end_seconds": 16.1,
      "duration_seconds": 3.36,
      "text": "Well, I've been having hard stools."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 21.42,
      "duration_seconds": 3.53,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.75,
      "end_seconds": 36.94,
      "duration_seconds": 2.19,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.47,
      "end_seconds": 63.61,
      "duration_seconds": 11.14,
      "text": "Okay: saturation 98 percent, pulse 65. And temp 36.8 degrees, blood pressure 115 over 72. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.86,
      "end_seconds": 70.24,
      "duration_seconds": 1.38,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.8,
      "end_seconds": 74.04,
      "duration_seconds": 2.24,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.31,
      "end_seconds": 78.49,
      "duration_seconds": 3.18,
      "text": "I notice it more with low fibre."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.39,
      "end_seconds": 84.79,
      "duration_seconds": 4.4,
      "text": "So, what do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.3,
      "end_seconds": 96.6,
      "duration_seconds": 10.3,
      "text": "Only water, and it's not much. I did have mild bloating at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.35,
      "end_seconds": 103.91,
      "duration_seconds": 5.56,
      "text": "Okay, have you had hard stools before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.91,
      "end_seconds": 110.73,
      "duration_seconds": 5.82,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.88,
      "end_seconds": 127.38,
      "duration_seconds": 4.5,
      "text": "Any blood in the stool or severe pain at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.41,
      "end_seconds": 135.84,
      "duration_seconds": 5.43,
      "text": "I haven't had blood in the stool or severe pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.12,
      "end_seconds": 140.08,
      "duration_seconds": 2.96,
      "text": "Any vomiting or weight loss at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.01,
      "end_seconds": 146.23,
      "duration_seconds": 5.22,
      "text": "Ah, um, no vomiting or weight loss, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.15,
      "end_seconds": 150.73,
      "duration_seconds": 2.58,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.6,
      "end_seconds": 157.67,
      "duration_seconds": 6.07,
      "text": "Sorry, uh, what was I saying, no, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.42,
      "end_seconds": 162.01,
      "duration_seconds": 2.59,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.55,
      "end_seconds": 164.05,
      "duration_seconds": 1.5,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.19,
      "end_seconds": 181.53,
      "duration_seconds": 5.34,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.21,
      "end_seconds": 183.7,
      "duration_seconds": 1.49,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.52,
      "end_seconds": 198.24,
      "duration_seconds": 2.72,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.69,
      "end_seconds": 203.49,
      "duration_seconds": 3.8,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.24,
      "end_seconds": 208.12,
      "duration_seconds": 2.88,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.69,
      "end_seconds": 212.18,
      "duration_seconds": 3.49,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.93,
      "end_seconds": 216.48,
      "duration_seconds": 3.55,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.57,
      "end_seconds": 220.86,
      "duration_seconds": 2.29,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.4,
      "end_seconds": 225.65,
      "duration_seconds": 4.25,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.8,
      "end_seconds": 234.16,
      "duration_seconds": 3.36,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.52,
      "end_seconds": 237.38,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.89,
      "end_seconds": 242.21,
      "duration_seconds": 3.32,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.26,
      "end_seconds": 246.33,
      "duration_seconds": 2.07,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.49,
      "end_seconds": 249.87,
      "duration_seconds": 2.38,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.7,
      "end_seconds": 261.07,
      "duration_seconds": 3.37,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.26,
      "end_seconds": 263.94,
      "duration_seconds": 1.68,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.03,
      "end_seconds": 275.94,
      "duration_seconds": 8.91,
      "text": "You can relax now. So where does that leave us? The most likely explanation is simple constipation from low fibre."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.29,
      "end_seconds": 281.0,
      "duration_seconds": 3.71,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.84,
      "end_seconds": 309.08,
      "duration_seconds": 26.24,
      "text": "I understand the worry. At the moment I'd say it's simple constipation from low fibre, and we'll watch how it goes. I'm prescribing lactulose, 15 ml, twice a day, two weeks. You take it by mouth. That's for constipation. Eat more fruit, vegetables and oats, and drink two litres of water. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.22,
      "end_seconds": 311.57,
      "duration_seconds": 1.35,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.13,
      "end_seconds": 317.11,
      "duration_seconds": 4.98,
      "text": "Please come and see me if it persists after a month."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.28,
      "end_seconds": 323.18,
      "duration_seconds": 4.9,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.76,
      "end_seconds": 327.25,
      "duration_seconds": 3.49,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.53,
      "end_seconds": 332.58,
      "duration_seconds": 4.05,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}