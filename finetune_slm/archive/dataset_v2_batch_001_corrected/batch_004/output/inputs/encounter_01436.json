{
  "schema_version": "1.0",
  "encounter_id": "01436",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.29,
      "end_seconds": 8.01,
      "duration_seconds": 6.72,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.62,
      "end_seconds": 13.12,
      "duration_seconds": 4.5,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 28.7,
      "duration_seconds": 14.1,
      "text": "it's night sweats, mostly it's a relief to finally sit down and talk about it a neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 30.32,
      "end_seconds": 39.8,
      "duration_seconds": 9.48,
      "text": "Doctor, I've got the readings for you. SpO2 99 percent on room air, blood pressure 115 over 69, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.89,
      "end_seconds": 44.33,
      "duration_seconds": 1.44,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.55,
      "end_seconds": 54.82,
      "duration_seconds": 10.27,
      "text": "Yes, carry on. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.8,
      "end_seconds": 69.2,
      "duration_seconds": 12.4,
      "text": "ah, it's severe, honestly. I'd say a few times a day. Oh, and poor sleep. That's been about the same, about two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.78,
      "end_seconds": 94.4,
      "duration_seconds": 6.62,
      "text": "let me check a few things any chest pain, heavy bleeding or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.77,
      "end_seconds": 105.29,
      "duration_seconds": 4.52,
      "text": "no, no chest pain, heavy bleeding or weight loss"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.04,
      "end_seconds": 109.14,
      "duration_seconds": 2.1,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.75,
      "end_seconds": 112.87,
      "duration_seconds": 2.12,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.94,
      "end_seconds": 121.8,
      "duration_seconds": 3.86,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.8,
      "end_seconds": 126.02,
      "duration_seconds": 2.22,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.7,
      "end_seconds": 130.28,
      "duration_seconds": 2.58,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.05,
      "end_seconds": 133.71,
      "duration_seconds": 1.66,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.32,
      "end_seconds": 156.25,
      "duration_seconds": 3.93,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.91,
      "end_seconds": 159.69,
      "duration_seconds": 2.78,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.87,
      "end_seconds": 163.8,
      "duration_seconds": 2.93,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.61,
      "end_seconds": 168.33,
      "duration_seconds": 3.72,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.7,
      "end_seconds": 172.72,
      "duration_seconds": 3.02,
      "text": "So, do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.43,
      "end_seconds": 178.73,
      "duration_seconds": 4.3,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.23,
      "end_seconds": 192.64,
      "duration_seconds": 3.41,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.29,
      "end_seconds": 202.62,
      "duration_seconds": 9.33,
      "text": "Seretide inhaler, twice a day. I'm on lamotrigine, 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.14,
      "end_seconds": 209.1,
      "duration_seconds": 5.96,
      "text": "Yes, carry on. What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.3,
      "end_seconds": 222.67,
      "duration_seconds": 12.37,
      "text": "I mean, um, I have asthma. I took the morning off to come in today. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.21,
      "end_seconds": 225.51,
      "duration_seconds": 1.3,
      "text": "is that everything?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.97,
      "end_seconds": 230.18,
      "duration_seconds": 1.21,
      "text": "yes, epilepsy"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.71,
      "end_seconds": 235.43,
      "duration_seconds": 3.72,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.42,
      "end_seconds": 237.12,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.18,
      "end_seconds": 240.12,
      "duration_seconds": 1.94,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.68,
      "end_seconds": 260.79,
      "duration_seconds": 2.11,
      "text": "your blood pressure is normal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.2,
      "end_seconds": 280.6,
      "duration_seconds": 16.4,
      "text": "You can sit up now. So, based on the history and the examination, this is probably menopausal symptoms. I'd also keep an overactive thyroid in mind. Let's book a thyroid test to look into hot flushes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.35,
      "end_seconds": 285.58,
      "duration_seconds": 3.23,
      "text": "So, do I need to prepare?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.48,
      "end_seconds": 302.5,
      "duration_seconds": 16.02,
      "text": "Let's use estradiol patch, 50 micrograms, twice weekly, long term. That's for menopausal symptoms. Dress in layers and keep the bedroom cool. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 303.59,
      "end_seconds": 306.48,
      "duration_seconds": 2.89,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.77,
      "end_seconds": 313.78,
      "duration_seconds": 6.01,
      "text": "See me again in three months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.12,
      "end_seconds": 318.77,
      "duration_seconds": 3.65,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.3,
      "end_seconds": 321.54,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}