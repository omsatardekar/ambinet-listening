{
  "schema_version": "1.0",
  "encounter_id": "01280",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 4.21,
      "duration_seconds": 2.87,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.85,
      "end_seconds": 6.99,
      "duration_seconds": 1.14,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.98,
      "end_seconds": 14.78,
      "duration_seconds": 6.8,
      "text": "Hello, you know, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.64,
      "end_seconds": 27.25,
      "duration_seconds": 6.61,
      "text": "That's fine, sit down. We'll go through it together. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.81,
      "end_seconds": 33.16,
      "duration_seconds": 5.35,
      "text": "Doctor, it's a severe sore throat. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.07,
      "end_seconds": 37.16,
      "duration_seconds": 2.09,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.21,
      "end_seconds": 43.96,
      "duration_seconds": 4.75,
      "text": "It's, It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.15,
      "end_seconds": 50.61,
      "duration_seconds": 5.46,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.89,
      "end_seconds": 55.78,
      "duration_seconds": 3.89,
      "text": "Swallowing definitely sets it off. Moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.43,
      "end_seconds": 62.19,
      "duration_seconds": 5.76,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 62.29,
      "end_seconds": 69.09,
      "duration_seconds": 6.8,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.28,
      "end_seconds": 73.1,
      "duration_seconds": 2.82,
      "text": "Right, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.04,
      "end_seconds": 77.74,
      "duration_seconds": 3.7,
      "text": "Erm, and drooling as well, since Friday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.7,
      "end_seconds": 93.73,
      "duration_seconds": 4.03,
      "text": "Let me check a few things. Any cough or rash?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.84,
      "end_seconds": 104.66,
      "duration_seconds": 9.82,
      "text": "No, no cough, no rash. I did have a muffled voice at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.24,
      "end_seconds": 109.37,
      "duration_seconds": 4.13,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 113.84,
      "duration_seconds": 3.51,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.76,
      "end_seconds": 118.24,
      "duration_seconds": 2.48,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.91,
      "end_seconds": 125.55,
      "duration_seconds": 5.64,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.43,
      "end_seconds": 142.23,
      "duration_seconds": 3.8,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.63,
      "end_seconds": 145.59,
      "duration_seconds": 1.96,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 148.81,
      "duration_seconds": 1.94,
      "text": "Right, do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.85,
      "end_seconds": 152.95,
      "duration_seconds": 3.1,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.56,
      "end_seconds": 156.36,
      "duration_seconds": 2.8,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.0,
      "end_seconds": 161.46,
      "duration_seconds": 3.46,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.15,
      "end_seconds": 166.06,
      "duration_seconds": 3.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.86,
      "end_seconds": 171.16,
      "duration_seconds": 3.3,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 173.22,
      "end_seconds": 179.38,
      "duration_seconds": 6.16,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.76,
      "end_seconds": 187.01,
      "duration_seconds": 2.25,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.9,
      "end_seconds": 196.88,
      "duration_seconds": 4.98,
      "text": "Fair enough, I'll write down both versions. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.95,
      "end_seconds": 204.01,
      "duration_seconds": 5.06,
      "text": "Well, uh, I take Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.2,
      "end_seconds": 207.08,
      "duration_seconds": 1.88,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.44,
      "end_seconds": 214.71,
      "duration_seconds": 6.27,
      "text": "Two years now. Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.28,
      "end_seconds": 215.98,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.76,
      "end_seconds": 222.88,
      "duration_seconds": 6.12,
      "text": "I'm on Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.91,
      "end_seconds": 227.84,
      "duration_seconds": 3.93,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.86,
      "end_seconds": 234.95,
      "duration_seconds": 6.09,
      "text": "No, it's at home. I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 236.75,
      "end_seconds": 243.2,
      "duration_seconds": 6.45,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.74,
      "end_seconds": 246.92,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.84,
      "end_seconds": 251.2,
      "duration_seconds": 3.36,
      "text": "I have asthma, for five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.14,
      "end_seconds": 253.7,
      "duration_seconds": 1.56,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.5,
      "end_seconds": 262.55,
      "duration_seconds": 8.05,
      "text": "Thin bones, for two years. Let me think, I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.82,
      "end_seconds": 265.8,
      "duration_seconds": 0.98,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.33,
      "end_seconds": 267.84,
      "duration_seconds": 1.51,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.16,
      "end_seconds": 274.51,
      "duration_seconds": 5.35,
      "text": "Okay, I can see asthma and anxiety in your file as well."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 275.54,
      "end_seconds": 283.94,
      "duration_seconds": 8.4,
      "text": "Okay, so the vitals from earlier. Pressure 123 over 75, temperature 36.8. Oxygen saturation is 93 percent, heart rate 101."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.24,
      "end_seconds": 286.16,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.2,
      "end_seconds": 291.24,
      "duration_seconds": 4.04,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.4,
      "end_seconds": 295.17,
      "duration_seconds": 2.77,
      "text": "Right, raise your arm for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.2,
      "end_seconds": 318.06,
      "duration_seconds": 4.86,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.64,
      "end_seconds": 320.34,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.58,
      "end_seconds": 336.1,
      "duration_seconds": 12.52,
      "text": "All finished, thank you. From what you've told me and what I found, I'd lean towards a possible airway infection that needs emergency care. Another possibility is severe tonsillitis."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.18,
      "end_seconds": 341.4,
      "duration_seconds": 3.22,
      "text": "Okay, so is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.89,
      "end_seconds": 359.65,
      "duration_seconds": 14.76,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible airway infection that needs emergency care, but I'd like to confirm. I think an urgent airway assessment makes sense here, for stridor and drooling."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.32,
      "end_seconds": 364.18,
      "duration_seconds": 2.86,
      "text": "Actually, how long will it take?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.02,
      "end_seconds": 377.94,
      "duration_seconds": 12.92,
      "text": "Do not lie flat, I am calling an ambulance now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.0,
      "end_seconds": 383.83,
      "duration_seconds": 3.83,
      "text": "Well, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.33,
      "end_seconds": 392.66,
      "duration_seconds": 7.33,
      "text": "I'll want another look straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.9,
      "end_seconds": 395.63,
      "duration_seconds": 1.73,
      "text": "That's clear, thanks."
    }
  ]
}