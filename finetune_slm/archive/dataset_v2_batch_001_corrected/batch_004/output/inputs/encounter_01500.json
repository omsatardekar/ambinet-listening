{
  "schema_version": "1.0",
  "encounter_id": "01500",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.06,
      "duration_seconds": 3.73,
      "text": "Well, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.78,
      "duration_seconds": 4.42,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.06,
      "end_seconds": 21.81,
      "duration_seconds": 9.75,
      "text": "I mean, I wanted to get hot flushes looked at. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.6,
      "end_seconds": 25.79,
      "duration_seconds": 3.19,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.4,
      "end_seconds": 34.74,
      "duration_seconds": 7.34,
      "text": "Since Friday, that's when it began i just want to get back to normal, really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.2,
      "end_seconds": 39.06,
      "duration_seconds": 3.86,
      "text": "Ah. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.95,
      "end_seconds": 43.85,
      "duration_seconds": 3.9,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.34,
      "end_seconds": 48.74,
      "duration_seconds": 2.4,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.37,
      "end_seconds": 58.5,
      "duration_seconds": 9.13,
      "text": "Vaginal dryness goes along with it, most of the time. The Vaginal dryness? That's been for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.54,
      "end_seconds": 63.65,
      "duration_seconds": 3.11,
      "text": "How strong would you say it it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.38,
      "end_seconds": 70.16,
      "duration_seconds": 4.78,
      "text": "I'd give it it a three, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.53,
      "end_seconds": 85.62,
      "duration_seconds": 3.09,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.82,
      "end_seconds": 96.62,
      "duration_seconds": 2.8,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.13,
      "end_seconds": 119.57,
      "duration_seconds": 8.44,
      "text": "Okay: SpO2 97 percent on room air, heart rate 69, temp 36.4 degrees. And blood pressure 121 over 77."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.53,
      "end_seconds": 125.44,
      "duration_seconds": 3.91,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.6,
      "end_seconds": 129.0,
      "duration_seconds": 2.4,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.62,
      "end_seconds": 146.66,
      "duration_seconds": 2.04,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.18,
      "end_seconds": 157.78,
      "duration_seconds": 5.6,
      "text": "Okay, that's enough for me. Have you noticed heavy bleeding or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.5,
      "end_seconds": 164.5,
      "duration_seconds": 5.0,
      "text": "No heavy bleeding or chest pain, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.07,
      "end_seconds": 166.76,
      "duration_seconds": 1.69,
      "text": "How about weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.64,
      "end_seconds": 170.68,
      "duration_seconds": 3.04,
      "text": "Mm, no, none, no weight loss."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.52,
      "end_seconds": 180.1,
      "duration_seconds": 4.58,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.77,
      "end_seconds": 182.89,
      "duration_seconds": 2.12,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.84,
      "end_seconds": 188.29,
      "duration_seconds": 3.45,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.01,
      "end_seconds": 191.55,
      "duration_seconds": 1.54,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.64,
      "end_seconds": 197.05,
      "duration_seconds": 4.41,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.71,
      "end_seconds": 202.13,
      "duration_seconds": 4.42,
      "text": "no, um, not that I know of"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.44,
      "end_seconds": 205.4,
      "duration_seconds": 1.96,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.02,
      "end_seconds": 208.59,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.94,
      "end_seconds": 214.52,
      "duration_seconds": 1.58,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.18,
      "end_seconds": 219.77,
      "duration_seconds": 4.59,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 225.85,
      "duration_seconds": 4.42,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.87,
      "end_seconds": 231.36,
      "duration_seconds": 3.49,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.2,
      "end_seconds": 244.45,
      "duration_seconds": 4.25,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.13,
      "end_seconds": 249.98,
      "duration_seconds": 3.85,
      "text": "It's warfarin, 3 milligrams, in the evening."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.48,
      "end_seconds": 266.34,
      "duration_seconds": 2.86,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.53,
      "end_seconds": 278.86,
      "duration_seconds": 11.33,
      "text": "I, I have an irregular heartbeat, for five years. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.78,
      "end_seconds": 295.08,
      "duration_seconds": 4.3,
      "text": "I want a thyroid test done, that's for hot flushes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.83,
      "end_seconds": 300.35,
      "duration_seconds": 4.52,
      "text": "let me think, uh, that's fine with me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.33,
      "end_seconds": 308.96,
      "duration_seconds": 7.63,
      "text": "I'd like you to take estradiol patch, 50 micrograms, twice weekly, long term it's for menopausal symptoms"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.46,
      "end_seconds": 316.39,
      "duration_seconds": 6.93,
      "text": "sorry, what was I saying, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.01,
      "end_seconds": 328.19,
      "duration_seconds": 10.18,
      "text": "dress in layers and keep the bedroom cool we'll catch up in three months anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.38,
      "end_seconds": 330.92,
      "duration_seconds": 1.54,
      "text": "That's clear, thanks."
    }
  ]
}