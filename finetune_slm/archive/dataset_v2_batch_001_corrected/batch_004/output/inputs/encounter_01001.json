{
  "schema_version": "1.0",
  "encounter_id": "01001",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 7.64,
      "duration_seconds": 6.92,
      "text": "ah, you know, hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.87,
      "end_seconds": 18.91,
      "duration_seconds": 5.04,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 19.52,
      "end_seconds": 27.6,
      "duration_seconds": 8.08,
      "text": "Yeah, you know, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.61,
      "end_seconds": 33.48,
      "duration_seconds": 3.87,
      "text": "Right, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.06,
      "end_seconds": 41.88,
      "duration_seconds": 6.82,
      "text": "It's a blocked ear, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.63,
      "end_seconds": 46.3,
      "duration_seconds": 3.67,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.8,
      "end_seconds": 50.39,
      "duration_seconds": 2.59,
      "text": "Around three weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.14,
      "end_seconds": 55.59,
      "duration_seconds": 4.45,
      "text": "Hm, um, I'd say more like a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.92,
      "end_seconds": 61.25,
      "duration_seconds": 4.33,
      "text": "okay, so roughly three to four weeks is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.97,
      "end_seconds": 64.27,
      "duration_seconds": 2.3,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.89,
      "end_seconds": 67.7,
      "duration_seconds": 2.81,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.78,
      "end_seconds": 75.71,
      "duration_seconds": 6.93,
      "text": "Let me think, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.74,
      "end_seconds": 79.28,
      "duration_seconds": 2.54,
      "text": "is it worse at certain times?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.06,
      "end_seconds": 85.27,
      "duration_seconds": 5.21,
      "text": "Um, uh, yes, showering. That makes it worse."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.66,
      "end_seconds": 89.05,
      "duration_seconds": 2.39,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.11,
      "end_seconds": 94.26,
      "duration_seconds": 4.15,
      "text": "It usually comes with a feeling of fullness."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.21,
      "end_seconds": 103.57,
      "duration_seconds": 8.36,
      "text": "And the the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 103.67,
      "end_seconds": 110.0,
      "duration_seconds": 6.33,
      "text": "so, tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.38,
      "end_seconds": 118.7,
      "duration_seconds": 4.32,
      "text": "oh, you know, I was getting to that!"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.98,
      "end_seconds": 123.38,
      "duration_seconds": 3.4,
      "text": "have you had muffled hearing on one side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.0,
      "end_seconds": 128.77,
      "duration_seconds": 3.77,
      "text": "Yeah, I've had that since last weekend."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.32,
      "end_seconds": 132.06,
      "duration_seconds": 2.74,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.07,
      "end_seconds": 141.05,
      "duration_seconds": 6.98,
      "text": "Well, uh, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.81,
      "end_seconds": 146.09,
      "duration_seconds": 3.28,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.51,
      "end_seconds": 148.62,
      "duration_seconds": 1.11,
      "text": "Severe, really"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.41,
      "end_seconds": 156.09,
      "duration_seconds": 5.68,
      "text": "Have you had a blocked ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.66,
      "end_seconds": 165.47,
      "duration_seconds": 8.81,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.54,
      "end_seconds": 167.9,
      "duration_seconds": 1.36,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.48,
      "end_seconds": 173.12,
      "duration_seconds": 3.64,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.69,
      "end_seconds": 193.77,
      "duration_seconds": 2.08,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.65,
      "end_seconds": 202.97,
      "duration_seconds": 7.32,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.8,
      "end_seconds": 224.22,
      "duration_seconds": 2.42,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.87,
      "end_seconds": 232.49,
      "duration_seconds": 6.62,
      "text": "it's escitalopram, 10 milligrams, maybe, once a day for the anxiety"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.05,
      "end_seconds": 237.06,
      "duration_seconds": 4.01,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.22,
      "end_seconds": 254.05,
      "duration_seconds": 15.83,
      "text": "Not with me. I'll bring it next time. Mm, it's carbamazepine, 200 milligrams, twice a day. Olive oil drops. I take it it twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.14,
      "end_seconds": 258.06,
      "duration_seconds": 2.92,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.3,
      "end_seconds": 261.72,
      "duration_seconds": 2.42,
      "text": "About about a year."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.18,
      "end_seconds": 266.4,
      "duration_seconds": 3.22,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.04,
      "end_seconds": 273.41,
      "duration_seconds": 5.37,
      "text": "My mother had a stroke. Right, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.0,
      "end_seconds": 277.64,
      "duration_seconds": 3.64,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.83,
      "end_seconds": 294.5,
      "duration_seconds": 15.67,
      "text": "Yes, anxiety. Okay, so yes, epilepsy. I looked a few things up online, and that probably didn't help. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.81,
      "end_seconds": 297.06,
      "duration_seconds": 1.25,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.63,
      "end_seconds": 301.14,
      "duration_seconds": 3.51,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.11,
      "end_seconds": 304.73,
      "duration_seconds": 2.62,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.22,
      "end_seconds": 309.16,
      "duration_seconds": 2.94,
      "text": "Have you noticed dizziness or discharge?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.85,
      "end_seconds": 313.15,
      "duration_seconds": 3.3,
      "text": "Right, no, no dizziness or discharge."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.82,
      "end_seconds": 317.62,
      "duration_seconds": 2.8,
      "text": "have you noticed ringing or ear pain?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.25,
      "end_seconds": 322.21,
      "duration_seconds": 3.96,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.43,
      "end_seconds": 325.96,
      "duration_seconds": 2.53,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.25,
      "end_seconds": 330.17,
      "duration_seconds": 2.92,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.18,
      "end_seconds": 334.34,
      "duration_seconds": 2.16,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.44,
      "end_seconds": 336.56,
      "duration_seconds": 1.12,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.67,
      "end_seconds": 341.11,
      "duration_seconds": 3.44,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.39,
      "end_seconds": 350.73,
      "duration_seconds": 2.34,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.54,
      "end_seconds": 382.15,
      "duration_seconds": 14.61,
      "text": "okay: weight 89 kilos, respiratory rate 17, heart rate 77, BMI works out to 36.1, oxygen saturation is 98 percent, temp 36.7 degrees, pressure 109 over 74, height 157 centimetres"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.6,
      "end_seconds": 386.55,
      "duration_seconds": 2.95,
      "text": "yeah, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.78,
      "end_seconds": 391.28,
      "duration_seconds": 3.5,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.4,
      "end_seconds": 396.7,
      "duration_seconds": 4.3,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.14,
      "end_seconds": 400.13,
      "duration_seconds": 1.99,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.85,
      "end_seconds": 418.28,
      "duration_seconds": 4.43,
      "text": "there's a lot of wax blocking the right ear canal"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.05,
      "end_seconds": 421.52,
      "duration_seconds": 1.47,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.86,
      "end_seconds": 443.92,
      "duration_seconds": 18.06,
      "text": "Good, you can sit up again. From what you've told me and what I found, I think we're dealing with earwax blocking the ear at this stage. Another possibility is a middle ear fluid. I'd like to arrange ear irrigation for wax."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 444.89,
      "end_seconds": 447.2,
      "duration_seconds": 2.31,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.9,
      "end_seconds": 450.86,
      "duration_seconds": 2.96,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.71,
      "end_seconds": 469.2,
      "duration_seconds": 16.49,
      "text": "Use the olive oil drops for a week and then we'll syringe the ear. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 471.28,
      "end_seconds": 473.24,
      "duration_seconds": 1.96,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 474.11,
      "end_seconds": 485.73,
      "duration_seconds": 11.62,
      "text": "If you get ear pain or dizziness, or you feel really unwell, please come to the emergency department. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 486.48,
      "end_seconds": 490.38,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}