      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.95,
      "end_seconds": 232.93,
      "duration_seconds": 17.98,
      "text": "Peppermint capsules, after meals it's a relief to finally sit down and talk about it i'm hoping you can tell me something definite i had escitalopram at one point, but I'm off it now"
    },
    {
      "segment_id": "SEG0029",
