    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.43,
      "end_seconds": 210.33,
      "duration_seconds": 10.9,
      "text": "I'm a hairdresser, on my feet all day. I swim twice a week. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
