      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.71,
      "end_seconds": 253.78,
      "duration_seconds": 4.07,
      "text": "well, uh, my sister had breast cancer"
