{
  "schema_version": "1.0",
  "encounter_id": "01372",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 3.32,
      "duration_seconds": 2.32,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.94,
      "end_seconds": 6.81,
      "duration_seconds": 2.87,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 10.22,
      "duration_seconds": 2.02,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.46,
      "end_seconds": 18.42,
      "duration_seconds": 3.96,
      "text": "Um, only about ten minutes, honestly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.05,
      "end_seconds": 20.96,
      "duration_seconds": 1.91,
      "text": "where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.45,
      "end_seconds": 27.21,
      "duration_seconds": 4.76,
      "text": "Um, so... bloating after meals. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.71,
      "end_seconds": 36.84,
      "duration_seconds": 2.13,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.25,
      "end_seconds": 43.12,
      "duration_seconds": 4.87,
      "text": "Around three days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.55,
      "end_seconds": 57.61,
      "duration_seconds": 13.06,
      "text": "tell me a bit more about it: how bad it gets, how often, and and whether anything makes it better or worse. These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.2,
      "end_seconds": 67.7,
      "duration_seconds": 9.5,
      "text": "I notice it more with large meals and fizzy drinks. I'd call it moderate. It settles a little with walking."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.21,
      "end_seconds": 70.72,
      "duration_seconds": 2.51,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.06,
      "end_seconds": 90.16,
      "duration_seconds": 18.1,
      "text": "It usually comes with loose stools now and then. The loose stools now and then? That's been for five days. Oh, with loose stools now and then, about a five out of ten. I notice it more with stress."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.78,
      "end_seconds": 93.4,
      "duration_seconds": 1.62,
      "text": "Nothing like weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.3,
      "end_seconds": 96.4,
      "duration_seconds": 2.1,
      "text": "Nope, no weight loss."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.83,
      "end_seconds": 101.98,
      "duration_seconds": 4.15,
      "text": "Did you get night-time diarrhoea or blood in the stool?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.15,
      "end_seconds": 108.49,
      "duration_seconds": 5.34,
      "text": "I haven't had night-time diarrhoea or blood in the stool, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.94,
      "end_seconds": 112.91,
      "duration_seconds": 2.97,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.99,
      "end_seconds": 116.12,
      "duration_seconds": 1.13,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.46,
      "end_seconds": 118.93,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 121.83,
      "duration_seconds": 2.21,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.52,
      "end_seconds": 142.78,
      "duration_seconds": 3.26,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.42,
      "end_seconds": 145.51,
      "duration_seconds": 2.09,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.2,
      "end_seconds": 153.09,
      "duration_seconds": 5.89,
      "text": "Right, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.78,
      "end_seconds": 159.56,
      "duration_seconds": 5.78,
      "text": "I'm allergic to plasters, I get a red itchy rash"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.59,
      "end_seconds": 162.71,
      "duration_seconds": 2.12,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.65,
      "end_seconds": 166.71,
      "duration_seconds": 3.06,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.77,
      "end_seconds": 171.89,
      "duration_seconds": 4.12,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.57,
      "end_seconds": 175.0,
      "duration_seconds": 2.43,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.53,
      "end_seconds": 183.96,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.61,
      "end_seconds": 188.64,
      "duration_seconds": 3.03,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.2,
      "end_seconds": 191.24,
      "duration_seconds": 2.04,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.76,
      "end_seconds": 195.49,
      "duration_seconds": 3.73,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.05,
      "end_seconds": 199.43,
      "duration_seconds": 2.38,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.64,
      "end_seconds": 204.08,
      "duration_seconds": 3.44,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.65,
      "end_seconds": 209.46,
      "duration_seconds": 2.81,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 212.36,
      "duration_seconds": 1.19,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.8,
      "end_seconds": 234.03,
      "duration_seconds": 6.23,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.36,
      "end_seconds": 241.07,
      "duration_seconds": 2.71,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.99,
      "end_seconds": 284.97,
      "duration_seconds": 24.98,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be a functional bowel pattern, with no alarm features, or it might be irritable bowel syndrome. Let me repeat that back to make sure. You've had bloating after meals for ten days, moderate, and no night-time diarrhoea or blood in the stool."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.44,
      "end_seconds": 287.93,
      "duration_seconds": 1.49,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.52,
      "end_seconds": 302.38,
      "duration_seconds": 12.86,
      "text": "I want a coeliac blood test done, that's for bloating. Try smaller meals and keep a food and symptom diary for four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.98,
      "end_seconds": 305.88,
      "duration_seconds": 2.9,
      "text": "Great, thank you for your help."
    }
  ]
}