{
  "schema_version": "1.0",
  "encounter_id": "01078",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 3.41,
      "duration_seconds": 2.28,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.82,
      "end_seconds": 8.51,
      "duration_seconds": 3.69,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.56,
      "end_seconds": 13.75,
      "duration_seconds": 4.19,
      "text": "thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.36,
      "end_seconds": 21.75,
      "duration_seconds": 7.39,
      "text": "Yes, that's no problem at all. Please sit. Right, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.45,
      "end_seconds": 29.03,
      "duration_seconds": 5.58,
      "text": "Oh, I've been dealing with a painful widespread rash."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.09,
      "end_seconds": 34.11,
      "duration_seconds": 3.02,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.93,
      "end_seconds": 39.6,
      "duration_seconds": 3.67,
      "text": "Around two weeks, you know, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.04,
      "end_seconds": 45.26,
      "duration_seconds": 4.22,
      "text": "hm, I'd say more like three weeks"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.82,
      "end_seconds": 49.9,
      "duration_seconds": 4.08,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.6,
      "end_seconds": 53.86,
      "duration_seconds": 2.26,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.56,
      "end_seconds": 62.85,
      "duration_seconds": 8.29,
      "text": "Can you describe it a bit more for me? How strong it is, what the the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.64,
      "end_seconds": 68.2,
      "duration_seconds": 4.56,
      "text": "it happens once or twice a day mostly moderate"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.9,
      "end_seconds": 72.33,
      "duration_seconds": 2.43,
      "text": "Any a fever as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.32,
      "end_seconds": 82.2,
      "duration_seconds": 8.88,
      "text": "Yes, you know, I have. As for fever, I'd say a few times a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.75,
      "end_seconds": 87.02,
      "duration_seconds": 3.27,
      "text": "Has there been sore red eyes too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.77,
      "end_seconds": 92.38,
      "duration_seconds": 3.61,
      "text": "Right, yeah. Two weeks, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.02,
      "end_seconds": 96.58,
      "duration_seconds": 3.56,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.57,
      "end_seconds": 99.58,
      "duration_seconds": 2.01,
      "text": "I'd call it moderate"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.63,
      "end_seconds": 104.86,
      "duration_seconds": 3.23,
      "text": "has there been sores in your mouth too?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.09,
      "end_seconds": 116.92,
      "duration_seconds": 10.83,
      "text": "Yeah, you know, I've had that since Monday. Mm, about sores in my mouth, I'd call it mild."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.98,
      "end_seconds": 122.09,
      "duration_seconds": 3.11,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.31,
      "end_seconds": 134.82,
      "duration_seconds": 11.51,
      "text": "I walk the dog every morning. I work in accounts at a hospital. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.86,
      "end_seconds": 140.56,
      "duration_seconds": 4.7,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.37,
      "end_seconds": 147.27,
      "duration_seconds": 4.9,
      "text": "My father has Parkinson's disease. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.2,
      "end_seconds": 156.63,
      "duration_seconds": 3.43,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.12,
      "end_seconds": 175.93,
      "duration_seconds": 17.81,
      "text": "it's aspirin, 75 milligrams, once a day for my heart it's Tiotropium inhaler, once a day i take a new antibiotic, 960 milligrams, twice a day for a week"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.61,
      "end_seconds": 193.32,
      "duration_seconds": 4.71,
      "text": "Do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.83,
      "end_seconds": 211.1,
      "duration_seconds": 13.27,
      "text": "Let me think, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.48,
      "end_seconds": 214.88,
      "duration_seconds": 2.4,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.97,
      "end_seconds": 220.3,
      "duration_seconds": 4.33,
      "text": "Right, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.0,
      "end_seconds": 225.87,
      "duration_seconds": 3.87,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.84,
      "end_seconds": 232.68,
      "duration_seconds": 1.84,
      "text": "yes, heart disease"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.58,
      "end_seconds": 236.5,
      "duration_seconds": 2.92,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.83,
      "end_seconds": 246.23,
      "duration_seconds": 8.4,
      "text": "Yes, COPD. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.82,
      "end_seconds": 255.71,
      "duration_seconds": 8.89,
      "text": "Yes, heart disease is known to us, good to have that clear. Any insect bite or new medicine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.47,
      "end_seconds": 260.81,
      "duration_seconds": 3.34,
      "text": "no, none that that I've noticed"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.55,
      "end_seconds": 263.11,
      "duration_seconds": 1.56,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.01,
      "end_seconds": 267.4,
      "duration_seconds": 2.39,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.23,
      "end_seconds": 270.18,
      "duration_seconds": 1.95,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.61,
      "end_seconds": 286.42,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.0,
      "end_seconds": 306.84,
      "duration_seconds": 8.84,
      "text": "Okay: temperature 38.6, respiratory rate 21. And blood pressure 117 over 69, oxygen saturation is 95 percent, pulse 104."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.48,
      "end_seconds": 309.14,
      "duration_seconds": 1.66,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.8,
      "end_seconds": 315.31,
      "duration_seconds": 4.51,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.83,
      "end_seconds": 319.91,
      "duration_seconds": 3.08,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.41,
      "end_seconds": 323.09,
      "duration_seconds": 1.68,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.12,
      "end_seconds": 347.23,
      "duration_seconds": 7.11,
      "text": "There are dusky red patches with blistering and the skin peels when I rub it lightly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.24,
      "end_seconds": 353.29,
      "duration_seconds": 2.05,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.64,
      "end_seconds": 383.58,
      "duration_seconds": 13.94,
      "text": "From what you've told me and what I found, this looks most like a severe drug reaction of the skin. I can't rule out a viral rash yet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.9,
      "end_seconds": 387.38,
      "duration_seconds": 2.48,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.63,
      "end_seconds": 398.21,
      "duration_seconds": 9.58,
      "text": "Nothing I've seen today points to an emergency. It looks like a severe drug reaction of the skin, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.2,
      "end_seconds": 437.97,
      "duration_seconds": 23.77,
      "text": "I'd like to arrange an urgent dermatology review for severe drug reaction. I think blood tests makes sense here, for severe drug reaction. Stop the antibiotic now and I am sending you to hospital immediately. I'd like you to see the dermatology team as well, and I'll write the referral. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 439.13,
      "end_seconds": 442.44,
      "duration_seconds": 3.31,
      "text": "Okay, um, I'll arrange it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 442.96,
      "end_seconds": 445.3,
      "duration_seconds": 2.34,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 446.71,
      "end_seconds": 450.67,
      "duration_seconds": 3.96,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}