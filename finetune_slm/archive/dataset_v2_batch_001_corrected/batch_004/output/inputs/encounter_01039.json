{
  "schema_version": "1.0",
  "encounter_id": "01039",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 5.75,
      "duration_seconds": 4.81,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.59,
      "end_seconds": 10.9,
      "duration_seconds": 4.31,
      "text": "erm, morning, doctor, sorry about the the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.45,
      "end_seconds": 17.16,
      "duration_seconds": 4.71,
      "text": "morning, doctor. I'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.02,
      "end_seconds": 25.97,
      "duration_seconds": 5.95,
      "text": "Of course, please stay. It's helpful to to have you here. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 35.29,
      "duration_seconds": 8.79,
      "text": "So the thing is, I've got a mild cough. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.1,
      "end_seconds": 40.52,
      "duration_seconds": 3.42,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.06,
      "end_seconds": 43.22,
      "duration_seconds": 2.16,
      "text": "probably two months. Yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.46,
      "end_seconds": 49.29,
      "duration_seconds": 4.83,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.65,
      "end_seconds": 67.15,
      "duration_seconds": 16.5,
      "text": "It's a couple of times a week. It's moderate, honestly. It's a relief to finally sit down and talk about it. Oh, and sneezing. Had that since last Tuesday. There's a runny nose as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.65,
      "end_seconds": 71.03,
      "duration_seconds": 2.38,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.48,
      "end_seconds": 83.27,
      "duration_seconds": 2.79,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.87,
      "end_seconds": 109.88,
      "duration_seconds": 10.01,
      "text": "Okay: oxygen saturation is 97 percent, temperature 36.8. And blood pressure 114 over 72, pulse is 79 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.82,
      "end_seconds": 112.49,
      "duration_seconds": 1.67,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.27,
      "end_seconds": 117.65,
      "duration_seconds": 3.38,
      "text": "Okay, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.15,
      "end_seconds": 122.85,
      "duration_seconds": 3.7,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.71,
      "end_seconds": 125.41,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.43,
      "end_seconds": 128.37,
      "duration_seconds": 1.94,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.3,
      "end_seconds": 149.67,
      "duration_seconds": 4.37,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.83,
      "end_seconds": 156.29,
      "duration_seconds": 2.46,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.44,
      "end_seconds": 175.79,
      "duration_seconds": 2.35,
      "text": "Did you notice any ear pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.78,
      "end_seconds": 179.93,
      "duration_seconds": 2.15,
      "text": "no. No ear pain"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.04,
      "end_seconds": 186.82,
      "duration_seconds": 5.78,
      "text": "let me check a few things. Any shortness of breath, chest pain or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.75,
      "end_seconds": 197.97,
      "duration_seconds": 5.22,
      "text": "No, no shortness of breath, chest pain or fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.32,
      "end_seconds": 204.54,
      "duration_seconds": 6.22,
      "text": "understood so, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.21,
      "end_seconds": 206.56,
      "duration_seconds": 1.35,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.37,
      "end_seconds": 211.63,
      "duration_seconds": 3.26,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.59,
      "end_seconds": 217.54,
      "duration_seconds": 3.95,
      "text": "Clopidogrel, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.42,
      "end_seconds": 222.63,
      "duration_seconds": 4.21,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.47,
      "end_seconds": 230.46,
      "duration_seconds": 5.99,
      "text": "Well, no, it's at home. I'm, I'm on throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 239.61,
      "duration_seconds": 4.15,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.45,
      "end_seconds": 243.95,
      "duration_seconds": 3.5,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.43,
      "end_seconds": 262.32,
      "duration_seconds": 2.89,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.93,
      "end_seconds": 268.43,
      "duration_seconds": 4.5,
      "text": "I've had heart disease for two years now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.86,
      "end_seconds": 276.56,
      "duration_seconds": 6.7,
      "text": "yes, heart disease is known to us, good to have that clear how active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.62,
      "end_seconds": 281.86,
      "duration_seconds": 3.24,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.44,
      "end_seconds": 285.9,
      "duration_seconds": 3.46,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.84,
      "end_seconds": 294.71,
      "duration_seconds": 2.87,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.03,
      "end_seconds": 298.13,
      "duration_seconds": 2.1,
      "text": "right, how are your meals?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.8,
      "end_seconds": 302.4,
      "duration_seconds": 3.6,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.76,
      "end_seconds": 315.89,
      "duration_seconds": 8.13,
      "text": "from what you've told me and what I found, the most likely explanation is a simple viral cold"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.94,
      "end_seconds": 320.07,
      "duration_seconds": 2.13,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.75,
      "end_seconds": 327.02,
      "duration_seconds": 6.27,
      "text": "nothing I've seen today points to an emergency it looks like a simple viral cold"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.38,
      "end_seconds": 353.34,
      "duration_seconds": 11.96,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.67,
      "end_seconds": 357.86,
      "duration_seconds": 3.19,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.37,
      "end_seconds": 366.51,
      "duration_seconds": 8.14,
      "text": "Book a review if it is not better in ten days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.08,
      "end_seconds": 369.95,
      "duration_seconds": 2.87,
      "text": "um, thank you, that's helpful"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.58,
      "end_seconds": 372.92,
      "duration_seconds": 1.34,
      "text": "All the best."
    }
  ]
}