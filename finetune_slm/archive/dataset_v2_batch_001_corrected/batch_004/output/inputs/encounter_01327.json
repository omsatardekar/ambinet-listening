{
  "schema_version": "1.0",
  "encounter_id": "01327",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 4.63,
      "duration_seconds": 3.7,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.85,
      "end_seconds": 8.79,
      "duration_seconds": 2.94,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.98,
      "end_seconds": 13.91,
      "duration_seconds": 3.93,
      "text": "Actually, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.67,
      "end_seconds": 17.01,
      "duration_seconds": 2.34,
      "text": "Okay, weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.87,
      "end_seconds": 23.05,
      "duration_seconds": 5.18,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.96,
      "end_seconds": 26.67,
      "duration_seconds": 2.71,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.02,
      "end_seconds": 35.08,
      "duration_seconds": 7.06,
      "text": "It's dry gritty eyes, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.03,
      "end_seconds": 39.13,
      "duration_seconds": 2.1,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.07,
      "end_seconds": 53.31,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.9,
      "end_seconds": 70.73,
      "duration_seconds": 5.83,
      "text": "Okay: heart rate 80, BP is 117 over 73, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.46,
      "end_seconds": 73.79,
      "duration_seconds": 2.33,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.04,
      "end_seconds": 80.76,
      "duration_seconds": 5.72,
      "text": "We'll look at it together shortly. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.24,
      "end_seconds": 87.01,
      "duration_seconds": 4.77,
      "text": "Ah, it's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.08,
      "end_seconds": 101.54,
      "duration_seconds": 10.46,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.59,
      "end_seconds": 113.09,
      "duration_seconds": 9.5,
      "text": "Pretty severe, if I'm being honest. Only eye drops, and it's not much. Yes, screens. That makes it worse."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.12,
      "end_seconds": 118.03,
      "duration_seconds": 3.91,
      "text": "Has there been occasional blurring that clears on blinking too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.99,
      "end_seconds": 127.35,
      "duration_seconds": 5.36,
      "text": "Yeah. Four weeks, I'd say. And tired eyes by evening, too."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.96,
      "end_seconds": 132.6,
      "duration_seconds": 3.64,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.5,
      "end_seconds": 138.35,
      "duration_seconds": 3.85,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.41,
      "end_seconds": 143.6,
      "duration_seconds": 3.19,
      "text": "Have you had any light sensitivity or pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.68,
      "end_seconds": 151.66,
      "duration_seconds": 3.98,
      "text": "No light sensitivity or pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.05,
      "end_seconds": 156.91,
      "duration_seconds": 3.86,
      "text": "Any loss of vision or redness at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.75,
      "end_seconds": 164.54,
      "duration_seconds": 2.79,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.07,
      "end_seconds": 168.49,
      "duration_seconds": 2.42,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.31,
      "end_seconds": 170.95,
      "duration_seconds": 1.64,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.06,
      "end_seconds": 174.46,
      "duration_seconds": 2.4,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.61,
      "end_seconds": 178.94,
      "duration_seconds": 3.33,
      "text": "Lubricating drops, four times a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.01,
      "end_seconds": 182.97,
      "duration_seconds": 2.96,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.77,
      "end_seconds": 185.93,
      "duration_seconds": 2.16,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.95,
      "end_seconds": 206.5,
      "duration_seconds": 4.55,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.5,
      "end_seconds": 212.92,
      "duration_seconds": 4.42,
      "text": "Let me think, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.23,
      "end_seconds": 219.82,
      "duration_seconds": 3.59,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.68,
      "end_seconds": 223.06,
      "duration_seconds": 1.38,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.15,
      "end_seconds": 228.66,
      "duration_seconds": 3.51,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.55,
      "end_seconds": 234.1,
      "duration_seconds": 3.55,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.37,
      "end_seconds": 237.69,
      "duration_seconds": 2.32,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.42,
      "end_seconds": 243.55,
      "duration_seconds": 4.13,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.67,
      "end_seconds": 250.83,
      "duration_seconds": 5.16,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.6,
      "end_seconds": 253.2,
      "duration_seconds": 1.6,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.63,
      "end_seconds": 256.59,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.67,
      "end_seconds": 281.02,
      "duration_seconds": 6.35,
      "text": "Your eyelids look slightly crusted but the white of the eye is clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.65,
      "end_seconds": 287.57,
      "duration_seconds": 1.92,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.36,
      "end_seconds": 308.61,
      "duration_seconds": 6.25,
      "text": "Okay, so my impression is this: The most likely explanation is dry eye disease."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.2,
      "end_seconds": 326.96,
      "duration_seconds": 6.76,
      "text": "For now, no new medicines or tests are needed. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.14,
      "end_seconds": 331.08,
      "duration_seconds": 2.94,
      "text": "Thank you, uh, that's helpful."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.09,
      "end_seconds": 333.47,
      "duration_seconds": 1.38,
      "text": "Goodbye for now."
    }
  ]
}