{
  "schema_version": "1.0",
  "encounter_id": "01038",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 3.04,
      "duration_seconds": 2.37,
      "text": "Right, morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.13,
      "end_seconds": 7.91,
      "duration_seconds": 2.78,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 11.45,
      "duration_seconds": 2.91,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.47,
      "end_seconds": 18.31,
      "duration_seconds": 5.84,
      "text": "Honestly, it's a runny nose, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.65,
      "end_seconds": 21.7,
      "duration_seconds": 2.05,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.02,
      "end_seconds": 28.99,
      "duration_seconds": 2.97,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.27,
      "end_seconds": 40.03,
      "duration_seconds": 7.76,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.18,
      "end_seconds": 51.18,
      "duration_seconds": 10.0,
      "text": "Tissues helps a bit. It's severe, honestly. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.19,
      "end_seconds": 56.63,
      "duration_seconds": 4.44,
      "text": "What about a scratchy throat, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.24,
      "end_seconds": 60.16,
      "duration_seconds": 1.92,
      "text": "Yes, since last weekend."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.87,
      "end_seconds": 64.93,
      "duration_seconds": 3.06,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.7,
      "end_seconds": 79.02,
      "duration_seconds": 2.32,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.49,
      "end_seconds": 102.84,
      "duration_seconds": 7.35,
      "text": "Okay: BP is 125 over 80, respiratory rate 15, SpO2 97 percent on room air. And pulse 83."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.76,
      "end_seconds": 106.96,
      "duration_seconds": 2.2,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.94,
      "end_seconds": 110.64,
      "duration_seconds": 2.7,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.99,
      "end_seconds": 131.65,
      "duration_seconds": 4.66,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.03,
      "end_seconds": 136.59,
      "duration_seconds": 2.56,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.35,
      "end_seconds": 151.58,
      "duration_seconds": 3.23,
      "text": "Did you get chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.43,
      "end_seconds": 157.32,
      "duration_seconds": 3.89,
      "text": "I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 160.22,
      "duration_seconds": 2.35,
      "text": "Any sign of shortness of breath?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.74,
      "end_seconds": 164.34,
      "duration_seconds": 3.6,
      "text": "I haven't noticed any shortness of breath."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.31,
      "end_seconds": 167.75,
      "duration_seconds": 2.44,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.53,
      "end_seconds": 169.62,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.47,
      "end_seconds": 174.54,
      "duration_seconds": 4.07,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.32,
      "end_seconds": 178.46,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 182.47,
      "duration_seconds": 2.77,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.34,
      "end_seconds": 186.97,
      "duration_seconds": 2.63,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.86,
      "end_seconds": 201.3,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.17,
      "end_seconds": 205.19,
      "duration_seconds": 3.02,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.81,
      "end_seconds": 218.51,
      "duration_seconds": 3.7,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.01,
      "end_seconds": 223.33,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.29,
      "end_seconds": 227.19,
      "duration_seconds": 2.9,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.64,
      "end_seconds": 232.38,
      "duration_seconds": 3.74,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.47,
      "end_seconds": 235.81,
      "duration_seconds": 1.34,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.27,
      "end_seconds": 240.33,
      "duration_seconds": 3.06,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.18,
      "end_seconds": 260.73,
      "duration_seconds": 3.55,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.55,
      "end_seconds": 271.7,
      "duration_seconds": 9.15,
      "text": "An irregular heartbeat, for five years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.54,
      "end_seconds": 274.9,
      "duration_seconds": 2.36,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.75,
      "end_seconds": 281.76,
      "duration_seconds": 5.01,
      "text": "I, I take warfarin, 3 milligrams, in the evening."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.84,
      "end_seconds": 286.91,
      "duration_seconds": 3.07,
      "text": "So, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.33,
      "end_seconds": 296.81,
      "duration_seconds": 8.48,
      "text": "Years back I got a rash all over from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.6,
      "end_seconds": 304.39,
      "duration_seconds": 6.79,
      "text": "Let me tell you where I've got to. It points towards a simple viral cold."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.46,
      "end_seconds": 308.39,
      "duration_seconds": 2.93,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.38,
      "end_seconds": 329.15,
      "duration_seconds": 18.77,
      "text": "I understand the worry. At the moment I'd say it's a simple viral cold, and we'll watch how it goes. Rest, plenty of fluids, and paracetamol if you ache. Please don't wait if you develop a high fever or trouble breathing. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.85,
      "end_seconds": 331.6,
      "duration_seconds": 1.75,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.5,
      "end_seconds": 346.24,
      "duration_seconds": 8.74,
      "text": "Let's review you if it is not better in ten days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.22,
      "end_seconds": 353.19,
      "duration_seconds": 2.97,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.76,
      "end_seconds": 355.05,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}