  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.9,
      "duration_seconds": 3.64,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 9.9,
      "duration_seconds": 4.03,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.84,
      "end_seconds": 18.25,
      "duration_seconds": 7.41,
      "text": "Doctor, uh, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.69,
      "end_seconds": 23.68,
      "duration_seconds": 3.99,
      "text": "that's fine, sit down we'll go through it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.69,
      "end_seconds": 32.31,
      "duration_seconds": 7.62,
      "text": "Yeah, it's tearing chest pain going to my back. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 37.91,
      "duration_seconds": 3.76,
      "text": "Can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.1,
      "end_seconds": 42.99,
      "duration_seconds": 3.89,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.23,
      "end_seconds": 53.55,
      "duration_seconds": 10.32,
      "text": "Right, right. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.35,
      "end_seconds": 72.37,
      "duration_seconds": 18.02,
      "text": "About a seven out of ten. It happens a couple of times a week. Yeah, and there's sudden onset as well, about four days now. I, I was feeling faint at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.37,
      "end_seconds": 74.68,
      "duration_seconds": 1.31,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 80.68,
      "duration_seconds": 4.01,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.41,
      "end_seconds": 83.52,
      "duration_seconds": 2.11,
      "text": "and and alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.07,
      "end_seconds": 89.02,
      "duration_seconds": 3.95,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 93.08,
      "duration_seconds": 2.67,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.83,
      "end_seconds": 99.35,
      "duration_seconds": 4.52,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.64,
      "end_seconds": 105.16,
      "duration_seconds": 4.52,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.64,
      "end_seconds": 110.71,
      "duration_seconds": 4.07,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.73,
      "end_seconds": 117.09,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.88,
      "end_seconds": 120.74,
      "duration_seconds": 2.86,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.64,
      "end_seconds": 128.52,
      "duration_seconds": 2.88,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.15,
      "end_seconds": 132.97,
      "duration_seconds": 2.82,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.52,
      "end_seconds": 136.84,
      "duration_seconds": 3.32,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.38,
      "end_seconds": 143.48,
      "duration_seconds": 5.1,
      "text": "My mother had a stroke. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.91,
      "end_seconds": 150.31,
      "duration_seconds": 5.4,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.16,
      "end_seconds": 155.24,
      "duration_seconds": 3.08,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 156.39,
      "end_seconds": 165.67,
      "duration_seconds": 9.28,
      "text": "Actually, I remember she had some kind of reaction to naproxen before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.07,
      "end_seconds": 172.21,
      "duration_seconds": 2.14,
      "text": "I don't remember that"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.85,
      "end_seconds": 178.3,
      "duration_seconds": 5.45,
      "text": "Alright, so so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.91,
      "end_seconds": 189.6,
      "duration_seconds": 3.69,
      "text": "right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.22,
      "end_seconds": 196.68,
      "duration_seconds": 6.46,
      "text": "Telmisartan i take it 40 milligrams, once a day for my pressure"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 198.05,
      "end_seconds": 203.54,
      "duration_seconds": 5.49,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.57,
      "end_seconds": 214.67,
      "duration_seconds": 9.1,
      "text": "What conditions have you been treated for in the past? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.63,
      "end_seconds": 218.44,
      "duration_seconds": 2.81,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.17,
      "end_seconds": 232.34,
      "duration_seconds": 12.17,
      "text": "mm-hmm. Right, so high blood pressure is already on your record. We'll keep that in mind today. And what about leg swelling, cough or fever?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.61,
      "end_seconds": 242.01,
      "duration_seconds": 4.4,
      "text": "No leg swelling, cough or fever, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 245.91,
      "duration_seconds": 2.25,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.74,
      "end_seconds": 251.36,
      "duration_seconds": 3.62,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.31,
      "end_seconds": 274.12,
      "duration_seconds": 13.81,
      "text": "let me tell you where I've got to. It points towards a possible tear in the main artery. It could also be a heart attack, so we'll keep that open"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.26,
      "end_seconds": 277.33,
      "duration_seconds": 2.07,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.58,
      "end_seconds": 302.5,
      "duration_seconds": 23.92,
      "text": "I can't promise yet, but most people with a possible tear in the main artery do well once it's treated properly. I'm sending you for an urgent CT scan of the chest and abdomen because of tearing chest pain. Do get help quickly if the symptoms get worse. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.4,
      "end_seconds": 307.21,
      "duration_seconds": 2.81,
      "text": "Great, thank you for your help."
    }
  ]
}