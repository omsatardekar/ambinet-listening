{
  "schema_version": "1.0",
  "encounter_id": "01297",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 5.37,
      "duration_seconds": 4.31,
      "text": "Hi, sit anywhere you like. Alright, what's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.24,
      "end_seconds": 14.58,
      "duration_seconds": 8.34,
      "text": "So the thing is, I've got vomiting. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.13,
      "end_seconds": 17.87,
      "duration_seconds": 2.74,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.6,
      "end_seconds": 26.36,
      "duration_seconds": 6.76,
      "text": "Um, I'd say six months. Actually, no, closer to two months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.05,
      "end_seconds": 36.6,
      "duration_seconds": 8.55,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.45,
      "end_seconds": 51.07,
      "duration_seconds": 13.62,
      "text": "Um, uh, I'd say moderate. It happens every other day. I've never really been one for hospitals. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.02,
      "end_seconds": 69.42,
      "duration_seconds": 4.4,
      "text": "Let me check a few things. Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.22,
      "end_seconds": 73.46,
      "duration_seconds": 3.24,
      "text": "So, no, not a single one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.92,
      "end_seconds": 77.83,
      "duration_seconds": 2.91,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.59,
      "end_seconds": 82.5,
      "duration_seconds": 2.91,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 102.73,
      "duration_seconds": 3.98,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.24,
      "end_seconds": 107.28,
      "duration_seconds": 3.04,
      "text": "Right, no, nothing at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.38,
      "end_seconds": 111.52,
      "duration_seconds": 3.14,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.02,
      "end_seconds": 118.08,
      "duration_seconds": 2.06,
      "text": "No, um, never."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.76,
      "end_seconds": 121.24,
      "duration_seconds": 1.48,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.88,
      "end_seconds": 127.44,
      "duration_seconds": 4.56,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.29,
      "end_seconds": 131.62,
      "duration_seconds": 3.33,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.64,
      "end_seconds": 136.02,
      "duration_seconds": 3.38,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.51,
      "end_seconds": 141.62,
      "duration_seconds": 4.11,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.36,
      "end_seconds": 148.48,
      "duration_seconds": 6.12,
      "text": "My steroid tablets. I take it 5 milligrams, stopped last week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.04,
      "end_seconds": 150.8,
      "duration_seconds": 1.76,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.26,
      "end_seconds": 162.71,
      "duration_seconds": 2.45,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.85,
      "end_seconds": 172.77,
      "duration_seconds": 2.92,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.75,
      "end_seconds": 208.46,
      "duration_seconds": 13.71,
      "text": "Okay: height 167 centimetres, temp 36.8 degrees, weight 97 kilos, pulse 101, respiratory rate 18, BMI works out to 34.8, SpO2 99 percent on room air, BP is 93 over 61."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.85,
      "end_seconds": 211.55,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.86,
      "end_seconds": 217.02,
      "duration_seconds": 4.16,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.89,
      "end_seconds": 221.68,
      "duration_seconds": 2.79,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.03,
      "end_seconds": 224.23,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.42,
      "end_seconds": 245.81,
      "duration_seconds": 5.39,
      "text": "Your blood pressure is very low and your skin is cool."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.82,
      "end_seconds": 262.11,
      "duration_seconds": 13.29,
      "text": "Please sit back down. Putting it all together, it's hard to say. A possible adrenal crisis after stopping steroids is one possibility and a severe infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.81,
      "end_seconds": 264.92,
      "duration_seconds": 2.11,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.61,
      "end_seconds": 282.42,
      "duration_seconds": 15.81,
      "text": "It's reasonable to be concerned, but right now a possible adrenal crisis after stopping steroids is my leading thought, not anything worse. I'm sending you for blood tests because of adrenal crisis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 284.1,
      "end_seconds": 287.65,
      "duration_seconds": 3.55,
      "text": "I can book that for Wednesday at 10 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.37,
      "end_seconds": 290.44,
      "duration_seconds": 1.07,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.61,
      "end_seconds": 309.23,
      "duration_seconds": 17.62,
      "text": "You'll be taking hydrocortisone, 100 milligrams, once now, single dose. It's for adrenal crisis. I am giving an injection now and calling an ambulance. I'm going to send a referral to the emergency team. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.28,
      "end_seconds": 313.32,
      "duration_seconds": 3.04,
      "text": "Alright, um, I'll be back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.6,
      "end_seconds": 320.94,
      "duration_seconds": 3.34,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.87,
      "end_seconds": 328.72,
      "duration_seconds": 2.85,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.47,
      "end_seconds": 331.24,
      "duration_seconds": 1.77,
      "text": "Have a good day."
    }
  ]
}