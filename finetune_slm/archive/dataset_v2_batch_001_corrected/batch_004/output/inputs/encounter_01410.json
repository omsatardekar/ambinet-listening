{
  "schema_version": "1.0",
  "encounter_id": "01410",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.69,
      "duration_seconds": 4.16,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 12.15,
      "duration_seconds": 5.73,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 19.07,
      "duration_seconds": 6.21,
      "text": "Honestly, it's numbness in my feet, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.07,
      "end_seconds": 26.32,
      "duration_seconds": 3.25,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.89,
      "end_seconds": 40.45,
      "duration_seconds": 2.56,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.72,
      "end_seconds": 77.53,
      "duration_seconds": 15.81,
      "text": "Okay: pressure 114 over 78, pulse 71. And temp 36.6 degrees, respiratory rate 15, SpO2 98 percent on room air. Has this been going on for long? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.46,
      "end_seconds": 85.12,
      "duration_seconds": 5.66,
      "text": "Around about two weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.06,
      "end_seconds": 89.89,
      "duration_seconds": 2.83,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.34,
      "end_seconds": 94.23,
      "duration_seconds": 2.89,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.34,
      "end_seconds": 98.68,
      "duration_seconds": 3.34,
      "text": "Alright, does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.4,
      "end_seconds": 118.41,
      "duration_seconds": 19.01,
      "text": "Being unsteady in the dark goes along with it, most of the time. The being unsteady in the dark? That's been for four weeks. With being unsteady in the dark, only holding on, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.4,
      "end_seconds": 123.68,
      "duration_seconds": 4.28,
      "text": "A few quick ones: weakness, back pain or bladder problems?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.43,
      "end_seconds": 129.29,
      "duration_seconds": 4.86,
      "text": "I haven't had weakness, back pain or bladder problems, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.22,
      "end_seconds": 135.54,
      "duration_seconds": 4.32,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.73,
      "end_seconds": 141.38,
      "duration_seconds": 4.65,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.05,
      "end_seconds": 143.65,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.18,
      "end_seconds": 146.8,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.59,
      "end_seconds": 148.76,
      "duration_seconds": 1.17,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.11,
      "end_seconds": 154.09,
      "duration_seconds": 3.98,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.98,
      "end_seconds": 158.57,
      "duration_seconds": 2.59,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.89,
      "end_seconds": 166.21,
      "duration_seconds": 3.32,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.35,
      "end_seconds": 170.49,
      "duration_seconds": 3.14,
      "text": "Alright, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.89,
      "end_seconds": 175.05,
      "duration_seconds": 3.16,
      "text": "Ah, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.94,
      "end_seconds": 179.63,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.35,
      "end_seconds": 181.51,
      "duration_seconds": 1.16,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.13,
      "end_seconds": 198.78,
      "duration_seconds": 4.65,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.2,
      "end_seconds": 201.79,
      "duration_seconds": 1.59,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.0,
      "end_seconds": 217.72,
      "duration_seconds": 2.72,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.85,
      "end_seconds": 221.45,
      "duration_seconds": 2.6,
      "text": "Yes, I'm allergic to diclofenac."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.99,
      "end_seconds": 226.19,
      "duration_seconds": 2.2,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.86,
      "end_seconds": 246.42,
      "duration_seconds": 1.56,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 250.31,
      "duration_seconds": 2.34,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.84,
      "end_seconds": 266.99,
      "duration_seconds": 5.15,
      "text": "The ankle reflexes are reduced and the feeling is dulled below the knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.54,
      "end_seconds": 272.47,
      "duration_seconds": 1.93,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.75,
      "end_seconds": 287.05,
      "duration_seconds": 3.3,
      "text": "Let's get a nerve conduction study, for neuropathy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 290.64,
      "end_seconds": 295.65,
      "duration_seconds": 5.01,
      "text": "We have a slot Tuesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.78,
      "end_seconds": 311.66,
      "duration_seconds": 14.88,
      "text": "I'd like you to take amitriptyline, 10 milligrams, at night, long term. It's for nerve pain. Check both feet daily and wear well-fitting shoes. Book a review in four weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.32,
      "end_seconds": 315.38,
      "duration_seconds": 3.06,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.48,
      "end_seconds": 318.69,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}