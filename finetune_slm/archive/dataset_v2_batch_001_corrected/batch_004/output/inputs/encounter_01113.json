{
  "schema_version": "1.0",
  "encounter_id": "01113",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.59,
      "duration_seconds": 4.01,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.05,
      "end_seconds": 15.48,
      "duration_seconds": 5.43,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.52,
      "end_seconds": 24.34,
      "duration_seconds": 6.82,
      "text": "Mainly being thirsty. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.51,
      "end_seconds": 29.08,
      "duration_seconds": 3.57,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.68,
      "end_seconds": 34.29,
      "duration_seconds": 1.61,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 38.11,
      "duration_seconds": 2.09,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.6,
      "end_seconds": 48.14,
      "duration_seconds": 8.54,
      "text": "It usually comes with blurred vision at times. I've also been passing urine at night, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.46,
      "end_seconds": 54.35,
      "duration_seconds": 2.89,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.44,
      "end_seconds": 56.53,
      "duration_seconds": 1.09,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.21,
      "end_seconds": 60.4,
      "duration_seconds": 3.19,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.62,
      "end_seconds": 73.5,
      "duration_seconds": 2.88,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.21,
      "end_seconds": 103.89,
      "duration_seconds": 9.68,
      "text": "Okay: BP is 148 over 104, respiratory rate 18. And temp 37.0 degrees, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.17,
      "end_seconds": 109.35,
      "duration_seconds": 4.18,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 112.85,
      "duration_seconds": 1.95,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.19,
      "end_seconds": 131.27,
      "duration_seconds": 6.08,
      "text": "Your weight is up a little and there are no sores on your feet."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.33,
      "end_seconds": 138.2,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.38,
      "end_seconds": 161.58,
      "duration_seconds": 5.2,
      "text": "Let me check a few things. Any weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.54,
      "end_seconds": 165.59,
      "duration_seconds": 3.05,
      "text": "No, no weight loss or vomiting."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.1,
      "end_seconds": 170.0,
      "duration_seconds": 3.9,
      "text": "Yes, carry on. Have you had any abdominal pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.73,
      "end_seconds": 172.7,
      "duration_seconds": 1.97,
      "text": "Definitely no abdominal pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 177.64,
      "duration_seconds": 3.92,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.63,
      "end_seconds": 179.97,
      "duration_seconds": 1.34,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.33,
      "end_seconds": 183.89,
      "duration_seconds": 2.56,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.71,
      "end_seconds": 188.57,
      "duration_seconds": 2.86,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.23,
      "end_seconds": 190.48,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.34,
      "end_seconds": 193.57,
      "duration_seconds": 1.23,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.92,
      "end_seconds": 197.96,
      "duration_seconds": 3.04,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.26,
      "end_seconds": 215.65,
      "duration_seconds": 16.39,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. I grab fast food at lunch most days. I look after my grandchildren most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.44,
      "end_seconds": 220.09,
      "duration_seconds": 3.65,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.33,
      "end_seconds": 223.44,
      "duration_seconds": 2.11,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.78,
      "end_seconds": 244.83,
      "duration_seconds": 3.05,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.07,
      "end_seconds": 249.97,
      "duration_seconds": 3.9,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.52,
      "end_seconds": 259.03,
      "duration_seconds": 3.51,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.97,
      "end_seconds": 268.83,
      "duration_seconds": 3.86,
      "text": "Iron tablets. I take it once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.86,
      "end_seconds": 271.8,
      "duration_seconds": 1.94,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.84,
      "end_seconds": 278.66,
      "duration_seconds": 4.82,
      "text": "For six months. It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.96,
      "end_seconds": 298.39,
      "duration_seconds": 2.43,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.83,
      "end_seconds": 302.77,
      "duration_seconds": 2.94,
      "text": "I've had low haemoglobin, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.15,
      "end_seconds": 306.21,
      "duration_seconds": 2.06,
      "text": "Right, any other things?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.9,
      "end_seconds": 309.09,
      "duration_seconds": 1.19,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.65,
      "end_seconds": 342.11,
      "duration_seconds": 32.46,
      "text": "Alright, anxiety, that matches what I have here. From what you've told me and what I found, the most likely explanation is possible type 2 diabetes pending blood tests. Let's book a urine test to look into frequent urination. I'd rather check than guess, and this is the quickest way to know more. I'll want another look after the results. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.59,
      "end_seconds": 346.55,
      "duration_seconds": 2.96,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.36,
      "end_seconds": 348.57,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
