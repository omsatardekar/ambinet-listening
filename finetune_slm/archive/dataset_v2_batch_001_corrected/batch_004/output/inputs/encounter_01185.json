{
  "schema_version": "1.0",
  "encounter_id": "01185",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 4.86,
      "duration_seconds": 3.77,
      "text": "come in, have a seat by the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.31,
      "end_seconds": 9.16,
      "duration_seconds": 2.85,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.46,
      "end_seconds": 13.41,
      "duration_seconds": 2.95,
      "text": "what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.81,
      "end_seconds": 18.16,
      "duration_seconds": 3.35,
      "text": "I've been dealing with a mild cough."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.07,
      "duration_seconds": 2.88,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 27.0,
      "duration_seconds": 3.15,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.62,
      "end_seconds": 38.08,
      "duration_seconds": 9.46,
      "text": "tell me a bit more about it: how bad it gets, how often, and and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.82,
      "end_seconds": 46.42,
      "duration_seconds": 7.6,
      "text": "It's on and off. Mild, I'd say. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.6,
      "end_seconds": 64.46,
      "duration_seconds": 2.86,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.93,
      "end_seconds": 69.09,
      "duration_seconds": 3.16,
      "text": "no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.04,
      "end_seconds": 78.78,
      "duration_seconds": 4.74,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.19,
      "end_seconds": 83.39,
      "duration_seconds": 3.2,
      "text": "Yes, wheat. I get itchy skin."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.24,
      "end_seconds": 103.94,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.57,
      "end_seconds": 108.03,
      "duration_seconds": 3.46,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.8,
      "end_seconds": 111.57,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.19,
      "end_seconds": 114.76,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.28,
      "end_seconds": 117.11,
      "duration_seconds": 1.83,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.94,
      "end_seconds": 123.47,
      "duration_seconds": 4.53,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.12,
      "end_seconds": 128.98,
      "duration_seconds": 3.86,
      "text": "right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.95,
      "end_seconds": 133.23,
      "duration_seconds": 3.28,
      "text": "I have migraines, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.71,
      "end_seconds": 138.93,
      "duration_seconds": 4.22,
      "text": "Any shortness of breath, fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.91,
      "end_seconds": 146.52,
      "duration_seconds": 5.61,
      "text": "I haven't had shortness of breath, fever or chest pain, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.17,
      "end_seconds": 151.11,
      "duration_seconds": 2.94,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.13,
      "end_seconds": 154.47,
      "duration_seconds": 2.34,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 159.55,
      "duration_seconds": 3.37,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.56,
      "end_seconds": 162.3,
      "duration_seconds": 1.74,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.38,
      "end_seconds": 168.05,
      "duration_seconds": 3.67,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.38,
      "end_seconds": 181.2,
      "duration_seconds": 2.82,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.59,
      "end_seconds": 202.59,
      "duration_seconds": 9.0,
      "text": "Okay: temperature 36.8, SpO2 99 percent on room air. And blood pressure 126 over 81, pulse is 72 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.16,
      "end_seconds": 204.52,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.83,
      "end_seconds": 209.25,
      "duration_seconds": 3.42,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.24,
      "end_seconds": 215.43,
      "duration_seconds": 4.19,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.16,
      "end_seconds": 220.01,
      "duration_seconds": 2.85,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.22,
      "end_seconds": 236.54,
      "duration_seconds": 5.32,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.97,
      "end_seconds": 243.01,
      "duration_seconds": 3.04,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.81,
      "end_seconds": 261.8,
      "duration_seconds": 4.99,
      "text": "Putting it all together, this is probably a simple viral cold."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.52,
      "end_seconds": 264.08,
      "duration_seconds": 1.56,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.41,
      "end_seconds": 283.13,
      "duration_seconds": 17.72,
      "text": "I understand the worry. At the moment I'd say it's a simple viral cold, and we'll watch how it goes. Let me repeat that back to make sure. You've had a mild cough, since yesterday, mild, and no chest pain or fever."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.81,
      "end_seconds": 285.74,
      "duration_seconds": 1.93,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.37,
      "end_seconds": 302.52,
      "duration_seconds": 16.15,
      "text": "rest, plenty of fluids, and paracetamol if you ache. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Let's plan a check if it is not better in ten days"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.07,
      "end_seconds": 307.61,
      "duration_seconds": 3.54,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.53,
      "end_seconds": 312.85,
      "duration_seconds": 3.32,
      "text": "I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.73,
      "end_seconds": 316.63,
      "duration_seconds": 2.9,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.97,
      "end_seconds": 320.1,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}