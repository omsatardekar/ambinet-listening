{
  "schema_version": "1.0",
  "encounter_id": "01206",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 5.1,
      "duration_seconds": 3.91,
      "text": "Ah, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.64,
      "end_seconds": 10.74,
      "duration_seconds": 5.1,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.19,
      "end_seconds": 21.87,
      "duration_seconds": 6.68,
      "text": "Let me think, I've been dealing with high fevers every other day."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.21,
      "end_seconds": 25.57,
      "duration_seconds": 2.36,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.17,
      "end_seconds": 36.21,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.76,
      "end_seconds": 55.5,
      "duration_seconds": 8.74,
      "text": "Okay: heart rate 96, pressure 111 over 67, temp 38.3 degrees. And SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.27,
      "end_seconds": 58.78,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.48,
      "end_seconds": 67.01,
      "duration_seconds": 7.53,
      "text": "Don't worry, we'll discuss it in a second. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.32,
      "end_seconds": 74.26,
      "duration_seconds": 1.94,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.84,
      "end_seconds": 79.18,
      "duration_seconds": 4.34,
      "text": "Yes. Alright, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.17,
      "end_seconds": 98.63,
      "duration_seconds": 17.46,
      "text": "When it starts I tend to get a severe headache as well. Right, the severe headache? That's been for about a month. About severe headache, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.59,
      "end_seconds": 104.23,
      "duration_seconds": 3.64,
      "text": "Right, have you noticed cough, diarrhoea or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.1,
      "end_seconds": 109.0,
      "duration_seconds": 2.9,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 114.18,
      "duration_seconds": 4.12,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.49,
      "end_seconds": 118.14,
      "duration_seconds": 2.65,
      "text": "Nothing unusual, uh, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 122.65,
      "duration_seconds": 3.02,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.71,
      "end_seconds": 126.18,
      "duration_seconds": 2.47,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.01,
      "end_seconds": 131.58,
      "duration_seconds": 3.57,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.56,
      "end_seconds": 148.19,
      "duration_seconds": 12.63,
      "text": "I've never touched a cigarette. I drink a lot of tea and snack through the day. I hardly move around during the day. My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.23,
      "end_seconds": 156.6,
      "duration_seconds": 2.37,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.55,
      "end_seconds": 161.78,
      "duration_seconds": 3.23,
      "text": "Oh, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.67,
      "end_seconds": 176.9,
      "duration_seconds": 4.23,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.6,
      "end_seconds": 179.37,
      "duration_seconds": 1.77,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.17,
      "end_seconds": 202.59,
      "duration_seconds": 4.42,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.6,
      "end_seconds": 206.87,
      "duration_seconds": 2.27,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.27,
      "end_seconds": 209.62,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.27,
      "end_seconds": 214.13,
      "duration_seconds": 2.86,
      "text": "No surgery, um, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.69,
      "end_seconds": 217.67,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.22,
      "end_seconds": 220.3,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.36,
      "end_seconds": 223.48,
      "duration_seconds": 2.12,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.89,
      "end_seconds": 244.91,
      "duration_seconds": 4.02,
      "text": "You are hot and jaundiced, and your spleen is tender."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.7,
      "end_seconds": 252.77,
      "duration_seconds": 2.07,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.51,
      "end_seconds": 275.63,
      "duration_seconds": 7.12,
      "text": "Let me tell you where I've got to. This looks most like possible malaria after travel."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.43,
      "end_seconds": 279.29,
      "duration_seconds": 2.86,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.91,
      "end_seconds": 290.5,
      "duration_seconds": 9.59,
      "text": "I understand the worry. At the moment I'd say it's possible malaria after travel, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.23,
      "end_seconds": 317.63,
      "duration_seconds": 9.4,
      "text": "Let's book blood tests to look into fever after travel. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.15,
      "end_seconds": 322.3,
      "duration_seconds": 4.15,
      "text": "We have a slot Monday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.1,
      "end_seconds": 326.96,
      "duration_seconds": 2.86,
      "text": "Um, okay, I'll be there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.03,
      "end_seconds": 332.79,
      "duration_seconds": 4.76,
      "text": "You need hospital assessment today, this can become serious fast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.06,
      "end_seconds": 341.13,
      "duration_seconds": 8.07,
      "text": "Yes. I'd like you to see the infectious diseases team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.65,
      "end_seconds": 346.68,
      "duration_seconds": 4.03,
      "text": "Sure, you know, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.06,
      "end_seconds": 354.78,
      "duration_seconds": 6.72,
      "text": "Do get help quickly if the symptoms get worse. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.71,
      "end_seconds": 360.33,
      "duration_seconds": 3.62,
      "text": "Ah, I think I understand everything. Thanks."
    }
  ]
}