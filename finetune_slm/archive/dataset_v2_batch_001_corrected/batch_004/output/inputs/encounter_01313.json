{
  "schema_version": "1.0",
  "encounter_id": "01313",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.19,
      "duration_seconds": 3.86,
      "text": "I mean, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 12.13,
      "duration_seconds": 4.98,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.84,
      "end_seconds": 19.59,
      "duration_seconds": 5.75,
      "text": "It's a missed period. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.16,
      "end_seconds": 28.58,
      "duration_seconds": 2.42,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.99,
      "end_seconds": 42.0,
      "duration_seconds": 12.01,
      "text": "Ever since... since Friday, really. I'd rather not end up on lots of tablets if I can avoid it. I've also had tender breasts."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.29,
      "end_seconds": 57.58,
      "duration_seconds": 4.29,
      "text": "A few quick ones: vomiting everything, severe pain or bleeding?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.15,
      "end_seconds": 62.94,
      "duration_seconds": 4.79,
      "text": "I haven't had vomiting everything, severe pain or bleeding, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.37,
      "end_seconds": 66.76,
      "duration_seconds": 2.39,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.94,
      "end_seconds": 69.98,
      "duration_seconds": 2.04,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.6,
      "end_seconds": 75.57,
      "duration_seconds": 3.97,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.51,
      "end_seconds": 91.85,
      "duration_seconds": 15.34,
      "text": "I take escitalopram, 10 milligrams, once a day. A folic acid tablet. I take it 400 micrograms, once a day. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 98.84,
      "duration_seconds": 2.83,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.7,
      "end_seconds": 105.69,
      "duration_seconds": 5.99,
      "text": "Anxiety, for two years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.18,
      "end_seconds": 127.45,
      "duration_seconds": 4.27,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.34,
      "end_seconds": 133.39,
      "duration_seconds": 4.05,
      "text": "Yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.13,
      "end_seconds": 136.48,
      "duration_seconds": 2.35,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.82,
      "end_seconds": 155.54,
      "duration_seconds": 13.72,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. I'm a bus driver, so I sit for long hours. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.76,
      "end_seconds": 157.97,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.8,
      "end_seconds": 160.97,
      "duration_seconds": 2.17,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.82,
      "end_seconds": 164.42,
      "duration_seconds": 2.6,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.15,
      "end_seconds": 179.15,
      "duration_seconds": 2.0,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.91,
      "end_seconds": 196.35,
      "duration_seconds": 6.44,
      "text": "Okay: heart rate 77, temperature 36.9, pressure 111 over 72. And respiratory rate 18."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.48,
      "end_seconds": 199.73,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.48,
      "end_seconds": 203.06,
      "duration_seconds": 2.58,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.21,
      "end_seconds": 209.43,
      "duration_seconds": 4.22,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.42,
      "end_seconds": 212.79,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.72,
      "end_seconds": 227.05,
      "duration_seconds": 2.33,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.22,
      "end_seconds": 230.98,
      "duration_seconds": 1.76,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 251.81,
      "duration_seconds": 5.22,
      "text": "Taking everything into account, this is probably a normal early pregnancy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.12,
      "end_seconds": 279.78,
      "duration_seconds": 9.66,
      "text": "I'd like to arrange a booking blood test for pregnancy. I'd like to arrange a pregnancy test for missed period."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.89,
      "end_seconds": 282.58,
      "duration_seconds": 1.69,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.23,
      "end_seconds": 298.83,
      "duration_seconds": 15.6,
      "text": "Keep taking folic acid and book in with the midwife. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I'd like you back in four weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.92,
      "end_seconds": 302.01,
      "duration_seconds": 2.09,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.53,
      "end_seconds": 307.22,
      "duration_seconds": 4.69,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.34,
      "end_seconds": 312.13,
      "duration_seconds": 3.79,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.71,
      "end_seconds": 313.94,
      "duration_seconds": 1.23,
      "text": "All the best."
    }
  ]
}