{
  "schema_version": "1.0",
  "encounter_id": "01194",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.64,
      "end_seconds": 7.52,
      "duration_seconds": 6.88,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.79,
      "end_seconds": 17.16,
      "duration_seconds": 4.37,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.5,
      "end_seconds": 23.5,
      "duration_seconds": 5.0,
      "text": "Yeah, uh, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.02,
      "end_seconds": 40.36,
      "duration_seconds": 15.34,
      "text": "So the thing is, I've got shaking chills and a high temperature. I've been reading about it online and it worried me. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.95,
      "end_seconds": 42.28,
      "duration_seconds": 1.33,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.84,
      "end_seconds": 51.14,
      "duration_seconds": 7.3,
      "text": "Um, around about two weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.08,
      "end_seconds": 54.09,
      "duration_seconds": 2.01,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.2,
      "end_seconds": 70.5,
      "duration_seconds": 15.3,
      "text": "Actually, it usually comes with a racing heart. As for racing heart, it's once or twice a day. I'd been feeling confused, but that went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.16,
      "end_seconds": 72.33,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.07,
      "end_seconds": 76.48,
      "duration_seconds": 2.41,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.38,
      "end_seconds": 79.75,
      "duration_seconds": 2.37,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.66,
      "end_seconds": 85.6,
      "duration_seconds": 4.94,
      "text": "Let me think, I've never had an allergy."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.95,
      "end_seconds": 90.63,
      "duration_seconds": 3.68,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.87,
      "end_seconds": 104.13,
      "duration_seconds": 12.26,
      "text": "Yeah, I have an irregular heartbeat. I'm not great at remembering details, so bear with me. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.02,
      "end_seconds": 106.32,
      "duration_seconds": 1.3,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.45,
      "end_seconds": 115.0,
      "duration_seconds": 5.55,
      "text": "Arthritis in my knees, for nearly five years. I've got anxiety."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.06,
      "end_seconds": 130.45,
      "duration_seconds": 2.39,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.71,
      "end_seconds": 136.23,
      "duration_seconds": 4.52,
      "text": "Okay, so it's diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 140.76,
      "end_seconds": 151.62,
      "duration_seconds": 10.86,
      "text": "Oh, doctor, I think the last prescription for the diclofenac was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.42,
      "end_seconds": 155.48,
      "duration_seconds": 3.06,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.4,
      "end_seconds": 164.61,
      "duration_seconds": 8.21,
      "text": "Not with me. I'll bring it next time. It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 165.72,
      "end_seconds": 173.86,
      "duration_seconds": 8.14,
      "text": "That's what's prescribed, uh, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.52,
      "end_seconds": 177.1,
      "duration_seconds": 2.58,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.78,
      "end_seconds": 193.93,
      "duration_seconds": 16.15,
      "text": "I smoke roughly a pack every two days. My partner and our baby. I retired from the post office two years ago. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.0,
      "end_seconds": 214.15,
      "duration_seconds": 5.15,
      "text": "Alright, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.38,
      "end_seconds": 223.75,
      "duration_seconds": 6.37,
      "text": "I mean, my son has asthma. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.04,
      "end_seconds": 231.2,
      "duration_seconds": 6.16,
      "text": "Let me check a few things. Any stiff neck, rash or chest pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.26,
      "end_seconds": 237.96,
      "duration_seconds": 5.7,
      "text": "No stiff neck, rash or chest pain, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.94,
      "end_seconds": 242.64,
      "duration_seconds": 2.7,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 243.28,
      "end_seconds": 246.77,
      "duration_seconds": 3.49,
      "text": "Actually, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 265.01,
      "end_seconds": 273.72,
      "duration_seconds": 8.71,
      "text": "Here are the numbers, doctor. Temp 38.7 degrees, heart rate 89, pressure 107 over 76, saturation 95 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.37,
      "end_seconds": 275.76,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.94,
      "end_seconds": 281.91,
      "duration_seconds": 3.97,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.35,
      "end_seconds": 284.96,
      "duration_seconds": 1.61,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.84,
      "end_seconds": 287.82,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.13,
      "end_seconds": 303.92,
      "duration_seconds": 6.79,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.33,
      "end_seconds": 341.74,
      "duration_seconds": 33.41,
      "text": "Okay, that's the examination finished. From what you've told me and what I found, it fits best with possible sepsis needing urgent treatment. It could also be a severe urine or chest infection, so we'll keep that open. I'm sending you for blood cultures because of fever with low blood pressure. I'll request lactate and blood tests, it'll help with sepsis. I want to admit you to hospital now for fluids and antibiotics."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.04,
      "end_seconds": 355.02,
      "duration_seconds": 11.98,
      "text": "I'll also refer you to the emergency team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 357.05,
      "end_seconds": 361.93,
      "duration_seconds": 4.88,
      "text": "Uh, can you send me for a chest X-ray?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.41,
      "end_seconds": 370.58,
      "duration_seconds": 7.17,
      "text": "Not at this point, no. It isn't indicated yet. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.34,
      "end_seconds": 375.47,
      "duration_seconds": 4.13,
      "text": "Right, um, alright, thanks, take care."
    }
  ]
}