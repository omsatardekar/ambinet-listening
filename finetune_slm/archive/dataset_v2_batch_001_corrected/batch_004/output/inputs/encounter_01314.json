{
  "schema_version": "1.0",
  "encounter_id": "01314",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.14,
      "duration_seconds": 3.04,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 9.85,
      "duration_seconds": 3.69,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.97,
      "end_seconds": 16.53,
      "duration_seconds": 5.56,
      "text": "Yeah, it's a sore throat. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.88,
      "end_seconds": 19.14,
      "duration_seconds": 1.26,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.99,
      "end_seconds": 23.58,
      "duration_seconds": 3.59,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.8,
      "end_seconds": 34.88,
      "duration_seconds": 10.08,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.99,
      "end_seconds": 47.07,
      "duration_seconds": 11.08,
      "text": "Mostly severe. It's worse with swallowing. I've had a mild cough too, for one week. As for mild cough, I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.84,
      "end_seconds": 51.42,
      "duration_seconds": 2.58,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.82,
      "end_seconds": 61.21,
      "duration_seconds": 4.39,
      "text": "It's metoprolol, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.67,
      "end_seconds": 64.93,
      "duration_seconds": 2.26,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.9,
      "end_seconds": 70.79,
      "duration_seconds": 4.89,
      "text": "50 milligrams. I take paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.49,
      "end_seconds": 86.1,
      "duration_seconds": 2.61,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.61,
      "end_seconds": 90.12,
      "duration_seconds": 2.51,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.73,
      "end_seconds": 100.8,
      "duration_seconds": 9.07,
      "text": "Hm, okay. Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.5,
      "end_seconds": 106.2,
      "duration_seconds": 3.7,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.82,
      "end_seconds": 110.21,
      "duration_seconds": 2.39,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.93,
      "end_seconds": 114.6,
      "duration_seconds": 3.67,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.2,
      "end_seconds": 127.79,
      "duration_seconds": 3.59,
      "text": "A few quick ones: chest pain or confusion?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.6,
      "end_seconds": 134.84,
      "duration_seconds": 3.24,
      "text": "No, no chest pain or confusion."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.14,
      "end_seconds": 140.4,
      "duration_seconds": 1.26,
      "text": "What about breathlessness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.69,
      "end_seconds": 143.25,
      "duration_seconds": 1.56,
      "text": "No, no breathlessness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.17,
      "end_seconds": 148.06,
      "duration_seconds": 2.89,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.74,
      "end_seconds": 150.38,
      "duration_seconds": 1.64,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 168.3,
      "duration_seconds": 3.34,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.53,
      "end_seconds": 177.89,
      "duration_seconds": 2.36,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.86,
      "end_seconds": 203.47,
      "duration_seconds": 13.61,
      "text": "Okay: pressure 124 over 69, height 173 centimetres, weight 66 kilos, saturation 97 percent, temperature is 36.8 degrees, BMI works out to 22.1, pulse 86."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.66,
      "end_seconds": 207.84,
      "duration_seconds": 2.18,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.62,
      "end_seconds": 210.32,
      "duration_seconds": 1.7,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.65,
      "end_seconds": 214.4,
      "duration_seconds": 2.75,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.28,
      "end_seconds": 230.67,
      "duration_seconds": 4.39,
      "text": "Your oxygen is normal and your chest is clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.87,
      "end_seconds": 249.07,
      "duration_seconds": 14.2,
      "text": "Please sit back down. Okay, thinking it through, I'd lean towards a mild viral respiratory infection. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.67,
      "end_seconds": 251.5,
      "duration_seconds": 1.83,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 265.97,
      "duration_seconds": 13.9,
      "text": "I can't promise yet, but most people with a mild viral respiratory infection do well once it's treated properly. I think a COVID test makes sense here, for respiratory symptoms."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 266.98,
      "end_seconds": 272.24,
      "duration_seconds": 5.26,
      "text": "We have a slot Tuesday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.11,
      "end_seconds": 277.0,
      "duration_seconds": 2.89,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.63,
      "end_seconds": 295.77,
      "duration_seconds": 18.14,
      "text": "Rest, fluids, and stay home until you feel well and the fever has settled. If you become breathless, that's the point to come in urgently. I'd like to see you again if not improving in a week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.29,
      "end_seconds": 303.28,
      "duration_seconds": 3.99,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.42,
      "end_seconds": 310.68,
      "duration_seconds": 1.26,
      "text": "All the best."
    }
  ]
}