{
  "schema_version": "1.0",
  "encounter_id": "01115",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.18,
      "end_seconds": 5.75,
      "duration_seconds": 4.57,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.49,
      "end_seconds": 10.91,
      "duration_seconds": 4.42,
      "text": "thank you. Good morning, tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.09,
      "end_seconds": 20.42,
      "duration_seconds": 8.33,
      "text": "Doctor, I'm just here to help with the details. She's been having light vaginal bleeding, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.01,
      "end_seconds": 22.98,
      "duration_seconds": 1.97,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.06,
      "end_seconds": 27.14,
      "duration_seconds": 2.08,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.13,
      "end_seconds": 33.35,
      "duration_seconds": 5.22,
      "text": "I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 33.45,
      "end_seconds": 40.94,
      "duration_seconds": 7.49,
      "text": "Sorry to to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.18,
      "end_seconds": 54.8,
      "duration_seconds": 7.62,
      "text": "Later, thanks. Please go on. What about sharp pain low on one side, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.7,
      "end_seconds": 56.8,
      "duration_seconds": 1.1,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.69,
      "end_seconds": 68.26,
      "duration_seconds": 9.57,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.23,
      "end_seconds": 74.82,
      "duration_seconds": 4.59,
      "text": "It feels severe to me. I'd say on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.83,
      "end_seconds": 94.96,
      "duration_seconds": 2.13,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.4,
      "end_seconds": 100.93,
      "duration_seconds": 4.53,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.95,
      "end_seconds": 107.36,
      "duration_seconds": 4.41,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.42,
      "end_seconds": 114.04,
      "duration_seconds": 4.62,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.67,
      "end_seconds": 118.02,
      "duration_seconds": 3.35,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.01,
      "end_seconds": 127.98,
      "duration_seconds": 8.97,
      "text": "Thyronorm i take it 50 micrograms, every morning it's allopurinol, 100 milligrams, once a day for the gout"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.15,
      "end_seconds": 136.71,
      "duration_seconds": 7.56,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.25,
      "end_seconds": 140.7,
      "duration_seconds": 2.45,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.66,
      "end_seconds": 156.14,
      "duration_seconds": 13.48,
      "text": "For the blood thinning, I believe. My son sets them out for me, I just take what I'm given. Metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 157.53,
      "end_seconds": 167.71,
      "duration_seconds": 10.18,
      "text": "Doctor, I think the last prescription for the metoprolol was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.06,
      "end_seconds": 173.14,
      "duration_seconds": 4.08,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.18,
      "end_seconds": 177.24,
      "duration_seconds": 3.06,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.93,
      "end_seconds": 183.0,
      "duration_seconds": 4.07,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.16,
      "end_seconds": 189.18,
      "duration_seconds": 2.02,
      "text": "my brother has epilepsy"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.06,
      "end_seconds": 209.68,
      "duration_seconds": 2.62,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.07,
      "end_seconds": 231.41,
      "duration_seconds": 20.34,
      "text": "I have an underactive thyroid, for nearly five years i have gout, for about a year i took the morning off to come in today i've had an irregular heartbeat, yes i've had heart failure, yes"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.08,
      "end_seconds": 240.25,
      "duration_seconds": 8.17,
      "text": "yes, an irregular heartbeat is known to us, good to have that that clear. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.17,
      "end_seconds": 244.2,
      "duration_seconds": 3.03,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.48,
      "end_seconds": 249.4,
      "duration_seconds": 3.92,
      "text": "have you had vaginal discharge, by any chance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 254.09,
      "duration_seconds": 3.38,
      "text": "No, uh, no vaginal discharge."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.11,
      "end_seconds": 260.38,
      "duration_seconds": 2.27,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.63,
      "end_seconds": 267.09,
      "duration_seconds": 1.46,
      "text": "no fever, thankfully"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 268.07,
      "end_seconds": 273.13,
      "duration_seconds": 5.06,
      "text": "actually, doctor, I did notice fever she doesn't always say"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 274.9,
      "end_seconds": 280.92,
      "duration_seconds": 6.02,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.63,
      "end_seconds": 287.15,
      "duration_seconds": 4.52,
      "text": "Alright, I'll note both what you've said and what you've noticed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.33,
      "end_seconds": 297.38,
      "duration_seconds": 6.05,
      "text": "I was feeling faint at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.33,
      "end_seconds": 302.38,
      "duration_seconds": 4.05,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 303.3,
      "end_seconds": 305.2,
      "duration_seconds": 1.9,
      "text": "nothing like that that"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 310.43,
      "end_seconds": 326.88,
      "duration_seconds": 16.45,
      "text": "Okay, so the vitals from earlier. SpO2 96 percent on room air, respiratory rate 19, temperature 36.6, height 173 centimetres, weight 97 kilos, blood pressure 127 over 84, pulse is 104 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.59,
      "end_seconds": 328.52,
      "duration_seconds": 0.93,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.09,
      "end_seconds": 332.18,
      "duration_seconds": 2.09,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.01,
      "end_seconds": 335.48,
      "duration_seconds": 2.47,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.94,
      "end_seconds": 350.36,
      "duration_seconds": 5.42,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.93,
      "end_seconds": 377.25,
      "duration_seconds": 24.32,
      "text": "Good, you can sit up again. Taking everything into account, it points towards a possible ectopic pregnancy. The reason I say that is that your story and my examination fit together. A ruptured ovarian cyst is also on my list. Let me just check I've got this right. You've had light vaginal bleeding for three days, and no vaginal discharge."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.43,
      "end_seconds": 379.95,
      "duration_seconds": 1.52,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 386.22,
      "end_seconds": 389.79,
      "duration_seconds": 3.57,
      "text": "We've already done a pregnancy test this morning, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.7,
      "end_seconds": 410.41,
      "duration_seconds": 18.71,
      "text": "Thanks, I'll have a look. I think an urgent pelvic scan makes sense here, for possible ectopic. You need to go to the hospital now for an emergency scan. Let's get you seen by the gynaecology team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.76,
      "end_seconds": 413.47,
      "duration_seconds": 1.71,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.51,
      "end_seconds": 427.75,
      "duration_seconds": 12.24,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose we'll catch up straight away does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 429.58,
      "end_seconds": 431.8,
      "duration_seconds": 2.22,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.6,
      "end_seconds": 435.38,
      "duration_seconds": 1.78,
      "text": "All the the best."
    }
  ]
}