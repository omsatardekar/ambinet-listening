{
  "schema_version": "1.0",
  "encounter_id": "01347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 5.64,
      "duration_seconds": 4.24,
      "text": "Hello, um, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 10.78,
      "duration_seconds": 3.83,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.02,
      "end_seconds": 17.46,
      "duration_seconds": 5.44,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.74,
      "end_seconds": 22.4,
      "duration_seconds": 3.66,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.13,
      "end_seconds": 31.3,
      "duration_seconds": 7.17,
      "text": "I wanted to get a red hot swelling on my leg looked at"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.0,
      "end_seconds": 36.75,
      "duration_seconds": 3.75,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.93,
      "end_seconds": 41.74,
      "duration_seconds": 3.81,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.51,
      "end_seconds": 46.87,
      "duration_seconds": 3.36,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.27,
      "end_seconds": 51.09,
      "duration_seconds": 2.82,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.56,
      "end_seconds": 55.21,
      "duration_seconds": 2.65,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.03,
      "end_seconds": 79.4,
      "duration_seconds": 22.37,
      "text": "I'd say a couple of times a week. I've had a high fever too, for about a month. Oh, and pain much worse than it looks. That's been about the same, about three months. As for pain much worse than it looks, it happens a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.74,
      "end_seconds": 84.01,
      "duration_seconds": 3.27,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.77,
      "end_seconds": 100.13,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 132.49,
      "duration_seconds": 10.59,
      "text": "Okay: blood pressure 109 over 74, respiratory rate 20, SpO2 97 percent on room air, temperature is 39.0 degrees, heart rate 88."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.06,
      "end_seconds": 134.7,
      "duration_seconds": 1.64,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.22,
      "end_seconds": 138.96,
      "duration_seconds": 2.74,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.4,
      "end_seconds": 143.33,
      "duration_seconds": 2.93,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.12,
      "end_seconds": 147.13,
      "duration_seconds": 2.01,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 170.23,
      "duration_seconds": 8.22,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.56,
      "end_seconds": 174.66,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.18,
      "end_seconds": 189.21,
      "duration_seconds": 3.03,
      "text": "and what about insect bite or cut?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.16,
      "end_seconds": 199.89,
      "duration_seconds": 4.73,
      "text": "No, um, I haven't had any of them."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 202.76,
      "duration_seconds": 2.16,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.08,
      "end_seconds": 210.56,
      "duration_seconds": 2.48,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.72,
      "end_seconds": 216.18,
      "duration_seconds": 4.46,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.28,
      "end_seconds": 221.12,
      "duration_seconds": 2.84,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.07,
      "end_seconds": 237.99,
      "duration_seconds": 4.92,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.47,
      "end_seconds": 250.11,
      "duration_seconds": 10.64,
      "text": "I hardly move around during the day. My partner and our baby. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 259.23,
      "duration_seconds": 7.36,
      "text": "Okay, which medicines do you take at the moment? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.61,
      "end_seconds": 268.89,
      "duration_seconds": 4.28,
      "text": "Before this I was on Glycomet; that's been stopped."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.81,
      "end_seconds": 273.26,
      "duration_seconds": 2.45,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.51,
      "end_seconds": 276.9,
      "duration_seconds": 2.39,
      "text": "Diabetes, for about a year"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.07,
      "end_seconds": 289.22,
      "duration_seconds": 3.15,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.21,
      "end_seconds": 295.54,
      "duration_seconds": 5.33,
      "text": "Okay, so yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.96,
      "end_seconds": 306.97,
      "duration_seconds": 10.01,
      "text": "from what you've told me and what I found, it fits best with a severe deep skin infection needing urgent surgery review"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.93,
      "end_seconds": 310.34,
      "duration_seconds": 2.41,
      "text": "Ah, will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.12,
      "end_seconds": 340.97,
      "duration_seconds": 26.85,
      "text": "Nothing I've seen today points to an emergency. It looks like a severe deep skin infection needing urgent surgery review, but I'd like to confirm. I'll request urgent blood tests, it'll help with severe skin infection. I'd rather check than guess, and this is the quickest way to know more. I am sending you to hospital now, do not wait. We'll refer you to the surgical team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.48,
      "end_seconds": 348.15,
      "duration_seconds": 5.67,
      "text": "Please don't wait if you cannot go now. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.99,
      "end_seconds": 351.57,
      "duration_seconds": 1.58,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.67,
      "end_seconds": 355.28,
      "duration_seconds": 2.61,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.16,
      "end_seconds": 360.31,
      "duration_seconds": 4.15,
      "text": "great, um, thank you for your help"
    }
  ]
}