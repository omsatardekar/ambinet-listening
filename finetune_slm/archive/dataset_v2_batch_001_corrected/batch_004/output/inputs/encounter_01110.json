{
  "schema_version": "1.0",
  "encounter_id": "01110",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 6.23,
      "duration_seconds": 4.99,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.0,
      "end_seconds": 12.36,
      "duration_seconds": 4.36,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.09,
      "end_seconds": 27.36,
      "duration_seconds": 13.27,
      "text": "Doctor, I've come along because I know the history, if it helps. Sorry, what was I saying, doctor, it's vomiting blood. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.45,
      "end_seconds": 30.67,
      "duration_seconds": 2.22,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.41,
      "end_seconds": 41.1,
      "duration_seconds": 2.69,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.68,
      "end_seconds": 64.89,
      "duration_seconds": 9.21,
      "text": "Okay: respiratory rate 18, blood pressure 127 over 77. And oxygen saturation is 96 percent, pulse is 108 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.95,
      "end_seconds": 67.45,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.2,
      "end_seconds": 75.07,
      "duration_seconds": 5.87,
      "text": "Don't worry, we'll discuss it in a second. When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.14,
      "end_seconds": 79.87,
      "duration_seconds": 3.73,
      "text": "Um, about two weeks, give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 80.42,
      "end_seconds": 84.46,
      "duration_seconds": 4.04,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.7,
      "end_seconds": 90.17,
      "duration_seconds": 4.47,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.03,
      "end_seconds": 94.61,
      "duration_seconds": 2.58,
      "text": "Well, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.41,
      "end_seconds": 101.51,
      "duration_seconds": 5.1,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.19,
      "end_seconds": 107.87,
      "duration_seconds": 5.68,
      "text": "It happens a couple of times a week. Moderate, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.75,
      "end_seconds": 112.28,
      "duration_seconds": 2.53,
      "text": "Has there been stomach pain too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.31,
      "end_seconds": 130.58,
      "duration_seconds": 16.27,
      "text": "Yeah. About a month, I'd say. About stomach pain, severe, I'd say. And I've been feeling faint as well. Well, with feeling faint, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.29,
      "end_seconds": 134.39,
      "duration_seconds": 2.1,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.94,
      "end_seconds": 141.29,
      "duration_seconds": 5.35,
      "text": "I mean, uh, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.2,
      "end_seconds": 145.63,
      "duration_seconds": 2.43,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.84,
      "end_seconds": 149.17,
      "duration_seconds": 2.33,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.09,
      "end_seconds": 152.45,
      "duration_seconds": 2.36,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 155.71,
      "duration_seconds": 1.55,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.28,
      "end_seconds": 160.73,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.34,
      "end_seconds": 164.28,
      "duration_seconds": 2.94,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.15,
      "end_seconds": 182.38,
      "duration_seconds": 7.23,
      "text": "Okay, has anyone ever diagnosed you with something? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.64,
      "end_seconds": 206.34,
      "duration_seconds": 19.7,
      "text": "Yes, migraines. I wasn't sure whether to come in at all, to be honest. I have depression, for about a year. My family kept telling me to get it checked. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.78,
      "end_seconds": 211.02,
      "duration_seconds": 1.24,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.46,
      "end_seconds": 216.47,
      "duration_seconds": 4.01,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.96,
      "end_seconds": 219.36,
      "duration_seconds": 1.4,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.76,
      "end_seconds": 223.88,
      "duration_seconds": 3.12,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.86,
      "end_seconds": 228.17,
      "duration_seconds": 2.31,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.87,
      "end_seconds": 235.03,
      "duration_seconds": 6.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 240.75,
      "duration_seconds": 3.84,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.97,
      "end_seconds": 245.23,
      "duration_seconds": 3.26,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.03,
      "end_seconds": 253.03,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.17,
      "end_seconds": 258.65,
      "duration_seconds": 4.48,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.34,
      "end_seconds": 261.58,
      "duration_seconds": 2.24,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.38,
      "end_seconds": 273.11,
      "duration_seconds": 6.73,
      "text": "I take sumatriptan, 50 milligrams, when needed. Mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 274.56,
      "end_seconds": 284.38,
      "duration_seconds": 9.82,
      "text": "Erm, doctor, I think the last prescription for the mirtazapine was 7.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.13,
      "end_seconds": 290.3,
      "duration_seconds": 4.17,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.2,
      "end_seconds": 296.71,
      "duration_seconds": 4.51,
      "text": "Right, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.1,
      "end_seconds": 303.17,
      "duration_seconds": 5.07,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.77,
      "end_seconds": 306.62,
      "duration_seconds": 2.85,
      "text": "Yes, I'm allergic to cat fur."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.57,
      "end_seconds": 314.11,
      "duration_seconds": 4.54,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.41,
      "end_seconds": 324.18,
      "duration_seconds": 1.77,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.29,
      "end_seconds": 327.28,
      "duration_seconds": 1.99,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.18,
      "end_seconds": 342.68,
      "duration_seconds": 6.5,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.77,
      "end_seconds": 359.05,
      "duration_seconds": 14.28,
      "text": "You can sit up now. Let me tell you where I've got to. This is probably a possible bleeding stomach ulcer. A bleed from the gullet is still possible."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.58,
      "end_seconds": 362.51,
      "duration_seconds": 1.93,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.35,
      "end_seconds": 372.78,
      "duration_seconds": 8.43,
      "text": "It's reasonable to be concerned, but right now a possible bleeding stomach ulcer is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.98,
      "end_seconds": 402.45,
      "duration_seconds": 13.47,
      "text": "I'm sending you for urgent blood tests because of bleeding. That will help us see what's going on underneath and decide the next step. Let's get an endoscopy, for bleeding."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.0,
      "end_seconds": 405.5,
      "duration_seconds": 1.5,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.89,
      "end_seconds": 421.32,
      "duration_seconds": 14.43,
      "text": "Please stop the ibuprofen and do not eat or drink. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.49,
      "end_seconds": 424.01,
      "duration_seconds": 1.52,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.26,
      "end_seconds": 434.13,
      "duration_seconds": 6.87,
      "text": "Let's review you straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.39,
      "end_seconds": 438.78,
      "duration_seconds": 3.39,
      "text": "Oh, great, thank you for your help."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.4,
      "end_seconds": 441.72,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
}