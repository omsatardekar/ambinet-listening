{
  "schema_version": "1.0",
  "encounter_id": "01084",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 5.02,
      "duration_seconds": 4.35,
      "text": "Hi doctor, you know, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.7,
      "end_seconds": 9.39,
      "duration_seconds": 3.69,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.94,
      "end_seconds": 14.76,
      "duration_seconds": 3.82,
      "text": "Well, I've been having loose stools after meals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.54,
      "end_seconds": 19.92,
      "duration_seconds": 3.38,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.46,
      "end_seconds": 25.89,
      "duration_seconds": 5.43,
      "text": "Ten days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.99,
      "end_seconds": 37.47,
      "duration_seconds": 10.48,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.29,
      "end_seconds": 55.61,
      "duration_seconds": 16.32,
      "text": "Sorry, uh, what was I saying, I notice it more with stress. It sort of comes and goes. And, And cramping lower tummy pain, too. About cramping lower tummy pain, severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.73,
      "end_seconds": 70.87,
      "duration_seconds": 5.14,
      "text": "Have you had any fever, blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.24,
      "end_seconds": 75.65,
      "duration_seconds": 3.41,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.42,
      "end_seconds": 81.31,
      "duration_seconds": 3.89,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.05,
      "end_seconds": 89.59,
      "duration_seconds": 2.54,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.3,
      "end_seconds": 93.98,
      "duration_seconds": 2.68,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.97,
      "end_seconds": 97.53,
      "duration_seconds": 1.56,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.02,
      "end_seconds": 103.63,
      "duration_seconds": 4.61,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.73,
      "end_seconds": 108.67,
      "duration_seconds": 3.94,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.3,
      "end_seconds": 131.86,
      "duration_seconds": 4.56,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.9,
      "end_seconds": 137.66,
      "duration_seconds": 3.76,
      "text": "Actually, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.31,
      "end_seconds": 140.96,
      "duration_seconds": 2.65,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.27,
      "end_seconds": 154.4,
      "duration_seconds": 12.13,
      "text": "Just my appendix taken out, when I was in my twenties. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.27,
      "end_seconds": 158.68,
      "duration_seconds": 2.41,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.74,
      "end_seconds": 164.1,
      "duration_seconds": 2.36,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.82,
      "end_seconds": 167.57,
      "duration_seconds": 2.75,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.12,
      "end_seconds": 170.95,
      "duration_seconds": 2.83,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.55,
      "end_seconds": 173.5,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.34,
      "end_seconds": 179.51,
      "duration_seconds": 4.17,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.11,
      "end_seconds": 183.57,
      "duration_seconds": 2.46,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.39,
      "end_seconds": 186.78,
      "duration_seconds": 1.39,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.6,
      "end_seconds": 207.39,
      "duration_seconds": 4.79,
      "text": "Your tummy is soft and only mildly tender on the left."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.62,
      "end_seconds": 214.53,
      "duration_seconds": 2.91,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.87,
      "end_seconds": 230.33,
      "duration_seconds": 8.46,
      "text": "So, based on the history and the examination, I think we're dealing with irritable bowel syndrome with diarrhoea at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.0,
      "end_seconds": 235.19,
      "duration_seconds": 3.19,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.89,
      "end_seconds": 254.92,
      "duration_seconds": 19.03,
      "text": "I can't promise yet, but most people with irritable bowel syndrome with diarrhoea do well once it's treated properly. So, to recap quickly. You've had loose stools after meals for three days, and no weight loss or fever."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.1,
      "end_seconds": 259.37,
      "duration_seconds": 3.27,
      "text": "Um, yes, you've got it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.27,
      "end_seconds": 269.12,
      "duration_seconds": 8.85,
      "text": "I'll request a blood count, it'll help with diarrhoea. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 270.68,
      "end_seconds": 275.03,
      "duration_seconds": 4.35,
      "text": "We have a slot Friday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.2,
      "end_seconds": 278.76,
      "duration_seconds": 2.56,
      "text": "Friday, that works for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.59,
      "end_seconds": 306.97,
      "duration_seconds": 27.38,
      "text": "I'd like to arrange a coeliac blood test for diarrhoea. The result will help us decide whether anything more is needed. Keep a food diary and cut back on coffee. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in six weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.47,
      "end_seconds": 310.11,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.97,
      "end_seconds": 312.53,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}