{
  "schema_version": "1.0",
  "encounter_id": "01052",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.35,
      "duration_seconds": 4.37,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.09,
      "duration_seconds": 3.73,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.81,
      "end_seconds": 15.73,
      "duration_seconds": 3.92,
      "text": "I wanted to get being thirsty looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.81,
      "end_seconds": 21.94,
      "duration_seconds": 5.13,
      "text": "When did this begin? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.03,
      "end_seconds": 26.17,
      "duration_seconds": 3.14,
      "text": "It's been going on for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.75,
      "end_seconds": 34.66,
      "duration_seconds": 7.91,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.21,
      "end_seconds": 42.64,
      "duration_seconds": 7.43,
      "text": "Water helps a bit. Mild, really work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.23,
      "end_seconds": 45.3,
      "duration_seconds": 2.07,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.9,
      "end_seconds": 50.06,
      "duration_seconds": 4.16,
      "text": "Tiredness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.06,
      "end_seconds": 66.71,
      "duration_seconds": 3.65,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.23,
      "end_seconds": 68.8,
      "duration_seconds": 1.57,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.34,
      "end_seconds": 74.67,
      "duration_seconds": 5.33,
      "text": "I see, go ahead. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.48,
      "end_seconds": 79.86,
      "duration_seconds": 3.38,
      "text": "Gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.21,
      "end_seconds": 99.32,
      "duration_seconds": 2.11,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.85,
      "end_seconds": 103.77,
      "duration_seconds": 3.92,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.54,
      "end_seconds": 108.87,
      "duration_seconds": 3.33,
      "text": "Are you in work at the the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.11,
      "end_seconds": 117.15,
      "duration_seconds": 4.04,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.36,
      "end_seconds": 123.8,
      "duration_seconds": 2.44,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.52,
      "end_seconds": 129.37,
      "duration_seconds": 3.85,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.65,
      "end_seconds": 133.51,
      "duration_seconds": 2.86,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.58,
      "end_seconds": 149.76,
      "duration_seconds": 15.18,
      "text": "I, I had a caesarean for my second baby nine years ago. My family kept telling me to get it checked. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.38,
      "end_seconds": 166.31,
      "duration_seconds": 0.93,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 169.59,
      "duration_seconds": 1.8,
      "text": "no vomiting, thankfully"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.8,
      "end_seconds": 173.46,
      "duration_seconds": 2.66,
      "text": "Any foot ulcers or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 178.08,
      "duration_seconds": 3.75,
      "text": "No, no foot ulcers or chest pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.95,
      "end_seconds": 181.69,
      "duration_seconds": 2.74,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.62,
      "end_seconds": 186.52,
      "duration_seconds": 2.9,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.49,
      "end_seconds": 192.11,
      "duration_seconds": 3.62,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.05,
      "end_seconds": 206.96,
      "duration_seconds": 2.91,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.42,
      "end_seconds": 243.33,
      "duration_seconds": 14.91,
      "text": "Okay: weight 97 kilos, heart rate 82, height 162 centimetres. And temperature 36.7, SpO2 97 percent on room air, BMI works out to 37.0, pressure 171 over 104."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.3,
      "end_seconds": 248.78,
      "duration_seconds": 3.48,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.58,
      "end_seconds": 251.85,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.81,
      "end_seconds": 276.26,
      "duration_seconds": 7.45,
      "text": "the feeling at the tips of your toes is reduced and the foot pulses are present"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.1,
      "end_seconds": 288.0,
      "duration_seconds": 8.9,
      "text": "You can relax now. Okay, thinking it through, this looks most like diabetes not well controlled on current treatment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.96,
      "end_seconds": 291.55,
      "duration_seconds": 1.59,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.6,
      "end_seconds": 304.81,
      "duration_seconds": 11.21,
      "text": "I understand the worry. At the moment I'd say it's diabetes not well controlled on current treatment, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.18,
      "end_seconds": 331.84,
      "duration_seconds": 16.66,
      "text": "I'd like you to see the diabetes educator as well, and I'll write the referral one warning sign to remember: the symptoms get worse in that case don't wait anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.46,
      "end_seconds": 339.53,
      "duration_seconds": 3.07,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}