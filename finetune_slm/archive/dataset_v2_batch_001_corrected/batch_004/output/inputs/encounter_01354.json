{
  "schema_version": "1.0",
  "encounter_id": "01354",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 5.48,
      "duration_seconds": 4.91,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 10.43,
      "duration_seconds": 3.65,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 19.24,
      "duration_seconds": 7.04,
      "text": "Um, so... tearing chest pain going to my back. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.12,
      "end_seconds": 24.5,
      "duration_seconds": 3.38,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.55,
      "end_seconds": 29.09,
      "duration_seconds": 2.54,
      "text": "probably about two weeks yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.59,
      "end_seconds": 33.37,
      "duration_seconds": 2.78,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.95,
      "end_seconds": 36.34,
      "duration_seconds": 2.39,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.2,
      "end_seconds": 40.99,
      "duration_seconds": 3.79,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.03,
      "end_seconds": 57.44,
      "duration_seconds": 14.41,
      "text": "I'd give it a four, out of ten. Mm, and I've been feeling faint as well, since yesterday. Sudden onset was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.15,
      "end_seconds": 61.01,
      "duration_seconds": 2.86,
      "text": "and leg swelling, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.48,
      "end_seconds": 66.07,
      "duration_seconds": 3.59,
      "text": "not that I've noticed, no leg swelling"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.14,
      "end_seconds": 70.04,
      "duration_seconds": 2.9,
      "text": "a few quick ones: fever or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.97,
      "end_seconds": 76.09,
      "duration_seconds": 5.12,
      "text": "Um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.59,
      "end_seconds": 79.25,
      "duration_seconds": 2.66,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.89,
      "end_seconds": 83.26,
      "duration_seconds": 2.37,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.35,
      "end_seconds": 88.54,
      "duration_seconds": 4.19,
      "text": "Okay, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.67,
      "end_seconds": 95.63,
      "duration_seconds": 1.96,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.29,
      "end_seconds": 101.5,
      "duration_seconds": 4.21,
      "text": "Okay, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.82,
      "end_seconds": 112.38,
      "duration_seconds": 9.56,
      "text": "Telmisartan, 40 milligrams, once a day. Right, though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.39,
      "end_seconds": 123.83,
      "duration_seconds": 2.44,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.53,
      "end_seconds": 129.32,
      "duration_seconds": 3.79,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.67,
      "end_seconds": 136.02,
      "duration_seconds": 5.35,
      "text": "alright, high blood pressure, that that matches what I have here. Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.61,
      "end_seconds": 139.95,
      "duration_seconds": 3.34,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.49,
      "end_seconds": 143.29,
      "duration_seconds": 1.8,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.15,
      "end_seconds": 150.4,
      "duration_seconds": 5.25,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.78,
      "end_seconds": 153.51,
      "duration_seconds": 1.73,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.24,
      "end_seconds": 159.46,
      "duration_seconds": 4.22,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.43,
      "end_seconds": 161.98,
      "duration_seconds": 1.55,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.02,
      "end_seconds": 167.61,
      "duration_seconds": 3.59,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.84,
      "end_seconds": 171.63,
      "duration_seconds": 2.79,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.32,
      "end_seconds": 176.24,
      "duration_seconds": 3.92,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.76,
      "end_seconds": 199.21,
      "duration_seconds": 5.45,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.14,
      "end_seconds": 204.7,
      "duration_seconds": 4.56,
      "text": "I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.3,
      "end_seconds": 216.61,
      "duration_seconds": 3.31,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.27,
      "end_seconds": 233.6,
      "duration_seconds": 3.33,
      "text": "so, that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.38,
      "end_seconds": 264.93,
      "duration_seconds": 12.55,
      "text": "Okay: pulse is 90 beats a minute, respiratory rate 17. And BP is 150 over 102, temperature 36.4, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.36,
      "end_seconds": 270.17,
      "duration_seconds": 3.81,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.44,
      "end_seconds": 273.91,
      "duration_seconds": 2.47,
      "text": "Hold that for a a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.4,
      "end_seconds": 287.57,
      "duration_seconds": 6.17,
      "text": "The blood pressure is different in your two arms and you are sweaty."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.99,
      "end_seconds": 300.24,
      "duration_seconds": 10.25,
      "text": "That's all I needed to check. From what you've told me and what I found, it fits best with a possible tear in the main artery."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.08,
      "end_seconds": 305.49,
      "duration_seconds": 3.41,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.42,
      "end_seconds": 329.5,
      "duration_seconds": 22.08,
      "text": "I understand the worry at the moment I'd say it's a a possible tear in the main artery, and we'll know more once the an urgent CT scan of the chest and abdomen is back. an urgent CT scan of the chest and abdomen is what I'd like next, for tearing chest pain"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 330.5,
      "end_seconds": 335.48,
      "duration_seconds": 4.98,
      "text": "We have a slot Wednesday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.66,
      "end_seconds": 352.1,
      "duration_seconds": 15.44,
      "text": "Do not move, I am calling an ambulance and you are going to a specialist centre. I'd like you to see the cardiac surgical team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.13,
      "end_seconds": 355.65,
      "duration_seconds": 1.52,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.69,
      "end_seconds": 361.28,
      "duration_seconds": 3.59,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.66,
      "end_seconds": 365.87,
      "duration_seconds": 3.21,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}