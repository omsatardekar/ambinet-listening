    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.67,
      "end_seconds": 168.29,
      "duration_seconds": 2.62,
      "text": "Any breathing difficulties apart from this?"
