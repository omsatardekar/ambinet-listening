      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.22,
      "end_seconds": 138.77,
      "duration_seconds": 3.55,
      "text": "I take apixaban, twice a day."
