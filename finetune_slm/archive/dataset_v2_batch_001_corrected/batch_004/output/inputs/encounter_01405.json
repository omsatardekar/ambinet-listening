      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.02,
      "end_seconds": 241.56,
      "duration_seconds": 5.54,
      "text": "Okay: pulse 80, temperature is 36.7 degrees, blood pressure 111 over 69."
