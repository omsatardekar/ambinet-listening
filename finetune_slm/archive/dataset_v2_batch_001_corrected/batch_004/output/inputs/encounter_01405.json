    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.72,
      "end_seconds": 109.1,
      "duration_seconds": 4.38,
      "text": "What conditions have you been treated for in the the past?"
