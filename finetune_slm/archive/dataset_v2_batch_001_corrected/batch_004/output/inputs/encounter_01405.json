    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.17,
      "end_seconds": 251.62,
      "duration_seconds": 4.45,
      "text": "Right, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.93,
      "end_seconds": 292.73,
      "duration_seconds": 29.8,
      "text": "Right, here's what I'm thinking. It fits best with a minor clean wound that needs only dressing. I'll close it with adhesive strips and keep it dry for two days. A short walk every day, even twenty minutes, will help more than you'd think. Come back or go to emergency straight away if the finger turns red, hot or swollen. I'll want another look if it looks red or swollen."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.11,
      "end_seconds": 297.56,
      "duration_seconds": 3.45,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.21,
      "end_seconds": 303.7,
      "duration_seconds": 4.49,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.37,
      "end_seconds": 307.99,
      "duration_seconds": 3.62,
      "text": "No, that's all. Thanks a lot."
    }
  ]
