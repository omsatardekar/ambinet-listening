      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.75,
      "end_seconds": 156.23,
      "duration_seconds": 3.48,
      "text": "A few quick ones: dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.15,
      "end_seconds": 161.58,
      "duration_seconds": 4.43,
      "text": "no, um, no dirty blade or numbness"
