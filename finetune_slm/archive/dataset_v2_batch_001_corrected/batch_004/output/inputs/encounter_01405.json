      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.6,
      "end_seconds": 183.46,
      "duration_seconds": 2.86,
      "text": "Bowels are regular, nothing odd."
