      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.56,
      "end_seconds": 215.55,
      "duration_seconds": 2.99,
      "text": "that's it, just a little longer.."
