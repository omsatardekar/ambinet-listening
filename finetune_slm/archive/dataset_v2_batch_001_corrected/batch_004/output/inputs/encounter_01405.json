      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.84,
      "end_seconds": 86.83,
      "duration_seconds": 4.99,
      "text": "No, I share a house with my brother."
