      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.33,
      "end_seconds": 81.27,
      "duration_seconds": 1.94,
      "text": "Do you live by yourself?"
