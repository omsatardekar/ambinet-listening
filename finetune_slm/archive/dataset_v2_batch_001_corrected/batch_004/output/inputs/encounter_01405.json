      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.12,
      "end_seconds": 122.44,
      "duration_seconds": 7.32,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Have you got any known allergies?"
    },
