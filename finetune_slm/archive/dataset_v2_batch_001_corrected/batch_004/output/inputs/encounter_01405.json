      "role": "PATIENT",
      "start_seconds": 24.4,
      "end_seconds": 32.74,
      "duration_seconds": 8.34,
      "text": "I've been dealing with a cut on my finger. There's a little bleeding as well."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 37.61,
