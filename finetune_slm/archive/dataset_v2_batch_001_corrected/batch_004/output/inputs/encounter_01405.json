      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.96,
      "end_seconds": 129.38,
      "duration_seconds": 6.42,
      "text": "not currently, but as a youngster naproxen gave me stomach pain"
