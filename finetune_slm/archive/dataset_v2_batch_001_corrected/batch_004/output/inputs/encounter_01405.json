    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.95,
      "end_seconds": 246.12,
      "duration_seconds": 3.17,
      "text": "Mm, is that alright, doctor?"
