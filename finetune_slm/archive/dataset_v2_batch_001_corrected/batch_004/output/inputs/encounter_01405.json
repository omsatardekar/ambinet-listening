      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.52,
      "end_seconds": 199.66,
      "duration_seconds": 2.14,
      "text": "I'll do your observations first"
