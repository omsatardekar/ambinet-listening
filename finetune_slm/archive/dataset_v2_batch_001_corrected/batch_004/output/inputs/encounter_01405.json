      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.59,
      "end_seconds": 133.16,
      "duration_seconds": 2.57,
      "text": "What's on your current medicine list?"
