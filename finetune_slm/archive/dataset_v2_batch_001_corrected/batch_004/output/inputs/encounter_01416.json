{
  "schema_version": "1.0",
  "encounter_id": "01416",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 4.64,
      "duration_seconds": 3.71,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.1,
      "end_seconds": 10.13,
      "duration_seconds": 4.03,
      "text": "Morning, um, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.22,
      "end_seconds": 15.08,
      "duration_seconds": 2.86,
      "text": "Okay, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.94,
      "end_seconds": 23.16,
      "duration_seconds": 7.22,
      "text": "It's scaly red plaques on my elbows. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 26.05,
      "end_seconds": 35.36,
      "duration_seconds": 9.31,
      "text": "here are the numbers, doctor. Oxygen saturation is 97 percent, pulse is 69 beats a minute. Pressure 122 over 74, temp 36.4 degrees"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.15,
      "end_seconds": 39.68,
      "duration_seconds": 2.53,
      "text": "Right, thanks. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.89,
      "end_seconds": 48.52,
      "duration_seconds": 4.63,
      "text": "well, you know, it's been one week now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.02,
      "end_seconds": 59.01,
      "duration_seconds": 8.99,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.21,
      "end_seconds": 69.98,
      "duration_seconds": 9.77,
      "text": "I get some relief from moisturiser. A three out of ten, I suppose. I notice it more with stress."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 73.49,
      "duration_seconds": 2.08,
      "text": "any pitted nails as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.82,
      "end_seconds": 81.59,
      "duration_seconds": 6.77,
      "text": "Yes, for ten days. Itching was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.79,
      "end_seconds": 99.66,
      "duration_seconds": 2.87,
      "text": "Any joint pain, fever or pus?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.63,
      "end_seconds": 104.94,
      "duration_seconds": 4.31,
      "text": "I haven't had joint pain, fever or pus, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.58,
      "end_seconds": 106.94,
      "duration_seconds": 1.36,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.59,
      "end_seconds": 112.17,
      "duration_seconds": 3.58,
      "text": "So, you know, no weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 115.78,
      "duration_seconds": 1.98,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 120.7,
      "duration_seconds": 1.08,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.46,
      "end_seconds": 124.05,
      "duration_seconds": 2.59,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.25,
      "end_seconds": 131.99,
      "duration_seconds": 6.74,
      "text": "yes, I had a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.53,
      "end_seconds": 153.27,
      "duration_seconds": 2.74,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.3,
      "end_seconds": 160.09,
      "duration_seconds": 5.79,
      "text": "I've had anxiety for nearly five years now i've got depression"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.95,
      "end_seconds": 162.65,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.85,
      "end_seconds": 168.34,
      "duration_seconds": 4.49,
      "text": "Erm, I've had eczema for two years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.39,
      "end_seconds": 176.0,
      "duration_seconds": 5.61,
      "text": "Okay, I can see anxiety and and eczema in your file as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.21,
      "end_seconds": 199.49,
      "duration_seconds": 6.28,
      "text": "let's run through your medicines. It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.03,
      "end_seconds": 205.5,
      "duration_seconds": 4.47,
      "text": "I'm on sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 206.65,
      "end_seconds": 212.19,
      "duration_seconds": 5.54,
      "text": "doctor, our chart from the last visit lists it as 25 milligrams"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.13,
      "end_seconds": 218.01,
      "duration_seconds": 3.88,
      "text": "I see is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.55,
      "end_seconds": 227.28,
      "duration_seconds": 7.73,
      "text": "I don't think I have it with me. I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.79,
      "end_seconds": 233.23,
      "duration_seconds": 4.44,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.05,
      "end_seconds": 236.88,
      "duration_seconds": 2.83,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.68,
      "end_seconds": 239.27,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.61,
      "end_seconds": 247.35,
      "duration_seconds": 2.74,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.02,
      "end_seconds": 250.16,
      "duration_seconds": 2.14,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.31,
      "end_seconds": 256.38,
      "duration_seconds": 5.07,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.81,
      "end_seconds": 259.15,
      "duration_seconds": 1.34,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.13,
      "end_seconds": 264.58,
      "duration_seconds": 3.45,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.99,
      "end_seconds": 271.35,
      "duration_seconds": 4.36,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.65,
      "end_seconds": 273.98,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.42,
      "end_seconds": 291.37,
      "duration_seconds": 5.95,
      "text": "There are well-defined silvery plaques on both elbows and a few pits in the nails."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 335.63,
      "duration_seconds": 38.46,
      "text": "okay, that's enough for me. So where does that leave us? This is probably plaque psoriasis. I can't rule out eczema yet. What I'm giving you is calcipotriol and betamethasone, 50 micrograms/0.5 mg per g, once a day, four weeks. That should help with psoriasis. Keep the skin well moisturised and avoid picking the plaques. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.45,
      "end_seconds": 337.55,
      "duration_seconds": 1.1,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.18,
      "end_seconds": 349.56,
      "duration_seconds": 10.38,
      "text": "if you get painful or swollen joints, that's the point to come in urgently i'd like to see you again in four weeks"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.05,
      "end_seconds": 351.75,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.53,
      "end_seconds": 357.58,
      "duration_seconds": 4.05,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.97,
      "end_seconds": 361.16,
      "duration_seconds": 2.19,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}