{
  "schema_version": "1.0",
  "encounter_id": "01088",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 5.7,
      "duration_seconds": 5.09,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.9,
      "end_seconds": 11.75,
      "duration_seconds": 4.85,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.48,
      "end_seconds": 16.88,
      "duration_seconds": 3.4,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.29,
      "end_seconds": 23.88,
      "duration_seconds": 5.59,
      "text": "Yeah, it's a missed period. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.61,
      "end_seconds": 27.36,
      "duration_seconds": 2.75,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.12,
      "end_seconds": 32.35,
      "duration_seconds": 3.23,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 39.03,
      "duration_seconds": 3.01,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.81,
      "end_seconds": 43.23,
      "duration_seconds": 3.42,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.98,
      "end_seconds": 47.96,
      "duration_seconds": 2.98,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.29,
      "end_seconds": 50.97,
      "duration_seconds": 1.68,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.51,
      "end_seconds": 56.94,
      "duration_seconds": 4.43,
      "text": "Have you noticed vomiting everything, bleeding or severe pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.93,
      "end_seconds": 62.7,
      "duration_seconds": 4.77,
      "text": "No vomiting everything, bleeding or severe pain, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.52,
      "end_seconds": 67.96,
      "duration_seconds": 3.44,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.54,
      "end_seconds": 71.01,
      "duration_seconds": 1.47,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.63,
      "end_seconds": 91.19,
      "duration_seconds": 4.56,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.99,
      "end_seconds": 94.56,
      "duration_seconds": 1.57,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.83,
      "end_seconds": 104.15,
      "duration_seconds": 5.32,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.14,
      "end_seconds": 112.61,
      "duration_seconds": 5.47,
      "text": "Not currently, but as a youngster naproxen gave me stomach pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.48,
      "end_seconds": 128.62,
      "duration_seconds": 2.14,
      "text": "Okay, have you retired yet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.41,
      "end_seconds": 135.17,
      "duration_seconds": 4.76,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.1,
      "end_seconds": 139.06,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.29,
      "end_seconds": 146.54,
      "duration_seconds": 6.25,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.82,
      "end_seconds": 155.34,
      "duration_seconds": 2.52,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.2,
      "end_seconds": 159.83,
      "duration_seconds": 3.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.36,
      "end_seconds": 175.09,
      "duration_seconds": 2.73,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.59,
      "end_seconds": 180.01,
      "duration_seconds": 4.42,
      "text": "Oh, just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.05,
      "end_seconds": 183.83,
      "duration_seconds": 2.78,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.11,
      "end_seconds": 193.09,
      "duration_seconds": 2.98,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.41,
      "end_seconds": 219.58,
      "duration_seconds": 9.17,
      "text": "Okay: pressure 128 over 71, pulse is 82 beats a minute, saturation 97 percent, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.78,
      "end_seconds": 226.17,
      "duration_seconds": 3.39,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.26,
      "end_seconds": 230.18,
      "duration_seconds": 2.92,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.52,
      "end_seconds": 236.76,
      "duration_seconds": 4.24,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.3,
      "end_seconds": 240.09,
      "duration_seconds": 1.79,
      "text": "Right, breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.94,
      "end_seconds": 260.92,
      "duration_seconds": 1.98,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.38,
      "end_seconds": 266.97,
      "duration_seconds": 2.59,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.54,
      "end_seconds": 289.71,
      "duration_seconds": 5.17,
      "text": "Okay, so my impression is this: It points towards a normal early pregnancy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.29,
      "end_seconds": 293.58,
      "duration_seconds": 3.29,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.34,
      "end_seconds": 329.89,
      "duration_seconds": 31.55,
      "text": "Nothing I've seen today points to an emergency. It looks like a normal early pregnancy, but I'd like to confirm. I think a pregnancy test makes sense here, for missed period. Keep taking folic acid and book in with the midwife. The midwife would be the right next step, I'll refer you. Let's hold off on a booking blood test for now, and if there's no change in two weeks we can revisit it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.86,
      "end_seconds": 339.82,
      "duration_seconds": 7.96,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.45,
      "end_seconds": 344.8,
      "duration_seconds": 3.35,
      "text": "Alright, um, thanks, take care."
    }
  ]
}