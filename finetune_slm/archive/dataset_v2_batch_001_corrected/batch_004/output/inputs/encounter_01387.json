{
  "schema_version": "1.0",
  "encounter_id": "01387",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.98,
      "duration_seconds": 4.23,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.75,
      "end_seconds": 11.01,
      "duration_seconds": 4.26,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 17.96,
      "duration_seconds": 5.93,
      "text": "Yeah, it's a missed period. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.62,
      "end_seconds": 25.05,
      "duration_seconds": 6.43,
      "text": "How long has this been bothering you? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.82,
      "end_seconds": 35.66,
      "duration_seconds": 8.84,
      "text": "Ever since... since last Tuesday, really. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.91,
      "end_seconds": 40.48,
      "duration_seconds": 2.57,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.55,
      "end_seconds": 51.11,
      "duration_seconds": 8.56,
      "text": "I'd give it a five, out of ten. I've also had tender breasts, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 55.62,
      "duration_seconds": 2.87,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.35,
      "end_seconds": 59.71,
      "duration_seconds": 3.36,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.4,
      "end_seconds": 63.41,
      "duration_seconds": 3.01,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.96,
      "end_seconds": 67.33,
      "duration_seconds": 3.37,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.54,
      "end_seconds": 70.9,
      "duration_seconds": 2.36,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.83,
      "end_seconds": 76.28,
      "duration_seconds": 3.45,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.56,
      "end_seconds": 87.2,
      "duration_seconds": 3.64,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.89,
      "end_seconds": 93.28,
      "duration_seconds": 4.39,
      "text": "I have high cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 95.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.31,
      "end_seconds": 99.78,
      "duration_seconds": 3.47,
      "text": "I have diabetes, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.69,
      "end_seconds": 110.64,
      "duration_seconds": 9.95,
      "text": "I follow. Alright, high cholesterol and diabetes, that matches what I have here. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.97,
      "end_seconds": 124.18,
      "duration_seconds": 12.21,
      "text": "I take simvastatin, 20 milligrams, at night for my cholesterol. Gliclazide, 80 milligrams, twice a day. A folic acid tablet, 400 micrograms, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.54,
      "end_seconds": 129.92,
      "duration_seconds": 4.38,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.57,
      "end_seconds": 139.67,
      "duration_seconds": 8.1,
      "text": "Actually, years back I got feeling very drowsy from tramadol, so I stay away from it now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.93,
      "end_seconds": 159.12,
      "duration_seconds": 3.19,
      "text": "Any severe pain, vomiting everything or bleeding?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.17,
      "end_seconds": 164.31,
      "duration_seconds": 4.14,
      "text": "No, no severe pain, vomiting everything or bleeding."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.64,
      "end_seconds": 168.22,
      "duration_seconds": 2.58,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.19,
      "end_seconds": 172.3,
      "duration_seconds": 2.11,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.07,
      "end_seconds": 176.03,
      "duration_seconds": 2.96,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.6,
      "end_seconds": 179.8,
      "duration_seconds": 2.2,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.16,
      "end_seconds": 183.61,
      "duration_seconds": 2.45,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 192.01,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 219.28,
      "duration_seconds": 10.52,
      "text": "Okay: SpO2 99 percent on room air, respiratory rate 18. And pressure 115 over 71, pulse 85, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.09,
      "end_seconds": 222.65,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.37,
      "end_seconds": 228.42,
      "duration_seconds": 4.05,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.31,
      "end_seconds": 235.8,
      "duration_seconds": 4.49,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.13,
      "end_seconds": 255.76,
      "duration_seconds": 1.63,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.95,
      "end_seconds": 258.92,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.7,
      "end_seconds": 277.02,
      "duration_seconds": 2.32,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.73,
      "end_seconds": 292.51,
      "duration_seconds": 10.78,
      "text": "That's all I needed to check. So, based on the history and the examination, my working impression is a normal early pregnancy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.59,
      "end_seconds": 295.72,
      "duration_seconds": 2.13,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.01,
      "end_seconds": 317.45,
      "duration_seconds": 20.44,
      "text": "I understand the worry. At the moment I'd say it's a normal early pregnancy, and we'll know more once the a pregnancy test is back. Just to be sure I understood. You've had a missed period, since last Tuesday, and no bleeding or vomiting everything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.54,
      "end_seconds": 320.15,
      "duration_seconds": 1.61,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.44,
      "end_seconds": 341.12,
      "duration_seconds": 19.68,
      "text": "I want a pregnancy test done, that's for missed period. I want a booking blood test done, that's for pregnancy. Keep taking folic acid and book in with the midwife. Book a review in four weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.92,
      "end_seconds": 345.54,
      "duration_seconds": 3.62,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}