{
  "schema_version": "1.0",
  "encounter_id": "01341",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 2.88,
      "duration_seconds": 1.59,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.17,
      "end_seconds": 8.67,
      "duration_seconds": 4.5,
      "text": "no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.62,
      "end_seconds": 16.47,
      "duration_seconds": 6.85,
      "text": "Honestly, it's a runny nose, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.11,
      "end_seconds": 20.77,
      "duration_seconds": 3.66,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.94,
      "end_seconds": 39.16,
      "duration_seconds": 17.22,
      "text": "Probably ten days. Yeah. Oh, and sneezing. Had that since Monday. Oh, and a scratchy throat. That's been about the same, six months. About scratchy throat, swallowing definitely sets it off."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.73,
      "end_seconds": 46.67,
      "duration_seconds": 6.94,
      "text": "Let me check a few things. Any fever, ear pain, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.56,
      "end_seconds": 58.52,
      "duration_seconds": 5.96,
      "text": "No, no fever, ear pain, shortness of breath or chest pain."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.08,
      "end_seconds": 65.42,
      "duration_seconds": 2.34,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.79,
      "end_seconds": 68.16,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.17,
      "end_seconds": 72.06,
      "duration_seconds": 2.89,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.98,
      "end_seconds": 75.9,
      "duration_seconds": 1.92,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.17,
      "end_seconds": 80.29,
      "duration_seconds": 3.12,
      "text": "alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.71,
      "end_seconds": 83.42,
      "duration_seconds": 1.71,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.12,
      "end_seconds": 88.86,
      "duration_seconds": 4.74,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.15,
      "end_seconds": 92.42,
      "duration_seconds": 2.27,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.59,
      "end_seconds": 107.92,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.01,
      "end_seconds": 112.73,
      "duration_seconds": 3.72,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.61,
      "end_seconds": 115.58,
      "duration_seconds": 1.97,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.33,
      "end_seconds": 118.12,
      "duration_seconds": 1.79,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.7,
      "end_seconds": 121.89,
      "duration_seconds": 2.19,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.14,
      "end_seconds": 127.59,
      "duration_seconds": 4.45,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.99,
      "end_seconds": 132.18,
      "duration_seconds": 3.19,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.27,
      "end_seconds": 138.18,
      "duration_seconds": 3.91,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.21,
      "end_seconds": 141.67,
      "duration_seconds": 2.46,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.44,
      "end_seconds": 148.0,
      "duration_seconds": 4.56,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.85,
      "end_seconds": 152.8,
      "duration_seconds": 3.95,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.01,
      "end_seconds": 161.51,
      "duration_seconds": 7.5,
      "text": "it's metoprolol, 50 milligrams, twice a day before this I was on spironolactone; that's been stopped"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.04,
      "end_seconds": 166.62,
      "duration_seconds": 4.58,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.26,
      "end_seconds": 169.76,
      "duration_seconds": 2.5,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.96,
      "end_seconds": 184.02,
      "duration_seconds": 2.06,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.32,
      "end_seconds": 197.05,
      "duration_seconds": 2.73,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.75,
      "end_seconds": 224.76,
      "duration_seconds": 9.01,
      "text": "Okay: SpO2 99 percent on room air, pulse is 65 beats a minute, temperature 36.7. And BP is 127 over 76."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.78,
      "end_seconds": 229.12,
      "duration_seconds": 2.34,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.66,
      "end_seconds": 230.75,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.1,
      "end_seconds": 233.4,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.08,
      "end_seconds": 250.5,
      "duration_seconds": 4.42,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.23,
      "end_seconds": 263.74,
      "duration_seconds": 8.51,
      "text": "alright, please sit back down. Right, here's what I'm thinking. It points towards a simple viral cold"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.46,
      "end_seconds": 267.61,
      "duration_seconds": 3.15,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.27,
      "end_seconds": 278.34,
      "duration_seconds": 7.07,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.08,
      "end_seconds": 312.23,
      "duration_seconds": 15.15,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. Do get help quickly if you develop a high fever or trouble breathing. We'll catch up if it is not better in ten days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.06,
      "end_seconds": 314.76,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.69,
      "end_seconds": 319.81,
      "duration_seconds": 4.12,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.35,
      "end_seconds": 322.48,
      "duration_seconds": 2.13,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.89,
      "end_seconds": 325.67,
      "duration_seconds": 1.78,
      "text": "Have a good day."
    }
  ]
}