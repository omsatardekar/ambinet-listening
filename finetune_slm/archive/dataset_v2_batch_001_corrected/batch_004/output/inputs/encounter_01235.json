{
  "schema_version": "1.0",
  "encounter_id": "01235",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 5.83,
      "duration_seconds": 5.0,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 11.31,
      "duration_seconds": 4.34,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.96,
      "end_seconds": 21.62,
      "duration_seconds": 8.66,
      "text": "Ah, it's a hot swollen painful knee. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.62,
      "end_seconds": 24.86,
      "duration_seconds": 2.24,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.09,
      "end_seconds": 28.24,
      "duration_seconds": 2.15,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.45,
      "end_seconds": 34.51,
      "duration_seconds": 5.06,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.16,
      "end_seconds": 52.93,
      "duration_seconds": 17.77,
      "text": "I'd say a few times a day. It's severe, honestly. I've had not being able to walk on it too, for about three months. I've also had fever and chills, for two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 62.7,
      "duration_seconds": 7.68,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.72,
      "end_seconds": 72.32,
      "duration_seconds": 4.6,
      "text": "About a six out of ten. It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.57,
      "end_seconds": 79.52,
      "duration_seconds": 5.95,
      "text": "Have you had a hot swollen painful knee before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.68,
      "end_seconds": 85.35,
      "duration_seconds": 4.67,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.14,
      "end_seconds": 100.18,
      "duration_seconds": 4.04,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.57,
      "end_seconds": 107.54,
      "duration_seconds": 2.97,
      "text": "No, you know, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.28,
      "end_seconds": 111.56,
      "duration_seconds": 3.28,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.69,
      "end_seconds": 129.17,
      "duration_seconds": 13.48,
      "text": "I quit smoking around ten years ago. I'm a hairdresser, on my feet all day. I swim twice a week. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.14,
      "end_seconds": 139.87,
      "duration_seconds": 8.73,
      "text": "Do you react to any medicines or foods? Any allergies? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.47,
      "end_seconds": 143.65,
      "duration_seconds": 3.18,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 148.38,
      "duration_seconds": 3.31,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.97,
      "end_seconds": 156.47,
      "duration_seconds": 6.5,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.41,
      "end_seconds": 161.26,
      "duration_seconds": 2.85,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.16,
      "end_seconds": 163.28,
      "duration_seconds": 1.12,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.51,
      "end_seconds": 169.87,
      "duration_seconds": 5.36,
      "text": "Right, and what about other joint pain, recent injury or rash?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.9,
      "end_seconds": 173.33,
      "duration_seconds": 2.43,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.68,
      "end_seconds": 179.51,
      "duration_seconds": 4.83,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.19,
      "end_seconds": 184.08,
      "duration_seconds": 2.89,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.74,
      "end_seconds": 186.27,
      "duration_seconds": 1.53,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.75,
      "end_seconds": 189.44,
      "duration_seconds": 1.69,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.32,
      "end_seconds": 211.6,
      "duration_seconds": 3.28,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.49,
      "end_seconds": 226.49,
      "duration_seconds": 2.0,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.54,
      "end_seconds": 244.15,
      "duration_seconds": 8.61,
      "text": "Okay: saturation 95 percent, pulse is 100 beats a minute. And pressure 108 over 73, temp 38.2 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.22,
      "end_seconds": 249.63,
      "duration_seconds": 4.41,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.86,
      "end_seconds": 252.18,
      "duration_seconds": 1.32,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.26,
      "end_seconds": 273.46,
      "duration_seconds": 6.2,
      "text": "The knee is hot, swollen and extremely painful when I move it even slightly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.86,
      "end_seconds": 279.22,
      "duration_seconds": 2.36,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.76,
      "end_seconds": 293.93,
      "duration_seconds": 4.17,
      "text": "Putting it all together, this is probably possible septic arthritis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.14,
      "end_seconds": 296.62,
      "duration_seconds": 1.48,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.0,
      "end_seconds": 318.1,
      "duration_seconds": 20.1,
      "text": "I can't promise yet, but most people with possible septic arthritis do well once it's treated properly. So, to recap quickly. You've had a hot swollen painful knee for three weeks, severe, and no recent injury or other joint pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.91,
      "end_seconds": 320.73,
      "duration_seconds": 1.82,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.34,
      "end_seconds": 338.98,
      "duration_seconds": 16.64,
      "text": "We should do a joint aspiration for hot swollen knee. You need to go to hospital now for a joint washout assessment. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.27,
      "end_seconds": 345.84,
      "duration_seconds": 1.57,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.39,
      "end_seconds": 348.11,
      "duration_seconds": 1.72,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.0,
      "end_seconds": 352.33,
      "duration_seconds": 2.33,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.49,
      "end_seconds": 357.62,
      "duration_seconds": 4.13,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.57,
      "end_seconds": 362.35,
      "duration_seconds": 3.78,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.45,
      "end_seconds": 364.76,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}