{
  "schema_version": "1.0",
  "encounter_id": "01239",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 5.32,
      "duration_seconds": 4.76,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.17,
      "end_seconds": 11.18,
      "duration_seconds": 5.01,
      "text": "Well, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.46,
      "end_seconds": 15.47,
      "duration_seconds": 3.01,
      "text": "Okay, have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.0,
      "end_seconds": 20.03,
      "duration_seconds": 4.03,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.03,
      "end_seconds": 24.06,
      "duration_seconds": 3.03,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.29,
      "end_seconds": 32.67,
      "duration_seconds": 7.38,
      "text": "Mainly a sore ankle. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.1,
      "end_seconds": 37.43,
      "duration_seconds": 3.33,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.16,
      "end_seconds": 42.0,
      "duration_seconds": 2.84,
      "text": "I've had it for two days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.33,
      "end_seconds": 46.4,
      "duration_seconds": 4.07,
      "text": "mm-hmm okay, has there been a little swelling too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.92,
      "end_seconds": 52.78,
      "duration_seconds": 4.86,
      "text": "Mm, yes. About little swelling, elevation helps a bit."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.39,
      "end_seconds": 58.24,
      "duration_seconds": 3.85,
      "text": "And pain in the foot, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.86,
      "end_seconds": 64.17,
      "duration_seconds": 4.31,
      "text": "no, I haven't had any pain in the foot"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.41,
      "end_seconds": 70.77,
      "duration_seconds": 3.36,
      "text": "Have you noticed numbness or crack or pop?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.85,
      "end_seconds": 76.58,
      "duration_seconds": 3.73,
      "text": "No, no numbness or crack or pop."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.59,
      "end_seconds": 82.73,
      "duration_seconds": 5.14,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.68,
      "end_seconds": 86.87,
      "duration_seconds": 2.19,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 93.75,
      "duration_seconds": 1.67,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.8,
      "end_seconds": 95.8,
      "duration_seconds": 1.0,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.24,
      "end_seconds": 101.21,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.94,
      "end_seconds": 104.77,
      "duration_seconds": 2.83,
      "text": "Anxiety, for about a year"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.74,
      "end_seconds": 107.48,
      "duration_seconds": 0.74,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.2,
      "end_seconds": 110.91,
      "duration_seconds": 2.71,
      "text": "COPD, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.72,
      "end_seconds": 114.6,
      "duration_seconds": 2.88,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.78,
      "end_seconds": 122.16,
      "duration_seconds": 6.38,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 122.94,
      "end_seconds": 132.95,
      "duration_seconds": 10.01,
      "text": "Doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.92,
      "end_seconds": 137.89,
      "duration_seconds": 3.97,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.08,
      "end_seconds": 151.09,
      "duration_seconds": 12.01,
      "text": "not with me. I'll bring it next time. Tiotropium inhaler. I take it once a day. Ibuprofen gel. I take it three times a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.61,
      "end_seconds": 155.06,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.69,
      "end_seconds": 160.18,
      "duration_seconds": 3.49,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.56,
      "end_seconds": 182.42,
      "duration_seconds": 6.86,
      "text": "before we go further, any allergies? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.47,
      "end_seconds": 187.83,
      "duration_seconds": 3.36,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 188.58,
      "end_seconds": 194.98,
      "duration_seconds": 6.4,
      "text": "Hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.07,
      "end_seconds": 200.33,
      "duration_seconds": 3.26,
      "text": "maybe, but I don't recall it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.01,
      "end_seconds": 207.43,
      "duration_seconds": 6.42,
      "text": "Okay, I'll note both of those. Alright, do you work outside the home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.19,
      "end_seconds": 212.3,
      "duration_seconds": 4.11,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.36,
      "end_seconds": 221.11,
      "duration_seconds": 2.75,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.89,
      "end_seconds": 225.74,
      "duration_seconds": 3.85,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.36,
      "end_seconds": 228.59,
      "duration_seconds": 2.23,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.17,
      "end_seconds": 233.88,
      "duration_seconds": 3.71,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.61,
      "end_seconds": 239.44,
      "duration_seconds": 3.83,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.14,
      "end_seconds": 251.41,
      "duration_seconds": 2.27,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.43,
      "end_seconds": 278.17,
      "duration_seconds": 12.74,
      "text": "Okay: height 176 centimetres, pulse is 84 beats a minute, temp 37.0 degrees, BMI works out to 26.5, weight 82 kilos, pressure 122 over 70."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.05,
      "end_seconds": 284.4,
      "duration_seconds": 3.35,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.71,
      "end_seconds": 287.08,
      "duration_seconds": 1.37,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.35,
      "end_seconds": 309.69,
      "duration_seconds": 8.34,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.38,
      "end_seconds": 317.54,
      "duration_seconds": 2.16,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.41,
      "end_seconds": 334.33,
      "duration_seconds": 7.92,
      "text": "okay, thinking it through, it points towards a mild ankle sprain another possibility is a minor fracture"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.08,
      "end_seconds": 367.14,
      "duration_seconds": 14.06,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 368.12,
      "end_seconds": 369.62,
      "duration_seconds": 1.5,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.86,
      "end_seconds": 391.87,
      "duration_seconds": 18.01,
      "text": "Please don't wait if you cannot put weight on it. That's when to be seen urgently. Let's plan a check if it is not better in two weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.02,
      "end_seconds": 400.56,
      "duration_seconds": 7.54,
      "text": "so, I come back if it is not better in two weeks is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.31,
      "end_seconds": 406.78,
      "duration_seconds": 4.47,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 407.9,
      "end_seconds": 410.71,
      "duration_seconds": 2.81,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.83,
      "end_seconds": 417.0,
      "duration_seconds": 1.17,
      "text": "look after yourself"
    }
  ]
}