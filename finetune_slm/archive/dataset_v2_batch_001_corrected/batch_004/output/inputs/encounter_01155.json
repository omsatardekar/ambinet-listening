{
  "schema_version": "1.0",
  "encounter_id": "01155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 5.37,
      "duration_seconds": 4.61,
      "text": "Um, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.11,
      "end_seconds": 11.05,
      "duration_seconds": 3.94,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.31,
      "end_seconds": 20.33,
      "duration_seconds": 8.02,
      "text": "Doctor, I'm just here to help with the details. She's been having crushing chest pain, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.38,
      "end_seconds": 28.89,
      "duration_seconds": 3.51,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.89,
      "end_seconds": 32.58,
      "duration_seconds": 2.69,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.23,
      "end_seconds": 37.68,
      "duration_seconds": 4.45,
      "text": "Hmm, it was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.26,
      "end_seconds": 42.83,
      "duration_seconds": 4.57,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.75,
      "end_seconds": 50.25,
      "duration_seconds": 5.5,
      "text": "Sorry, what was I saying, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.66,
      "end_seconds": 66.34,
      "duration_seconds": 9.68,
      "text": "So, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.35,
      "end_seconds": 74.88,
      "duration_seconds": 6.53,
      "text": "Exertion definitely sets it off. I'd say moderate. It happens on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.65,
      "end_seconds": 77.23,
      "duration_seconds": 1.58,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.84,
      "end_seconds": 80.5,
      "duration_seconds": 1.66,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.42,
      "end_seconds": 84.99,
      "duration_seconds": 3.57,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.51,
      "end_seconds": 88.06,
      "duration_seconds": 1.55,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.93,
      "end_seconds": 94.38,
      "duration_seconds": 4.45,
      "text": "So, have you noticed cough, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.38,
      "end_seconds": 99.62,
      "duration_seconds": 4.24,
      "text": "Oh, uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.92,
      "end_seconds": 104.38,
      "duration_seconds": 4.46,
      "text": "Hm, okay. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 109.2,
      "duration_seconds": 2.73,
      "text": "Well, no, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.31,
      "end_seconds": 113.25,
      "duration_seconds": 2.94,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.8,
      "end_seconds": 119.47,
      "duration_seconds": 4.67,
      "text": "I mean, you know, no, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.77,
      "end_seconds": 137.01,
      "duration_seconds": 2.24,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.51,
      "end_seconds": 151.51,
      "duration_seconds": 13.0,
      "text": "Yeah, you know, I've had high cholesterol for about ten years now. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.14,
      "end_seconds": 160.13,
      "duration_seconds": 7.99,
      "text": "Okay, I can see high cholesterol in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.22,
      "end_seconds": 165.54,
      "duration_seconds": 3.32,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.3,
      "end_seconds": 168.81,
      "duration_seconds": 2.51,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.52,
      "end_seconds": 178.57,
      "duration_seconds": 8.05,
      "text": "Sorry, what was I saying, not currently, but as a youngster amoxicillin gave me hives."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.38,
      "end_seconds": 183.32,
      "duration_seconds": 2.94,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.22,
      "end_seconds": 197.66,
      "duration_seconds": 12.44,
      "text": "I work in accounts at a hospital. I hardly move around during the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.75,
      "end_seconds": 214.7,
      "duration_seconds": 3.95,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 215.49,
      "end_seconds": 222.93,
      "duration_seconds": 7.44,
      "text": "Sorry, what was I saying, it's simvastatin, 20 milligrams, at night, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.99,
      "end_seconds": 228.42,
      "duration_seconds": 4.43,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.75,
      "end_seconds": 241.49,
      "duration_seconds": 1.74,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.32,
      "end_seconds": 246.47,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.87,
      "end_seconds": 267.24,
      "duration_seconds": 4.37,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.71,
      "end_seconds": 282.35,
      "duration_seconds": 12.64,
      "text": "You can relax now. So, based on the history and the examination, this looks most like a possible heart attack. I can't rule out unstable angina yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.43,
      "end_seconds": 287.71,
      "duration_seconds": 4.28,
      "text": "Erm, um, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.39,
      "end_seconds": 317.89,
      "duration_seconds": 29.5,
      "text": "I understand the worry. At the moment I'd say it's a possible heart attack, and we'll know more once the an ECG is back. I'd like to arrange an ECG for chest pain. Let's get a troponin blood test, for chest pain. I'm prescribing aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. Stay lying down and do not eat or drink. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.37,
      "end_seconds": 324.92,
      "duration_seconds": 5.55,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.71,
      "end_seconds": 329.22,
      "duration_seconds": 3.51,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.31,
      "end_seconds": 332.22,
      "duration_seconds": 1.91,
      "text": "Have a good day."
    }
  ]
}