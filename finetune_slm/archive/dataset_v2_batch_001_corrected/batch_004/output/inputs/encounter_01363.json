      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.22,
      "end_seconds": 71.46,
      "duration_seconds": 2.24,
      "text": "Yes, somewhere around that."
