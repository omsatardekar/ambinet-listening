    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.08,
      "end_seconds": 68.21,
      "duration_seconds": 4.13,
      "text": "Okay, so roughly one to two months. Is that right?"
