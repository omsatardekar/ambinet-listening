      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.23,
      "end_seconds": 434.77,
      "duration_seconds": 2.54,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 435.38,
