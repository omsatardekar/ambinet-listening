{
  "schema_version": "1.0",
  "encounter_id": "01055",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.81,
      "duration_seconds": 6.54,
      "text": "Sorry, what was I saying, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.07,
      "end_seconds": 14.48,
      "duration_seconds": 5.41,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.46,
      "end_seconds": 25.9,
      "duration_seconds": 10.44,
      "text": "erm, um, it's pain going into my left arm i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.04,
      "end_seconds": 28.39,
      "duration_seconds": 1.35,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.29,
      "end_seconds": 42.18,
      "duration_seconds": 7.89,
      "text": "it's been going on for two days. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.1,
      "end_seconds": 54.73,
      "duration_seconds": 7.63,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.41,
      "end_seconds": 66.89,
      "duration_seconds": 7.48,
      "text": "I'd say on and off. It's severe, honestly. Oh, I've also been feeling sick."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.1,
      "end_seconds": 71.91,
      "duration_seconds": 3.81,
      "text": "Right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.97,
      "end_seconds": 80.35,
      "duration_seconds": 6.38,
      "text": "Let me think, I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.45,
      "end_seconds": 82.55,
      "duration_seconds": 1.1,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.31,
      "end_seconds": 88.21,
      "duration_seconds": 4.9,
      "text": "I, I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.83,
      "end_seconds": 95.51,
      "duration_seconds": 6.68,
      "text": "yes, high blood pressure is known to us, good to have that clear. Alright, any smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.44,
      "end_seconds": 100.56,
      "duration_seconds": 4.12,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 103.06,
      "duration_seconds": 1.56,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.9,
      "end_seconds": 108.21,
      "duration_seconds": 3.31,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 110.84,
      "duration_seconds": 1.21,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.69,
      "end_seconds": 116.07,
      "duration_seconds": 3.38,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.98,
      "end_seconds": 119.89,
      "duration_seconds": 2.91,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.9,
      "end_seconds": 124.32,
      "duration_seconds": 3.42,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.87,
      "end_seconds": 128.13,
      "duration_seconds": 2.26,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.1,
      "end_seconds": 131.73,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.8,
      "end_seconds": 150.12,
      "duration_seconds": 2.32,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.89,
      "end_seconds": 155.36,
      "duration_seconds": 3.47,
      "text": "Simvastatin, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.29,
      "end_seconds": 159.54,
      "duration_seconds": 2.25,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.68,
      "end_seconds": 167.99,
      "duration_seconds": 7.31,
      "text": "20 milligrams. I'm, I'm on telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.66,
      "end_seconds": 174.67,
      "duration_seconds": 5.01,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.98,
      "end_seconds": 181.53,
      "duration_seconds": 5.55,
      "text": "okay, so I don't think I have any, no"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.08,
      "end_seconds": 187.65,
      "duration_seconds": 4.57,
      "text": "A few quick ones: cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.79,
      "end_seconds": 194.15,
      "duration_seconds": 5.36,
      "text": "no cough, leg swelling or fever, none of it"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 201.08,
      "duration_seconds": 3.26,
      "text": "okay, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.22,
      "end_seconds": 207.09,
      "duration_seconds": 4.87,
      "text": "Okay, um, so no, that's all fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.19,
      "end_seconds": 209.64,
      "duration_seconds": 1.45,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.55,
      "end_seconds": 214.75,
      "duration_seconds": 3.2,
      "text": "Mm, no, nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.22,
      "end_seconds": 232.88,
      "duration_seconds": 2.66,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.34,
      "end_seconds": 248.38,
      "duration_seconds": 3.04,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.76,
      "end_seconds": 273.9,
      "duration_seconds": 13.14,
      "text": "Okay: blood pressure 136 over 78, weight 52 kilos, heart rate 123, temp 36.8 degrees, height 181 centimetres, SpO2 99 percent on room air, respiratory rate 17."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.97,
      "end_seconds": 280.49,
      "duration_seconds": 4.52,
      "text": "I'll examine you in a a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.19,
      "end_seconds": 284.95,
      "duration_seconds": 2.76,
      "text": "so, tell me if that's sore"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.78,
      "end_seconds": 300.73,
      "duration_seconds": 4.95,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.96,
      "end_seconds": 306.19,
      "duration_seconds": 2.23,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.7,
      "end_seconds": 351.49,
      "duration_seconds": 26.79,
      "text": "Okay, so my impression is this: I think we're dealing with a possible heart attack at this stage. I'd also keep unstable angina in mind. A troponin blood test is what I'd like next, for chest pain. Let's book an ECG to look into chest pain. I'd rather check than guess, and this is the the quickest way to know more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.1,
      "end_seconds": 356.9,
      "duration_seconds": 3.8,
      "text": "I mean, okay, I'll do it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.96,
      "end_seconds": 369.67,
      "duration_seconds": 9.71,
      "text": "What I'm giving you is aspirin, 300 milligrams, once now, single dose. You take it it by mouth. That's for possible heart attack."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.74,
      "end_seconds": 375.43,
      "duration_seconds": 4.69,
      "text": "I mean, how soon will it it work?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.71,
      "end_seconds": 391.87,
      "duration_seconds": 15.16,
      "text": "Stay lying down and do not eat or drink. If you smoke, this is a good moment to think about stopping, and we can help you with that. I'm gonna send a referral to the cardiac team."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.67,
      "end_seconds": 395.38,
      "duration_seconds": 1.71,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.38,
      "end_seconds": 402.21,
      "duration_seconds": 5.83,
      "text": "I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.3,
      "end_seconds": 408.51,
      "duration_seconds": 5.21,
      "text": "Hmm, uh, I think I understand everything. Thanks."
    }
  ]
}