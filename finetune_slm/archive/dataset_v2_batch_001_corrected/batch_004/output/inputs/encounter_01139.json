{
  "schema_version": "1.0",
  "encounter_id": "01139",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 4.83,
      "duration_seconds": 3.93,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.93,
      "end_seconds": 10.35,
      "duration_seconds": 4.42,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.35,
      "end_seconds": 14.14,
      "duration_seconds": 1.79,
      "text": "I've been wanting contraception."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.96,
      "end_seconds": 16.26,
      "duration_seconds": 1.3,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.95,
      "end_seconds": 30.06,
      "duration_seconds": 8.11,
      "text": "About... well, about a month. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.33,
      "end_seconds": 33.52,
      "duration_seconds": 2.19,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.44,
      "end_seconds": 48.71,
      "duration_seconds": 14.27,
      "text": "Slightly heavy periods goes along with it, most of the time. Sorry, what was I saying, the slightly heavy periods? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.4,
      "end_seconds": 58.11,
      "duration_seconds": 3.71,
      "text": "Have you noticed breast lumps or migraine with aura?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.81,
      "end_seconds": 64.25,
      "duration_seconds": 5.44,
      "text": "I haven't had breast lumps or migraine with aura, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.99,
      "end_seconds": 66.78,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.13,
      "end_seconds": 69.62,
      "duration_seconds": 1.49,
      "text": "No smoking, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 73.15,
      "duration_seconds": 2.85,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.82,
      "end_seconds": 74.88,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.74,
      "end_seconds": 78.13,
      "duration_seconds": 2.39,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.91,
      "end_seconds": 83.64,
      "duration_seconds": 3.73,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.07,
      "end_seconds": 94.01,
      "duration_seconds": 4.94,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.8,
      "end_seconds": 98.64,
      "duration_seconds": 3.84,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.8,
      "end_seconds": 109.13,
      "duration_seconds": 2.33,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.99,
      "end_seconds": 114.1,
      "duration_seconds": 4.11,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.64,
      "end_seconds": 121.25,
      "duration_seconds": 2.61,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.97,
      "end_seconds": 126.71,
      "duration_seconds": 3.74,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.73,
      "end_seconds": 131.01,
      "duration_seconds": 3.28,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.04,
      "end_seconds": 133.54,
      "duration_seconds": 1.5,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.56,
      "end_seconds": 145.61,
      "duration_seconds": 3.05,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.49,
      "end_seconds": 148.55,
      "duration_seconds": 1.06,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.04,
      "end_seconds": 164.1,
      "duration_seconds": 2.06,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.48,
      "end_seconds": 179.42,
      "duration_seconds": 1.94,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.39,
      "end_seconds": 201.22,
      "duration_seconds": 5.83,
      "text": "Okay: blood pressure 108 over 80, saturation 98 percent, heart rate 83."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.97,
      "end_seconds": 203.99,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.89,
      "end_seconds": 208.88,
      "duration_seconds": 3.99,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.28,
      "end_seconds": 213.19,
      "duration_seconds": 2.91,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.56,
      "end_seconds": 218.49,
      "duration_seconds": 0.93,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.23,
      "end_seconds": 222.05,
      "duration_seconds": 1.82,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.03,
      "end_seconds": 240.12,
      "duration_seconds": 2.09,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.04,
      "end_seconds": 246.04,
      "duration_seconds": 3.0,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.06,
      "end_seconds": 267.68,
      "duration_seconds": 12.62,
      "text": "Having listened and examined, the most likely explanation is suitable for hormonal contraception with no risk factors. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.63,
      "end_seconds": 271.87,
      "duration_seconds": 2.24,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.95,
      "end_seconds": 304.0,
      "duration_seconds": 31.05,
      "text": "I understand the worry. At the moment I'd say it's suitable for hormonal contraception with no risk factors, and we'll watch how it goes. You'll be taking levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That should help with contraception. Take the pill at the same time each day and use condoms if you miss two. Come back or go to emergency straight away if you get leg swelling or severe headaches."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.18,
      "end_seconds": 307.97,
      "duration_seconds": 2.79,
      "text": "See me again in three months."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.24,
      "end_seconds": 312.23,
      "duration_seconds": 2.99,
      "text": "Oh, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.13,
      "end_seconds": 317.67,
      "duration_seconds": 4.54,
      "text": "Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.37,
      "end_seconds": 321.36,
      "duration_seconds": 2.99,
      "text": "I think I understand everything. Thanks."
    }
  ]
}