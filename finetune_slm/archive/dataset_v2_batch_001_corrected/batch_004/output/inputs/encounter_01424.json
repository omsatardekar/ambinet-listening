{
  "schema_version": "1.0",
  "encounter_id": "01424",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.11,
      "end_seconds": 6.57,
      "duration_seconds": 5.46,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.61,
      "end_seconds": 13.22,
      "duration_seconds": 4.61,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.09,
      "end_seconds": 21.78,
      "duration_seconds": 7.69,
      "text": "Good morning, doctor. I came along to help out. She's been feeling tired all the time, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.02,
      "end_seconds": 26.41,
      "duration_seconds": 3.39,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.36,
      "end_seconds": 31.07,
      "duration_seconds": 2.71,
      "text": "It's been five days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.41,
      "end_seconds": 34.89,
      "duration_seconds": 2.48,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.46,
      "end_seconds": 38.41,
      "duration_seconds": 2.95,
      "text": "Mm, naps helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.76,
      "end_seconds": 46.02,
      "duration_seconds": 3.26,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.13,
      "end_seconds": 52.75,
      "duration_seconds": 5.62,
      "text": "When it starts I tend to get craving ice as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.62,
      "end_seconds": 60.59,
      "duration_seconds": 6.97,
      "text": "Yeah, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 60.69,
      "end_seconds": 66.41,
      "duration_seconds": 5.72,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.35,
      "end_seconds": 72.86,
      "duration_seconds": 5.51,
      "text": "I was getting to that! I've been looking pale too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 78.98,
      "end_seconds": 81.52,
      "duration_seconds": 2.54,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.53,
      "end_seconds": 88.9,
      "duration_seconds": 6.37,
      "text": "Let me check a few things. Any heavy periods, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.81,
      "end_seconds": 92.77,
      "duration_seconds": 1.96,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.68,
      "end_seconds": 100.66,
      "duration_seconds": 3.98,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.58,
      "end_seconds": 105.24,
      "duration_seconds": 2.66,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.26,
      "end_seconds": 109.6,
      "duration_seconds": 2.34,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.3,
      "end_seconds": 115.64,
      "duration_seconds": 3.34,
      "text": "Uh, no, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.07,
      "end_seconds": 120.92,
      "duration_seconds": 3.85,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.98,
      "end_seconds": 127.0,
      "duration_seconds": 4.02,
      "text": "I'm on paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 127.82,
      "end_seconds": 137.05,
      "duration_seconds": 9.23,
      "text": "Doctor, I think the last prescription for the paracetamol was 1300 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.89,
      "end_seconds": 140.81,
      "duration_seconds": 2.92,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.84,
      "end_seconds": 146.13,
      "duration_seconds": 3.29,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.47,
      "end_seconds": 155.19,
      "duration_seconds": 7.72,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.55,
      "end_seconds": 159.29,
      "duration_seconds": 2.74,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.29,
      "end_seconds": 175.01,
      "duration_seconds": 14.72,
      "text": "For my sugar, I believe. My husband sets them out for me, I just take what I'm given. A multivitamin. I take it daily. Glibenclamide I don't take anymore."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.99,
      "end_seconds": 179.6,
      "duration_seconds": 3.61,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.75,
      "end_seconds": 183.67,
      "duration_seconds": 2.92,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.81,
      "end_seconds": 185.51,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.22,
      "end_seconds": 188.27,
      "duration_seconds": 1.05,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.96,
      "end_seconds": 196.19,
      "duration_seconds": 6.23,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.26,
      "end_seconds": 204.72,
      "duration_seconds": 1.46,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.71,
      "end_seconds": 209.81,
      "duration_seconds": 3.1,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.49,
      "end_seconds": 211.74,
      "duration_seconds": 1.25,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.98,
      "end_seconds": 218.68,
      "duration_seconds": 1.7,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.88,
      "end_seconds": 222.74,
      "duration_seconds": 2.86,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.56,
      "end_seconds": 226.87,
      "duration_seconds": 3.31,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.38,
      "end_seconds": 229.62,
      "duration_seconds": 2.24,
      "text": "Right, have you retired yet?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.24,
      "end_seconds": 236.28,
      "duration_seconds": 5.04,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.48,
      "end_seconds": 241.53,
      "duration_seconds": 4.05,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.85,
      "end_seconds": 246.58,
      "duration_seconds": 3.73,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 249.11,
      "end_seconds": 256.83,
      "duration_seconds": 7.72,
      "text": "Actually, I remember she had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.13,
      "end_seconds": 260.27,
      "duration_seconds": 2.14,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 266.61,
      "duration_seconds": 5.44,
      "text": "Alright, fair enough, I'll write down both versions. Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.79,
      "end_seconds": 269.89,
      "duration_seconds": 2.1,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 284.38,
      "end_seconds": 293.47,
      "duration_seconds": 9.09,
      "text": "Doctor, I've got the readings for you. BP is 124 over 87, pulse is 121 beats a minute, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.39,
      "end_seconds": 296.09,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.01,
      "end_seconds": 301.35,
      "duration_seconds": 3.34,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.99,
      "end_seconds": 302.69,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.35,
      "end_seconds": 306.6,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.07,
      "end_seconds": 320.6,
      "duration_seconds": 5.53,
      "text": "Your inner eyelids look pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.21,
      "end_seconds": 340.58,
      "duration_seconds": 15.37,
      "text": "Thank you, you can get dressed. So where does that leave us? I don't have a clear answer today: tiredness probably from low iron is possible, and so is low vitamin B12."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 342.46,
      "end_seconds": 345.28,
      "duration_seconds": 2.82,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.67,
      "end_seconds": 362.17,
      "duration_seconds": 15.5,
      "text": "I understand the worry. At the moment I'd say it's tiredness probably from low iron, and we'll know more once the an iron study is back. I think an iron study makes sense here, for pallor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 365.82,
      "end_seconds": 369.16,
      "duration_seconds": 3.34,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.66,
      "end_seconds": 373.89,
      "duration_seconds": 4.23,
      "text": "I think a thyroid test makes sense here, for tiredness."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 375.04,
      "end_seconds": 376.56,
      "duration_seconds": 1.52,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.38,
      "end_seconds": 403.32,
      "duration_seconds": 24.94,
      "text": "I'm prescribing ferrous sulfate, 200 milligrams, once a day, three months. You take it by mouth. That should help with low iron. Take the iron with orange juice, not with tea. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 404.67,
      "end_seconds": 408.37,
      "duration_seconds": 3.7,
      "text": "I, I know what to watch for."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.86,
      "end_seconds": 420.53,
      "duration_seconds": 10.67,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. I'd like you back after the results. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 421.09,
      "end_seconds": 424.69,
      "duration_seconds": 3.6,
      "text": "Well, good, thanks, I'll see you then."
    }
  ]
}