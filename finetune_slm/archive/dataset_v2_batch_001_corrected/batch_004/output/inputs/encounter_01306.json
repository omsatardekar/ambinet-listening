{
  "schema_version": "1.0",
  "encounter_id": "01306",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 9.82,
      "duration_seconds": 8.58,
      "text": "Let me think, um, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.85,
      "end_seconds": 16.28,
      "duration_seconds": 4.43,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.84,
      "end_seconds": 29.83,
      "duration_seconds": 12.99,
      "text": "Good morning, um, doctor. I came along to help out. It's being thirsty, doctor. She didn't wanna come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.31,
      "end_seconds": 37.43,
      "duration_seconds": 6.12,
      "text": "has this been going on for long? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.28,
      "end_seconds": 41.82,
      "duration_seconds": 2.54,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.62,
      "end_seconds": 53.17,
      "duration_seconds": 9.55,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.44,
      "end_seconds": 72.94,
      "duration_seconds": 18.5,
      "text": "Water helps a bit. I'd give it a five, um, out of ten. As for passing urine at night, I honestly can't say when that began. It might have been last month or the month before"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.7,
      "end_seconds": 77.69,
      "duration_seconds": 2.99,
      "text": "And And vomiting, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.58,
      "end_seconds": 80.24,
      "duration_seconds": 1.66,
      "text": "No vomiting, thankfully."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.32,
      "end_seconds": 86.18,
      "duration_seconds": 3.86,
      "text": "Any abdominal pain or weight loss at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.38,
      "end_seconds": 89.6,
      "duration_seconds": 2.22,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 94.52,
      "duration_seconds": 3.54,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.8,
      "end_seconds": 97.39,
      "duration_seconds": 1.59,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.82,
      "end_seconds": 101.02,
      "duration_seconds": 2.2,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.47,
      "end_seconds": 105.17,
      "duration_seconds": 2.7,
      "text": "yeah, no problems with breathing"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.08,
      "end_seconds": 109.41,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.52,
      "end_seconds": 114.18,
      "duration_seconds": 3.66,
      "text": "So, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.02,
      "end_seconds": 120.53,
      "duration_seconds": 4.51,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.17,
      "end_seconds": 129.22,
      "duration_seconds": 7.05,
      "text": "I mean, I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.05,
      "end_seconds": 136.98,
      "duration_seconds": 6.93,
      "text": "alright, arthritis in your knees, that matches what I have here are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.07,
      "end_seconds": 141.63,
      "duration_seconds": 3.56,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.58,
      "end_seconds": 146.2,
      "duration_seconds": 2.62,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.71,
      "end_seconds": 150.63,
      "duration_seconds": 3.92,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.64,
      "end_seconds": 155.64,
      "duration_seconds": 3.0,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.89,
      "end_seconds": 167.24,
      "duration_seconds": 5.35,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.28,
      "end_seconds": 179.18,
      "duration_seconds": 2.9,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.99,
      "end_seconds": 183.88,
      "duration_seconds": 2.89,
      "text": "my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.52,
      "end_seconds": 188.92,
      "duration_seconds": 3.4,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.1,
      "end_seconds": 193.14,
      "duration_seconds": 3.04,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.85,
      "end_seconds": 197.24,
      "duration_seconds": 2.39,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.11,
      "end_seconds": 202.99,
      "duration_seconds": 4.88,
      "text": "Naproxen. I take it 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.34,
      "end_seconds": 218.77,
      "duration_seconds": 2.43,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.84,
      "end_seconds": 227.64,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.01,
      "end_seconds": 253.63,
      "duration_seconds": 9.62,
      "text": "Okay: heart rate 88, weight 67 kilos. And height 170 centimetres, pressure 150 over 94, saturation 96 percent, temperature 36.5."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.34,
      "end_seconds": 257.73,
      "duration_seconds": 2.39,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.5,
      "end_seconds": 262.39,
      "duration_seconds": 3.89,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.37,
      "end_seconds": 268.14,
      "duration_seconds": 3.77,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.27,
      "end_seconds": 275.44,
      "duration_seconds": 1.17,
      "text": "of course"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.93,
      "end_seconds": 279.17,
      "duration_seconds": 2.24,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.6,
      "end_seconds": 301.61,
      "duration_seconds": 7.01,
      "text": "Your weight is up a little and and there are no sores on your feet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.13,
      "end_seconds": 302.83,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.58,
      "end_seconds": 309.66,
      "duration_seconds": 3.08,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.18,
      "end_seconds": 342.79,
      "duration_seconds": 14.61,
      "text": "let me tell you where I've got to. It's hard to say. Possible type 2 diabetes pending blood tests is one possibility and a urine infection another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.31,
      "end_seconds": 346.67,
      "duration_seconds": 2.36,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.63,
      "end_seconds": 373.39,
      "duration_seconds": 24.76,
      "text": "I understand the worry. At the moment I'd say it's possible type 2 diabetes pending blood tests, and we'll know more once the an HbA1c test is back. I'm going to order an HbA1c test, for thirst. Please come and see me after the results. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.08,
      "end_seconds": 378.18,
      "duration_seconds": 4.1,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.11,
      "end_seconds": 382.0,
      "duration_seconds": 1.89,
      "text": "Have a good day."
    }
  ]
}