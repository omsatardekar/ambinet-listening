{
  "schema_version": "1.0",
  "encounter_id": "01353",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 6.48,
      "duration_seconds": 5.28,
      "text": "Afternoon, thanks for coming in. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.59,
      "end_seconds": 13.59,
      "duration_seconds": 6.0,
      "text": "Honestly, it's a racing heart, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.08,
      "end_seconds": 17.12,
      "duration_seconds": 2.04,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.03,
      "end_seconds": 23.54,
      "duration_seconds": 4.51,
      "text": "I'm on tamsulosin, at night for the prostate."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.5,
      "end_seconds": 30.84,
      "duration_seconds": 2.34,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.26,
      "end_seconds": 40.34,
      "duration_seconds": 8.08,
      "text": "It's 0.4 milligrams. I take aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.79,
      "end_seconds": 43.83,
      "duration_seconds": 2.04,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.66,
      "end_seconds": 53.74,
      "duration_seconds": 8.08,
      "text": "About a month now. Okay, so I was on clopidogrel before. I stopped taking it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.04,
      "end_seconds": 62.35,
      "duration_seconds": 3.31,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.18,
      "end_seconds": 65.88,
      "duration_seconds": 2.7,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.57,
      "end_seconds": 70.97,
      "duration_seconds": 3.4,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.58,
      "end_seconds": 74.63,
      "duration_seconds": 3.05,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.85,
      "end_seconds": 78.09,
      "duration_seconds": 2.24,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.42,
      "end_seconds": 99.94,
      "duration_seconds": 20.52,
      "text": "It's all the time. And there's very little urine as well, about two weeks now. And shaking chills and a high temperature, too. About shaking chills and a high temperature, it settles a little with blankets."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.62,
      "end_seconds": 103.76,
      "duration_seconds": 3.14,
      "text": "Have you noticed stiff neck or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.58,
      "end_seconds": 110.8,
      "duration_seconds": 5.22,
      "text": "I haven't had stiff neck or chest pain, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.38,
      "end_seconds": 114.0,
      "duration_seconds": 2.62,
      "text": "Okay, did you notice any rash?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.62,
      "end_seconds": 116.28,
      "duration_seconds": 1.66,
      "text": "Nope, no rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.3,
      "end_seconds": 120.81,
      "duration_seconds": 3.51,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.2,
      "end_seconds": 123.15,
      "duration_seconds": 0.95,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.62,
      "end_seconds": 127.79,
      "duration_seconds": 3.17,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.35,
      "end_seconds": 129.99,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.49,
      "end_seconds": 146.77,
      "duration_seconds": 2.28,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.56,
      "end_seconds": 151.8,
      "duration_seconds": 4.24,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.18,
      "end_seconds": 155.11,
      "duration_seconds": 1.93,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.75,
      "end_seconds": 160.42,
      "duration_seconds": 3.67,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.43,
      "end_seconds": 162.85,
      "duration_seconds": 1.42,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.93,
      "end_seconds": 168.26,
      "duration_seconds": 3.33,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.11,
      "end_seconds": 172.51,
      "duration_seconds": 2.4,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.51,
      "end_seconds": 179.76,
      "duration_seconds": 5.25,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.18,
      "end_seconds": 195.57,
      "duration_seconds": 2.39,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.3,
      "end_seconds": 207.52,
      "duration_seconds": 8.22,
      "text": "I've had an enlarged prostate for about a year now. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.16,
      "end_seconds": 212.81,
      "duration_seconds": 3.65,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.83,
      "end_seconds": 226.57,
      "duration_seconds": 2.74,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.75,
      "end_seconds": 250.41,
      "duration_seconds": 12.66,
      "text": "Okay: blood pressure 106 over 67, temperature 38.2. And respiratory rate 22, SpO2 96 percent on room air, pulse is 93 beats a minute."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.37,
      "end_seconds": 255.48,
      "duration_seconds": 2.11,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.15,
      "end_seconds": 261.85,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.95,
      "end_seconds": 265.82,
      "duration_seconds": 2.87,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.34,
      "end_seconds": 290.22,
      "duration_seconds": 6.88,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.43,
      "end_seconds": 292.8,
      "duration_seconds": 1.37,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.27,
      "end_seconds": 298.36,
      "duration_seconds": 2.09,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.7,
      "end_seconds": 340.42,
      "duration_seconds": 30.72,
      "text": "So where does that leave us? I can't pin this down yet. We're looking at possible sepsis needing urgent treatment or a severe urine or chest infection. I want blood cultures done, that's for fever with low blood pressure. I want to admit you to hospital now for fluids and antibiotics. I'll also refer you to the emergency team. Come back or go to emergency straight away if you cannot be brought in today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.66,
      "end_seconds": 344.14,
      "duration_seconds": 2.48,
      "text": "I'll want another look straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.31,
      "end_seconds": 351.84,
      "duration_seconds": 3.53,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.66,
      "end_seconds": 356.15,
      "duration_seconds": 2.49,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.1,
      "end_seconds": 362.04,
      "duration_seconds": 3.94,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}