{
  "schema_version": "1.0",
  "encounter_id": "01287",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.22,
      "end_seconds": 6.43,
      "duration_seconds": 5.21,
      "text": "Hello, good to see you. Please sit. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.69,
      "end_seconds": 16.62,
      "duration_seconds": 8.93,
      "text": "Mainly a pink spotty rash. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.06,
      "end_seconds": 21.63,
      "duration_seconds": 3.57,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.81,
      "end_seconds": 28.32,
      "duration_seconds": 5.51,
      "text": "For three days, I'd say. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.09,
      "end_seconds": 32.28,
      "duration_seconds": 2.19,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.81,
      "end_seconds": 40.51,
      "duration_seconds": 7.7,
      "text": "Yeah, it usually comes with a mild temperature. The mild temperature? That's been for ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.37,
      "end_seconds": 44.49,
      "duration_seconds": 2.12,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.64,
      "end_seconds": 47.89,
      "duration_seconds": 2.25,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.48,
      "end_seconds": 52.38,
      "duration_seconds": 3.9,
      "text": "Mm, okay. Any drowsiness, breathlessness or stiff neck?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.88,
      "end_seconds": 59.74,
      "duration_seconds": 6.86,
      "text": "Sorry, what was I saying, I haven't had drowsiness, breathlessness or stiff neck, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.37,
      "end_seconds": 64.44,
      "duration_seconds": 4.07,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.02,
      "end_seconds": 67.49,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.46,
      "end_seconds": 78.31,
      "duration_seconds": 2.85,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.35,
      "end_seconds": 82.15,
      "duration_seconds": 2.8,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.02,
      "end_seconds": 87.6,
      "duration_seconds": 3.58,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.58,
      "end_seconds": 92.98,
      "duration_seconds": 2.4,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.76,
      "end_seconds": 98.44,
      "duration_seconds": 4.68,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 102.53,
      "duration_seconds": 3.41,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.85,
      "end_seconds": 106.15,
      "duration_seconds": 2.3,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.12,
      "end_seconds": 110.79,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 115.28,
      "duration_seconds": 2.95,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.36,
      "end_seconds": 120.76,
      "duration_seconds": 3.4,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.54,
      "end_seconds": 137.03,
      "duration_seconds": 2.49,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.11,
      "end_seconds": 149.43,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.77,
      "end_seconds": 176.9,
      "duration_seconds": 11.13,
      "text": "Okay: respiratory rate 16, temperature 36.8, oxygen saturation is 98 percent, BP is 120 over 77, pulse is 75 beats a minute."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.59,
      "end_seconds": 179.99,
      "duration_seconds": 1.4,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.33,
      "end_seconds": 184.16,
      "duration_seconds": 2.83,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.15,
      "end_seconds": 189.66,
      "duration_seconds": 2.51,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.84,
      "end_seconds": 192.14,
      "duration_seconds": 1.3,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.9,
      "end_seconds": 207.03,
      "duration_seconds": 5.13,
      "text": "The spots fade when pressed and he is playful and drinking well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.74,
      "end_seconds": 209.52,
      "duration_seconds": 1.78,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.89,
      "end_seconds": 213.63,
      "duration_seconds": 1.74,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.48,
      "end_seconds": 241.68,
      "duration_seconds": 13.2,
      "text": "Let me tell you where I've got to. This is probably a harmless viral rash. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.53,
      "end_seconds": 245.72,
      "duration_seconds": 3.19,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.68,
      "end_seconds": 254.0,
      "duration_seconds": 6.32,
      "text": "Nothing I've seen today points to an emergency. It looks like a harmless viral rash."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.24,
      "end_seconds": 272.99,
      "duration_seconds": 10.75,
      "text": "Fluids and paracetamol if he is hot or uncomfortable. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.35,
      "end_seconds": 281.08,
      "duration_seconds": 7.73,
      "text": "Mm, okay. Do get help quickly if the spots do not fade when pressed or he becomes drowsy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.74,
      "end_seconds": 284.66,
      "duration_seconds": 2.92,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.5,
      "end_seconds": 291.37,
      "duration_seconds": 4.87,
      "text": "I'd like you back if it lasts more than a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.47,
      "end_seconds": 294.39,
      "duration_seconds": 1.92,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.85,
      "end_seconds": 300.58,
      "duration_seconds": 4.73,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.4,
      "end_seconds": 309.38,
      "duration_seconds": 6.98,
      "text": "So, I come back if it lasts more than a week. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.33,
      "end_seconds": 317.42,
      "duration_seconds": 6.09,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.05,
      "end_seconds": 321.14,
      "duration_seconds": 2.09,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}