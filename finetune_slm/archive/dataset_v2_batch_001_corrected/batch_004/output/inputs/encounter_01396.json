{
  "schema_version": "1.0",
  "encounter_id": "01396",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 6.66,
      "duration_seconds": 5.8,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.08,
      "end_seconds": 11.74,
      "duration_seconds": 3.66,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.55,
      "end_seconds": 28.61,
      "duration_seconds": 16.06,
      "text": "Ah, uh, it's an irregular heartbeat. I thought I'd wait, but it hasn't gone. I've been putting this off for weeks. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.52,
      "end_seconds": 34.5,
      "duration_seconds": 2.98,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.47,
      "end_seconds": 39.22,
      "duration_seconds": 2.75,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.14,
      "end_seconds": 42.93,
      "duration_seconds": 2.79,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.58,
      "end_seconds": 46.28,
      "duration_seconds": 1.7,
      "text": "it's mild, honestly"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.1,
      "end_seconds": 50.26,
      "duration_seconds": 2.16,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.06,
      "end_seconds": 57.72,
      "duration_seconds": 5.66,
      "text": "Yeah, it usually comes with being short of breath on slopes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.92,
      "end_seconds": 61.0,
      "duration_seconds": 2.08,
      "text": "Have you had occasional bruising?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.05,
      "end_seconds": 65.1,
      "duration_seconds": 1.05,
      "text": "mm, yes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.92,
      "end_seconds": 70.37,
      "duration_seconds": 3.45,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.92,
      "end_seconds": 74.28,
      "duration_seconds": 3.36,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.02,
      "end_seconds": 82.89,
      "duration_seconds": 6.87,
      "text": "Have you had an irregular heartbeat before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.97,
      "end_seconds": 90.4,
      "duration_seconds": 6.43,
      "text": "Let me think, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.23,
      "end_seconds": 95.15,
      "duration_seconds": 2.92,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.79,
      "end_seconds": 106.88,
      "duration_seconds": 11.09,
      "text": "um, I've had an irregular heartbeat for two years now i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.49,
      "end_seconds": 112.73,
      "duration_seconds": 4.24,
      "text": "Alright, an irregular heartbeat, that matches what I have here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.52,
      "end_seconds": 130.02,
      "duration_seconds": 2.5,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.1,
      "end_seconds": 134.33,
      "duration_seconds": 3.23,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.76,
      "end_seconds": 137.99,
      "duration_seconds": 2.23,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.47,
      "end_seconds": 143.7,
      "duration_seconds": 4.23,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.29,
      "end_seconds": 145.97,
      "duration_seconds": 1.68,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.82,
      "end_seconds": 151.09,
      "duration_seconds": 3.27,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.91,
      "end_seconds": 156.16,
      "duration_seconds": 3.25,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.83,
      "end_seconds": 163.43,
      "duration_seconds": 6.6,
      "text": "Metoprolol i take it 50 milligrams, twice a day for the heart rhythm"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.19,
      "end_seconds": 169.45,
      "duration_seconds": 5.26,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.24,
      "end_seconds": 174.69,
      "duration_seconds": 3.45,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.28,
      "end_seconds": 178.44,
      "duration_seconds": 2.16,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.93,
      "end_seconds": 188.78,
      "duration_seconds": 8.85,
      "text": "Just an operation for a hernia, last spring. I didn't wanna bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.33,
      "end_seconds": 193.44,
      "duration_seconds": 3.11,
      "text": "Have you noticed fainting or chest pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.84,
      "end_seconds": 201.24,
      "duration_seconds": 2.4,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.33,
      "end_seconds": 206.57,
      "duration_seconds": 3.24,
      "text": "Have you noticed black stools or nosebleeds?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.12,
      "end_seconds": 210.89,
      "duration_seconds": 3.77,
      "text": "I haven't had black stools or nosebleeds, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.86,
      "end_seconds": 215.99,
      "duration_seconds": 3.13,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.43,
      "end_seconds": 219.3,
      "duration_seconds": 1.87,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.59,
      "end_seconds": 222.58,
      "duration_seconds": 1.99,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.16,
      "end_seconds": 225.44,
      "duration_seconds": 2.28,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.44,
      "end_seconds": 237.16,
      "duration_seconds": 2.72,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.05,
      "end_seconds": 249.55,
      "duration_seconds": 2.5,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.58,
      "end_seconds": 273.29,
      "duration_seconds": 8.71,
      "text": "Okay: oxygen saturation is 98 percent, temperature 36.6. And pulse 118, blood pressure 120 over 86, respiratory rate 17."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.55,
      "end_seconds": 279.36,
      "duration_seconds": 3.81,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.9,
      "end_seconds": 296.9,
      "duration_seconds": 1.0,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.2,
      "end_seconds": 300.62,
      "duration_seconds": 2.42,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 314.14,
      "duration_seconds": 4.58,
      "text": "your pulse is irregular and your heart sounds are otherwise normal"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.34,
      "end_seconds": 316.33,
      "duration_seconds": 0.99,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.0,
      "end_seconds": 329.13,
      "duration_seconds": 10.13,
      "text": "Good, you can sit up again. Having listened and examined, this is probably atrial fibrillation, rate reasonably controlled. We shouldn't forget anaemia from bleeding."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.57,
      "end_seconds": 333.95,
      "duration_seconds": 3.38,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.87,
      "end_seconds": 366.88,
      "duration_seconds": 32.01,
      "text": "I understand the worry. At the moment I'd say it's atrial fibrillation, rate reasonably controlled, and we'll know more once the a full blood count is back. a full blood count is what I'd like next, for anticoagulant review. We should do an ECG for irregular pulse. I'm sending you for kidney function tests because of anticoagulant dosing. Never skip the blood thinner, and tell any dentist or surgeon you take it. Book a review in three months."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.83,
      "end_seconds": 371.32,
      "duration_seconds": 2.49,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.38,
      "end_seconds": 375.31,
      "duration_seconds": 2.93,
      "text": "I think I understand everything. Thanks."
    }
  ]
}