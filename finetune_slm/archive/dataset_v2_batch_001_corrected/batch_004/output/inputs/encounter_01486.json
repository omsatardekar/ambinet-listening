{
  "schema_version": "1.0",
  "encounter_id": "01486",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.64,
      "duration_seconds": 4.79,
      "text": "oh, good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 10.99,
      "duration_seconds": 4.18,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.04,
      "end_seconds": 25.17,
      "duration_seconds": 12.13,
      "text": "Mainly a sore throat. There's a couple of other things, but that's the the main one. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 30.48,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.49,
      "end_seconds": 34.28,
      "duration_seconds": 1.79,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.22,
      "end_seconds": 44.74,
      "duration_seconds": 9.52,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.88,
      "end_seconds": 55.67,
      "duration_seconds": 9.79,
      "text": "I get some relief from warm drinks it's worse with swallowing i did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.63,
      "end_seconds": 74.36,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.95,
      "end_seconds": 85.46,
      "duration_seconds": 2.51,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.95,
      "end_seconds": 103.64,
      "duration_seconds": 6.69,
      "text": "Okay: temp 36.7 degrees, pulse 67. And BP is 112 over 78, saturation 97 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.37,
      "end_seconds": 109.3,
      "duration_seconds": 2.93,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.86,
      "end_seconds": 112.08,
      "duration_seconds": 1.22,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.62,
      "end_seconds": 125.5,
      "duration_seconds": 3.88,
      "text": "your oxygen is normal and your chest is clear"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.94,
      "end_seconds": 132.78,
      "duration_seconds": 1.84,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.62,
      "end_seconds": 148.95,
      "duration_seconds": 2.33,
      "text": "And breathlessness, any of that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.75,
      "end_seconds": 153.93,
      "duration_seconds": 3.18,
      "text": "No, I haven't had any breathlessness."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.94,
      "end_seconds": 157.85,
      "duration_seconds": 2.91,
      "text": "and what about chest pain or confusion?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.69,
      "end_seconds": 162.5,
      "duration_seconds": 3.81,
      "text": "No chest pain or confusion, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.66,
      "end_seconds": 166.91,
      "duration_seconds": 3.25,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.92,
      "end_seconds": 170.74,
      "duration_seconds": 1.82,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.79,
      "end_seconds": 174.11,
      "duration_seconds": 1.32,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.95,
      "end_seconds": 179.82,
      "duration_seconds": 3.87,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.67,
      "end_seconds": 187.66,
      "duration_seconds": 2.99,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.41,
      "end_seconds": 191.98,
      "duration_seconds": 3.57,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.7,
      "end_seconds": 194.87,
      "duration_seconds": 2.17,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.46,
      "end_seconds": 200.57,
      "duration_seconds": 4.11,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.06,
      "end_seconds": 203.42,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.49,
      "end_seconds": 210.3,
      "duration_seconds": 2.81,
      "text": "Right, no, not at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.71,
      "end_seconds": 214.2,
      "duration_seconds": 2.49,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.42,
      "end_seconds": 221.29,
      "duration_seconds": 5.87,
      "text": "I take warfarin, 3 milligrams, in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.13,
      "end_seconds": 228.93,
      "duration_seconds": 5.8,
      "text": "Are you allergic to anything? Any allergies to to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.57,
      "end_seconds": 235.19,
      "duration_seconds": 3.62,
      "text": "Yes, milk, it gives me stomach cramps."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.79,
      "end_seconds": 238.99,
      "duration_seconds": 3.2,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.19,
      "end_seconds": 247.95,
      "duration_seconds": 7.76,
      "text": "An irregular heartbeat, for two years. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.15,
      "end_seconds": 256.41,
      "duration_seconds": 7.26,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.1,
      "end_seconds": 285.15,
      "duration_seconds": 11.05,
      "text": "Putting it all together, the most likely explanation is a mild viral respiratory infection. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.03,
      "end_seconds": 304.75,
      "duration_seconds": 4.72,
      "text": "I think a COVID test makes sense here, for respiratory symptoms."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.56,
      "end_seconds": 308.41,
      "duration_seconds": 2.85,
      "text": "well, how long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.6,
      "end_seconds": 314.96,
      "duration_seconds": 5.36,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.54,
      "end_seconds": 319.94,
      "duration_seconds": 3.4,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.11,
      "end_seconds": 322.32,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}