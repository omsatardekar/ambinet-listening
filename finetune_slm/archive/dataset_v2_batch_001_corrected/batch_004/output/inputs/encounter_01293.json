{
  "schema_version": "1.0",
  "encounter_id": "01293",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 2.73,
      "duration_seconds": 1.79,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.26,
      "end_seconds": 8.25,
      "duration_seconds": 4.99,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.22,
      "end_seconds": 17.11,
      "duration_seconds": 4.89,
      "text": "So, I've been waking at night with wheeze, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.87,
      "end_seconds": 22.59,
      "duration_seconds": 3.72,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.57,
      "end_seconds": 28.07,
      "duration_seconds": 3.5,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.61,
      "end_seconds": 36.14,
      "duration_seconds": 2.53,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.14,
      "end_seconds": 42.02,
      "duration_seconds": 3.88,
      "text": "it's a couple of times a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.59,
      "end_seconds": 46.68,
      "duration_seconds": 3.09,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.03,
      "end_seconds": 51.49,
      "duration_seconds": 3.46,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.6,
      "end_seconds": 66.1,
      "duration_seconds": 3.5,
      "text": "So, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.84,
      "end_seconds": 73.95,
      "duration_seconds": 3.11,
      "text": "no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.99,
      "end_seconds": 93.58,
      "duration_seconds": 2.59,
      "text": "right, do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.39,
      "end_seconds": 99.86,
      "duration_seconds": 4.47,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.61,
      "end_seconds": 106.85,
      "duration_seconds": 3.24,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.46,
      "end_seconds": 111.35,
      "duration_seconds": 3.89,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.98,
      "end_seconds": 114.98,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.02,
      "end_seconds": 120.38,
      "duration_seconds": 4.36,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.75,
      "end_seconds": 125.29,
      "duration_seconds": 3.54,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.28,
      "end_seconds": 130.55,
      "duration_seconds": 4.27,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.38,
      "end_seconds": 143.96,
      "duration_seconds": 4.58,
      "text": "right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.6,
      "end_seconds": 150.61,
      "duration_seconds": 3.01,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.81,
      "end_seconds": 155.99,
      "duration_seconds": 4.18,
      "text": "have you noticed fever, leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.67,
      "end_seconds": 159.3,
      "duration_seconds": 2.63,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.26,
      "end_seconds": 164.31,
      "duration_seconds": 3.05,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.13,
      "end_seconds": 167.98,
      "duration_seconds": 1.85,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.63,
      "end_seconds": 173.33,
      "duration_seconds": 3.7,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.35,
      "end_seconds": 175.92,
      "duration_seconds": 1.57,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.99,
      "end_seconds": 181.29,
      "duration_seconds": 3.3,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.82,
      "end_seconds": 197.06,
      "duration_seconds": 3.24,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.68,
      "end_seconds": 218.42,
      "duration_seconds": 9.74,
      "text": "Okay: heart rate 65, temperature is 36.9 degrees, BP is 108 over 77. And oxygen saturation is 98 percent, respiratory rate 15."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.48,
      "end_seconds": 222.86,
      "duration_seconds": 2.38,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.38,
      "end_seconds": 227.03,
      "duration_seconds": 3.65,
      "text": "I'll explain what these mean in a a moment"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.82,
      "end_seconds": 232.75,
      "duration_seconds": 2.93,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.97,
      "end_seconds": 244.93,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.01,
      "end_seconds": 247.84,
      "duration_seconds": 1.83,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.53,
      "end_seconds": 261.77,
      "duration_seconds": 5.24,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.27,
      "end_seconds": 273.21,
      "duration_seconds": 6.94,
      "text": "You can sit up now. Having listened and examined, it fits best with poorly controlled asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.28,
      "end_seconds": 276.78,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.3,
      "end_seconds": 294.66,
      "duration_seconds": 17.36,
      "text": "I understand the worry. At the moment I'd say it's poorly controlled asthma, and we'll know more once the a peak flow reading is back. I want a peak flow reading done, that's for asthma."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.21,
      "end_seconds": 296.27,
      "duration_seconds": 1.06,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.6,
      "end_seconds": 322.22,
      "duration_seconds": 24.62,
      "text": "I'm going to put you on beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term. That should help with asthma control. Use the spacer and rinse your mouth after the preventer. Spirometry is something we might do if this doesn't improve in a month. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.59,
      "end_seconds": 327.29,
      "duration_seconds": 3.7,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.13,
      "end_seconds": 330.5,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}