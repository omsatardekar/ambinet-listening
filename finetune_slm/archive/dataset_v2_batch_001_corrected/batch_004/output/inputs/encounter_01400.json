{
  "schema_version": "1.0",
  "encounter_id": "01400",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 5.95,
      "duration_seconds": 5.01,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 11.14,
      "duration_seconds": 3.15,
      "text": "thank you right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.8,
      "end_seconds": 21.91,
      "duration_seconds": 9.11,
      "text": "Ah, you know, I've been waking at night with wheeze, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.21,
      "end_seconds": 26.43,
      "duration_seconds": 3.22,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.46,
      "end_seconds": 31.63,
      "duration_seconds": 4.17,
      "text": "it's been going on for about two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.79,
      "end_seconds": 37.2,
      "duration_seconds": 4.41,
      "text": "Okay give me more detail on it whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.27,
      "end_seconds": 62.41,
      "duration_seconds": 24.14,
      "text": "Well, it feels moderate to me. Yes, cold air. That makes it worse. I get some relief from inhaler. Sorry, uh, what was I saying, and I've been using my blue inhaler a lot as well, for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 67.11,
      "duration_seconds": 2.96,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.69,
      "end_seconds": 69.03,
      "duration_seconds": 1.34,
      "text": "Severe, really"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 74.65,
      "duration_seconds": 5.36,
      "text": "mm-hmm have you noticed leg swelling, fever or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.28,
      "end_seconds": 81.46,
      "duration_seconds": 6.18,
      "text": "No leg swelling, fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.06,
      "end_seconds": 84.39,
      "duration_seconds": 2.33,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.01,
      "end_seconds": 88.63,
      "duration_seconds": 3.62,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.23,
      "end_seconds": 91.84,
      "duration_seconds": 2.61,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.32,
      "end_seconds": 94.34,
      "duration_seconds": 1.02,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 114.04,
      "duration_seconds": 3.14,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.23,
      "end_seconds": 118.02,
      "duration_seconds": 2.79,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.88,
      "end_seconds": 122.79,
      "duration_seconds": 3.91,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.94,
      "end_seconds": 127.65,
      "duration_seconds": 1.71,
      "text": "No no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.15,
      "end_seconds": 144.8,
      "duration_seconds": 2.65,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.51,
      "end_seconds": 149.19,
      "duration_seconds": 2.68,
      "text": "no, you know, none"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.43,
      "end_seconds": 155.22,
      "duration_seconds": 4.79,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.3,
      "end_seconds": 159.87,
      "duration_seconds": 3.57,
      "text": "not to my knowledge, uh, no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.88,
      "end_seconds": 164.63,
      "duration_seconds": 2.75,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.72,
      "end_seconds": 172.53,
      "duration_seconds": 5.81,
      "text": "Well, just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.67,
      "end_seconds": 174.97,
      "duration_seconds": 1.3,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.97,
      "end_seconds": 180.95,
      "duration_seconds": 3.98,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.17,
      "end_seconds": 185.16,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.96,
      "end_seconds": 192.92,
      "duration_seconds": 2.96,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.79,
      "end_seconds": 196.91,
      "duration_seconds": 3.12,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.03,
      "end_seconds": 202.58,
      "duration_seconds": 4.55,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 203.35,
      "end_seconds": 213.9,
      "duration_seconds": 10.55,
      "text": "here are the numbers, doctor temperature 36.5, saturation 98 percent, pressure 119 over 69, respiratory rate 18, pulse is 71 beats a minute"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.92,
      "end_seconds": 216.89,
      "duration_seconds": 0.97,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.78,
      "end_seconds": 223.77,
      "duration_seconds": 3.99,
      "text": "Alright now I'm gonna do a a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.72,
      "end_seconds": 226.98,
      "duration_seconds": 1.26,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.31,
      "end_seconds": 251.21,
      "duration_seconds": 5.9,
      "text": "there is a little wheeze at the end of each breath out"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.66,
      "end_seconds": 258.22,
      "duration_seconds": 2.56,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.21,
      "end_seconds": 277.6,
      "duration_seconds": 9.39,
      "text": "Right here's what I'm thinking. The most likely explanation is poorly controlled asthma. I can't rule out an inhaler technique problem yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 278.64,
      "end_seconds": 280.77,
      "duration_seconds": 2.13,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.22,
      "end_seconds": 295.01,
      "duration_seconds": 12.79,
      "text": "I understand the worry. At the the moment I'd say it's poorly controlled asthma and we'll know more once the a peak flow reading is back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 296.02,
      "end_seconds": 302.62,
      "duration_seconds": 6.6,
      "text": "doctor, I did a peak flow reading before they came in, the result's on your screen"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.22,
      "end_seconds": 315.39,
      "duration_seconds": 11.17,
      "text": "okay, great, that's useful what I'm giving you is beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term that's for asthma control"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 321.53,
      "end_seconds": 322.75,
      "duration_seconds": 1.22,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.33,
      "end_seconds": 333.55,
      "duration_seconds": 6.22,
      "text": "come back in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.19,
      "end_seconds": 337.75,
      "duration_seconds": 3.56,
      "text": "great, thank you for your help"
    }
  ]
