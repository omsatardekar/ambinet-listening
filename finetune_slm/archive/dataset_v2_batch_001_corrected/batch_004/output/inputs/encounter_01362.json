      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.87,
      "end_seconds": 255.78,
      "duration_seconds": 4.91,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 260.52,
      "duration_seconds": 2.12,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.32,
      "end_seconds": 290.86,
      "duration_seconds": 20.54,
      "text": "Right here's what I'm thinking. I can't pin this down yet. We're looking at diabetic ketoacidosis or a severe infection. We should do blood gas and electrolytes for DKA. You need to go to hospital now for insulin and fluids. I think the the emergency team should see you too."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.4,
      "end_seconds": 295.26,
      "duration_seconds": 2.86,
      "text": "Sure where do I go?"
