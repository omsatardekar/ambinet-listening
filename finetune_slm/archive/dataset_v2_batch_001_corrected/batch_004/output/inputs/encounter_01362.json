    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.25,
      "end_seconds": 182.77,
      "duration_seconds": 3.52,
      "text": "Um, my mother had a stroke."
