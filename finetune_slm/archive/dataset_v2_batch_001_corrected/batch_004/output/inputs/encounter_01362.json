      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.68,
      "end_seconds": 189.79,
      "duration_seconds": 3.11,
      "text": "what do you do during the day?"
