      "role": "NURSE",
      "start_seconds": 206.36,
      "end_seconds": 220.99,
      "duration_seconds": 14.63,
      "text": "here are the numbers, doctor temperature 37.0, weight 56 kilos, pressure 123 over 78. Height 164 centimetres, oxygen saturation is 99 percent, BMI works out to to 20.8, heart rate 123."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.57,
      "end_seconds": 223.17,
      "duration_seconds": 1.6,
      "text": "Good, thank you."
