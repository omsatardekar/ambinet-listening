      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.76,
      "end_seconds": 230.61,
      "duration_seconds": 4.85,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.0,
      "end_seconds": 234.43,
      "duration_seconds": 2.43,
      "text": "I'm just checking this side."
