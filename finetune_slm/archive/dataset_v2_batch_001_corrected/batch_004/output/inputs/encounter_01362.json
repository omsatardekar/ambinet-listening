      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.95,
      "end_seconds": 303.78,
      "duration_seconds": 7.83,
      "text": "Let's plan a a check straight away. Okay, I think we're done unless you have questions."
