{
  "schema_version": "1.0",
  "encounter_id": "01495",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 4.04,
      "duration_seconds": 3.38,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.52,
      "end_seconds": 6.57,
      "duration_seconds": 1.05,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.73,
      "end_seconds": 9.58,
      "duration_seconds": 1.85,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.88,
      "end_seconds": 19.24,
      "duration_seconds": 8.36,
      "text": "Let me think, um, it has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.69,
      "end_seconds": 25.65,
      "duration_seconds": 2.96,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.24,
      "end_seconds": 34.48,
      "duration_seconds": 8.24,
      "text": "Let me think, uh, so the thing is, I've got sudden low back pain."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.94,
      "end_seconds": 40.84,
      "duration_seconds": 2.9,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.16,
      "end_seconds": 59.1,
      "duration_seconds": 16.94,
      "text": "Since last night, that's when it began. Work has been very busy so I kept ignoring it. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.2,
      "end_seconds": 68.79,
      "duration_seconds": 8.59,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.38,
      "end_seconds": 80.55,
      "duration_seconds": 11.17,
      "text": "Ah, it's worse with lifting. Only walking, and it's not much. Yeah, I've had stiffness too, for five days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.1,
      "end_seconds": 85.57,
      "duration_seconds": 3.47,
      "text": "Any a twinge down the thigh as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.12,
      "end_seconds": 90.25,
      "duration_seconds": 4.13,
      "text": "Yeah. About two weeks, you know, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.87,
      "end_seconds": 96.28,
      "duration_seconds": 4.41,
      "text": "Have you had numbness in the groin, by any chance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.35,
      "end_seconds": 103.3,
      "duration_seconds": 5.95,
      "text": "I mean, no, I haven't had any numbness in the groin."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.47,
      "end_seconds": 108.25,
      "duration_seconds": 3.78,
      "text": "Have you noticed fever, bladder problems or leg weakness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.65,
      "end_seconds": 112.42,
      "duration_seconds": 2.77,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.57,
      "end_seconds": 116.92,
      "duration_seconds": 3.35,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.52,
      "end_seconds": 119.08,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.03,
      "end_seconds": 127.1,
      "duration_seconds": 4.07,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.18,
      "end_seconds": 134.65,
      "duration_seconds": 6.47,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.65,
      "end_seconds": 138.59,
      "duration_seconds": 2.94,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.06,
      "end_seconds": 145.38,
      "duration_seconds": 5.32,
      "text": "Erm, I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.37,
      "end_seconds": 148.9,
      "duration_seconds": 2.53,
      "text": "Hm, okay. How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.65,
      "end_seconds": 154.36,
      "duration_seconds": 3.71,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.69,
      "end_seconds": 157.71,
      "duration_seconds": 2.02,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.75,
      "end_seconds": 162.56,
      "duration_seconds": 2.81,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.59,
      "end_seconds": 167.49,
      "duration_seconds": 2.9,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.09,
      "end_seconds": 173.89,
      "duration_seconds": 5.8,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.41,
      "end_seconds": 178.21,
      "duration_seconds": 2.8,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.51,
      "end_seconds": 182.61,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 191.22,
      "duration_seconds": 4.19,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.03,
      "end_seconds": 199.59,
      "duration_seconds": 3.56,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.27,
      "end_seconds": 221.08,
      "duration_seconds": 3.81,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.47,
      "end_seconds": 226.2,
      "duration_seconds": 3.73,
      "text": "I'm on Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.34,
      "end_seconds": 230.34,
      "duration_seconds": 3.0,
      "text": "So, do you know the dose?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.28,
      "end_seconds": 242.15,
      "duration_seconds": 9.87,
      "text": "500 milligrams, I think that's what's on the box. I'm on paracetamol, 1 gram, maybe, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.79,
      "end_seconds": 248.31,
      "duration_seconds": 4.52,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.04,
      "end_seconds": 257.23,
      "duration_seconds": 8.19,
      "text": "Sorry, um, what was I saying, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.66,
      "end_seconds": 275.87,
      "duration_seconds": 3.21,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.37,
      "end_seconds": 278.77,
      "duration_seconds": 2.4,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.31,
      "end_seconds": 291.43,
      "duration_seconds": 3.12,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.66,
      "end_seconds": 303.73,
      "duration_seconds": 2.07,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.63,
      "end_seconds": 345.48,
      "duration_seconds": 27.85,
      "text": "Okay: heart rate 69, saturation 99 percent, respiratory rate 17. And pressure 125 over 68, temp 37.0 degrees. Putting together what you've described, I'd lean towards mechanical low back pain. We shouldn't forget a nerve irritation. Stop me if I've got anything wrong. You've had sudden low back pain, since last night, and no fever or numbness in the groin."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.05,
      "end_seconds": 347.75,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.86,
      "end_seconds": 361.51,
      "duration_seconds": 10.65,
      "text": "I'll start you on naproxen, 500 milligrams, twice a day with food, five days. You take it by mouth. That's for back pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.72,
      "end_seconds": 365.34,
      "duration_seconds": 2.62,
      "text": "Thank you, uh, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.1,
      "end_seconds": 394.36,
      "duration_seconds": 27.26,
      "text": "Keep moving and walk a little each day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if you notice numbness in the groin or lose bladder control. If that happens, go to emergency. Please come and see me if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 396.01,
      "end_seconds": 396.71,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.01,
      "end_seconds": 401.18,
      "duration_seconds": 3.17,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.49,
      "end_seconds": 406.53,
      "duration_seconds": 4.04,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.32,
      "end_seconds": 410.03,
      "duration_seconds": 1.71,
      "text": "Alright, see you soon."
    }
  ]
}