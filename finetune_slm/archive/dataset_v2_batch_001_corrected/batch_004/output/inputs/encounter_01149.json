{
  "schema_version": "1.0",
  "encounter_id": "01149",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 6.99,
      "duration_seconds": 5.83,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.53,
      "end_seconds": 13.45,
      "duration_seconds": 4.92,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.24,
      "end_seconds": 21.44,
      "duration_seconds": 6.2,
      "text": "hello, uh, doctor i'm here with them in case I can help"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.46,
      "end_seconds": 25.53,
      "duration_seconds": 3.07,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.12,
      "end_seconds": 35.34,
      "duration_seconds": 9.22,
      "text": "well, I've been having a stiff neck. Work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.18,
      "end_seconds": 43.31,
      "duration_seconds": 3.13,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.12,
      "end_seconds": 51.19,
      "duration_seconds": 7.07,
      "text": "uh, it's Thyronorm, 50 micrograms, every morning for my thyroid, doctor"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.84,
      "end_seconds": 56.19,
      "duration_seconds": 3.35,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.99,
      "end_seconds": 61.71,
      "duration_seconds": 3.72,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.51,
      "end_seconds": 66.8,
      "duration_seconds": 3.29,
      "text": "Is it it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.51,
      "end_seconds": 72.76,
      "duration_seconds": 5.25,
      "text": "Oh, um, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.39,
      "end_seconds": 77.14,
      "duration_seconds": 3.75,
      "text": "What about hating the light, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.2,
      "end_seconds": 94.43,
      "duration_seconds": 15.23,
      "text": "yes, you know, actually as for hating the light, pretty moderate, if I'm being honest i had a severe headache before that's settled now, um, though"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.56,
      "end_seconds": 108.75,
      "duration_seconds": 3.19,
      "text": "Have you noticed cough or recent head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.08,
      "end_seconds": 114.25,
      "duration_seconds": 4.17,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.14,
      "end_seconds": 118.8,
      "duration_seconds": 2.66,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.35,
      "end_seconds": 120.9,
      "duration_seconds": 1.55,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.29,
      "end_seconds": 124.66,
      "duration_seconds": 2.37,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.65,
      "end_seconds": 126.85,
      "duration_seconds": 1.2,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.28,
      "end_seconds": 131.91,
      "duration_seconds": 3.63,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.37,
      "end_seconds": 136.67,
      "duration_seconds": 3.3,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.91,
      "end_seconds": 141.62,
      "duration_seconds": 3.71,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.17,
      "end_seconds": 150.09,
      "duration_seconds": 2.92,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.34,
      "end_seconds": 152.7,
      "duration_seconds": 1.36,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.12,
      "end_seconds": 164.43,
      "duration_seconds": 3.31,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.31,
      "end_seconds": 169.24,
      "duration_seconds": 2.93,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.4,
      "end_seconds": 180.38,
      "duration_seconds": 0.98,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.36,
      "end_seconds": 184.87,
      "duration_seconds": 2.51,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.27,
      "end_seconds": 188.24,
      "duration_seconds": 1.97,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.41,
      "end_seconds": 193.47,
      "duration_seconds": 4.06,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 197.71,
      "duration_seconds": 3.09,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.3,
      "end_seconds": 202.77,
      "duration_seconds": 3.47,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.63,
      "end_seconds": 205.65,
      "duration_seconds": 2.02,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.92,
      "end_seconds": 213.68,
      "duration_seconds": 6.76,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.89,
      "end_seconds": 218.03,
      "duration_seconds": 3.14,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.8,
      "end_seconds": 222.62,
      "duration_seconds": 3.82,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.27,
      "end_seconds": 225.38,
      "duration_seconds": 2.11,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.51,
      "end_seconds": 236.51,
      "duration_seconds": 3.0,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.52,
      "end_seconds": 253.94,
      "duration_seconds": 7.42,
      "text": "Okay: blood pressure 112 over 69, saturation 97 percent, pulse is 99 beats a minute."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.55,
      "end_seconds": 259.23,
      "duration_seconds": 2.68,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.05,
      "end_seconds": 262.06,
      "duration_seconds": 2.01,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 288.51,
      "duration_seconds": 8.85,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.39,
      "end_seconds": 292.08,
      "duration_seconds": 1.69,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.44,
      "end_seconds": 334.57,
      "duration_seconds": 39.13,
      "text": "thank you, you can get dressed putting it all together, it points towards possible bacterial meningitis another possibility is meningococcal septicaemia we should do a lumbar puncture for possible meningitis i'm prescribing benzylpenicillin, 1.2 grams, once now, single dose that's for possible meningitis call an ambulance now, this is an emergency the emergency team would be the right next step, I'll refer you book a review straight away so, I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.42,
      "end_seconds": 339.8,
      "duration_seconds": 3.38,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.39,
      "end_seconds": 341.67,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}