{
  "schema_version": "1.0",
  "encounter_id": "01122",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.74,
      "end_seconds": 2.67,
      "duration_seconds": 1.93,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.24,
      "end_seconds": 10.07,
      "duration_seconds": 5.83,
      "text": "Hmm, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.35,
      "end_seconds": 14.15,
      "duration_seconds": 2.8,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.0,
      "end_seconds": 17.83,
      "duration_seconds": 2.83,
      "text": "I've been dealing with night sweats."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.02,
      "end_seconds": 20.41,
      "duration_seconds": 1.39,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.58,
      "end_seconds": 24.63,
      "duration_seconds": 3.05,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.47,
      "end_seconds": 31.43,
      "duration_seconds": 4.96,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.5,
      "end_seconds": 45.31,
      "duration_seconds": 12.81,
      "text": "Honestly, every other day. Oh, and vaginal dryness. With vaginal dryness, I'd call it mild. Poor sleep was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.75,
      "end_seconds": 50.32,
      "duration_seconds": 3.57,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.83,
      "end_seconds": 53.26,
      "duration_seconds": 1.43,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.57,
      "end_seconds": 57.74,
      "duration_seconds": 3.17,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.51,
      "end_seconds": 63.7,
      "duration_seconds": 5.19,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.57,
      "end_seconds": 66.28,
      "duration_seconds": 1.71,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.04,
      "end_seconds": 71.51,
      "duration_seconds": 4.47,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.4,
      "end_seconds": 75.0,
      "duration_seconds": 1.6,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.61,
      "end_seconds": 80.48,
      "duration_seconds": 3.87,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.22,
      "end_seconds": 86.74,
      "duration_seconds": 4.52,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.65,
      "end_seconds": 100.99,
      "duration_seconds": 13.34,
      "text": "I've got high cholesterol. I've had high blood pressure, yes. I did try to ignore it for a while. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.33,
      "end_seconds": 108.43,
      "duration_seconds": 6.1,
      "text": "Understood. Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.89,
      "end_seconds": 121.34,
      "duration_seconds": 2.45,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.83,
      "end_seconds": 126.96,
      "duration_seconds": 4.13,
      "text": "I'm on simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.05,
      "end_seconds": 131.96,
      "duration_seconds": 2.91,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.84,
      "end_seconds": 142.07,
      "duration_seconds": 9.23,
      "text": "For two months. Ramipril. I take it 5 milligrams, every morning. Before this I was on hydrochlorothiazide; that's been stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.16,
      "end_seconds": 147.96,
      "duration_seconds": 4.8,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.04,
      "end_seconds": 152.95,
      "duration_seconds": 2.91,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.37,
      "end_seconds": 172.73,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.55,
      "end_seconds": 176.19,
      "duration_seconds": 1.64,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.56,
      "end_seconds": 181.07,
      "duration_seconds": 3.51,
      "text": "And what about heavy bleeding or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.67,
      "end_seconds": 185.67,
      "duration_seconds": 4.0,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.67,
      "end_seconds": 188.3,
      "duration_seconds": 1.63,
      "text": "How about weight loss?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.13,
      "end_seconds": 191.07,
      "duration_seconds": 1.94,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.95,
      "end_seconds": 194.08,
      "duration_seconds": 2.13,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.6,
      "end_seconds": 197.34,
      "duration_seconds": 1.74,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 205.88,
      "duration_seconds": 5.22,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.77,
      "end_seconds": 208.4,
      "duration_seconds": 1.63,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.3,
      "end_seconds": 224.02,
      "duration_seconds": 2.72,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.91,
      "end_seconds": 234.4,
      "duration_seconds": 2.49,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.01,
      "end_seconds": 260.37,
      "duration_seconds": 10.36,
      "text": "Okay: pulse is 67 beats a minute, temperature is 36.8 degrees, respiratory rate 14. And pressure 108 over 76, saturation 99 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.03,
      "end_seconds": 263.35,
      "duration_seconds": 2.32,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.0,
      "end_seconds": 268.06,
      "duration_seconds": 4.06,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.02,
      "end_seconds": 274.47,
      "duration_seconds": 4.45,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.04,
      "end_seconds": 277.44,
      "duration_seconds": 1.4,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.75,
      "end_seconds": 293.86,
      "duration_seconds": 2.11,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.03,
      "end_seconds": 304.07,
      "duration_seconds": 7.04,
      "text": "Thank you, you can get dressed. Okay, thinking it through, it fits best with menopausal symptoms."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.42,
      "end_seconds": 308.32,
      "duration_seconds": 2.9,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.72,
      "end_seconds": 322.33,
      "duration_seconds": 12.61,
      "text": "Nothing I've seen today points to an emergency. It looks like menopausal symptoms. I'm going to put you on estradiol patch, 50 micrograms, twice weekly, long term. That's for menopausal symptoms."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.9,
      "end_seconds": 324.38,
      "duration_seconds": 1.48,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.33,
      "end_seconds": 332.0,
      "duration_seconds": 3.67,
      "text": "Please come and see me in three months."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.25,
      "end_seconds": 335.59,
      "duration_seconds": 2.34,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.19,
      "end_seconds": 341.11,
      "duration_seconds": 3.92,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.69,
      "end_seconds": 345.52,
      "duration_seconds": 3.83,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.19,
      "end_seconds": 348.76,
      "duration_seconds": 1.57,
      "text": "Have a good day."
    }
  ]
}