{
  "schema_version": "1.0",
  "encounter_id": "01425",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 3.75,
      "duration_seconds": 2.9,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.5,
      "end_seconds": 9.9,
      "duration_seconds": 4.4,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.94,
      "end_seconds": 22.76,
      "duration_seconds": 11.82,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. It's a lingering cough, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.23,
      "end_seconds": 27.74,
      "duration_seconds": 3.51,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.73,
      "end_seconds": 37.29,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.79,
      "end_seconds": 64.06,
      "duration_seconds": 10.27,
      "text": "Okay: pulse is 65 beats a minute, BP is 115 over 73. And oxygen saturation is 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.92,
      "end_seconds": 67.85,
      "duration_seconds": 1.93,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.52,
      "end_seconds": 72.47,
      "duration_seconds": 2.95,
      "text": "that's fine, I'll explain it it soon"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.51,
      "end_seconds": 92.68,
      "duration_seconds": 3.17,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.99,
      "end_seconds": 98.6,
      "duration_seconds": 4.61,
      "text": "let me think, around three days, I think"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 100.1,
      "end_seconds": 104.38,
      "duration_seconds": 4.28,
      "text": "Yeah, hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.26,
      "end_seconds": 109.41,
      "duration_seconds": 4.15,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.87,
      "end_seconds": 112.79,
      "duration_seconds": 1.92,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.39,
      "end_seconds": 117.57,
      "duration_seconds": 3.18,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.2,
      "end_seconds": 122.31,
      "duration_seconds": 3.11,
      "text": "about a eight out of ten"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.0,
      "end_seconds": 125.18,
      "duration_seconds": 2.18,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.41,
      "end_seconds": 131.27,
      "duration_seconds": 4.86,
      "text": "Okay, you know, so talking definitely sets it off."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.99,
      "end_seconds": 134.36,
      "duration_seconds": 2.37,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.08,
      "end_seconds": 145.85,
      "duration_seconds": 10.77,
      "text": "It usually comes with a tickle in my throat. Well, the tickle in my throat? That's been for two months."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.85,
      "end_seconds": 148.31,
      "duration_seconds": 1.46,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.42,
      "end_seconds": 152.26,
      "duration_seconds": 2.84,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 153.37,
      "end_seconds": 158.18,
      "duration_seconds": 4.81,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.95,
      "end_seconds": 165.66,
      "duration_seconds": 6.71,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.7,
      "end_seconds": 174.45,
      "duration_seconds": 7.75,
      "text": "alright, I'll note both what you've said and what you've noticed have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.78,
      "end_seconds": 179.74,
      "duration_seconds": 3.96,
      "text": "not that I've noticed, no weight loss"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.35,
      "end_seconds": 185.93,
      "duration_seconds": 4.58,
      "text": "Did you get shortness of breath or coughing up blood?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.01,
      "end_seconds": 190.88,
      "duration_seconds": 2.87,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.72,
      "end_seconds": 195.03,
      "duration_seconds": 3.31,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.39,
      "end_seconds": 198.87,
      "duration_seconds": 2.48,
      "text": "Ah, no, that's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.52,
      "end_seconds": 202.56,
      "duration_seconds": 3.04,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.72,
      "end_seconds": 205.84,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.95,
      "end_seconds": 209.02,
      "duration_seconds": 2.07,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 211.09,
      "end_seconds": 226.31,
      "duration_seconds": 15.22,
      "text": "She is on thyroxine, 75 micrograms, every morning, I give it to her. She takes carvedilol, 6.25 milligrams, twice a day for my heart. She takes honey and lemon, at night."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.76,
      "end_seconds": 242.15,
      "duration_seconds": 5.39,
      "text": "Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.06,
      "end_seconds": 245.58,
      "duration_seconds": 2.52,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.82,
      "end_seconds": 248.78,
      "duration_seconds": 1.96,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.47,
      "end_seconds": 253.23,
      "duration_seconds": 3.76,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.88,
      "end_seconds": 255.24,
      "duration_seconds": 1.36,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.01,
      "end_seconds": 258.26,
      "duration_seconds": 2.25,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 260.76,
      "duration_seconds": 1.26,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.43,
      "end_seconds": 265.06,
      "duration_seconds": 3.63,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.43,
      "end_seconds": 268.18,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.43,
      "end_seconds": 271.9,
      "duration_seconds": 2.47,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.7,
      "end_seconds": 275.19,
      "duration_seconds": 2.49,
      "text": "Alright, do you get out much?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.95,
      "end_seconds": 280.2,
      "duration_seconds": 4.25,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.68,
      "end_seconds": 288.71,
      "duration_seconds": 4.03,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.04,
      "end_seconds": 300.22,
      "duration_seconds": 10.18,
      "text": "I've got an underactive thyroid i've, I've got heart failure my neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.71,
      "end_seconds": 306.2,
      "duration_seconds": 4.49,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.97,
      "end_seconds": 313.42,
      "duration_seconds": 4.45,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.94,
      "end_seconds": 316.65,
      "duration_seconds": 2.71,
      "text": "Yeah, you know, no problem."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.15,
      "end_seconds": 319.71,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.41,
      "end_seconds": 340.97,
      "duration_seconds": 3.56,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.54,
      "end_seconds": 361.67,
      "duration_seconds": 17.13,
      "text": "good, you can sit up again from what you've told me and what I found, it's hard to say a post-viral cough that is settling is one possibility and early asthma another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.69,
      "end_seconds": 365.7,
      "duration_seconds": 2.01,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.39,
      "end_seconds": 378.73,
      "duration_seconds": 9.34,
      "text": "I understand the worry. At the moment I'd say it's a post-viral cough that is settling, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.14,
      "end_seconds": 400.89,
      "duration_seconds": 11.75,
      "text": "it should settle over the next two to three weeks; steam and honey can help. Come back or go to emergency straight away if you cough up blood"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.33,
      "end_seconds": 403.92,
      "duration_seconds": 1.59,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.9,
      "end_seconds": 412.68,
      "duration_seconds": 7.78,
      "text": "I'd like you back if it lasts beyond eight weeks. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.62,
      "end_seconds": 416.5,
      "duration_seconds": 2.88,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}