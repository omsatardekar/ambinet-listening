{
  "schema_version": "1.0",
  "encounter_id": "01238",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.24,
      "duration_seconds": 3.25,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 10.26,
      "duration_seconds": 4.81,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.25,
      "end_seconds": 20.77,
      "duration_seconds": 8.52,
      "text": "I'm here because of numbness between my legs. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.11,
      "end_seconds": 24.5,
      "duration_seconds": 2.39,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.08,
      "end_seconds": 28.49,
      "duration_seconds": 2.41,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.8,
      "end_seconds": 42.98,
      "duration_seconds": 3.18,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.06,
      "end_seconds": 46.64,
      "duration_seconds": 2.58,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.17,
      "end_seconds": 51.12,
      "duration_seconds": 2.95,
      "text": "Any severe lower back pain as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.71,
      "end_seconds": 53.75,
      "duration_seconds": 1.04,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.83,
      "end_seconds": 58.94,
      "duration_seconds": 3.11,
      "text": "A few quick ones: fever or recent fall?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.95,
      "end_seconds": 64.35,
      "duration_seconds": 3.4,
      "text": "No, no fever or recent fall."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.47,
      "end_seconds": 69.88,
      "duration_seconds": 4.41,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.76,
      "end_seconds": 76.17,
      "duration_seconds": 2.41,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.84,
      "end_seconds": 97.68,
      "duration_seconds": 4.84,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 99.9,
      "duration_seconds": 1.25,
      "text": "Yes, wheat."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.77,
      "end_seconds": 104.18,
      "duration_seconds": 3.41,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.02,
      "end_seconds": 115.59,
      "duration_seconds": 5.57,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.99,
      "end_seconds": 118.59,
      "duration_seconds": 1.6,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.51,
      "end_seconds": 123.36,
      "duration_seconds": 3.85,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.38,
      "end_seconds": 141.53,
      "duration_seconds": 4.15,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.41,
      "end_seconds": 146.9,
      "duration_seconds": 3.49,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.78,
      "end_seconds": 159.82,
      "duration_seconds": 2.04,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.13,
      "end_seconds": 173.95,
      "duration_seconds": 2.82,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.49,
      "end_seconds": 200.6,
      "duration_seconds": 11.11,
      "text": "Okay: pressure 120 over 76, pulse is 84 beats a minute. And respiratory rate 17, BMI works out to 29.3, height 159 centimetres, weight 74 kilos."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.07,
      "end_seconds": 206.67,
      "duration_seconds": 3.6,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.02,
      "end_seconds": 209.41,
      "duration_seconds": 1.39,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.77,
      "end_seconds": 212.72,
      "duration_seconds": 1.95,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.29,
      "end_seconds": 236.46,
      "duration_seconds": 5.17,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.72,
      "end_seconds": 251.6,
      "duration_seconds": 11.88,
      "text": "Okay, that's enough for me. From what you've told me and what I found, this looks most like possible cauda equina syndrome needing an urgent scan."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.73,
      "end_seconds": 255.73,
      "duration_seconds": 3.0,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.68,
      "end_seconds": 276.2,
      "duration_seconds": 19.52,
      "text": "I understand the worry. At the moment I'd say it's possible cauda equina syndrome needing an urgent scan, and we'll know more once the an urgent MRI of the spine is back. Let's book an urgent MRI of the spine to look into possible cauda equina."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.01,
      "end_seconds": 281.08,
      "duration_seconds": 3.07,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.79,
      "end_seconds": 306.46,
      "duration_seconds": 19.67,
      "text": "You need to go to hospital now for an emergency scan. I'd like you to see the spinal team as well, and I'll write the referral. If the numbness spreads, that's the point to come in urgently. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.23,
      "end_seconds": 311.2,
      "duration_seconds": 2.97,
      "text": "Alright, uh, thanks, take care."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.91,
      "end_seconds": 314.36,
      "duration_seconds": 1.45,
      "text": "See you soon."
    }
  ]
}