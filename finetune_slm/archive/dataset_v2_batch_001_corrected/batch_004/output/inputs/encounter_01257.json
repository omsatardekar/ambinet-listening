  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 5.31,
      "duration_seconds": 4.0,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 11.54,
      "duration_seconds": 4.78,
      "text": "So, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.58,
      "end_seconds": 20.38,
      "duration_seconds": 6.8,
      "text": "It's headaches in the morning. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.31,
      "end_seconds": 25.45,
      "duration_seconds": 3.14,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.55,
      "end_seconds": 38.06,
      "duration_seconds": 10.51,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.55,
      "end_seconds": 48.84,
      "duration_seconds": 9.29,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.03,
      "end_seconds": 59.09,
      "duration_seconds": 9.06,
      "text": "It's on and off. About a five out of ten. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.66,
      "end_seconds": 62.27,
      "duration_seconds": 2.61,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.5,
      "end_seconds": 89.89,
      "duration_seconds": 26.39,
      "text": "I mean, when it starts I tend to get a pounding in my ears as well. Right, um, and I've been feeling tired as well. Uh, the pounding in my ears? That's been for two months. Actually, with pounding in my ears, I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 91.43,
      "end_seconds": 104.13,
      "duration_seconds": 12.7,
      "text": "here are the numbers, doctor spO2 99 percent on room air, temp 36.9 degrees weight 66 kilos, heart rate 79, height 162 centimetres, pressure 159 over 100."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.11,
      "end_seconds": 107.53,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.39,
      "end_seconds": 113.57,
      "duration_seconds": 4.18,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.25,
      "end_seconds": 118.95,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.41,
      "end_seconds": 122.92,
      "duration_seconds": 2.51,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.36,
      "end_seconds": 138.24,
      "duration_seconds": 5.88,
      "text": "Your heart sounds are normal and there is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.28,
      "end_seconds": 139.98,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.67,
      "end_seconds": 152.96,
      "duration_seconds": 8.29,
      "text": "Thank you, you can get dressed. Any breathlessness, leg swelling, visual changes or chest pain at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 158.62,
      "duration_seconds": 4.46,
      "text": "Yeah, no, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.16,
      "end_seconds": 162.53,
      "duration_seconds": 3.37,
      "text": "Right, right. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.57,
      "end_seconds": 165.52,
      "duration_seconds": 1.95,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.05,
      "end_seconds": 168.98,
      "duration_seconds": 2.93,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.76,
      "end_seconds": 171.91,
      "duration_seconds": 2.15,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.54,
      "end_seconds": 192.32,
      "duration_seconds": 2.78,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.91,
      "end_seconds": 197.13,
      "duration_seconds": 4.22,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 201.88,
      "duration_seconds": 2.92,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.23,
      "end_seconds": 207.4,
      "duration_seconds": 4.17,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.19,
      "end_seconds": 211.22,
      "duration_seconds": 2.03,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.27,
      "end_seconds": 217.8,
      "duration_seconds": 4.53,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.58,
      "end_seconds": 223.16,
      "duration_seconds": 4.58,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.38,
      "end_seconds": 240.06,
      "duration_seconds": 15.68,
      "text": "I've had high blood pressure, yes. I've had acid reflux, yes. I thought it would sort itself out, but it hasn't. I did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.38,
      "end_seconds": 246.83,
      "duration_seconds": 5.45,
      "text": "Alright, high blood pressure and acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.42,
      "end_seconds": 260.07,
      "duration_seconds": 3.65,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.76,
      "end_seconds": 267.05,
      "duration_seconds": 3.29,
      "text": "Omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.99,
      "end_seconds": 281.93,
      "duration_seconds": 4.94,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.58,
      "end_seconds": 288.63,
      "duration_seconds": 5.05,
      "text": "Let me think, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.62,
      "end_seconds": 322.4,
      "duration_seconds": 32.78,
      "text": "taking everything into account, my working impression is blood pressure above target on current treatment. I think a 24-hour blood pressure monitor makes sense here, for hypertension. I'm going to put you on amlodipine, 5 milligrams, once a day, long term. That's for blood pressure. Cut down on salty foods and and keep a home blood pressure diary. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Come back after the monitor"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.75,
      "end_seconds": 327.07,
      "duration_seconds": 3.32,
      "text": "um, that's fine with me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.04,
      "end_seconds": 333.27,
      "duration_seconds": 4.23,
      "text": "Okay, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.8,
      "end_seconds": 343.4,
      "duration_seconds": 9.6,
      "text": "so, I take the amlodipine, 5 milligrams, once a day and come back after the monitor is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.38,
      "end_seconds": 350.49,
      "duration_seconds": 5.11,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.22,
      "end_seconds": 353.75,
      "duration_seconds": 2.53,
      "text": "Alright, thanks, take care."
    }
  ]
