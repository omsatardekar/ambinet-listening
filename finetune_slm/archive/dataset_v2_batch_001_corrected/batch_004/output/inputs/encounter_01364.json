{
  "schema_version": "1.0",
  "encounter_id": "01364",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.04,
      "end_seconds": 6.62,
      "duration_seconds": 5.58,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.55,
      "end_seconds": 9.53,
      "duration_seconds": 0.98,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.16,
      "end_seconds": 15.85,
      "duration_seconds": 5.69,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.43,
      "end_seconds": 22.2,
      "duration_seconds": 5.77,
      "text": "Please do. Extra information is always welcome. So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.7,
      "end_seconds": 29.93,
      "duration_seconds": 6.23,
      "text": "It's crushing chest pain, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 30.97,
      "end_seconds": 43.63,
      "duration_seconds": 12.66,
      "text": "Okay, so the vitals from earlier. SpO2 96 percent on room air, blood pressure 133 over 86. Pulse is 116 beats a minute, temp 37.0 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.69,
      "end_seconds": 50.35,
      "duration_seconds": 4.66,
      "text": "Okay, noted. Right, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.64,
      "end_seconds": 54.1,
      "duration_seconds": 2.46,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.95,
      "end_seconds": 64.2,
      "duration_seconds": 9.25,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.25,
      "end_seconds": 76.76,
      "duration_seconds": 10.51,
      "text": "I'd say every other day. Exertion definitely sets it off. Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.29,
      "end_seconds": 81.36,
      "duration_seconds": 4.07,
      "text": "Has there been pain going into your left arm too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.13,
      "end_seconds": 84.57,
      "duration_seconds": 2.44,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.44,
      "end_seconds": 88.07,
      "duration_seconds": 1.63,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.79,
      "end_seconds": 91.28,
      "duration_seconds": 1.49,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.87,
      "end_seconds": 98.23,
      "duration_seconds": 2.36,
      "text": "And what about fever or cough?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.19,
      "end_seconds": 101.98,
      "duration_seconds": 2.79,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.75,
      "end_seconds": 105.13,
      "duration_seconds": 1.38,
      "text": "Any leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.18,
      "end_seconds": 110.66,
      "duration_seconds": 3.48,
      "text": "Not that I've noticed, no leg swelling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.54,
      "end_seconds": 114.12,
      "duration_seconds": 2.58,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.64,
      "end_seconds": 117.11,
      "duration_seconds": 2.47,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.53,
      "end_seconds": 121.89,
      "duration_seconds": 3.36,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.48,
      "end_seconds": 124.3,
      "duration_seconds": 1.82,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.1,
      "end_seconds": 135.65,
      "duration_seconds": 3.55,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.31,
      "end_seconds": 142.65,
      "duration_seconds": 5.34,
      "text": "Right, I'm allergic to cat fur, I get wheezing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.46,
      "end_seconds": 147.01,
      "duration_seconds": 3.55,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.83,
      "end_seconds": 153.69,
      "duration_seconds": 4.86,
      "text": "Telmisartan. I take it 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 155.36,
      "end_seconds": 162.31,
      "duration_seconds": 6.95,
      "text": "It's meant to be once a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.1,
      "end_seconds": 167.09,
      "duration_seconds": 3.99,
      "text": "Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 168.8,
      "end_seconds": 173.86,
      "duration_seconds": 5.06,
      "text": "Doctor, our chart from the last visit lists it as 40 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.64,
      "end_seconds": 178.49,
      "duration_seconds": 3.85,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.91,
      "end_seconds": 187.83,
      "duration_seconds": 7.92,
      "text": "Not with me. I'll bring it next time. I was on losartan before. I stopped taking it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.85,
      "end_seconds": 192.75,
      "duration_seconds": 2.9,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.61,
      "end_seconds": 198.17,
      "duration_seconds": 4.56,
      "text": "My father has Parkinson's disease. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.57,
      "end_seconds": 208.62,
      "duration_seconds": 2.05,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.39,
      "end_seconds": 220.05,
      "duration_seconds": 8.66,
      "text": "I have high blood pressure, for five years. Uh, I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.71,
      "end_seconds": 222.83,
      "duration_seconds": 2.12,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.14,
      "end_seconds": 228.06,
      "duration_seconds": 3.92,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.96,
      "end_seconds": 232.78,
      "duration_seconds": 2.82,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.02,
      "end_seconds": 237.42,
      "duration_seconds": 3.4,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.27,
      "end_seconds": 240.53,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.89,
      "end_seconds": 244.68,
      "duration_seconds": 2.79,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.83,
      "end_seconds": 261.79,
      "duration_seconds": 2.96,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.86,
      "end_seconds": 268.77,
      "duration_seconds": 4.91,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.76,
      "end_seconds": 277.1,
      "duration_seconds": 5.34,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.95,
      "end_seconds": 279.12,
      "duration_seconds": 1.17,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.86,
      "end_seconds": 292.62,
      "duration_seconds": 4.76,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.64,
      "end_seconds": 298.23,
      "duration_seconds": 1.59,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 300.3,
      "end_seconds": 304.16,
      "duration_seconds": 3.86,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.24,
      "end_seconds": 335.5,
      "duration_seconds": 29.26,
      "text": "Right, thank you. I'll request a troponin blood test, it'll help with chest pain. The treatment will be aspirin, 300 milligrams, once now, single dose. That's for possible heart attack. Stay lying down and do not eat or drink. Let's get you seen by the cardiac team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.81,
      "end_seconds": 339.73,
      "duration_seconds": 2.92,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.39,
      "end_seconds": 345.87,
      "duration_seconds": 5.48,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.64,
      "end_seconds": 350.99,
      "duration_seconds": 3.35,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}