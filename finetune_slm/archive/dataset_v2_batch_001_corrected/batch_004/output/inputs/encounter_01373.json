{
  "schema_version": "1.0",
  "encounter_id": "01373",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 5.61,
      "duration_seconds": 4.37,
      "text": "Hello, come in. Mind the step. What's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.97,
      "end_seconds": 18.39,
      "duration_seconds": 11.42,
      "text": "Well, I'm here because of not being able to finish a sentence. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.93,
      "end_seconds": 21.31,
      "duration_seconds": 1.38,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.84,
      "end_seconds": 30.45,
      "duration_seconds": 7.61,
      "text": "I've had it for three weeks. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.98,
      "end_seconds": 34.21,
      "duration_seconds": 3.23,
      "text": "Yes. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.23,
      "end_seconds": 44.96,
      "duration_seconds": 9.73,
      "text": "It feels moderate to me. I've also had wheezing, since last night. About wheezing, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.39,
      "end_seconds": 52.47,
      "duration_seconds": 3.08,
      "text": "Any fever, blue tinge or chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.87,
      "end_seconds": 57.86,
      "duration_seconds": 1.99,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.8,
      "end_seconds": 62.41,
      "duration_seconds": 3.61,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.24,
      "end_seconds": 67.55,
      "duration_seconds": 4.31,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.07,
      "end_seconds": 71.36,
      "duration_seconds": 2.29,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.53,
      "end_seconds": 77.03,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.74,
      "end_seconds": 82.73,
      "duration_seconds": 4.99,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.93,
      "end_seconds": 86.16,
      "duration_seconds": 2.23,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.87,
      "end_seconds": 88.64,
      "duration_seconds": 1.77,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.4,
      "end_seconds": 93.32,
      "duration_seconds": 2.92,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.02,
      "end_seconds": 107.64,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.48,
      "end_seconds": 118.09,
      "duration_seconds": 8.61,
      "text": "I've had asthma for five years now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.23,
      "end_seconds": 124.22,
      "duration_seconds": 0.99,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 130.14,
      "duration_seconds": 4.17,
      "text": "I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.55,
      "end_seconds": 140.85,
      "duration_seconds": 9.3,
      "text": "Yes. Alright, asthma, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.43,
      "end_seconds": 157.16,
      "duration_seconds": 11.73,
      "text": "My partner and our baby. Not much, I mostly stay in these days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.04,
      "end_seconds": 170.46,
      "duration_seconds": 3.42,
      "text": "Alright, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.32,
      "end_seconds": 174.76,
      "duration_seconds": 3.44,
      "text": "Hmm, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.76,
      "end_seconds": 194.48,
      "duration_seconds": 2.72,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.94,
      "end_seconds": 208.06,
      "duration_seconds": 2.12,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.22,
      "end_seconds": 234.03,
      "duration_seconds": 8.81,
      "text": "Okay: pulse 93, oxygen saturation is 90 percent, blood pressure 118 over 74. And temperature 36.8, respiratory rate 25."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.8,
      "end_seconds": 237.45,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.35,
      "end_seconds": 242.15,
      "duration_seconds": 2.8,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.32,
      "end_seconds": 247.53,
      "duration_seconds": 4.21,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.58,
      "end_seconds": 251.09,
      "duration_seconds": 1.51,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.01,
      "end_seconds": 253.41,
      "duration_seconds": 1.4,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.18,
      "end_seconds": 272.31,
      "duration_seconds": 6.13,
      "text": "You are using your neck muscles to breathe, and your oxygen is low."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.79,
      "end_seconds": 296.67,
      "duration_seconds": 21.88,
      "text": "Okay, all finished, thank you. So, based on the history and the examination, my working impression is a severe asthma attack. Let's get a chest X-ray, for severe breathlessness. The result will help us decide whether anything more is needed. I'll request a peak flow, it'll help with asthma attack."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.05,
      "end_seconds": 320.24,
      "duration_seconds": 22.19,
      "text": "I'm going to put you on salbutamol, 5 milligrams, now, single dose. That's for asthma attack. The pharmacy will go through the details again when you pick it up. Sit upright and take slow breaths while the nebuliser is set up. I'll want another look straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.85,
      "end_seconds": 323.89,
      "duration_seconds": 3.04,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}