{
  "schema_version": "1.0",
  "encounter_id": "01020",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 3.36,
      "duration_seconds": 2.39,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.66,
      "end_seconds": 5.76,
      "duration_seconds": 1.1,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.95,
      "end_seconds": 13.77,
      "duration_seconds": 6.82,
      "text": "hello, uh, doctor. I hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.04,
      "end_seconds": 21.7,
      "duration_seconds": 6.66,
      "text": "So, yes, that's no problem at all. Please sit. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.14,
      "end_seconds": 29.59,
      "duration_seconds": 6.45,
      "text": "Doctor, it's pressure over my cheeks. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.85,
      "end_seconds": 32.25,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.69,
      "end_seconds": 40.95,
      "duration_seconds": 7.26,
      "text": "About two weeks, I think... sorry, three weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.15,
      "end_seconds": 46.72,
      "duration_seconds": 4.57,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.6,
      "end_seconds": 52.28,
      "duration_seconds": 4.68,
      "text": "Bending forward definitely sets it off. It's severe, honestly"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 57.12,
      "duration_seconds": 3.22,
      "text": "Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.43,
      "end_seconds": 65.9,
      "duration_seconds": 7.47,
      "text": "When it starts I tend to get a poor sense of smell as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.93,
      "end_seconds": 69.39,
      "duration_seconds": 2.46,
      "text": "Nothing like swelling around the eye?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.24,
      "end_seconds": 74.92,
      "duration_seconds": 3.68,
      "text": "no. No swelling around the eye"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.04,
      "end_seconds": 80.6,
      "duration_seconds": 4.56,
      "text": "Have you had any double vision, fever or severe headache?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.69,
      "end_seconds": 84.85,
      "duration_seconds": 3.16,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.35,
      "end_seconds": 89.61,
      "duration_seconds": 4.26,
      "text": "Alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.27,
      "end_seconds": 94.4,
      "duration_seconds": 4.13,
      "text": "Okay, so no, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.37,
      "end_seconds": 97.9,
      "duration_seconds": 1.53,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.83,
      "end_seconds": 101.35,
      "duration_seconds": 1.52,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.58,
      "end_seconds": 120.8,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.78,
      "end_seconds": 125.86,
      "duration_seconds": 3.08,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.43,
      "end_seconds": 133.43,
      "duration_seconds": 4.0,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.14,
      "end_seconds": 140.97,
      "duration_seconds": 3.83,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.89,
      "end_seconds": 144.51,
      "duration_seconds": 2.62,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.05,
      "end_seconds": 150.46,
      "duration_seconds": 4.41,
      "text": "It's metoprolol, twice a day for my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.97,
      "end_seconds": 153.0,
      "duration_seconds": 2.03,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.84,
      "end_seconds": 160.6,
      "duration_seconds": 6.76,
      "text": "50 milligrams. Saline nasal spray i take it three times a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.03,
      "end_seconds": 165.36,
      "duration_seconds": 4.33,
      "text": "Yes, carry on. Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.67,
      "end_seconds": 172.51,
      "duration_seconds": 5.84,
      "text": "I've got heart disease it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.19,
      "end_seconds": 178.63,
      "duration_seconds": 4.44,
      "text": "okay, I can see heart disease in your file as well"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.89,
      "end_seconds": 196.78,
      "duration_seconds": 1.89,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.32,
      "end_seconds": 201.44,
      "duration_seconds": 3.12,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.09,
      "end_seconds": 205.05,
      "duration_seconds": 2.96,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.72,
      "end_seconds": 210.13,
      "duration_seconds": 4.41,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.03,
      "end_seconds": 214.14,
      "duration_seconds": 2.11,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.33,
      "end_seconds": 219.77,
      "duration_seconds": 4.44,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.24,
      "end_seconds": 224.99,
      "duration_seconds": 3.75,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.78,
      "end_seconds": 228.01,
      "duration_seconds": 1.23,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.09,
      "end_seconds": 249.92,
      "duration_seconds": 5.83,
      "text": "There is tenderness over both cheeks and the nasal lining looks swollen."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.8,
      "end_seconds": 257.4,
      "duration_seconds": 1.6,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.23,
      "end_seconds": 304.67,
      "duration_seconds": 32.44,
      "text": "Okay, thinking it through, this looks most like chronic sinusitis. I can't rule out a deviated septum yet. The treatment will be mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That should help with sinus inflammation. Rinse your nose with saline twice a day. Cut down on salt and fried food for now, it really does make a difference. Let's get you seen by the ENT clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.09,
      "end_seconds": 323.53,
      "duration_seconds": 15.44,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's plan a check in eight weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.05,
      "end_seconds": 328.65,
      "duration_seconds": 4.6,
      "text": "Actually, okay, that makes sense. Thanks for explaining."
    }
  ]
}