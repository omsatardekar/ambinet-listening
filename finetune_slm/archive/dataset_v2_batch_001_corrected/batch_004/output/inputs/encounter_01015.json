{
  "schema_version": "1.0",
  "encounter_id": "01015",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.13,
      "duration_seconds": 3.98,
      "text": "morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.61,
      "duration_seconds": 4.55,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.7,
      "end_seconds": 16.96,
      "duration_seconds": 5.26,
      "text": "hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.42,
      "end_seconds": 22.71,
      "duration_seconds": 4.29,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.9,
      "end_seconds": 30.38,
      "duration_seconds": 6.48,
      "text": "Doctor you know it's a swollen painful calf. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.21,
      "end_seconds": 36.56,
      "duration_seconds": 4.35,
      "text": "When was the the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.13,
      "end_seconds": 41.02,
      "duration_seconds": 2.89,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.69,
      "end_seconds": 46.15,
      "duration_seconds": 4.46,
      "text": "okay give me more detail on it whatever comes to mind"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.89,
      "end_seconds": 61.36,
      "duration_seconds": 14.47,
      "text": "yes walking that makes it worse i'd say a few times a day. Sharp pain when I breathe in was there but it's gone away on its own"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.95,
      "end_seconds": 64.18,
      "duration_seconds": 2.23,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.67,
      "end_seconds": 72.3,
      "duration_seconds": 3.63,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.26,
      "end_seconds": 77.38,
      "duration_seconds": 3.12,
      "text": "have you noticed chest tightness or wheeze?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.45,
      "end_seconds": 82.24,
      "duration_seconds": 2.79,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.99,
      "end_seconds": 86.76,
      "duration_seconds": 3.77,
      "text": "what about your tummy and bowels anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.81,
      "end_seconds": 91.02,
      "duration_seconds": 3.21,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.59,
      "end_seconds": 94.92,
      "duration_seconds": 2.33,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.26,
      "end_seconds": 105.78,
      "duration_seconds": 5.52,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.12,
      "end_seconds": 110.03,
      "duration_seconds": 2.91,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.75,
      "end_seconds": 114.96,
      "duration_seconds": 4.21,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.0,
      "end_seconds": 119.38,
      "duration_seconds": 1.38,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.4,
      "end_seconds": 124.41,
      "duration_seconds": 4.01,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.16,
      "end_seconds": 139.83,
      "duration_seconds": 4.67,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.86,
      "end_seconds": 151.09,
      "duration_seconds": 8.23,
      "text": "I was told I'm allergic to erythromycin but I don't remember what reaction I had"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.46,
      "end_seconds": 158.66,
      "duration_seconds": 6.2,
      "text": "so has anyone ever diagnosed you with something? Take your time there's no rush"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.71,
      "end_seconds": 163.5,
      "duration_seconds": 2.79,
      "text": "I've had heart disease yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.26,
      "end_seconds": 165.63,
      "duration_seconds": 1.37,
      "text": "any other things?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.57,
      "end_seconds": 173.74,
      "duration_seconds": 6.17,
      "text": "Thin bones for about ten years. Yes high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.8,
      "end_seconds": 176.63,
      "duration_seconds": 0.83,
      "text": "anything else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.1,
      "end_seconds": 184.97,
      "duration_seconds": 6.87,
      "text": "Okay I can see thin bones in your file as well. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.85,
      "end_seconds": 192.1,
      "duration_seconds": 5.25,
      "text": "okay so I take alendronate 70 milligrams once a week"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 194.14,
      "end_seconds": 201.88,
      "duration_seconds": 7.74,
      "text": "She is supposed to take it once a week, but I can't say she always does."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.67,
      "end_seconds": 206.58,
      "duration_seconds": 2.91,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.86,
      "end_seconds": 222.43,
      "duration_seconds": 2.57,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.98,
      "end_seconds": 255.62,
      "duration_seconds": 13.64,
      "text": "okay: BMI works out to 36.0 oxygen saturation is 94 percent temperature is 37.6 degrees BP is 120 over 74 height 151 centimetres weight 82 kilos respiratory rate 22 pulse 90."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.46,
      "end_seconds": 258.04,
      "duration_seconds": 1.58,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.08,
      "end_seconds": 265.41,
      "duration_seconds": 2.33,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.43,
      "end_seconds": 270.47,
      "duration_seconds": 4.04,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.4,
      "end_seconds": 275.13,
      "duration_seconds": 2.73,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.93,
      "end_seconds": 290.17,
      "duration_seconds": 6.24,
      "text": "your left calf is swollen and tender and your oxygen is lower than I'd like"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.04,
      "end_seconds": 295.02,
      "duration_seconds": 1.98,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.16,
      "end_seconds": 316.19,
      "duration_seconds": 9.03,
      "text": "Let me tell you where I've got to. This looks most like a possible blood clot in the lung."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.24,
      "end_seconds": 322.87,
      "duration_seconds": 4.63,
      "text": "right, I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.37,
      "end_seconds": 335.59,
      "duration_seconds": 10.22,
      "text": "nothing I've seen today points to an emergency it looks like a possible blood clot in the lung, but I'd like to confirm"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.74,
      "end_seconds": 370.68,
      "duration_seconds": 26.94,
      "text": "I want a D-dimer blood test done, that's for possible clot. I want a CT scan of the chest done, that's for breathlessness. You need to go to hospital now for a scan. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I think the medical team should see you too. Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.38,
      "end_seconds": 375.41,
      "duration_seconds": 4.03,
      "text": "so I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.22,
      "end_seconds": 377.6,
      "duration_seconds": 1.38,
      "text": "take care now"
    }
  ]
}