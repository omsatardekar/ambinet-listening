{
  "schema_version": "1.0",
  "encounter_id": "01207",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 7.3,
      "duration_seconds": 6.69,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.0,
      "end_seconds": 12.92,
      "duration_seconds": 4.92,
      "text": "Alright, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.07,
      "end_seconds": 18.69,
      "duration_seconds": 4.62,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.75,
      "end_seconds": 24.54,
      "duration_seconds": 4.79,
      "text": "Alright, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.41,
      "end_seconds": 30.0,
      "duration_seconds": 3.59,
      "text": "He's been having a long seizure, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.2,
      "end_seconds": 34.37,
      "duration_seconds": 3.17,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.65,
      "end_seconds": 39.39,
      "duration_seconds": 3.74,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.62,
      "end_seconds": 45.63,
      "duration_seconds": 5.01,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.83,
      "end_seconds": 49.17,
      "duration_seconds": 2.34,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.85,
      "end_seconds": 53.36,
      "duration_seconds": 3.51,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.46,
      "end_seconds": 57.11,
      "duration_seconds": 1.65,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.11,
      "end_seconds": 63.14,
      "duration_seconds": 5.03,
      "text": "What about being drowsy and confused afterwards, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.74,
      "end_seconds": 75.89,
      "duration_seconds": 11.15,
      "text": "Yes, for about four days. I've also been biting my tongue. With biting my tongue, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.53,
      "end_seconds": 78.42,
      "duration_seconds": 1.89,
      "text": "How about head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.22,
      "end_seconds": 82.52,
      "duration_seconds": 2.3,
      "text": "Nope, no head injury."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.88,
      "end_seconds": 84.66,
      "duration_seconds": 1.78,
      "text": "Ah. How about fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.67,
      "end_seconds": 89.04,
      "duration_seconds": 2.37,
      "text": "No, none, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 91.05,
      "end_seconds": 95.6,
      "duration_seconds": 4.55,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.16,
      "end_seconds": 102.59,
      "duration_seconds": 6.43,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.26,
      "end_seconds": 110.9,
      "duration_seconds": 7.64,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.49,
      "end_seconds": 114.51,
      "duration_seconds": 1.02,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.1,
      "end_seconds": 119.7,
      "duration_seconds": 3.6,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.51,
      "end_seconds": 125.41,
      "duration_seconds": 4.9,
      "text": "It's, It's carbamazepine, 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 126.87,
      "end_seconds": 134.03,
      "duration_seconds": 7.16,
      "text": "Erm, that's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.69,
      "end_seconds": 139.66,
      "duration_seconds": 3.97,
      "text": "It's sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.74,
      "end_seconds": 145.77,
      "duration_seconds": 4.03,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.9,
      "end_seconds": 150.45,
      "duration_seconds": 3.55,
      "text": "I have epilepsy, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.41,
      "end_seconds": 152.11,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.74,
      "end_seconds": 156.55,
      "duration_seconds": 3.81,
      "text": "I've had depression for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.26,
      "end_seconds": 162.14,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.41,
      "end_seconds": 175.14,
      "duration_seconds": 11.73,
      "text": "Yes, grass pollen. I get itchy eyes. Yes, trimethoprim. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 185.35,
      "duration_seconds": 1.81,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.93,
      "end_seconds": 192.09,
      "duration_seconds": 3.16,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.35,
      "end_seconds": 201.0,
      "duration_seconds": 2.65,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.95,
      "end_seconds": 207.31,
      "duration_seconds": 4.36,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.09,
      "end_seconds": 219.96,
      "duration_seconds": 2.87,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.48,
      "end_seconds": 223.97,
      "duration_seconds": 3.49,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 224.76,
      "end_seconds": 235.47,
      "duration_seconds": 10.71,
      "text": "Doctor, I've got the readings for you. Pressure 116 over 84, saturation 98 percent. Respiratory rate 18, heart rate 120, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.29,
      "end_seconds": 237.99,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.93,
      "end_seconds": 244.67,
      "duration_seconds": 3.74,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.05,
      "end_seconds": 247.6,
      "duration_seconds": 1.55,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.99,
      "end_seconds": 262.12,
      "duration_seconds": 5.13,
      "text": "You are drowsy and confused, and there is blood on your tongue."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.57,
      "end_seconds": 267.46,
      "duration_seconds": 1.89,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.01,
      "end_seconds": 303.35,
      "duration_seconds": 21.34,
      "text": "Let me tell you where I've got to. This looks most like a prolonged seizure in a person with epilepsy. I can't rule out a missed dose of medicine yet. So, to recap quickly. You've had a long seizure for two weeks, severe, and no head injury."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.63,
      "end_seconds": 305.33,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.18,
      "end_seconds": 311.9,
      "duration_seconds": 4.72,
      "text": "I'll request blood tests including drug levels, it'll help with seizure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 314.83,
      "end_seconds": 321.51,
      "duration_seconds": 6.68,
      "text": "Doctor, I did a blood sugar before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.26,
      "end_seconds": 344.18,
      "duration_seconds": 20.92,
      "text": "Right, thank you. The treatment will be lorazepam, 4 milligrams, once now, single dose. That should help with prolonged seizure. Lie on your side while we monitor you. I'm going to send a referral to the emergency team. I'd like to see you again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.14,
      "end_seconds": 348.57,
      "duration_seconds": 3.43,
      "text": "Great, thank you for your help."
    }
  ]
}