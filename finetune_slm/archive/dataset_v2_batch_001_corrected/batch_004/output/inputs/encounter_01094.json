{
  "schema_version": "1.0",
  "encounter_id": "01094",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 8.16,
      "duration_seconds": 6.93,
      "text": "Alright, good morning. I've just opened your notes. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.65,
      "end_seconds": 16.31,
      "duration_seconds": 6.66,
      "text": "Well, I've been having the room spinning when I turn over in bed."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.0,
      "end_seconds": 21.53,
      "duration_seconds": 3.53,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.5,
      "end_seconds": 25.13,
      "duration_seconds": 2.63,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.43,
      "end_seconds": 28.38,
      "duration_seconds": 2.95,
      "text": "Mm, okay. Does anything help it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.34,
      "end_seconds": 33.83,
      "duration_seconds": 3.49,
      "text": "I get some relief from lying still."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.34,
      "end_seconds": 39.52,
      "duration_seconds": 5.18,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.8,
      "end_seconds": 44.09,
      "duration_seconds": 3.29,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.65,
      "end_seconds": 48.42,
      "duration_seconds": 2.77,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.22,
      "end_seconds": 59.96,
      "duration_seconds": 10.74,
      "text": "Maybe a eight out of ten on a bad day. And I've been feeling sick as well, for ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.42,
      "end_seconds": 64.41,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.16,
      "end_seconds": 67.16,
      "duration_seconds": 1.0,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.31,
      "end_seconds": 85.57,
      "duration_seconds": 2.26,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.57,
      "end_seconds": 98.68,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.99,
      "end_seconds": 125.32,
      "duration_seconds": 9.33,
      "text": "Okay: pulse is 68 beats a minute, BP is 122 over 70, saturation 97 percent, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.11,
      "end_seconds": 128.6,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.69,
      "end_seconds": 134.13,
      "duration_seconds": 2.44,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.55,
      "end_seconds": 138.24,
      "duration_seconds": 2.69,
      "text": "Right, shall I start the examination?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.13,
      "end_seconds": 140.56,
      "duration_seconds": 1.43,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.51,
      "end_seconds": 142.77,
      "duration_seconds": 1.26,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.15,
      "end_seconds": 159.56,
      "duration_seconds": 7.41,
      "text": "When I tip you back, the eyes flick for about twenty seconds, and the hearing is normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.83,
      "end_seconds": 172.1,
      "duration_seconds": 7.27,
      "text": "All finished, thank you. A few quick ones: ringing in the ear or hearing loss?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.97,
      "end_seconds": 176.19,
      "duration_seconds": 2.22,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.98,
      "end_seconds": 180.94,
      "duration_seconds": 2.96,
      "text": "And what about double vision or weakness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.81,
      "end_seconds": 187.09,
      "duration_seconds": 5.28,
      "text": "Let me think, no, no double vision or weakness."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.12,
      "end_seconds": 191.78,
      "duration_seconds": 3.66,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.38,
      "end_seconds": 193.35,
      "duration_seconds": 0.97,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.19,
      "end_seconds": 197.89,
      "duration_seconds": 3.7,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.24,
      "end_seconds": 212.49,
      "duration_seconds": 13.25,
      "text": "It's escitalopram, 10 milligrams, once a day. I'm on glibenclamide, 5 milligrams, before breakfast. Yeah, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.46,
      "end_seconds": 217.29,
      "duration_seconds": 2.83,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.96,
      "end_seconds": 222.73,
      "duration_seconds": 4.77,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 241.33,
      "duration_seconds": 2.03,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.05,
      "end_seconds": 248.47,
      "duration_seconds": 5.42,
      "text": "Yes, anxiety. I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 255.67,
      "duration_seconds": 6.45,
      "text": "Alright, anxiety and diabetes, that matches what I have here. How are your meals?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.72,
      "end_seconds": 260.46,
      "duration_seconds": 3.74,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 262.5,
      "duration_seconds": 1.33,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.17,
      "end_seconds": 266.62,
      "duration_seconds": 3.45,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.58,
      "end_seconds": 282.18,
      "duration_seconds": 7.6,
      "text": "Do you react to any medicines or foods? Any allergies? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.95,
      "end_seconds": 286.08,
      "duration_seconds": 2.13,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.76,
      "end_seconds": 292.39,
      "duration_seconds": 4.63,
      "text": "Okay, thinking it through, this looks most like benign positional vertigo."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.33,
      "end_seconds": 298.09,
      "duration_seconds": 2.76,
      "text": "Oh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.02,
      "end_seconds": 322.02,
      "duration_seconds": 21.0,
      "text": "Nothing I've seen today points to an emergency. It looks like benign positional vertigo. I'll do a repositioning manoeuvre now and show you exercises for home. Please don't wait if the symptoms get worse. That's when to be seen urgently. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.1,
      "end_seconds": 327.3,
      "duration_seconds": 3.2,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.42,
      "end_seconds": 329.8,
      "duration_seconds": 1.38,
      "text": "Look after yourself."
    }
  ]
}