{
  "schema_version": "1.0",
  "encounter_id": "01002",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.13,
      "end_seconds": 5.32,
      "duration_seconds": 4.19,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.47,
      "end_seconds": 10.4,
      "duration_seconds": 3.93,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.29,
      "end_seconds": 21.17,
      "duration_seconds": 8.88,
      "text": "Sorry, what was I saying, I've been feeling faint, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.55,
      "end_seconds": 26.47,
      "duration_seconds": 3.92,
      "text": "Right, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.51,
      "end_seconds": 37.88,
      "duration_seconds": 10.37,
      "text": "Hmm, for about three months, I'd say. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 43.58,
      "duration_seconds": 5.11,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.24,
      "end_seconds": 61.44,
      "duration_seconds": 16.2,
      "text": "Uh, I notice it more with standing. Lying down helps a bit. It feels moderate to me. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.61,
      "end_seconds": 65.45,
      "duration_seconds": 2.84,
      "text": "Any black tarry stools as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.31,
      "end_seconds": 69.56,
      "duration_seconds": 3.25,
      "text": "Yes, you know, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.57,
      "end_seconds": 73.4,
      "duration_seconds": 2.83,
      "text": "Has there been vomiting blood too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.27,
      "end_seconds": 78.47,
      "duration_seconds": 3.2,
      "text": "Yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.96,
      "end_seconds": 83.08,
      "duration_seconds": 3.12,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.2,
      "end_seconds": 85.94,
      "duration_seconds": 1.74,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.34,
      "end_seconds": 102.78,
      "duration_seconds": 2.44,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.71,
      "end_seconds": 108.34,
      "duration_seconds": 3.63,
      "text": "Um, no, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 111.95,
      "duration_seconds": 2.19,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.63,
      "end_seconds": 116.07,
      "duration_seconds": 2.44,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.38,
      "end_seconds": 121.6,
      "duration_seconds": 4.22,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.93,
      "end_seconds": 127.09,
      "duration_seconds": 4.16,
      "text": "Yeah, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 132.24,
      "duration_seconds": 3.98,
      "text": "Okay, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.63,
      "end_seconds": 137.82,
      "duration_seconds": 4.19,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.86,
      "end_seconds": 157.82,
      "duration_seconds": 3.96,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.55,
      "end_seconds": 178.52,
      "duration_seconds": 18.97,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. I grab fast food at lunch most days. I swim twice a week. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.88,
      "end_seconds": 183.04,
      "duration_seconds": 3.16,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.73,
      "end_seconds": 188.28,
      "duration_seconds": 4.55,
      "text": "It's clopidogrel, once a day for the stent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.14,
      "end_seconds": 191.13,
      "duration_seconds": 1.99,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.18,
      "end_seconds": 194.3,
      "duration_seconds": 1.12,
      "text": "75 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 199.1,
      "duration_seconds": 4.48,
      "text": "Mm-hmm. Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.96,
      "end_seconds": 203.01,
      "duration_seconds": 2.05,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.29,
      "end_seconds": 210.56,
      "duration_seconds": 6.27,
      "text": "Right, so heart disease is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 223.46,
      "end_seconds": 232.32,
      "duration_seconds": 8.86,
      "text": "Here are the numbers, doctor. Temperature 37.1, saturation 98 percent, respiratory rate 16, blood pressure 124 over 72, heart rate 105."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.86,
      "end_seconds": 235.36,
      "duration_seconds": 1.5,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.1,
      "end_seconds": 239.13,
      "duration_seconds": 2.03,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.94,
      "end_seconds": 243.89,
      "duration_seconds": 2.95,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.26,
      "end_seconds": 246.55,
      "duration_seconds": 1.29,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.92,
      "end_seconds": 263.41,
      "duration_seconds": 6.49,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.56,
      "end_seconds": 280.43,
      "duration_seconds": 14.87,
      "text": "Good, you can sit up again. From what you've told me and what I found, I don't have a clear answer today: a possible bleeding stomach ulcer is possible, and so is a bleed from the gullet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.0,
      "end_seconds": 286.76,
      "duration_seconds": 4.76,
      "text": "Let me think, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.52,
      "end_seconds": 325.47,
      "duration_seconds": 37.95,
      "text": "I understand the worry. At the moment I'd say it's a possible bleeding stomach ulcer, and we'll know more once the urgent blood tests is back. I'll request urgent blood tests, it'll help with bleeding. I'd rather check than guess, and this is the quickest way to know more. I'm going to order an endoscopy, for bleeding. Please stop the ibuprofen and do not eat or drink. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.76,
      "end_seconds": 332.11,
      "duration_seconds": 2.35,
      "text": "Alright, thanks, take care."
    }
  ]
}