{
  "schema_version": "1.0",
  "encounter_id": "01144",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 3.28,
      "duration_seconds": 2.67,
      "text": "Okay, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.04,
      "end_seconds": 6.05,
      "duration_seconds": 1.01,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.37,
      "end_seconds": 10.07,
      "duration_seconds": 2.7,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.67,
      "end_seconds": 17.63,
      "duration_seconds": 5.96,
      "text": "Good, that'll be useful. Pull up a chair. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.68,
      "end_seconds": 26.03,
      "duration_seconds": 6.35,
      "text": "Honestly, it's hard stools, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.12,
      "end_seconds": 30.85,
      "duration_seconds": 2.73,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.49,
      "end_seconds": 38.48,
      "duration_seconds": 2.99,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.59,
      "end_seconds": 47.59,
      "duration_seconds": 8.0,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.46,
      "end_seconds": 55.77,
      "duration_seconds": 6.31,
      "text": "Only water, and it's not much. It feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.8,
      "end_seconds": 61.22,
      "duration_seconds": 3.42,
      "text": "Alright, have you been going less often?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.96,
      "end_seconds": 64.87,
      "duration_seconds": 2.91,
      "text": "Yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.44,
      "end_seconds": 69.36,
      "duration_seconds": 2.92,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.21,
      "end_seconds": 78.36,
      "duration_seconds": 8.15,
      "text": "I had a triple bypass eight years ago. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.88,
      "end_seconds": 83.49,
      "duration_seconds": 4.61,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.47,
      "end_seconds": 96.01,
      "duration_seconds": 10.54,
      "text": "I take spironolactone, 25 milligrams, once a day for my heart. It's clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.21,
      "end_seconds": 110.08,
      "duration_seconds": 3.87,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.84,
      "end_seconds": 112.84,
      "duration_seconds": 2.0,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.22,
      "end_seconds": 128.0,
      "duration_seconds": 1.78,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.66,
      "end_seconds": 131.32,
      "duration_seconds": 1.66,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.12,
      "end_seconds": 134.84,
      "duration_seconds": 1.72,
      "text": "So, and your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 139.72,
      "duration_seconds": 3.73,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.35,
      "end_seconds": 142.83,
      "duration_seconds": 1.48,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.03,
      "end_seconds": 146.83,
      "duration_seconds": 2.8,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.84,
      "end_seconds": 152.41,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.67,
      "end_seconds": 156.31,
      "duration_seconds": 2.64,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.8,
      "end_seconds": 161.9,
      "duration_seconds": 4.1,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.86,
      "end_seconds": 166.12,
      "duration_seconds": 2.26,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.77,
      "end_seconds": 174.71,
      "duration_seconds": 6.94,
      "text": "Tell me about any past illnesses or ongoing conditions. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.5,
      "end_seconds": 185.69,
      "duration_seconds": 9.19,
      "text": "I have heart failure. I've had heart disease, yes. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.74,
      "end_seconds": 188.93,
      "duration_seconds": 2.19,
      "text": "So, is there anything more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.51,
      "end_seconds": 197.68,
      "duration_seconds": 8.17,
      "text": "Let me check a few things. Any weight loss, blood in the stool, vomiting or severe pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.86,
      "end_seconds": 201.77,
      "duration_seconds": 2.91,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.6,
      "end_seconds": 206.45,
      "duration_seconds": 3.85,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.13,
      "end_seconds": 212.27,
      "duration_seconds": 5.14,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.24,
      "end_seconds": 216.64,
      "duration_seconds": 2.4,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.23,
      "end_seconds": 225.99,
      "duration_seconds": 2.76,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.52,
      "end_seconds": 247.93,
      "duration_seconds": 9.41,
      "text": "Okay: temperature is 37.0 degrees, pulse is 73 beats a minute, SpO2 98 percent on room air, pressure 114 over 76."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.57,
      "end_seconds": 255.07,
      "duration_seconds": 4.5,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.66,
      "end_seconds": 258.22,
      "duration_seconds": 1.56,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.17,
      "end_seconds": 262.5,
      "duration_seconds": 2.33,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.24,
      "end_seconds": 273.54,
      "duration_seconds": 3.3,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.16,
      "end_seconds": 280.27,
      "duration_seconds": 2.11,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.02,
      "end_seconds": 308.16,
      "duration_seconds": 13.14,
      "text": "Okay, so my impression is this: This looks most like simple constipation from low fibre. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.1,
      "end_seconds": 311.78,
      "duration_seconds": 1.68,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.49,
      "end_seconds": 331.73,
      "duration_seconds": 19.24,
      "text": "Nothing I've seen today points to an emergency. It looks like simple constipation from low fibre. I'm prescribing lactulose, 15 ml, twice a day, two weeks. You take it by mouth. It's for constipation. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.49,
      "end_seconds": 335.52,
      "duration_seconds": 2.03,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.38,
      "end_seconds": 337.61,
      "duration_seconds": 1.23,
      "text": "See you soon."
    }
  ]
}