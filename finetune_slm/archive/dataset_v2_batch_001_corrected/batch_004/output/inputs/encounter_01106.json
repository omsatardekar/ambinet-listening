{
  "schema_version": "1.0",
  "encounter_id": "01106",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 4.52,
      "duration_seconds": 3.62,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.39,
      "end_seconds": 10.78,
      "duration_seconds": 4.39,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.26,
      "end_seconds": 18.23,
      "duration_seconds": 5.97,
      "text": "So the thing is, I've got high fevers every other day."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.83,
      "end_seconds": 23.01,
      "duration_seconds": 3.18,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.25,
      "end_seconds": 27.64,
      "duration_seconds": 3.39,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.88,
      "end_seconds": 31.25,
      "duration_seconds": 2.37,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.84,
      "end_seconds": 40.16,
      "duration_seconds": 3.32,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.53,
      "end_seconds": 44.0,
      "duration_seconds": 3.47,
      "text": "Yes, carry on. Have you been feeling confused?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.05,
      "end_seconds": 48.96,
      "duration_seconds": 2.91,
      "text": "Yes, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.95,
      "end_seconds": 67.94,
      "duration_seconds": 2.99,
      "text": "Any rash, cough or diarrhoea at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.61,
      "end_seconds": 73.31,
      "duration_seconds": 3.7,
      "text": "Oh, no, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.04,
      "end_seconds": 78.0,
      "duration_seconds": 2.96,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.81,
      "end_seconds": 81.66,
      "duration_seconds": 1.85,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.67,
      "end_seconds": 94.52,
      "duration_seconds": 3.85,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.49,
      "end_seconds": 98.41,
      "duration_seconds": 2.92,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.46,
      "end_seconds": 108.88,
      "duration_seconds": 2.42,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.03,
      "end_seconds": 117.26,
      "duration_seconds": 7.23,
      "text": "Well, yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.95,
      "end_seconds": 121.58,
      "duration_seconds": 2.63,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.99,
      "end_seconds": 124.01,
      "duration_seconds": 1.02,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.34,
      "end_seconds": 128.0,
      "duration_seconds": 2.66,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.64,
      "end_seconds": 131.74,
      "duration_seconds": 2.1,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.19,
      "end_seconds": 134.5,
      "duration_seconds": 1.31,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.12,
      "end_seconds": 139.85,
      "duration_seconds": 3.73,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.85,
      "end_seconds": 145.25,
      "duration_seconds": 1.4,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.64,
      "end_seconds": 151.57,
      "duration_seconds": 4.93,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.56,
      "end_seconds": 154.45,
      "duration_seconds": 1.89,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.55,
      "end_seconds": 159.57,
      "duration_seconds": 4.02,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.77,
      "end_seconds": 162.57,
      "duration_seconds": 1.8,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.87,
      "end_seconds": 167.56,
      "duration_seconds": 3.69,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.38,
      "end_seconds": 171.72,
      "duration_seconds": 2.34,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.78,
      "end_seconds": 179.35,
      "duration_seconds": 4.57,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.04,
      "end_seconds": 182.47,
      "duration_seconds": 2.43,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.18,
      "end_seconds": 195.64,
      "duration_seconds": 2.46,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.27,
      "end_seconds": 228.7,
      "duration_seconds": 11.43,
      "text": "Okay: BMI works out to 36.9, blood pressure 112 over 68, weight 83 kilos, saturation 95 percent, height 150 centimetres, pulse is 94 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.14,
      "end_seconds": 233.96,
      "duration_seconds": 2.82,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.16,
      "end_seconds": 243.86,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.84,
      "end_seconds": 246.16,
      "duration_seconds": 1.32,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.37,
      "end_seconds": 266.44,
      "duration_seconds": 4.07,
      "text": "You are hot and jaundiced, and your spleen is tender."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.48,
      "end_seconds": 269.18,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.35,
      "end_seconds": 287.27,
      "duration_seconds": 14.92,
      "text": "So, good, you can sit up again. Let me tell you where I've got to. I'd lean towards possible malaria after travel. Blood tests is what I'd like next, for fever after travel."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.03,
      "end_seconds": 290.65,
      "duration_seconds": 2.62,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.36,
      "end_seconds": 301.03,
      "duration_seconds": 9.67,
      "text": "You need hospital assessment today, this can become serious fast. I think the infectious diseases team should see you too."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.66,
      "end_seconds": 304.22,
      "duration_seconds": 1.56,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.23,
      "end_seconds": 307.67,
      "duration_seconds": 2.44,
      "text": "Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.71,
      "end_seconds": 311.86,
      "duration_seconds": 2.15,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.68,
      "end_seconds": 316.29,
      "duration_seconds": 2.61,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.97,
      "end_seconds": 321.07,
      "duration_seconds": 4.1,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.89,
      "end_seconds": 324.72,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}