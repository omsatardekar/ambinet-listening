  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.37,
      "duration_seconds": 3.71,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 11.95,
      "duration_seconds": 6.08,
      "text": "Right, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.55,
      "end_seconds": 23.59,
      "duration_seconds": 6.04,
      "text": "Doctor, thank you for seeing us. She's been having pelvic pain, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.43,
      "end_seconds": 27.5,
      "duration_seconds": 2.07,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.19,
      "end_seconds": 32.21,
      "duration_seconds": 3.02,
      "text": "I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.54,
      "end_seconds": 37.78,
      "duration_seconds": 4.24,
      "text": "hm, I'd say more like about two months"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.62,
      "end_seconds": 44.35,
      "duration_seconds": 4.73,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.72,
      "end_seconds": 51.96,
      "duration_seconds": 2.24,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.4,
      "end_seconds": 58.24,
      "duration_seconds": 4.84,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 65.09,
      "duration_seconds": 5.78,
      "text": "About a seven out of ten. Moving definitely sets it off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.49,
      "end_seconds": 70.49,
      "duration_seconds": 4.0,
      "text": "Right, has there been a high fever too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.04,
      "end_seconds": 78.25,
      "duration_seconds": 7.21,
      "text": "Yeah, that too. As for high fever, it happens a couple of times a week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.73,
      "end_seconds": 83.74,
      "duration_seconds": 4.01,
      "text": "What about a smelly discharge, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.58,
      "end_seconds": 89.11,
      "duration_seconds": 3.53,
      "text": "yes, about the the same, two days"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.76,
      "end_seconds": 93.96,
      "duration_seconds": 4.2,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.35,
      "end_seconds": 104.74,
      "duration_seconds": 9.39,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.37,
      "end_seconds": 109.03,
      "duration_seconds": 2.66,
      "text": "Okay, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.18,
      "end_seconds": 114.06,
      "duration_seconds": 3.88,
      "text": "just my tonsils removed, as a teenager"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.83,
      "end_seconds": 117.42,
      "duration_seconds": 2.59,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.48,
      "end_seconds": 136.21,
      "duration_seconds": 17.73,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. Lots of rice, lentils and some fruit. My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.7,
      "end_seconds": 140.42,
      "duration_seconds": 2.72,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.13,
      "end_seconds": 147.09,
      "duration_seconds": 5.96,
      "text": "my mother has an underactive thyroid my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 150.7,
      "duration_seconds": 2.36,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.79,
      "end_seconds": 152.97,
      "duration_seconds": 1.18,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.17,
      "end_seconds": 155.87,
      "duration_seconds": 1.7,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.77,
      "end_seconds": 161.29,
      "duration_seconds": 3.52,
      "text": "I have anxiety, for five years"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 171.04,
      "duration_seconds": 7.65,
      "text": "Yes, asthma and anxiety are known to us, good to have that clear. Any regular medication at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.45,
      "end_seconds": 177.7,
      "duration_seconds": 3.25,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.3,
      "end_seconds": 181.47,
      "duration_seconds": 2.17,
      "text": "Any vomiting or recent pregnancy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.05,
      "end_seconds": 185.95,
      "duration_seconds": 2.9,
      "text": "No, no vomiting or recent pregnancy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.9,
      "end_seconds": 191.18,
      "duration_seconds": 3.28,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.81,
      "end_seconds": 193.5,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 204.87,
      "end_seconds": 214.66,
      "duration_seconds": 9.79,
      "text": "Okay, so so the vitals from earlier. Temperature is 38.9 degrees, pulse 91, pressure 125 over 80, saturation 97 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.25,
      "end_seconds": 216.79,
      "duration_seconds": 1.54,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.41,
      "end_seconds": 220.55,
      "duration_seconds": 2.14,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.35,
      "end_seconds": 240.09,
      "duration_seconds": 1.74,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.75,
      "end_seconds": 243.05,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.52,
      "end_seconds": 265.86,
      "duration_seconds": 7.34,
      "text": "you are very tender low in the tummy, and it hurts when I move the cervix"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.28,
      "end_seconds": 285.52,
      "duration_seconds": 16.24,
      "text": "good, you can sit up again let's book blood tests to look into fever that will help us see what's going on underneath and decide the next step let's book swabs to look into pelvic infection"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.29,
      "end_seconds": 289.96,
      "duration_seconds": 2.67,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.78,
      "end_seconds": 301.77,
      "duration_seconds": 6.99,
      "text": "I'll start you on ceftriaxone, 1 gram, once now, single dose it's for pelvic infection"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.57,
      "end_seconds": 305.09,
      "duration_seconds": 1.52,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.45,
      "end_seconds": 315.57,
      "duration_seconds": 6.12,
      "text": "you need hospital treatment today i think the gynaecology team should see you too"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.42,
      "end_seconds": 319.92,
      "duration_seconds": 2.5,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.88,
      "end_seconds": 329.16,
      "duration_seconds": 7.28,
      "text": "I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.15,
      "end_seconds": 333.65,
      "duration_seconds": 3.5,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
