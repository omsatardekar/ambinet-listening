{
  "schema_version": "1.0",
  "encounter_id": "01203",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.74,
      "duration_seconds": 3.94,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.04,
      "end_seconds": 10.66,
      "duration_seconds": 4.62,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.18,
      "end_seconds": 20.58,
      "duration_seconds": 6.4,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.13,
      "end_seconds": 24.73,
      "duration_seconds": 2.6,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 31.62,
      "duration_seconds": 5.25,
      "text": "So the thing is, I've got a red sticky eye."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.14,
      "end_seconds": 35.55,
      "duration_seconds": 3.41,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.04,
      "end_seconds": 39.92,
      "duration_seconds": 2.88,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.99,
      "end_seconds": 43.94,
      "duration_seconds": 2.95,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.35,
      "end_seconds": 69.27,
      "duration_seconds": 23.92,
      "text": "Sorry, what was I saying, about a three out of ten. There's crusting in the morning as well. As for crusting in the morning, I'd give it a eight, out of ten. Oh, and a gritty feeling. That's been about the same, three weeks. About gritty feeling, severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.99,
      "end_seconds": 76.07,
      "duration_seconds": 5.08,
      "text": "So, have you noticed pain in the eye or contact lens?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.78,
      "end_seconds": 83.9,
      "duration_seconds": 6.12,
      "text": "I haven't had pain in the eye or contact lens, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.81,
      "end_seconds": 92.72,
      "duration_seconds": 4.91,
      "text": "Right, have you noticed sensitivity to light or blurred vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.69,
      "end_seconds": 98.87,
      "duration_seconds": 4.18,
      "text": "No, no sensitivity to light or blurred vision."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.68,
      "end_seconds": 102.62,
      "duration_seconds": 2.94,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.58,
      "end_seconds": 105.89,
      "duration_seconds": 2.31,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.3,
      "end_seconds": 111.38,
      "duration_seconds": 4.08,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.24,
      "end_seconds": 123.15,
      "duration_seconds": 6.91,
      "text": "I'm on furosemide, 40 milligrams, every morning. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.88,
      "end_seconds": 127.7,
      "duration_seconds": 2.82,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.32,
      "end_seconds": 141.88,
      "duration_seconds": 12.56,
      "text": "Lots of rice, lentils and some fruit. No, I share a house with my brother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.25,
      "end_seconds": 160.02,
      "duration_seconds": 2.77,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.96,
      "end_seconds": 163.96,
      "duration_seconds": 3.0,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.66,
      "end_seconds": 169.23,
      "duration_seconds": 4.57,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.17,
      "end_seconds": 173.91,
      "duration_seconds": 2.74,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.96,
      "end_seconds": 178.53,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.53,
      "end_seconds": 181.99,
      "duration_seconds": 1.46,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.83,
      "end_seconds": 187.36,
      "duration_seconds": 3.53,
      "text": "Right, right. Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.43,
      "end_seconds": 202.66,
      "duration_seconds": 2.23,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.34,
      "end_seconds": 224.17,
      "duration_seconds": 8.83,
      "text": "Okay: pulse 68, respiratory rate 15, SpO2 97 percent on room air, BP is 125 over 68, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 231.62,
      "duration_seconds": 4.46,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.3,
      "end_seconds": 233.41,
      "duration_seconds": 1.11,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.82,
      "end_seconds": 237.87,
      "duration_seconds": 3.05,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.96,
      "end_seconds": 258.02,
      "duration_seconds": 7.06,
      "text": "The white of the eye is pink with some sticky discharge, and your pupil is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.51,
      "end_seconds": 265.57,
      "duration_seconds": 2.06,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.0,
      "end_seconds": 286.1,
      "duration_seconds": 10.1,
      "text": "Putting it all together, it points towards infective conjunctivitis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.53,
      "end_seconds": 309.51,
      "duration_seconds": 8.98,
      "text": "I don't need to add any tests or treatment at this point. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.69,
      "end_seconds": 313.76,
      "duration_seconds": 3.07,
      "text": "Great, thank you for your help."
    }
  ]
}