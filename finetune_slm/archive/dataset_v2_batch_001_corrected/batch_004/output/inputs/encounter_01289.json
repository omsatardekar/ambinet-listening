{
  "schema_version": "1.0",
  "encounter_id": "01289",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 5.85,
      "duration_seconds": 4.65,
      "text": "Afternoon, thanks for coming in. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.06,
      "end_seconds": 17.82,
      "duration_seconds": 10.76,
      "text": "Honestly, it's my throat closing up, and my family pushed me to come. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.98,
      "end_seconds": 24.09,
      "duration_seconds": 2.11,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.01,
      "end_seconds": 35.08,
      "duration_seconds": 9.07,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.04,
      "end_seconds": 39.98,
      "duration_seconds": 2.94,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.72,
      "end_seconds": 44.34,
      "duration_seconds": 3.62,
      "text": "I'd say mild. I've been feeling faint too."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.33,
      "end_seconds": 57.28,
      "duration_seconds": 4.95,
      "text": "Let me check a few things. Any recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.81,
      "end_seconds": 65.38,
      "duration_seconds": 4.57,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.27,
      "end_seconds": 71.62,
      "duration_seconds": 4.35,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.2,
      "end_seconds": 75.08,
      "duration_seconds": 2.88,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.51,
      "end_seconds": 89.83,
      "duration_seconds": 3.32,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.0,
      "end_seconds": 102.87,
      "duration_seconds": 11.87,
      "text": "It's Asthalin inhaler, when needed for my asthma. Apixaban, 5 milligrams, twice a day. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.1,
      "end_seconds": 108.11,
      "duration_seconds": 4.01,
      "text": "Okay, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.37,
      "end_seconds": 116.03,
      "duration_seconds": 6.66,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.12,
      "end_seconds": 120.16,
      "duration_seconds": 3.04,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.8,
      "end_seconds": 130.06,
      "duration_seconds": 8.26,
      "text": "I have asthma, for nearly five years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.59,
      "end_seconds": 133.15,
      "duration_seconds": 2.56,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.85,
      "end_seconds": 136.91,
      "duration_seconds": 3.06,
      "text": "I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.73,
      "end_seconds": 141.78,
      "duration_seconds": 4.05,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.95,
      "end_seconds": 147.27,
      "duration_seconds": 4.32,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.27,
      "end_seconds": 152.03,
      "duration_seconds": 2.76,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.22,
      "end_seconds": 161.87,
      "duration_seconds": 4.65,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.47,
      "end_seconds": 166.41,
      "duration_seconds": 2.94,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.99,
      "end_seconds": 170.91,
      "duration_seconds": 3.92,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.95,
      "end_seconds": 173.77,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.84,
      "end_seconds": 178.18,
      "duration_seconds": 2.34,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.0,
      "end_seconds": 192.41,
      "duration_seconds": 3.41,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.75,
      "end_seconds": 205.51,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.94,
      "end_seconds": 225.28,
      "duration_seconds": 8.34,
      "text": "Okay: blood pressure 104 over 57, temperature 37.0, SpO2 98 percent on room air, pulse 108."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.83,
      "end_seconds": 231.43,
      "duration_seconds": 2.6,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.68,
      "end_seconds": 235.53,
      "duration_seconds": 2.85,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.89,
      "end_seconds": 239.35,
      "duration_seconds": 2.46,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.92,
      "end_seconds": 242.12,
      "duration_seconds": 1.2,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.58,
      "end_seconds": 257.65,
      "duration_seconds": 7.07,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.51,
      "end_seconds": 267.78,
      "duration_seconds": 7.27,
      "text": "That's all I needed to check. Right, here's what I'm thinking. It points towards anaphylaxis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.13,
      "end_seconds": 271.92,
      "duration_seconds": 2.79,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.76,
      "end_seconds": 290.25,
      "duration_seconds": 16.49,
      "text": "It's reasonable to be concerned, but right now anaphylaxis is my leading thought, not anything worse. We should do monitoring for anaphylaxis. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 292.28,
      "end_seconds": 294.68,
      "duration_seconds": 2.4,
      "text": "The earliest is Thursday, 10 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.78,
      "end_seconds": 318.32,
      "duration_seconds": 19.54,
      "text": "I'm prescribing adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. Do get help quickly if the symptoms return. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.94,
      "end_seconds": 329.99,
      "duration_seconds": 7.05,
      "text": "So, I take the adrenaline, 0.5 milligrams, once now. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.82,
      "end_seconds": 340.64,
      "duration_seconds": 5.82,
      "text": "Yes, exactly right. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.51,
      "end_seconds": 344.84,
      "duration_seconds": 3.33,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}