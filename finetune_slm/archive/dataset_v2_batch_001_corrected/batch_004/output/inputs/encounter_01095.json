  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 6.69,
      "duration_seconds": 6.01,
      "text": "Hi there, the chair's free, sit down. Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.23,
      "end_seconds": 11.6,
      "duration_seconds": 3.37,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.38,
      "end_seconds": 18.32,
      "duration_seconds": 1.94,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.69,
      "end_seconds": 23.05,
      "duration_seconds": 3.36,
      "text": "So, I've been passing clots, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.04,
      "end_seconds": 26.79,
      "duration_seconds": 2.75,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.04,
      "end_seconds": 39.79,
      "duration_seconds": 2.75,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.39,
      "end_seconds": 67.01,
      "duration_seconds": 9.62,
      "text": "Okay: saturation 99 percent, BP is 124 over 69, heart rate 83. And respiratory rate 17, temperature 36.8."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.6,
      "end_seconds": 70.16,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.81,
      "end_seconds": 77.09,
      "duration_seconds": 6.28,
      "text": "We'll look at it together shortly. So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.4,
      "end_seconds": 80.33,
      "duration_seconds": 1.93,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.72,
      "end_seconds": 83.83,
      "duration_seconds": 2.11,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.38,
      "end_seconds": 88.41,
      "duration_seconds": 3.03,
      "text": "Yes, about the same, ten days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.36,
      "end_seconds": 95.8,
      "duration_seconds": 3.44,
      "text": "Has there been very heavy periods too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.39,
      "end_seconds": 98.53,
      "duration_seconds": 1.14,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.05,
      "end_seconds": 113.65,
      "duration_seconds": 4.6,
      "text": "Have you had any pain with sex or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.75,
      "end_seconds": 119.78,
      "duration_seconds": 4.03,
      "text": "No, no pain with sex or weight loss."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.78,
      "end_seconds": 126.3,
      "duration_seconds": 4.52,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.35,
      "end_seconds": 131.14,
      "duration_seconds": 2.79,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.54,
      "end_seconds": 144.45,
      "duration_seconds": 4.91,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.28,
      "end_seconds": 146.74,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.42,
      "end_seconds": 152.1,
      "duration_seconds": 4.68,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.63,
      "end_seconds": 159.27,
      "duration_seconds": 6.64,
      "text": "It's Asthalin inhaler, when needed. It's tranexamic acid, 500 milligrams, during periods."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.07,
      "end_seconds": 162.76,
      "duration_seconds": 1.69,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.38,
      "end_seconds": 171.12,
      "duration_seconds": 4.74,
      "text": "Okay, so nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.7,
      "end_seconds": 174.05,
      "duration_seconds": 1.35,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.78,
      "end_seconds": 178.78,
      "duration_seconds": 4.0,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.64,
      "end_seconds": 184.36,
      "duration_seconds": 3.72,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.45,
      "end_seconds": 190.02,
      "duration_seconds": 3.57,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.95,
      "end_seconds": 194.41,
      "duration_seconds": 2.46,
      "text": "Okay, who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.61,
      "end_seconds": 197.85,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.6,
      "end_seconds": 201.54,
      "duration_seconds": 2.94,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.62,
      "end_seconds": 203.99,
      "duration_seconds": 1.37,
      "text": "I have asthma."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.78,
      "end_seconds": 209.95,
      "duration_seconds": 4.17,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.4,
      "end_seconds": 225.1,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.73,
      "end_seconds": 229.3,
      "duration_seconds": 2.57,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.41,
      "end_seconds": 248.71,
      "duration_seconds": 6.3,
      "text": "The uterus feels enlarged and firm, about the size of a ten-week pregnancy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.66,
      "end_seconds": 262.42,
      "duration_seconds": 8.76,
      "text": "That's all I needed to check. So where does that leave us? It fits best with heavy periods, possibly from fibroids."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.49,
      "end_seconds": 266.55,
      "duration_seconds": 2.06,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.51,
      "end_seconds": 294.44,
      "duration_seconds": 25.93,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods, possibly from fibroids, but I'd like to confirm. I'm sending you for a ferritin level because of heavy periods. Keep a record of the bleeding with the pad count. We'll refer you to the gynaecology clinic. I'd like to see you again after the scan."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.93,
      "end_seconds": 303.31,
      "duration_seconds": 3.38,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.15,
      "end_seconds": 309.14,
      "duration_seconds": 3.99,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.54,
      "end_seconds": 314.72,
      "duration_seconds": 4.18,
      "text": "Erm, great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.8,
      "end_seconds": 321.2,
      "duration_seconds": 1.4,
      "text": "Take care now."
    }
  ]
