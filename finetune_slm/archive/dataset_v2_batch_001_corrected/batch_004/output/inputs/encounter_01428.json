    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.88,
      "end_seconds": 181.35,
      "duration_seconds": 2.47,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.74,
      "end_seconds": 207.52,
      "duration_seconds": 7.78,
      "text": "Okay: pulse is 85 beats a a minute, saturation 92 percent, respiratory rate 24, pressure 120 over 73."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.02,
      "end_seconds": 213.68,
      "duration_seconds": 3.66,
      "text": "now I'm going to do a short physical check"
