{
  "schema_version": "1.0",
  "encounter_id": "01048",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 2.74,
      "duration_seconds": 1.7,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.84,
      "end_seconds": 8.28,
      "duration_seconds": 4.44,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.55,
      "end_seconds": 15.23,
      "duration_seconds": 5.68,
      "text": "Doctor, uh, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.32,
      "end_seconds": 20.98,
      "duration_seconds": 4.66,
      "text": "Mm, I've been dealing with a blocked nose."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.44,
      "end_seconds": 26.26,
      "duration_seconds": 3.82,
      "text": "Alright, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.15,
      "end_seconds": 41.96,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.43,
      "end_seconds": 62.58,
      "duration_seconds": 5.15,
      "text": "Okay: heart rate 81, BP is 122 over 79, temperature 37.0."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.38,
      "end_seconds": 65.73,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.61,
      "end_seconds": 77.69,
      "duration_seconds": 6.08,
      "text": "We'll look at it together shortly. Okay, is there something that settles it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.34,
      "end_seconds": 90.95,
      "duration_seconds": 11.61,
      "text": "Only steam, um, and it's not much. I did have pressure over my cheeks at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 97.76,
      "duration_seconds": 5.5,
      "text": "Have you had a blocked nose before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.1,
      "end_seconds": 105.88,
      "duration_seconds": 6.78,
      "text": "I, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 124.48,
      "duration_seconds": 6.59,
      "text": "Any severe headache, double vision, fever or swelling around the eye at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.04,
      "end_seconds": 129.02,
      "duration_seconds": 2.98,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.34,
      "end_seconds": 133.0,
      "duration_seconds": 3.66,
      "text": "Sure. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.17,
      "end_seconds": 136.51,
      "duration_seconds": 2.34,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.39,
      "end_seconds": 141.22,
      "duration_seconds": 3.83,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.35,
      "end_seconds": 144.53,
      "duration_seconds": 2.18,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.07,
      "end_seconds": 151.01,
      "duration_seconds": 4.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 156.72,
      "duration_seconds": 4.55,
      "text": "I have thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.2,
      "end_seconds": 158.9,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.78,
      "end_seconds": 164.37,
      "duration_seconds": 4.59,
      "text": "Heart failure, for two years. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.17,
      "end_seconds": 177.74,
      "duration_seconds": 12.57,
      "text": "Alright, heart failure, that matches what I have here. Right, are you allergic to anything? Any allergies to medicines or foods? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.28,
      "end_seconds": 180.77,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.63,
      "end_seconds": 185.67,
      "duration_seconds": 3.04,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.17,
      "end_seconds": 192.95,
      "duration_seconds": 6.78,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.41,
      "end_seconds": 197.76,
      "duration_seconds": 3.35,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.41,
      "end_seconds": 217.4,
      "duration_seconds": 15.99,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I live with my elderly mother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.08,
      "end_seconds": 234.89,
      "duration_seconds": 3.81,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.97,
      "end_seconds": 248.59,
      "duration_seconds": 11.62,
      "text": "Alendronate, 70 milligrams, once a week for my bones. It's metoprolol, 50 milligrams, twice a day. I'm on ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.74,
      "end_seconds": 254.59,
      "duration_seconds": 3.85,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.29,
      "end_seconds": 257.02,
      "duration_seconds": 1.73,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.38,
      "end_seconds": 260.73,
      "duration_seconds": 2.35,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.39,
      "end_seconds": 275.39,
      "duration_seconds": 5.0,
      "text": "There is tenderness over both cheeks and the nasal lining looks swollen."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.95,
      "end_seconds": 281.98,
      "duration_seconds": 3.03,
      "text": "Right, that's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.59,
      "end_seconds": 328.07,
      "duration_seconds": 28.48,
      "text": "Having listened and examined, the most likely explanation is chronic sinusitis. We'll begin with mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That should help with sinus inflammation. Rinse your nose with saline twice a day. Let's get you seen by the ENT clinic, I'll arrange the letter. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.67,
      "end_seconds": 332.83,
      "duration_seconds": 3.16,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.43,
      "end_seconds": 342.2,
      "duration_seconds": 7.77,
      "text": "We'll catch up in eight weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.76,
      "end_seconds": 348.89,
      "duration_seconds": 3.13,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.81,
      "end_seconds": 355.11,
      "duration_seconds": 1.3,
      "text": "Look after yourself."
    }
  ]
}