{
  "schema_version": "1.0",
  "encounter_id": "01032",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 8.15,
      "duration_seconds": 7.52,
      "text": "Yeah, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.49,
      "end_seconds": 13.42,
      "duration_seconds": 3.93,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.75,
      "end_seconds": 25.38,
      "duration_seconds": 10.63,
      "text": "Mm, I'm here because of sudden hearing loss in one ear. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.03,
      "end_seconds": 27.4,
      "duration_seconds": 1.37,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.91,
      "end_seconds": 30.44,
      "duration_seconds": 2.53,
      "text": "It's been five days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.08,
      "end_seconds": 33.78,
      "duration_seconds": 1.7,
      "text": "Any ringing as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.45,
      "end_seconds": 39.76,
      "duration_seconds": 4.31,
      "text": "Yes, since Monday. Oh, and a blocked feeling."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.86,
      "end_seconds": 45.01,
      "duration_seconds": 4.15,
      "text": "have you noticed ear pain, facial weakness or dizziness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.88,
      "end_seconds": 49.81,
      "duration_seconds": 2.93,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.31,
      "end_seconds": 57.3,
      "duration_seconds": 1.99,
      "text": "Did you notice any discharge?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.63,
      "end_seconds": 60.19,
      "duration_seconds": 1.56,
      "text": "No, no discharge."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.43,
      "end_seconds": 64.37,
      "duration_seconds": 2.94,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.12,
      "end_seconds": 67.59,
      "duration_seconds": 1.47,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 71.51,
      "duration_seconds": 2.22,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.44,
      "end_seconds": 75.74,
      "duration_seconds": 2.3,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.38,
      "end_seconds": 80.37,
      "duration_seconds": 2.99,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.34,
      "end_seconds": 84.69,
      "duration_seconds": 3.35,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.23,
      "end_seconds": 88.59,
      "duration_seconds": 3.36,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.82,
      "end_seconds": 94.2,
      "duration_seconds": 4.38,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.26,
      "end_seconds": 107.09,
      "duration_seconds": 4.83,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.19,
      "end_seconds": 112.54,
      "duration_seconds": 4.35,
      "text": "Right, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.35,
      "end_seconds": 118.04,
      "duration_seconds": 3.69,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.72,
      "end_seconds": 124.39,
      "duration_seconds": 4.67,
      "text": "Actually, uh, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.2,
      "end_seconds": 129.29,
      "duration_seconds": 4.09,
      "text": "What do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.5,
      "end_seconds": 159.39,
      "duration_seconds": 28.89,
      "text": "I'm on Seretide inhaler, twice a day. I'm on aspirin, 75 milligrams, once a day for my heart. Hydrocortisone cream. I take it when needed. Though honestly, some days I forget to take it. Let me think, um, I had metoprolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.99,
      "end_seconds": 167.11,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.59,
      "end_seconds": 172.33,
      "duration_seconds": 3.74,
      "text": "I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.89,
      "end_seconds": 173.84,
      "duration_seconds": 0.95,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.1,
      "end_seconds": 192.56,
      "duration_seconds": 17.46,
      "text": "I, I have heart disease, for nearly five years. Okay, so I've had eczema for about a year now. I've been putting this off for weeks. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.3,
      "end_seconds": 199.21,
      "duration_seconds": 4.91,
      "text": "Alright, heart disease and eczema, that matches what I have here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.94,
      "end_seconds": 213.76,
      "duration_seconds": 2.82,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.06,
      "end_seconds": 218.65,
      "duration_seconds": 3.59,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.22,
      "end_seconds": 221.67,
      "duration_seconds": 2.45,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.99,
      "end_seconds": 236.64,
      "duration_seconds": 2.65,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.83,
      "end_seconds": 258.3,
      "duration_seconds": 6.47,
      "text": "Okay: pulse is 68 beats a minute, blood pressure 114 over 75, temperature 36.5."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.17,
      "end_seconds": 261.35,
      "duration_seconds": 2.18,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.24,
      "end_seconds": 265.17,
      "duration_seconds": 2.93,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.48,
      "end_seconds": 271.3,
      "duration_seconds": 3.82,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.07,
      "end_seconds": 275.16,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.04,
      "end_seconds": 291.23,
      "duration_seconds": 7.19,
      "text": "The ear drum looks normal and the tuning fork is heard louder in the other ear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.99,
      "end_seconds": 320.54,
      "duration_seconds": 23.55,
      "text": "You can sit up now. Let me tell you where I've got to. This looks most like sudden hearing loss needing urgent treatment. The reason I say that is that your story and my examination fit together. It could also be a wax or fluid blockage, so we'll keep that open."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.67,
      "end_seconds": 324.39,
      "duration_seconds": 2.72,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.45,
      "end_seconds": 337.27,
      "duration_seconds": 11.82,
      "text": "I understand the worry. At the moment I'd say it's sudden hearing loss needing urgent treatment, and we'll know more once the an MRI scan is back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.17,
      "end_seconds": 378.3,
      "duration_seconds": 32.13,
      "text": "I'm sending you for an MRI scan because of sudden hearing loss. I'd like to arrange an urgent hearing test for sudden hearing loss. The treatment will be prednisolone, 60 milligrams, once a day, seven days. That's for sudden hearing loss. This is time-critical, so I'm starting treatment today. I'd like you to see the ENT team as well, and I'll write the referral. Please come and see me in one week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.05,
      "end_seconds": 386.8,
      "duration_seconds": 3.75,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.04,
      "end_seconds": 390.93,
      "duration_seconds": 2.89,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.22,
      "end_seconds": 395.29,
      "duration_seconds": 3.07,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.21,
      "end_seconds": 397.57,
      "duration_seconds": 1.36,
      "text": "Goodbye for now."
    }
  ]
}