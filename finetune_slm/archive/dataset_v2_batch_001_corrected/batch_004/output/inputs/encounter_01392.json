{
  "schema_version": "1.0",
  "encounter_id": "01392",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.07,
      "end_seconds": 7.9,
      "duration_seconds": 6.83,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 12.72,
      "duration_seconds": 4.28,
      "text": "Alright, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.43,
      "end_seconds": 19.91,
      "duration_seconds": 6.48,
      "text": "I've been feeling sick, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.82,
      "end_seconds": 25.18,
      "duration_seconds": 3.36,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.21,
      "end_seconds": 31.8,
      "duration_seconds": 5.59,
      "text": "I mean, um, I've had it for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.43,
      "end_seconds": 35.52,
      "duration_seconds": 3.09,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.4,
      "end_seconds": 38.14,
      "duration_seconds": 1.74,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.53,
      "end_seconds": 41.64,
      "duration_seconds": 2.11,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.76,
      "end_seconds": 61.55,
      "duration_seconds": 18.79,
      "text": "It usually comes with zigzag lights before it starts. As for zigzag lights before it starts, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.96,
      "end_seconds": 80.09,
      "duration_seconds": 4.13,
      "text": "Any head injury, weakness or stiff neck at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.43,
      "end_seconds": 88.89,
      "duration_seconds": 5.46,
      "text": "I haven't had head injury, weakness or stiff neck, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.46,
      "end_seconds": 91.72,
      "duration_seconds": 2.26,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.86,
      "end_seconds": 95.51,
      "duration_seconds": 2.65,
      "text": "No, none, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.3,
      "end_seconds": 99.61,
      "duration_seconds": 2.31,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.45,
      "end_seconds": 105.18,
      "duration_seconds": 4.73,
      "text": "Oh, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.4,
      "end_seconds": 109.35,
      "duration_seconds": 2.95,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.49,
      "end_seconds": 131.35,
      "duration_seconds": 20.86,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. No, I share a house with my brother. I'm vegetarian and have been for years. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.27,
      "end_seconds": 136.59,
      "duration_seconds": 3.32,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.28,
      "end_seconds": 140.79,
      "duration_seconds": 2.51,
      "text": "It's sumatriptan, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.67,
      "end_seconds": 145.0,
      "duration_seconds": 2.33,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.61,
      "end_seconds": 151.19,
      "duration_seconds": 5.58,
      "text": "It's 50 milligrams. Paracetamol, 1 gram, maybe, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.41,
      "end_seconds": 156.45,
      "duration_seconds": 4.04,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.5,
      "end_seconds": 159.61,
      "duration_seconds": 2.11,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.88,
      "end_seconds": 166.63,
      "duration_seconds": 3.75,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.51,
      "end_seconds": 173.6,
      "duration_seconds": 3.09,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.65,
      "end_seconds": 186.57,
      "duration_seconds": 2.92,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.47,
      "end_seconds": 201.62,
      "duration_seconds": 13.15,
      "text": "Sorry, what was I saying, I've had migraines for about ten years now. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.02,
      "end_seconds": 203.72,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.2,
      "end_seconds": 221.39,
      "duration_seconds": 16.19,
      "text": "An underactive thyroid, for nearly five years. A neighbour of mine said I should see someone about it. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.46,
      "end_seconds": 226.24,
      "duration_seconds": 2.78,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.26,
      "end_seconds": 233.49,
      "duration_seconds": 6.23,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 234.12,
      "end_seconds": 244.41,
      "duration_seconds": 10.29,
      "text": "Doctor, I've got the readings for you. Temperature is 36.8 degrees, BP is 121 over 72, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.25,
      "end_seconds": 246.95,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.26,
      "end_seconds": 252.41,
      "duration_seconds": 4.15,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.69,
      "end_seconds": 260.74,
      "duration_seconds": 1.05,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.59,
      "end_seconds": 262.99,
      "duration_seconds": 1.4,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.57,
      "end_seconds": 287.5,
      "duration_seconds": 6.93,
      "text": "Your eye movements are normal and there is no weakness in your arms or legs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.99,
      "end_seconds": 303.1,
      "duration_seconds": 10.11,
      "text": "All finished, thank you. Okay, thinking it through, it fits best with migraine with aura. Another possibility is tension-type headache."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.32,
      "end_seconds": 309.66,
      "duration_seconds": 3.34,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.3,
      "end_seconds": 344.45,
      "duration_seconds": 33.15,
      "text": "I understand the worry. At the moment I'd say it's migraine with aura, and we'll know more once the a headache diary is back. I'm sending you for a headache diary because of migraine. It's a routine test and it'll give us a much clearer picture. Keep a headache diary and avoid skipping meals. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.36,
      "end_seconds": 352.55,
      "duration_seconds": 4.19,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.34,
      "end_seconds": 355.77,
      "duration_seconds": 2.43,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.6,
      "end_seconds": 361.01,
      "duration_seconds": 4.41,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 362.78,
      "end_seconds": 365.99,
      "duration_seconds": 3.21,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}