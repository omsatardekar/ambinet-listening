{
  "schema_version": "1.0",
  "encounter_id": "01148",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 2.55,
      "duration_seconds": 1.67,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.57,
      "end_seconds": 8.99,
      "duration_seconds": 5.42,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.7,
      "end_seconds": 14.64,
      "duration_seconds": 3.94,
      "text": "I've been dealing with very heavy periods."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.33,
      "end_seconds": 16.89,
      "duration_seconds": 1.56,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.79,
      "end_seconds": 28.2,
      "duration_seconds": 9.41,
      "text": "I've had it since Monday. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.8,
      "end_seconds": 33.52,
      "duration_seconds": 3.72,
      "text": "did you get pain with sex or weight loss?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.14,
      "end_seconds": 38.1,
      "duration_seconds": 3.96,
      "text": "um, no, nothing to report there"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.11,
      "end_seconds": 43.58,
      "duration_seconds": 3.47,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.87,
      "end_seconds": 49.91,
      "duration_seconds": 1.04,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.98,
      "end_seconds": 55.01,
      "duration_seconds": 3.03,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.3,
      "end_seconds": 58.84,
      "duration_seconds": 2.54,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.46,
      "end_seconds": 68.01,
      "duration_seconds": 3.55,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.69,
      "end_seconds": 76.78,
      "duration_seconds": 8.09,
      "text": "I'm on paracetamol, 650 milligrams, when needed. Propranolol, 40 milligrams, twice a day for the migraine prevention"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.98,
      "end_seconds": 85.42,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.17,
      "end_seconds": 91.98,
      "duration_seconds": 3.81,
      "text": "No, um, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.19,
      "end_seconds": 105.1,
      "duration_seconds": 3.91,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.02,
      "end_seconds": 111.03,
      "duration_seconds": 4.01,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.55,
      "end_seconds": 117.24,
      "duration_seconds": 4.69,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.9,
      "end_seconds": 132.11,
      "duration_seconds": 14.21,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. Yes, I work in a bakery, early starts. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.65,
      "end_seconds": 137.69,
      "duration_seconds": 4.04,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.32,
      "end_seconds": 141.57,
      "duration_seconds": 3.25,
      "text": "I, I have arthritis in my knees"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.36,
      "end_seconds": 143.15,
      "duration_seconds": 0.79,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.79,
      "end_seconds": 152.14,
      "duration_seconds": 3.35,
      "text": "I have migraines, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.33,
      "end_seconds": 161.92,
      "duration_seconds": 2.59,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.88,
      "end_seconds": 176.46,
      "duration_seconds": 2.58,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.67,
      "end_seconds": 192.13,
      "duration_seconds": 3.46,
      "text": "Okay: pulse 74, pressure 120 over 82."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.86,
      "end_seconds": 195.24,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.3,
      "end_seconds": 200.21,
      "duration_seconds": 3.91,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.9,
      "end_seconds": 206.32,
      "duration_seconds": 4.42,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.71,
      "end_seconds": 224.74,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.82,
      "end_seconds": 227.74,
      "duration_seconds": 1.92,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.31,
      "end_seconds": 252.75,
      "duration_seconds": 6.44,
      "text": "The uterus feels enlarged and firm, about the size of a ten-week pregnancy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.91,
      "end_seconds": 276.3,
      "duration_seconds": 20.39,
      "text": "You can relax now. Right, here's what I'm thinking. I think we're dealing with heavy periods, possibly from fibroids at this stage. Just to be sure I understood. You've had very heavy periods, since Monday, and no weight loss or pain with sex."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.83,
      "end_seconds": 277.53,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.18,
      "end_seconds": 294.3,
      "duration_seconds": 16.12,
      "text": "I'm sending you for a pelvic ultrasound because of heavy periods. Keep a record of the bleeding with the pad count. Let's get you seen by the gynaecology clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.38,
      "end_seconds": 297.08,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.69,
      "end_seconds": 310.85,
      "duration_seconds": 13.16,
      "text": "I'd like to see you again after the scan. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.39,
      "end_seconds": 317.49,
      "duration_seconds": 5.1,
      "text": "So, I come back after the scan. Is that that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.5,
      "end_seconds": 322.56,
      "duration_seconds": 4.06,
      "text": "yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.3,
      "end_seconds": 326.47,
      "duration_seconds": 2.17,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.28,
      "end_seconds": 328.46,
      "duration_seconds": 1.18,
      "text": "all the best"
    }
  ]
}