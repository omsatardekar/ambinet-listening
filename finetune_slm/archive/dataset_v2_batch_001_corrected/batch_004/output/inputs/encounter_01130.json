{
  "schema_version": "1.0",
  "encounter_id": "01130",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 2.66,
      "duration_seconds": 1.75,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.28,
      "end_seconds": 8.23,
      "duration_seconds": 4.95,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.02,
      "end_seconds": 13.23,
      "duration_seconds": 4.21,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.32,
      "end_seconds": 19.36,
      "duration_seconds": 5.04,
      "text": "I've been dealing with a mole that has got bigger."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.52,
      "end_seconds": 22.57,
      "duration_seconds": 2.05,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.49,
      "end_seconds": 28.71,
      "duration_seconds": 5.22,
      "text": "A darker edge goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.64,
      "end_seconds": 33.41,
      "duration_seconds": 2.77,
      "text": "Has there been occasional itching too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.09,
      "end_seconds": 37.51,
      "duration_seconds": 3.42,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.74,
      "end_seconds": 40.22,
      "duration_seconds": 1.48,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.97,
      "end_seconds": 44.42,
      "duration_seconds": 3.45,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.98,
      "end_seconds": 46.32,
      "duration_seconds": 1.34,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.8,
      "end_seconds": 49.58,
      "duration_seconds": 1.78,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.63,
      "end_seconds": 54.91,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.68,
      "end_seconds": 58.96,
      "duration_seconds": 3.28,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.51,
      "end_seconds": 61.07,
      "duration_seconds": 1.56,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.21,
      "end_seconds": 66.09,
      "duration_seconds": 3.88,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.79,
      "end_seconds": 70.27,
      "duration_seconds": 2.48,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.0,
      "end_seconds": 75.29,
      "duration_seconds": 3.29,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.94,
      "end_seconds": 83.14,
      "duration_seconds": 4.2,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.17,
      "end_seconds": 95.35,
      "duration_seconds": 11.18,
      "text": "I have high cholesterol, for five years. I have thin bones, for about a year. I've had gout for nearly five years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.34,
      "end_seconds": 104.59,
      "duration_seconds": 7.25,
      "text": "alright, high cholesterol, that matches what I have here do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.17,
      "end_seconds": 120.34,
      "duration_seconds": 14.17,
      "text": "Atorvastatin, 20 milligrams, at night for my cholesterol. I take alendronate, 70 milligrams, once a week. Febuxostat. I take it 80 milligrams, once a day for the gout"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 121.9,
      "end_seconds": 131.32,
      "duration_seconds": 9.42,
      "text": "doctor, I think the last prescription for the febuxostat was 160 milligrams. We changed it at the last visit"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.64,
      "end_seconds": 136.71,
      "duration_seconds": 4.07,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.37,
      "end_seconds": 141.13,
      "duration_seconds": 3.76,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.78,
      "end_seconds": 147.56,
      "duration_seconds": 4.78,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.79,
      "end_seconds": 160.58,
      "duration_seconds": 11.79,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.45,
      "end_seconds": 165.79,
      "duration_seconds": 3.34,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.63,
      "end_seconds": 179.65,
      "duration_seconds": 13.02,
      "text": "I had a cataract operation in my left eye about a year ago. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.28,
      "end_seconds": 197.68,
      "duration_seconds": 2.4,
      "text": "Any sign of other new moles?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.08,
      "end_seconds": 203.01,
      "duration_seconds": 3.93,
      "text": "not that I've noticed, no other new moles"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.09,
      "end_seconds": 207.08,
      "duration_seconds": 2.99,
      "text": "have you had any crusting or bleeding?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.26,
      "end_seconds": 210.2,
      "duration_seconds": 1.94,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.23,
      "end_seconds": 213.43,
      "duration_seconds": 2.2,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.59,
      "end_seconds": 216.7,
      "duration_seconds": 2.11,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.4,
      "end_seconds": 223.8,
      "duration_seconds": 4.4,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.68,
      "end_seconds": 226.62,
      "duration_seconds": 1.94,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.25,
      "end_seconds": 244.87,
      "duration_seconds": 5.62,
      "text": "The mole is seven millimetres with an irregular border and two shades of brown."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.11,
      "end_seconds": 251.94,
      "duration_seconds": 1.83,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.21,
      "end_seconds": 289.21,
      "duration_seconds": 27.0,
      "text": "I think a dermoscopy makes sense here, for changing mole. I'll request a skin biopsy, it'll help with changing mole. Protect it from the sun until you are seen. I'll also refer you to the skin cancer clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.78,
      "end_seconds": 293.76,
      "duration_seconds": 2.98,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.95,
      "end_seconds": 313.82,
      "duration_seconds": 15.87,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's review you after the biopsy. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.32,
      "end_seconds": 318.26,
      "duration_seconds": 2.94,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}