{
  "schema_version": "1.0",
  "encounter_id": "01003",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.84,
      "duration_seconds": 3.12,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 11.01,
      "duration_seconds": 5.79,
      "text": "You're alright, take a a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.54,
      "end_seconds": 19.81,
      "duration_seconds": 7.27,
      "text": "I've been waking at night with wheeze, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.31,
      "end_seconds": 24.09,
      "duration_seconds": 2.78,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.81,
      "end_seconds": 28.07,
      "duration_seconds": 2.26,
      "text": "it's been three days now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.63,
      "end_seconds": 31.13,
      "duration_seconds": 2.5,
      "text": "Alright, does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.98,
      "end_seconds": 35.72,
      "duration_seconds": 2.74,
      "text": "it's worse with cold air"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.25,
      "end_seconds": 40.09,
      "duration_seconds": 2.84,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.83,
      "end_seconds": 44.04,
      "duration_seconds": 2.21,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.55,
      "end_seconds": 49.51,
      "duration_seconds": 3.96,
      "text": "have you been using your blue inhaler a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.17,
      "end_seconds": 57.14,
      "duration_seconds": 6.97,
      "text": "Yes, since Monday. As for using my blue inhaler a lot, I'd say moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.38,
      "end_seconds": 63.87,
      "duration_seconds": 5.49,
      "text": "Have you been waking at night with wheeze at any time before this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.86,
      "end_seconds": 75.35,
      "duration_seconds": 9.49,
      "text": "Let me think, yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.27,
      "end_seconds": 81.68,
      "duration_seconds": 4.41,
      "text": "Did you get leg swelling, fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.91,
      "end_seconds": 87.51,
      "duration_seconds": 4.6,
      "text": "no, no leg swelling, fever or chest pain"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.18,
      "end_seconds": 91.26,
      "duration_seconds": 2.08,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.09,
      "end_seconds": 93.01,
      "duration_seconds": 0.92,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.0,
      "end_seconds": 100.26,
      "duration_seconds": 5.26,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.07,
      "end_seconds": 103.89,
      "duration_seconds": 2.82,
      "text": "no, um, all normal there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.65,
      "end_seconds": 106.86,
      "duration_seconds": 1.21,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.46,
      "end_seconds": 112.13,
      "duration_seconds": 1.67,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.32,
      "end_seconds": 133.58,
      "duration_seconds": 3.26,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.46,
      "end_seconds": 135.67,
      "duration_seconds": 1.21,
      "text": "Yes, trimethoprim."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.02,
      "end_seconds": 143.82,
      "duration_seconds": 3.8,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.05,
      "end_seconds": 148.94,
      "duration_seconds": 3.89,
      "text": "Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.69,
      "end_seconds": 166.06,
      "duration_seconds": 2.37,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.38,
      "end_seconds": 173.06,
      "duration_seconds": 5.68,
      "text": "yes, asthma i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.87,
      "end_seconds": 176.73,
      "duration_seconds": 2.86,
      "text": "mm, okay do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.58,
      "end_seconds": 179.08,
      "duration_seconds": 1.5,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.0,
      "end_seconds": 183.42,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.98,
      "end_seconds": 188.76,
      "duration_seconds": 3.78,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.62,
      "end_seconds": 191.96,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.33,
      "end_seconds": 201.49,
      "duration_seconds": 4.16,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.28,
      "end_seconds": 206.26,
      "duration_seconds": 2.98,
      "text": "Anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.1,
      "end_seconds": 210.89,
      "duration_seconds": 3.79,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.16,
      "end_seconds": 215.26,
      "duration_seconds": 3.1,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.66,
      "end_seconds": 229.46,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.21,
      "end_seconds": 250.66,
      "duration_seconds": 9.45,
      "text": "Okay: temperature 36.7, blood pressure 116 over 73, oxygen saturation is 98 percent, respiratory rate 18, pulse 85."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.94,
      "end_seconds": 254.24,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.87,
      "end_seconds": 258.47,
      "duration_seconds": 2.6,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.67,
      "end_seconds": 263.37,
      "duration_seconds": 3.7,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.35,
      "end_seconds": 266.39,
      "duration_seconds": 1.04,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.33,
      "end_seconds": 270.38,
      "duration_seconds": 2.05,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 287.54,
      "duration_seconds": 5.54,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.84,
      "end_seconds": 293.17,
      "duration_seconds": 2.33,
      "text": "Right, all finished, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.0,
      "end_seconds": 325.38,
      "duration_seconds": 20.38,
      "text": "let me tell you where I've got to i can't pin this down yet we're looking at poorly controlled asthma or an inhaler technique problem just to be sure I understood you've been waking at night with wheeze for three days, moderate, and and no leg swelling or fever"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.6,
      "end_seconds": 328.61,
      "duration_seconds": 2.01,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.4,
      "end_seconds": 351.06,
      "duration_seconds": 18.66,
      "text": "I'm prescribing beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term that should help with asthma control i'll put all of this in writing so you don't have to remember it that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.99,
      "end_seconds": 354.14,
      "duration_seconds": 2.15,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.04,
      "end_seconds": 357.0,
      "duration_seconds": 1.96,
      "text": "have a a good day"
    }
  ]
