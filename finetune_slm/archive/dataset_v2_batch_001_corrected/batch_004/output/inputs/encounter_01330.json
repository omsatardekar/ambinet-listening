{
  "schema_version": "1.0",
  "encounter_id": "01330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.97,
      "duration_seconds": 2.99,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.96,
      "end_seconds": 6.89,
      "duration_seconds": 0.93,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.97,
      "end_seconds": 12.41,
      "duration_seconds": 4.44,
      "text": "doctor, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.04,
      "end_seconds": 20.79,
      "duration_seconds": 6.75,
      "text": "Good, that'll be useful. Pull up a chair. What do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.53,
      "end_seconds": 33.58,
      "duration_seconds": 8.05,
      "text": "It's a severe sore throat, doctor. He didn't want to to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.35,
      "end_seconds": 43.07,
      "duration_seconds": 3.72,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.87,
      "end_seconds": 45.79,
      "duration_seconds": 1.92,
      "text": "probably three days. Yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.99,
      "end_seconds": 55.93,
      "duration_seconds": 8.94,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.67,
      "end_seconds": 61.73,
      "duration_seconds": 4.06,
      "text": "It's, It's worse with swallowing. Mostly moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.51,
      "end_seconds": 65.94,
      "duration_seconds": 3.43,
      "text": "What about noisy breathing, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.92,
      "end_seconds": 74.46,
      "duration_seconds": 7.54,
      "text": "Yeah, um, that too. Drooling was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.67,
      "end_seconds": 88.49,
      "duration_seconds": 2.82,
      "text": "so, and cough, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.58,
      "end_seconds": 91.06,
      "duration_seconds": 1.48,
      "text": "No. No cough."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 91.77,
      "end_seconds": 97.39,
      "duration_seconds": 5.62,
      "text": "Actually, doctor, I did notice cough. He doesn't always say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.59,
      "end_seconds": 106.69,
      "duration_seconds": 6.1,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.2,
      "end_seconds": 113.18,
      "duration_seconds": 5.98,
      "text": "alright, I'll note both what you've said and what you've noticed. How about rash?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.46,
      "end_seconds": 117.28,
      "duration_seconds": 2.82,
      "text": "no, I haven't had any rash"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.86,
      "end_seconds": 120.61,
      "duration_seconds": 2.75,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.19,
      "end_seconds": 123.58,
      "duration_seconds": 2.39,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.25,
      "end_seconds": 129.07,
      "duration_seconds": 4.82,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.61,
      "end_seconds": 132.24,
      "duration_seconds": 2.63,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.1,
      "end_seconds": 136.42,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.07,
      "end_seconds": 142.09,
      "duration_seconds": 4.02,
      "text": "Walnuts. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.4,
      "end_seconds": 146.14,
      "duration_seconds": 2.74,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.8,
      "end_seconds": 152.17,
      "duration_seconds": 5.37,
      "text": "My mother has an underactive thyroid. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.38,
      "end_seconds": 157.41,
      "duration_seconds": 4.03,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.54,
      "end_seconds": 181.33,
      "duration_seconds": 17.79,
      "text": "I've never touched a cigarette. I used to drink heavily but I stopped four years ago. I live with my elderly mother. I walk the dog every morning. I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.0,
      "end_seconds": 185.14,
      "duration_seconds": 3.14,
      "text": "alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.49,
      "end_seconds": 187.6,
      "duration_seconds": 1.11,
      "text": "yes, anxiety"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.5,
      "end_seconds": 190.02,
      "duration_seconds": 1.52,
      "text": "yes, carry on"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.98,
      "end_seconds": 194.91,
      "duration_seconds": 2.93,
      "text": "I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.75,
      "end_seconds": 197.48,
      "duration_seconds": 1.73,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.43,
      "end_seconds": 202.35,
      "duration_seconds": 2.92,
      "text": "I've had an enlarged prostate, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.72,
      "end_seconds": 209.64,
      "duration_seconds": 5.92,
      "text": "Okay, I can see an enlarged prostate in your file as well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.08,
      "end_seconds": 225.57,
      "duration_seconds": 3.49,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.6,
      "end_seconds": 230.68,
      "duration_seconds": 3.08,
      "text": "Escitalopram, 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 232.1,
      "end_seconds": 239.21,
      "duration_seconds": 7.11,
      "text": "He is supposed to take it once a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.37,
      "end_seconds": 242.85,
      "duration_seconds": 2.48,
      "text": "Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.42,
      "end_seconds": 247.31,
      "duration_seconds": 2.89,
      "text": "roughly how long on that one?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.3,
      "end_seconds": 253.92,
      "duration_seconds": 5.62,
      "text": "About about three months. Tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.79,
      "end_seconds": 257.79,
      "duration_seconds": 2.0,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.37,
      "end_seconds": 269.78,
      "duration_seconds": 2.41,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.1,
      "end_seconds": 298.28,
      "duration_seconds": 7.18,
      "text": "Okay: blood pressure 131 over 73, temperature 37.0, SpO2 89 percent on room air, pulse 100."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.21,
      "end_seconds": 303.62,
      "duration_seconds": 3.41,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.42,
      "end_seconds": 305.53,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.96,
      "end_seconds": 308.43,
      "duration_seconds": 1.47,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.28,
      "end_seconds": 320.42,
      "duration_seconds": 4.14,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.39,
      "end_seconds": 322.34,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.93,
      "end_seconds": 329.28,
      "duration_seconds": 2.35,
      "text": "Alright, you can relax now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.78,
      "end_seconds": 375.98,
      "duration_seconds": 36.2,
      "text": "Right, here's what I'm thinking. This looks most like a possible airway infection that needs emergency care. The reason I say that is that your story and my examination fit together. Another possibility is severe tonsillitis. I'd like to arrange an urgent airway assessment for stridor and drooling. It's a routine test and it'll give us a much clearer picture. Do not lie flat, I am calling an ambulance now. We'll refer you to the emergency ENT team."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.66,
      "end_seconds": 388.79,
      "duration_seconds": 12.13,
      "text": "If the breathing gets harder, or you feel really unwell, please come to the emergency department. We'll catch up straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.5,
      "end_seconds": 393.84,
      "duration_seconds": 3.34,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.41,
      "end_seconds": 396.14,
      "duration_seconds": 1.73,
      "text": "Alright, look after yourself."
    }
  ]
}