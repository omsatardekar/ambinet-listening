{
  "schema_version": "1.0",
  "encounter_id": "01131",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.09,
      "duration_seconds": 4.39,
      "text": "Erm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 9.48,
      "duration_seconds": 3.77,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.04,
      "end_seconds": 18.0,
      "duration_seconds": 6.96,
      "text": "Oh, honestly, it's sudden low back pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.99,
      "end_seconds": 23.34,
      "duration_seconds": 3.35,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.07,
      "end_seconds": 37.38,
      "duration_seconds": 13.31,
      "text": "Uh, um, hm. It was either the end of last month or earlier than that. I couldn't tell you the date. There's stiffness as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.91,
      "end_seconds": 38.61,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.17,
      "end_seconds": 42.98,
      "duration_seconds": 3.81,
      "text": "And a twinge down the thigh, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.2,
      "end_seconds": 58.01,
      "duration_seconds": 3.81,
      "text": "Alright, any bladder problems or leg weakness at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.2,
      "end_seconds": 62.71,
      "duration_seconds": 3.51,
      "text": "Ah, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.55,
      "end_seconds": 68.88,
      "duration_seconds": 4.33,
      "text": "Any numbness in the groin or fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.39,
      "end_seconds": 74.22,
      "duration_seconds": 4.83,
      "text": "No numbness in the groin or fever, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 78.22,
      "duration_seconds": 3.49,
      "text": "Right, right. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.46,
      "end_seconds": 82.97,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.34,
      "end_seconds": 87.44,
      "duration_seconds": 3.1,
      "text": "Right, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.94,
      "end_seconds": 90.77,
      "duration_seconds": 1.83,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.45,
      "end_seconds": 95.41,
      "duration_seconds": 2.96,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.67,
      "end_seconds": 100.51,
      "duration_seconds": 3.84,
      "text": "No, um, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.52,
      "end_seconds": 103.88,
      "duration_seconds": 2.36,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.39,
      "end_seconds": 109.83,
      "duration_seconds": 5.44,
      "text": "I take Eltroxin, 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.05,
      "end_seconds": 113.91,
      "duration_seconds": 2.86,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.74,
      "end_seconds": 132.77,
      "duration_seconds": 17.03,
      "text": "About about a year. Febuxostat. I take it 80 milligrams, once a day. I'm supposed to take it regularly, but I don't always manage. Paracetamol. I take it 1 gram, when needed. Allopurinol I don't take anymore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.73,
      "end_seconds": 138.15,
      "duration_seconds": 3.42,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.57,
      "end_seconds": 144.27,
      "duration_seconds": 4.7,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.29,
      "end_seconds": 147.09,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.45,
      "end_seconds": 152.94,
      "duration_seconds": 4.49,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.85,
      "end_seconds": 156.23,
      "duration_seconds": 1.38,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.66,
      "end_seconds": 160.37,
      "duration_seconds": 2.71,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.24,
      "end_seconds": 163.69,
      "duration_seconds": 2.45,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.4,
      "end_seconds": 167.79,
      "duration_seconds": 2.39,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 175.8,
      "duration_seconds": 2.87,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.71,
      "end_seconds": 183.39,
      "duration_seconds": 5.68,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.19,
      "end_seconds": 189.48,
      "duration_seconds": 4.29,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.23,
      "end_seconds": 194.87,
      "duration_seconds": 3.64,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.14,
      "end_seconds": 200.52,
      "duration_seconds": 4.38,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.12,
      "end_seconds": 212.13,
      "duration_seconds": 10.01,
      "text": "Right, yes, an underactive thyroid. I'm hoping you can tell me something definite. I've had gout for about a year now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.6,
      "end_seconds": 228.92,
      "duration_seconds": 15.32,
      "text": "Okay, go on. Right, so an underactive thyroid and gout are already on your record. We'll keep that in mind today. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.2,
      "end_seconds": 234.97,
      "duration_seconds": 4.77,
      "text": "My grandfather had a stroke. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.21,
      "end_seconds": 240.61,
      "duration_seconds": 4.4,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.21,
      "end_seconds": 253.27,
      "duration_seconds": 1.06,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.25,
      "end_seconds": 257.41,
      "duration_seconds": 2.16,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 274.08,
      "duration_seconds": 6.44,
      "text": "The muscles beside the spine are tight and tender and you can lift both legs fully."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.77,
      "end_seconds": 308.54,
      "duration_seconds": 30.77,
      "text": "Thank you, you can get dressed. So where does that leave us? I think we're dealing with mechanical low back pain at this stage. That's my thinking for now, and it may change as we learn more. A nerve irritation is also on my list. Just to be sure I understood. You've had sudden low back pain, and no numbness in the groin or leg weakness."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.22,
      "end_seconds": 312.95,
      "duration_seconds": 2.73,
      "text": "Yes, uh, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.3,
      "end_seconds": 345.97,
      "duration_seconds": 31.67,
      "text": "I'm going to put you on naproxen, 500 milligrams, twice a day with food, five days. That's for back pain. Keep moving and walk a little each day. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Do get help quickly if you notice numbness in the groin or lose bladder control. Come back if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 347.03,
      "end_seconds": 350.81,
      "duration_seconds": 3.78,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.53,
      "end_seconds": 354.53,
      "duration_seconds": 2.0,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.26,
      "end_seconds": 360.77,
      "duration_seconds": 4.51,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.03,
      "end_seconds": 365.5,
      "duration_seconds": 3.47,
      "text": "Great, thank you for your help."
    }
  ]
}