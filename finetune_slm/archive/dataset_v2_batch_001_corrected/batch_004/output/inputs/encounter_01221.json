{
  "schema_version": "1.0",
  "encounter_id": "01221",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.33,
      "duration_seconds": 4.35,
      "text": "Erm, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.88,
      "end_seconds": 10.46,
      "duration_seconds": 4.58,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 18.02,
      "duration_seconds": 6.51,
      "text": "It's loose stools after meals. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.25,
      "end_seconds": 22.41,
      "duration_seconds": 3.16,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.03,
      "end_seconds": 31.15,
      "duration_seconds": 4.12,
      "text": "Ah, it's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.63,
      "end_seconds": 35.91,
      "duration_seconds": 4.28,
      "text": "Okay, go on. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.67,
      "end_seconds": 43.74,
      "duration_seconds": 6.07,
      "text": "Erm, maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.63,
      "end_seconds": 47.64,
      "duration_seconds": 2.01,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.61,
      "end_seconds": 55.79,
      "duration_seconds": 3.18,
      "text": "It's worse with coffee and stress."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.24,
      "end_seconds": 57.04,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.59,
      "end_seconds": 71.96,
      "duration_seconds": 11.37,
      "text": "Oh, and cramping lower tummy pain. Sorry, what was I saying, about cramping lower tummy pain, honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.8,
      "end_seconds": 88.29,
      "duration_seconds": 4.49,
      "text": "Any blood in the stool, fever or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.67,
      "end_seconds": 96.36,
      "duration_seconds": 6.69,
      "text": "No, um, no blood in the stool, fever or weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.45,
      "end_seconds": 101.16,
      "duration_seconds": 2.71,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.92,
      "end_seconds": 102.89,
      "duration_seconds": 0.97,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.61,
      "end_seconds": 107.07,
      "duration_seconds": 2.46,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.95,
      "end_seconds": 110.76,
      "duration_seconds": 2.81,
      "text": "Yes, kiwi. I get hives."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.81,
      "end_seconds": 122.01,
      "duration_seconds": 2.2,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.84,
      "end_seconds": 130.19,
      "duration_seconds": 7.35,
      "text": "Sorry, what was I saying, it's escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.72,
      "end_seconds": 134.17,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.98,
      "end_seconds": 139.6,
      "duration_seconds": 3.62,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.86,
      "end_seconds": 142.84,
      "duration_seconds": 1.98,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.79,
      "end_seconds": 153.61,
      "duration_seconds": 5.82,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.26,
      "end_seconds": 157.56,
      "duration_seconds": 2.3,
      "text": "Alright, have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.58,
      "end_seconds": 163.93,
      "duration_seconds": 4.35,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.3,
      "end_seconds": 166.73,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.91,
      "end_seconds": 169.0,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.81,
      "end_seconds": 176.03,
      "duration_seconds": 6.22,
      "text": "Has anyone ever diagnosed you with something? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.91,
      "end_seconds": 178.29,
      "duration_seconds": 1.38,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.76,
      "end_seconds": 182.33,
      "duration_seconds": 2.57,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.08,
      "end_seconds": 191.41,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.72,
      "end_seconds": 209.32,
      "duration_seconds": 8.6,
      "text": "Okay: temp 36.8 degrees, SpO2 99 percent on room air. And pulse 65, pressure 124 over 78."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 215.46,
      "duration_seconds": 4.75,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.25,
      "end_seconds": 233.26,
      "duration_seconds": 1.01,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.78,
      "end_seconds": 237.71,
      "duration_seconds": 2.93,
      "text": "So, take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.75,
      "end_seconds": 252.52,
      "duration_seconds": 4.77,
      "text": "Your tummy is soft and only mildly tender on the left."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.52,
      "end_seconds": 263.52,
      "duration_seconds": 8.0,
      "text": "You can relax now. Right, here's what I'm thinking. This looks most like irritable bowel syndrome with diarrhoea."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.78,
      "end_seconds": 306.96,
      "duration_seconds": 25.18,
      "text": "Let's get a coeliac blood test, for diarrhoea. Keep a food diary and cut back on coffee. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Do get help quickly if the symptoms get worse. We'll catch up after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.77,
      "end_seconds": 311.32,
      "duration_seconds": 2.55,
      "text": "Oh, that's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.02,
      "end_seconds": 318.11,
      "duration_seconds": 4.09,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.64,
      "end_seconds": 321.34,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    }
  ]
}