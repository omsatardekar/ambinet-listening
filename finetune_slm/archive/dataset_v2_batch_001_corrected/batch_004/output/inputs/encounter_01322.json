    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.88,
      "end_seconds": 143.97,
      "duration_seconds": 3.09,
      "text": "What do you do during the day?"
