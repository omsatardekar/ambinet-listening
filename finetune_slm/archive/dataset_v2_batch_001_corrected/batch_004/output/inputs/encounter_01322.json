      "role": "PATIENT",
      "start_seconds": 66.19,
      "end_seconds": 70.69,
      "duration_seconds": 4.5,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.66,
      "end_seconds": 84.92,
      "duration_seconds": 3.26,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.35,
      "end_seconds": 89.36,
      "duration_seconds": 3.01,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.7,
      "end_seconds": 111.0,
      "duration_seconds": 3.3,
      "text": "Does your family have any medical conditions?"
