      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 20.79,
      "duration_seconds": 7.47,
      "text": "I'm here because of irregular periods i did try to ignore it it for a while"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.79,
      "end_seconds": 25.63,
      "duration_seconds": 2.84,
      "text": "How long has it been like this?"
