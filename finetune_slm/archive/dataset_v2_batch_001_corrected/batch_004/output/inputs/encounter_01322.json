      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.84,
      "end_seconds": 137.16,
      "duration_seconds": 4.32,
      "text": "I grab fast food at lunch most days."
