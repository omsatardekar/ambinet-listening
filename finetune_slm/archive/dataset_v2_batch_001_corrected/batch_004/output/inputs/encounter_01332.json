{
  "schema_version": "1.0",
  "encounter_id": "01332",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 5.59,
      "duration_seconds": 4.59,
      "text": "Ah, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 10.81,
      "duration_seconds": 3.66,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.44,
      "end_seconds": 20.05,
      "duration_seconds": 8.61,
      "text": "Okay, so honestly, it's a racing heart, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.04,
      "end_seconds": 27.39,
      "duration_seconds": 6.35,
      "text": "What's the timeline, when did it begin? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.61,
      "end_seconds": 44.29,
      "duration_seconds": 13.68,
      "text": "Um, I'd say about a month. Actually, no, closer to six months. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.17,
      "end_seconds": 48.05,
      "duration_seconds": 2.88,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.77,
      "end_seconds": 52.07,
      "duration_seconds": 2.3,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.69,
      "end_seconds": 55.78,
      "duration_seconds": 2.09,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.55,
      "end_seconds": 61.58,
      "duration_seconds": 5.03,
      "text": "Bulging eyes goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.56,
      "end_seconds": 76.88,
      "duration_seconds": 4.32,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.1,
      "end_seconds": 89.16,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.39,
      "end_seconds": 107.75,
      "duration_seconds": 8.36,
      "text": "Okay: weight 82 kilos, pulse is 113 beats a minute. And blood pressure 128 over 71, height 160 centimetres."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.62,
      "end_seconds": 115.3,
      "duration_seconds": 4.68,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.86,
      "end_seconds": 128.35,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.52,
      "end_seconds": 131.56,
      "duration_seconds": 2.04,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 151.21,
      "duration_seconds": 5.81,
      "text": "You have a fine tremor and your pulse is fast and regular."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.13,
      "end_seconds": 158.52,
      "duration_seconds": 4.39,
      "text": "That's all I needed to check. Has there been any diarrhoea?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.15,
      "end_seconds": 161.89,
      "duration_seconds": 1.74,
      "text": "Definitely no diarrhoea."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.68,
      "end_seconds": 169.49,
      "duration_seconds": 5.81,
      "text": "Let me check a few things. Any chest pain or neck pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.49,
      "end_seconds": 176.66,
      "duration_seconds": 5.17,
      "text": "I mean, no, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.54,
      "end_seconds": 182.52,
      "duration_seconds": 3.98,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.3,
      "end_seconds": 187.66,
      "duration_seconds": 3.36,
      "text": "Erm, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.6,
      "end_seconds": 192.3,
      "duration_seconds": 2.7,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.02,
      "end_seconds": 195.17,
      "duration_seconds": 1.15,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 198.79,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 203.65,
      "duration_seconds": 4.34,
      "text": "I'm on telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.51,
      "end_seconds": 224.36,
      "duration_seconds": 2.85,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.1,
      "end_seconds": 229.17,
      "duration_seconds": 3.07,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.67,
      "end_seconds": 234.77,
      "duration_seconds": 4.1,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.26,
      "end_seconds": 239.96,
      "duration_seconds": 3.7,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.0,
      "end_seconds": 243.46,
      "duration_seconds": 1.46,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.19,
      "end_seconds": 247.91,
      "duration_seconds": 3.72,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.19,
      "end_seconds": 253.57,
      "duration_seconds": 4.38,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.58,
      "end_seconds": 260.1,
      "duration_seconds": 4.52,
      "text": "Well, you know, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.75,
      "end_seconds": 262.84,
      "duration_seconds": 2.09,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.15,
      "end_seconds": 270.24,
      "duration_seconds": 6.09,
      "text": "Yes, you know, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.22,
      "end_seconds": 303.82,
      "duration_seconds": 31.6,
      "text": "Taking everything into account, I don't have a clear answer today: an overactive thyroid is possible, and so is anxiety. I'm sending you for an ECG because of palpitations. I'm sending you for thyroid blood tests because of weight loss and palpitations. I'm prescribing propranolol, 20 milligrams, twice a day, until review. It's for racing heart and tremor. Avoid caffeine while the heart is racing. I'm going to send a referral to the endocrine clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.2,
      "end_seconds": 308.28,
      "duration_seconds": 3.08,
      "text": "Book a review after the thyroid results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.03,
      "end_seconds": 309.73,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.83,
      "end_seconds": 313.28,
      "duration_seconds": 2.45,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.05,
      "end_seconds": 318.87,
      "duration_seconds": 4.82,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}