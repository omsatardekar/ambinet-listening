{
  "schema_version": "1.0",
  "encounter_id": "01343",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 5.13,
      "duration_seconds": 4.34,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 11.09,
      "duration_seconds": 4.89,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.9,
      "end_seconds": 18.76,
      "duration_seconds": 6.86,
      "text": "Okay, so doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.18,
      "end_seconds": 25.01,
      "duration_seconds": 4.83,
      "text": "So the thing is, I've got bloating after meals."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.09,
      "end_seconds": 30.38,
      "duration_seconds": 3.29,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.88,
      "end_seconds": 35.45,
      "duration_seconds": 3.57,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.08,
      "end_seconds": 45.77,
      "duration_seconds": 9.69,
      "text": "Alright, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.6,
      "end_seconds": 64.04,
      "duration_seconds": 17.44,
      "text": "Mm, about a eight out of ten. It settles a little with walking. My sister suggested writing things down, but I forgot. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.09,
      "end_seconds": 69.05,
      "duration_seconds": 2.96,
      "text": "Any a lot of wind as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.92,
      "end_seconds": 78.93,
      "duration_seconds": 4.01,
      "text": "Yeah. Ten days, uh, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.9,
      "end_seconds": 84.58,
      "duration_seconds": 4.68,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 88.69,
      "duration_seconds": 2.83,
      "text": "No, you know, no conditions."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.34,
      "end_seconds": 107.61,
      "duration_seconds": 3.27,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.64,
      "end_seconds": 111.67,
      "duration_seconds": 2.03,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.66,
      "end_seconds": 119.28,
      "duration_seconds": 6.62,
      "text": "Tell me your medicines, please. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.97,
      "end_seconds": 123.89,
      "duration_seconds": 3.92,
      "text": "Peppermint capsules. I take it after meals."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.45,
      "end_seconds": 130.9,
      "duration_seconds": 3.45,
      "text": "So, how long have you been on it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.4,
      "end_seconds": 134.17,
      "duration_seconds": 1.77,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.67,
      "end_seconds": 139.37,
      "duration_seconds": 3.7,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.34,
      "end_seconds": 144.5,
      "duration_seconds": 4.16,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.16,
      "end_seconds": 147.15,
      "duration_seconds": 1.99,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.21,
      "end_seconds": 154.81,
      "duration_seconds": 5.6,
      "text": "Ah, yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.58,
      "end_seconds": 158.96,
      "duration_seconds": 3.38,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.78,
      "end_seconds": 164.94,
      "duration_seconds": 4.16,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.25,
      "end_seconds": 169.63,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.7,
      "end_seconds": 175.38,
      "duration_seconds": 3.68,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.7,
      "end_seconds": 178.38,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.89,
      "end_seconds": 184.05,
      "duration_seconds": 4.16,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.7,
      "end_seconds": 190.49,
      "duration_seconds": 4.79,
      "text": "Have you noticed night-time diarrhoea, blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.03,
      "end_seconds": 201.24,
      "duration_seconds": 9.21,
      "text": "Okay, you know, so no night-time diarrhoea, blood in the stool or weight loss, none of it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.4,
      "end_seconds": 203.63,
      "duration_seconds": 1.23,
      "text": "How about vomiting?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.58,
      "end_seconds": 206.1,
      "duration_seconds": 1.52,
      "text": "No. No vomiting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.44,
      "end_seconds": 209.8,
      "duration_seconds": 2.36,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.25,
      "end_seconds": 216.64,
      "duration_seconds": 5.39,
      "text": "Okay, so that's normal as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.9,
      "end_seconds": 220.86,
      "duration_seconds": 2.96,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.91,
      "end_seconds": 224.1,
      "duration_seconds": 2.19,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.26,
      "end_seconds": 228.37,
      "duration_seconds": 3.11,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.26,
      "end_seconds": 242.23,
      "duration_seconds": 1.97,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.29,
      "end_seconds": 266.73,
      "duration_seconds": 12.44,
      "text": "Okay: pulse 66, oxygen saturation is 97 percent, BMI works out to 29.7, temp 37.0 degrees, height 162 centimetres, weight 78 kilos, BP is 119 over 68."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.24,
      "end_seconds": 274.08,
      "duration_seconds": 1.84,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.71,
      "end_seconds": 279.53,
      "duration_seconds": 3.82,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.02,
      "end_seconds": 283.13,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.81,
      "end_seconds": 286.62,
      "duration_seconds": 1.81,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.62,
      "end_seconds": 300.99,
      "duration_seconds": 5.37,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.99,
      "end_seconds": 312.68,
      "duration_seconds": 1.69,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.19,
      "end_seconds": 319.87,
      "duration_seconds": 2.68,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.42,
      "end_seconds": 349.9,
      "duration_seconds": 15.48,
      "text": "We should do a coeliac blood test for bloating. Try smaller meals and keep a food and symptom diary for four weeks. I'd like you back in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.98,
      "end_seconds": 357.58,
      "duration_seconds": 5.6,
      "text": "Yeah, um, great, thank you for your help."
    }
  ]
}