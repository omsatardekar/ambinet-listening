{
  "schema_version": "1.0",
  "encounter_id": "01179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 5.34,
      "duration_seconds": 4.37,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 10.18,
      "duration_seconds": 3.9,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.27,
      "end_seconds": 17.87,
      "duration_seconds": 5.6,
      "text": "Honestly, it's watery diarrhoea, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 22.56,
      "duration_seconds": 3.44,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.82,
      "end_seconds": 26.01,
      "duration_seconds": 2.19,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.34,
      "end_seconds": 37.56,
      "duration_seconds": 11.22,
      "text": "Right, right. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.28,
      "end_seconds": 60.97,
      "duration_seconds": 22.69,
      "text": "I get some relief from oral rehydration. I'd call it severe. I told myself I'd wait and see, and here I am. I've had crampy tummy pain too, um, for one week. About crampy tummy pain, it's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.56,
      "end_seconds": 64.93,
      "duration_seconds": 3.37,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.99,
      "end_seconds": 73.91,
      "duration_seconds": 7.92,
      "text": "I had a reaction to trimethoprim when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.15,
      "end_seconds": 82.33,
      "duration_seconds": 7.18,
      "text": "What conditions have you been treated for in the past? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.86,
      "end_seconds": 85.29,
      "duration_seconds": 2.43,
      "text": "Anxiety, for about a year."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.19,
      "end_seconds": 94.17,
      "duration_seconds": 7.98,
      "text": "Yes, anxiety is known to us, good to have that clear. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.24,
      "end_seconds": 98.59,
      "duration_seconds": 2.35,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.88,
      "end_seconds": 102.75,
      "duration_seconds": 2.87,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.54,
      "end_seconds": 113.36,
      "duration_seconds": 4.82,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.6,
      "end_seconds": 127.41,
      "duration_seconds": 4.81,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.36,
      "end_seconds": 146.49,
      "duration_seconds": 17.13,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. Yes, I work in a bakery, early starts. I'm vegetarian and have been for years. I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.7,
      "end_seconds": 168.45,
      "duration_seconds": 4.75,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.26,
      "end_seconds": 177.03,
      "duration_seconds": 6.77,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.53,
      "end_seconds": 183.13,
      "duration_seconds": 4.6,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.8,
      "end_seconds": 188.54,
      "duration_seconds": 3.74,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.29,
      "end_seconds": 196.54,
      "duration_seconds": 5.25,
      "text": "So, did you get vomiting, blood in the stool or severe dehydration?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.25,
      "end_seconds": 204.94,
      "duration_seconds": 6.69,
      "text": "No vomiting, blood in the stool or severe dehydration, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.48,
      "end_seconds": 209.55,
      "duration_seconds": 4.07,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.45,
      "end_seconds": 215.34,
      "duration_seconds": 4.89,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.18,
      "end_seconds": 220.06,
      "duration_seconds": 2.88,
      "text": "Right, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.47,
      "end_seconds": 223.62,
      "duration_seconds": 2.15,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 231.66,
      "end_seconds": 242.3,
      "duration_seconds": 10.64,
      "text": "Here are the numbers, doctor. Respiratory rate 22, oxygen saturation is 97 percent. Blood pressure 123 over 71, temp 38.2 degrees, pulse is 91 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 244.44,
      "duration_seconds": 1.35,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.91,
      "end_seconds": 250.23,
      "duration_seconds": 3.32,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.0,
      "end_seconds": 253.7,
      "duration_seconds": 1.7,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.21,
      "end_seconds": 256.56,
      "duration_seconds": 1.35,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.47,
      "end_seconds": 274.59,
      "duration_seconds": 7.12,
      "text": "Your tummy is soft with mild general tenderness and your mouth is a little dry."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.89,
      "end_seconds": 279.4,
      "duration_seconds": 2.51,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 284.2,
      "end_seconds": 287.67,
      "duration_seconds": 3.47,
      "text": "We've already done a stool sample this morning, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.03,
      "end_seconds": 313.38,
      "duration_seconds": 21.35,
      "text": "Okay, I'll take a look at that. Drink plenty of fluids and wash your hands carefully. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.06,
      "end_seconds": 316.27,
      "duration_seconds": 2.21,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.0,
      "end_seconds": 328.44,
      "duration_seconds": 10.44,
      "text": "I'd like to see you again if it lasts more than a week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.47,
      "end_seconds": 335.21,
      "duration_seconds": 4.74,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.28,
      "end_seconds": 338.22,
      "duration_seconds": 1.94,
      "text": "Have a good day."
    }
  ]
}