{
  "schema_version": "1.0",
  "encounter_id": "01395",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 2.42,
      "duration_seconds": 1.72,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.49,
      "end_seconds": 5.74,
      "duration_seconds": 1.25,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.27,
      "end_seconds": 9.53,
      "duration_seconds": 2.26,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.27,
      "end_seconds": 15.01,
      "duration_seconds": 3.74,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.94,
      "end_seconds": 18.53,
      "duration_seconds": 1.59,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.35,
      "end_seconds": 25.49,
      "duration_seconds": 5.14,
      "text": "Doctor, it's a sore throat. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.96,
      "end_seconds": 30.29,
      "duration_seconds": 3.33,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.07,
      "end_seconds": 35.13,
      "duration_seconds": 4.06,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.72,
      "end_seconds": 45.12,
      "duration_seconds": 9.4,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.09,
      "end_seconds": 59.79,
      "duration_seconds": 12.7,
      "text": "I notice it more with swallowing. Mostly severe. And I've been feeling tired as well. As for feeling tired, it settles a little with rest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.53,
      "end_seconds": 81.88,
      "duration_seconds": 3.35,
      "text": "And what about confusion or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.76,
      "end_seconds": 86.23,
      "duration_seconds": 2.47,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.71,
      "end_seconds": 90.29,
      "duration_seconds": 2.58,
      "text": "Okay, have you had any breathlessness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.88,
      "end_seconds": 93.26,
      "duration_seconds": 1.38,
      "text": "No. No breathlessness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.12,
      "end_seconds": 96.27,
      "duration_seconds": 2.15,
      "text": "Right, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.71,
      "end_seconds": 99.23,
      "duration_seconds": 1.52,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.33,
      "end_seconds": 103.38,
      "duration_seconds": 2.05,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 108.71,
      "duration_seconds": 4.57,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.22,
      "end_seconds": 110.81,
      "duration_seconds": 1.59,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.63,
      "end_seconds": 116.17,
      "duration_seconds": 4.54,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.91,
      "end_seconds": 120.2,
      "duration_seconds": 3.29,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.05,
      "end_seconds": 126.05,
      "duration_seconds": 5.0,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.88,
      "end_seconds": 129.02,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.17,
      "end_seconds": 132.25,
      "duration_seconds": 2.08,
      "text": "Spironolactone, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.39,
      "end_seconds": 135.35,
      "duration_seconds": 1.96,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.24,
      "end_seconds": 141.75,
      "duration_seconds": 1.51,
      "text": "It's 25 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.35,
      "end_seconds": 145.4,
      "duration_seconds": 2.05,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.05,
      "end_seconds": 150.64,
      "duration_seconds": 4.59,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.27,
      "end_seconds": 154.95,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.79,
      "end_seconds": 162.39,
      "duration_seconds": 5.6,
      "text": "So, um, I've had heart failure for nearly five years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.32,
      "end_seconds": 170.49,
      "duration_seconds": 7.17,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.05,
      "end_seconds": 189.99,
      "duration_seconds": 2.94,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.8,
      "end_seconds": 193.36,
      "duration_seconds": 1.56,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.15,
      "end_seconds": 200.54,
      "duration_seconds": 2.39,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.65,
      "end_seconds": 215.23,
      "duration_seconds": 2.58,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.83,
      "end_seconds": 242.22,
      "duration_seconds": 8.39,
      "text": "Okay: BP is 114 over 77, SpO2 98 percent on room air, pulse 78, respiratory rate 14."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.61,
      "end_seconds": 246.66,
      "duration_seconds": 2.05,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.17,
      "end_seconds": 250.82,
      "duration_seconds": 2.65,
      "text": "So, raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.9,
      "end_seconds": 267.1,
      "duration_seconds": 4.2,
      "text": "Your oxygen is normal and your chest is clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.29,
      "end_seconds": 274.64,
      "duration_seconds": 2.35,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.45,
      "end_seconds": 295.29,
      "duration_seconds": 4.84,
      "text": "Let's book a COVID test to look into respiratory symptoms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 296.29,
      "end_seconds": 299.52,
      "duration_seconds": 3.23,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.95,
      "end_seconds": 316.14,
      "duration_seconds": 15.19,
      "text": "Rest, fluids, and stay home until you feel well and the fever has settled. The thing that would worry me is if you become breathless. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.0,
      "end_seconds": 321.11,
      "duration_seconds": 3.11,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.38,
      "end_seconds": 325.1,
      "duration_seconds": 2.72,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.94,
      "end_seconds": 329.62,
      "duration_seconds": 3.68,
      "text": "Ah, no, that's all. Thanks a lot."
    }
  ]
}