{
  "schema_version": "1.0",
  "encounter_id": "01049",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.23,
      "duration_seconds": 3.84,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.38,
      "end_seconds": 13.54,
      "duration_seconds": 4.16,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.43,
      "end_seconds": 26.86,
      "duration_seconds": 12.43,
      "text": "Hmm, I'm here because of a sore throat. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.97,
      "end_seconds": 29.92,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.89,
      "end_seconds": 37.44,
      "duration_seconds": 5.55,
      "text": "right, uh, I'm on rosuvastatin, 10 milligrams, at night"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.32,
      "end_seconds": 39.55,
      "duration_seconds": 1.23,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.33,
      "end_seconds": 47.47,
      "duration_seconds": 7.14,
      "text": "about about a month i'm, I'm on paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.69,
      "end_seconds": 55.93,
      "duration_seconds": 3.24,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.79,
      "end_seconds": 59.44,
      "duration_seconds": 2.65,
      "text": "probably about a week. Yeah"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.52,
      "end_seconds": 63.36,
      "duration_seconds": 2.84,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.65,
      "end_seconds": 68.42,
      "duration_seconds": 3.77,
      "text": "a three out of ten, I suppose"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.28,
      "end_seconds": 73.15,
      "duration_seconds": 3.87,
      "text": "Right, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.63,
      "end_seconds": 86.92,
      "duration_seconds": 12.29,
      "text": "when it starts I tend to get a headache as well ah, I've also been feeling tired, for two weeks"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.23,
      "end_seconds": 110.46,
      "duration_seconds": 5.23,
      "text": "let me check a few things any confusion, chest pain or breathlessness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.15,
      "end_seconds": 114.48,
      "duration_seconds": 3.33,
      "text": "Um, none of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.06,
      "end_seconds": 117.97,
      "duration_seconds": 1.91,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.08,
      "end_seconds": 124.83,
      "duration_seconds": 2.75,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.55,
      "end_seconds": 129.7,
      "duration_seconds": 3.15,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.53,
      "end_seconds": 134.11,
      "duration_seconds": 3.58,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.94,
      "end_seconds": 138.11,
      "duration_seconds": 2.17,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.49,
      "end_seconds": 145.28,
      "duration_seconds": 5.79,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.26,
      "end_seconds": 149.52,
      "duration_seconds": 2.26,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.02,
      "end_seconds": 154.9,
      "duration_seconds": 4.88,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.43,
      "end_seconds": 156.71,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 162.88,
      "duration_seconds": 4.28,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.08,
      "end_seconds": 176.58,
      "duration_seconds": 2.5,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.89,
      "end_seconds": 184.42,
      "duration_seconds": 6.53,
      "text": "High cholesterol, for about ten years i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.17,
      "end_seconds": 186.87,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.14,
      "end_seconds": 192.73,
      "duration_seconds": 4.59,
      "text": "I have an underactive thyroid, for two years"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.78,
      "end_seconds": 198.22,
      "duration_seconds": 4.44,
      "text": "I see, go ahead. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.22,
      "end_seconds": 206.42,
      "duration_seconds": 7.2,
      "text": "Yeah, um, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.79,
      "end_seconds": 211.91,
      "duration_seconds": 4.12,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 216.6,
      "duration_seconds": 2.67,
      "text": "Mm, no allergies at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.79,
      "end_seconds": 222.06,
      "duration_seconds": 4.27,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.48,
      "end_seconds": 231.83,
      "duration_seconds": 2.35,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.96,
      "end_seconds": 249.75,
      "duration_seconds": 6.79,
      "text": "Okay: temp 36.7 degrees, pressure 108 over 74, pulse 72, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.85,
      "end_seconds": 252.56,
      "duration_seconds": 1.71,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.32,
      "end_seconds": 255.78,
      "duration_seconds": 2.46,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.71,
      "end_seconds": 262.63,
      "duration_seconds": 3.92,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.08,
      "end_seconds": 266.67,
      "duration_seconds": 2.59,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.92,
      "end_seconds": 283.48,
      "duration_seconds": 3.56,
      "text": "Your oxygen is normal and your chest is clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.47,
      "end_seconds": 292.63,
      "duration_seconds": 3.16,
      "text": "so, good, you can sit up again"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.12,
      "end_seconds": 311.1,
      "duration_seconds": 5.98,
      "text": "right, here's what I'm thinking. It points towards a mild viral respiratory infection"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.97,
      "end_seconds": 316.6,
      "duration_seconds": 3.63,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.69,
      "end_seconds": 341.38,
      "duration_seconds": 22.69,
      "text": "It's reasonable to be concerned, but right now a mild viral respiratory infection is my leading thought, not anything worse. I'm sending you for a COVID test because of respiratory symptoms. Rest, fluids, and stay home until you feel well and the fever has settled."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.76,
      "end_seconds": 354.07,
      "duration_seconds": 12.31,
      "text": "I see, go ahead. One warning sign to remember: you become breathless. In that case don't wait. See me again if not improving in a week."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.16,
      "end_seconds": 358.64,
      "duration_seconds": 3.48,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.92,
      "end_seconds": 368.1,
      "duration_seconds": 8.18,
      "text": "can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.88,
      "end_seconds": 376.86,
      "duration_seconds": 6.98,
      "text": "So, I come back if not improving in a week. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.36,
      "end_seconds": 384.64,
      "duration_seconds": 6.28,
      "text": "Right, yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.15,
      "end_seconds": 388.5,
      "duration_seconds": 3.35,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.12,
      "end_seconds": 391.33,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}