{
  "schema_version": "1.0",
  "encounter_id": "01028",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 3.44,
      "duration_seconds": 2.75,
      "text": "hi doctor am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.19,
      "end_seconds": 9.62,
      "duration_seconds": 5.43,
      "text": "you're alright take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.22,
      "end_seconds": 20.7,
      "duration_seconds": 9.48,
      "text": "thank you for fitting us in, doctor. Doctor, it's a red itchy lump on my arm. That's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.8,
      "end_seconds": 25.19,
      "duration_seconds": 3.39,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.09,
      "end_seconds": 36.78,
      "duration_seconds": 9.69,
      "text": "I'm not sure when it began to be honest. Some weeks ago but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.51,
      "end_seconds": 40.0,
      "duration_seconds": 2.49,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.71,
      "end_seconds": 45.99,
      "duration_seconds": 3.28,
      "text": "It's, It's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.81,
      "end_seconds": 50.33,
      "duration_seconds": 2.52,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.02,
      "end_seconds": 56.34,
      "duration_seconds": 5.32,
      "text": "When it starts I tend to get mild swelling as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.04,
      "end_seconds": 59.81,
      "duration_seconds": 2.77,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.26,
      "end_seconds": 62.92,
      "duration_seconds": 1.66,
      "text": "Moderate, I'd say"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.43,
      "end_seconds": 67.88,
      "duration_seconds": 4.45,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.07,
      "end_seconds": 72.12,
      "duration_seconds": 3.05,
      "text": "High cholesterol, for nearly five years"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.17,
      "end_seconds": 84.57,
      "duration_seconds": 11.4,
      "text": "right so high cholesterol is already on your record we'll keep that in mind today do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.66,
      "end_seconds": 92.4,
      "duration_seconds": 5.74,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.92,
      "end_seconds": 97.07,
      "duration_seconds": 4.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.3,
      "end_seconds": 102.51,
      "duration_seconds": 4.21,
      "text": "I'm on simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.16,
      "end_seconds": 106.55,
      "duration_seconds": 3.39,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.4,
      "end_seconds": 119.66,
      "duration_seconds": 12.26,
      "text": "For about three months. An antihistamine, 10 milligrams, once a day. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.67,
      "end_seconds": 124.41,
      "duration_seconds": 3.74,
      "text": "so is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.83,
      "end_seconds": 128.6,
      "duration_seconds": 2.77,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.39,
      "end_seconds": 134.3,
      "duration_seconds": 4.91,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.03,
      "end_seconds": 147.22,
      "duration_seconds": 11.19,
      "text": "I gave up cigarettes last spring. My partner and our baby. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.31,
      "end_seconds": 151.98,
      "duration_seconds": 3.67,
      "text": "and what about breathing trouble, fever or dizziness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.06,
      "end_seconds": 159.47,
      "duration_seconds": 6.41,
      "text": "Actually uh I haven't had breathing trouble fever or dizziness no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.86,
      "end_seconds": 162.51,
      "duration_seconds": 1.65,
      "text": "Nothing like lip swelling?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.03,
      "end_seconds": 166.16,
      "duration_seconds": 2.13,
      "text": "No. No lip swelling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.68,
      "end_seconds": 170.37,
      "duration_seconds": 2.69,
      "text": "alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 174.29,
      "duration_seconds": 2.52,
      "text": "No that side's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.06,
      "end_seconds": 194.45,
      "duration_seconds": 3.39,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 205.59,
      "duration_seconds": 2.13,
      "text": "okay this won't take long.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.33,
      "end_seconds": 242.2,
      "duration_seconds": 17.87,
      "text": "okay: weight 91 kilos, pressure 128 over 70, pulse is 72 beats a minute and BMI works out to 29.4, height 176 centimetres, temperature is 36.5 degrees, SpO2 99 percent on room air"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.35,
      "end_seconds": 248.08,
      "duration_seconds": 3.73,
      "text": "let me look at the area I'll be gentle"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.88,
      "end_seconds": 253.63,
      "duration_seconds": 3.75,
      "text": "stay as you are for a a moment"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.66,
      "end_seconds": 269.74,
      "duration_seconds": 8.08,
      "text": "There is a small red lump with a central punctum and a little swelling around it and no spreading redness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.83,
      "end_seconds": 275.05,
      "duration_seconds": 3.22,
      "text": "so, thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.87,
      "end_seconds": 295.55,
      "duration_seconds": 11.68,
      "text": "Right, here's what I'm thinking. This looks most like a local insect bite reaction. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.98,
      "end_seconds": 337.05,
      "duration_seconds": 24.07,
      "text": "for this, hydrocortisone cream, 1%, twice a day, five days it's for bite reaction cool it with ice and avoid scratching please take the tablets with food so they don't upset your stomach see me again if the redness spreads right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.0,
      "end_seconds": 342.61,
      "duration_seconds": 3.61,
      "text": "Um no that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.95,
      "end_seconds": 345.82,
      "duration_seconds": 1.87,
      "text": "all the the best"
    }
  ]
}