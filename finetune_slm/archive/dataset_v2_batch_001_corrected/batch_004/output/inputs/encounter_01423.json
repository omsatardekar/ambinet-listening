{
  "schema_version": "1.0",
  "encounter_id": "01423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.18,
      "duration_seconds": 3.59,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.18,
      "end_seconds": 10.32,
      "duration_seconds": 5.14,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.49,
      "end_seconds": 22.45,
      "duration_seconds": 7.96,
      "text": "Sorry, what was I saying, so the thing is, I've got more breathless than usual."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.02,
      "end_seconds": 26.77,
      "duration_seconds": 3.75,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.78,
      "end_seconds": 31.2,
      "duration_seconds": 3.42,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.95,
      "end_seconds": 36.51,
      "duration_seconds": 4.56,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.55,
      "end_seconds": 60.02,
      "duration_seconds": 22.47,
      "text": "Mild, really. Only inhaler, and it's not much. Yes, walking. That makes it worse. And more sputum, a bit yellow as well, since last weekend. Okay, so as for more sputum, a bit yellow, severe, really. Oh, and a wheeze."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.08,
      "end_seconds": 68.07,
      "duration_seconds": 5.99,
      "text": "Have you had more breathless than usual before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.78,
      "end_seconds": 75.88,
      "duration_seconds": 6.1,
      "text": "Yeah, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.86,
      "end_seconds": 81.19,
      "duration_seconds": 3.33,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.3,
      "end_seconds": 89.12,
      "duration_seconds": 6.82,
      "text": "So, yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.75,
      "end_seconds": 93.53,
      "duration_seconds": 2.78,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.84,
      "end_seconds": 98.54,
      "duration_seconds": 3.7,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.09,
      "end_seconds": 102.99,
      "duration_seconds": 1.9,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.93,
      "end_seconds": 108.52,
      "duration_seconds": 3.59,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 119.1,
      "duration_seconds": 3.42,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.64,
      "end_seconds": 123.06,
      "duration_seconds": 3.42,
      "text": "I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.06,
      "end_seconds": 129.68,
      "duration_seconds": 4.62,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.64,
      "end_seconds": 135.53,
      "duration_seconds": 3.89,
      "text": "I've had COPD for five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.32,
      "end_seconds": 141.54,
      "duration_seconds": 5.22,
      "text": "Yes, COPD is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.67,
      "end_seconds": 161.03,
      "duration_seconds": 3.36,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.16,
      "end_seconds": 165.08,
      "duration_seconds": 2.92,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.86,
      "end_seconds": 170.49,
      "duration_seconds": 4.63,
      "text": "A few quick ones: chest pain, fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.21,
      "end_seconds": 182.07,
      "duration_seconds": 5.86,
      "text": "No chest pain, fever or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.45,
      "end_seconds": 189.78,
      "duration_seconds": 2.33,
      "text": "Has there been any swollen ankles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.65,
      "end_seconds": 194.65,
      "duration_seconds": 3.0,
      "text": "I haven't noticed any swollen ankles."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.47,
      "end_seconds": 197.61,
      "duration_seconds": 2.14,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.47,
      "end_seconds": 202.96,
      "duration_seconds": 3.49,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.47,
      "end_seconds": 206.25,
      "duration_seconds": 2.78,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.73,
      "end_seconds": 217.47,
      "duration_seconds": 2.74,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.73,
      "end_seconds": 236.01,
      "duration_seconds": 8.28,
      "text": "Okay: pulse 92, respiratory rate 26, temperature is 37.1 degrees. And blood pressure 135 over 74, saturation 90 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.72,
      "end_seconds": 241.37,
      "duration_seconds": 2.65,
      "text": "Right, may I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.6,
      "end_seconds": 243.95,
      "duration_seconds": 1.35,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.62,
      "end_seconds": 262.52,
      "duration_seconds": 5.9,
      "text": "There is wheeze at both bases and your oxygen is a little low."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.39,
      "end_seconds": 270.56,
      "duration_seconds": 2.17,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.54,
      "end_seconds": 297.19,
      "duration_seconds": 8.65,
      "text": "Putting it all together, it points towards a flare-up of COPD. A chest infection is also on my list."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.88,
      "end_seconds": 303.91,
      "duration_seconds": 5.03,
      "text": "So, uh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.23,
      "end_seconds": 322.65,
      "duration_seconds": 17.42,
      "text": "I understand the worry. At the moment I'd say it's a flare-up of COPD, and we'll know more once the a chest X-ray is back. I want a chest X-ray done, that's for COPD flare."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.71,
      "end_seconds": 325.22,
      "duration_seconds": 1.51,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.74,
      "end_seconds": 331.09,
      "duration_seconds": 5.35,
      "text": "A sputum sample is what I'd like next, for purulent sputum."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.54,
      "end_seconds": 334.97,
      "duration_seconds": 2.43,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.68,
      "end_seconds": 344.61,
      "duration_seconds": 7.93,
      "text": "Let's use doxycycline, 100 milligrams, once a day, five days. That should help with chest infection."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.39,
      "end_seconds": 347.6,
      "duration_seconds": 1.21,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.15,
      "end_seconds": 367.3,
      "duration_seconds": 19.15,
      "text": "The treatment will be prednisolone, 30 milligrams, once a day, five days. That should help with COPD flare. Use your inhaler regularly and get seen if you are not better in three days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.02,
      "end_seconds": 372.56,
      "duration_seconds": 4.54,
      "text": "Erm, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.2,
      "end_seconds": 374.95,
      "duration_seconds": 1.75,
      "text": "Have a good day."
    }
  ]
}