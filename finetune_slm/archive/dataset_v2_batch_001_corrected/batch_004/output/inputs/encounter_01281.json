{
  "schema_version": "1.0",
  "encounter_id": "01281",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.22,
      "duration_seconds": 4.24,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.27,
      "end_seconds": 12.25,
      "duration_seconds": 4.98,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 19.06,
      "duration_seconds": 5.88,
      "text": "Doctor, it's a missed period. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.48,
      "end_seconds": 27.79,
      "duration_seconds": 7.31,
      "text": "Has this been going on for long? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.08,
      "end_seconds": 31.22,
      "duration_seconds": 2.14,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.69,
      "end_seconds": 32.39,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.28,
      "end_seconds": 55.19,
      "duration_seconds": 3.91,
      "text": "Any severe pain, bleeding or vomiting everything at all?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.21,
      "end_seconds": 61.61,
      "duration_seconds": 5.4,
      "text": "I haven't had severe pain, bleeding or vomiting everything, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.34,
      "end_seconds": 65.57,
      "duration_seconds": 3.23,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.27,
      "end_seconds": 67.85,
      "duration_seconds": 1.58,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.6,
      "end_seconds": 72.58,
      "duration_seconds": 3.98,
      "text": "Okay, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.89,
      "end_seconds": 78.27,
      "duration_seconds": 4.38,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.61,
      "end_seconds": 86.02,
      "duration_seconds": 3.41,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.8,
      "end_seconds": 90.12,
      "duration_seconds": 2.32,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.73,
      "end_seconds": 96.05,
      "duration_seconds": 4.32,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.06,
      "end_seconds": 100.57,
      "duration_seconds": 3.51,
      "text": "A folic acid tablet, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.87,
      "end_seconds": 108.08,
      "duration_seconds": 2.21,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.29,
      "end_seconds": 114.03,
      "duration_seconds": 4.74,
      "text": "400 micrograms, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.66,
      "end_seconds": 117.42,
      "duration_seconds": 2.76,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.33,
      "end_seconds": 119.42,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.04,
      "end_seconds": 140.65,
      "duration_seconds": 3.61,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.92,
      "end_seconds": 148.03,
      "duration_seconds": 4.11,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.94,
      "end_seconds": 154.13,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.88,
      "end_seconds": 162.84,
      "duration_seconds": 2.96,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.13,
      "end_seconds": 184.46,
      "duration_seconds": 3.33,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.44,
      "end_seconds": 194.69,
      "duration_seconds": 2.25,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.33,
      "end_seconds": 225.84,
      "duration_seconds": 9.51,
      "text": "Okay: BP is 125 over 77, pulse 85, temp 36.4 degrees. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.73,
      "end_seconds": 232.24,
      "duration_seconds": 4.51,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.18,
      "end_seconds": 236.97,
      "duration_seconds": 2.79,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.05,
      "end_seconds": 254.42,
      "duration_seconds": 2.37,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.18,
      "end_seconds": 264.25,
      "duration_seconds": 1.07,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 283.43,
      "duration_seconds": 14.19,
      "text": "Please sit back down. Right, here's what I'm thinking. It fits best with a normal early pregnancy. Let's get a pregnancy test, for missed period. Keep taking folic acid and book in with the midwife."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.8,
      "end_seconds": 304.83,
      "duration_seconds": 21.03,
      "text": "Mm, okay. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. If the symptoms get worse, or you feel really unwell, please come to the emergency department. See me again in four weeks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.52,
      "end_seconds": 307.32,
      "duration_seconds": 1.8,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.29,
      "end_seconds": 311.48,
      "duration_seconds": 3.19,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.07,
      "end_seconds": 316.54,
      "duration_seconds": 3.47,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.4,
      "end_seconds": 319.61,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}