{
  "schema_version": "1.0",
  "encounter_id": "01068",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 5.42,
      "duration_seconds": 4.02,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 11.44,
      "duration_seconds": 4.22,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.76,
      "end_seconds": 17.64,
      "duration_seconds": 4.88,
      "text": "Oh, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.62,
      "end_seconds": 22.91,
      "duration_seconds": 3.29,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.53,
      "end_seconds": 30.78,
      "duration_seconds": 7.25,
      "text": "Mainly I've been waking at night with wheeze. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.27,
      "end_seconds": 36.17,
      "duration_seconds": 3.9,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.98,
      "end_seconds": 42.78,
      "duration_seconds": 4.8,
      "text": "Mm, uh, it's been ten days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.62,
      "end_seconds": 48.63,
      "duration_seconds": 5.01,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.73,
      "end_seconds": 60.63,
      "duration_seconds": 9.9,
      "text": "Oh, it feels mild to me. Inhaler helps a bit. Yes, cold air. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.18,
      "end_seconds": 63.71,
      "duration_seconds": 2.53,
      "text": "Alright, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.28,
      "end_seconds": 72.82,
      "duration_seconds": 8.54,
      "text": "So, when it starts I tend to get a tight chest after exercise as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.74,
      "end_seconds": 81.24,
      "duration_seconds": 3.5,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.62,
      "end_seconds": 96.96,
      "duration_seconds": 2.34,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.13,
      "end_seconds": 119.81,
      "duration_seconds": 8.68,
      "text": "Okay: blood pressure 118 over 68, temperature 36.6, pulse 72, respiratory rate 15, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.32,
      "end_seconds": 125.16,
      "duration_seconds": 3.84,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.55,
      "end_seconds": 127.85,
      "duration_seconds": 1.3,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.31,
      "end_seconds": 151.2,
      "duration_seconds": 5.89,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.87,
      "end_seconds": 170.68,
      "duration_seconds": 1.81,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.54,
      "end_seconds": 178.28,
      "duration_seconds": 1.74,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.45,
      "end_seconds": 191.5,
      "duration_seconds": 4.05,
      "text": "Have you noticed leg swelling, fever or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.81,
      "end_seconds": 202.16,
      "duration_seconds": 6.35,
      "text": "Ah, you know, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 206.71,
      "duration_seconds": 3.25,
      "text": "Alright, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.06,
      "end_seconds": 216.21,
      "duration_seconds": 4.15,
      "text": "Let me think, no, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.36,
      "end_seconds": 219.94,
      "duration_seconds": 2.58,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.58,
      "end_seconds": 223.72,
      "duration_seconds": 3.14,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.03,
      "end_seconds": 236.76,
      "duration_seconds": 2.73,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.62,
      "end_seconds": 256.36,
      "duration_seconds": 17.74,
      "text": "I used to drink heavily but I stopped four years ago. I gave up cigarettes last spring. I'm a hairdresser, on my feet all day. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.96,
      "end_seconds": 258.19,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.43,
      "end_seconds": 260.73,
      "duration_seconds": 1.3,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.49,
      "end_seconds": 264.49,
      "duration_seconds": 3.0,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.3,
      "end_seconds": 267.46,
      "duration_seconds": 1.16,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.06,
      "end_seconds": 272.1,
      "duration_seconds": 4.04,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.16,
      "end_seconds": 277.59,
      "duration_seconds": 4.43,
      "text": "Uh, uh, my son has asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.6,
      "end_seconds": 282.66,
      "duration_seconds": 4.06,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.44,
      "end_seconds": 286.8,
      "duration_seconds": 2.36,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.79,
      "end_seconds": 297.85,
      "duration_seconds": 9.06,
      "text": "Putting it all together, my working impression is poorly controlled asthma. Spirometry is what I'd like next, for asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.8,
      "end_seconds": 300.53,
      "duration_seconds": 1.73,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 321.55,
      "duration_seconds": 16.39,
      "text": "I'll start you on beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term. It's for asthma control. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.75,
      "end_seconds": 326.99,
      "duration_seconds": 4.24,
      "text": "Okay, so alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.29,
      "end_seconds": 353.23,
      "duration_seconds": 24.94,
      "text": "Use the spacer and rinse your mouth after the preventer. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like to see you again in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.92,
      "end_seconds": 359.12,
      "duration_seconds": 4.2,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.9,
      "end_seconds": 366.73,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}