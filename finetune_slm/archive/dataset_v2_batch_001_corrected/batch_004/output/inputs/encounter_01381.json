{
  "schema_version": "1.0",
  "encounter_id": "01381",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.54,
      "end_seconds": 7.48,
      "duration_seconds": 6.94,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.65,
      "end_seconds": 13.54,
      "duration_seconds": 4.89,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.82,
      "end_seconds": 29.19,
      "duration_seconds": 14.37,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. It's a tight band around my head, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 32.42,
      "end_seconds": 51.49,
      "duration_seconds": 19.07,
      "text": "Doctor, I've got the readings for you. BMI works out to 30.8, BP is 117 over 81, pulse is 81 beats a minute. Weight 85 kilos, oxygen saturation is 97 percent, temperature 36.8, height 166 centimetres, respiratory rate 15."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.13,
      "end_seconds": 56.62,
      "duration_seconds": 4.49,
      "text": "Good, thank you. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.12,
      "end_seconds": 61.61,
      "duration_seconds": 3.49,
      "text": "I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.39,
      "end_seconds": 67.35,
      "duration_seconds": 3.96,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.28,
      "end_seconds": 72.47,
      "duration_seconds": 4.19,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.53,
      "end_seconds": 76.92,
      "duration_seconds": 2.39,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.44,
      "end_seconds": 83.63,
      "duration_seconds": 5.19,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.08,
      "end_seconds": 96.32,
      "duration_seconds": 11.24,
      "text": "I'd give it a seven, out of ten. I'd say a few times a day. Long screen days and stress definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.91,
      "end_seconds": 101.35,
      "duration_seconds": 3.44,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 106.02,
      "duration_seconds": 2.73,
      "text": "It usually comes with tired eyes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.66,
      "end_seconds": 114.14,
      "duration_seconds": 7.48,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 114.24,
      "end_seconds": 119.57,
      "duration_seconds": 5.33,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.72,
      "end_seconds": 124.38,
      "duration_seconds": 3.66,
      "text": "Hmm, I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.14,
      "end_seconds": 130.04,
      "duration_seconds": 4.9,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 139.28,
      "duration_seconds": 7.37,
      "text": "The tired eyes? That's been for two months. I've also had a stiff neck."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.18,
      "end_seconds": 144.47,
      "duration_seconds": 3.29,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.1,
      "end_seconds": 147.37,
      "duration_seconds": 2.27,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.24,
      "end_seconds": 152.47,
      "duration_seconds": 4.23,
      "text": "And what about blurred vision or sensitivity to light?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.14,
      "end_seconds": 159.7,
      "duration_seconds": 5.56,
      "text": "I mean, no, no blurred vision or sensitivity to light."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.13,
      "end_seconds": 165.18,
      "duration_seconds": 4.05,
      "text": "Let me check a few things. Any weakness or sickness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.08,
      "end_seconds": 169.5,
      "duration_seconds": 2.42,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.71,
      "end_seconds": 173.49,
      "duration_seconds": 2.78,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.3,
      "end_seconds": 177.03,
      "duration_seconds": 1.73,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.16,
      "end_seconds": 185.33,
      "duration_seconds": 5.17,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.22,
      "end_seconds": 202.24,
      "duration_seconds": 15.02,
      "text": "I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.59,
      "end_seconds": 206.1,
      "duration_seconds": 2.51,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.93,
      "end_seconds": 217.3,
      "duration_seconds": 9.37,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 225.52,
      "duration_seconds": 6.9,
      "text": "Tell me about any past illnesses or ongoing conditions. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.55,
      "end_seconds": 229.89,
      "duration_seconds": 3.34,
      "text": "I have asthma, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.75,
      "end_seconds": 231.67,
      "duration_seconds": 0.92,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.16,
      "end_seconds": 242.61,
      "duration_seconds": 9.45,
      "text": "I've had an irregular heartbeat, yes. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.68,
      "end_seconds": 247.12,
      "duration_seconds": 2.44,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 248.84,
      "end_seconds": 257.99,
      "duration_seconds": 9.15,
      "text": "It's Foracort inhaler, twice a day, doctor. She is on paracetamol, 1 gram, when needed, I give it to her."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.63,
      "end_seconds": 262.02,
      "duration_seconds": 2.39,
      "text": "Metoprolol I don't take anymore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.49,
      "end_seconds": 266.44,
      "duration_seconds": 2.95,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.17,
      "end_seconds": 270.49,
      "duration_seconds": 2.32,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.32,
      "end_seconds": 275.44,
      "duration_seconds": 3.12,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 278.32,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.18,
      "end_seconds": 294.42,
      "duration_seconds": 5.24,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.9,
      "end_seconds": 301.26,
      "duration_seconds": 2.36,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.82,
      "end_seconds": 348.27,
      "duration_seconds": 30.45,
      "text": "Okay, so my impression is this: I can't pin this down yet. We're looking at tension-type headache or eye strain. I'll request an eye test, it'll help with eye strain. Take screen breaks every hour and try regular neck stretches. One warning sign to remember: the headache becomes sudden and severe. In that case don't wait. I'd like you back in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 350.05,
      "end_seconds": 353.97,
      "duration_seconds": 3.92,
      "text": "No, uh, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.51,
      "end_seconds": 357.3,
      "duration_seconds": 1.79,
      "text": "Okay, all the best."
    }
  ]
}