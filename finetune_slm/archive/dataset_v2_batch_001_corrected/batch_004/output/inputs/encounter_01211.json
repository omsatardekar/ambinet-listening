{
  "schema_version": "1.0",
  "encounter_id": "01211",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 6.26,
      "duration_seconds": 5.74,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.84,
      "end_seconds": 10.56,
      "duration_seconds": 3.72,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 22.65,
      "duration_seconds": 10.71,
      "text": "Well, I've been having a tight band around my head. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.2,
      "end_seconds": 27.02,
      "duration_seconds": 2.82,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.82,
      "end_seconds": 31.5,
      "duration_seconds": 2.68,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.3,
      "end_seconds": 35.15,
      "duration_seconds": 1.85,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.7,
      "end_seconds": 39.87,
      "duration_seconds": 3.17,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.23,
      "end_seconds": 44.58,
      "duration_seconds": 3.35,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.09,
      "end_seconds": 47.15,
      "duration_seconds": 2.06,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.86,
      "end_seconds": 51.53,
      "duration_seconds": 2.67,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.81,
      "end_seconds": 61.41,
      "duration_seconds": 8.6,
      "text": "It usually comes with a stiff neck. About stiff neck, I get some relief from stretching."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.78,
      "end_seconds": 68.2,
      "duration_seconds": 5.42,
      "text": "A few quick ones: blurred vision, sickness or sensitivity to light?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.99,
      "end_seconds": 72.85,
      "duration_seconds": 2.86,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.2,
      "end_seconds": 76.63,
      "duration_seconds": 2.43,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.58,
      "end_seconds": 79.31,
      "duration_seconds": 1.73,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 100.12,
      "duration_seconds": 3.63,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.4,
      "end_seconds": 103.81,
      "duration_seconds": 2.41,
      "text": "Not really, uh, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.96,
      "end_seconds": 108.73,
      "duration_seconds": 3.77,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.12,
      "end_seconds": 112.28,
      "duration_seconds": 2.16,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.56,
      "end_seconds": 117.54,
      "duration_seconds": 3.98,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.34,
      "end_seconds": 123.23,
      "duration_seconds": 3.89,
      "text": "Um, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.66,
      "end_seconds": 126.87,
      "duration_seconds": 2.21,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.85,
      "end_seconds": 131.34,
      "duration_seconds": 2.49,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.36,
      "end_seconds": 133.63,
      "duration_seconds": 1.27,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.25,
      "end_seconds": 139.6,
      "duration_seconds": 4.35,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.9,
      "end_seconds": 143.78,
      "duration_seconds": 2.88,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.55,
      "end_seconds": 155.01,
      "duration_seconds": 2.46,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.17,
      "end_seconds": 185.0,
      "duration_seconds": 13.83,
      "text": "Okay: height 162 centimetres, BMI works out to 31.2, respiratory rate 14, weight 82 kilos, blood pressure 111 over 73, pulse 83, temperature is 36.4 degrees, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.78,
      "end_seconds": 190.32,
      "duration_seconds": 3.54,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.29,
      "end_seconds": 194.68,
      "duration_seconds": 2.39,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.82,
      "end_seconds": 216.52,
      "duration_seconds": 5.7,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.47,
      "end_seconds": 229.84,
      "duration_seconds": 1.37,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.46,
      "end_seconds": 236.58,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.75,
      "end_seconds": 259.14,
      "duration_seconds": 10.39,
      "text": "Okay, thinking it through, this looks most like tension-type headache. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.96,
      "end_seconds": 262.84,
      "duration_seconds": 2.88,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.62,
      "end_seconds": 271.87,
      "duration_seconds": 8.25,
      "text": "Nothing I've seen today points to an emergency. It looks like tension-type headache, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.31,
      "end_seconds": 301.65,
      "duration_seconds": 11.34,
      "text": "We should do an eye test for eye strain. Take screen breaks every hour and try regular neck stretches. Let's plan a check in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.66,
      "end_seconds": 308.83,
      "duration_seconds": 3.17,
      "text": "Good, uh, I'll return then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.93,
      "end_seconds": 312.54,
      "duration_seconds": 2.61,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.96,
      "end_seconds": 321.52,
      "duration_seconds": 7.56,
      "text": "Sorry, uh, what was I saying, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.48,
      "end_seconds": 324.83,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}