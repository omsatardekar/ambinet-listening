      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.96,
      "end_seconds": 247.52,
      "duration_seconds": 6.56,
      "text": "Nothing I've seen today points to an emergency. It looks like fit to have travel vaccinations."
