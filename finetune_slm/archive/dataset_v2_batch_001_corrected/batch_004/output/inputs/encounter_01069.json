{
  "schema_version": "1.0",
  "encounter_id": "01069",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 6.46,
      "duration_seconds": 5.58,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.75,
      "end_seconds": 13.59,
      "duration_seconds": 5.84,
      "text": "Uh, uh, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.26,
      "end_seconds": 20.12,
      "duration_seconds": 5.86,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.75,
      "end_seconds": 22.02,
      "duration_seconds": 1.27,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.06,
      "end_seconds": 31.52,
      "duration_seconds": 7.46,
      "text": "Doctor, um, it's burning when I pass urine. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.07,
      "end_seconds": 38.15,
      "duration_seconds": 6.08,
      "text": "When was the first time you noticed it? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.73,
      "end_seconds": 40.84,
      "duration_seconds": 2.11,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 45.01,
      "duration_seconds": 2.53,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.64,
      "end_seconds": 51.26,
      "duration_seconds": 4.62,
      "text": "I, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.89,
      "end_seconds": 55.24,
      "duration_seconds": 3.35,
      "text": "Have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.82,
      "end_seconds": 59.13,
      "duration_seconds": 2.31,
      "text": "Yes, for one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.3,
      "end_seconds": 66.61,
      "duration_seconds": 6.31,
      "text": "Have you had burning when you pass urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.7,
      "end_seconds": 73.96,
      "duration_seconds": 6.26,
      "text": "I, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.94,
      "end_seconds": 79.88,
      "duration_seconds": 3.94,
      "text": "Okay, did you notice any blood in the urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.43,
      "end_seconds": 86.0,
      "duration_seconds": 5.57,
      "text": "So, no, I haven't had any blood in the urine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.73,
      "end_seconds": 94.25,
      "duration_seconds": 6.52,
      "text": "Let me check a few things. Any vaginal discharge, fever or back pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 99.98,
      "duration_seconds": 4.39,
      "text": "No, no vaginal discharge, fever or back pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.87,
      "end_seconds": 103.82,
      "duration_seconds": 2.95,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.23,
      "end_seconds": 106.71,
      "duration_seconds": 1.48,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.5,
      "end_seconds": 111.98,
      "duration_seconds": 3.48,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.68,
      "end_seconds": 115.62,
      "duration_seconds": 1.94,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.16,
      "end_seconds": 119.1,
      "duration_seconds": 2.94,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.4,
      "end_seconds": 130.74,
      "duration_seconds": 10.34,
      "text": "Lots of rice, lentils and some fruit. I work in accounts at a hospital. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.04,
      "end_seconds": 153.77,
      "duration_seconds": 4.73,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.48,
      "end_seconds": 165.05,
      "duration_seconds": 9.57,
      "text": "I had a reaction to naproxen when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.75,
      "end_seconds": 170.66,
      "duration_seconds": 3.91,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.88,
      "end_seconds": 178.84,
      "duration_seconds": 3.96,
      "text": "Hmm, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.45,
      "end_seconds": 188.8,
      "duration_seconds": 2.35,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.34,
      "end_seconds": 194.55,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.78,
      "end_seconds": 198.48,
      "duration_seconds": 2.7,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.25,
      "end_seconds": 210.48,
      "duration_seconds": 10.23,
      "text": "Okay, so I had a bunion operation six years ago. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.86,
      "end_seconds": 214.33,
      "duration_seconds": 2.47,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.4,
      "end_seconds": 226.82,
      "duration_seconds": 2.42,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.19,
      "end_seconds": 250.76,
      "duration_seconds": 9.57,
      "text": "Okay: temperature 36.8, blood pressure 112 over 68. And oxygen saturation is 98 percent, pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.66,
      "end_seconds": 255.35,
      "duration_seconds": 2.69,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.3,
      "end_seconds": 259.72,
      "duration_seconds": 2.42,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.93,
      "end_seconds": 266.01,
      "duration_seconds": 4.08,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.97,
      "end_seconds": 269.32,
      "duration_seconds": 1.35,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.44,
      "end_seconds": 290.15,
      "duration_seconds": 5.71,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.73,
      "end_seconds": 302.13,
      "duration_seconds": 7.4,
      "text": "That's the examination finished. Let me tell you where I've got to. I'd lean towards an uncomplicated urinary infection."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.47,
      "end_seconds": 305.77,
      "duration_seconds": 2.3,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.84,
      "end_seconds": 316.08,
      "duration_seconds": 9.24,
      "text": "It's reasonable to be concerned, but right now an uncomplicated urinary infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.57,
      "end_seconds": 345.14,
      "duration_seconds": 14.57,
      "text": "Let's book a urine dipstick to look into burning urine. We'll begin with nitrofurantoin, 100 milligrams, twice a day, three days. You take it by mouth. That's for urinary infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.61,
      "end_seconds": 352.13,
      "duration_seconds": 5.52,
      "text": "Actually, um, can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.77,
      "end_seconds": 355.98,
      "duration_seconds": 3.21,
      "text": "Drink plenty of water and avoid holding urine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.24,
      "end_seconds": 374.29,
      "duration_seconds": 18.05,
      "text": "Ah. Come back or go to emergency straight away if you get a fever or back pain. Please come and see me if it is not better in three days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.04,
      "end_seconds": 377.22,
      "duration_seconds": 2.18,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.25,
      "end_seconds": 380.49,
      "duration_seconds": 1.24,
      "text": "Goodbye for now."
    }
  ]
}