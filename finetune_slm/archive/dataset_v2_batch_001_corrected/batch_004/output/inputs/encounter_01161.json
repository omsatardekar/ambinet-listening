{
  "schema_version": "1.0",
  "encounter_id": "01161",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 3.34,
      "duration_seconds": 2.45,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.23,
      "end_seconds": 8.51,
      "duration_seconds": 4.28,
      "text": "Ah, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.44,
      "end_seconds": 13.47,
      "duration_seconds": 4.03,
      "text": "Erm, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.43,
      "end_seconds": 20.14,
      "duration_seconds": 5.71,
      "text": "That's fine, sit down. We'll go through it together. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.97,
      "end_seconds": 26.37,
      "duration_seconds": 5.4,
      "text": "We came because of a mole that has got bigger."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.04,
      "end_seconds": 30.01,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.91,
      "end_seconds": 41.13,
      "duration_seconds": 9.22,
      "text": "It's been going on for two months. Actually, and there's a darker edge as well, six months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.04,
      "end_seconds": 53.6,
      "duration_seconds": 8.56,
      "text": "Right, have you had a mole that has got bigger before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.45,
      "end_seconds": 61.82,
      "duration_seconds": 7.37,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.91,
      "end_seconds": 74.21,
      "duration_seconds": 4.3,
      "text": "Did you get bleeding, crusting or other new moles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.11,
      "end_seconds": 80.75,
      "duration_seconds": 5.64,
      "text": "I haven't had bleeding, crusting or other new moles, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.1,
      "end_seconds": 86.83,
      "duration_seconds": 4.73,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.97,
      "end_seconds": 90.41,
      "duration_seconds": 2.44,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.36,
      "end_seconds": 95.08,
      "duration_seconds": 2.72,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.32,
      "end_seconds": 98.46,
      "duration_seconds": 2.14,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.35,
      "end_seconds": 114.43,
      "duration_seconds": 6.08,
      "text": "Before we go further, any allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.93,
      "end_seconds": 121.06,
      "duration_seconds": 5.13,
      "text": "Right, um, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.75,
      "end_seconds": 124.51,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.84,
      "end_seconds": 138.37,
      "duration_seconds": 12.53,
      "text": "I grab fast food at lunch most days. I hardly move around during the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.46,
      "end_seconds": 142.42,
      "duration_seconds": 1.96,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.07,
      "end_seconds": 149.27,
      "duration_seconds": 6.2,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.08,
      "end_seconds": 154.42,
      "duration_seconds": 4.34,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.57,
      "end_seconds": 157.28,
      "duration_seconds": 1.71,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.15,
      "end_seconds": 161.03,
      "duration_seconds": 2.88,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.93,
      "end_seconds": 166.09,
      "duration_seconds": 3.16,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.96,
      "end_seconds": 169.99,
      "duration_seconds": 3.03,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 182.37,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.73,
      "end_seconds": 212.08,
      "duration_seconds": 11.35,
      "text": "Okay: weight 79 kilos, pulse 81. And temperature is 36.4 degrees, SpO2 99 percent on room air, height 155 centimetres, blood pressure 117 over 72."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.35,
      "end_seconds": 219.11,
      "duration_seconds": 4.76,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.29,
      "end_seconds": 221.54,
      "duration_seconds": 1.25,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.03,
      "end_seconds": 246.75,
      "duration_seconds": 6.72,
      "text": "The mole is seven millimetres with an irregular border and two shades of brown."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 266.44,
      "duration_seconds": 14.37,
      "text": "Please sit back down. Having listened and examined, I can't pin this down yet. We're looking at a mole with features that need specialist assessment or a benign naevus."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.39,
      "end_seconds": 270.43,
      "duration_seconds": 3.04,
      "text": "Ah, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.01,
      "end_seconds": 280.12,
      "duration_seconds": 8.11,
      "text": "Nothing I've seen today points to an emergency. It looks like a mole with features that need specialist assessment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.74,
      "end_seconds": 297.06,
      "duration_seconds": 7.32,
      "text": "Protect it from the sun until you are seen. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.14,
      "end_seconds": 301.79,
      "duration_seconds": 2.65,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}