{
  "schema_version": "1.0",
  "encounter_id": "01295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 5.32,
      "duration_seconds": 4.15,
      "text": "ah, morning, doctor. Lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 11.32,
      "duration_seconds": 4.49,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.82,
      "end_seconds": 17.54,
      "duration_seconds": 5.72,
      "text": "Mainly I've been losing weight without trying. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.06,
      "end_seconds": 20.13,
      "duration_seconds": 2.07,
      "text": "So, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.65,
      "end_seconds": 30.21,
      "duration_seconds": 9.56,
      "text": "So, um, it's been five days, I'm fairly sure. There's a cough that won't go as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.88,
      "end_seconds": 34.04,
      "duration_seconds": 3.16,
      "text": "any a lump in your neck as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.42,
      "end_seconds": 38.93,
      "duration_seconds": 1.51,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.19,
      "end_seconds": 43.66,
      "duration_seconds": 3.47,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.69,
      "end_seconds": 53.89,
      "duration_seconds": 3.2,
      "text": "okay, bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.02,
      "end_seconds": 79.13,
      "duration_seconds": 12.11,
      "text": "Okay: pulse is 71 beats a a minute, oxygen saturation is 98 percent. And temperature 36.5, BP is 116 over 79, respiratory rate 17."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.92,
      "end_seconds": 85.04,
      "duration_seconds": 4.12,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 88.9,
      "duration_seconds": 1.91,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.52,
      "end_seconds": 112.43,
      "duration_seconds": 6.91,
      "text": "There is a firm, painless lump in the left side of your neck about three centimetres."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.93,
      "end_seconds": 120.19,
      "duration_seconds": 2.26,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.81,
      "end_seconds": 135.02,
      "duration_seconds": 4.21,
      "text": "Did you get fever, bone pain or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.58,
      "end_seconds": 143.0,
      "duration_seconds": 6.42,
      "text": "Yeah, you know, no fever, bone pain or chest pain, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.63,
      "end_seconds": 150.34,
      "duration_seconds": 2.71,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.73,
      "end_seconds": 155.62,
      "duration_seconds": 3.89,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.66,
      "end_seconds": 159.61,
      "duration_seconds": 2.95,
      "text": "Right, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.82,
      "end_seconds": 165.22,
      "duration_seconds": 4.4,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.21,
      "end_seconds": 181.28,
      "duration_seconds": 3.07,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.3,
      "end_seconds": 194.6,
      "duration_seconds": 12.3,
      "text": "I'm a bus driver, so I sit for long hours. My husband and I live above the shop. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.66,
      "end_seconds": 209.24,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.9,
      "end_seconds": 225.78,
      "duration_seconds": 15.88,
      "text": "I've had an enlarged prostate for five years now. A neighbour of mine said I should see someone about it. I didn't want to make a fuss, um, you know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.36,
      "end_seconds": 235.28,
      "duration_seconds": 8.92,
      "text": "Right, right. Okay, I can see an enlarged prostate in your file as well. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.42,
      "end_seconds": 241.85,
      "duration_seconds": 5.43,
      "text": "I'm on tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.55,
      "end_seconds": 272.81,
      "duration_seconds": 30.26,
      "text": "Putting it all together, it's hard to say. Symptoms that need an urgent cancer work-up is one possibility and a chronic infection another, and I'd rather not commit yet. We should do an urgent chest X-ray for cough and weight loss. I am referring you on an urgent pathway, which means an appointment within two weeks. The rapid diagnostic clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.56,
      "end_seconds": 276.16,
      "duration_seconds": 2.6,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.29,
      "end_seconds": 287.46,
      "duration_seconds": 10.17,
      "text": "the thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Book a review after the scans"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.15,
      "end_seconds": 288.85,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.8,
      "end_seconds": 297.98,
      "duration_seconds": 7.18,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.57,
      "end_seconds": 303.95,
      "duration_seconds": 5.38,
      "text": "So, I come back after the scans. Is that right?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.18,
      "end_seconds": 310.68,
      "duration_seconds": 5.5,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.53,
      "end_seconds": 315.9,
      "duration_seconds": 3.37,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}