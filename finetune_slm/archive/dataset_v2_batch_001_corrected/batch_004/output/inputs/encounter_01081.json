{
  "schema_version": "1.0",
  "encounter_id": "01081",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.34,
      "duration_seconds": 3.57,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.85,
      "end_seconds": 9.94,
      "duration_seconds": 4.09,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.72,
      "end_seconds": 16.4,
      "duration_seconds": 5.68,
      "text": "I've been feeling well, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.57,
      "end_seconds": 23.57,
      "duration_seconds": 6.0,
      "text": "Alright, how long has it been like this? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.2,
      "end_seconds": 33.48,
      "duration_seconds": 9.28,
      "text": "It's been going on for one week. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.61,
      "end_seconds": 38.36,
      "duration_seconds": 3.75,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.05,
      "end_seconds": 47.1,
      "duration_seconds": 7.05,
      "text": "Actually, about a three out of ten. Oh, and slightly dry skin."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.37,
      "end_seconds": 51.44,
      "duration_seconds": 3.07,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.83,
      "end_seconds": 55.87,
      "duration_seconds": 3.04,
      "text": "It feels mild to to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.82,
      "end_seconds": 63.99,
      "duration_seconds": 2.17,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.72,
      "end_seconds": 70.84,
      "duration_seconds": 6.12,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.67,
      "end_seconds": 75.88,
      "duration_seconds": 1.21,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.53,
      "end_seconds": 80.87,
      "duration_seconds": 4.34,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.78,
      "end_seconds": 85.19,
      "duration_seconds": 2.41,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.18,
      "end_seconds": 90.67,
      "duration_seconds": 3.49,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.45,
      "end_seconds": 95.33,
      "duration_seconds": 3.88,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.38,
      "end_seconds": 102.25,
      "duration_seconds": 4.87,
      "text": "Let me think, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.93,
      "end_seconds": 123.61,
      "duration_seconds": 3.68,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.14,
      "end_seconds": 128.88,
      "duration_seconds": 3.74,
      "text": "I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.71,
      "end_seconds": 139.11,
      "duration_seconds": 9.4,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.57,
      "end_seconds": 145.31,
      "duration_seconds": 4.74,
      "text": "Thyronorm, 50 micrograms, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.96,
      "end_seconds": 150.14,
      "duration_seconds": 4.18,
      "text": "So, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.81,
      "end_seconds": 162.51,
      "duration_seconds": 9.7,
      "text": "Ah, yes, cat fur. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.65,
      "end_seconds": 178.22,
      "duration_seconds": 1.57,
      "text": "Nothing like weight change?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.87,
      "end_seconds": 181.04,
      "duration_seconds": 2.17,
      "text": "No weight change, thankfully."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.16,
      "end_seconds": 185.24,
      "duration_seconds": 3.08,
      "text": "So, any palpitations, constipation or feeling cold?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.9,
      "end_seconds": 193.24,
      "duration_seconds": 6.34,
      "text": "Right, I haven't had palpitations, constipation or feeling cold, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.3,
      "end_seconds": 196.53,
      "duration_seconds": 2.23,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.15,
      "end_seconds": 199.53,
      "duration_seconds": 2.38,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.31,
      "end_seconds": 204.26,
      "duration_seconds": 2.95,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.74,
      "end_seconds": 207.66,
      "duration_seconds": 1.92,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.34,
      "end_seconds": 212.96,
      "duration_seconds": 2.62,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.26,
      "end_seconds": 221.66,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.87,
      "end_seconds": 253.54,
      "duration_seconds": 11.67,
      "text": "okay: oxygen saturation is 97 percent, heart rate 86. And BP is 118 over 73, temperature is 36.9 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.2,
      "end_seconds": 259.68,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.16,
      "end_seconds": 264.9,
      "duration_seconds": 3.74,
      "text": "Okay, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.65,
      "end_seconds": 296.03,
      "duration_seconds": 12.38,
      "text": "Let me tell you where I've got to. The most likely explanation is well-controlled thyroid replacement. I'm sending you for a thyroid blood test because of annual review."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.42,
      "end_seconds": 299.88,
      "duration_seconds": 2.46,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.61,
      "end_seconds": 308.08,
      "duration_seconds": 4.47,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.48,
      "end_seconds": 316.87,
      "duration_seconds": 8.39,
      "text": "yes, carry on. I'll want another look in twelve months. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.45,
      "end_seconds": 323.55,
      "duration_seconds": 5.1,
      "text": "So, I come back in twelve months. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.4,
      "end_seconds": 328.72,
      "duration_seconds": 4.32,
      "text": "yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.16,
      "end_seconds": 335.85,
      "duration_seconds": 5.69,
      "text": "Sorry, what was I saying, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.24,
      "end_seconds": 338.5,
      "duration_seconds": 1.26,
      "text": "All the best."
    }
  ]
}