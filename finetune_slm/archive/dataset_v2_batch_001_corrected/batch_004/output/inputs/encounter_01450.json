{
  "schema_version": "1.0",
  "encounter_id": "01450",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 4.54,
      "duration_seconds": 3.16,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.95,
      "end_seconds": 7.13,
      "duration_seconds": 1.18,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 11.86,
      "duration_seconds": 3.42,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.15,
      "end_seconds": 15.87,
      "duration_seconds": 2.72,
      "text": "It's sore red eyes, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.56,
      "end_seconds": 19.95,
      "duration_seconds": 3.39,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.95,
      "end_seconds": 39.51,
      "duration_seconds": 17.56,
      "text": "Hmm, uh, it's been one week now. I'd rather not end up on lots of tablets if I can avoid it. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.69,
      "end_seconds": 43.75,
      "duration_seconds": 3.06,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.99,
      "end_seconds": 49.47,
      "duration_seconds": 4.48,
      "text": "Ah, um, about a eight out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.3,
      "end_seconds": 55.64,
      "duration_seconds": 4.34,
      "text": "What about sores in your mouth, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.15,
      "end_seconds": 96.22,
      "duration_seconds": 39.07,
      "text": "Yeah, I've had that since Friday. With sores in my mouth, I'd give it a seven, out of ten. Oh, um, and a fever. Sorry, uh, what was I saying, about fever, honestly, every other day. Erm, you know, I've also had a painful widespread rash, for four weeks. Actually, about painful widespread rash, mild, really. Honestly, on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.98,
      "end_seconds": 114.82,
      "duration_seconds": 3.84,
      "text": "Have you noticed new medicine or insect bite?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.16,
      "end_seconds": 119.96,
      "duration_seconds": 3.8,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.52,
      "end_seconds": 124.09,
      "duration_seconds": 3.57,
      "text": "Ah. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.09,
      "end_seconds": 129.78,
      "duration_seconds": 3.69,
      "text": "Ah, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.45,
      "end_seconds": 133.14,
      "duration_seconds": 2.69,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.3,
      "end_seconds": 136.61,
      "duration_seconds": 2.31,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.73,
      "end_seconds": 139.79,
      "duration_seconds": 2.06,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.67,
      "end_seconds": 154.87,
      "duration_seconds": 14.2,
      "text": "Uh, it's Tiotropium inhaler, once a day for my chest. A new antibiotic, 960 milligrams, maybe, twice a day for a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.54,
      "end_seconds": 158.64,
      "duration_seconds": 3.1,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.76,
      "end_seconds": 167.34,
      "duration_seconds": 7.58,
      "text": "No, it's at home. Before this I was on Glycomet; that's been stopped."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.32,
      "end_seconds": 177.23,
      "duration_seconds": 5.91,
      "text": "Has anyone ever diagnosed you with something? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.6,
      "end_seconds": 186.36,
      "duration_seconds": 4.76,
      "text": "Sorry, what was I saying, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.34,
      "end_seconds": 188.13,
      "duration_seconds": 0.79,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.91,
      "end_seconds": 191.74,
      "duration_seconds": 1.83,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 198.95,
      "duration_seconds": 6.11,
      "text": "Okay, I can see diabetes in your file as well. Do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.72,
      "end_seconds": 205.17,
      "duration_seconds": 4.45,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.9,
      "end_seconds": 207.24,
      "duration_seconds": 1.34,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.97,
      "end_seconds": 212.89,
      "duration_seconds": 3.92,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.7,
      "end_seconds": 216.04,
      "duration_seconds": 2.34,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.05,
      "end_seconds": 220.74,
      "duration_seconds": 2.69,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.42,
      "end_seconds": 232.68,
      "duration_seconds": 3.26,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.14,
      "end_seconds": 245.2,
      "duration_seconds": 7.06,
      "text": "My son has asthma. Uh, you know, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.39,
      "end_seconds": 260.2,
      "duration_seconds": 3.81,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.91,
      "end_seconds": 262.47,
      "duration_seconds": 1.56,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.13,
      "end_seconds": 266.13,
      "duration_seconds": 2.0,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.83,
      "end_seconds": 280.58,
      "duration_seconds": 2.75,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.19,
      "end_seconds": 305.98,
      "duration_seconds": 9.79,
      "text": "Okay: SpO2 98 percent on room air, height 176 centimetres. And BP is 114 over 79, weight 69 kilos, pulse 88."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.56,
      "end_seconds": 310.2,
      "duration_seconds": 3.64,
      "text": "Okay, so is that alright, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.79,
      "end_seconds": 314.13,
      "duration_seconds": 2.34,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.43,
      "end_seconds": 320.36,
      "duration_seconds": 3.93,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.38,
      "end_seconds": 322.36,
      "duration_seconds": 0.98,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.04,
      "end_seconds": 326.32,
      "duration_seconds": 2.28,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.52,
      "end_seconds": 345.91,
      "duration_seconds": 6.39,
      "text": "There are dusky red patches with blistering and the skin peels when I rub it lightly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.4,
      "end_seconds": 365.54,
      "duration_seconds": 14.14,
      "text": "You can sit up now. Let me tell you where I've got to. I can't pin this down yet. We're looking at a severe drug reaction of the skin or a viral rash."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.31,
      "end_seconds": 372.2,
      "duration_seconds": 4.89,
      "text": "Ah, you know, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.06,
      "end_seconds": 388.79,
      "duration_seconds": 14.73,
      "text": "I understand the worry. At the moment I'd say it's a severe drug reaction of the skin, and we'll know more once the blood tests is back. Let's get blood tests, for severe drug reaction."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.4,
      "end_seconds": 392.99,
      "duration_seconds": 3.59,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.53,
      "end_seconds": 406.81,
      "duration_seconds": 12.28,
      "text": "An urgent dermatology review is what I'd like next, for severe drug reaction. Stop the antibiotic now and I am sending you to hospital immediately."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.09,
      "end_seconds": 429.36,
      "duration_seconds": 22.27,
      "text": "Yes. I'm going to send a referral to the dermatology team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 430.68,
      "end_seconds": 433.99,
      "duration_seconds": 3.31,
      "text": "Mm, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.76,
      "end_seconds": 436.95,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}