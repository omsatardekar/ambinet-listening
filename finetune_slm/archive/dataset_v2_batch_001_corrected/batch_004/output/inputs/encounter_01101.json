{
  "schema_version": "1.0",
  "encounter_id": "01101",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 4.65,
      "duration_seconds": 3.32,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 11.82,
      "duration_seconds": 5.5,
      "text": "okay, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.77,
      "end_seconds": 19.23,
      "duration_seconds": 5.46,
      "text": "doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.24,
      "end_seconds": 23.84,
      "duration_seconds": 2.6,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.0,
      "end_seconds": 32.54,
      "duration_seconds": 7.54,
      "text": "It's severe lower back pain, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.56,
      "end_seconds": 37.89,
      "duration_seconds": 3.33,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.11,
      "end_seconds": 41.71,
      "duration_seconds": 2.6,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 43.43,
      "end_seconds": 47.06,
      "duration_seconds": 3.63,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.39,
      "end_seconds": 52.86,
      "duration_seconds": 4.47,
      "text": "okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.89,
      "end_seconds": 62.05,
      "duration_seconds": 7.16,
      "text": "yeah, roughly. And there's weakness in both legs as well, three weeks now"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.82,
      "end_seconds": 67.0,
      "duration_seconds": 3.18,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.56,
      "end_seconds": 71.83,
      "duration_seconds": 4.27,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.6,
      "end_seconds": 75.9,
      "duration_seconds": 3.3,
      "text": "Right, any trouble passing urine as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.68,
      "end_seconds": 78.74,
      "duration_seconds": 1.06,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 85.85,
      "duration_seconds": 2.19,
      "text": "Any recent fall or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.39,
      "end_seconds": 98.04,
      "duration_seconds": 10.65,
      "text": "No, no recent fall, no fever. I did have numbness between my legs at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.65,
      "end_seconds": 102.73,
      "duration_seconds": 4.08,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.35,
      "end_seconds": 105.42,
      "duration_seconds": 2.07,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.77,
      "end_seconds": 111.1,
      "duration_seconds": 4.33,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.59,
      "end_seconds": 118.81,
      "duration_seconds": 6.22,
      "text": "My father had bowel cancer. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.27,
      "end_seconds": 124.81,
      "duration_seconds": 4.54,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.18,
      "end_seconds": 129.94,
      "duration_seconds": 3.76,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 131.05,
      "end_seconds": 138.85,
      "duration_seconds": 7.8,
      "text": "Hold on, doctor, I think she reacted to erythromycin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.65,
      "end_seconds": 147.49,
      "duration_seconds": 2.84,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.75,
      "end_seconds": 154.5,
      "duration_seconds": 5.75,
      "text": "Fair enough, I'll write down both versions. Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.43,
      "end_seconds": 160.63,
      "duration_seconds": 4.2,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.63,
      "end_seconds": 169.3,
      "duration_seconds": 4.67,
      "text": "Right, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.36,
      "end_seconds": 174.63,
      "duration_seconds": 4.27,
      "text": "Escitalopram i take it 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.94,
      "end_seconds": 183.31,
      "duration_seconds": 7.37,
      "text": "it's a... um, I can't remember what it's called it's a small white one"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.04,
      "end_seconds": 186.56,
      "duration_seconds": 2.52,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.48,
      "end_seconds": 200.91,
      "duration_seconds": 12.43,
      "text": "For my sugar, I believe. My husband sets them out for me, I just take what I'm given. Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 205.6,
      "duration_seconds": 2.89,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.06,
      "end_seconds": 214.75,
      "duration_seconds": 5.69,
      "text": "I had my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.14,
      "end_seconds": 218.79,
      "duration_seconds": 2.65,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.49,
      "end_seconds": 235.67,
      "duration_seconds": 15.18,
      "text": "I've had high blood pressure, yes. I told my wife I'd come today. I'm not great at remembering details, so bear with me. I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.71,
      "end_seconds": 238.65,
      "duration_seconds": 0.94,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.64,
      "end_seconds": 242.89,
      "duration_seconds": 3.25,
      "text": "I've got diabetes. Yes, an underactive thyroid"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.48,
      "end_seconds": 261.11,
      "duration_seconds": 12.63,
      "text": "Mm-hmm. Alright, yes, high blood pressure and anxiety are known to us, good to have that clear. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.92,
      "end_seconds": 272.53,
      "duration_seconds": 2.61,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.25,
      "end_seconds": 288.46,
      "duration_seconds": 5.21,
      "text": "Okay: respiratory rate 17, blood pressure 117 over 76, heart rate 80."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.44,
      "end_seconds": 291.83,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.57,
      "end_seconds": 297.66,
      "duration_seconds": 4.09,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.3,
      "end_seconds": 303.92,
      "duration_seconds": 3.62,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.2,
      "end_seconds": 306.52,
      "duration_seconds": 1.32,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.8,
      "end_seconds": 321.89,
      "duration_seconds": 5.09,
      "text": "you have numbness in the saddle area and your leg strength is reduced"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.0,
      "end_seconds": 326.86,
      "duration_seconds": 1.86,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.2,
      "end_seconds": 350.33,
      "duration_seconds": 13.13,
      "text": "okay, so my impression is this: I'm honestly not certain yet it could be possible cauda equina syndrome needing an urgent scan, or it might be a large disc prolapse"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.29,
      "end_seconds": 373.64,
      "duration_seconds": 11.35,
      "text": "let's get an urgent MRI of the spine, for possible cauda equina i'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 375.49,
      "end_seconds": 378.59,
      "duration_seconds": 3.1,
      "text": "The earliest is Wednesday, 11:30 am."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.95,
      "end_seconds": 391.64,
      "duration_seconds": 11.69,
      "text": "You need to go to hospital now for an emergency scan. The thing that would worry me is if the numbness spreads. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.65,
      "end_seconds": 396.67,
      "duration_seconds": 1.02,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.5,
      "end_seconds": 402.23,
      "duration_seconds": 4.73,
      "text": "Let's plan a check straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.24,
      "end_seconds": 406.23,
      "duration_seconds": 2.99,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.2,
      "end_seconds": 409.43,
      "duration_seconds": 1.23,
      "text": "Look after yourself."
    }
  ]
}