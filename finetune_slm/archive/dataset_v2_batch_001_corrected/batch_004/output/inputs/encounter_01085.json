{
  "schema_version": "1.0",
  "encounter_id": "01085",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.84,
      "duration_seconds": 3.67,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 11.27,
      "duration_seconds": 5.02,
      "text": "yes come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.19,
      "end_seconds": 17.88,
      "duration_seconds": 5.69,
      "text": "Yeah, it's a racing heart. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 23.89,
      "duration_seconds": 4.31,
      "text": "right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.53,
      "end_seconds": 32.81,
      "duration_seconds": 8.28,
      "text": "Probably three weeks. Yeah. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.28,
      "end_seconds": 37.44,
      "duration_seconds": 3.16,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.53,
      "end_seconds": 39.65,
      "duration_seconds": 1.12,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.78,
      "end_seconds": 45.02,
      "duration_seconds": 2.24,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.75,
      "end_seconds": 64.33,
      "duration_seconds": 18.58,
      "text": "when it starts I tend to get shaky hands as well let me think as for shaky hands I'd call it mild uh I've been losing weight too since this morning"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.06,
      "end_seconds": 71.28,
      "duration_seconds": 5.22,
      "text": "Have you had a racing heart before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.34,
      "end_seconds": 78.96,
      "duration_seconds": 6.62,
      "text": "a bit, a couple of years ago. It settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.56,
      "end_seconds": 81.37,
      "duration_seconds": 1.81,
      "text": "What about chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 89.77,
      "duration_seconds": 3.64,
      "text": "no, I haven't had any chest pain"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.85,
      "end_seconds": 94.33,
      "duration_seconds": 3.48,
      "text": "So, any diarrhoea or neck pain at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.9,
      "end_seconds": 98.41,
      "duration_seconds": 2.51,
      "text": "No nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.86,
      "end_seconds": 102.32,
      "duration_seconds": 2.46,
      "text": "Okay is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.34,
      "end_seconds": 106.8,
      "duration_seconds": 2.46,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.6,
      "end_seconds": 112.07,
      "duration_seconds": 4.47,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.33,
      "end_seconds": 119.67,
      "duration_seconds": 3.34,
      "text": "Right uh no all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.07,
      "end_seconds": 125.69,
      "duration_seconds": 4.62,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.77,
      "end_seconds": 141.37,
      "duration_seconds": 13.6,
      "text": "I have thin bones. I didn't want to make a a fuss uh you know. I'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.66,
      "end_seconds": 144.41,
      "duration_seconds": 1.75,
      "text": "I see go ahead"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.58,
      "end_seconds": 151.12,
      "duration_seconds": 5.54,
      "text": "yeah, I have heart failure, for about ten years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.96,
      "end_seconds": 153.6,
      "duration_seconds": 1.64,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.73,
      "end_seconds": 159.76,
      "duration_seconds": 5.03,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.14,
      "end_seconds": 176.29,
      "duration_seconds": 3.15,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.22,
      "end_seconds": 180.84,
      "duration_seconds": 3.62,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.0,
      "end_seconds": 195.01,
      "duration_seconds": 4.01,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.0,
      "end_seconds": 205.36,
      "duration_seconds": 9.36,
      "text": "Yes, tramadol. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.22,
      "end_seconds": 210.0,
      "duration_seconds": 2.78,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.49,
      "end_seconds": 223.52,
      "duration_seconds": 12.03,
      "text": "Alendronate. I take it 70 milligrams, once a week for my bones. I, I take metoprolol, 50 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.6,
      "end_seconds": 226.38,
      "duration_seconds": 1.78,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.36,
      "end_seconds": 229.97,
      "duration_seconds": 1.61,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.41,
      "end_seconds": 232.37,
      "duration_seconds": 0.96,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.87,
      "end_seconds": 238.15,
      "duration_seconds": 4.28,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.8,
      "end_seconds": 240.48,
      "duration_seconds": 1.68,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.55,
      "end_seconds": 246.99,
      "duration_seconds": 5.44,
      "text": "I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.36,
      "end_seconds": 250.27,
      "duration_seconds": 1.91,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.19,
      "end_seconds": 254.85,
      "duration_seconds": 2.66,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.52,
      "end_seconds": 257.17,
      "duration_seconds": 1.65,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.24,
      "end_seconds": 262.92,
      "duration_seconds": 3.68,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.2,
      "end_seconds": 266.98,
      "duration_seconds": 2.78,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.48,
      "end_seconds": 280.8,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.07,
      "end_seconds": 311.17,
      "duration_seconds": 12.1,
      "text": "Okay: oxygen saturation is 97 percent, height 182 centimetres, pulse is 104 beats a a minute, blood pressure 132 over 86, weight 89 kilos."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.23,
      "end_seconds": 316.48,
      "duration_seconds": 3.25,
      "text": "okay, time for me to to examine you"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.19,
      "end_seconds": 319.53,
      "duration_seconds": 1.34,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.31,
      "end_seconds": 322.78,
      "duration_seconds": 1.47,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.54,
      "end_seconds": 337.11,
      "duration_seconds": 5.57,
      "text": "you have a fine tremor and your pulse is fast and regular"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.7,
      "end_seconds": 344.4,
      "duration_seconds": 1.7,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.28,
      "end_seconds": 359.91,
      "duration_seconds": 4.63,
      "text": "Taking everything into account I'd lean towards an overactive thyroid."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.48,
      "end_seconds": 363.44,
      "duration_seconds": 2.96,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.76,
      "end_seconds": 388.27,
      "duration_seconds": 23.51,
      "text": "Nothing I've seen today points to an emergency. It looks like an overactive thyroid, but I'd like to confirm. I'm sending you for an ECG cos of palpitations. Avoid caffeine while the heart is racing. Do get help quickly if the symptoms get worse. Please come and see me after the thyroid results. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.63,
      "end_seconds": 392.67,
      "duration_seconds": 3.04,
      "text": "So, alright, thanks, take care."
    }
  ]
}