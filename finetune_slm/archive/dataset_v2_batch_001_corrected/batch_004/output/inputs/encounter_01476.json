{
  "schema_version": "1.0",
  "encounter_id": "01476",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.93,
      "duration_seconds": 4.15,
      "text": "hmm, sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.69,
      "end_seconds": 10.09,
      "duration_seconds": 4.4,
      "text": "So, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.95,
      "end_seconds": 15.87,
      "duration_seconds": 4.92,
      "text": "doctor, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.55,
      "end_seconds": 21.65,
      "duration_seconds": 5.1,
      "text": "Okay, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.08,
      "end_seconds": 29.43,
      "duration_seconds": 6.35,
      "text": "It's no appetite, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.27,
      "end_seconds": 36.12,
      "duration_seconds": 2.85,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.17,
      "end_seconds": 50.45,
      "duration_seconds": 13.28,
      "text": "it's been going on for four weeks. Oh, and pain that started around my belly button then moved to the right. That's been about the same, two months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.28,
      "end_seconds": 62.04,
      "duration_seconds": 9.76,
      "text": "okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 77.36,
      "duration_seconds": 13.74,
      "text": "I notice it more with moving and and coughing. Honestly, once or twice a day. Oh, and a low fever. Ah, as for low fever, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.65,
      "end_seconds": 84.73,
      "duration_seconds": 6.08,
      "text": "Okay, have you had no appetite before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.35,
      "end_seconds": 92.94,
      "duration_seconds": 6.59,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.21,
      "end_seconds": 98.05,
      "duration_seconds": 3.84,
      "text": "so, a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 108.71,
      "duration_seconds": 10.06,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.91,
      "end_seconds": 112.26,
      "duration_seconds": 2.35,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.63,
      "end_seconds": 122.62,
      "duration_seconds": 4.99,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.35,
      "end_seconds": 127.89,
      "duration_seconds": 3.54,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.84,
      "end_seconds": 142.66,
      "duration_seconds": 12.82,
      "text": "Hmm, um, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.6,
      "end_seconds": 147.26,
      "duration_seconds": 3.66,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.2,
      "end_seconds": 158.52,
      "duration_seconds": 9.32,
      "text": "I'm on paracetamol, 650 milligrams, when needed. Clopidogrel. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.02,
      "end_seconds": 163.03,
      "duration_seconds": 3.01,
      "text": "how long has that been going on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.04,
      "end_seconds": 173.28,
      "duration_seconds": 9.24,
      "text": "Nearly five years now. I'm, I'm on something called simv... simvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.93,
      "end_seconds": 178.54,
      "duration_seconds": 4.61,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.87,
      "end_seconds": 184.53,
      "duration_seconds": 4.66,
      "text": "No, it's at home. Eltroxin I don't take anymore."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.88,
      "end_seconds": 189.01,
      "duration_seconds": 3.13,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.88,
      "end_seconds": 199.83,
      "duration_seconds": 8.95,
      "text": "My grandfather had a stroke. Sorry, you know, what was I saying, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.37,
      "end_seconds": 203.28,
      "duration_seconds": 2.91,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.27,
      "end_seconds": 209.56,
      "duration_seconds": 4.29,
      "text": "Arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.59,
      "end_seconds": 213.47,
      "duration_seconds": 1.88,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.24,
      "end_seconds": 231.48,
      "duration_seconds": 16.24,
      "text": "I've got gout. I've never really been one for hospitals. Okay, so I've had heart disease for nearly five years now. An underactive thyroid, for about ten years. Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.96,
      "end_seconds": 240.6,
      "duration_seconds": 7.64,
      "text": "Right, so arthritis in your knees and gout are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.07,
      "end_seconds": 254.34,
      "duration_seconds": 4.27,
      "text": "A few quick ones: urinary symptoms, diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.16,
      "end_seconds": 259.26,
      "duration_seconds": 3.1,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.63,
      "end_seconds": 262.96,
      "duration_seconds": 2.33,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.57,
      "end_seconds": 266.08,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.66,
      "end_seconds": 271.58,
      "duration_seconds": 3.92,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.52,
      "end_seconds": 274.91,
      "duration_seconds": 1.39,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.26,
      "end_seconds": 301.84,
      "duration_seconds": 13.58,
      "text": "going by what you've described, it points towards possible appendicitis. A urine infection is also on my list. Gynaecological pain is still possible. Let's get an ultrasound or CT scan, for possible appendicitis"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 302.48,
      "end_seconds": 306.98,
      "duration_seconds": 4.5,
      "text": "We have a slot Thursday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.22,
      "end_seconds": 312.04,
      "duration_seconds": 2.82,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.6,
      "end_seconds": 330.76,
      "duration_seconds": 17.16,
      "text": "I'm sending you for urgent blood tests because of abdominal pain. You need to go to hospital now and not eat or drink. The surgical team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.87,
      "end_seconds": 332.57,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.07,
      "end_seconds": 341.38,
      "duration_seconds": 8.31,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.15,
      "end_seconds": 343.94,
      "duration_seconds": 1.79,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.51,
      "end_seconds": 354.93,
      "duration_seconds": 9.42,
      "text": "do get help quickly if the symptoms get worse we'll catch up straight away that's all from me any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.98,
      "end_seconds": 359.25,
      "duration_seconds": 2.27,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.31,
      "end_seconds": 361.79,
      "duration_seconds": 1.48,
      "text": "look after yourself"
    }
  ]
}