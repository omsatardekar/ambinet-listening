{
  "schema_version": "1.0",
  "encounter_id": "01324",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 5.01,
      "duration_seconds": 4.21,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 11.57,
      "duration_seconds": 4.68,
      "text": "Right, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.5,
      "end_seconds": 19.43,
      "duration_seconds": 6.93,
      "text": "So the thing is, I've got tearing chest pain going to my back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.48,
      "end_seconds": 23.83,
      "duration_seconds": 3.35,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.91,
      "end_seconds": 30.38,
      "duration_seconds": 4.47,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.09,
      "end_seconds": 34.51,
      "duration_seconds": 2.42,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.27,
      "end_seconds": 37.33,
      "duration_seconds": 1.06,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.48,
      "end_seconds": 55.4,
      "duration_seconds": 2.92,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.49,
      "end_seconds": 66.46,
      "duration_seconds": 1.97,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.59,
      "end_seconds": 88.12,
      "duration_seconds": 11.53,
      "text": "Okay: BMI works out to 19.9, height 172 centimetres, pulse is 83 beats a minute. And pressure 156 over 103, weight 59 kilos."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.68,
      "end_seconds": 94.89,
      "duration_seconds": 4.21,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.27,
      "end_seconds": 97.54,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.33,
      "end_seconds": 120.72,
      "duration_seconds": 6.39,
      "text": "The blood pressure is different in your two arms and you are sweaty."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.76,
      "end_seconds": 130.3,
      "duration_seconds": 7.54,
      "text": "Okay, that's enough for me. Let me check a few things. Any leg swelling, fever or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.7,
      "end_seconds": 136.64,
      "duration_seconds": 4.94,
      "text": "Actually, no leg swelling, fever or cough, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.05,
      "end_seconds": 140.74,
      "duration_seconds": 2.69,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.76,
      "end_seconds": 143.85,
      "duration_seconds": 2.09,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.63,
      "end_seconds": 158.15,
      "duration_seconds": 3.52,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.68,
      "end_seconds": 174.3,
      "duration_seconds": 14.62,
      "text": "I have high blood pressure, for about ten years. I just want to get back to normal, really. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.87,
      "end_seconds": 193.49,
      "duration_seconds": 1.62,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.68,
      "end_seconds": 200.46,
      "duration_seconds": 2.78,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.25,
      "end_seconds": 207.47,
      "duration_seconds": 3.22,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.21,
      "end_seconds": 211.52,
      "duration_seconds": 3.31,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.52,
      "end_seconds": 214.41,
      "duration_seconds": 1.89,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.62,
      "end_seconds": 219.67,
      "duration_seconds": 4.05,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 224.09,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.98,
      "end_seconds": 230.47,
      "duration_seconds": 3.49,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 250.66,
      "duration_seconds": 2.77,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.13,
      "end_seconds": 253.67,
      "duration_seconds": 1.54,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.66,
      "end_seconds": 259.18,
      "duration_seconds": 3.52,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.78,
      "end_seconds": 265.5,
      "duration_seconds": 4.72,
      "text": "I take losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.72,
      "end_seconds": 296.49,
      "duration_seconds": 29.77,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be a possible tear in the main artery, or it might be a heart attack. Let's get an urgent CT scan of the chest and abdomen, for tearing chest pain. Do not move, I am calling an ambulance and you are going to a specialist centre. I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.24,
      "end_seconds": 301.17,
      "duration_seconds": 2.93,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}