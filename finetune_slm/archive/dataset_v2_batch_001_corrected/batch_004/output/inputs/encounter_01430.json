{
  "schema_version": "1.0",
  "encounter_id": "01430",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 7.81,
      "duration_seconds": 6.57,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.16,
      "end_seconds": 12.94,
      "duration_seconds": 3.78,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.4,
      "end_seconds": 22.0,
      "duration_seconds": 7.6,
      "text": "Uh, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.43,
      "end_seconds": 26.22,
      "duration_seconds": 2.79,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.3,
      "end_seconds": 39.19,
      "duration_seconds": 10.89,
      "text": "Oh, you know, it's been losing weight without trying, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.69,
      "end_seconds": 46.57,
      "duration_seconds": 6.88,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 46.67,
      "end_seconds": 53.41,
      "duration_seconds": 6.74,
      "text": "tell the doctor about the other thing, um, that's what worries me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.52,
      "end_seconds": 63.81,
      "duration_seconds": 9.29,
      "text": "I was getting to that! Oh, and a cough that won't go had that that since yesterday"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.27,
      "end_seconds": 68.05,
      "duration_seconds": 2.78,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.09,
      "end_seconds": 73.56,
      "duration_seconds": 3.47,
      "text": "Uh, it feels moderate to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 74.42,
      "end_seconds": 77.11,
      "duration_seconds": 2.69,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.52,
      "end_seconds": 91.27,
      "duration_seconds": 2.75,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.83,
      "end_seconds": 106.71,
      "duration_seconds": 2.88,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.31,
      "end_seconds": 130.34,
      "duration_seconds": 8.03,
      "text": "okay: temperature is 36.7 degrees, pressure 118 over 69, SpO2 99 percent on room air, heart rate 81."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.16,
      "end_seconds": 134.44,
      "duration_seconds": 2.28,
      "text": "is that that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.07,
      "end_seconds": 138.52,
      "duration_seconds": 3.45,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.97,
      "end_seconds": 142.98,
      "duration_seconds": 2.01,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.49,
      "end_seconds": 145.51,
      "duration_seconds": 1.02,
      "text": "of course"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.16,
      "end_seconds": 148.45,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.16,
      "end_seconds": 166.82,
      "duration_seconds": 6.66,
      "text": "There is a firm, painless lump in the left side of your neck about three centimetres."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.88,
      "end_seconds": 172.49,
      "duration_seconds": 3.61,
      "text": "All finished, thank you. Alright, any bone pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.15,
      "end_seconds": 181.79,
      "duration_seconds": 3.64,
      "text": "not that I've noticed, no bone pain"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.3,
      "end_seconds": 185.44,
      "duration_seconds": 3.14,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.73,
      "end_seconds": 200.2,
      "duration_seconds": 13.47,
      "text": "No, no fever, no chest pain. I did have drenching night sweats at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.55,
      "end_seconds": 205.34,
      "duration_seconds": 3.79,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.27,
      "end_seconds": 207.86,
      "duration_seconds": 1.59,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.83,
      "end_seconds": 211.29,
      "duration_seconds": 2.46,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.19,
      "end_seconds": 215.17,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.8,
      "end_seconds": 220.24,
      "duration_seconds": 3.44,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.58,
      "end_seconds": 224.07,
      "duration_seconds": 2.49,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.1,
      "end_seconds": 230.26,
      "duration_seconds": 4.16,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.09,
      "end_seconds": 244.08,
      "duration_seconds": 12.99,
      "text": "Anxiety, for about a year. A neighbour of mine said I should see someone about it. Low haemoglobin, for two years. Eczema, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.89,
      "end_seconds": 248.86,
      "duration_seconds": 3.97,
      "text": "alright, low haemoglobin, that matches what I have here"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.82,
      "end_seconds": 267.72,
      "duration_seconds": 4.9,
      "text": "Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.8,
      "end_seconds": 274.43,
      "duration_seconds": 5.63,
      "text": "No, you know, nothing as far as I know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.45,
      "end_seconds": 278.84,
      "duration_seconds": 2.39,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.77,
      "end_seconds": 283.88,
      "duration_seconds": 4.11,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.45,
      "end_seconds": 291.65,
      "duration_seconds": 7.2,
      "text": "do you take any prescribed or over-the-counter medicines? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.42,
      "end_seconds": 297.79,
      "duration_seconds": 5.37,
      "text": "Escitalopram, 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.77,
      "end_seconds": 302.77,
      "duration_seconds": 3.0,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.87,
      "end_seconds": 314.3,
      "duration_seconds": 9.43,
      "text": "No, it's at home. Iron tablets. I take it once a day. It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.77,
      "end_seconds": 326.48,
      "duration_seconds": 10.71,
      "text": "Taking everything into account, the most likely explanation is symptoms that need an urgent cancer work-up. Another possibility is a chronic infection. Another possibility is a lymphoma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.88,
      "end_seconds": 330.07,
      "duration_seconds": 2.19,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.44,
      "end_seconds": 354.32,
      "duration_seconds": 22.88,
      "text": "Nothing I've seen today points to an emergency. It looks like symptoms that need an urgent cancer work-up. Let's get you seen by the rapid diagnostic clinic, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.59,
      "end_seconds": 359.24,
      "duration_seconds": 3.65,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.98,
      "end_seconds": 363.55,
      "duration_seconds": 2.57,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.15,
      "end_seconds": 369.67,
      "duration_seconds": 4.52,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}