{
  "schema_version": "1.0",
  "encounter_id": "01254",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 6.18,
      "duration_seconds": 5.29,
      "text": "hi, doctor, I came as soon as they called me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 12.38,
      "duration_seconds": 4.13,
      "text": "not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.41,
      "end_seconds": 19.46,
      "duration_seconds": 6.05,
      "text": "Yeah, it's a high fever. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.35,
      "end_seconds": 26.08,
      "duration_seconds": 1.73,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.71,
      "end_seconds": 30.6,
      "duration_seconds": 3.89,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.24,
      "end_seconds": 34.78,
      "duration_seconds": 2.54,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.73,
      "end_seconds": 40.3,
      "duration_seconds": 3.57,
      "text": "I'd say once or twice a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.16,
      "end_seconds": 44.8,
      "duration_seconds": 3.64,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.64,
      "end_seconds": 50.21,
      "duration_seconds": 3.57,
      "text": "It's thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.9,
      "end_seconds": 54.74,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.39,
      "end_seconds": 58.55,
      "duration_seconds": 2.16,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.5,
      "end_seconds": 63.93,
      "duration_seconds": 3.43,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.29,
      "end_seconds": 70.34,
      "duration_seconds": 5.05,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.33,
      "end_seconds": 72.97,
      "duration_seconds": 1.64,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.67,
      "end_seconds": 79.19,
      "duration_seconds": 4.52,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.59,
      "end_seconds": 99.28,
      "duration_seconds": 2.69,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.2,
      "end_seconds": 102.27,
      "duration_seconds": 2.07,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.14,
      "end_seconds": 106.07,
      "duration_seconds": 2.93,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.16,
      "end_seconds": 110.11,
      "duration_seconds": 1.95,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.54,
      "end_seconds": 115.45,
      "duration_seconds": 3.91,
      "text": "Did you get cough or recent head injury?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.01,
      "end_seconds": 119.94,
      "duration_seconds": 2.93,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.5,
      "end_seconds": 122.21,
      "duration_seconds": 1.71,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.69,
      "end_seconds": 125.51,
      "duration_seconds": 1.82,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.54,
      "end_seconds": 130.46,
      "duration_seconds": 2.92,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 145.62,
      "duration_seconds": 2.03,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.27,
      "end_seconds": 172.22,
      "duration_seconds": 5.95,
      "text": "Okay: oxygen saturation is 98 percent, pulse 96, pressure 118 over 80."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.21,
      "end_seconds": 175.78,
      "duration_seconds": 2.57,
      "text": "Well, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.41,
      "end_seconds": 178.46,
      "duration_seconds": 2.05,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.48,
      "end_seconds": 183.63,
      "duration_seconds": 4.15,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.59,
      "end_seconds": 186.41,
      "duration_seconds": 1.82,
      "text": "does that that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.36,
      "end_seconds": 213.0,
      "duration_seconds": 7.64,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.72,
      "end_seconds": 220.51,
      "duration_seconds": 1.79,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.71,
      "end_seconds": 251.0,
      "duration_seconds": 13.29,
      "text": "okay, so my impression is this: It fits best with possible bacterial meningitis. The reason I say that is that your story and my examination fit together"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.64,
      "end_seconds": 255.96,
      "duration_seconds": 3.32,
      "text": "What are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.13,
      "end_seconds": 264.14,
      "duration_seconds": 7.01,
      "text": "I can't promise yet, but most people with possible bacterial meningitis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.1,
      "end_seconds": 283.46,
      "duration_seconds": 3.36,
      "text": "I'm gonna order blood cultures, for possible meningitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.21,
      "end_seconds": 286.64,
      "duration_seconds": 1.43,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.38,
      "end_seconds": 302.98,
      "duration_seconds": 15.6,
      "text": "For this, benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. Call an ambulance now, this is an emergency. See me again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.18,
      "end_seconds": 306.39,
      "duration_seconds": 2.21,
      "text": "Thank you, that's helpful."
    }
  ]
}