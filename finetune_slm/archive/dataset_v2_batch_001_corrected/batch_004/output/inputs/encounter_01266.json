{
  "schema_version": "1.0",
  "encounter_id": "01266",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.67,
      "duration_seconds": 4.03,
      "text": "hello, doctor i think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 10.35,
      "duration_seconds": 4.32,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.9,
      "end_seconds": 16.79,
      "duration_seconds": 2.89,
      "text": "I've been getting breathless lying flat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.46,
      "end_seconds": 21.9,
      "duration_seconds": 3.44,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.35,
      "end_seconds": 26.23,
      "duration_seconds": 2.88,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.01,
      "end_seconds": 29.94,
      "duration_seconds": 2.93,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.9,
      "end_seconds": 34.16,
      "duration_seconds": 3.26,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.87,
      "end_seconds": 39.75,
      "duration_seconds": 2.88,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.01,
      "end_seconds": 43.42,
      "duration_seconds": 2.41,
      "text": "Extra pillows helps a bit"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.46,
      "end_seconds": 47.54,
      "duration_seconds": 2.08,
      "text": "Have you had swollen ankles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.05,
      "end_seconds": 52.27,
      "duration_seconds": 3.22,
      "text": "Yes, about the same, one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.12,
      "end_seconds": 55.75,
      "duration_seconds": 2.63,
      "text": "Okay, how frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.74,
      "end_seconds": 60.27,
      "duration_seconds": 2.53,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.8,
      "end_seconds": 65.94,
      "duration_seconds": 5.14,
      "text": "have you been getting breathless lying flat at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.67,
      "end_seconds": 72.92,
      "duration_seconds": 6.25,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.98,
      "end_seconds": 77.73,
      "duration_seconds": 3.75,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.46,
      "end_seconds": 80.74,
      "duration_seconds": 1.28,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.21,
      "end_seconds": 94.11,
      "duration_seconds": 5.9,
      "text": "there is pitting swelling of both ankles and a few crackles at the lung bases"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.56,
      "end_seconds": 100.9,
      "duration_seconds": 2.34,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.23,
      "end_seconds": 113.68,
      "duration_seconds": 3.45,
      "text": "Alright, did you get chest pain or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.35,
      "end_seconds": 117.42,
      "duration_seconds": 3.07,
      "text": "So, no, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.28,
      "end_seconds": 119.6,
      "duration_seconds": 1.32,
      "text": "How about palpitations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.28,
      "end_seconds": 123.43,
      "duration_seconds": 2.15,
      "text": "No, none, no palpitations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.17,
      "end_seconds": 127.74,
      "duration_seconds": 2.57,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.41,
      "end_seconds": 131.79,
      "duration_seconds": 3.38,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.4,
      "end_seconds": 143.1,
      "duration_seconds": 3.7,
      "text": "So, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.98,
      "end_seconds": 151.17,
      "duration_seconds": 3.19,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.23,
      "end_seconds": 154.57,
      "duration_seconds": 2.34,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.11,
      "end_seconds": 162.57,
      "duration_seconds": 6.46,
      "text": "Uh, uh, I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.54,
      "end_seconds": 166.5,
      "duration_seconds": 1.96,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.46,
      "end_seconds": 172.38,
      "duration_seconds": 4.92,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.82,
      "end_seconds": 174.69,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.19,
      "end_seconds": 177.79,
      "duration_seconds": 2.6,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.61,
      "end_seconds": 180.62,
      "duration_seconds": 2.01,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.29,
      "end_seconds": 186.27,
      "duration_seconds": 3.98,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.1,
      "end_seconds": 191.43,
      "duration_seconds": 3.33,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.19,
      "end_seconds": 196.11,
      "duration_seconds": 3.92,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 204.11,
      "duration_seconds": 2.35,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.2,
      "end_seconds": 213.04,
      "duration_seconds": 3.84,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.3,
      "end_seconds": 217.68,
      "duration_seconds": 3.38,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.95,
      "end_seconds": 223.96,
      "duration_seconds": 5.01,
      "text": "Carvedilol. I take it 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.5,
      "end_seconds": 251.18,
      "duration_seconds": 8.68,
      "text": "Let me tell you where I've got to. The most likely explanation is heart failure with some fluid on board."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.96,
      "end_seconds": 254.55,
      "duration_seconds": 1.59,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.37,
      "end_seconds": 290.46,
      "duration_seconds": 35.09,
      "text": "I understand the worry at the moment I'd say it's heart failure with some fluid on board, and we'll know more once the an echocardiogram is back. an echocardiogram is what I'd like next, for heart failure we'll begin with furosemide, 40 milligrams, once a day in the morning, long term you take it by mouth that's for fluid retention weigh yourself every morning and tell us if you gain two kilos in three days"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 306.14,
      "duration_seconds": 11.59,
      "text": "I'll also refer you to the heart failure nurse. Come back in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.1,
      "end_seconds": 310.31,
      "duration_seconds": 2.21,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.17,
      "end_seconds": 316.54,
      "duration_seconds": 1.37,
      "text": "Look after yourself."
    }
  ]
}