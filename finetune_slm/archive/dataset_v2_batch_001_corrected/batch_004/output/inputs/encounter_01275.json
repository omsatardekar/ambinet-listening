{
  "schema_version": "1.0",
  "encounter_id": "01275",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.47,
      "duration_seconds": 4.62,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.48,
      "end_seconds": 11.26,
      "duration_seconds": 3.78,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.7,
      "end_seconds": 20.15,
      "duration_seconds": 7.45,
      "text": "Doctor, it's a red warm patch on my shin. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.44,
      "end_seconds": 27.8,
      "duration_seconds": 3.36,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.99,
      "end_seconds": 33.86,
      "duration_seconds": 4.87,
      "text": "Around one week... no wait, it's more like two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 37.92,
      "duration_seconds": 3.33,
      "text": "Alright, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.24,
      "end_seconds": 42.18,
      "duration_seconds": 2.94,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.25,
      "end_seconds": 54.62,
      "duration_seconds": 5.37,
      "text": "Have you had any rash elsewhere, shortness of breath or cut?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.54,
      "end_seconds": 63.95,
      "duration_seconds": 8.41,
      "text": "Sorry, what was I saying, I haven't had rash elsewhere, shortness of breath or cut, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.16,
      "end_seconds": 71.26,
      "duration_seconds": 4.1,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.92,
      "end_seconds": 75.31,
      "duration_seconds": 2.39,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.79,
      "end_seconds": 85.06,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.65,
      "end_seconds": 90.57,
      "duration_seconds": 3.92,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.29,
      "end_seconds": 97.86,
      "duration_seconds": 3.57,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.69,
      "end_seconds": 102.26,
      "duration_seconds": 3.57,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.83,
      "end_seconds": 105.55,
      "duration_seconds": 2.72,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.11,
      "end_seconds": 113.76,
      "duration_seconds": 3.65,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.95,
      "end_seconds": 134.9,
      "duration_seconds": 2.95,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.8,
      "end_seconds": 139.33,
      "duration_seconds": 3.53,
      "text": "Arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.85,
      "end_seconds": 147.28,
      "duration_seconds": 7.43,
      "text": "Mm-hmm. Alright, arthritis in your knees, that matches what I have here. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.19,
      "end_seconds": 159.19,
      "duration_seconds": 6.0,
      "text": "I take diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.28,
      "end_seconds": 175.26,
      "duration_seconds": 3.98,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.36,
      "end_seconds": 178.83,
      "duration_seconds": 2.47,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.57,
      "end_seconds": 180.74,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.09,
      "end_seconds": 183.85,
      "duration_seconds": 1.76,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.9,
      "end_seconds": 190.65,
      "duration_seconds": 2.75,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.48,
      "end_seconds": 200.42,
      "duration_seconds": 2.94,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.72,
      "end_seconds": 220.73,
      "duration_seconds": 7.01,
      "text": "Okay: pulse 107, BP is 107 over 66, temp 39.0 degrees, oxygen saturation is 95 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.64,
      "end_seconds": 224.7,
      "duration_seconds": 2.06,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.31,
      "end_seconds": 228.01,
      "duration_seconds": 2.7,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.21,
      "end_seconds": 231.28,
      "duration_seconds": 2.07,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.34,
      "end_seconds": 236.41,
      "duration_seconds": 1.07,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.16,
      "end_seconds": 240.06,
      "duration_seconds": 1.9,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.48,
      "end_seconds": 256.42,
      "duration_seconds": 8.94,
      "text": "The shin is red, warm and tender with a clear edge, and I've marked it with a pen."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.76,
      "end_seconds": 274.7,
      "duration_seconds": 13.94,
      "text": "You can relax now. So where does that leave us? I think we're dealing with cellulitis of the leg at this stage. I'm going to order blood tests, for cellulitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.43,
      "end_seconds": 277.54,
      "duration_seconds": 2.11,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.61,
      "end_seconds": 299.83,
      "duration_seconds": 21.22,
      "text": "What I'm giving you is flucloxacillin, 500 milligrams, four times a day, seven days. It's for cellulitis. It's a commonly used medicine and most people tolerate it well. Keep the leg raised and come back if the redness goes past the pen line. I'd like you back in two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.43,
      "end_seconds": 304.32,
      "duration_seconds": 2.89,
      "text": "Um, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.31,
      "end_seconds": 309.67,
      "duration_seconds": 4.36,
      "text": "Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.17,
      "end_seconds": 314.42,
      "duration_seconds": 3.25,
      "text": "I, I think I understand everything. Thanks."
    }
  ]
}