{
  "schema_version": "1.0",
  "encounter_id": "01063",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 7.05,
      "duration_seconds": 6.13,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.75,
      "end_seconds": 11.97,
      "duration_seconds": 4.22,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.56,
      "end_seconds": 18.97,
      "duration_seconds": 5.41,
      "text": "Mainly I've been getting breathless lying flat. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.66,
      "end_seconds": 21.88,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.47,
      "end_seconds": 25.66,
      "duration_seconds": 3.19,
      "text": "Actually, for five days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.61,
      "end_seconds": 35.64,
      "duration_seconds": 8.03,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.87,
      "end_seconds": 45.07,
      "duration_seconds": 8.2,
      "text": "it's worse with lying flat. Only extra pillows, and it's not much. I'd say severe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.05,
      "end_seconds": 50.6,
      "duration_seconds": 3.55,
      "text": "shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.86,
      "end_seconds": 64.06,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.01,
      "end_seconds": 81.13,
      "duration_seconds": 5.12,
      "text": "Okay: pulse is 92 beats a minute, BP is 134 over 73."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.69,
      "end_seconds": 84.79,
      "duration_seconds": 2.1,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.35,
      "end_seconds": 88.93,
      "duration_seconds": 2.58,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.59,
      "end_seconds": 110.53,
      "duration_seconds": 6.94,
      "text": "There is pitting swelling of both ankles and a few crackles at the lung bases."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.07,
      "end_seconds": 119.71,
      "duration_seconds": 6.64,
      "text": "Okay, please sit back down. Did you get fainting, palpitations or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.75,
      "end_seconds": 122.9,
      "duration_seconds": 2.15,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.76,
      "end_seconds": 126.64,
      "duration_seconds": 2.88,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.32,
      "end_seconds": 129.44,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.54,
      "end_seconds": 144.97,
      "duration_seconds": 2.43,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.74,
      "end_seconds": 149.55,
      "duration_seconds": 2.81,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.54,
      "end_seconds": 154.63,
      "duration_seconds": 3.09,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.41,
      "end_seconds": 162.08,
      "duration_seconds": 2.67,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.74,
      "end_seconds": 175.26,
      "duration_seconds": 2.52,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.33,
      "end_seconds": 182.0,
      "duration_seconds": 4.67,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.33,
      "end_seconds": 188.91,
      "duration_seconds": 5.58,
      "text": "Let's run through your medicines. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.13,
      "end_seconds": 195.48,
      "duration_seconds": 5.35,
      "text": "Clopidogrel, 75 milligrams, once a day for the stent"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.54,
      "end_seconds": 198.97,
      "duration_seconds": 2.43,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.51,
      "end_seconds": 203.33,
      "duration_seconds": 3.82,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.11,
      "end_seconds": 206.33,
      "duration_seconds": 2.22,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.75,
      "end_seconds": 212.32,
      "duration_seconds": 4.57,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.1,
      "end_seconds": 230.88,
      "duration_seconds": 2.78,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.35,
      "end_seconds": 234.35,
      "duration_seconds": 2.0,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.25,
      "end_seconds": 243.0,
      "duration_seconds": 6.75,
      "text": "putting it all together, it points towards heart failure with some fluid on board"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.56,
      "end_seconds": 246.7,
      "duration_seconds": 2.14,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.13,
      "end_seconds": 266.99,
      "duration_seconds": 18.86,
      "text": "Nothing I've seen today points to an emergency. It looks like heart failure with some fluid on board, but I'd like to confirm. Just to be sure I understood. You've been getting breathless lying flat for five days, severe, and no chest pain or palpitations."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.86,
      "end_seconds": 270.74,
      "duration_seconds": 2.88,
      "text": "mm, yes, you've got it"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.92,
      "end_seconds": 307.82,
      "duration_seconds": 27.9,
      "text": "let's book blood tests to look into heart failure. We'll begin with furosemide, 40 milligrams, once a day in the morning, long term. You take it by mouth. That should help with fluid retention. Weigh yourself every morning and tell us if you gain two kilos in three days. Please come and see me in two weeks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.25,
      "end_seconds": 310.89,
      "duration_seconds": 1.64,
      "text": "yes, that's manageable"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.7,
      "end_seconds": 315.22,
      "duration_seconds": 2.52,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.36,
      "end_seconds": 324.64,
      "duration_seconds": 3.28,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.57,
      "end_seconds": 326.91,
      "duration_seconds": 1.34,
      "text": "goodbye for now"
    }
  ]
}