{
  "schema_version": "1.0",
  "encounter_id": "01384",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 6.02,
      "duration_seconds": 5.52,
      "text": "Okay, so hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 11.09,
      "duration_seconds": 4.14,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.36,
      "end_seconds": 19.0,
      "duration_seconds": 6.64,
      "text": "Hello, um, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.0,
      "end_seconds": 26.92,
      "duration_seconds": 3.92,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.54,
      "end_seconds": 37.06,
      "duration_seconds": 8.52,
      "text": "Yeah, it's the room spinning when I turn over in bed. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.72,
      "end_seconds": 40.84,
      "duration_seconds": 2.12,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.74,
      "end_seconds": 45.89,
      "duration_seconds": 3.15,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.16,
      "end_seconds": 49.52,
      "duration_seconds": 2.36,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.64,
      "end_seconds": 55.42,
      "duration_seconds": 4.78,
      "text": "Okay, so it settles a little with lying still."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.01,
      "end_seconds": 59.5,
      "duration_seconds": 3.49,
      "text": "Okay, go on. How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.39,
      "end_seconds": 63.71,
      "duration_seconds": 2.32,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.8,
      "end_seconds": 68.04,
      "duration_seconds": 2.24,
      "text": "Okay, what brings it on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.65,
      "end_seconds": 75.14,
      "duration_seconds": 3.49,
      "text": "Looking up definitely sets it off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.94,
      "end_seconds": 82.96,
      "duration_seconds": 7.02,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 83.06,
      "end_seconds": 89.12,
      "duration_seconds": 6.06,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.64,
      "end_seconds": 93.47,
      "duration_seconds": 2.83,
      "text": "Right, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.71,
      "end_seconds": 100.55,
      "duration_seconds": 5.84,
      "text": "Well, I've been feeling sick too, for about two weeks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.16,
      "end_seconds": 106.7,
      "duration_seconds": 5.54,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.23,
      "end_seconds": 116.72,
      "duration_seconds": 9.49,
      "text": "Honestly, once or twice a day. I had being unsteady for a few minutes before. That's settled now, though."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.27,
      "end_seconds": 126.96,
      "duration_seconds": 8.69,
      "text": "Have you had the room spinning when you turn over in bed before, or is this the first time?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.35,
      "end_seconds": 135.11,
      "duration_seconds": 6.76,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 136.84,
      "end_seconds": 139.66,
      "duration_seconds": 2.82,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 147.71,
      "duration_seconds": 6.41,
      "text": "A few quick ones: hearing loss, weakness, double vision or ringing in the ear?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.91,
      "end_seconds": 155.97,
      "duration_seconds": 7.06,
      "text": "Erm, no, no hearing loss, weakness, double vision or ringing in the ear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.55,
      "end_seconds": 160.28,
      "duration_seconds": 3.73,
      "text": "Okay, go on. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.22,
      "end_seconds": 164.09,
      "duration_seconds": 1.87,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.77,
      "end_seconds": 168.79,
      "duration_seconds": 3.02,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.33,
      "end_seconds": 172.89,
      "duration_seconds": 2.56,
      "text": "It's sertraline, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.41,
      "end_seconds": 176.4,
      "duration_seconds": 1.99,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.79,
      "end_seconds": 178.79,
      "duration_seconds": 1.0,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.46,
      "end_seconds": 183.65,
      "duration_seconds": 3.19,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.73,
      "end_seconds": 186.92,
      "duration_seconds": 2.19,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.75,
      "end_seconds": 196.63,
      "duration_seconds": 7.88,
      "text": "Erm, it's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.93,
      "end_seconds": 200.32,
      "duration_seconds": 2.39,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.03,
      "end_seconds": 220.35,
      "duration_seconds": 19.32,
      "text": "For the heart rhythm, I believe. My husband sets them out for me, I just take what I'm given. Valsartan, 80 milligrams, once a day. Hmm, it's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 221.97,
      "end_seconds": 226.69,
      "duration_seconds": 4.72,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.04,
      "end_seconds": 233.19,
      "duration_seconds": 5.15,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.09,
      "end_seconds": 246.79,
      "duration_seconds": 11.7,
      "text": "I, I don't think I have it with me. Yeah, I'd been on telmisartan, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.85,
      "end_seconds": 249.68,
      "duration_seconds": 1.83,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.17,
      "end_seconds": 254.92,
      "duration_seconds": 3.75,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.79,
      "end_seconds": 258.82,
      "duration_seconds": 2.03,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.58,
      "end_seconds": 265.53,
      "duration_seconds": 4.95,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.45,
      "end_seconds": 284.42,
      "duration_seconds": 3.97,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.35,
      "end_seconds": 288.57,
      "duration_seconds": 2.22,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.3,
      "end_seconds": 291.42,
      "duration_seconds": 2.12,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.33,
      "end_seconds": 300.17,
      "duration_seconds": 7.84,
      "text": "Uh, just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.81,
      "end_seconds": 314.15,
      "duration_seconds": 2.34,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.2,
      "end_seconds": 321.28,
      "duration_seconds": 5.08,
      "text": "Well, I've had depression for about ten years now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.52,
      "end_seconds": 323.43,
      "duration_seconds": 0.91,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.0,
      "end_seconds": 329.52,
      "duration_seconds": 4.52,
      "text": "Mm, I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.1,
      "end_seconds": 332.62,
      "duration_seconds": 1.52,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.5,
      "end_seconds": 347.94,
      "duration_seconds": 9.44,
      "text": "Erm, um, I've had high blood pressure, yes. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.8,
      "end_seconds": 352.5,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.7,
      "end_seconds": 355.39,
      "duration_seconds": 1.69,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.87,
      "end_seconds": 362.6,
      "duration_seconds": 5.73,
      "text": "Right, so anxiety is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 364.11,
      "end_seconds": 373.46,
      "duration_seconds": 9.35,
      "text": "Here are the numbers, doctor. Heart rate 69, SpO2 97 percent on room air, blood pressure 109 over 68, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.92,
      "end_seconds": 376.26,
      "duration_seconds": 1.34,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.96,
      "end_seconds": 382.55,
      "duration_seconds": 3.59,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.36,
      "end_seconds": 385.54,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.37,
      "end_seconds": 409.52,
      "duration_seconds": 7.15,
      "text": "When I tip you back, the eyes flick for about twenty seconds, and the hearing is normal."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.2,
      "end_seconds": 412.19,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.09,
      "end_seconds": 432.11,
      "duration_seconds": 16.02,
      "text": "Right, thank you, you can get dressed. I'll do a repositioning manoeuvre now and show you exercises for home. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.97,
      "end_seconds": 435.28,
      "duration_seconds": 2.31,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.1,
      "end_seconds": 441.83,
      "duration_seconds": 5.73,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.73,
      "end_seconds": 447.59,
      "duration_seconds": 3.86,
      "text": "Erm, um, that's fine by me."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.16,
      "end_seconds": 455.78,
      "duration_seconds": 6.62,
      "text": "I'd like you back in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.35,
      "end_seconds": 460.65,
      "duration_seconds": 3.3,
      "text": "Thank you, uh, doctor, goodbye."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 462.04,
      "end_seconds": 463.42,
      "duration_seconds": 1.38,
      "text": "Take care now."
    }
  ]
}