    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.24,
      "end_seconds": 136.72,
      "duration_seconds": 3.48,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.41,
      "end_seconds": 139.85,
      "duration_seconds": 2.44,
      "text": "my father had bowel cancer"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 147.34,
      "duration_seconds": 4.16,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.53,
      "end_seconds": 150.03,
      "duration_seconds": 1.5,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.8,
      "end_seconds": 160.54,
      "duration_seconds": 2.74,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.99,
      "end_seconds": 163.02,
      "duration_seconds": 1.03,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.62,
      "end_seconds": 168.15,
      "duration_seconds": 3.53,
      "text": "let me get the readings out of the way"
