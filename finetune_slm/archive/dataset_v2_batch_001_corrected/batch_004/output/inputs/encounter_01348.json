    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.59,
      "end_seconds": 182.94,
      "duration_seconds": 2.35,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.75,
      "end_seconds": 202.95,
      "duration_seconds": 9.2,
      "text": "Okay: pulse is 105 beats a minute, BP is 115 over 80, respiratory rate 21, temp 38.7 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.49,
      "end_seconds": 205.88,
      "duration_seconds": 1.39,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.4,
      "end_seconds": 211.66,
      "duration_seconds": 4.26,
      "text": "I'll explain what these mean in a a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.28,
      "end_seconds": 218.19,
      "duration_seconds": 3.91,
      "text": "okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.96,
      "end_seconds": 222.61,
      "duration_seconds": 2.65,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 244.62,
      "duration_seconds": 6.96,
      "text": "the skin on your leg is dusky with blisters and is very tender, and you are feverish"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 249.65,
      "duration_seconds": 2.5,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.34,
      "end_seconds": 269.44,
      "duration_seconds": 8.1,
      "text": "Okay thinking it through it it points towards a severe deep skin infection needing urgent surgery review."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.91,
      "end_seconds": 274.48,
      "duration_seconds": 3.57,
      "text": "what are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.33,
      "end_seconds": 291.41,
      "duration_seconds": 15.08,
      "text": "nothing I've seen today points to an emergency it looks like a severe deep skin infection needing urgent surgery review but I'd like to confirm we should do an urgent surgical review for possible necrotising infection"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.52,
      "end_seconds": 294.96,
      "duration_seconds": 2.44,
      "text": "Yeah, that's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.87,
      "end_seconds": 322.57,
      "duration_seconds": 26.7,
      "text": "I am sending you to hospital now, do not wait. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. I'm going to send a referral to the surgical team. Come back or go to emergency straight away if you cannot go now. Come back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.94,
      "end_seconds": 327.84,
      "duration_seconds": 3.9,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0041",
