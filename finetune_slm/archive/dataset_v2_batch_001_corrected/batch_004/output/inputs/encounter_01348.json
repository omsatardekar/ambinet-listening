    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.13,
      "end_seconds": 63.12,
      "duration_seconds": 4.99,
      "text": "Sorry, what was I saying, none of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.11,
      "end_seconds": 66.9,
      "duration_seconds": 1.79,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.94,
      "end_seconds": 71.8,
      "duration_seconds": 2.86,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 76.32,
      "duration_seconds": 3.8,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
