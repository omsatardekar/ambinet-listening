      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.81,
      "end_seconds": 81.56,
      "duration_seconds": 3.75,
      "text": "no you know nothing with my heart"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.03,
      "end_seconds": 88.51,
      "duration_seconds": 2.48,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.12,
      "end_seconds": 94.68,
      "duration_seconds": 4.56,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.56,
      "end_seconds": 98.53,
      "duration_seconds": 1.97,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.56,
      "end_seconds": 106.6,
      "duration_seconds": 6.04,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.82,
      "end_seconds": 124.82,
      "duration_seconds": 5.0,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.48,
      "end_seconds": 128.06,
      "duration_seconds": 2.58,
      "text": "not to my knowledge, no"
