    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.37,
      "end_seconds": 22.38,
      "duration_seconds": 7.01,
      "text": "so the thing is, I've got a red hot swelling on my leg"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.11,
      "end_seconds": 27.37,
      "duration_seconds": 4.26,
      "text": "Right, how many days or weeks has it been?"
