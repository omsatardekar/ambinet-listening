    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.4,
      "end_seconds": 54.05,
      "duration_seconds": 3.65,
      "text": "Have you had any cut or insect bite?"
