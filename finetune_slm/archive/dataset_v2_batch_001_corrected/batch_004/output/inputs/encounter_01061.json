{
  "schema_version": "1.0",
  "encounter_id": "01061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.2,
      "duration_seconds": 2.57,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.1,
      "end_seconds": 6.18,
      "duration_seconds": 1.08,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.81,
      "end_seconds": 17.67,
      "duration_seconds": 7.86,
      "text": "Sorry, what was I saying, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 25.77,
      "duration_seconds": 6.87,
      "text": "Yes, that's no problem at all. Please sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.01,
      "end_seconds": 35.09,
      "duration_seconds": 6.08,
      "text": "Honestly, it's a blocked nose, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.97,
      "end_seconds": 38.68,
      "duration_seconds": 2.71,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.0,
      "end_seconds": 52.9,
      "duration_seconds": 2.9,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.18,
      "end_seconds": 75.06,
      "duration_seconds": 11.88,
      "text": "Okay: SpO2 99 percent on room air, temperature is 36.8 degrees, heart rate 76, pressure 111 over 81. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.04,
      "end_seconds": 79.03,
      "duration_seconds": 1.99,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.29,
      "end_seconds": 98.24,
      "duration_seconds": 13.95,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.86,
      "end_seconds": 114.89,
      "duration_seconds": 16.03,
      "text": "Steam helps a bit. It feels severe to me. Oh, and a poor sense of smell. Had that since Monday. Let me think, I've also had green discharge, for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.67,
      "end_seconds": 135.08,
      "duration_seconds": 2.41,
      "text": "Any swelling around the eye?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.55,
      "end_seconds": 140.0,
      "duration_seconds": 3.45,
      "text": "No, none, no swelling around the eye."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 146.11,
      "duration_seconds": 4.21,
      "text": "A few quick ones: double vision, severe headache or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.63,
      "end_seconds": 151.82,
      "duration_seconds": 5.19,
      "text": "No double vision, severe headache or fever, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.89,
      "end_seconds": 156.62,
      "duration_seconds": 2.73,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 162.08,
      "duration_seconds": 3.48,
      "text": "No, you know, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.03,
      "end_seconds": 167.55,
      "duration_seconds": 3.52,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.33,
      "end_seconds": 170.3,
      "duration_seconds": 0.97,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.84,
      "end_seconds": 173.54,
      "duration_seconds": 2.7,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.6,
      "end_seconds": 177.57,
      "duration_seconds": 2.97,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.2,
      "end_seconds": 181.21,
      "duration_seconds": 3.01,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.13,
      "end_seconds": 199.56,
      "duration_seconds": 16.43,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.12,
      "end_seconds": 213.34,
      "duration_seconds": 3.22,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.79,
      "end_seconds": 221.77,
      "duration_seconds": 6.98,
      "text": "I mean, I've had an underactive thyroid for about ten years now. I have COPD."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.6,
      "end_seconds": 227.76,
      "duration_seconds": 4.16,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.53,
      "end_seconds": 235.55,
      "duration_seconds": 7.02,
      "text": "Tiotropium inhaler, once a day. I used to take Eltroxin, but I stopped it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.02,
      "end_seconds": 239.46,
      "duration_seconds": 2.44,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.36,
      "end_seconds": 246.41,
      "duration_seconds": 5.05,
      "text": "Well, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.76,
      "end_seconds": 252.85,
      "duration_seconds": 4.09,
      "text": "Okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.7,
      "end_seconds": 255.74,
      "duration_seconds": 1.04,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.06,
      "end_seconds": 258.45,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.34,
      "end_seconds": 280.32,
      "duration_seconds": 4.98,
      "text": "There is tenderness over both cheeks and the nasal lining looks swollen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.23,
      "end_seconds": 290.04,
      "duration_seconds": 6.81,
      "text": "You can relax now. Right, here's what I'm thinking. The most likely explanation is chronic sinusitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.3,
      "end_seconds": 293.36,
      "duration_seconds": 2.06,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 302.5,
      "duration_seconds": 8.57,
      "text": "I understand the worry. At the moment I'd say it's chronic sinusitis, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.97,
      "end_seconds": 331.92,
      "duration_seconds": 10.95,
      "text": "Rinse your nose with saline twice a day. See me again in eight weeks. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.19,
      "end_seconds": 336.05,
      "duration_seconds": 2.86,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.79,
      "end_seconds": 338.03,
      "duration_seconds": 1.24,
      "text": "Goodbye for now."
    }
  ]
}