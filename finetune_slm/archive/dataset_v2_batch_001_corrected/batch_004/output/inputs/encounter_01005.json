{
  "schema_version": "1.0",
  "encounter_id": "01005",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.59,
      "end_seconds": 7.63,
      "duration_seconds": 7.04,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.62,
      "end_seconds": 12.35,
      "duration_seconds": 3.73,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.86,
      "end_seconds": 26.21,
      "duration_seconds": 12.35,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come. We came because of tearing chest pain going to my back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.28,
      "end_seconds": 36.82,
      "duration_seconds": 5.54,
      "text": "Since when exactly? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.43,
      "end_seconds": 42.04,
      "duration_seconds": 3.61,
      "text": "It's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.63,
      "end_seconds": 46.65,
      "duration_seconds": 3.02,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.04,
      "end_seconds": 48.98,
      "duration_seconds": 0.94,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.62,
      "end_seconds": 55.53,
      "duration_seconds": 5.91,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 55.63,
      "end_seconds": 62.09,
      "duration_seconds": 6.46,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.78,
      "end_seconds": 69.04,
      "duration_seconds": 5.26,
      "text": "Alright, later, thanks. Please go on. Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.64,
      "end_seconds": 71.22,
      "duration_seconds": 1.58,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.62,
      "end_seconds": 79.53,
      "duration_seconds": 3.91,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.31,
      "end_seconds": 82.28,
      "duration_seconds": 0.97,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.03,
      "end_seconds": 90.97,
      "duration_seconds": 7.94,
      "text": "Have you had tearing chest pain going to your back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.89,
      "end_seconds": 99.07,
      "duration_seconds": 7.18,
      "text": "Hmm, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 100.21,
      "end_seconds": 102.26,
      "duration_seconds": 2.05,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.06,
      "end_seconds": 107.88,
      "duration_seconds": 3.82,
      "text": "Right, a few quick ones: fever or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.16,
      "end_seconds": 121.15,
      "duration_seconds": 11.99,
      "text": "No, no fever, no leg swelling. I did have sudden onset at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.33,
      "end_seconds": 124.83,
      "duration_seconds": 2.5,
      "text": "And cough, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 128.31,
      "duration_seconds": 1.57,
      "text": "No. No cough."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.11,
      "end_seconds": 133.97,
      "duration_seconds": 3.86,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.57,
      "end_seconds": 140.32,
      "duration_seconds": 2.75,
      "text": "Actually, no, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.1,
      "end_seconds": 143.58,
      "duration_seconds": 2.48,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.04,
      "end_seconds": 146.95,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.51,
      "end_seconds": 151.29,
      "duration_seconds": 3.78,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.07,
      "end_seconds": 155.38,
      "duration_seconds": 3.31,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.04,
      "end_seconds": 160.45,
      "duration_seconds": 4.41,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.89,
      "end_seconds": 163.74,
      "duration_seconds": 1.85,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.17,
      "end_seconds": 168.59,
      "duration_seconds": 3.42,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.31,
      "end_seconds": 173.61,
      "duration_seconds": 4.3,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.95,
      "end_seconds": 180.14,
      "duration_seconds": 3.19,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.98,
      "end_seconds": 189.67,
      "duration_seconds": 7.69,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.35,
      "end_seconds": 197.14,
      "duration_seconds": 2.79,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.49,
      "end_seconds": 212.43,
      "duration_seconds": 13.94,
      "text": "For my blood pressure, I believe. My wife sets them out for me, I just take what I'm given. It's clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.99,
      "end_seconds": 213.69,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.73,
      "end_seconds": 218.18,
      "duration_seconds": 3.45,
      "text": "Mm, I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 219.59,
      "end_seconds": 226.76,
      "duration_seconds": 7.17,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.55,
      "end_seconds": 229.9,
      "duration_seconds": 2.35,
      "text": "Metoprolol I don't take anymore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.48,
      "end_seconds": 250.53,
      "duration_seconds": 3.05,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 252.16,
      "end_seconds": 264.11,
      "duration_seconds": 11.95,
      "text": "I've, I've had high blood pressure for about a year now. Uh, I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.82,
      "end_seconds": 266.52,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.5,
      "end_seconds": 269.65,
      "duration_seconds": 2.15,
      "text": "Eczema, for five years."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 271.29,
      "end_seconds": 279.83,
      "duration_seconds": 8.54,
      "text": "Here are the numbers, doctor. SpO2 96 percent on room air, BP is 153 over 99, heart rate 85, temperature 36.8."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.66,
      "end_seconds": 281.64,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.73,
      "end_seconds": 287.38,
      "duration_seconds": 3.65,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 289.39,
      "end_seconds": 291.1,
      "duration_seconds": 1.71,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.68,
      "end_seconds": 295.59,
      "duration_seconds": 2.91,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.95,
      "end_seconds": 313.24,
      "duration_seconds": 5.29,
      "text": "The blood pressure is different in your two arms and you are sweaty."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.49,
      "end_seconds": 343.17,
      "duration_seconds": 25.68,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I'd lean towards a possible tear in the main artery. A heart attack is also on my list. Let me just check I've got this right. You've had tearing chest pain going to your back for three weeks, severe, and no fever or leg swelling."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.26,
      "end_seconds": 347.78,
      "duration_seconds": 2.52,
      "text": "Yeah, yes, you've got it."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.91,
      "end_seconds": 366.54,
      "duration_seconds": 8.63,
      "text": "I think an urgent CT scan of the chest and abdomen makes sense here, for tearing chest pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 368.02,
      "end_seconds": 370.45,
      "duration_seconds": 2.43,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.56,
      "end_seconds": 392.7,
      "duration_seconds": 21.14,
      "text": "I'd like to arrange an ECG for chest pain. Do not move, I am calling an ambulance and you are going to a specialist centre. I'm going to send a referral to the cardiac surgical team. I'd like to see you again straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.37,
      "end_seconds": 398.24,
      "duration_seconds": 3.87,
      "text": "Great, uh, thank you for your help."
    }
  ]
}