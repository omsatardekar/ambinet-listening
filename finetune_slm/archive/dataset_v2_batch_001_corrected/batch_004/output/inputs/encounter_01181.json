    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.64,
      "end_seconds": 102.76,
      "duration_seconds": 2.12,
      "text": "No problems with breathing."
