    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.59,
      "end_seconds": 84.61,
      "duration_seconds": 8.02,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.38,
      "end_seconds": 89.33,
