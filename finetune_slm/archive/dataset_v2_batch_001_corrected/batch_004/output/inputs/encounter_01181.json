    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.95,
      "end_seconds": 111.06,
      "duration_seconds": 2.11,
      "text": "no weakness or anything"
