      "start_seconds": 51.11,
      "end_seconds": 63.86,
      "duration_seconds": 12.75,
      "text": "sorry uh what was I saying yes about the same about two weeks oh and shoulder tip pain had that since last weekend"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.73,
      "end_seconds": 75.23,
      "duration_seconds": 7.5,
      "text": "Have you had sharp pain low on one side before, or is this the the first time?"
