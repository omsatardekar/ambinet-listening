    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.58,
      "end_seconds": 108.34,
      "duration_seconds": 3.76,
      "text": "anything with your nerves like weakness or numbness?"
