{
  "schema_version": "1.0",
  "encounter_id": "01475",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.04,
      "duration_seconds": 3.24,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 10.3,
      "duration_seconds": 5.08,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 15.29,
      "duration_seconds": 3.93,
      "text": "Well, I've been having an irregular heartbeat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.12,
      "end_seconds": 20.36,
      "duration_seconds": 3.24,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.8,
      "end_seconds": 30.49,
      "duration_seconds": 8.69,
      "text": "I've had it for six months. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.81,
      "end_seconds": 34.58,
      "duration_seconds": 2.77,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.4,
      "end_seconds": 52.97,
      "duration_seconds": 13.57,
      "text": "Erm, maybe a three out of ten on a bad day. I, I had being short of breath on slopes before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.12,
      "end_seconds": 66.38,
      "duration_seconds": 4.26,
      "text": "Did you get black stools, chest pain, nosebleeds or fainting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.33,
      "end_seconds": 75.93,
      "duration_seconds": 6.6,
      "text": "No black stools, chest pain, nosebleeds or fainting, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.91,
      "end_seconds": 83.56,
      "duration_seconds": 3.65,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.22,
      "end_seconds": 87.41,
      "duration_seconds": 3.19,
      "text": "Hmm, no, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 91.64,
      "duration_seconds": 2.24,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.5,
      "end_seconds": 102.44,
      "duration_seconds": 4.94,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.15,
      "end_seconds": 106.05,
      "duration_seconds": 1.9,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.14,
      "end_seconds": 111.41,
      "duration_seconds": 3.27,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.25,
      "end_seconds": 116.12,
      "duration_seconds": 2.87,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.68,
      "end_seconds": 120.72,
      "duration_seconds": 4.04,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 129.97,
      "duration_seconds": 3.04,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.69,
      "end_seconds": 133.01,
      "duration_seconds": 2.32,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.63,
      "end_seconds": 138.15,
      "duration_seconds": 4.52,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.88,
      "end_seconds": 144.22,
      "duration_seconds": 4.34,
      "text": "Okay, so yes, wheat. I get bloating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.05,
      "end_seconds": 151.74,
      "duration_seconds": 6.69,
      "text": "Do you have any chronic illnesses? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.83,
      "end_seconds": 169.76,
      "duration_seconds": 12.93,
      "text": "An irregular heartbeat, for five years. Okay, so I've had an enlarged prostate, yes. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.61,
      "end_seconds": 179.07,
      "duration_seconds": 8.46,
      "text": "ah. Okay, I can see an enlarged prostate in your file as well. Let's run through your medicines"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.8,
      "end_seconds": 195.64,
      "duration_seconds": 15.84,
      "text": "It's apixaban, 5 milligrams, twice a day. Tamsulosin, 0.4 milligrams, at night for the prostate. Yeah, I was on warfarin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.35,
      "end_seconds": 204.08,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.41,
      "end_seconds": 215.13,
      "duration_seconds": 2.72,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 242.96,
      "duration_seconds": 6.63,
      "text": "Okay: BP is 126 over 85, temperature 36.7, heart rate 126, saturation 96 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.7,
      "end_seconds": 249.29,
      "duration_seconds": 4.59,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.92,
      "end_seconds": 261.04,
      "duration_seconds": 1.12,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 264.51,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.82,
      "end_seconds": 282.38,
      "duration_seconds": 4.56,
      "text": "Your pulse is irregular and your heart sounds are otherwise normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.17,
      "end_seconds": 297.28,
      "duration_seconds": 9.11,
      "text": "you can relax now. So, based on the history and the examination, this looks most like atrial fibrillation, rate reasonably controlled"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.95,
      "end_seconds": 302.76,
      "duration_seconds": 3.81,
      "text": "Ah, is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.01,
      "end_seconds": 325.28,
      "duration_seconds": 19.27,
      "text": "it's reasonable to be concerned, but right now atrial fibrillation, rate reasonably controlled is my leading thought, not anything worse let me just check I've got this right you've had an irregular heartbeat for six months, and no nosebleeds or fainting"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.41,
      "end_seconds": 328.34,
      "duration_seconds": 1.93,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.15,
      "end_seconds": 370.78,
      "duration_seconds": 23.63,
      "text": "I want a full blood count done, that's for anticoagulant review. That will help us see what's going on underneath and decide the next step. Never skip the blood thinner, and tell any dentist or surgeon you take it. See me again in three months. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.5,
      "end_seconds": 376.26,
      "duration_seconds": 3.76,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.63,
      "end_seconds": 381.51,
      "duration_seconds": 1.88,
      "text": "So, look after yourself."
    }
  ]
}