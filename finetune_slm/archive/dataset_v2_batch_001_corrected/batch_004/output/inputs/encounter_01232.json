{
  "schema_version": "1.0",
  "encounter_id": "01232",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 2.83,
      "duration_seconds": 1.75,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.2,
      "end_seconds": 8.84,
      "duration_seconds": 4.64,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.33,
      "end_seconds": 24.08,
      "duration_seconds": 11.75,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. It's dry gritty eyes, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.94,
      "end_seconds": 28.14,
      "duration_seconds": 3.2,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.88,
      "end_seconds": 39.9,
      "duration_seconds": 7.02,
      "text": "It's been about four days now. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.99,
      "end_seconds": 47.16,
      "duration_seconds": 5.17,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.21,
      "end_seconds": 76.75,
      "duration_seconds": 28.54,
      "text": "Only eye drops, and it's not much. I notice it more with screens. Oh, and occasional blurring that clears on blinking. That's been about the same, about four days. As for occasional blurring that clears on blinking, I'd call it mild. There was tired eyes by evening, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.57,
      "end_seconds": 81.54,
      "duration_seconds": 2.97,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.67,
      "end_seconds": 86.91,
      "duration_seconds": 4.24,
      "text": "Ah, just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.76,
      "end_seconds": 93.16,
      "duration_seconds": 4.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.86,
      "end_seconds": 98.2,
      "duration_seconds": 3.34,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.21,
      "end_seconds": 102.19,
      "duration_seconds": 1.98,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.72,
      "end_seconds": 111.93,
      "duration_seconds": 4.21,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.45,
      "end_seconds": 114.53,
      "duration_seconds": 2.08,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.05,
      "end_seconds": 119.67,
      "duration_seconds": 3.62,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.28,
      "end_seconds": 123.31,
      "duration_seconds": 3.03,
      "text": "So, do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.9,
      "end_seconds": 129.4,
      "duration_seconds": 4.5,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.07,
      "end_seconds": 133.77,
      "duration_seconds": 2.7,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.56,
      "end_seconds": 138.0,
      "duration_seconds": 3.44,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.8,
      "end_seconds": 141.16,
      "duration_seconds": 2.36,
      "text": "So, how active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.05,
      "end_seconds": 146.38,
      "duration_seconds": 3.33,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.71,
      "end_seconds": 150.9,
      "duration_seconds": 3.19,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 152.16,
      "end_seconds": 158.8,
      "duration_seconds": 6.64,
      "text": "She is on diclofenac, 50 milligrams, when needed, I give it to her."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.17,
      "end_seconds": 165.8,
      "duration_seconds": 3.63,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.53,
      "end_seconds": 169.39,
      "duration_seconds": 2.86,
      "text": "I've, I've had gout, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.34,
      "end_seconds": 171.04,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.54,
      "end_seconds": 184.76,
      "duration_seconds": 9.22,
      "text": "Arthritis in my knees, for nearly five years. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.24,
      "end_seconds": 208.46,
      "duration_seconds": 5.22,
      "text": "A few quick ones: redness, loss of vision, pain or light sensitivity?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.15,
      "end_seconds": 216.94,
      "duration_seconds": 6.79,
      "text": "No redness, loss of vision, pain or light sensitivity, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.56,
      "end_seconds": 220.76,
      "duration_seconds": 2.2,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.67,
      "end_seconds": 224.46,
      "duration_seconds": 1.79,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.61,
      "end_seconds": 240.33,
      "duration_seconds": 2.72,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.73,
      "end_seconds": 252.11,
      "duration_seconds": 2.38,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.48,
      "end_seconds": 275.86,
      "duration_seconds": 11.38,
      "text": "Okay: BP is 118 over 78, temperature is 37.0 degrees. And respiratory rate 16, heart rate 64, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.96,
      "end_seconds": 280.69,
      "duration_seconds": 3.73,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.54,
      "end_seconds": 283.56,
      "duration_seconds": 2.02,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.61,
      "end_seconds": 301.67,
      "duration_seconds": 5.06,
      "text": "Your eyelids look slightly crusted but the white of the eye is clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.92,
      "end_seconds": 307.38,
      "duration_seconds": 2.46,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.8,
      "end_seconds": 338.85,
      "duration_seconds": 18.05,
      "text": "Okay, so my impression is this: I think we're dealing with dry eye disease at this stage. I'd also keep blepharitis in mind. Take screen breaks every twenty minutes and use warm compresses on the lids. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.42,
      "end_seconds": 343.86,
      "duration_seconds": 3.44,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.77,
      "end_seconds": 346.05,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}