{
  "schema_version": "1.0",
  "encounter_id": "01100",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 5.77,
      "duration_seconds": 5.11,
      "text": "I mean, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.67,
      "end_seconds": 12.39,
      "duration_seconds": 4.72,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.93,
      "end_seconds": 20.64,
      "duration_seconds": 6.71,
      "text": "Let me think, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.28,
      "end_seconds": 25.64,
      "duration_seconds": 4.36,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.42,
      "end_seconds": 35.87,
      "duration_seconds": 9.45,
      "text": "Mainly throbbing headaches on one side. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.68,
      "end_seconds": 38.83,
      "duration_seconds": 2.15,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.91,
      "end_seconds": 41.99,
      "duration_seconds": 2.08,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.78,
      "end_seconds": 46.75,
      "duration_seconds": 3.97,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.07,
      "end_seconds": 52.67,
      "duration_seconds": 4.6,
      "text": "Erm, uh, it feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.5,
      "end_seconds": 56.92,
      "duration_seconds": 2.42,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.62,
      "end_seconds": 76.39,
      "duration_seconds": 17.77,
      "text": "Zigzag lights before it starts goes along with it, most of the time. Hmm, I've been feeling sick too, since yesterday. The Zigzag lights before it starts? That's been for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.54,
      "end_seconds": 81.72,
      "duration_seconds": 4.18,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.23,
      "end_seconds": 84.92,
      "duration_seconds": 1.69,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.87,
      "end_seconds": 90.64,
      "duration_seconds": 3.77,
      "text": "Any stiff neck, head injury or weakness at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.66,
      "end_seconds": 96.02,
      "duration_seconds": 3.36,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.98,
      "end_seconds": 99.84,
      "duration_seconds": 1.86,
      "text": "any sign of fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.42,
      "end_seconds": 103.32,
      "duration_seconds": 1.9,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 103.86,
      "end_seconds": 108.86,
      "duration_seconds": 5.0,
      "text": "actually, doctor, I did notice fever. She doesn't always say"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.38,
      "end_seconds": 117.17,
      "duration_seconds": 7.79,
      "text": "Let me think, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.75,
      "end_seconds": 126.61,
      "duration_seconds": 7.86,
      "text": "alright, I'll note both what you've said and what you've noticed anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.63,
      "end_seconds": 129.12,
      "duration_seconds": 1.49,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.36,
      "end_seconds": 143.64,
      "duration_seconds": 3.28,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.03,
      "end_seconds": 154.67,
      "duration_seconds": 9.64,
      "text": "Migraines, for about a year. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.8,
      "end_seconds": 156.5,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.17,
      "end_seconds": 172.82,
      "duration_seconds": 15.65,
      "text": "Well, uh, I've had heart failure for about a year now. I've had an underactive thyroid, yes. Let me think, I've had gout for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.03,
      "end_seconds": 189.58,
      "duration_seconds": 12.55,
      "text": "Right, so migraines and and heart failure are already on your record. We'll keep that in mind today. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.57,
      "end_seconds": 195.94,
      "duration_seconds": 4.37,
      "text": "Propranolol, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.0,
      "end_seconds": 200.02,
      "duration_seconds": 3.02,
      "text": "Alright, and what strength is that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.21,
      "end_seconds": 210.01,
      "duration_seconds": 8.8,
      "text": "it's 40 milligrams i'm on metoprolol, 50 milligrams, twice a day for my heart"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.55,
      "end_seconds": 218.84,
      "duration_seconds": 8.29,
      "text": "That's what's prescribed, uh, but I'm not sure she takes it it every day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.31,
      "end_seconds": 230.16,
      "duration_seconds": 9.85,
      "text": "Mm, you know, I'm on Thyronorm, 50 micrograms, every morning. Febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.98,
      "end_seconds": 234.86,
      "duration_seconds": 2.88,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.53,
      "end_seconds": 244.23,
      "duration_seconds": 8.7,
      "text": "About about three months. Let me think, I used to take sumatriptan, but I stopped it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.86,
      "end_seconds": 246.78,
      "duration_seconds": 1.92,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.79,
      "end_seconds": 253.17,
      "duration_seconds": 5.38,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.04,
      "end_seconds": 256.45,
      "duration_seconds": 1.41,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.79,
      "end_seconds": 262.38,
      "duration_seconds": 4.59,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.2,
      "end_seconds": 265.85,
      "duration_seconds": 1.65,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.1,
      "end_seconds": 270.13,
      "duration_seconds": 3.03,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.84,
      "end_seconds": 272.07,
      "duration_seconds": 1.23,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.04,
      "end_seconds": 280.32,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.23,
      "end_seconds": 282.88,
      "duration_seconds": 1.65,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.77,
      "end_seconds": 289.74,
      "duration_seconds": 4.97,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.59,
      "end_seconds": 299.96,
      "duration_seconds": 4.37,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.78,
      "end_seconds": 314.46,
      "duration_seconds": 10.68,
      "text": "Uh, I had a reaction to trimethoprim when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.71,
      "end_seconds": 329.78,
      "duration_seconds": 3.07,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.54,
      "end_seconds": 335.73,
      "duration_seconds": 5.19,
      "text": "just keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.57,
      "end_seconds": 339.79,
      "duration_seconds": 3.22,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.04,
      "end_seconds": 350.67,
      "duration_seconds": 2.63,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.77,
      "end_seconds": 372.12,
      "duration_seconds": 11.35,
      "text": "okay: pulse is 72 beats a minute, SpO2 98 percent on room air. And respiratory rate 16, pressure 110 over 68, temperature 36.9."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.64,
      "end_seconds": 376.71,
      "duration_seconds": 3.07,
      "text": "Let's move on to to the examination."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.5,
      "end_seconds": 380.02,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.13,
      "end_seconds": 383.18,
      "duration_seconds": 2.05,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.09,
      "end_seconds": 397.68,
      "duration_seconds": 6.59,
      "text": "Your eye movements are normal and there is no weakness in your arms or legs."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.45,
      "end_seconds": 405.05,
      "duration_seconds": 1.6,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.9,
      "end_seconds": 440.6,
      "duration_seconds": 18.7,
      "text": "Having listened and examined, I think we're dealing with migraine with aura at this stage. Another possibility is tension-type headache. Let me repeat that back to make sure. You've had throbbing headaches on one side for six months, moderate, and no stiff neck or weakness."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.48,
      "end_seconds": 446.24,
      "duration_seconds": 1.76,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.82,
      "end_seconds": 467.32,
      "duration_seconds": 20.5,
      "text": "I'd like to arrange a headache diary for migraine. Keep a headache diary and avoid skipping meals. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Please come and see me in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 468.15,
      "end_seconds": 471.74,
      "duration_seconds": 3.59,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 473.28,
      "end_seconds": 474.67,
      "duration_seconds": 1.39,
      "text": "see you soon"
    }
  ]
}