{
  "schema_version": "1.0",
  "encounter_id": "01380",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 6.77,
      "duration_seconds": 5.63,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.36,
      "end_seconds": 11.82,
      "duration_seconds": 4.46,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.38,
      "end_seconds": 20.25,
      "duration_seconds": 6.87,
      "text": "Mainly a blocked ear. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.09,
      "end_seconds": 25.79,
      "duration_seconds": 3.7,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.54,
      "end_seconds": 39.33,
      "duration_seconds": 2.79,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.14,
      "end_seconds": 62.52,
      "duration_seconds": 10.38,
      "text": "Okay: SpO2 97 percent on room air, pulse 64. And temperature is 36.7 degrees, respiratory rate 17, BP is 109 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.0,
      "end_seconds": 65.58,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.2,
      "end_seconds": 69.58,
      "duration_seconds": 2.38,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.04,
      "end_seconds": 84.95,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.09,
      "end_seconds": 88.62,
      "duration_seconds": 2.53,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.12,
      "end_seconds": 98.34,
      "duration_seconds": 9.22,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.2,
      "end_seconds": 102.82,
      "duration_seconds": 3.62,
      "text": "Showering definitely sets it off. Moderate, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.61,
      "end_seconds": 107.61,
      "duration_seconds": 3.0,
      "text": "Have you had a feeling of fullness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.23,
      "end_seconds": 111.06,
      "duration_seconds": 2.83,
      "text": "Yeah. Two weeks, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.16,
      "end_seconds": 115.21,
      "duration_seconds": 3.05,
      "text": "A few quick ones: ringing or dizziness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.8,
      "end_seconds": 119.32,
      "duration_seconds": 3.52,
      "text": "No ringing or dizziness, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.21,
      "end_seconds": 121.55,
      "duration_seconds": 1.34,
      "text": "Nothing like discharge?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.82,
      "end_seconds": 124.55,
      "duration_seconds": 1.73,
      "text": "No discharge, thankfully."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.04,
      "end_seconds": 129.14,
      "duration_seconds": 3.1,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 131.73,
      "duration_seconds": 1.96,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.25,
      "end_seconds": 135.81,
      "duration_seconds": 2.56,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.79,
      "end_seconds": 138.6,
      "duration_seconds": 1.81,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.42,
      "end_seconds": 145.45,
      "duration_seconds": 3.03,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.07,
      "end_seconds": 151.03,
      "duration_seconds": 4.96,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.61,
      "end_seconds": 154.71,
      "duration_seconds": 2.1,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.68,
      "end_seconds": 160.73,
      "duration_seconds": 5.05,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.32,
      "end_seconds": 163.46,
      "duration_seconds": 2.14,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.58,
      "end_seconds": 169.18,
      "duration_seconds": 4.6,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.35,
      "end_seconds": 189.57,
      "duration_seconds": 8.22,
      "text": "Alright, are you taking anything regularly, including from the pharmacy? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.37,
      "end_seconds": 193.34,
      "duration_seconds": 2.97,
      "text": "Olive oil drops, twice a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.32,
      "end_seconds": 198.22,
      "duration_seconds": 3.9,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.59,
      "end_seconds": 201.33,
      "duration_seconds": 1.74,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.55,
      "end_seconds": 206.29,
      "duration_seconds": 3.74,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.47,
      "end_seconds": 211.07,
      "duration_seconds": 3.6,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.01,
      "end_seconds": 216.1,
      "duration_seconds": 2.09,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.51,
      "end_seconds": 221.65,
      "duration_seconds": 1.14,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.59,
      "end_seconds": 225.74,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 248.58,
      "duration_seconds": 4.15,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.48,
      "end_seconds": 251.44,
      "duration_seconds": 0.96,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.9,
      "end_seconds": 258.03,
      "duration_seconds": 3.13,
      "text": "Okay, that's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 282.58,
      "duration_seconds": 11.22,
      "text": "Putting it all together, it fits best with earwax blocking the ear. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.16,
      "end_seconds": 285.07,
      "duration_seconds": 1.91,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.82,
      "end_seconds": 295.72,
      "duration_seconds": 8.9,
      "text": "I can't promise yet, but most people with earwax blocking the ear do well once it's treated properly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.57,
      "end_seconds": 333.28,
      "duration_seconds": 20.71,
      "text": "I'm sending you for ear irrigation because of wax. Use the olive oil drops for a week and then we'll syringe the ear. If you get ear pain or dizziness, that's the point to come in urgently. Book a review in one week. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.6,
      "end_seconds": 338.63,
      "duration_seconds": 4.03,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.38,
      "end_seconds": 342.29,
      "duration_seconds": 1.91,
      "text": "Okay, look after yourself."
    }
  ]
}