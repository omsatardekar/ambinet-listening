  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 6.26,
      "duration_seconds": 5.24,
      "text": "I mean, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.26,
      "end_seconds": 12.1,
      "duration_seconds": 3.84,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.1,
      "end_seconds": 20.67,
      "duration_seconds": 6.57,
      "text": "Ah, you know, I've been dealing with a hot swollen painful knee."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.56,
      "end_seconds": 26.79,
      "duration_seconds": 4.23,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.6,
      "end_seconds": 36.88,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.61,
      "end_seconds": 58.54,
      "duration_seconds": 8.93,
      "text": "Okay: SpO2 98 percent on room air, BP is 114 over 69, pulse 107, temp 38.1 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.56,
      "end_seconds": 64.04,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.26,
      "end_seconds": 71.23,
      "duration_seconds": 5.97,
      "text": "We'll look at it together shortly. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.24,
      "end_seconds": 75.97,
      "duration_seconds": 2.73,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.45,
      "end_seconds": 80.17,
      "duration_seconds": 2.72,
      "text": "So, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 96.35,
      "duration_seconds": 14.29,
      "text": "Fever and chills goes along with it, uh, most of the time. The, The fever and chills? That's been since this morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.37,
      "end_seconds": 100.63,
      "duration_seconds": 3.26,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.06,
      "end_seconds": 107.23,
      "duration_seconds": 5.17,
      "text": "Uh, you know, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.98,
      "end_seconds": 114.47,
      "duration_seconds": 5.49,
      "text": "Have you had any recent injury, rash or other joint pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.16,
      "end_seconds": 122.59,
      "duration_seconds": 6.43,
      "text": "I haven't had recent injury, rash or other joint pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.46,
      "end_seconds": 128.25,
      "duration_seconds": 3.79,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.09,
      "end_seconds": 132.29,
      "duration_seconds": 3.2,
      "text": "Uh, no, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.17,
      "end_seconds": 151.54,
      "duration_seconds": 3.37,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.09,
      "end_seconds": 155.56,
      "duration_seconds": 2.47,
      "text": "I have an enlarged prostate."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.53,
      "end_seconds": 159.93,
      "duration_seconds": 2.4,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.78,
      "end_seconds": 170.02,
      "duration_seconds": 4.24,
      "text": "Tamsulosin, 0.4 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.35,
      "end_seconds": 175.63,
      "duration_seconds": 4.28,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.34,
      "end_seconds": 180.52,
      "duration_seconds": 3.18,
      "text": "Hmm, no, it's at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.32,
      "end_seconds": 185.64,
      "duration_seconds": 3.32,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.98,
      "end_seconds": 204.81,
      "duration_seconds": 17.83,
      "text": "I only drink at family occasions. I'm a bus driver, so I sit for long hours. My partner and our baby. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.68,
      "end_seconds": 218.36,
      "duration_seconds": 4.68,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.49,
      "end_seconds": 222.63,
      "duration_seconds": 3.14,
      "text": "Right, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.24,
      "end_seconds": 242.31,
      "duration_seconds": 4.07,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.33,
      "end_seconds": 246.12,
      "duration_seconds": 1.79,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.95,
      "end_seconds": 252.73,
      "duration_seconds": 3.78,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.68,
      "end_seconds": 255.15,
      "duration_seconds": 1.47,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.31,
      "end_seconds": 258.47,
      "duration_seconds": 2.16,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.97,
      "end_seconds": 282.64,
      "duration_seconds": 6.67,
      "text": "The knee is hot, swollen and extremely painful when I move it even slightly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.5,
      "end_seconds": 304.65,
      "duration_seconds": 17.15,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. This is probably possible septic arthritis. I want to be honest that this is an impression, not a final answer. A gout attack is also on my list."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.26,
      "end_seconds": 307.46,
      "duration_seconds": 2.2,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.4,
      "end_seconds": 327.48,
      "duration_seconds": 19.08,
      "text": "It's reasonable to be concerned, but right now possible septic arthritis is my leading thought, not anything worse. I'll request urgent blood tests, it'll help with septic arthritis. You need to go to hospital now for a joint washout assessment. I'll also refer you to the orthopaedic team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.2,
      "end_seconds": 330.84,
      "duration_seconds": 1.64,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.9,
      "end_seconds": 344.04,
      "duration_seconds": 12.14,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.9,
      "end_seconds": 346.68,
      "duration_seconds": 1.78,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.48,
      "end_seconds": 349.9,
      "duration_seconds": 2.42,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.71,
      "end_seconds": 353.95,
      "duration_seconds": 3.24,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.05,
      "end_seconds": 357.42,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
