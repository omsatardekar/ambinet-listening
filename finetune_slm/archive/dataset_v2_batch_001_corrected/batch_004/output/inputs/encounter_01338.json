{
  "schema_version": "1.0",
  "encounter_id": "01338",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 6.79,
      "duration_seconds": 6.0,
      "text": "Good morning. I've just opened your notes. Alright, lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.31,
      "end_seconds": 13.47,
      "duration_seconds": 5.16,
      "text": "It is, uh, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.44,
      "end_seconds": 18.53,
      "duration_seconds": 3.09,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.84,
      "end_seconds": 31.01,
      "duration_seconds": 7.17,
      "text": "Mainly I've been feeling well. That's why I came. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.79,
      "end_seconds": 37.67,
      "duration_seconds": 1.88,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.67,
      "end_seconds": 41.77,
      "duration_seconds": 3.1,
      "text": "Oh, it's been three weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.78,
      "end_seconds": 45.14,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.73,
      "end_seconds": 57.9,
      "duration_seconds": 2.17,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 79.27,
      "duration_seconds": 9.61,
      "text": "Okay: saturation 97 percent, pulse is 82 beats a minute, temp 36.6 degrees, blood pressure 117 over 82, respiratory rate 16."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.28,
      "end_seconds": 84.3,
      "duration_seconds": 3.02,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.55,
      "end_seconds": 88.49,
      "duration_seconds": 2.94,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.08,
      "end_seconds": 109.18,
      "duration_seconds": 5.1,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.43,
      "end_seconds": 118.27,
      "duration_seconds": 6.84,
      "text": "So, good, you can sit up again. And what about constipation or weight change?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.36,
      "end_seconds": 122.52,
      "duration_seconds": 2.16,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.07,
      "end_seconds": 125.84,
      "duration_seconds": 2.77,
      "text": "And what about palpitations or feeling cold?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.06,
      "end_seconds": 129.13,
      "duration_seconds": 2.07,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.14,
      "end_seconds": 132.91,
      "duration_seconds": 1.77,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.17,
      "end_seconds": 139.25,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.03,
      "end_seconds": 143.67,
      "duration_seconds": 2.64,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.24,
      "end_seconds": 147.87,
      "duration_seconds": 3.63,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.61,
      "end_seconds": 165.58,
      "duration_seconds": 4.97,
      "text": "Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.53,
      "end_seconds": 172.12,
      "duration_seconds": 4.59,
      "text": "Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 175.07,
      "duration_seconds": 2.32,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.52,
      "end_seconds": 187.16,
      "duration_seconds": 6.64,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.75,
      "end_seconds": 206.83,
      "duration_seconds": 5.08,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.12,
      "end_seconds": 210.11,
      "duration_seconds": 1.99,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 213.59,
      "duration_seconds": 2.7,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.17,
      "end_seconds": 216.64,
      "duration_seconds": 2.47,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.6,
      "end_seconds": 220.29,
      "duration_seconds": 1.69,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.08,
      "end_seconds": 227.18,
      "duration_seconds": 5.1,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.87,
      "end_seconds": 234.14,
      "duration_seconds": 2.27,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.68,
      "end_seconds": 238.78,
      "duration_seconds": 4.1,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.53,
      "end_seconds": 241.98,
      "duration_seconds": 2.45,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.54,
      "end_seconds": 246.62,
      "duration_seconds": 4.08,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.24,
      "end_seconds": 248.85,
      "duration_seconds": 1.61,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.71,
      "end_seconds": 252.85,
      "duration_seconds": 3.14,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.76,
      "end_seconds": 267.28,
      "duration_seconds": 2.52,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.11,
      "end_seconds": 271.45,
      "duration_seconds": 2.34,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.67,
      "end_seconds": 299.94,
      "duration_seconds": 24.27,
      "text": "Putting it all together, I think we're dealing with well-controlled thyroid replacement at this stage. That's my thinking for now, and it may change as we learn more. Let me repeat that back to make sure. You've been feeling well for three weeks, and no feeling cold or weight change."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.82,
      "end_seconds": 302.52,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.1,
      "end_seconds": 315.04,
      "duration_seconds": 4.94,
      "text": "I'll request a thyroid blood test, it'll help with annual review."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.88,
      "end_seconds": 319.15,
      "duration_seconds": 2.27,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.01,
      "end_seconds": 331.13,
      "duration_seconds": 11.12,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee. Please come and see me in twelve months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.05,
      "end_seconds": 335.99,
      "duration_seconds": 3.94,
      "text": "No, um, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.88,
      "end_seconds": 339.66,
      "duration_seconds": 1.78,
      "text": "Have a good day."
    }
  ]
}