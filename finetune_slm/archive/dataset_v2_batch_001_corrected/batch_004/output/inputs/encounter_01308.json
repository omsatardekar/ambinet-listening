{
  "schema_version": "1.0",
  "encounter_id": "01308",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.06,
      "duration_seconds": 2.99,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.3,
      "end_seconds": 9.49,
      "duration_seconds": 4.19,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.92,
      "end_seconds": 18.81,
      "duration_seconds": 7.89,
      "text": "Honestly, it's high fevers every other day, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.42,
      "duration_seconds": 3.23,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.01,
      "end_seconds": 29.37,
      "duration_seconds": 2.36,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 40.67,
      "duration_seconds": 2.77,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.38,
      "end_seconds": 49.72,
      "duration_seconds": 2.34,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 68.96,
      "duration_seconds": 9.08,
      "text": "okay: saturation 95 percent, respiratory rate 16, heart rate 91, blood pressure 116 over 70, temperature 39.0."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.31,
      "end_seconds": 74.84,
      "duration_seconds": 3.53,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.35,
      "end_seconds": 77.69,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.75,
      "end_seconds": 98.87,
      "duration_seconds": 4.12,
      "text": "You are hot and jaundiced, and your spleen is tender."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.89,
      "end_seconds": 117.95,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.3,
      "end_seconds": 128.6,
      "duration_seconds": 6.3,
      "text": "thank you, you can get dressed okay, a few quick ones: diarrhoea, rash or cough?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.54,
      "end_seconds": 133.49,
      "duration_seconds": 2.95,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.75,
      "end_seconds": 136.93,
      "duration_seconds": 2.18,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.29,
      "end_seconds": 140.06,
      "duration_seconds": 1.77,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.0,
      "end_seconds": 144.0,
      "duration_seconds": 3.0,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.11,
      "end_seconds": 147.51,
      "duration_seconds": 2.4,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.39,
      "end_seconds": 152.28,
      "duration_seconds": 3.89,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.06,
      "end_seconds": 155.55,
      "duration_seconds": 1.49,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.94,
      "end_seconds": 159.23,
      "duration_seconds": 2.29,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.68,
      "end_seconds": 164.78,
      "duration_seconds": 4.1,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.18,
      "end_seconds": 167.52,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.99,
      "end_seconds": 173.22,
      "duration_seconds": 4.23,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.1,
      "end_seconds": 177.5,
      "duration_seconds": 2.4,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.58,
      "end_seconds": 182.14,
      "duration_seconds": 3.56,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.54,
      "end_seconds": 193.92,
      "duration_seconds": 1.38,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.87,
      "end_seconds": 200.5,
      "duration_seconds": 1.63,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 207.07,
      "duration_seconds": 5.31,
      "text": "Okay, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.02,
      "end_seconds": 212.81,
      "duration_seconds": 3.79,
      "text": "I'm allergic to trimethoprim, I get a rash"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.74,
      "end_seconds": 241.01,
      "duration_seconds": 11.27,
      "text": "From what you've told me and what I found, I don't have a clear answer today: possible malaria after travel is possible, and and so is typhoid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.19,
      "end_seconds": 244.29,
      "duration_seconds": 2.1,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.03,
      "end_seconds": 265.29,
      "duration_seconds": 20.26,
      "text": "Nothing I've seen today points to an emergency. It looks like possible malaria after travel, but I'd like to confirm. Let's book blood tests to look into fever after travel. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 269.53,
      "end_seconds": 272.79,
      "duration_seconds": 3.26,
      "text": "The earliest is Tuesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.14,
      "end_seconds": 276.84,
      "duration_seconds": 2.7,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.3,
      "end_seconds": 287.02,
      "duration_seconds": 8.72,
      "text": "You need hospital assessment today, this can become serious fast. I think the the infectious diseases team should see you too."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.05,
      "end_seconds": 290.46,
      "duration_seconds": 2.41,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.16,
      "end_seconds": 302.33,
      "duration_seconds": 10.17,
      "text": "I'm not ordering urgent blood films today. If things carry on in a month, we'll consider it. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.35,
      "end_seconds": 306.4,
      "duration_seconds": 3.05,
      "text": "I think I understand everything. Thanks."
    }
  ]
}