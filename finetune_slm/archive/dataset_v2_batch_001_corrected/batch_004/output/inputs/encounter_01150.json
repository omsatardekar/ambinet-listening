{
  "schema_version": "1.0",
  "encounter_id": "01150",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 4.81,
      "duration_seconds": 3.56,
      "text": "Alright, good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.52,
      "end_seconds": 11.7,
      "duration_seconds": 3.18,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.03,
      "end_seconds": 15.76,
      "duration_seconds": 2.73,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.68,
      "end_seconds": 23.3,
      "duration_seconds": 5.62,
      "text": "Honestly, it's very heavy periods, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.15,
      "end_seconds": 25.48,
      "duration_seconds": 1.33,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.65,
      "end_seconds": 32.61,
      "duration_seconds": 1.96,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.01,
      "end_seconds": 36.19,
      "duration_seconds": 2.18,
      "text": "Alright, anything that improves it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.24,
      "end_seconds": 51.19,
      "duration_seconds": 13.95,
      "text": "Extra pads helps a bit. Right, I've been feeling tired too. As for feeling tired, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.81,
      "end_seconds": 57.13,
      "duration_seconds": 4.32,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.77,
      "end_seconds": 72.7,
      "duration_seconds": 2.93,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.62,
      "end_seconds": 92.9,
      "duration_seconds": 7.28,
      "text": "Okay: blood pressure 120 over 68, pulse 83, temperature 36.6. And saturation 99 percent."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.38,
      "end_seconds": 96.64,
      "duration_seconds": 2.26,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.23,
      "end_seconds": 98.32,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.5,
      "end_seconds": 102.62,
      "duration_seconds": 3.12,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.74,
      "end_seconds": 117.17,
      "duration_seconds": 6.43,
      "text": "The uterus feels enlarged and firm, about the size of a ten-week pregnancy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 122.01,
      "duration_seconds": 1.66,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.07,
      "end_seconds": 140.51,
      "duration_seconds": 3.44,
      "text": "Any weight loss or pain with sex?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.8,
      "end_seconds": 146.97,
      "duration_seconds": 5.17,
      "text": "No weight loss or pain with sex, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.95,
      "end_seconds": 151.95,
      "duration_seconds": 4.0,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.3,
      "end_seconds": 156.47,
      "duration_seconds": 3.17,
      "text": "Hmm, no, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.02,
      "end_seconds": 161.26,
      "duration_seconds": 4.24,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.0,
      "end_seconds": 167.31,
      "duration_seconds": 3.31,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.65,
      "end_seconds": 185.01,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.37,
      "end_seconds": 189.71,
      "duration_seconds": 3.34,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.25,
      "end_seconds": 209.18,
      "duration_seconds": 3.93,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.68,
      "end_seconds": 215.97,
      "duration_seconds": 5.29,
      "text": "I've had arthritis in my knees for about ten years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.37,
      "end_seconds": 218.19,
      "duration_seconds": 0.82,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.54,
      "end_seconds": 231.55,
      "duration_seconds": 5.01,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.27,
      "end_seconds": 247.52,
      "duration_seconds": 14.25,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. I live with my elderly mother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.89,
      "end_seconds": 252.33,
      "duration_seconds": 3.44,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.51,
      "end_seconds": 260.47,
      "duration_seconds": 6.96,
      "text": "Naproxen. I take it 250 milligrams, twice a day. It's tranexamic acid, during periods."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.56,
      "end_seconds": 263.82,
      "duration_seconds": 2.26,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.58,
      "end_seconds": 266.56,
      "duration_seconds": 0.98,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.04,
      "end_seconds": 286.3,
      "duration_seconds": 18.26,
      "text": "Putting it all together, it fits best with heavy periods, possibly from fibroids. I want to be honest that this is an impression, not a final answer. I'll request a blood count, it'll help with heavy periods."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 287.87,
      "end_seconds": 290.63,
      "duration_seconds": 2.76,
      "text": "The earliest is Monday, 9 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.7,
      "end_seconds": 299.54,
      "duration_seconds": 6.84,
      "text": "Keep a record of the bleeding with the pad count. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.21,
      "end_seconds": 304.04,
      "duration_seconds": 3.83,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}