{
  "schema_version": "1.0",
  "encounter_id": "01205",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 5.37,
      "duration_seconds": 4.14,
      "text": "So, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 11.91,
      "duration_seconds": 4.45,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.5,
      "end_seconds": 24.86,
      "duration_seconds": 11.36,
      "text": "I've been dealing with my face drooping on one side. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.49,
      "end_seconds": 31.55,
      "duration_seconds": 4.06,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.2,
      "end_seconds": 34.18,
      "duration_seconds": 1.98,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.8,
      "end_seconds": 38.5,
      "duration_seconds": 3.7,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.08,
      "end_seconds": 41.61,
      "duration_seconds": 1.53,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.96,
      "end_seconds": 45.18,
      "duration_seconds": 3.22,
      "text": "Yes. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.21,
      "end_seconds": 57.8,
      "duration_seconds": 10.59,
      "text": "A sudden headache goes along with it, most of the time. Well, the sudden headache? That's been for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.27,
      "end_seconds": 66.17,
      "duration_seconds": 6.9,
      "text": "Have you had your face drooping on one side before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.15,
      "end_seconds": 75.82,
      "duration_seconds": 7.67,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.56,
      "end_seconds": 88.7,
      "duration_seconds": 2.14,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.64,
      "end_seconds": 104.48,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.78,
      "end_seconds": 140.0,
      "duration_seconds": 14.22,
      "text": "Okay: SpO2 96 percent on room air, pulse 74, temp 36.9 degrees. And BP is 158 over 94, respiratory rate 18, weight 77 kilos, height 172 centimetres, BMI works out to 26.0."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.7,
      "end_seconds": 146.33,
      "duration_seconds": 3.63,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.0,
      "end_seconds": 148.97,
      "duration_seconds": 0.97,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.89,
      "end_seconds": 153.3,
      "duration_seconds": 2.41,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.82,
      "end_seconds": 177.55,
      "duration_seconds": 6.73,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.71,
      "end_seconds": 186.37,
      "duration_seconds": 5.66,
      "text": "That's the examination finished. A few quick ones: fever, loss of consciousness or seizure?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.12,
      "end_seconds": 190.35,
      "duration_seconds": 2.23,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.32,
      "end_seconds": 196.59,
      "duration_seconds": 2.27,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.65,
      "end_seconds": 201.0,
      "duration_seconds": 2.35,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.41,
      "end_seconds": 206.56,
      "duration_seconds": 4.15,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.43,
      "end_seconds": 210.54,
      "duration_seconds": 2.11,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.15,
      "end_seconds": 213.46,
      "duration_seconds": 2.31,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.55,
      "end_seconds": 223.39,
      "duration_seconds": 7.84,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.53,
      "end_seconds": 226.36,
      "duration_seconds": 1.83,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.22,
      "end_seconds": 232.27,
      "duration_seconds": 4.05,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.05,
      "end_seconds": 236.04,
      "duration_seconds": 2.99,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.33,
      "end_seconds": 240.5,
      "duration_seconds": 3.17,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.27,
      "end_seconds": 242.99,
      "duration_seconds": 1.72,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.55,
      "end_seconds": 246.12,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.31,
      "end_seconds": 264.19,
      "duration_seconds": 2.88,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.66,
      "end_seconds": 269.7,
      "duration_seconds": 4.04,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.34,
      "end_seconds": 274.25,
      "duration_seconds": 2.91,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.33,
      "end_seconds": 277.14,
      "duration_seconds": 1.81,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.12,
      "end_seconds": 280.81,
      "duration_seconds": 2.69,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.86,
      "end_seconds": 288.25,
      "duration_seconds": 3.39,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.51,
      "end_seconds": 317.05,
      "duration_seconds": 11.54,
      "text": "I'll request a blood sugar test, it'll help with stroke symptoms. I'll request an urgent CT scan of the head, it'll help with possible stroke."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.39,
      "end_seconds": 323.46,
      "duration_seconds": 3.07,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.27,
      "end_seconds": 338.41,
      "duration_seconds": 14.14,
      "text": "Call an ambulance now, you need hospital immediately. I'll also refer you to the stroke team. I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.33,
      "end_seconds": 341.79,
      "duration_seconds": 2.46,
      "text": "Alright, thanks, take care."
    }
  ]
}