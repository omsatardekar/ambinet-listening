{
  "schema_version": "1.0",
  "encounter_id": "01136",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 4.52,
      "duration_seconds": 3.56,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.74,
      "end_seconds": 10.39,
      "duration_seconds": 4.65,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.1,
      "end_seconds": 15.63,
      "duration_seconds": 4.53,
      "text": "Um, so... a racing heart. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.2,
      "end_seconds": 20.54,
      "duration_seconds": 3.34,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.73,
      "end_seconds": 25.59,
      "duration_seconds": 3.86,
      "text": "So, it's been going on for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.98,
      "end_seconds": 29.76,
      "duration_seconds": 2.78,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.92,
      "end_seconds": 34.67,
      "duration_seconds": 3.75,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.62,
      "end_seconds": 38.75,
      "duration_seconds": 3.13,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.57,
      "end_seconds": 54.04,
      "duration_seconds": 13.47,
      "text": "sorry, what was I saying, when it starts I tend to get shaky hands as well. The shaky hands? That's been since last night"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.39,
      "end_seconds": 57.68,
      "duration_seconds": 2.29,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.25,
      "end_seconds": 63.67,
      "duration_seconds": 4.42,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.51,
      "end_seconds": 67.53,
      "duration_seconds": 3.02,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.54,
      "end_seconds": 72.79,
      "duration_seconds": 3.25,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.79,
      "end_seconds": 79.11,
      "duration_seconds": 4.32,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.19,
      "end_seconds": 84.66,
      "duration_seconds": 3.47,
      "text": "Hmm, I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.24,
      "end_seconds": 96.4,
      "duration_seconds": 3.16,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.9,
      "end_seconds": 99.09,
      "duration_seconds": 1.19,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.54,
      "end_seconds": 104.81,
      "duration_seconds": 4.27,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 108.02,
      "duration_seconds": 1.76,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.16,
      "end_seconds": 115.6,
      "duration_seconds": 5.44,
      "text": "Let me check a few things. Any chest pain, neck pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.18,
      "end_seconds": 120.21,
      "duration_seconds": 3.03,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.05,
      "end_seconds": 124.61,
      "duration_seconds": 2.56,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.93,
      "end_seconds": 129.93,
      "duration_seconds": 4.0,
      "text": "Yeah, you know, no, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.67,
      "end_seconds": 132.92,
      "duration_seconds": 2.25,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.32,
      "end_seconds": 139.88,
      "duration_seconds": 2.56,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.98,
      "end_seconds": 160.07,
      "duration_seconds": 4.09,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.14,
      "end_seconds": 175.65,
      "duration_seconds": 2.51,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.91,
      "end_seconds": 208.5,
      "duration_seconds": 13.59,
      "text": "Okay: height 169 centimetres, pulse 125, BMI works out to 24.9, SpO2 99 percent on room air, weight 71 kilos, BP is 134 over 81, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.07,
      "end_seconds": 213.25,
      "duration_seconds": 3.18,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.92,
      "end_seconds": 217.82,
      "duration_seconds": 2.9,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.06,
      "end_seconds": 238.67,
      "duration_seconds": 5.61,
      "text": "you have a fine tremor and your pulse is fast and regular"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.21,
      "end_seconds": 244.45,
      "duration_seconds": 2.24,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.03,
      "end_seconds": 286.28,
      "duration_seconds": 30.25,
      "text": "We should do thyroid blood tests for weight loss and palpitations. I'll request an ECG, it'll help with palpitations. The result will help us decide whether anything more is needed. I'll start you on propranolol, 20 milligrams, twice a day, until review. That's for racing heart and tremor. Avoid caffeine while the heart is racing. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.23,
      "end_seconds": 295.88,
      "duration_seconds": 7.65,
      "text": "the thing that would worry me is if the symptoms get worse if that happens, go to emergency"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.69,
      "end_seconds": 299.25,
      "duration_seconds": 2.56,
      "text": "Alright, uh, I follow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.09,
      "end_seconds": 308.0,
      "duration_seconds": 6.91,
      "text": "book a review after the thyroid results. Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.08,
      "end_seconds": 314.41,
      "duration_seconds": 4.33,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}