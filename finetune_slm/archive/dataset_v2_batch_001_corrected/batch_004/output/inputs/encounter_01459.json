{
  "schema_version": "1.0",
  "encounter_id": "01459",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.04,
      "duration_seconds": 3.48,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 9.1,
      "duration_seconds": 3.64,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.08,
      "end_seconds": 19.44,
      "duration_seconds": 5.36,
      "text": "Um, so... a smelly discharge. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.02,
      "end_seconds": 26.08,
      "duration_seconds": 5.06,
      "text": "So, when did this begin? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.59,
      "end_seconds": 34.32,
      "duration_seconds": 7.73,
      "text": "It's been like this since yesterday. I've also had a high fever, for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.96,
      "end_seconds": 55.2,
      "duration_seconds": 3.24,
      "text": "Have you had any recent pregnancy or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.3,
      "end_seconds": 59.59,
      "duration_seconds": 3.29,
      "text": "No, no recent pregnancy or vomiting."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.14,
      "end_seconds": 65.1,
      "duration_seconds": 3.96,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.04,
      "end_seconds": 69.27,
      "duration_seconds": 2.23,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.45,
      "end_seconds": 74.81,
      "duration_seconds": 4.36,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.34,
      "end_seconds": 81.84,
      "duration_seconds": 1.5,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.95,
      "end_seconds": 97.64,
      "duration_seconds": 1.69,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.91,
      "end_seconds": 103.88,
      "duration_seconds": 4.97,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.45,
      "end_seconds": 106.07,
      "duration_seconds": 1.62,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.25,
      "end_seconds": 109.85,
      "duration_seconds": 2.6,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.65,
      "end_seconds": 115.08,
      "duration_seconds": 3.43,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.59,
      "end_seconds": 120.76,
      "duration_seconds": 4.17,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 126.17,
      "duration_seconds": 3.79,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.77,
      "end_seconds": 129.66,
      "duration_seconds": 2.89,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 148.05,
      "duration_seconds": 2.5,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.92,
      "end_seconds": 155.6,
      "duration_seconds": 2.68,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.28,
      "end_seconds": 162.0,
      "duration_seconds": 5.72,
      "text": "Right, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.61,
      "end_seconds": 169.24,
      "duration_seconds": 5.63,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.7,
      "end_seconds": 186.38,
      "duration_seconds": 2.68,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.86,
      "end_seconds": 197.69,
      "duration_seconds": 2.83,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.09,
      "end_seconds": 221.16,
      "duration_seconds": 7.07,
      "text": "Okay: pressure 119 over 78, temperature is 38.5 degrees, pulse 99, respiratory rate 20."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.24,
      "end_seconds": 226.8,
      "duration_seconds": 4.56,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.08,
      "end_seconds": 230.08,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.96,
      "end_seconds": 250.89,
      "duration_seconds": 7.93,
      "text": "You are very tender low in the tummy, and it hurts when I move the cervix."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.28,
      "end_seconds": 270.52,
      "duration_seconds": 17.24,
      "text": "Thank you, you can get dressed. Taking everything into account, it's hard to say. Severe pelvic inflammatory disease is one possibility and an abscess another, and I'd rather not commit yet. I'll request a pelvic scan, it'll help with pelvic pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.6,
      "end_seconds": 274.71,
      "duration_seconds": 3.11,
      "text": "Mm, how long will it take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.5,
      "end_seconds": 305.72,
      "duration_seconds": 30.22,
      "text": "I'll start you on ceftriaxone, 1 gram, once now, single dose. That should help with pelvic infection. It's a commonly used medicine and most people tolerate it well. You need hospital treatment today. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. The gynaecology team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.04,
      "end_seconds": 307.74,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.57,
      "end_seconds": 311.61,
      "duration_seconds": 2.04,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.1,
      "end_seconds": 313.8,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.87,
      "end_seconds": 322.55,
      "duration_seconds": 3.68,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.85,
      "end_seconds": 326.17,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    }
  ]
}