{
  "schema_version": "1.0",
  "encounter_id": "01471",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 7.62,
      "duration_seconds": 6.85,
      "text": "erm, hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.2,
      "end_seconds": 13.6,
      "duration_seconds": 4.4,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.54,
      "end_seconds": 20.41,
      "duration_seconds": 5.87,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.24,
      "end_seconds": 25.69,
      "duration_seconds": 4.45,
      "text": "So, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.63,
      "end_seconds": 33.97,
      "duration_seconds": 7.34,
      "text": "It's an itchy patch on my wrist, doctor. He didn't wanna come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.49,
      "end_seconds": 36.88,
      "duration_seconds": 2.39,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.07,
      "end_seconds": 44.16,
      "duration_seconds": 6.09,
      "text": "I'd say about four days. Actually, no, closer to five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.94,
      "end_seconds": 50.76,
      "duration_seconds": 4.82,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.62,
      "end_seconds": 63.59,
      "duration_seconds": 10.97,
      "text": "I'd call it mild. It's worse with my new watch strap. Oh, and a bit of redness. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.57,
      "end_seconds": 72.78,
      "duration_seconds": 7.21,
      "text": "Have you had an itchy patch on your wrist before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.95,
      "end_seconds": 79.38,
      "duration_seconds": 5.43,
      "text": "I, I had a similar thing last year. It went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 80.52,
      "end_seconds": 82.8,
      "duration_seconds": 2.28,
      "text": "yes, exactly like that"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 87.01,
      "duration_seconds": 2.29,
      "text": "have you had any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.03,
      "end_seconds": 91.35,
      "duration_seconds": 2.32,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 93.1,
      "end_seconds": 98.67,
      "duration_seconds": 5.57,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.53,
      "end_seconds": 107.44,
      "duration_seconds": 6.91,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.25,
      "end_seconds": 118.01,
      "duration_seconds": 8.76,
      "text": "Alright, I'll note both what you've said and what you've noticed. Let me check a few things. Any blisters or spreading?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.63,
      "end_seconds": 130.03,
      "duration_seconds": 10.4,
      "text": "No, no blisters, no spreading. I did have dry flaky skin at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.22,
      "end_seconds": 135.62,
      "duration_seconds": 4.4,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.11,
      "end_seconds": 139.35,
      "duration_seconds": 2.24,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.57,
      "end_seconds": 142.7,
      "duration_seconds": 2.13,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.28,
      "end_seconds": 145.9,
      "duration_seconds": 1.62,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.33,
      "end_seconds": 151.21,
      "duration_seconds": 3.88,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.78,
      "end_seconds": 157.23,
      "duration_seconds": 5.45,
      "text": "I have high cholesterol, for two years. Asthma, for five years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.27,
      "end_seconds": 159.21,
      "duration_seconds": 0.94,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.53,
      "end_seconds": 164.69,
      "duration_seconds": 4.16,
      "text": "I've had diabetes for about a year now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.49,
      "end_seconds": 172.8,
      "duration_seconds": 6.31,
      "text": "Okay, I can see high cholesterol and diabetes in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.83,
      "end_seconds": 184.22,
      "duration_seconds": 3.39,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.78,
      "end_seconds": 189.69,
      "duration_seconds": 4.91,
      "text": "My uncle has high cholesterol. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.55,
      "end_seconds": 199.4,
      "duration_seconds": 4.85,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.05,
      "end_seconds": 207.62,
      "duration_seconds": 7.57,
      "text": "It's rosuvastatin, 10 milligrams, at night. I'm on Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 209.14,
      "end_seconds": 214.52,
      "duration_seconds": 5.38,
      "text": "that's what's prescribed, but I'm not sure he takes it every day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.61,
      "end_seconds": 222.19,
      "duration_seconds": 5.58,
      "text": "it's sitagliptin, 100 milligrams, once a day for my sugar"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.73,
      "end_seconds": 223.79,
      "duration_seconds": 1.06,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.54,
      "end_seconds": 228.04,
      "duration_seconds": 3.5,
      "text": "A plain moisturiser, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.02,
      "end_seconds": 233.06,
      "duration_seconds": 3.04,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.42,
      "end_seconds": 236.07,
      "duration_seconds": 1.65,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.43,
      "end_seconds": 238.71,
      "duration_seconds": 1.28,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.97,
      "end_seconds": 247.5,
      "duration_seconds": 3.53,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.43,
      "end_seconds": 251.41,
      "duration_seconds": 2.98,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.75,
      "end_seconds": 259.54,
      "duration_seconds": 4.79,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.8,
      "end_seconds": 263.42,
      "duration_seconds": 2.62,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.5,
      "end_seconds": 275.4,
      "duration_seconds": 9.9,
      "text": "I think I reacted to to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 276.29,
      "end_seconds": 288.08,
      "duration_seconds": 11.79,
      "text": "Okay, so the vitals from earlier. Weight 91 kilos, blood pressure 121 over 76, SpO2 97 percent on room air, BMI works out to 28.7, pulse 65, height 178 centimetres."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.08,
      "end_seconds": 302.05,
      "duration_seconds": 11.97,
      "text": "Good, thank you. So, based on your history, it points towards mild contact dermatitis from the watch strap. Eczema is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.17,
      "end_seconds": 324.36,
      "duration_seconds": 6.19,
      "text": "I'm prescribing hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.15,
      "end_seconds": 327.8,
      "duration_seconds": 1.65,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.25,
      "end_seconds": 338.49,
      "duration_seconds": 9.24,
      "text": "stop wearing that strap and keep the skin moisturised come back if it has not cleared in two weeks"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 339.75,
      "end_seconds": 342.97,
      "duration_seconds": 3.22,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.19,
      "end_seconds": 348.5,
      "duration_seconds": 4.31,
      "text": "Uh, uh, I can manage that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.68,
      "end_seconds": 353.7,
      "duration_seconds": 4.02,
      "text": "so, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.01,
      "end_seconds": 358.43,
      "duration_seconds": 3.42,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.26,
      "end_seconds": 360.54,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}