{
  "schema_version": "1.0",
  "encounter_id": "01250",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 5.07,
      "duration_seconds": 4.2,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.03,
      "end_seconds": 15.36,
      "duration_seconds": 4.33,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.37,
      "end_seconds": 21.93,
      "duration_seconds": 5.56,
      "text": "Yeah, it's a dry mouth. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 22.96,
      "end_seconds": 33.76,
      "duration_seconds": 10.8,
      "text": "Here are the numbers, doctor. Heart rate 108, oxygen saturation is 99 percent, pressure 99 over 65. Height 182 centimetres, weight 87 kilos, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.69,
      "end_seconds": 39.23,
      "duration_seconds": 4.54,
      "text": "Okay, noted. How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.8,
      "end_seconds": 44.02,
      "duration_seconds": 3.22,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.45,
      "end_seconds": 48.77,
      "duration_seconds": 3.32,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.71,
      "end_seconds": 51.62,
      "duration_seconds": 1.91,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.96,
      "end_seconds": 56.88,
      "duration_seconds": 3.92,
      "text": "What about dizziness on standing, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.52,
      "end_seconds": 66.31,
      "duration_seconds": 7.79,
      "text": "Yes, actually. With dizziness on standing, I'd say a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.86,
      "end_seconds": 70.41,
      "duration_seconds": 2.55,
      "text": "Right, has there been constipation too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.12,
      "end_seconds": 80.56,
      "duration_seconds": 9.44,
      "text": "Right, yes, for about four days. With constipation, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.52,
      "end_seconds": 84.56,
      "duration_seconds": 2.04,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.62,
      "end_seconds": 89.19,
      "duration_seconds": 2.57,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.92,
      "end_seconds": 93.75,
      "duration_seconds": 2.83,
      "text": "Any chest pain or falls at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.35,
      "end_seconds": 97.26,
      "duration_seconds": 2.91,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.91,
      "end_seconds": 100.0,
      "duration_seconds": 2.09,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.2,
      "end_seconds": 107.01,
      "duration_seconds": 3.81,
      "text": "Ah, uh, no problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.77,
      "end_seconds": 111.97,
      "duration_seconds": 3.2,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.11,
      "end_seconds": 115.98,
      "duration_seconds": 2.87,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.66,
      "end_seconds": 120.14,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.0,
      "end_seconds": 124.1,
      "duration_seconds": 3.1,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.99,
      "end_seconds": 143.41,
      "duration_seconds": 2.42,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.18,
      "end_seconds": 148.87,
      "duration_seconds": 4.69,
      "text": "Yes, amoxicillin. I get a rash all over."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.53,
      "end_seconds": 152.97,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.95,
      "end_seconds": 173.84,
      "duration_seconds": 15.89,
      "text": "Nothing, I'm teetotal. I gave up cigarettes last spring. Lots of rice, lentils and some fruit. I live with my elderly mother. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.35,
      "end_seconds": 188.94,
      "duration_seconds": 3.59,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.5,
      "end_seconds": 198.55,
      "duration_seconds": 8.05,
      "text": "Losartan. I take it 50 milligrams, maybe, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.21,
      "end_seconds": 203.62,
      "duration_seconds": 3.41,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.62,
      "end_seconds": 213.14,
      "duration_seconds": 8.52,
      "text": "Not with me. I'll bring it next time. Febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 219.45,
      "end_seconds": 224.14,
      "duration_seconds": 4.69,
      "text": "Doctor, our chart from the last visit lists it as 160 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.38,
      "end_seconds": 229.35,
      "duration_seconds": 3.97,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.62,
      "end_seconds": 237.56,
      "duration_seconds": 4.94,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.51,
      "end_seconds": 242.68,
      "duration_seconds": 4.17,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.16,
      "end_seconds": 253.05,
      "duration_seconds": 4.89,
      "text": "My daughter has type 1 diabetes. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.39,
      "end_seconds": 268.52,
      "duration_seconds": 4.13,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.17,
      "end_seconds": 285.1,
      "duration_seconds": 15.93,
      "text": "Arthritis in my knees, for five years. I've had high blood pressure for two years now. I kept putting it off, um, which I know isn't sensible. Yes, gout."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.74,
      "end_seconds": 288.83,
      "duration_seconds": 2.09,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 290.38,
      "end_seconds": 291.59,
      "duration_seconds": 1.21,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.75,
      "end_seconds": 294.75,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.09,
      "end_seconds": 311.37,
      "duration_seconds": 3.28,
      "text": "Your blood pressure drops a little on standing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.9,
      "end_seconds": 326.13,
      "duration_seconds": 10.23,
      "text": "Okay, that's enough for me. Putting it all together, it points towards side effects from several medicines taken together. Dehydration is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 327.1,
      "end_seconds": 329.96,
      "duration_seconds": 2.86,
      "text": "Erm, will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.52,
      "end_seconds": 351.97,
      "duration_seconds": 20.45,
      "text": "It's reasonable to be concerned, but right now side effects from several medicines taken together is my leading thought, not anything worse. I'm going to order a medication review, for polypharmacy. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.16,
      "end_seconds": 354.64,
      "duration_seconds": 1.48,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.6,
      "end_seconds": 388.91,
      "duration_seconds": 33.31,
      "text": "I'm going to order blood tests, for dizziness. We will stop the sleeping tablet slowly over two weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's plan a check in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 390.33,
      "end_seconds": 395.08,
      "duration_seconds": 4.75,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}