{
  "schema_version": "1.0",
  "encounter_id": "01352",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 2.84,
      "duration_seconds": 1.77,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.89,
      "end_seconds": 8.34,
      "duration_seconds": 4.45,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.77,
      "end_seconds": 17.2,
      "duration_seconds": 7.43,
      "text": "Mainly skipped beats. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.67,
      "end_seconds": 22.73,
      "duration_seconds": 4.06,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.7,
      "end_seconds": 33.5,
      "duration_seconds": 9.8,
      "text": "It's been one week, I'm fairly sure. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.03,
      "end_seconds": 43.88,
      "duration_seconds": 8.85,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.91,
      "end_seconds": 54.77,
      "duration_seconds": 8.86,
      "text": "Erm, it sort of comes and goes. Deep breaths helps a bit. It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.59,
      "end_seconds": 58.73,
      "duration_seconds": 2.14,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.64,
      "end_seconds": 66.46,
      "duration_seconds": 5.82,
      "text": "I mean, it usually comes with a flutter in my chest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.0,
      "end_seconds": 71.2,
      "duration_seconds": 3.2,
      "text": "Has there been being a bit anxious too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.83,
      "end_seconds": 83.22,
      "duration_seconds": 11.39,
      "text": "Yes, I have. Sorry, what was I saying, the flutter in my chest? That's been for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.38,
      "end_seconds": 87.7,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.61,
      "end_seconds": 91.13,
      "duration_seconds": 2.52,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.2,
      "end_seconds": 97.49,
      "duration_seconds": 4.29,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.4,
      "end_seconds": 101.43,
      "duration_seconds": 3.03,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.44,
      "end_seconds": 107.08,
      "duration_seconds": 4.64,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.85,
      "end_seconds": 111.97,
      "duration_seconds": 4.12,
      "text": "No, uh, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.57,
      "end_seconds": 116.85,
      "duration_seconds": 4.28,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.95,
      "end_seconds": 128.66,
      "duration_seconds": 10.71,
      "text": "I do a yoga class on Thursdays. Lots of rice, lentils and some fruit. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.38,
      "end_seconds": 133.3,
      "duration_seconds": 3.92,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.72,
      "end_seconds": 138.73,
      "duration_seconds": 4.01,
      "text": "I'm on herbal calming tea, in the evening."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.58,
      "end_seconds": 144.08,
      "duration_seconds": 3.5,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.72,
      "end_seconds": 152.93,
      "duration_seconds": 4.21,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.69,
      "end_seconds": 156.89,
      "duration_seconds": 3.2,
      "text": "Any shortness of breath or fainting at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.09,
      "end_seconds": 163.48,
      "duration_seconds": 5.39,
      "text": "No shortness of breath or fainting, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.47,
      "end_seconds": 168.72,
      "duration_seconds": 3.25,
      "text": "Any dizziness or chest pain at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.04,
      "end_seconds": 173.2,
      "duration_seconds": 3.16,
      "text": "Hmm, none of those, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.97,
      "end_seconds": 180.16,
      "duration_seconds": 5.19,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.86,
      "end_seconds": 184.28,
      "duration_seconds": 3.42,
      "text": "Hmm, no weakness or anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.61,
      "end_seconds": 197.37,
      "duration_seconds": 4.76,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.59,
      "end_seconds": 208.54,
      "duration_seconds": 2.95,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.13,
      "end_seconds": 229.93,
      "duration_seconds": 7.8,
      "text": "Okay: BP is 125 over 79, SpO2 99 percent on room air, temperature 36.8, pulse 69."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.13,
      "end_seconds": 234.57,
      "duration_seconds": 3.44,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.93,
      "end_seconds": 237.6,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.39,
      "end_seconds": 240.98,
      "duration_seconds": 1.59,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 262.68,
      "duration_seconds": 4.27,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.77,
      "end_seconds": 267.03,
      "duration_seconds": 3.26,
      "text": "Yeah, you know, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.77,
      "end_seconds": 273.31,
      "duration_seconds": 2.54,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.52,
      "end_seconds": 291.14,
      "duration_seconds": 5.62,
      "text": "So where does that leave us? My working impression is harmless extra heartbeats."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.21,
      "end_seconds": 297.37,
      "duration_seconds": 5.16,
      "text": "Well, uh, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.19,
      "end_seconds": 304.95,
      "duration_seconds": 6.76,
      "text": "I can't promise yet, but most people with harmless extra heartbeats do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.38,
      "end_seconds": 319.52,
      "duration_seconds": 3.14,
      "text": "We should do an ECG for palpitations."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 320.1,
      "end_seconds": 322.5,
      "duration_seconds": 2.4,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.8,
      "end_seconds": 338.95,
      "duration_seconds": 15.15,
      "text": "Cut back on coffee and energy drinks and keep a diary of when it happens. I'd like you back if it carries on after a month. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.01,
      "end_seconds": 348.86,
      "duration_seconds": 8.85,
      "text": "So, you know, I come back if it carries on after a month. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.48,
      "end_seconds": 354.23,
      "duration_seconds": 3.75,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.08,
      "end_seconds": 359.78,
      "duration_seconds": 3.7,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}