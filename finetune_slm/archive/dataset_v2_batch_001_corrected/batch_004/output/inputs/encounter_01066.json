{
  "schema_version": "1.0",
  "encounter_id": "01066",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 3.73,
      "duration_seconds": 3.17,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.58,
      "end_seconds": 7.73,
      "duration_seconds": 2.15,
      "text": "hello, you know, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.43,
      "end_seconds": 10.68,
      "duration_seconds": 1.25,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.39,
      "end_seconds": 30.17,
      "duration_seconds": 18.78,
      "text": "Mm, it's I can't get my breath. I thought I'd wait, but it hasn't gone. I looked a few things up online, and that probably didn't help. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.75,
      "end_seconds": 33.01,
      "duration_seconds": 2.26,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.81,
      "end_seconds": 38.03,
      "duration_seconds": 3.22,
      "text": "well, no, nothing at the moment"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.09,
      "end_seconds": 43.01,
      "duration_seconds": 2.92,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.02,
      "end_seconds": 46.76,
      "duration_seconds": 2.74,
      "text": "Probably about a month. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.3,
      "end_seconds": 58.58,
      "duration_seconds": 10.28,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.25,
      "end_seconds": 65.85,
      "duration_seconds": 6.6,
      "text": "I mean, you know, it happens all the time. It feels severe to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.38,
      "end_seconds": 69.81,
      "duration_seconds": 3.43,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.75,
      "end_seconds": 79.69,
      "duration_seconds": 7.94,
      "text": "Not being able to finish a sentence goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.7,
      "end_seconds": 85.48,
      "duration_seconds": 4.78,
      "text": "Have you had any fever, chest pain or blue tinge?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.13,
      "end_seconds": 92.2,
      "duration_seconds": 5.07,
      "text": "No fever, chest pain or blue tinge, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.39,
      "end_seconds": 100.73,
      "duration_seconds": 3.34,
      "text": "So, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.3,
      "end_seconds": 105.13,
      "duration_seconds": 2.83,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.85,
      "end_seconds": 108.86,
      "duration_seconds": 3.01,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.24,
      "end_seconds": 112.17,
      "duration_seconds": 1.93,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.29,
      "end_seconds": 122.22,
      "duration_seconds": 2.93,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.6,
      "end_seconds": 124.8,
      "duration_seconds": 1.2,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.83,
      "end_seconds": 128.79,
      "duration_seconds": 1.96,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.77,
      "end_seconds": 132.79,
      "duration_seconds": 2.02,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.22,
      "end_seconds": 134.92,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.81,
      "end_seconds": 147.46,
      "duration_seconds": 3.65,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.2,
      "end_seconds": 152.56,
      "duration_seconds": 3.36,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.38,
      "end_seconds": 154.55,
      "duration_seconds": 1.17,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.54,
      "end_seconds": 159.57,
      "duration_seconds": 3.03,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.14,
      "end_seconds": 162.49,
      "duration_seconds": 1.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.34,
      "end_seconds": 167.74,
      "duration_seconds": 3.4,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.51,
      "end_seconds": 174.51,
      "duration_seconds": 2.0,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.94,
      "end_seconds": 180.39,
      "duration_seconds": 4.45,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.55,
      "end_seconds": 184.6,
      "duration_seconds": 3.05,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.22,
      "end_seconds": 190.81,
      "duration_seconds": 4.59,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.6,
      "end_seconds": 196.9,
      "duration_seconds": 4.3,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.47,
      "end_seconds": 209.39,
      "duration_seconds": 2.92,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.96,
      "end_seconds": 242.63,
      "duration_seconds": 11.67,
      "text": "Okay: respiratory rate 24, SpO2 90 percent on room air. And temperature 37.3, BP is 120 over 86, pulse is 102 beats a minute."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.31,
      "end_seconds": 245.77,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.18,
      "end_seconds": 252.11,
      "duration_seconds": 4.93,
      "text": "Alright, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.53,
      "end_seconds": 258.41,
      "duration_seconds": 4.88,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 261.13,
      "duration_seconds": 1.63,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.56,
      "end_seconds": 274.04,
      "duration_seconds": 5.48,
      "text": "you are using your neck muscles to breathe, and your oxygen is low"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.49,
      "end_seconds": 282.26,
      "duration_seconds": 2.77,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.91,
      "end_seconds": 308.49,
      "duration_seconds": 16.58,
      "text": "So where does that leave us? This is probably a severe asthma attack. Let me just check I've got this right. You've had you can't get your breath for about a month, severe, and no fever or blue tinge."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.18,
      "end_seconds": 311.66,
      "duration_seconds": 2.48,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.18,
      "end_seconds": 333.45,
      "duration_seconds": 9.27,
      "text": "I'd like to arrange a peak flow for asthma attack. I think a chest X-ray makes sense here, for severe breathlessness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.59,
      "end_seconds": 336.29,
      "duration_seconds": 1.7,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.91,
      "end_seconds": 370.03,
      "duration_seconds": 30.12,
      "text": "What I'm giving you is salbutamol, 5 milligrams, now, single dose. It's for asthma attack. Sit upright and take slow breaths while the nebuliser is set up. I'd like you to see the emergency team as well, and I'll write the referral. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'll want another look straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.91,
      "end_seconds": 376.18,
      "duration_seconds": 4.27,
      "text": "Great, uh, thank you for your help."
    }
  ]
}