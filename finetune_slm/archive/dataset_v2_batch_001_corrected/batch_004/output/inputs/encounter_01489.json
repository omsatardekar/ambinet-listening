{
  "schema_version": "1.0",
  "encounter_id": "01489",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 4.58,
      "duration_seconds": 3.56,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.12,
      "end_seconds": 9.17,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.98,
      "end_seconds": 18.95,
      "duration_seconds": 7.97,
      "text": "I've been waking at night with wheeze, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.38,
      "end_seconds": 22.59,
      "duration_seconds": 2.21,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.43,
      "end_seconds": 39.23,
      "duration_seconds": 11.8,
      "text": "Okay, uh, so ever since... since this morning, really. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.52,
      "end_seconds": 43.33,
      "duration_seconds": 2.81,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.32,
      "end_seconds": 51.99,
      "duration_seconds": 3.67,
      "text": "Yeah, it feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.15,
      "end_seconds": 59.02,
      "duration_seconds": 2.87,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.01,
      "end_seconds": 72.33,
      "duration_seconds": 11.32,
      "text": "It usually comes with a tight chest after exercise. As for tight chest after exercise, it happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.73,
      "end_seconds": 77.59,
      "duration_seconds": 3.86,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.6,
      "end_seconds": 90.91,
      "duration_seconds": 3.31,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.77,
      "end_seconds": 117.64,
      "duration_seconds": 9.87,
      "text": "Okay: heart rate 72, BP is 124 over 68, SpO2 98 percent on room air, temperature is 36.7 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.16,
      "end_seconds": 120.62,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.52,
      "end_seconds": 124.13,
      "duration_seconds": 2.61,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.66,
      "end_seconds": 130.3,
      "duration_seconds": 3.64,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.87,
      "end_seconds": 133.81,
      "duration_seconds": 1.94,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.78,
      "end_seconds": 153.12,
      "duration_seconds": 5.34,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 159.21,
      "duration_seconds": 2.78,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.07,
      "end_seconds": 172.1,
      "duration_seconds": 3.03,
      "text": "And chest pain, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.6,
      "end_seconds": 181.42,
      "duration_seconds": 3.82,
      "text": "Yeah, not at all, no chest pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.42,
      "end_seconds": 184.78,
      "duration_seconds": 2.36,
      "text": "Any fever or leg swelling?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.02,
      "end_seconds": 193.68,
      "duration_seconds": 3.66,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.56,
      "end_seconds": 200.89,
      "duration_seconds": 3.33,
      "text": "Right, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.26,
      "end_seconds": 204.21,
      "duration_seconds": 1.95,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.93,
      "end_seconds": 210.12,
      "duration_seconds": 4.19,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.61,
      "end_seconds": 217.02,
      "duration_seconds": 5.41,
      "text": "Seretide inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 222.55,
      "duration_seconds": 4.07,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.02,
      "end_seconds": 246.4,
      "duration_seconds": 22.38,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. My partner and our baby. I drink a lot of tea and snack through the day. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.93,
      "end_seconds": 266.35,
      "duration_seconds": 3.42,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.42,
      "end_seconds": 270.64,
      "duration_seconds": 2.22,
      "text": "I've, I've got asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.86,
      "end_seconds": 284.58,
      "duration_seconds": 8.72,
      "text": "Yes, asthma is known to us, good to have that clear. Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.18,
      "end_seconds": 287.97,
      "duration_seconds": 1.79,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.11,
      "end_seconds": 291.2,
      "duration_seconds": 2.09,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.88,
      "end_seconds": 305.57,
      "duration_seconds": 12.69,
      "text": "Yeah, uh, yes, I had a mole taken off my arm, a few years ago. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.07,
      "end_seconds": 322.8,
      "duration_seconds": 16.73,
      "text": "Right, here's what I'm thinking. The most likely explanation is poorly controlled asthma. That's my thinking for now, and it may change as we learn more. I'd also keep an inhaler technique problem in mind."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.33,
      "end_seconds": 327.54,
      "duration_seconds": 3.21,
      "text": "So, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.32,
      "end_seconds": 336.53,
      "duration_seconds": 8.21,
      "text": "It's reasonable to be concerned, but right now poorly controlled asthma is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.11,
      "end_seconds": 389.21,
      "duration_seconds": 34.1,
      "text": "I'm going to order a peak flow reading, for asthma. For this, beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term. That's for asthma control. Use the spacer and rinse your mouth after the preventer. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's review you in four weeks. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.08,
      "end_seconds": 392.78,
      "duration_seconds": 2.7,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.54,
      "end_seconds": 396.99,
      "duration_seconds": 2.45,
      "text": "Okay, have a good day."
    }
  ]
}