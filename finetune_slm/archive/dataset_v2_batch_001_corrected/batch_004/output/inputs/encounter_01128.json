{
  "schema_version": "1.0",
  "encounter_id": "01128",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 2.8,
      "duration_seconds": 2.09,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.9,
      "end_seconds": 9.09,
      "duration_seconds": 5.19,
      "text": "Right, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.84,
      "end_seconds": 13.25,
      "duration_seconds": 2.41,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.37,
      "end_seconds": 33.13,
      "duration_seconds": 14.76,
      "text": "Uh, uh, mainly I've been waking at night with wheeze. That's why I came. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.09,
      "end_seconds": 39.1,
      "duration_seconds": 4.01,
      "text": "Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.88,
      "end_seconds": 42.89,
      "duration_seconds": 2.01,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.07,
      "end_seconds": 47.26,
      "duration_seconds": 3.19,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.04,
      "end_seconds": 49.95,
      "duration_seconds": 0.91,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.01,
      "end_seconds": 54.63,
      "duration_seconds": 3.62,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.31,
      "end_seconds": 59.94,
      "duration_seconds": 3.63,
      "text": "Seretide inhaler. I take it twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.73,
      "end_seconds": 65.08,
      "duration_seconds": 4.35,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.07,
      "end_seconds": 74.58,
      "duration_seconds": 8.51,
      "text": "I've had asthma for five years now. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.35,
      "end_seconds": 86.76,
      "duration_seconds": 7.41,
      "text": "Ah. Alright, asthma, that matches what I have here. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.51,
      "end_seconds": 92.59,
      "duration_seconds": 5.08,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.09,
      "end_seconds": 112.64,
      "duration_seconds": 5.55,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.4,
      "end_seconds": 133.23,
      "duration_seconds": 19.83,
      "text": "I only drink at family occasions. I quit smoking around ten years ago. No, I share a house with my brother. I'm vegetarian and have been for years. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.79,
      "end_seconds": 154.86,
      "duration_seconds": 6.07,
      "text": "Have you got any known allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.4,
      "end_seconds": 161.53,
      "duration_seconds": 5.13,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.86,
      "end_seconds": 168.12,
      "duration_seconds": 5.26,
      "text": "Let me check a few things. Any leg swelling, fever or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.03,
      "end_seconds": 174.2,
      "duration_seconds": 4.17,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.91,
      "end_seconds": 179.19,
      "duration_seconds": 3.28,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.49,
      "end_seconds": 183.33,
      "duration_seconds": 2.84,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.95,
      "end_seconds": 195.39,
      "duration_seconds": 2.44,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.26,
      "end_seconds": 207.64,
      "duration_seconds": 2.38,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.74,
      "end_seconds": 229.76,
      "duration_seconds": 9.02,
      "text": "Okay: blood pressure 123 over 74, heart rate 71, oxygen saturation is 97 percent. And respiratory rate 18, temperature 36.5."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.58,
      "end_seconds": 235.13,
      "duration_seconds": 2.55,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.15,
      "end_seconds": 238.63,
      "duration_seconds": 2.48,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.34,
      "end_seconds": 242.51,
      "duration_seconds": 2.17,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.74,
      "end_seconds": 257.6,
      "duration_seconds": 5.86,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.18,
      "end_seconds": 259.8,
      "duration_seconds": 1.62,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.01,
      "end_seconds": 273.62,
      "duration_seconds": 8.61,
      "text": "You can relax now. So, based on the history and the examination, it points towards poorly controlled asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.3,
      "end_seconds": 289.51,
      "duration_seconds": 3.21,
      "text": "I'll request spirometry, it'll help with asthma."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.45,
      "end_seconds": 296.84,
      "duration_seconds": 2.39,
      "text": "The earliest is Monday, 2 pm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.47,
      "end_seconds": 303.36,
      "duration_seconds": 4.89,
      "text": "I'd like to arrange a peak flow reading for asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.65,
      "end_seconds": 305.72,
      "duration_seconds": 1.07,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.31,
      "end_seconds": 331.59,
      "duration_seconds": 24.28,
      "text": "The treatment will be beclometasone and formoterol, 100 and 6 micrograms, two puffs twice a day, long term. That should help with asthma control. Use the spacer and rinse your mouth after the preventer. See me again in four weeks. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.54,
      "end_seconds": 336.63,
      "duration_seconds": 3.09,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.59,
      "end_seconds": 339.85,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
}