{
  "schema_version": "1.0",
  "encounter_id": "01145",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 4.47,
      "duration_seconds": 3.6,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 10.63,
      "duration_seconds": 4.76,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.49,
      "end_seconds": 18.74,
      "duration_seconds": 6.25,
      "text": "Yeah, it's black tarry stools. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 22.6,
      "duration_seconds": 3.02,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.29,
      "end_seconds": 30.11,
      "duration_seconds": 1.82,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.81,
      "end_seconds": 37.92,
      "duration_seconds": 3.11,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.56,
      "end_seconds": 45.95,
      "duration_seconds": 7.39,
      "text": "It's moderate, honestly. Hmm, I've been feeling faint too, for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.06,
      "end_seconds": 52.85,
      "duration_seconds": 5.79,
      "text": "Okay, have you had black tarry stools before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.47,
      "end_seconds": 59.66,
      "duration_seconds": 5.19,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.8,
      "end_seconds": 80.08,
      "duration_seconds": 2.28,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.71,
      "end_seconds": 84.38,
      "duration_seconds": 3.67,
      "text": "Ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.06,
      "end_seconds": 91.81,
      "duration_seconds": 4.75,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.81,
      "end_seconds": 94.28,
      "duration_seconds": 1.47,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.16,
      "end_seconds": 105.54,
      "duration_seconds": 2.38,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.41,
      "end_seconds": 113.77,
      "duration_seconds": 6.36,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.87,
      "end_seconds": 120.98,
      "duration_seconds": 5.11,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.63,
      "end_seconds": 126.5,
      "duration_seconds": 4.87,
      "text": "Right, yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 130.13,
      "duration_seconds": 1.9,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.98,
      "end_seconds": 134.81,
      "duration_seconds": 3.83,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.2,
      "end_seconds": 138.09,
      "duration_seconds": 1.89,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.77,
      "end_seconds": 144.91,
      "duration_seconds": 3.14,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.56,
      "end_seconds": 152.49,
      "duration_seconds": 2.93,
      "text": "Okay, tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.3,
      "end_seconds": 160.46,
      "duration_seconds": 6.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.14,
      "end_seconds": 165.52,
      "duration_seconds": 3.38,
      "text": "Did you get fever or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.96,
      "end_seconds": 170.43,
      "duration_seconds": 3.47,
      "text": "No, no fever or chest pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.58,
      "end_seconds": 176.38,
      "duration_seconds": 2.8,
      "text": "Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.42,
      "end_seconds": 183.87,
      "duration_seconds": 5.45,
      "text": "Sorry, what was I saying, no, that's all fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.35,
      "end_seconds": 190.06,
      "duration_seconds": 3.71,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.04,
      "end_seconds": 194.34,
      "duration_seconds": 3.3,
      "text": "Uh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.29,
      "end_seconds": 199.35,
      "duration_seconds": 4.06,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.01,
      "end_seconds": 209.17,
      "duration_seconds": 2.16,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.5,
      "end_seconds": 224.5,
      "duration_seconds": 5.0,
      "text": "Okay: pulse is 105 beats a minute, BP is 112 over 81."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.85,
      "end_seconds": 228.97,
      "duration_seconds": 2.12,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.63,
      "end_seconds": 233.4,
      "duration_seconds": 2.77,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.38,
      "end_seconds": 256.03,
      "duration_seconds": 6.65,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.24,
      "end_seconds": 275.55,
      "duration_seconds": 15.31,
      "text": "Good, you can sit up again. Okay, so my impression is this: I'm honestly not certain yet. It could be a possible bleeding stomach ulcer, or it might be a bleed from the gullet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.01,
      "end_seconds": 283.36,
      "duration_seconds": 3.35,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.96,
      "end_seconds": 303.73,
      "duration_seconds": 19.77,
      "text": "I understand the worry. At the moment I'd say it's a possible bleeding stomach ulcer, and we'll know more once the urgent blood tests is back. Let me just check I've got this right. You've had black tarry stools for one week, moderate, and no fever or chest pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.23,
      "end_seconds": 307.56,
      "duration_seconds": 2.33,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.39,
      "end_seconds": 324.81,
      "duration_seconds": 4.42,
      "text": "I think urgent blood tests makes sense here, for bleeding."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.07,
      "end_seconds": 327.88,
      "duration_seconds": 1.81,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.42,
      "end_seconds": 341.34,
      "duration_seconds": 11.92,
      "text": "I want an endoscopy done, that's for bleeding. Please stop the ibuprofen and do not eat or drink. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.15,
      "end_seconds": 345.58,
      "duration_seconds": 2.43,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.77,
      "end_seconds": 353.65,
      "duration_seconds": 6.88,
      "text": "I'd like to see you again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.02,
      "end_seconds": 357.31,
      "duration_seconds": 2.29,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.23,
      "end_seconds": 360.57,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}