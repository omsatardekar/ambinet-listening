{
  "schema_version": "1.0",
  "encounter_id": "01442",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 6.11,
      "duration_seconds": 5.45,
      "text": "Mm, uh, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.18,
      "end_seconds": 12.1,
      "duration_seconds": 3.92,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.05,
      "end_seconds": 18.27,
      "duration_seconds": 5.22,
      "text": "hello, doctor. I'm here with them in case I can help"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.86,
      "end_seconds": 23.9,
      "duration_seconds": 4.04,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.9,
      "end_seconds": 30.19,
      "duration_seconds": 4.29,
      "text": "I've been dealing with planning a trip."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.72,
      "end_seconds": 34.5,
      "duration_seconds": 2.78,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.27,
      "end_seconds": 38.91,
      "duration_seconds": 3.64,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.52,
      "end_seconds": 43.34,
      "duration_seconds": 2.82,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.55,
      "end_seconds": 57.66,
      "duration_seconds": 13.11,
      "text": "Ah, it usually comes with a mild sore arm from last injection. Um, the mild sore arm from last injection? That's been since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.7,
      "end_seconds": 65.6,
      "duration_seconds": 5.9,
      "text": "Have you had planning a trip before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.37,
      "end_seconds": 75.44,
      "duration_seconds": 8.07,
      "text": "Oh, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.26,
      "end_seconds": 78.69,
      "duration_seconds": 2.43,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.64,
      "end_seconds": 81.4,
      "duration_seconds": 1.76,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.06,
      "end_seconds": 86.11,
      "duration_seconds": 3.05,
      "text": "have you noticed rash or recent illness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.16,
      "end_seconds": 92.97,
      "duration_seconds": 5.81,
      "text": "Actually, um, I haven't had rash or recent illness, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.68,
      "end_seconds": 95.67,
      "duration_seconds": 1.99,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.02,
      "end_seconds": 98.02,
      "duration_seconds": 1.0,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.96,
      "end_seconds": 109.36,
      "duration_seconds": 1.4,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.2,
      "end_seconds": 114.37,
      "duration_seconds": 4.17,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 117.69,
      "duration_seconds": 2.01,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 121.88,
      "duration_seconds": 2.43,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.01,
      "end_seconds": 126.32,
      "duration_seconds": 3.31,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.01,
      "end_seconds": 129.98,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.84,
      "end_seconds": 133.71,
      "duration_seconds": 2.87,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.68,
      "end_seconds": 139.05,
      "duration_seconds": 4.37,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 157.6,
      "duration_seconds": 2.53,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.59,
      "end_seconds": 167.11,
      "duration_seconds": 8.52,
      "text": "Diabetes, for nearly five years. I took the morning off to to come in today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.69,
      "end_seconds": 170.04,
      "duration_seconds": 1.35,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.96,
      "end_seconds": 175.0,
      "duration_seconds": 3.04,
      "text": "I, I have heart failure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.38,
      "end_seconds": 178.21,
      "duration_seconds": 1.83,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.45,
      "end_seconds": 181.76,
      "duration_seconds": 2.31,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.32,
      "end_seconds": 186.54,
      "duration_seconds": 4.22,
      "text": "I'm on glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.36,
      "end_seconds": 190.91,
      "duration_seconds": 3.55,
      "text": "How long has that that been going on?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.63,
      "end_seconds": 198.34,
      "duration_seconds": 5.71,
      "text": "For nearly five years. I take furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 200.19,
      "end_seconds": 210.04,
      "duration_seconds": 9.85,
      "text": "Doctor, I think the last prescription for the furosemide was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 214.72,
      "duration_seconds": 3.83,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.95,
      "end_seconds": 220.15,
      "duration_seconds": 4.2,
      "text": "I don't think I have it with me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.0,
      "end_seconds": 223.95,
      "duration_seconds": 1.95,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.8,
      "end_seconds": 226.92,
      "duration_seconds": 2.12,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.22,
      "end_seconds": 238.73,
      "duration_seconds": 3.51,
      "text": "Your temperature is normal and you look well."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 245.28,
      "duration_seconds": 1.62,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.12,
      "end_seconds": 265.07,
      "duration_seconds": 6.95,
      "text": "Okay, so my impression is this: It points towards fit to have travel vaccinations."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.06,
      "end_seconds": 268.51,
      "duration_seconds": 2.45,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.55,
      "end_seconds": 289.23,
      "duration_seconds": 19.68,
      "text": "Nothing I've seen today points to an emergency. It looks like fit to have travel vaccinations. I'd like you to take hepatitis A vaccine, 1 dose, once, single dose. That's for travel. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.5,
      "end_seconds": 292.96,
      "duration_seconds": 2.46,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.23,
      "end_seconds": 312.66,
      "duration_seconds": 18.43,
      "text": "Drink bottled water and use insect repellent. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review in six months for the booster. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.7,
      "end_seconds": 316.08,
      "duration_seconds": 2.38,
      "text": "alright, thanks, take care"
    }
  ]
}