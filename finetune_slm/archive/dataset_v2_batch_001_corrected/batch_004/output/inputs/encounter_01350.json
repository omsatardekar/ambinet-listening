{
  "schema_version": "1.0",
  "encounter_id": "01350",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 3.65,
      "duration_seconds": 3.02,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.31,
      "end_seconds": 9.32,
      "duration_seconds": 4.01,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.42,
      "end_seconds": 18.05,
      "duration_seconds": 7.63,
      "text": "I mean, I've been wanting contraception. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.13,
      "end_seconds": 22.84,
      "duration_seconds": 3.71,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.6,
      "end_seconds": 27.02,
      "duration_seconds": 2.42,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.06,
      "end_seconds": 31.82,
      "duration_seconds": 2.76,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.6,
      "end_seconds": 35.62,
      "duration_seconds": 3.02,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.08,
      "end_seconds": 39.78,
      "duration_seconds": 3.7,
      "text": "Right, right. So, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.49,
      "end_seconds": 49.19,
      "duration_seconds": 8.7,
      "text": "It usually comes with slightly heavy periods. The slightly heavy periods? That's been for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.98,
      "end_seconds": 55.13,
      "duration_seconds": 4.15,
      "text": "Any breast lumps, migraine with aura or smoking at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.95,
      "end_seconds": 58.9,
      "duration_seconds": 2.95,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.27,
      "end_seconds": 63.59,
      "duration_seconds": 3.32,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.13,
      "end_seconds": 68.05,
      "duration_seconds": 2.92,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.12,
      "end_seconds": 76.83,
      "duration_seconds": 3.71,
      "text": "Right, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.74,
      "end_seconds": 79.19,
      "duration_seconds": 1.45,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.35,
      "end_seconds": 95.01,
      "duration_seconds": 2.66,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.01,
      "end_seconds": 98.74,
      "duration_seconds": 1.73,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.13,
      "end_seconds": 102.17,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 106.37,
      "duration_seconds": 2.82,
      "text": "Thin bones, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 111.69,
      "duration_seconds": 4.63,
      "text": "Okay, I can see thin bones in your file as well."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.93,
      "end_seconds": 122.4,
      "duration_seconds": 3.47,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.16,
      "end_seconds": 129.19,
      "duration_seconds": 3.03,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.29,
      "end_seconds": 134.52,
      "duration_seconds": 4.23,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.83,
      "end_seconds": 150.49,
      "duration_seconds": 14.66,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I live with my elderly mother. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 154.15,
      "duration_seconds": 3.12,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.54,
      "end_seconds": 160.27,
      "duration_seconds": 4.73,
      "text": "Alendronate. I take it 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 165.72,
      "duration_seconds": 4.81,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.61,
      "end_seconds": 172.81,
      "duration_seconds": 3.2,
      "text": "I mean, no, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 192.76,
      "duration_seconds": 3.32,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.26,
      "end_seconds": 201.76,
      "duration_seconds": 2.5,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.4,
      "end_seconds": 227.78,
      "duration_seconds": 7.38,
      "text": "Okay: blood pressure 110 over 82, saturation 98 percent. And temp 36.6 degrees, pulse 66."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.86,
      "end_seconds": 230.9,
      "duration_seconds": 2.04,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.18,
      "end_seconds": 234.65,
      "duration_seconds": 2.47,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.98,
      "end_seconds": 240.84,
      "duration_seconds": 3.86,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.57,
      "end_seconds": 245.54,
      "duration_seconds": 2.97,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.27,
      "end_seconds": 265.69,
      "duration_seconds": 2.42,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 278.99,
      "duration_seconds": 10.27,
      "text": "Alright, that's all I needed to check. Let's use levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. It's for contraception."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.73,
      "end_seconds": 283.72,
      "duration_seconds": 2.99,
      "text": "Erm, how soon will it work?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.75,
      "end_seconds": 299.95,
      "duration_seconds": 14.2,
      "text": "Take the pill at the same time each day and use condoms if you miss two. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.54,
      "end_seconds": 302.04,
      "duration_seconds": 1.5,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.85,
      "end_seconds": 319.61,
      "duration_seconds": 11.76,
      "text": "The thing that would worry me is if you get leg swelling or severe headaches. If that happens, go to emergency. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.65,
      "end_seconds": 324.57,
      "duration_seconds": 3.92,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.97,
      "end_seconds": 327.28,
      "duration_seconds": 1.31,
      "text": "Look after yourself."
    }
  ]
}