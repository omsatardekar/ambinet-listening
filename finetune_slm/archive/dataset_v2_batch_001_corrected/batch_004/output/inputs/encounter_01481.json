{
  "schema_version": "1.0",
  "encounter_id": "01481",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.41,
      "duration_seconds": 3.4,
      "text": "good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 11.55,
      "duration_seconds": 5.1,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.39,
      "end_seconds": 17.97,
      "duration_seconds": 5.58,
      "text": "Yeah, it's difficulty swallowing. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.93,
      "end_seconds": 22.28,
      "duration_seconds": 3.35,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.95,
      "end_seconds": 31.59,
      "duration_seconds": 2.64,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 53.72,
      "duration_seconds": 8.71,
      "text": "okay: oxygen saturation is 93 percent, temperature is 37.6 degrees, heart rate 92, BP is 131 over 84."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.01,
      "end_seconds": 58.03,
      "duration_seconds": 4.02,
      "text": "yes, carry on is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.13,
      "end_seconds": 63.3,
      "duration_seconds": 3.17,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.45,
      "end_seconds": 67.05,
      "duration_seconds": 2.6,
      "text": "right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.9,
      "end_seconds": 81.92,
      "duration_seconds": 14.02,
      "text": "A severe sore throat goes along with it, most of the time. About severe sore throat, pretty severe, if I'm being honest. I notice it more with swallowing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.27,
      "end_seconds": 90.07,
      "duration_seconds": 2.8,
      "text": "did you get cough or rash?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.86,
      "end_seconds": 93.34,
      "duration_seconds": 2.48,
      "text": "no, no cough or rash"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.01,
      "end_seconds": 98.61,
      "duration_seconds": 4.6,
      "text": "So, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.55,
      "end_seconds": 102.93,
      "duration_seconds": 2.38,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.03,
      "end_seconds": 108.74,
      "duration_seconds": 4.71,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.63,
      "end_seconds": 113.69,
      "duration_seconds": 4.06,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.45,
      "end_seconds": 124.68,
      "duration_seconds": 3.23,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.15,
      "end_seconds": 132.35,
      "duration_seconds": 6.2,
      "text": "I'm on naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.02,
      "end_seconds": 135.88,
      "duration_seconds": 2.86,
      "text": "roughly how long on that one?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.94,
      "end_seconds": 152.82,
      "duration_seconds": 14.88,
      "text": "About a year now. It's glibenclamide, 5 milligrams, before breakfast. I've been reading about it online and it worried me. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.9,
      "end_seconds": 156.32,
      "duration_seconds": 2.42,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.33,
      "end_seconds": 160.27,
      "duration_seconds": 2.94,
      "text": "yes, arthritis in my knees"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.36,
      "end_seconds": 162.65,
      "duration_seconds": 1.29,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.37,
      "end_seconds": 168.34,
      "duration_seconds": 3.97,
      "text": "I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.26,
      "end_seconds": 175.46,
      "duration_seconds": 5.2,
      "text": "Yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.19,
      "end_seconds": 196.76,
      "duration_seconds": 3.57,
      "text": "okay, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.12,
      "end_seconds": 203.71,
      "duration_seconds": 5.59,
      "text": "just a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.5,
      "end_seconds": 220.31,
      "duration_seconds": 3.81,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.9,
      "end_seconds": 224.77,
      "duration_seconds": 1.87,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.49,
      "end_seconds": 227.5,
      "duration_seconds": 2.01,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.85,
      "end_seconds": 233.46,
      "duration_seconds": 4.61,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.52,
      "end_seconds": 237.27,
      "duration_seconds": 2.75,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.43,
      "end_seconds": 241.77,
      "duration_seconds": 3.34,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 245.83,
      "duration_seconds": 2.84,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 249.12,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.95,
      "end_seconds": 271.13,
      "duration_seconds": 4.18,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.31,
      "end_seconds": 288.52,
      "duration_seconds": 15.21,
      "text": "You can sit up now. Right, here's what I'm thinking. I think we're dealing with a possible airway infection that needs emergency care at this stage. I can't rule out severe tonsillitis yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.96,
      "end_seconds": 291.89,
      "duration_seconds": 1.93,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.14,
      "end_seconds": 323.48,
      "duration_seconds": 26.34,
      "text": "I can't promise yet, but most people with a possible airway infection that needs emergency care do well once it's treated properly. I'm going to order an urgent airway assessment, for stridor and drooling. Do not lie flat, I am calling an ambulance now. Please take the tablets with food so they don't upset your stomach. I'll also refer you to the emergency ENT team."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.57,
      "end_seconds": 326.27,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.98,
      "end_seconds": 328.99,
      "duration_seconds": 2.01,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.7,
      "end_seconds": 332.76,
      "duration_seconds": 2.06,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.82,
      "end_seconds": 338.71,
      "duration_seconds": 3.89,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.35,
      "end_seconds": 343.26,
      "duration_seconds": 3.91,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}