{
  "schema_version": "1.0",
  "encounter_id": "01284",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 6.55,
      "duration_seconds": 5.78,
      "text": "Good morning. I've just opened your notes. Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.8,
      "end_seconds": 12.37,
      "duration_seconds": 4.57,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.53,
      "end_seconds": 15.67,
      "duration_seconds": 2.14,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.06,
      "end_seconds": 22.16,
      "duration_seconds": 5.1,
      "text": "Well, I've been having a red itchy lump on my arm."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.67,
      "end_seconds": 26.87,
      "duration_seconds": 3.2,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.68,
      "end_seconds": 40.4,
      "duration_seconds": 12.72,
      "text": "Oh, it's been going on for six months. My family kept telling me to get it checked. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.9,
      "end_seconds": 44.32,
      "duration_seconds": 2.42,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.47,
      "end_seconds": 47.71,
      "duration_seconds": 2.24,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.82,
      "end_seconds": 64.75,
      "duration_seconds": 3.93,
      "text": "Any lip swelling, dizziness or fever at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.26,
      "end_seconds": 68.81,
      "duration_seconds": 2.55,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.49,
      "end_seconds": 72.5,
      "duration_seconds": 2.01,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.05,
      "end_seconds": 77.73,
      "duration_seconds": 2.68,
      "text": "Yeah, no problems with breathing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.02,
      "end_seconds": 81.96,
      "duration_seconds": 2.94,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.41,
      "end_seconds": 85.23,
      "duration_seconds": 1.82,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.1,
      "end_seconds": 88.75,
      "duration_seconds": 2.65,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.59,
      "end_seconds": 94.67,
      "duration_seconds": 4.08,
      "text": "An antihistamine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.42,
      "end_seconds": 98.45,
      "duration_seconds": 3.03,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.07,
      "end_seconds": 102.43,
      "duration_seconds": 2.36,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.36,
      "end_seconds": 104.55,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.4,
      "end_seconds": 107.63,
      "duration_seconds": 1.23,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.6,
      "end_seconds": 128.62,
      "duration_seconds": 4.02,
      "text": "Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.23,
      "end_seconds": 140.8,
      "duration_seconds": 10.57,
      "text": "My husband and I live above the shop. I hardly move around during the day. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.76,
      "end_seconds": 158.01,
      "duration_seconds": 4.25,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.11,
      "end_seconds": 161.96,
      "duration_seconds": 2.85,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.75,
      "end_seconds": 182.47,
      "duration_seconds": 2.72,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.48,
      "end_seconds": 193.22,
      "duration_seconds": 2.74,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.07,
      "end_seconds": 223.51,
      "duration_seconds": 9.44,
      "text": "Okay: temp 36.7 degrees, SpO2 97 percent on room air, BP is 128 over 82. And pulse is 84 beats a minute."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.78,
      "end_seconds": 227.17,
      "duration_seconds": 2.39,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.49,
      "end_seconds": 231.93,
      "duration_seconds": 3.44,
      "text": "So, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.17,
      "end_seconds": 237.92,
      "duration_seconds": 4.75,
      "text": "Right, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.97,
      "end_seconds": 240.64,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.12,
      "end_seconds": 266.72,
      "duration_seconds": 8.6,
      "text": "There is a small red lump with a central punctum and a little swelling around it, and no spreading redness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.71,
      "end_seconds": 279.99,
      "duration_seconds": 8.28,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: This is probably a local insect bite reaction."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.5,
      "end_seconds": 283.97,
      "duration_seconds": 2.47,
      "text": "Erm, will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.92,
      "end_seconds": 312.75,
      "duration_seconds": 26.83,
      "text": "I understand the worry. At the moment I'd say it's a local insect bite reaction, and we'll watch how it goes. You'll be taking hydrocortisone cream, 1%, twice a day, five days. That's for bite reaction. Cool it with ice and avoid scratching. If the redness spreads or you feel unwell, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.54,
      "end_seconds": 316.72,
      "duration_seconds": 3.18,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.26,
      "end_seconds": 323.21,
      "duration_seconds": 5.95,
      "text": "Let's review you if the redness spreads. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.24,
      "end_seconds": 328.26,
      "duration_seconds": 3.02,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.24,
      "end_seconds": 333.13,
      "duration_seconds": 1.89,
      "text": "Have a good day."
    }
  ]
}