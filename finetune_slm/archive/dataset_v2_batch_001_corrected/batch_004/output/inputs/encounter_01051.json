{
  "schema_version": "1.0",
  "encounter_id": "01051",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 5.83,
      "duration_seconds": 4.63,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 11.73,
      "duration_seconds": 5.13,
      "text": "yes, come in and and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.69,
      "end_seconds": 16.39,
      "duration_seconds": 2.7,
      "text": "It's being very thirsty, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.14,
      "end_seconds": 21.89,
      "duration_seconds": 4.75,
      "text": "Okay give me more detail on it whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.44,
      "end_seconds": 27.73,
      "duration_seconds": 4.29,
      "text": "I get some relief from water. Mostly moderate."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.13,
      "end_seconds": 32.01,
      "duration_seconds": 2.88,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.19,
      "end_seconds": 47.52,
      "duration_seconds": 14.33,
      "text": "sorry, what was I saying, when it starts I tend to get deep fast breathing as well. The deep fast breathing? That's been since last Tuesday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.15,
      "end_seconds": 50.64,
      "duration_seconds": 2.49,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.49,
      "end_seconds": 60.37,
      "duration_seconds": 2.88,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.0,
      "end_seconds": 82.49,
      "duration_seconds": 12.49,
      "text": "Okay: pressure 131 over 82, respiratory rate 17, temperature is 36.8 degrees. And pulse is 109 beats a minute, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.87,
      "end_seconds": 87.45,
      "duration_seconds": 3.58,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.14,
      "end_seconds": 90.11,
      "duration_seconds": 0.97,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.91,
      "end_seconds": 92.91,
      "duration_seconds": 2.0,
      "text": "so, does that hurt?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.6,
      "end_seconds": 105.01,
      "duration_seconds": 4.41,
      "text": "you are dry breathing deeply and your breath smells fruity"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.72,
      "end_seconds": 110.17,
      "duration_seconds": 1.45,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.39,
      "end_seconds": 116.25,
      "duration_seconds": 2.86,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.06,
      "end_seconds": 137.47,
      "duration_seconds": 3.41,
      "text": "Have you noticed cough or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.53,
      "end_seconds": 142.13,
      "duration_seconds": 2.6,
      "text": "no I'd have said so"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.62,
      "end_seconds": 147.67,
      "duration_seconds": 2.05,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.22,
      "end_seconds": 150.15,
      "duration_seconds": 0.93,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.55,
      "end_seconds": 155.81,
      "duration_seconds": 4.26,
      "text": "Anything with your heart like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.42,
      "end_seconds": 160.31,
      "duration_seconds": 2.89,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.3,
      "end_seconds": 163.8,
      "duration_seconds": 2.5,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.21,
      "end_seconds": 169.03,
      "duration_seconds": 3.82,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.82,
      "end_seconds": 175.07,
      "duration_seconds": 2.25,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.11,
      "end_seconds": 181.3,
      "duration_seconds": 4.19,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.76,
      "end_seconds": 194.42,
      "duration_seconds": 3.66,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.34,
      "end_seconds": 203.3,
      "duration_seconds": 3.96,
      "text": "Glimepiride i take it 2 milligrams, before breakfast"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.05,
      "end_seconds": 219.49,
      "duration_seconds": 2.44,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.51,
      "end_seconds": 225.49,
      "duration_seconds": 4.98,
      "text": "yes, I had my womb taken out, fifteen years ago"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.32,
      "end_seconds": 230.12,
      "duration_seconds": 2.8,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.75,
      "end_seconds": 238.83,
      "duration_seconds": 3.08,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.37,
      "end_seconds": 248.02,
      "duration_seconds": 4.65,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.44,
      "end_seconds": 251.06,
      "duration_seconds": 1.62,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.61,
      "end_seconds": 255.96,
      "duration_seconds": 4.35,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.53,
      "end_seconds": 258.73,
      "duration_seconds": 2.2,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.81,
      "end_seconds": 266.47,
      "duration_seconds": 6.66,
      "text": "So, based on the history and the examination, my working impression is diabetic ketoacidosis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.08,
      "end_seconds": 270.32,
      "duration_seconds": 3.24,
      "text": "what are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.81,
      "end_seconds": 297.24,
      "duration_seconds": 25.43,
      "text": "It's reasonable to be concerned, but right now diabetic ketoacidosis is my leading thought, not anything worse. I want blood gas and electrolytes done, that's for DKA. I'd like to arrange a blood sugar and ketone test for thirst and vomiting. You need to to go to hospital now for insulin and fluids. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.61,
      "end_seconds": 301.35,
      "duration_seconds": 2.74,
      "text": "I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.0,
      "end_seconds": 306.55,
      "duration_seconds": 4.55,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.27,
      "end_seconds": 309.39,
      "duration_seconds": 2.12,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.42,
      "end_seconds": 312.8,
      "duration_seconds": 1.38,
      "text": "Look after yourself."
    }
  ]
}