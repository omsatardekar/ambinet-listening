{
  "schema_version": "1.0",
  "encounter_id": "01265",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.26,
      "duration_seconds": 3.48,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 8.74,
      "duration_seconds": 3.74,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.91,
      "end_seconds": 19.29,
      "duration_seconds": 7.38,
      "text": "It's a cut on my finger. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.16,
      "duration_seconds": 2.97,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.91,
      "end_seconds": 26.77,
      "duration_seconds": 2.86,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.99,
      "end_seconds": 38.3,
      "duration_seconds": 3.31,
      "text": "A few quick ones: dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.0,
      "end_seconds": 41.47,
      "duration_seconds": 2.47,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.22,
      "end_seconds": 46.9,
      "duration_seconds": 3.68,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.87,
      "end_seconds": 52.75,
      "duration_seconds": 4.88,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.18,
      "end_seconds": 56.97,
      "duration_seconds": 1.79,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.75,
      "end_seconds": 59.27,
      "duration_seconds": 1.52,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.26,
      "end_seconds": 63.13,
      "duration_seconds": 2.87,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.8,
      "end_seconds": 69.27,
      "duration_seconds": 4.47,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.93,
      "end_seconds": 74.92,
      "duration_seconds": 4.99,
      "text": "So, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.2,
      "end_seconds": 79.65,
      "duration_seconds": 3.45,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.87,
      "end_seconds": 84.75,
      "duration_seconds": 1.88,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.36,
      "end_seconds": 89.17,
      "duration_seconds": 3.81,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.65,
      "end_seconds": 112.19,
      "duration_seconds": 4.54,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.01,
      "end_seconds": 118.97,
      "duration_seconds": 2.96,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.14,
      "end_seconds": 140.55,
      "duration_seconds": 4.41,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.39,
      "end_seconds": 145.97,
      "duration_seconds": 3.58,
      "text": "Yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.12,
      "end_seconds": 149.27,
      "duration_seconds": 2.15,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.11,
      "end_seconds": 157.91,
      "duration_seconds": 2.8,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.61,
      "end_seconds": 177.03,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.06,
      "end_seconds": 187.28,
      "duration_seconds": 2.22,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.9,
      "end_seconds": 215.46,
      "duration_seconds": 12.56,
      "text": "Okay: height 154 centimetres, BMI works out to 32.5, temperature 36.8, weight 77 kilos, heart rate 76, pressure 117 over 71, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.35,
      "end_seconds": 217.87,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.71,
      "end_seconds": 227.26,
      "duration_seconds": 4.55,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 234.34,
      "duration_seconds": 4.48,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.81,
      "end_seconds": 238.07,
      "duration_seconds": 2.26,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.86,
      "end_seconds": 256.87,
      "duration_seconds": 6.01,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.67,
      "end_seconds": 259.86,
      "duration_seconds": 1.19,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.41,
      "end_seconds": 273.79,
      "duration_seconds": 11.38,
      "text": "Please sit back down. Putting it all together, I think we're dealing with a minor clean wound that needs only dressing at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.69,
      "end_seconds": 276.66,
      "duration_seconds": 1.97,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.76,
      "end_seconds": 290.45,
      "duration_seconds": 12.69,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor clean wound that needs only dressing. I'll close it with adhesive strips and keep it dry for two days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.9,
      "end_seconds": 301.18,
      "duration_seconds": 10.28,
      "text": "Ah. Do get help quickly if the finger turns red, hot or swollen. Come back if it looks red or swollen."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.72,
      "end_seconds": 303.42,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.81,
      "end_seconds": 308.75,
      "duration_seconds": 3.94,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.7,
      "end_seconds": 312.48,
      "duration_seconds": 2.78,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 315.55,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}