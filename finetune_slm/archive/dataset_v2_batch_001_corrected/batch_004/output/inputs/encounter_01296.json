{
  "schema_version": "1.0",
  "encounter_id": "01296",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.97,
      "duration_seconds": 3.25,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.42,
      "end_seconds": 11.88,
      "duration_seconds": 4.46,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.07,
      "end_seconds": 21.69,
      "duration_seconds": 8.62,
      "text": "Mainly headaches in the morning. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.71,
      "end_seconds": 26.13,
      "duration_seconds": 2.42,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.83,
      "end_seconds": 29.34,
      "duration_seconds": 1.51,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.1,
      "end_seconds": 32.52,
      "duration_seconds": 2.42,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.18,
      "end_seconds": 36.92,
      "duration_seconds": 2.74,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.5,
      "end_seconds": 41.23,
      "duration_seconds": 2.73,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.02,
      "end_seconds": 44.53,
      "duration_seconds": 1.51,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.38,
      "end_seconds": 49.93,
      "duration_seconds": 4.55,
      "text": "Did you get chest pain, leg swelling or visual changes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.73,
      "end_seconds": 53.72,
      "duration_seconds": 1.99,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.16,
      "end_seconds": 56.33,
      "duration_seconds": 1.17,
      "text": "Nothing like breathlessness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.02,
      "end_seconds": 59.74,
      "duration_seconds": 1.72,
      "text": "No, no breathlessness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.75,
      "end_seconds": 64.1,
      "duration_seconds": 3.35,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.23,
      "end_seconds": 66.81,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.5,
      "end_seconds": 86.57,
      "duration_seconds": 4.07,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.97,
      "end_seconds": 91.62,
      "duration_seconds": 3.65,
      "text": "Actually, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.3,
      "end_seconds": 95.54,
      "duration_seconds": 3.24,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.25,
      "end_seconds": 100.08,
      "duration_seconds": 2.83,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.78,
      "end_seconds": 118.25,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.65,
      "end_seconds": 122.67,
      "duration_seconds": 3.02,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.23,
      "end_seconds": 126.64,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.4,
      "end_seconds": 131.3,
      "duration_seconds": 3.9,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.87,
      "end_seconds": 144.56,
      "duration_seconds": 4.69,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.27,
      "end_seconds": 162.26,
      "duration_seconds": 16.99,
      "text": "I only drink at family occasions. I've never touched a cigarette. I retired from the post office two years ago. I grab fast food at lunch most days. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.08,
      "end_seconds": 167.36,
      "duration_seconds": 3.28,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.04,
      "end_seconds": 176.75,
      "duration_seconds": 2.71,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.7,
      "end_seconds": 195.78,
      "duration_seconds": 7.08,
      "text": "Okay: pulse 75, blood pressure 158 over 101. And respiratory rate 15, temperature 36.9."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.02,
      "end_seconds": 201.73,
      "duration_seconds": 3.71,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.64,
      "end_seconds": 205.77,
      "duration_seconds": 2.13,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.47,
      "end_seconds": 224.85,
      "duration_seconds": 6.38,
      "text": "Your heart sounds are normal and there is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.78,
      "end_seconds": 231.88,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.31,
      "end_seconds": 250.49,
      "duration_seconds": 7.18,
      "text": "Having listened and examined, it fits best with blood pressure above target on current treatment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.96,
      "end_seconds": 254.77,
      "duration_seconds": 2.81,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.15,
      "end_seconds": 281.1,
      "duration_seconds": 24.95,
      "text": "I understand the worry. At the moment I'd say it's blood pressure above target on current treatment, and we'll know more once the kidney function blood tests is back. I'd like to arrange kidney function blood tests for hypertension. You'll be taking amlodipine, 5 milligrams, once a day, long term. You take it by mouth. That should help with blood pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.43,
      "end_seconds": 286.01,
      "duration_seconds": 1.58,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.5,
      "end_seconds": 292.18,
      "duration_seconds": 4.68,
      "text": "Cut down on salty foods and keep a home blood pressure diary."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.5,
      "end_seconds": 307.27,
      "duration_seconds": 14.77,
      "text": "Yes. One warning sign to remember: the symptoms get worse. In that case don't wait. Please come and see me after the monitor. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.32,
      "end_seconds": 312.15,
      "duration_seconds": 2.83,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}