{
  "schema_version": "1.0",
  "encounter_id": "01237",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.1,
      "duration_seconds": 4.0,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.17,
      "end_seconds": 11.04,
      "duration_seconds": 3.87,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.54,
      "end_seconds": 27.82,
      "duration_seconds": 15.28,
      "text": "Um, uh, so... a mole that has got bigger. That's why I came. I'm hoping you can tell me something definite. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.77,
      "end_seconds": 31.41,
      "duration_seconds": 2.64,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.54,
      "end_seconds": 35.95,
      "duration_seconds": 3.41,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.25,
      "end_seconds": 40.42,
      "duration_seconds": 3.17,
      "text": "Right, how long have you taken that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.31,
      "end_seconds": 45.72,
      "duration_seconds": 4.41,
      "text": "About about a month. Atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.43,
      "end_seconds": 50.76,
      "duration_seconds": 3.33,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.82,
      "end_seconds": 57.89,
      "duration_seconds": 5.07,
      "text": "About... well, five days. And a darker edge, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.95,
      "end_seconds": 61.59,
      "duration_seconds": 2.64,
      "text": "Has there been occasional itching too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.11,
      "end_seconds": 69.6,
      "duration_seconds": 7.49,
      "text": "Yes, for six months. With occasional itching, honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.41,
      "end_seconds": 74.15,
      "duration_seconds": 3.74,
      "text": "Did you get other new moles, crusting or bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.21,
      "end_seconds": 79.13,
      "duration_seconds": 2.92,
      "text": "Erm, no, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.18,
      "end_seconds": 83.45,
      "duration_seconds": 2.27,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.33,
      "end_seconds": 88.28,
      "duration_seconds": 3.95,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.15,
      "end_seconds": 92.95,
      "duration_seconds": 2.8,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.77,
      "end_seconds": 98.18,
      "duration_seconds": 4.41,
      "text": "Sorry, what was I saying, no, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.09,
      "end_seconds": 105.43,
      "duration_seconds": 3.34,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.58,
      "end_seconds": 121.95,
      "duration_seconds": 15.37,
      "text": "I mean, um, I have anxiety, for about ten years. A neighbour of mine said I should see someone about it. Right, I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.52,
      "end_seconds": 130.5,
      "duration_seconds": 3.98,
      "text": "Alright, anxiety, that matches what I have here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.59,
      "end_seconds": 147.1,
      "duration_seconds": 4.51,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.19,
      "end_seconds": 153.4,
      "duration_seconds": 4.21,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.35,
      "end_seconds": 174.33,
      "duration_seconds": 3.98,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.16,
      "end_seconds": 184.72,
      "duration_seconds": 9.56,
      "text": "I do a yoga class on Thursdays. My partner and our baby. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 187.91,
      "duration_seconds": 2.41,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.25,
      "end_seconds": 194.49,
      "duration_seconds": 5.24,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 195.78,
      "end_seconds": 205.02,
      "duration_seconds": 9.24,
      "text": "Okay, so the vitals from earlier. Heart rate 64, oxygen saturation is 99 percent, temp 36.6 degrees. BP is 122 over 73."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.59,
      "end_seconds": 207.58,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.21,
      "end_seconds": 214.62,
      "duration_seconds": 4.41,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.53,
      "end_seconds": 216.23,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.42,
      "end_seconds": 219.9,
      "duration_seconds": 2.48,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.84,
      "end_seconds": 238.58,
      "duration_seconds": 5.74,
      "text": "The mole is seven millimetres with an irregular border and two shades of brown."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.62,
      "end_seconds": 244.2,
      "duration_seconds": 2.58,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.42,
      "end_seconds": 267.15,
      "duration_seconds": 8.73,
      "text": "So, based on the history and the examination, this looks most like a mole with features that need specialist assessment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.85,
      "end_seconds": 270.95,
      "duration_seconds": 2.1,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.99,
      "end_seconds": 289.87,
      "duration_seconds": 17.88,
      "text": "I understand the worry. At the moment I'd say it's a mole with features that need specialist assessment, and we'll watch how it goes. Let's get you seen by the skin cancer clinic, I'll arrange the letter. I'd like you back after the biopsy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.73,
      "end_seconds": 294.02,
      "duration_seconds": 2.29,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.73,
      "end_seconds": 302.1,
      "duration_seconds": 2.37,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.36,
      "end_seconds": 305.09,
      "duration_seconds": 1.73,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.07,
      "end_seconds": 308.35,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}