{
  "schema_version": "1.0",
  "encounter_id": "01432",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.86,
      "end_seconds": 7.59,
      "duration_seconds": 6.73,
      "text": "doctor, this one's ready for you. Everything's on the chart, but I'll go through it"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.04,
      "end_seconds": 13.58,
      "duration_seconds": 4.54,
      "text": "thank you. Good morning, tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.7,
      "end_seconds": 28.35,
      "duration_seconds": 13.65,
      "text": "Well, honestly, it's high fevers every other day, and my family pushed me to come. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.69,
      "end_seconds": 33.03,
      "duration_seconds": 3.34,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.13,
      "end_seconds": 37.15,
      "duration_seconds": 3.02,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.99,
      "end_seconds": 41.19,
      "duration_seconds": 2.2,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.23,
      "end_seconds": 58.22,
      "duration_seconds": 15.99,
      "text": "It usually comes with shaking chills. Uh, and I've been feeling confused as well, since last Tuesday. The shaking chills? That's been for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.34,
      "end_seconds": 68.32,
      "duration_seconds": 1.98,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.94,
      "end_seconds": 71.73,
      "duration_seconds": 1.79,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.5,
      "end_seconds": 74.68,
      "duration_seconds": 1.18,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.93,
      "end_seconds": 79.39,
      "duration_seconds": 3.46,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.17,
      "end_seconds": 83.55,
      "duration_seconds": 3.38,
      "text": "right, what line of work are you in?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.31,
      "end_seconds": 89.46,
      "duration_seconds": 5.15,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.6,
      "end_seconds": 94.64,
      "duration_seconds": 2.04,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.66,
      "end_seconds": 100.42,
      "duration_seconds": 4.76,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.76,
      "end_seconds": 103.92,
      "duration_seconds": 2.16,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.98,
      "end_seconds": 110.42,
      "duration_seconds": 4.44,
      "text": "I had my tonsils removed as a teenager"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.36,
      "end_seconds": 115.58,
      "duration_seconds": 3.22,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.35,
      "end_seconds": 125.88,
      "duration_seconds": 4.53,
      "text": "I take lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.54,
      "end_seconds": 129.05,
      "duration_seconds": 2.51,
      "text": "So, when did you start it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.48,
      "end_seconds": 132.48,
      "duration_seconds": 2.0,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.05,
      "end_seconds": 137.93,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.85,
      "end_seconds": 142.69,
      "duration_seconds": 2.84,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.14,
      "end_seconds": 148.13,
      "duration_seconds": 3.99,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.84,
      "end_seconds": 154.18,
      "duration_seconds": 4.34,
      "text": "I've had epilepsy for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.95,
      "end_seconds": 159.18,
      "duration_seconds": 3.23,
      "text": "Have you had any diarrhoea, rash or cough?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.75,
      "end_seconds": 163.82,
      "duration_seconds": 3.07,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.06,
      "end_seconds": 167.94,
      "duration_seconds": 2.88,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.97,
      "end_seconds": 177.53,
      "duration_seconds": 4.56,
      "text": "uh, uh, no, joints are fine"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 192.34,
      "end_seconds": 203.65,
      "duration_seconds": 11.31,
      "text": "Here are the numbers, doctor. BP is 107 over 67, pulse is 108 beats a minute. Oxygen saturation is 97 percent, temperature is 39.3 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.44,
      "end_seconds": 205.14,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.5,
      "end_seconds": 211.94,
      "duration_seconds": 4.44,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.93,
      "end_seconds": 214.37,
      "duration_seconds": 1.44,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.33,
      "end_seconds": 235.57,
      "duration_seconds": 4.24,
      "text": "you are hot and jaundiced, and your spleen is tender"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.46,
      "end_seconds": 251.97,
      "duration_seconds": 11.51,
      "text": "Alright, please sit back down. Let me tell you where I've got to. This looks most like possible malaria after travel. Typhoid is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.86,
      "end_seconds": 278.2,
      "duration_seconds": 9.34,
      "text": "I want urgent blood films done, that's for fever after travel. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 279.79,
      "end_seconds": 280.91,
      "duration_seconds": 1.12,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.47,
      "end_seconds": 286.99,
      "duration_seconds": 4.52,
      "text": "You need hospital assessment today, this can become serious fast."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.66,
      "end_seconds": 294.27,
      "duration_seconds": 5.61,
      "text": "could I get blood tests done? A friend had it"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.49,
      "end_seconds": 309.74,
      "duration_seconds": 14.25,
      "text": "Not right now, it wouldn't change what we do today. If the symptoms get worse, that's the point to to come in urgently. Come back straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.91,
      "end_seconds": 316.55,
      "duration_seconds": 5.64,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.4,
      "end_seconds": 323.09,
      "duration_seconds": 5.69,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.38,
      "end_seconds": 328.52,
      "duration_seconds": 4.14,
      "text": "I, I think I understand everything. Thanks."
    }
  ]
}