{
  "schema_version": "1.0",
  "encounter_id": "01357",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 2.69,
      "duration_seconds": 1.87,
      "text": "evening let's get started"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.27,
      "end_seconds": 7.21,
      "duration_seconds": 2.94,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.8,
      "end_seconds": 15.24,
      "duration_seconds": 6.44,
      "text": "doctor, I've come along cos I know the history, if it helps"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.78,
      "end_seconds": 22.84,
      "duration_seconds": 7.06,
      "text": "Okay, that's fine, sit down. We'll go through it together. Did you find the place alright?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.87,
      "end_seconds": 30.04,
      "duration_seconds": 5.17,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.1,
      "end_seconds": 37.61,
      "duration_seconds": 2.51,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 38.99,
      "end_seconds": 45.05,
      "duration_seconds": 6.06,
      "text": "Doctor, you know, it's a missed period. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.11,
      "end_seconds": 50.4,
      "duration_seconds": 3.29,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.08,
      "end_seconds": 58.89,
      "duration_seconds": 6.81,
      "text": "about... well, one week i've also been feeling sick in the mornings, since Monday"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.21,
      "end_seconds": 69.83,
      "duration_seconds": 9.62,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.61,
      "end_seconds": 80.29,
      "duration_seconds": 8.68,
      "text": "It's a few times a day. I get some relief from dry biscuits. About a three out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.0,
      "end_seconds": 86.67,
      "duration_seconds": 5.67,
      "text": "have you had a missed period before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.89,
      "end_seconds": 92.51,
      "duration_seconds": 4.62,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.74,
      "end_seconds": 106.66,
      "duration_seconds": 2.92,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.47,
      "end_seconds": 110.32,
      "duration_seconds": 1.85,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.2,
      "end_seconds": 116.46,
      "duration_seconds": 5.26,
      "text": "Right, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.55,
      "end_seconds": 124.06,
      "duration_seconds": 6.51,
      "text": "Yes, diclofenac, it gives me wheezing. Yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.91,
      "end_seconds": 129.14,
      "duration_seconds": 3.23,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.7,
      "end_seconds": 138.76,
      "duration_seconds": 8.06,
      "text": "I've had thin bones for about a year now. I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.55,
      "end_seconds": 140.35,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.44,
      "end_seconds": 158.56,
      "duration_seconds": 14.12,
      "text": "I've got high blood pressure. I wasn't sure whether to come in at all, to be honest. Yes, high cholesterol. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.67,
      "end_seconds": 171.3,
      "duration_seconds": 8.63,
      "text": "Alright, heart failure and high cholesterol, that matches what I have here. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.06,
      "end_seconds": 176.38,
      "duration_seconds": 4.32,
      "text": "I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 177.35,
      "end_seconds": 183.76,
      "duration_seconds": 6.41,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.8,
      "end_seconds": 188.44,
      "duration_seconds": 3.64,
      "text": "Spironolactone. I take it once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.73,
      "end_seconds": 191.73,
      "duration_seconds": 2.0,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.22,
      "end_seconds": 207.15,
      "duration_seconds": 13.93,
      "text": "it's 25 milligrams. It's atorvastatin, 20 milligrams, at night. Well, I take something called a fo... a folic acid tablet, 400 micrograms, maybe, once a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.04,
      "end_seconds": 211.39,
      "duration_seconds": 3.35,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.1,
      "end_seconds": 216.06,
      "duration_seconds": 3.96,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.68,
      "end_seconds": 219.69,
      "duration_seconds": 3.01,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.3,
      "end_seconds": 225.16,
      "duration_seconds": 2.86,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.7,
      "end_seconds": 230.25,
      "duration_seconds": 3.55,
      "text": "Any bleeding, severe pain or vomiting everything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.72,
      "end_seconds": 245.46,
      "duration_seconds": 13.74,
      "text": "no, no bleeding, no severe pain, no vomiting everything i did have tender breasts at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.7,
      "end_seconds": 248.84,
      "duration_seconds": 2.14,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 251.75,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.63,
      "end_seconds": 261.03,
      "duration_seconds": 3.4,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.64,
      "end_seconds": 264.04,
      "duration_seconds": 1.4,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.11,
      "end_seconds": 268.4,
      "duration_seconds": 3.29,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.44,
      "end_seconds": 279.25,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.22,
      "end_seconds": 297.47,
      "duration_seconds": 7.25,
      "text": "Okay: temp 36.8 degrees, heart rate 70, saturation 99 percent. And pressure 118 over 81."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.86,
      "end_seconds": 300.43,
      "duration_seconds": 1.57,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.77,
      "end_seconds": 304.73,
      "duration_seconds": 2.96,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.22,
      "end_seconds": 323.24,
      "duration_seconds": 4.02,
      "text": "we should do a booking blood test for pregnancy"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.01,
      "end_seconds": 325.82,
      "duration_seconds": 1.81,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.0,
      "end_seconds": 338.9,
      "duration_seconds": 11.9,
      "text": "I want a pregnancy test done, that's for missed period. Keep taking folic acid and book in with the midwife. I'll also refer you to the midwife."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.77,
      "end_seconds": 340.47,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.03,
      "end_seconds": 359.39,
      "duration_seconds": 17.36,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, that's the point to come in urgently. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.89,
      "end_seconds": 362.52,
      "duration_seconds": 1.63,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.0,
      "end_seconds": 369.19,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}