{
  "schema_version": "1.0",
  "encounter_id": "01212",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 4.22,
      "duration_seconds": 3.04,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.35,
      "end_seconds": 6.36,
      "duration_seconds": 1.01,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.81,
      "end_seconds": 10.79,
      "duration_seconds": 2.98,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.57,
      "end_seconds": 17.58,
      "duration_seconds": 6.01,
      "text": "Yes, that's no problem at all. Please sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.8,
      "end_seconds": 23.78,
      "duration_seconds": 4.98,
      "text": "Doctor, it's watery diarrhoea. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.78,
      "end_seconds": 26.89,
      "duration_seconds": 2.11,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.28,
      "end_seconds": 35.68,
      "duration_seconds": 7.4,
      "text": "It's, It's been going on for two weeks. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.85,
      "end_seconds": 42.1,
      "duration_seconds": 3.25,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.16,
      "end_seconds": 48.98,
      "duration_seconds": 4.82,
      "text": "Severe, I'd say. Oh, um, and crampy tummy pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.01,
      "end_seconds": 53.43,
      "duration_seconds": 2.42,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.28,
      "end_seconds": 59.96,
      "duration_seconds": 4.68,
      "text": "Yes, for three weeks. And a low fever, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.87,
      "end_seconds": 68.95,
      "duration_seconds": 5.08,
      "text": "Have you had watery diarrhoea before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.22,
      "end_seconds": 78.48,
      "duration_seconds": 8.26,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.04,
      "end_seconds": 84.89,
      "duration_seconds": 4.85,
      "text": "Have you had any blood in the stool, severe dehydration or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 94.35,
      "duration_seconds": 5.04,
      "text": "No, no blood in the stool, severe dehydration or vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.94,
      "end_seconds": 98.24,
      "duration_seconds": 3.3,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.81,
      "end_seconds": 101.99,
      "duration_seconds": 2.18,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.02,
      "end_seconds": 107.18,
      "duration_seconds": 4.16,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.9,
      "end_seconds": 113.13,
      "duration_seconds": 5.23,
      "text": "I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.89,
      "end_seconds": 116.36,
      "duration_seconds": 1.47,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.28,
      "end_seconds": 119.76,
      "duration_seconds": 1.48,
      "text": "I've got asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.7,
      "end_seconds": 124.08,
      "duration_seconds": 3.38,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.82,
      "end_seconds": 139.47,
      "duration_seconds": 13.65,
      "text": "No, I've never smoked in my life. Nothing, I'm teetotal. Yes, I work in a bakery, early starts. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.97,
      "end_seconds": 143.36,
      "duration_seconds": 3.39,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.93,
      "end_seconds": 145.92,
      "duration_seconds": 1.99,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.36,
      "end_seconds": 150.02,
      "duration_seconds": 2.66,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.14,
      "end_seconds": 161.03,
      "duration_seconds": 5.89,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.22,
      "end_seconds": 177.95,
      "duration_seconds": 3.73,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.02,
      "end_seconds": 188.96,
      "duration_seconds": 9.94,
      "text": "It's diclofenac, 50 milligrams, when needed for the joint pain. Oral rehydration salts, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.93,
      "end_seconds": 194.86,
      "duration_seconds": 3.93,
      "text": "Alright, how long have you been on it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.57,
      "end_seconds": 199.06,
      "duration_seconds": 1.49,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.75,
      "end_seconds": 206.41,
      "duration_seconds": 6.66,
      "text": "Are there any allergies I should be aware of? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.32,
      "end_seconds": 218.72,
      "duration_seconds": 10.4,
      "text": "I think I reacted to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.22,
      "end_seconds": 223.99,
      "duration_seconds": 3.77,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.04,
      "end_seconds": 233.96,
      "duration_seconds": 2.92,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.4,
      "end_seconds": 256.28,
      "duration_seconds": 11.88,
      "text": "Okay: pulse is 104 beats a minute, temperature 38.8, BMI works out to 28.4. And weight 94 kilos, pressure 106 over 66, height 182 centimetres."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.21,
      "end_seconds": 263.14,
      "duration_seconds": 3.93,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.51,
      "end_seconds": 266.33,
      "duration_seconds": 1.82,
      "text": "So, does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.64,
      "end_seconds": 285.78,
      "duration_seconds": 7.14,
      "text": "Your tummy is soft with mild general tenderness and your mouth is a little dry."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.55,
      "end_seconds": 292.11,
      "duration_seconds": 2.56,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.74,
      "end_seconds": 339.58,
      "duration_seconds": 31.84,
      "text": "Putting it all together, this looks most like travellers' diarrhoea. It could also be a parasitic infection, so we'll keep that open. I'm going to order a stool sample, for diarrhoea after travel. Drink plenty of fluids and wash your hands carefully. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'd like you back if it lasts more than a week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.22,
      "end_seconds": 342.36,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.18,
      "end_seconds": 346.46,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}