{
  "schema_version": "1.0",
  "encounter_id": "01312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.46,
      "duration_seconds": 4.62,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 11.48,
      "duration_seconds": 4.7,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.0,
      "end_seconds": 21.93,
      "duration_seconds": 8.93,
      "text": "I've been dealing with a lingering cough. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.84,
      "end_seconds": 26.12,
      "duration_seconds": 3.28,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.39,
      "end_seconds": 30.66,
      "duration_seconds": 3.27,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.61,
      "end_seconds": 34.04,
      "duration_seconds": 2.43,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.3,
      "end_seconds": 38.11,
      "duration_seconds": 2.81,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 42.83,
      "duration_seconds": 2.88,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.68,
      "end_seconds": 62.09,
      "duration_seconds": 17.41,
      "text": "A tickle in my throat goes along with it, most of the the time. Uh, the tickle in my throat? That's been since last weekend. About tickle in my throat, it feels severe to me"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.91,
      "end_seconds": 70.15,
      "duration_seconds": 6.24,
      "text": "Have you had a lingering cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.87,
      "end_seconds": 77.16,
      "duration_seconds": 5.29,
      "text": "yeah, a bit, last year. It settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.79,
      "end_seconds": 82.01,
      "duration_seconds": 3.22,
      "text": "Alright, have you had any weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.05,
      "end_seconds": 86.12,
      "duration_seconds": 2.07,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.97,
      "end_seconds": 92.65,
      "duration_seconds": 4.68,
      "text": "Any shortness of breath, coughing up blood or fever at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.54,
      "end_seconds": 100.2,
      "duration_seconds": 5.66,
      "text": "I haven't had shortness of breath, coughing up blood or fever, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.52,
      "end_seconds": 103.92,
      "duration_seconds": 2.4,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.11,
      "end_seconds": 106.67,
      "duration_seconds": 1.56,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.22,
      "end_seconds": 111.38,
      "duration_seconds": 3.16,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.3,
      "end_seconds": 117.78,
      "duration_seconds": 1.48,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.49,
      "end_seconds": 133.13,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.08,
      "end_seconds": 137.99,
      "duration_seconds": 3.91,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.65,
      "end_seconds": 142.78,
      "duration_seconds": 3.13,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.81,
      "end_seconds": 147.64,
      "duration_seconds": 3.83,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.84,
      "end_seconds": 151.65,
      "duration_seconds": 2.81,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.67,
      "end_seconds": 156.91,
      "duration_seconds": 3.24,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.51,
      "end_seconds": 161.29,
      "duration_seconds": 2.78,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.22,
      "end_seconds": 166.01,
      "duration_seconds": 2.79,
      "text": "I've got eczema. I've got epilepsy"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.05,
      "end_seconds": 171.97,
      "duration_seconds": 3.92,
      "text": "Alright, epilepsy, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.14,
      "end_seconds": 185.93,
      "duration_seconds": 4.79,
      "text": "Do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.22,
      "end_seconds": 189.4,
      "duration_seconds": 2.18,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.62,
      "end_seconds": 202.1,
      "duration_seconds": 3.48,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.97,
      "end_seconds": 206.92,
      "duration_seconds": 3.95,
      "text": "So, I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.29,
      "end_seconds": 208.22,
      "duration_seconds": 0.93,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.07,
      "end_seconds": 213.7,
      "duration_seconds": 3.63,
      "text": "I take honey and lemon, at night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.65,
      "end_seconds": 217.59,
      "duration_seconds": 1.94,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.11,
      "end_seconds": 231.37,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.9,
      "end_seconds": 258.34,
      "duration_seconds": 10.44,
      "text": "okay: pulse is 85 beats a minute, blood pressure 124 over 72, temperature is 36.6 degrees, saturation 97 percent, respiratory rate 17."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.32,
      "end_seconds": 261.74,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.64,
      "end_seconds": 267.45,
      "duration_seconds": 3.81,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.8,
      "end_seconds": 271.87,
      "duration_seconds": 2.07,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.68,
      "end_seconds": 274.0,
      "duration_seconds": 1.32,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.33,
      "end_seconds": 290.31,
      "duration_seconds": 3.98,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.26,
      "end_seconds": 315.93,
      "duration_seconds": 19.67,
      "text": "Okay, that's enough for me. Having listened and examined, it points towards a post-viral cough that is settling. I'd also keep early asthma in mind. Stop me if I've got anything wrong. You've had a lingering cough for three days, and no weight loss or fever."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.23,
      "end_seconds": 317.93,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.3,
      "end_seconds": 339.15,
      "duration_seconds": 15.85,
      "text": "It should settle over the next two to three weeks; steam and honey can help. Keep an eye out, and if you cough up blood, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.08,
      "end_seconds": 341.57,
      "duration_seconds": 1.49,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.94,
      "end_seconds": 350.1,
      "duration_seconds": 4.16,
      "text": "let's plan a check if it lasts beyond eight weeks"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 354.96,
      "end_seconds": 359.25,
      "duration_seconds": 4.29,
      "text": "I'll book your follow-up at the front desk on your way out"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.01,
      "end_seconds": 364.26,
      "duration_seconds": 3.25,
      "text": "Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.11,
      "end_seconds": 369.32,
      "duration_seconds": 4.21,
      "text": "ah, no, that's all thanks a a lot"
    }
  ]
}