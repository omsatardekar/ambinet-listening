{
  "schema_version": "1.0",
  "encounter_id": "01033",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 3.87,
      "duration_seconds": 2.98,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.63,
      "end_seconds": 11.05,
      "duration_seconds": 5.42,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.85,
      "end_seconds": 13.18,
      "duration_seconds": 1.33,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.98,
      "end_seconds": 28.29,
      "duration_seconds": 14.31,
      "text": "I've been dealing with burning when I pass urine. It's the not knowing that gets to me. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.99,
      "end_seconds": 32.19,
      "duration_seconds": 3.2,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.13,
      "end_seconds": 47.0,
      "duration_seconds": 2.87,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.0,
      "end_seconds": 67.12,
      "duration_seconds": 5.12,
      "text": "Okay: heart rate 79, temperature 36.4, pressure 127 over 69."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 86.92,
      "duration_seconds": 3.37,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.32,
      "end_seconds": 90.34,
      "duration_seconds": 2.02,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 101.69,
      "duration_seconds": 11.1,
      "text": "I see, go ahead. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.16,
      "end_seconds": 108.99,
      "duration_seconds": 5.83,
      "text": "It sort of comes and goes. I get some relief from drinking water."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.0,
      "end_seconds": 113.53,
      "duration_seconds": 3.53,
      "text": "Have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.56,
      "end_seconds": 115.59,
      "duration_seconds": 1.03,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.84,
      "end_seconds": 123.98,
      "duration_seconds": 8.14,
      "text": "I see, go ahead. Have you had any vaginal discharge, blood in the urine or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.84,
      "end_seconds": 128.93,
      "duration_seconds": 4.09,
      "text": "Let me think, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.63,
      "end_seconds": 134.5,
      "duration_seconds": 4.87,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.74,
      "end_seconds": 138.24,
      "duration_seconds": 2.5,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.11,
      "end_seconds": 143.08,
      "duration_seconds": 3.97,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.83,
      "end_seconds": 145.79,
      "duration_seconds": 1.96,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 158.22,
      "duration_seconds": 4.8,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.25,
      "end_seconds": 162.65,
      "duration_seconds": 2.4,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.13,
      "end_seconds": 167.08,
      "duration_seconds": 2.95,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.95,
      "end_seconds": 170.83,
      "duration_seconds": 2.88,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.77,
      "end_seconds": 176.21,
      "duration_seconds": 4.44,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.06,
      "end_seconds": 180.86,
      "duration_seconds": 2.8,
      "text": "I'm on cranberry juice, daily."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.04,
      "end_seconds": 186.72,
      "duration_seconds": 2.68,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.29,
      "end_seconds": 190.79,
      "duration_seconds": 3.5,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.53,
      "end_seconds": 193.89,
      "duration_seconds": 2.36,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 202.8,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.62,
      "end_seconds": 206.85,
      "duration_seconds": 3.23,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.39,
      "end_seconds": 209.91,
      "duration_seconds": 1.52,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.7,
      "end_seconds": 221.16,
      "duration_seconds": 3.46,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.3,
      "end_seconds": 229.81,
      "duration_seconds": 2.51,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.48,
      "end_seconds": 236.13,
      "duration_seconds": 4.65,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.04,
      "end_seconds": 239.18,
      "duration_seconds": 2.14,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.06,
      "end_seconds": 255.96,
      "duration_seconds": 5.9,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 270.79,
      "duration_seconds": 9.62,
      "text": "You can relax now. Right, here's what I'm thinking. I think we're dealing with an uncomplicated urinary infection at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.46,
      "end_seconds": 275.21,
      "duration_seconds": 2.75,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.8,
      "end_seconds": 284.84,
      "duration_seconds": 9.04,
      "text": "It's reasonable to be concerned, but right now an uncomplicated urinary infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.19,
      "end_seconds": 316.67,
      "duration_seconds": 22.48,
      "text": "We should do a urine dipstick for burning urine. The treatment will be nitrofurantoin, 100 milligrams, twice a day, three days. You take it by mouth. That should help with urinary infection. Drink plenty of water and avoid holding urine. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.19,
      "end_seconds": 319.67,
      "duration_seconds": 2.48,
      "text": "Alright, thanks, take care."
    }
  ]
}