{
  "schema_version": "1.0",
  "encounter_id": "01349",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 6.73,
      "duration_seconds": 5.8,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.37,
      "end_seconds": 15.34,
      "duration_seconds": 3.97,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.21,
      "end_seconds": 21.57,
      "duration_seconds": 5.36,
      "text": "Um, so... numbness in my feet. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.19,
      "end_seconds": 24.61,
      "duration_seconds": 2.42,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.69,
      "end_seconds": 27.3,
      "duration_seconds": 1.61,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.12,
      "end_seconds": 31.34,
      "duration_seconds": 3.22,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.56,
      "end_seconds": 55.15,
      "duration_seconds": 22.59,
      "text": "I've had it for two weeks. Oh, and being unsteady in the dark. That's been about the same, four weeks. As for being unsteady in the dark, about a five out of ten. I've had burning pain in my toes too, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.24,
      "end_seconds": 61.0,
      "duration_seconds": 3.76,
      "text": "Any bladder problems, weakness or back pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.66,
      "end_seconds": 68.11,
      "duration_seconds": 5.45,
      "text": "No bladder problems, weakness or back pain, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.99,
      "end_seconds": 71.93,
      "duration_seconds": 1.94,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.87,
      "end_seconds": 77.07,
      "duration_seconds": 2.2,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.59,
      "end_seconds": 82.68,
      "duration_seconds": 4.09,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.62,
      "end_seconds": 86.25,
      "duration_seconds": 1.63,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.71,
      "end_seconds": 95.02,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.97,
      "end_seconds": 97.12,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.34,
      "end_seconds": 101.69,
      "duration_seconds": 3.35,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.25,
      "end_seconds": 104.72,
      "duration_seconds": 1.47,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.96,
      "end_seconds": 110.38,
      "duration_seconds": 4.42,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.63,
      "end_seconds": 122.35,
      "duration_seconds": 10.72,
      "text": "I do a yoga class on Thursdays. I look after my grandchildren most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.18,
      "end_seconds": 126.4,
      "duration_seconds": 3.22,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.42,
      "end_seconds": 130.26,
      "duration_seconds": 1.84,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.71,
      "end_seconds": 134.54,
      "duration_seconds": 2.83,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.29,
      "end_seconds": 150.39,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.74,
      "end_seconds": 171.39,
      "duration_seconds": 8.65,
      "text": "Okay: temperature 36.4, respiratory rate 15, blood pressure 122 over 76. And oxygen saturation is 98 percent, heart rate 66."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.59,
      "end_seconds": 175.73,
      "duration_seconds": 3.14,
      "text": "Hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.48,
      "end_seconds": 180.07,
      "duration_seconds": 2.59,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 187.07,
      "duration_seconds": 4.12,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.57,
      "end_seconds": 202.6,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.53,
      "end_seconds": 205.9,
      "duration_seconds": 2.37,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.75,
      "end_seconds": 225.87,
      "duration_seconds": 5.12,
      "text": "The ankle reflexes are reduced and the feeling is dulled below the knees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.06,
      "end_seconds": 240.53,
      "duration_seconds": 9.47,
      "text": "Please sit back down. Taking everything into account, this looks most like a peripheral neuropathy, probably related to diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.6,
      "end_seconds": 244.68,
      "duration_seconds": 3.08,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.72,
      "end_seconds": 255.04,
      "duration_seconds": 9.32,
      "text": "Nothing I've seen today points to an emergency. It looks like a peripheral neuropathy, probably related to diabetes, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.99,
      "end_seconds": 290.21,
      "duration_seconds": 16.22,
      "text": "I'd like to arrange a nerve conduction study for neuropathy. The treatment will be amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That should help with nerve pain. Check both feet daily and wear well-fitting shoes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.41,
      "end_seconds": 296.34,
      "duration_seconds": 4.93,
      "text": "Do I need a B12 level? I read it might help."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.87,
      "end_seconds": 305.9,
      "duration_seconds": 9.03,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.54,
      "end_seconds": 309.01,
      "duration_seconds": 1.47,
      "text": "That's clear, thanks."
    }
  ]
}