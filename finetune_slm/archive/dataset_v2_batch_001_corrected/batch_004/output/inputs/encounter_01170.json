{
  "schema_version": "1.0",
  "encounter_id": "01170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.9,
      "duration_seconds": 5.82,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.02,
      "end_seconds": 12.98,
      "duration_seconds": 4.96,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.41,
      "end_seconds": 21.62,
      "duration_seconds": 5.21,
      "text": "Well, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.47,
      "end_seconds": 26.86,
      "duration_seconds": 3.39,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.95,
      "end_seconds": 33.3,
      "duration_seconds": 5.35,
      "text": "Doctor, it's a blocked ear. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.68,
      "end_seconds": 38.24,
      "duration_seconds": 3.56,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.14,
      "end_seconds": 51.82,
      "duration_seconds": 12.68,
      "text": "So, honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.38,
      "end_seconds": 54.83,
      "duration_seconds": 2.45,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.15,
      "end_seconds": 70.65,
      "duration_seconds": 14.5,
      "text": "Yes, showering. That makes it worse. I've also had muffled hearing on one side, for six months. With muffled hearing on one side, I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.71,
      "end_seconds": 85.47,
      "duration_seconds": 2.76,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.33,
      "end_seconds": 94.7,
      "duration_seconds": 2.37,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.95,
      "end_seconds": 116.88,
      "duration_seconds": 9.93,
      "text": "Okay: blood pressure 117 over 79, temperature 36.5. And SpO2 99 percent on room air, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.69,
      "end_seconds": 122.3,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.73,
      "end_seconds": 126.11,
      "duration_seconds": 2.38,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 132.58,
      "duration_seconds": 4.35,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.45,
      "end_seconds": 135.06,
      "duration_seconds": 1.61,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.58,
      "end_seconds": 138.58,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.03,
      "end_seconds": 153.95,
      "duration_seconds": 3.92,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.73,
      "end_seconds": 162.21,
      "duration_seconds": 4.48,
      "text": "All finished, thank you. Did you get ear pain or dizziness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.74,
      "end_seconds": 166.49,
      "duration_seconds": 2.75,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.0,
      "end_seconds": 170.93,
      "duration_seconds": 2.93,
      "text": "Did you get ringing or discharge?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.28,
      "end_seconds": 174.33,
      "duration_seconds": 2.05,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.43,
      "end_seconds": 178.11,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.11,
      "end_seconds": 182.08,
      "duration_seconds": 1.97,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.29,
      "end_seconds": 186.06,
      "duration_seconds": 2.77,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.29,
      "end_seconds": 189.22,
      "duration_seconds": 1.93,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.06,
      "end_seconds": 201.82,
      "duration_seconds": 3.76,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.87,
      "end_seconds": 205.83,
      "duration_seconds": 1.96,
      "text": "I, I have gout."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.95,
      "end_seconds": 215.67,
      "duration_seconds": 8.72,
      "text": "Right, right. Right, so gout is already on your record. We'll keep that in mind today. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.28,
      "end_seconds": 224.14,
      "duration_seconds": 6.86,
      "text": "She is on allopurinol, 100 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.65,
      "end_seconds": 243.63,
      "duration_seconds": 3.98,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.52,
      "end_seconds": 259.37,
      "duration_seconds": 14.85,
      "text": "Nothing, I'm teetotal. My husband and I live above the shop. I drink a lot of tea and snack through the day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 262.45,
      "duration_seconds": 2.34,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.37,
      "end_seconds": 265.25,
      "duration_seconds": 1.88,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.27,
      "end_seconds": 270.45,
      "duration_seconds": 4.18,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.15,
      "end_seconds": 274.29,
      "duration_seconds": 3.14,
      "text": "Um, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.01,
      "end_seconds": 283.51,
      "duration_seconds": 8.5,
      "text": "Taking everything into account, it points towards earwax blocking the ear. I can't rule out a middle ear fluid yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.5,
      "end_seconds": 288.84,
      "duration_seconds": 3.34,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.39,
      "end_seconds": 312.95,
      "duration_seconds": 22.56,
      "text": "Nothing I've seen today points to an emergency. It looks like earwax blocking the ear, but I'd like to confirm. Let's get ear irrigation, for wax. Use the olive oil drops for a week and then we'll syringe the ear. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.15,
      "end_seconds": 322.48,
      "duration_seconds": 9.33,
      "text": "Yes. If you get ear pain or dizziness, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.52,
      "end_seconds": 325.14,
      "duration_seconds": 1.62,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.19,
      "end_seconds": 336.0,
      "duration_seconds": 8.81,
      "text": "Please come and see me in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.69,
      "end_seconds": 341.16,
      "duration_seconds": 4.47,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.94,
      "end_seconds": 348.39,
      "duration_seconds": 1.45,
      "text": "Take care now."
    }
  ]
}