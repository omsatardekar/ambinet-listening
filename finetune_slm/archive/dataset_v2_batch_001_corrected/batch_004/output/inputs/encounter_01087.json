{
  "schema_version": "1.0",
  "encounter_id": "01087",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 5.17,
      "duration_seconds": 4.5,
      "text": "I mean, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.77,
      "end_seconds": 9.53,
      "duration_seconds": 3.76,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.37,
      "end_seconds": 21.15,
      "duration_seconds": 10.78,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. Let me think, we came because of an irregular heartbeat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.86,
      "end_seconds": 25.8,
      "duration_seconds": 2.94,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.56,
      "end_seconds": 31.41,
      "duration_seconds": 4.85,
      "text": "Let me think, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.86,
      "end_seconds": 52.15,
      "duration_seconds": 2.29,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.51,
      "end_seconds": 55.71,
      "duration_seconds": 2.2,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.29,
      "end_seconds": 57.34,
      "duration_seconds": 1.05,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.13,
      "end_seconds": 70.07,
      "duration_seconds": 11.94,
      "text": "Mm, there's occasional bruising as well. Okay, so and there's being short of breath on slopes as well, ten days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.28,
      "end_seconds": 75.11,
      "duration_seconds": 3.83,
      "text": "Any nosebleeds, fainting or black stools at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.65,
      "end_seconds": 81.89,
      "duration_seconds": 5.24,
      "text": "Well, no, no nosebleeds, fainting or black stools."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 85.8,
      "duration_seconds": 2.25,
      "text": "Okay, what about chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.29,
      "end_seconds": 89.23,
      "duration_seconds": 1.94,
      "text": "Definitely no chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.01,
      "end_seconds": 96.17,
      "duration_seconds": 5.16,
      "text": "Okay, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.22,
      "end_seconds": 101.96,
      "duration_seconds": 4.74,
      "text": "Um, um, no, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.67,
      "end_seconds": 120.98,
      "duration_seconds": 1.31,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.6,
      "end_seconds": 125.47,
      "duration_seconds": 3.87,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.38,
      "end_seconds": 128.14,
      "duration_seconds": 1.76,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.21,
      "end_seconds": 133.26,
      "duration_seconds": 4.05,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.58,
      "end_seconds": 140.15,
      "duration_seconds": 5.57,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.01,
      "end_seconds": 146.37,
      "duration_seconds": 5.36,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.96,
      "end_seconds": 150.53,
      "duration_seconds": 2.57,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.54,
      "end_seconds": 155.47,
      "duration_seconds": 2.93,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.6,
      "end_seconds": 159.87,
      "duration_seconds": 3.27,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.89,
      "end_seconds": 171.19,
      "duration_seconds": 10.3,
      "text": "I have an irregular heartbeat, for nearly five years. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.45,
      "end_seconds": 182.0,
      "duration_seconds": 9.55,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.86,
      "end_seconds": 185.57,
      "duration_seconds": 2.71,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.22,
      "end_seconds": 190.39,
      "duration_seconds": 4.17,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.27,
      "end_seconds": 205.54,
      "duration_seconds": 2.27,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.35,
      "end_seconds": 229.87,
      "duration_seconds": 9.52,
      "text": "Okay: temperature is 37.0 degrees, heart rate 126, pressure 122 over 85. And respiratory rate 20, saturation 97 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.16,
      "end_seconds": 234.47,
      "duration_seconds": 3.31,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.38,
      "end_seconds": 239.21,
      "duration_seconds": 2.83,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.96,
      "end_seconds": 258.13,
      "duration_seconds": 5.17,
      "text": "Your pulse is irregular and your heart sounds are otherwise normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.5,
      "end_seconds": 274.2,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.45,
      "end_seconds": 285.52,
      "duration_seconds": 8.07,
      "text": "Okay, that's enough for me. Okay, thinking it through, my working impression is atrial fibrillation, rate reasonably controlled."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.26,
      "end_seconds": 289.24,
      "duration_seconds": 2.98,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.22,
      "end_seconds": 310.59,
      "duration_seconds": 19.37,
      "text": "Nothing I've seen today points to an emergency. It looks like atrial fibrillation, rate reasonably controlled, but I'd like to confirm. Let's get kidney function tests, for anticoagulant dosing. I'm going to order a full blood count, for anticoagulant review."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.97,
      "end_seconds": 315.01,
      "duration_seconds": 3.04,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.76,
      "end_seconds": 331.18,
      "duration_seconds": 15.42,
      "text": "I'm going to order an ECG, for irregular pulse. Never skip the blood thinner, and tell any dentist or surgeon you take it. Do get help quickly if the symptoms get worse. Book a review in three months."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.83,
      "end_seconds": 337.78,
      "duration_seconds": 3.95,
      "text": "Let me think, alright, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.56,
      "end_seconds": 343.37,
      "duration_seconds": 4.81,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.41,
      "end_seconds": 347.78,
      "duration_seconds": 2.37,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.26,
      "end_seconds": 351.18,
      "duration_seconds": 1.92,
      "text": "Have a good day."
    }
  ]
}