{
  "schema_version": "1.0",
  "encounter_id": "01273",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.87,
      "duration_seconds": 4.12,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 10.76,
      "duration_seconds": 3.87,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.74,
      "end_seconds": 13.75,
      "duration_seconds": 2.01,
      "text": "I've been feeling confused"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.64,
      "end_seconds": 18.86,
      "duration_seconds": 3.22,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.99,
      "end_seconds": 21.94,
      "duration_seconds": 1.95,
      "text": "probably five days yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.74,
      "end_seconds": 26.83,
      "duration_seconds": 4.09,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.24,
      "end_seconds": 31.09,
      "duration_seconds": 2.85,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.02,
      "end_seconds": 35.09,
      "duration_seconds": 2.07,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.87,
      "end_seconds": 39.87,
      "duration_seconds": 4.0,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.13,
      "end_seconds": 46.06,
      "duration_seconds": 1.93,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.12,
      "end_seconds": 50.5,
      "duration_seconds": 3.38,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.98,
      "end_seconds": 66.55,
      "duration_seconds": 2.57,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.08,
      "end_seconds": 70.09,
      "duration_seconds": 2.01,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.87,
      "end_seconds": 76.88,
      "duration_seconds": 5.01,
      "text": "Okay, I can see an irregular heartbeat in your file as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 87.56,
      "duration_seconds": 2.63,
      "text": "right, tell me your medicines, please"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.13,
      "end_seconds": 95.52,
      "duration_seconds": 6.39,
      "text": "Bisoprolol, 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.01,
      "end_seconds": 116.83,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.71,
      "end_seconds": 121.69,
      "duration_seconds": 2.98,
      "text": "No, um, not at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.19,
      "end_seconds": 130.24,
      "duration_seconds": 5.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.67,
      "end_seconds": 134.06,
      "duration_seconds": 2.39,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.61,
      "end_seconds": 138.6,
      "duration_seconds": 3.99,
      "text": "Did you get stiff neck, rash or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.32,
      "end_seconds": 142.29,
      "duration_seconds": 2.97,
      "text": "I mean, nope, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.78,
      "end_seconds": 149.11,
      "duration_seconds": 2.33,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.42,
      "end_seconds": 156.47,
      "duration_seconds": 2.05,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.96,
      "end_seconds": 162.91,
      "duration_seconds": 2.95,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.89,
      "end_seconds": 166.86,
      "duration_seconds": 1.97,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.71,
      "end_seconds": 171.64,
      "duration_seconds": 2.93,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.88,
      "end_seconds": 186.23,
      "duration_seconds": 3.35,
      "text": "okay, keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.11,
      "end_seconds": 206.99,
      "duration_seconds": 7.88,
      "text": "okay: SpO2 95 percent on room air, temp 38.5 degrees, pulse 100. And pressure 114 over 70."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.81,
      "end_seconds": 209.17,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.38,
      "end_seconds": 213.32,
      "duration_seconds": 2.94,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.32,
      "end_seconds": 219.75,
      "duration_seconds": 4.43,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.28,
      "end_seconds": 223.35,
      "duration_seconds": 2.07,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 245.31,
      "duration_seconds": 7.05,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.82,
      "end_seconds": 267.68,
      "duration_seconds": 16.86,
      "text": "Okay, that's enough for me. So where does that leave us? I don't have a clear answer today: possible sepsis needing urgent treatment is possible, and so is a severe urine or chest infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.5,
      "end_seconds": 271.28,
      "duration_seconds": 2.78,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.18,
      "end_seconds": 285.97,
      "duration_seconds": 12.79,
      "text": "I understand the worry. At the the moment I'd say it's possible sepsis needing urgent treatment, and we'll know more once the blood cultures is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.53,
      "end_seconds": 312.77,
      "duration_seconds": 16.24,
      "text": "Let's book blood cultures to look into fever with low blood pressure. Let's book lactate and blood tests to look into sepsis. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.61,
      "end_seconds": 314.82,
      "duration_seconds": 1.21,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.7,
      "end_seconds": 337.62,
      "duration_seconds": 21.92,
      "text": "I wanna admit you to hospital now for fluids and antibiotics. Cut back on tea, coffee and and fizzy drinks for a couple of weeks and see how things settle. I'll also refer you to the emergency team. One warning sign to remember: you cannot be brought in today. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.17,
      "end_seconds": 340.81,
      "duration_seconds": 1.64,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.67,
      "end_seconds": 347.85,
      "duration_seconds": 6.18,
      "text": "Let's review you straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.0,
      "end_seconds": 352.07,
      "duration_seconds": 3.07,
      "text": "good, thanks, I'll see you then"
    }
  ]
}