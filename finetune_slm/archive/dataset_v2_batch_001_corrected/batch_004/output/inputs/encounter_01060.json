{
  "schema_version": "1.0",
  "encounter_id": "01060",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 5.97,
      "duration_seconds": 4.96,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.87,
      "end_seconds": 10.36,
      "duration_seconds": 2.49,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.99,
      "end_seconds": 13.75,
      "duration_seconds": 1.76,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.2,
      "end_seconds": 19.66,
      "duration_seconds": 4.46,
      "text": "So, I've been getting breathless lying flat, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.09,
      "end_seconds": 23.99,
      "duration_seconds": 2.9,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.93,
      "end_seconds": 29.08,
      "duration_seconds": 3.15,
      "text": "Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.79,
      "end_seconds": 32.65,
      "duration_seconds": 1.86,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.09,
      "end_seconds": 36.82,
      "duration_seconds": 2.73,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.48,
      "end_seconds": 42.43,
      "duration_seconds": 3.95,
      "text": "Okay, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.1,
      "end_seconds": 47.2,
      "duration_seconds": 4.1,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.71,
      "end_seconds": 59.02,
      "duration_seconds": 3.31,
      "text": "Did you get palpitations, fainting or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.59,
      "end_seconds": 63.43,
      "duration_seconds": 2.84,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.16,
      "end_seconds": 69.85,
      "duration_seconds": 4.69,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 73.48,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.99,
      "end_seconds": 77.38,
      "duration_seconds": 2.39,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.4,
      "end_seconds": 80.66,
      "duration_seconds": 2.26,
      "text": "I have heart failure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.41,
      "end_seconds": 88.07,
      "duration_seconds": 6.66,
      "text": "Okay, yes, heart failure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.51,
      "end_seconds": 101.37,
      "duration_seconds": 2.86,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.17,
      "end_seconds": 106.08,
      "duration_seconds": 3.91,
      "text": "I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.74,
      "end_seconds": 122.99,
      "duration_seconds": 2.25,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.3,
      "end_seconds": 128.03,
      "duration_seconds": 3.73,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.81,
      "end_seconds": 131.81,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.46,
      "end_seconds": 136.38,
      "duration_seconds": 3.92,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.13,
      "end_seconds": 138.98,
      "duration_seconds": 1.85,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.54,
      "end_seconds": 143.28,
      "duration_seconds": 3.74,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.23,
      "end_seconds": 165.15,
      "duration_seconds": 2.92,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.05,
      "end_seconds": 174.53,
      "duration_seconds": 2.48,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.85,
      "end_seconds": 203.97,
      "duration_seconds": 9.12,
      "text": "Okay: temp 37.2 degrees, pressure 127 over 79, pulse is 96 beats a minute, respiratory rate 21."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.87,
      "end_seconds": 210.69,
      "duration_seconds": 3.82,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.07,
      "end_seconds": 213.48,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.04,
      "end_seconds": 237.72,
      "duration_seconds": 6.68,
      "text": "There is pitting swelling of both ankles and a few crackles at the lung bases."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.13,
      "end_seconds": 269.88,
      "duration_seconds": 26.75,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: I think we're dealing with heart failure with some fluid on board at this stage. The reason I say that is that your story and my examination fit together. Let me repeat that back to make sure. You've been getting breathless lying flat, since this morning, and no chest pain or palpitations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.28,
      "end_seconds": 271.98,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.28,
      "end_seconds": 307.23,
      "duration_seconds": 31.95,
      "text": "I want blood tests done, that's for heart failure. That will help us see what's going on underneath and decide the next step. I'm going to put you on furosemide, 40 milligrams, once a day in the morning, long term. You take it by mouth. It's for fluid retention. Weigh yourself every morning and tell us if you gain two kilos in three days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.37,
      "end_seconds": 325.21,
      "duration_seconds": 12.84,
      "text": "I'd like you to see the heart failure nurse as well, and I'll write the referral. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.05,
      "end_seconds": 328.29,
      "duration_seconds": 2.24,
      "text": "I, I'll remember that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.74,
      "end_seconds": 336.49,
      "duration_seconds": 6.75,
      "text": "Let's review you in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.26,
      "end_seconds": 340.52,
      "duration_seconds": 2.26,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.98,
      "end_seconds": 343.95,
      "duration_seconds": 1.97,
      "text": "Have a good day."
    }
  ]
}