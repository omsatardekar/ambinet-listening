{
  "schema_version": "1.0",
  "encounter_id": "01431",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.05,
      "end_seconds": 5.27,
      "duration_seconds": 4.22,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 11.31,
      "duration_seconds": 5.15,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.82,
      "end_seconds": 17.63,
      "duration_seconds": 5.81,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.25,
      "end_seconds": 22.2,
      "duration_seconds": 2.95,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.54,
      "end_seconds": 27.43,
      "duration_seconds": 3.89,
      "text": "She's been getting breathless lying flat, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.7,
      "end_seconds": 32.05,
      "duration_seconds": 3.35,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.84,
      "end_seconds": 35.64,
      "duration_seconds": 2.8,
      "text": "I'd say three weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.24,
      "end_seconds": 41.14,
      "duration_seconds": 3.9,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.3,
      "end_seconds": 47.1,
      "duration_seconds": 4.8,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.7,
      "end_seconds": 50.14,
      "duration_seconds": 2.44,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.7,
      "end_seconds": 60.92,
      "duration_seconds": 9.22,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.86,
      "end_seconds": 70.93,
      "duration_seconds": 9.07,
      "text": "I, I'd say a few times a day. I'd say mild. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.93,
      "end_seconds": 74.41,
      "duration_seconds": 2.48,
      "text": "So, any tiredness as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.39,
      "end_seconds": 88.29,
      "duration_seconds": 12.9,
      "text": "Um, you know, yeah. Three days, I'd say. Oh, and swollen ankles. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.02,
      "end_seconds": 92.67,
      "duration_seconds": 3.65,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.87,
      "end_seconds": 96.31,
      "duration_seconds": 2.44,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.89,
      "end_seconds": 99.63,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.19,
      "end_seconds": 124.87,
      "duration_seconds": 19.68,
      "text": "Yes, high blood pressure. I have heart failure, for about ten years. Arthritis in my knees, for five years. I've been putting this off for weeks. Right, um, I have an irregular heartbeat, for five years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.17,
      "end_seconds": 129.25,
      "duration_seconds": 3.08,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.24,
      "end_seconds": 136.76,
      "duration_seconds": 5.52,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.42,
      "end_seconds": 141.17,
      "duration_seconds": 3.75,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.81,
      "end_seconds": 150.25,
      "duration_seconds": 7.44,
      "text": "Uh, it's hydrochlorothiazide, 12.5 milligrams, maybe, every morning for my pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.16,
      "end_seconds": 156.83,
      "duration_seconds": 4.67,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.55,
      "end_seconds": 171.25,
      "duration_seconds": 13.7,
      "text": "Not with me. I'll bring it next time. Carvedilol, 6.25 milligrams, twice a day for my heart. Paracetamol. I take it 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 176.03,
      "end_seconds": 186.28,
      "duration_seconds": 10.25,
      "text": "Right, doctor, I think the last prescription for the paracetamol was 325 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.61,
      "end_seconds": 190.44,
      "duration_seconds": 2.83,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.87,
      "end_seconds": 201.97,
      "duration_seconds": 10.1,
      "text": "Uh, no, I left it at home. I, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.78,
      "end_seconds": 205.16,
      "duration_seconds": 2.38,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.7,
      "end_seconds": 209.28,
      "duration_seconds": 3.58,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.05,
      "end_seconds": 212.84,
      "duration_seconds": 1.79,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.72,
      "end_seconds": 216.19,
      "duration_seconds": 2.47,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.42,
      "end_seconds": 231.34,
      "duration_seconds": 3.92,
      "text": "Did you get chest pain, fainting or palpitations?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.92,
      "end_seconds": 239.0,
      "duration_seconds": 6.08,
      "text": "Um, I haven't had chest pain, fainting or palpitations, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.65,
      "end_seconds": 243.66,
      "duration_seconds": 3.01,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.47,
      "end_seconds": 246.48,
      "duration_seconds": 1.01,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.61,
      "end_seconds": 249.71,
      "duration_seconds": 2.1,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.93,
      "end_seconds": 252.67,
      "duration_seconds": 1.74,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 254.13,
      "end_seconds": 262.03,
      "duration_seconds": 7.9,
      "text": "Here are the numbers, doctor. Heart rate 100, BP is 131 over 86. Saturation 92 percent, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.65,
      "end_seconds": 264.35,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.37,
      "end_seconds": 288.12,
      "duration_seconds": 8.75,
      "text": "Listening to the whole story, my working impression is heart failure with some fluid on board. A kidney problem is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.06,
      "end_seconds": 293.09,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.59,
      "end_seconds": 304.31,
      "duration_seconds": 9.72,
      "text": "It's reasonable to be concerned, but right now heart failure with some fluid on board is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.66,
      "end_seconds": 331.04,
      "duration_seconds": 8.38,
      "text": "Let's book an echocardiogram to look into heart failure. I'd like to arrange blood tests for heart failure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 332.68,
      "end_seconds": 334.38,
      "duration_seconds": 1.7,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.02,
      "end_seconds": 340.86,
      "duration_seconds": 5.84,
      "text": "Weigh yourself every morning and tell us if you gain two kilos in three days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.34,
      "end_seconds": 349.41,
      "duration_seconds": 8.07,
      "text": "Okay, go on. I'd like you to see the heart failure nurse as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.85,
      "end_seconds": 352.55,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.38,
      "end_seconds": 367.89,
      "duration_seconds": 13.51,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.44,
      "end_seconds": 372.87,
      "duration_seconds": 3.43,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.18,
      "end_seconds": 378.89,
      "duration_seconds": 4.71,
      "text": "Book a review in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.2,
      "end_seconds": 383.51,
      "duration_seconds": 3.31,
      "text": "I think I understand everything. Thanks."
    }
  ]
}