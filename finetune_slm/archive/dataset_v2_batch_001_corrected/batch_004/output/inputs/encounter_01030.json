{
  "schema_version": "1.0",
  "encounter_id": "01030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 5.77,
      "duration_seconds": 5.25,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 11.53,
      "duration_seconds": 3.77,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.25,
      "end_seconds": 16.45,
      "duration_seconds": 3.2,
      "text": "Well, I've been having pelvic pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.77,
      "end_seconds": 20.63,
      "duration_seconds": 2.86,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.6,
      "end_seconds": 24.43,
      "duration_seconds": 2.83,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.1,
      "end_seconds": 35.12,
      "duration_seconds": 10.02,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.53,
      "end_seconds": 50.84,
      "duration_seconds": 10.31,
      "text": "It happens once or twice a day. It's worse with moving. Mild, I'd say. And a smelly discharge, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.27,
      "end_seconds": 57.89,
      "duration_seconds": 5.62,
      "text": "Have you had pelvic pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.15,
      "end_seconds": 68.89,
      "duration_seconds": 6.74,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.56,
      "end_seconds": 79.75,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.51,
      "end_seconds": 82.1,
      "duration_seconds": 1.59,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.69,
      "end_seconds": 84.94,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.75,
      "end_seconds": 92.46,
      "duration_seconds": 2.71,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.47,
      "end_seconds": 96.47,
      "duration_seconds": 3.0,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.7,
      "end_seconds": 101.59,
      "duration_seconds": 3.89,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.11,
      "end_seconds": 103.75,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.98,
      "end_seconds": 108.88,
      "duration_seconds": 3.9,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.56,
      "end_seconds": 127.51,
      "duration_seconds": 3.95,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.6,
      "end_seconds": 135.14,
      "duration_seconds": 6.54,
      "text": "Anxiety, for about ten years. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.79,
      "end_seconds": 140.66,
      "duration_seconds": 3.87,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.2,
      "end_seconds": 144.69,
      "duration_seconds": 3.49,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.18,
      "end_seconds": 150.49,
      "duration_seconds": 4.31,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.56,
      "end_seconds": 155.73,
      "duration_seconds": 4.17,
      "text": "I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.15,
      "end_seconds": 159.79,
      "duration_seconds": 2.64,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.01,
      "end_seconds": 162.25,
      "duration_seconds": 1.24,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.87,
      "end_seconds": 167.81,
      "duration_seconds": 4.94,
      "text": "Let me check a few things. Any recent pregnancy or vomiting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.46,
      "end_seconds": 170.59,
      "duration_seconds": 2.13,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.13,
      "end_seconds": 174.47,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.22,
      "end_seconds": 179.09,
      "duration_seconds": 2.87,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.07,
      "end_seconds": 185.97,
      "duration_seconds": 4.9,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.56,
      "end_seconds": 189.09,
      "duration_seconds": 1.53,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.64,
      "end_seconds": 193.11,
      "duration_seconds": 3.47,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.03,
      "end_seconds": 204.57,
      "duration_seconds": 2.54,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 230.19,
      "duration_seconds": 7.55,
      "text": "Okay: saturation 95 percent, BP is 124 over 76, pulse is 90 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.35,
      "end_seconds": 233.68,
      "duration_seconds": 2.33,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.78,
      "end_seconds": 237.3,
      "duration_seconds": 2.52,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 262.03,
      "duration_seconds": 6.39,
      "text": "You are very tender low in the tummy, and it hurts when I move the cervix."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.87,
      "end_seconds": 267.37,
      "duration_seconds": 2.5,
      "text": "Okay, please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.58,
      "end_seconds": 287.59,
      "duration_seconds": 12.01,
      "text": "From what you've told me and what I found, I can't pin this down yet. We're looking at severe pelvic inflammatory disease or an abscess."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.71,
      "end_seconds": 290.13,
      "duration_seconds": 1.42,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.66,
      "end_seconds": 321.64,
      "duration_seconds": 29.98,
      "text": "It's reasonable to be concerned, but right now severe pelvic inflammatory disease is my leading thought, not anything worse. I'm going to order a pelvic scan, for pelvic pain. Swabs is what I'd like next, for pelvic infection. The treatment will be ceftriaxone, 1 gram, once now, single dose. It's for pelvic infection. It's a commonly used medicine and most people tolerate it well. You need hospital treatment today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.42,
      "end_seconds": 333.95,
      "duration_seconds": 11.53,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.25,
      "end_seconds": 338.94,
      "duration_seconds": 3.69,
      "text": "Yeah, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.63,
      "end_seconds": 340.84,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}