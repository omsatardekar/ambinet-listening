{
  "schema_version": "1.0",
  "encounter_id": "01358",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.18,
      "duration_seconds": 5.31,
      "text": "hello? Doctor? I was told to to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.48,
      "end_seconds": 13.2,
      "duration_seconds": 3.72,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.03,
      "end_seconds": 29.88,
      "duration_seconds": 13.85,
      "text": "Hmm, mainly a red sticky eye. There's a couple of other things, but that's the main one. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.88,
      "end_seconds": 35.0,
      "duration_seconds": 3.12,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.57,
      "end_seconds": 48.19,
      "duration_seconds": 12.62,
      "text": "About... well, two days. I'm not great at remembering details, so bear with me. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.34,
      "end_seconds": 51.42,
      "duration_seconds": 2.08,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.15,
      "end_seconds": 72.06,
      "duration_seconds": 19.91,
      "text": "Crusting in the morning goes along with it, most of the time. Well, um, the Crusting in the morning? That's been since Friday. I had a gritty feeling before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.26,
      "end_seconds": 95.11,
      "duration_seconds": 5.85,
      "text": "Let me check a few things. Any blurred vision or sensitivity to light?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.79,
      "end_seconds": 101.85,
      "duration_seconds": 6.06,
      "text": "Right, no blurred vision or sensitivity to light, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.53,
      "end_seconds": 110.05,
      "duration_seconds": 6.52,
      "text": "Let me check a few things. Any contact lens or pain in the eye?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.12,
      "end_seconds": 113.56,
      "duration_seconds": 2.44,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.69,
      "end_seconds": 117.69,
      "duration_seconds": 3.0,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 123.04,
      "duration_seconds": 4.81,
      "text": "Actually, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.92,
      "end_seconds": 127.7,
      "duration_seconds": 2.78,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.22,
      "end_seconds": 130.2,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.29,
      "end_seconds": 135.54,
      "duration_seconds": 4.25,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.56,
      "end_seconds": 138.67,
      "duration_seconds": 2.11,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.35,
      "end_seconds": 155.36,
      "duration_seconds": 3.01,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.58,
      "end_seconds": 159.31,
      "duration_seconds": 2.73,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.81,
      "end_seconds": 163.58,
      "duration_seconds": 2.77,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.59,
      "end_seconds": 169.86,
      "duration_seconds": 3.27,
      "text": "Well, I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.47,
      "end_seconds": 174.31,
      "duration_seconds": 2.84,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.41,
      "end_seconds": 185.29,
      "duration_seconds": 9.88,
      "text": "I have thin bones, for nearly five years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.97,
      "end_seconds": 189.09,
      "duration_seconds": 2.12,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.55,
      "end_seconds": 196.53,
      "duration_seconds": 5.98,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.51,
      "end_seconds": 204.34,
      "duration_seconds": 2.83,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.91,
      "end_seconds": 213.26,
      "duration_seconds": 5.35,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.99,
      "end_seconds": 232.22,
      "duration_seconds": 4.23,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.06,
      "end_seconds": 247.89,
      "duration_seconds": 2.83,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.91,
      "end_seconds": 278.02,
      "duration_seconds": 18.11,
      "text": "okay: BMI works out to 26.8, height 165 centimetres and BP is 114 over 82, oxygen saturation is 99 percent, weight 73 kilos, pulse is 76 beats a minute, temp 36.8 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 283.81,
      "duration_seconds": 4.01,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.05,
      "end_seconds": 287.42,
      "duration_seconds": 2.37,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.97,
      "end_seconds": 309.85,
      "duration_seconds": 6.88,
      "text": "The white of the eye is pink with some sticky discharge, and your pupil is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.72,
      "end_seconds": 312.72,
      "duration_seconds": 1.0,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.5,
      "end_seconds": 329.23,
      "duration_seconds": 10.73,
      "text": "That's all I needed to check. Let me tell you where I've got to. This is probably infective conjunctivitis. We shouldn't forget allergic conjunctivitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.14,
      "end_seconds": 331.86,
      "duration_seconds": 1.72,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.24,
      "end_seconds": 346.05,
      "duration_seconds": 12.81,
      "text": "Nothing I've seen today points to an emergency. It looks like infective conjunctivitis. Wash your hands often and don't share towels. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.44,
      "end_seconds": 357.13,
      "duration_seconds": 5.69,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.47,
      "end_seconds": 360.04,
      "duration_seconds": 1.57,
      "text": "have a good day"
    }
  ]
}