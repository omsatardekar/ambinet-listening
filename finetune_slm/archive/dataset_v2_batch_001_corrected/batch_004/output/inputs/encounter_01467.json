{
  "schema_version": "1.0",
  "encounter_id": "01467",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 7.54,
      "duration_seconds": 6.35,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 13.16,
      "duration_seconds": 4.4,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.26,
      "end_seconds": 17.07,
      "duration_seconds": 2.81,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.77,
      "end_seconds": 22.25,
      "duration_seconds": 4.48,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.2,
      "end_seconds": 28.95,
      "duration_seconds": 5.75,
      "text": "It's being very thirsty. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.13,
      "end_seconds": 34.48,
      "duration_seconds": 4.35,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.87,
      "end_seconds": 45.75,
      "duration_seconds": 2.88,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.76,
      "end_seconds": 70.62,
      "duration_seconds": 10.86,
      "text": "Okay: SpO2 96 percent on room air, pulse 120, pressure 122 over 86, respiratory rate 18. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.04,
      "end_seconds": 75.85,
      "duration_seconds": 3.81,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.46,
      "end_seconds": 84.99,
      "duration_seconds": 8.53,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 90.8,
      "duration_seconds": 5.14,
      "text": "Ah, I get some relief from water. I'd say moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.74,
      "end_seconds": 98.34,
      "duration_seconds": 6.6,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 98.44,
      "end_seconds": 103.97,
      "duration_seconds": 5.53,
      "text": "Erm, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 107.98,
      "duration_seconds": 2.3,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.83,
      "end_seconds": 114.59,
      "duration_seconds": 4.76,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.54,
      "end_seconds": 144.95,
      "duration_seconds": 28.41,
      "text": "And I've been passing a lot of urine as well, since Friday. Ah, with passing a lot of urine, I'd call it moderate. As for vomiting, I honestly can't say when that began. It might have been last month or the month before. With vomiting, it happens on and off."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.67,
      "end_seconds": 150.86,
      "duration_seconds": 5.19,
      "text": "Have you had being very thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.61,
      "end_seconds": 158.2,
      "duration_seconds": 5.59,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.09,
      "end_seconds": 174.56,
      "duration_seconds": 4.47,
      "text": "Let me check a few things. Any chest pain or cough?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.01,
      "end_seconds": 187.69,
      "duration_seconds": 11.68,
      "text": "No, no chest pain, no cough. I did have deep fast breathing at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.09,
      "end_seconds": 192.46,
      "duration_seconds": 3.37,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.3,
      "end_seconds": 196.5,
      "duration_seconds": 2.2,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.05,
      "end_seconds": 201.42,
      "duration_seconds": 3.37,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.66,
      "end_seconds": 207.71,
      "duration_seconds": 5.05,
      "text": "I've had diabetes for about a year now. I've got migraines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.79,
      "end_seconds": 210.49,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.28,
      "end_seconds": 217.62,
      "duration_seconds": 5.34,
      "text": "I've had an enlarged prostate for about ten years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.7,
      "end_seconds": 222.89,
      "duration_seconds": 4.19,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.68,
      "end_seconds": 228.63,
      "duration_seconds": 3.95,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.82,
      "end_seconds": 247.24,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.42,
      "end_seconds": 251.55,
      "duration_seconds": 3.13,
      "text": "Okay, so no, not at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.05,
      "end_seconds": 255.7,
      "duration_seconds": 2.65,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.03,
      "end_seconds": 264.54,
      "duration_seconds": 4.51,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.5,
      "end_seconds": 268.4,
      "duration_seconds": 2.9,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.39,
      "end_seconds": 274.22,
      "duration_seconds": 3.83,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.08,
      "end_seconds": 279.87,
      "duration_seconds": 3.79,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.79,
      "end_seconds": 290.27,
      "duration_seconds": 8.48,
      "text": "Okay, so it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.07,
      "end_seconds": 293.52,
      "duration_seconds": 2.45,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.3,
      "end_seconds": 309.58,
      "duration_seconds": 15.28,
      "text": "For my sugar, I believe. My wife sets them out for me, I just take what I'm given. I'm on something called prop... propranolol, 40 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.87,
      "end_seconds": 314.44,
      "duration_seconds": 3.57,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.75,
      "end_seconds": 321.62,
      "duration_seconds": 5.87,
      "text": "No, it's at home. Tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.31,
      "end_seconds": 327.69,
      "duration_seconds": 4.38,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.69,
      "end_seconds": 332.55,
      "duration_seconds": 2.86,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.38,
      "end_seconds": 348.39,
      "duration_seconds": 4.01,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.73,
      "end_seconds": 377.09,
      "duration_seconds": 23.36,
      "text": "Okay, that's enough for me. So, based on the history and the examination, I'd lean towards diabetic ketoacidosis. It could also be a severe infection, so we'll keep that open. Let me just check I've got this right. You've had being very thirsty, yesterday, moderate, and no cough or chest pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.1,
      "end_seconds": 379.8,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.84,
      "end_seconds": 392.31,
      "duration_seconds": 7.47,
      "text": "A blood sugar and ketone test is what I'd like next, for thirst and vomiting."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 393.89,
      "end_seconds": 398.18,
      "duration_seconds": 4.29,
      "text": "We have a slot Tuesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.98,
      "end_seconds": 403.97,
      "duration_seconds": 0.99,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.67,
      "end_seconds": 409.12,
      "duration_seconds": 4.45,
      "text": "I think blood gas and electrolytes makes sense here, for DKA."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.51,
      "end_seconds": 413.6,
      "duration_seconds": 3.09,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.47,
      "end_seconds": 446.06,
      "duration_seconds": 30.59,
      "text": "You need to go to hospital now for insulin and fluids. I'd like you to see the emergency team as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if you cannot get there now. I'd like to see you again straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.74,
      "end_seconds": 449.96,
      "duration_seconds": 2.22,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.79,
      "end_seconds": 454.15,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    }
  ]
}