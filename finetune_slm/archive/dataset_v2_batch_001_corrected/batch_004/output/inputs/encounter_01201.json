{
  "schema_version": "1.0",
  "encounter_id": "01201",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 3.74,
      "duration_seconds": 2.99,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.51,
      "end_seconds": 10.36,
      "duration_seconds": 4.85,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.18,
      "end_seconds": 16.97,
      "duration_seconds": 5.79,
      "text": "it's vomiting. I thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.36,
      "end_seconds": 25.44,
      "duration_seconds": 3.08,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.7,
      "end_seconds": 33.67,
      "duration_seconds": 6.97,
      "text": "About four days, I think... sorry, five days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.52,
      "end_seconds": 37.44,
      "duration_seconds": 2.92,
      "text": "Have you been feeling extremely weak?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.31,
      "end_seconds": 42.04,
      "duration_seconds": 2.73,
      "text": "Yeah. Ten days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.44,
      "end_seconds": 43.26,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.38,
      "end_seconds": 59.4,
      "duration_seconds": 3.02,
      "text": "Have you noticed chest pain or fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.44,
      "end_seconds": 64.5,
      "duration_seconds": 4.06,
      "text": "No chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.66,
      "end_seconds": 68.03,
      "duration_seconds": 2.37,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.47,
      "end_seconds": 70.46,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.15,
      "end_seconds": 78.65,
      "duration_seconds": 3.5,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.38,
      "end_seconds": 82.53,
      "duration_seconds": 3.15,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.17,
      "end_seconds": 87.36,
      "duration_seconds": 3.19,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.39,
      "end_seconds": 96.95,
      "duration_seconds": 7.56,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.26,
      "end_seconds": 115.91,
      "duration_seconds": 2.65,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.79,
      "end_seconds": 123.51,
      "duration_seconds": 5.72,
      "text": "I'm on my steroid tablets, 5 milligrams, stopped last week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.15,
      "end_seconds": 144.16,
      "duration_seconds": 4.01,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 147.81,
      "duration_seconds": 2.99,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.59,
      "end_seconds": 151.0,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.39,
      "end_seconds": 163.12,
      "duration_seconds": 10.73,
      "text": "I'm a plumber, lots of bending and kneeling. Not much, I mostly stay in these days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 167.91,
      "duration_seconds": 2.88,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.06,
      "end_seconds": 177.0,
      "duration_seconds": 2.94,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.89,
      "end_seconds": 207.74,
      "duration_seconds": 12.85,
      "text": "Okay: respiratory rate 17, BP is 93 over 58, height 180 centimetres, weight 52 kilos, temp 36.6 degrees, pulse is 112 beats a minute."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.81,
      "end_seconds": 210.18,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.77,
      "end_seconds": 213.19,
      "duration_seconds": 2.42,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.37,
      "end_seconds": 218.21,
      "duration_seconds": 3.84,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.2,
      "end_seconds": 221.19,
      "duration_seconds": 0.99,
      "text": "of course"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.58,
      "end_seconds": 225.55,
      "duration_seconds": 2.97,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.03,
      "end_seconds": 238.33,
      "duration_seconds": 4.3,
      "text": "Your blood pressure is very low and your skin is cool."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.57,
      "end_seconds": 243.41,
      "duration_seconds": 2.84,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.9,
      "end_seconds": 273.52,
      "duration_seconds": 19.62,
      "text": "Let me tell you where I've got to. The most likely explanation is a possible adrenal crisis after stopping steroids. I'd like to arrange blood tests for adrenal crisis. I'll start you on hydrocortisone, 100 milligrams, once now, single dose. It's for adrenal crisis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.16,
      "end_seconds": 279.2,
      "duration_seconds": 4.04,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.91,
      "end_seconds": 293.82,
      "duration_seconds": 12.91,
      "text": "I am giving an injection now and calling an ambulance we'll refer you to the emergency team come back or go to emergency straight away if the symptoms get worse"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.78,
      "end_seconds": 296.42,
      "duration_seconds": 1.64,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.39,
      "end_seconds": 304.22,
      "duration_seconds": 5.83,
      "text": "Let's review you straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.98,
      "end_seconds": 307.35,
      "duration_seconds": 2.37,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.05,
      "end_seconds": 309.68,
      "duration_seconds": 1.63,
      "text": "have a good day"
    }
  ]
}