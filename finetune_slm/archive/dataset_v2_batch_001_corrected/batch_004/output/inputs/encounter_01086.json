{
  "schema_version": "1.0",
  "encounter_id": "01086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.56,
      "duration_seconds": 3.3,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.08,
      "end_seconds": 9.02,
      "duration_seconds": 3.94,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.93,
      "end_seconds": 15.09,
      "duration_seconds": 5.16,
      "text": "morning, doctor. I'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.56,
      "end_seconds": 21.13,
      "duration_seconds": 4.57,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.22,
      "end_seconds": 28.3,
      "duration_seconds": 5.08,
      "text": "I wanted to get a racing heart looked at"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.28,
      "end_seconds": 31.33,
      "duration_seconds": 2.05,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.35,
      "end_seconds": 36.71,
      "duration_seconds": 4.36,
      "text": "I, I'd say about a month, um, maybe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.97,
      "end_seconds": 41.63,
      "duration_seconds": 3.66,
      "text": "it was closer to about two months, doctor"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.11,
      "end_seconds": 51.33,
      "duration_seconds": 5.22,
      "text": "Okay, so roughly one to to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 55.49,
      "duration_seconds": 3.17,
      "text": "Yes, um, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.0,
      "end_seconds": 63.03,
      "duration_seconds": 2.03,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 75.9,
      "duration_seconds": 10.93,
      "text": "honestly, every other day i've also had shaky hands, for two months i've also been losing weight, since yesterday"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.96,
      "end_seconds": 79.16,
      "duration_seconds": 2.2,
      "text": "Any bulging eyes as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.84,
      "end_seconds": 80.95,
      "duration_seconds": 1.11,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.28,
      "end_seconds": 86.82,
      "duration_seconds": 4.54,
      "text": "Have you had any diarrhoea, neck pain or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.51,
      "end_seconds": 93.49,
      "duration_seconds": 4.98,
      "text": "no diarrhoea, neck pain or chest pain, none of it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.8,
      "end_seconds": 97.32,
      "duration_seconds": 2.52,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.77,
      "end_seconds": 102.7,
      "duration_seconds": 3.93,
      "text": "Uh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.35,
      "end_seconds": 104.97,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.87,
      "end_seconds": 109.1,
      "duration_seconds": 2.23,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.57,
      "end_seconds": 129.64,
      "duration_seconds": 5.07,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.85,
      "end_seconds": 140.24,
      "duration_seconds": 9.39,
      "text": "I walk the dog every morning. I live with my elderly mother. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.77,
      "end_seconds": 157.45,
      "duration_seconds": 5.68,
      "text": "Let's run through your medicines. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 164.31,
      "duration_seconds": 5.34,
      "text": "Glycomet. I take it 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.37,
      "end_seconds": 170.99,
      "duration_seconds": 4.62,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.24,
      "end_seconds": 193.23,
      "duration_seconds": 20.99,
      "text": "No, it's at home. So, uh, I take alendronate, 70 milligrams, once a week. Hmm, I take clopidogrel, 75 milligrams, once a day for the stent. I had sitagliptin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.82,
      "end_seconds": 209.16,
      "duration_seconds": 2.34,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.77,
      "end_seconds": 211.26,
      "duration_seconds": 1.49,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.73,
      "end_seconds": 214.09,
      "duration_seconds": 1.36,
      "text": "and besides that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.89,
      "end_seconds": 223.77,
      "duration_seconds": 7.88,
      "text": "Thin bones, for nearly five years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.86,
      "end_seconds": 225.83,
      "duration_seconds": 0.97,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.87,
      "end_seconds": 229.64,
      "duration_seconds": 2.77,
      "text": "I, I have heart disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.97,
      "end_seconds": 242.22,
      "duration_seconds": 11.25,
      "text": "ah. So, yes, diabetes and thin bones are known to us, good to have that clear. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.31,
      "end_seconds": 251.21,
      "duration_seconds": 5.9,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.32,
      "end_seconds": 254.78,
      "duration_seconds": 2.46,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.6,
      "end_seconds": 264.07,
      "duration_seconds": 8.47,
      "text": "I'm allergic to amoxicillin, I get hives uh, I'm allergic to milk, I get stomach cramps"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.93,
      "end_seconds": 268.18,
      "duration_seconds": 3.25,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.91,
      "end_seconds": 278.52,
      "duration_seconds": 2.61,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.5,
      "end_seconds": 300.5,
      "duration_seconds": 8.0,
      "text": "Okay: respiratory rate 17, pulse 123, SpO2 96 percent on room air, blood pressure 124 over 76."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.58,
      "end_seconds": 303.13,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.88,
      "end_seconds": 306.4,
      "duration_seconds": 2.52,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.63,
      "end_seconds": 311.37,
      "duration_seconds": 3.74,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.32,
      "end_seconds": 315.38,
      "duration_seconds": 2.06,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.29,
      "end_seconds": 337.87,
      "duration_seconds": 5.58,
      "text": "you have a fine tremor and your pulse is fast and regular"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.58,
      "end_seconds": 369.93,
      "duration_seconds": 26.35,
      "text": "You can sit up now. Okay, thinking it through, the most likely explanation is an overactive thyroid. A heart rhythm problem is also on my list. I'd like to arrange an ECG for palpitations. I'll request thyroid blood tests, it'll help with weight loss and palpitations. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.76,
      "end_seconds": 381.48,
      "duration_seconds": 9.72,
      "text": "I'd like you to take propranolol, 20 milligrams, twice a day, until review. That should help with racing heart and tremor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.87,
      "end_seconds": 386.07,
      "duration_seconds": 3.2,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.94,
      "end_seconds": 409.96,
      "duration_seconds": 23.02,
      "text": "Avoid caffeine while the heart is racing. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait. See me again after the thyroid results."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.89,
      "end_seconds": 412.77,
      "duration_seconds": 1.88,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.48,
      "end_seconds": 417.06,
      "duration_seconds": 2.58,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.11,
      "end_seconds": 420.17,
      "duration_seconds": 2.06,
      "text": "Alright, thanks, take care."
    }
  ]
}