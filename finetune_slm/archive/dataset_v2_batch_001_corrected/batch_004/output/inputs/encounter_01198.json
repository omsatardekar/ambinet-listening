{
  "schema_version": "1.0",
  "encounter_id": "01198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 5.64,
      "duration_seconds": 4.41,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.14,
      "end_seconds": 11.82,
      "duration_seconds": 4.68,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.47,
      "end_seconds": 18.8,
      "duration_seconds": 5.33,
      "text": "Well, I've been having a red itchy lump on my arm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.5,
      "end_seconds": 23.53,
      "duration_seconds": 3.03,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 28.84,
      "duration_seconds": 3.41,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.14,
      "end_seconds": 48.3,
      "duration_seconds": 4.16,
      "text": "Have you noticed fever, dizziness, lip swelling or breathing trouble?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.89,
      "end_seconds": 62.63,
      "duration_seconds": 12.74,
      "text": "No, no fever, no dizziness, no lip swelling. I did have mild swelling at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.31,
      "end_seconds": 66.87,
      "duration_seconds": 3.56,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.89,
      "end_seconds": 73.77,
      "duration_seconds": 4.88,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.99,
      "end_seconds": 78.24,
      "duration_seconds": 3.25,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.28,
      "end_seconds": 84.79,
      "duration_seconds": 5.51,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.29,
      "end_seconds": 88.98,
      "duration_seconds": 3.69,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.78,
      "end_seconds": 103.28,
      "duration_seconds": 12.5,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.46,
      "end_seconds": 108.37,
      "duration_seconds": 3.91,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.59,
      "end_seconds": 113.36,
      "duration_seconds": 3.77,
      "text": "Depression, for five years. I've got anxiety."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.23,
      "end_seconds": 116.59,
      "duration_seconds": 1.36,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.27,
      "end_seconds": 135.32,
      "duration_seconds": 17.05,
      "text": "An irregular heartbeat, for five years. I have acid reflux, for about ten years. My family kept telling me to get it checked. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.0,
      "end_seconds": 148.02,
      "duration_seconds": 11.02,
      "text": "I see, go ahead. Okay, I can see depression and acid reflux in your file as well. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.6,
      "end_seconds": 152.23,
      "duration_seconds": 3.63,
      "text": "I'm on fluoxetine, 20 milligrams, every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.97,
      "end_seconds": 164.07,
      "duration_seconds": 10.1,
      "text": "Sorry, what was I saying, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.99,
      "end_seconds": 168.95,
      "duration_seconds": 2.96,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.37,
      "end_seconds": 187.39,
      "duration_seconds": 17.02,
      "text": "For the anxiety, I believe. My son sets them out for me, I just take what I'm given. Warfarin. I take it 3 milligrams, maybe, in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.05,
      "end_seconds": 192.78,
      "duration_seconds": 4.73,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.37,
      "end_seconds": 203.26,
      "duration_seconds": 9.89,
      "text": "No, it's at home. I'm on lansoprazole, 30 milligrams, before breakfast. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.34,
      "end_seconds": 207.28,
      "duration_seconds": 2.94,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.74,
      "end_seconds": 213.79,
      "duration_seconds": 5.05,
      "text": "My brother has epilepsy. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.78,
      "end_seconds": 220.85,
      "duration_seconds": 5.07,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.22,
      "end_seconds": 235.4,
      "duration_seconds": 13.18,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. I grab fast food at lunch most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 236.4,
      "end_seconds": 246.28,
      "duration_seconds": 9.88,
      "text": "Here are the numbers, doctor. Pressure 124 over 77, heart rate 78, weight 60 kilos. Height 164 centimetres, BMI works out to 22.3."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.78,
      "end_seconds": 248.48,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.47,
      "end_seconds": 254.83,
      "duration_seconds": 4.36,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.2,
      "end_seconds": 258.5,
      "duration_seconds": 2.3,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.96,
      "end_seconds": 279.41,
      "duration_seconds": 9.45,
      "text": "There is a small red lump with a central punctum and a little swelling around it, and no spreading redness."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.1,
      "end_seconds": 293.84,
      "duration_seconds": 11.74,
      "text": "That's the examination finished. Putting it all together, I think we're dealing with a local insect bite reaction at this stage. Another possibility is early cellulitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.63,
      "end_seconds": 298.7,
      "duration_seconds": 3.07,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.5,
      "end_seconds": 318.5,
      "duration_seconds": 19.0,
      "text": "Nothing I've seen today points to an emergency. It looks like a local insect bite reaction. Let me repeat that back to make sure. You've had a red itchy lump on your arm for six months, and no dizziness or lip swelling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.06,
      "end_seconds": 324.8,
      "duration_seconds": 1.74,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.12,
      "end_seconds": 347.61,
      "duration_seconds": 12.49,
      "text": "I'll start you on hydrocortisone cream, 1%, twice a day, five days. That's for bite reaction. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 350.52,
      "end_seconds": 354.29,
      "duration_seconds": 3.77,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.13,
      "end_seconds": 377.05,
      "duration_seconds": 20.92,
      "text": "Cool it with ice and avoid scratching. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the redness spreads or you feel unwell. Come back if the redness spreads."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 378.93,
      "end_seconds": 383.69,
      "duration_seconds": 4.76,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.39,
      "end_seconds": 389.31,
      "duration_seconds": 3.92,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 390.63,
      "end_seconds": 394.37,
      "duration_seconds": 3.74,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.44,
      "end_seconds": 397.2,
      "duration_seconds": 1.76,
      "text": "Have a good day."
    }
  ]
}