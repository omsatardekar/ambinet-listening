{
  "schema_version": "1.0",
  "encounter_id": "01283",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 4.88,
      "duration_seconds": 3.51,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.77,
      "end_seconds": 11.56,
      "duration_seconds": 4.79,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.25,
      "end_seconds": 16.9,
      "duration_seconds": 3.65,
      "text": "It's extra hair on my chin, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.84,
      "end_seconds": 20.91,
      "duration_seconds": 3.07,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.02,
      "end_seconds": 24.29,
      "duration_seconds": 2.27,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.46,
      "end_seconds": 29.69,
      "duration_seconds": 2.23,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.66,
      "end_seconds": 47.85,
      "duration_seconds": 16.19,
      "text": "When it starts I tend to get irregular periods as well. Uh, the irregular periods? That's been since Monday. About irregular periods, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.22,
      "end_seconds": 51.89,
      "duration_seconds": 2.67,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.81,
      "end_seconds": 65.84,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.55,
      "end_seconds": 84.18,
      "duration_seconds": 4.63,
      "text": "Okay: pressure 110 over 72, saturation 99 percent, pulse 84."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.34,
      "end_seconds": 86.81,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.9,
      "end_seconds": 90.45,
      "duration_seconds": 2.55,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.76,
      "end_seconds": 95.04,
      "duration_seconds": 3.28,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.55,
      "end_seconds": 98.23,
      "duration_seconds": 1.68,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.78,
      "end_seconds": 102.32,
      "duration_seconds": 2.54,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.68,
      "end_seconds": 127.34,
      "duration_seconds": 8.66,
      "text": "Your weight is up a little, and there is acne on the jaw and some coarse hairs on the chin."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.03,
      "end_seconds": 135.11,
      "duration_seconds": 4.08,
      "text": "You can sit up now. And headaches, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.22,
      "end_seconds": 137.68,
      "duration_seconds": 1.46,
      "text": "No headaches, thankfully."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.68,
      "end_seconds": 142.35,
      "duration_seconds": 3.67,
      "text": "Have you had any palpitations or milky nipple discharge?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.44,
      "end_seconds": 146.99,
      "duration_seconds": 2.55,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 152.83,
      "duration_seconds": 4.11,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.28,
      "end_seconds": 157.16,
      "duration_seconds": 2.88,
      "text": "So, no, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.02,
      "end_seconds": 166.17,
      "duration_seconds": 3.15,
      "text": "Alright, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.99,
      "end_seconds": 170.25,
      "duration_seconds": 2.26,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.33,
      "end_seconds": 175.69,
      "duration_seconds": 3.36,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.83,
      "end_seconds": 178.57,
      "duration_seconds": 1.74,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.12,
      "end_seconds": 195.67,
      "duration_seconds": 3.55,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.24,
      "end_seconds": 200.43,
      "duration_seconds": 3.19,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.19,
      "end_seconds": 221.21,
      "duration_seconds": 3.02,
      "text": "So, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.26,
      "end_seconds": 225.35,
      "duration_seconds": 3.09,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.9,
      "end_seconds": 231.72,
      "duration_seconds": 1.82,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.96,
      "end_seconds": 236.59,
      "duration_seconds": 3.63,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.01,
      "end_seconds": 239.26,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.27,
      "end_seconds": 245.11,
      "duration_seconds": 3.84,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.25,
      "end_seconds": 249.08,
      "duration_seconds": 2.83,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.73,
      "end_seconds": 253.02,
      "duration_seconds": 3.29,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.3,
      "end_seconds": 259.82,
      "duration_seconds": 5.52,
      "text": "Putting it all together, the most likely explanation is polycystic ovary syndrome."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.35,
      "end_seconds": 261.84,
      "duration_seconds": 1.49,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.01,
      "end_seconds": 280.34,
      "duration_seconds": 17.33,
      "text": "It's reasonable to be concerned, but right now polycystic ovary syndrome is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had extra hair on your chin for two months, and no milky nipple discharge or headaches."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.88,
      "end_seconds": 282.38,
      "duration_seconds": 1.5,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.84,
      "end_seconds": 305.69,
      "duration_seconds": 11.85,
      "text": "We should do a pelvic ultrasound for irregular periods. I'd like to arrange a thyroid test for irregular periods. I'd like to arrange hormone blood tests for irregular periods."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.6,
      "end_seconds": 308.62,
      "duration_seconds": 1.02,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.87,
      "end_seconds": 324.92,
      "duration_seconds": 15.05,
      "text": "I'll start you on metformin, 500 milligrams, twice a day with food, long term. It's for polycystic ovaries. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.57,
      "end_seconds": 327.54,
      "duration_seconds": 1.97,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.49,
      "end_seconds": 347.67,
      "duration_seconds": 19.18,
      "text": "Regular exercise and a lower-sugar diet help the periods settle. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's plan a check after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.54,
      "end_seconds": 352.45,
      "duration_seconds": 2.91,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}