{
  "schema_version": "1.0",
  "encounter_id": "01040",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 7.55,
      "duration_seconds": 6.96,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.43,
      "end_seconds": 12.76,
      "duration_seconds": 4.33,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.71,
      "end_seconds": 29.8,
      "duration_seconds": 15.09,
      "text": "Doctor, um, it's tearing chest pain going to my back. It's getting on my nerves now. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.68,
      "end_seconds": 35.38,
      "duration_seconds": 4.7,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.59,
      "end_seconds": 44.21,
      "duration_seconds": 7.62,
      "text": "I take hydrocortisone cream, when needed. Actually, though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.96,
      "end_seconds": 47.06,
      "duration_seconds": 2.1,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.73,
      "end_seconds": 51.25,
      "duration_seconds": 3.52,
      "text": "Since last night, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.83,
      "end_seconds": 54.78,
      "duration_seconds": 2.95,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.13,
      "end_seconds": 63.02,
      "duration_seconds": 6.89,
      "text": "It's moderate, honestly. And there's sudden onset as well, about a week now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.91,
      "end_seconds": 72.41,
      "duration_seconds": 8.5,
      "text": "Have you had tearing chest pain going to your back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.71,
      "end_seconds": 80.29,
      "duration_seconds": 6.58,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.91,
      "end_seconds": 85.66,
      "duration_seconds": 3.75,
      "text": "Any leg swelling, fever or cough at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 90.27,
      "duration_seconds": 3.75,
      "text": "No, no leg swelling, fever or cough."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.62,
      "end_seconds": 95.1,
      "duration_seconds": 3.48,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.01,
      "end_seconds": 98.83,
      "duration_seconds": 1.82,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.19,
      "end_seconds": 102.68,
      "duration_seconds": 2.49,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.91,
      "end_seconds": 105.62,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.16,
      "end_seconds": 111.88,
      "duration_seconds": 4.72,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.78,
      "end_seconds": 116.47,
      "duration_seconds": 2.69,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.77,
      "end_seconds": 128.95,
      "duration_seconds": 2.18,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 135.79,
      "duration_seconds": 6.02,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.49,
      "end_seconds": 140.11,
      "duration_seconds": 2.62,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.75,
      "end_seconds": 145.64,
      "duration_seconds": 3.89,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.21,
      "end_seconds": 150.16,
      "duration_seconds": 2.95,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.22,
      "end_seconds": 155.72,
      "duration_seconds": 4.5,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.41,
      "end_seconds": 162.64,
      "duration_seconds": 5.23,
      "text": "Right, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.2,
      "end_seconds": 166.73,
      "duration_seconds": 2.53,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.17,
      "end_seconds": 170.16,
      "duration_seconds": 1.99,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.7,
      "end_seconds": 179.01,
      "duration_seconds": 8.31,
      "text": "High blood pressure, for five years. It's the not knowing that gets to me. I've got eczema."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.72,
      "end_seconds": 188.56,
      "duration_seconds": 8.84,
      "text": "I follow. So, yes, high blood pressure and eczema are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.47,
      "end_seconds": 204.32,
      "duration_seconds": 2.85,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.09,
      "end_seconds": 214.58,
      "duration_seconds": 2.49,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.13,
      "end_seconds": 234.0,
      "duration_seconds": 5.87,
      "text": "Okay: temperature is 36.5 degrees, pulse 80, pressure 155 over 88."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.2,
      "end_seconds": 236.76,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.63,
      "end_seconds": 242.11,
      "duration_seconds": 4.48,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.72,
      "end_seconds": 261.59,
      "duration_seconds": 3.87,
      "text": "I want an ECG done, that's for chest pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 263.31,
      "end_seconds": 267.75,
      "duration_seconds": 4.44,
      "text": "We have a slot Monday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.93,
      "end_seconds": 281.27,
      "duration_seconds": 12.34,
      "text": "Do not move, I am calling an ambulance and you are going to a specialist centre. I think the cardiac surgical team should see you too."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.42,
      "end_seconds": 283.9,
      "duration_seconds": 1.48,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.54,
      "end_seconds": 300.24,
      "duration_seconds": 14.7,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'd like to see you again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.79,
      "end_seconds": 306.21,
      "duration_seconds": 5.42,
      "text": "Sorry, what was I saying, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.75,
      "end_seconds": 309.03,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}