{
  "schema_version": "1.0",
  "encounter_id": "01355",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 6.0,
      "duration_seconds": 4.99,
      "text": "Hi, uh, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 10.6,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.81,
      "end_seconds": 16.69,
      "duration_seconds": 4.88,
      "text": "I wanted to get a sore ankle looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.84,
      "end_seconds": 21.22,
      "duration_seconds": 3.38,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.3,
      "end_seconds": 26.74,
      "duration_seconds": 3.44,
      "text": "Ah, it's been like this since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.97,
      "end_seconds": 32.86,
      "duration_seconds": 5.89,
      "text": "Sure. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.69,
      "end_seconds": 40.41,
      "duration_seconds": 6.72,
      "text": "Walking definitely sets it off. It's a few times a day. Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.17,
      "end_seconds": 45.59,
      "duration_seconds": 3.42,
      "text": "Has there been a little swelling too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.09,
      "end_seconds": 48.63,
      "duration_seconds": 1.54,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.73,
      "end_seconds": 60.07,
      "duration_seconds": 3.34,
      "text": "Have you had any pain in the foot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.53,
      "end_seconds": 64.5,
      "duration_seconds": 2.97,
      "text": "No pain in the foot, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.98,
      "end_seconds": 69.49,
      "duration_seconds": 3.51,
      "text": "Have you noticed crack or pop or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.54,
      "end_seconds": 74.16,
      "duration_seconds": 2.62,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.14,
      "end_seconds": 78.74,
      "duration_seconds": 2.6,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.41,
      "end_seconds": 81.11,
      "duration_seconds": 1.7,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.18,
      "end_seconds": 84.86,
      "duration_seconds": 2.68,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.92,
      "end_seconds": 90.99,
      "duration_seconds": 4.07,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.41,
      "end_seconds": 107.79,
      "duration_seconds": 3.38,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.95,
      "end_seconds": 111.98,
      "duration_seconds": 3.03,
      "text": "Allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.69,
      "end_seconds": 118.74,
      "duration_seconds": 2.05,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.83,
      "end_seconds": 121.47,
      "duration_seconds": 1.64,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.01,
      "end_seconds": 122.94,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.51,
      "end_seconds": 128.36,
      "duration_seconds": 4.85,
      "text": "Bisoprolol, 2.5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.37,
      "end_seconds": 133.76,
      "duration_seconds": 4.39,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.35,
      "end_seconds": 145.2,
      "duration_seconds": 9.85,
      "text": "Not with me. I'll bring it next time. Erm, I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.87,
      "end_seconds": 159.2,
      "duration_seconds": 4.33,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.74,
      "end_seconds": 162.18,
      "duration_seconds": 1.44,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 167.16,
      "duration_seconds": 3.04,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.98,
      "end_seconds": 175.78,
      "duration_seconds": 3.8,
      "text": "Right, you know, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.54,
      "end_seconds": 180.52,
      "duration_seconds": 2.98,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.08,
      "end_seconds": 190.76,
      "duration_seconds": 8.68,
      "text": "I'm vegetarian and have been for years. I live with my elderly mother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.06,
      "end_seconds": 195.63,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.9,
      "end_seconds": 220.36,
      "duration_seconds": 23.46,
      "text": "I've had gout for two years now. I have an irregular heartbeat, for nearly five years. I've been reading about it online and it worried me. I didn't want to make a fuss, you know. Epilepsy, for five years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.6,
      "end_seconds": 233.15,
      "duration_seconds": 6.55,
      "text": "Alright, gout, that matches what I have here. Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.45,
      "end_seconds": 248.44,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.97,
      "end_seconds": 290.45,
      "duration_seconds": 30.48,
      "text": "Okay: heart rate 81, oxygen saturation is 99 percent, blood pressure 116 over 82, respiratory rate 16, temperature 36.9. Right, here's what I'm thinking. This is probably a mild ankle sprain. We shouldn't forget a minor fracture. Rest, ice, a compression bandage and keep it raised for two days. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.31,
      "end_seconds": 310.82,
      "duration_seconds": 18.51,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if you cannot put weight on it. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.09,
      "end_seconds": 317.32,
      "duration_seconds": 3.23,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}