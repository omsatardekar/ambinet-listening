{
  "schema_version": "1.0",
  "encounter_id": "01336",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.08,
      "end_seconds": 3.16,
      "duration_seconds": 2.08,
      "text": "Right, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.23,
      "end_seconds": 6.39,
      "duration_seconds": 1.16,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.06,
      "end_seconds": 14.62,
      "duration_seconds": 7.56,
      "text": "Good afternoon, you know, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.95,
      "end_seconds": 24.43,
      "duration_seconds": 8.48,
      "text": "That's fine, sit down. We'll go through it together. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.05,
      "end_seconds": 30.36,
      "duration_seconds": 4.31,
      "text": "She's been having loose stools after meals, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.89,
      "end_seconds": 35.95,
      "duration_seconds": 4.06,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.88,
      "end_seconds": 46.36,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.39,
      "end_seconds": 74.41,
      "duration_seconds": 9.02,
      "text": "Okay: temp 36.4 degrees, respiratory rate 14, BP is 113 over 72. And heart rate 74. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.58,
      "end_seconds": 77.84,
      "duration_seconds": 2.26,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.71,
      "end_seconds": 88.08,
      "duration_seconds": 9.37,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.22,
      "end_seconds": 97.96,
      "duration_seconds": 8.74,
      "text": "Yes, coffee. That makes it worse. Mild, really. And cramping lower tummy pain as well, since last weekend."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.06,
      "end_seconds": 102.96,
      "duration_seconds": 1.9,
      "text": "Any urgency as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.36,
      "end_seconds": 109.16,
      "duration_seconds": 4.8,
      "text": "Yeah. Four weeks, I'd say. About urgency, I'd say mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 116.0,
      "duration_seconds": 5.22,
      "text": "Any weight loss, fever or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.85,
      "end_seconds": 120.47,
      "duration_seconds": 2.62,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.19,
      "end_seconds": 124.59,
      "duration_seconds": 3.4,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.81,
      "end_seconds": 127.68,
      "duration_seconds": 1.87,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 131.09,
      "duration_seconds": 2.83,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.13,
      "end_seconds": 137.47,
      "duration_seconds": 2.34,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.38,
      "end_seconds": 141.0,
      "duration_seconds": 2.62,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 142.13,
      "end_seconds": 149.24,
      "duration_seconds": 7.11,
      "text": "It's glimepiride, 2 milligrams, before breakfast, doctor. It's loperamide, 2 milligrams, when needed, doctor."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.55,
      "end_seconds": 159.85,
      "duration_seconds": 3.3,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.38,
      "end_seconds": 163.2,
      "duration_seconds": 2.82,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.39,
      "end_seconds": 172.41,
      "duration_seconds": 2.02,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.29,
      "end_seconds": 175.22,
      "duration_seconds": 1.93,
      "text": "I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.73,
      "end_seconds": 176.43,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.23,
      "end_seconds": 181.06,
      "duration_seconds": 3.83,
      "text": "Actually, I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.06,
      "end_seconds": 189.05,
      "duration_seconds": 6.99,
      "text": "Yes, diabetes is known to us, good to have that clear. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.99,
      "end_seconds": 194.63,
      "duration_seconds": 3.64,
      "text": "Yes, tramadol. I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.37,
      "end_seconds": 199.18,
      "duration_seconds": 2.81,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.26,
      "end_seconds": 218.51,
      "duration_seconds": 18.25,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. No, I share a house with my brother. I'm vegetarian and have been for years. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.52,
      "end_seconds": 223.33,
      "duration_seconds": 3.81,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.43,
      "end_seconds": 226.9,
      "duration_seconds": 1.47,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.93,
      "end_seconds": 229.26,
      "duration_seconds": 1.33,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.09,
      "end_seconds": 243.36,
      "duration_seconds": 5.27,
      "text": "Your tummy is soft and only mildly tender on the left."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.19,
      "end_seconds": 251.52,
      "duration_seconds": 3.33,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.93,
      "end_seconds": 275.95,
      "duration_seconds": 13.02,
      "text": "Putting it all together, it points towards irritable bowel syndrome with diarrhoea. The reason I say that is that your story and my examination fit together. We shouldn't forget an inflammatory bowel condition."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.99,
      "end_seconds": 281.92,
      "duration_seconds": 3.93,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.71,
      "end_seconds": 304.88,
      "duration_seconds": 21.17,
      "text": "I can't promise yet, but most people with irritable bowel syndrome with diarrhoea do well once it's treated properly. Let me just check I've got this right. You've had loose stools after meals for about two weeks, mild, and no weight loss or blood in the stool."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.7,
      "end_seconds": 308.84,
      "duration_seconds": 2.14,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.09,
      "end_seconds": 323.72,
      "duration_seconds": 13.63,
      "text": "Let's get a coeliac blood test, for diarrhoea. Keep a food diary and cut back on coffee. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.33,
      "end_seconds": 327.27,
      "duration_seconds": 2.94,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.18,
      "end_seconds": 332.68,
      "duration_seconds": 3.5,
      "text": "I'd like to see you again after the results."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.25,
      "end_seconds": 335.78,
      "duration_seconds": 1.53,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.94,
      "end_seconds": 341.52,
      "duration_seconds": 4.58,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.44,
      "end_seconds": 344.82,
      "duration_seconds": 2.38,
      "text": "Thank you, that's helpful."
    }
  ]
}