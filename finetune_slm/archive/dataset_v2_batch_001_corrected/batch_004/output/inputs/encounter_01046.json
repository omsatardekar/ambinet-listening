{
  "schema_version": "1.0",
  "encounter_id": "01046",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.22,
      "end_seconds": 3.54,
      "duration_seconds": 2.32,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.09,
      "end_seconds": 5.15,
      "duration_seconds": 1.06,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 10.29,
      "duration_seconds": 3.56,
      "text": "Okay, what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.83,
      "end_seconds": 21.7,
      "duration_seconds": 10.87,
      "text": "It's I can't get my breath. I thought I'd wait, but it hasn't gone. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.25,
      "end_seconds": 26.42,
      "duration_seconds": 3.17,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.12,
      "end_seconds": 30.0,
      "duration_seconds": 2.88,
      "text": "I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.91,
      "end_seconds": 48.04,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.14,
      "end_seconds": 53.5,
      "duration_seconds": 2.36,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.9,
      "end_seconds": 57.52,
      "duration_seconds": 2.62,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.49,
      "end_seconds": 65.81,
      "duration_seconds": 4.32,
      "text": "Erm, I get some relief from sitting up."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.59,
      "end_seconds": 71.47,
      "duration_seconds": 3.88,
      "text": "Have you noticed blue tinge, chest pain or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.56,
      "end_seconds": 75.99,
      "duration_seconds": 3.43,
      "text": "Uh, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.9,
      "end_seconds": 81.66,
      "duration_seconds": 4.76,
      "text": "Alright, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.12,
      "end_seconds": 85.91,
      "duration_seconds": 2.79,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.87,
      "end_seconds": 90.09,
      "duration_seconds": 3.22,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.99,
      "end_seconds": 94.81,
      "duration_seconds": 2.82,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.63,
      "end_seconds": 99.82,
      "duration_seconds": 3.19,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.73,
      "end_seconds": 114.36,
      "duration_seconds": 13.63,
      "text": "Asthma, for two years. My sister suggested writing things down, but I forgot. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.0,
      "end_seconds": 127.01,
      "duration_seconds": 10.01,
      "text": "Yes, carry on. Right, so asthma is already on your record. We'll keep that in mind today. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.89,
      "end_seconds": 142.19,
      "duration_seconds": 13.3,
      "text": "I used to drink heavily but I stopped four years ago. I'm a bus driver, so I sit for long hours. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 147.65,
      "duration_seconds": 4.06,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.59,
      "end_seconds": 153.25,
      "duration_seconds": 4.66,
      "text": "Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.73,
      "end_seconds": 168.58,
      "duration_seconds": 2.85,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.48,
      "end_seconds": 171.63,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.3,
      "end_seconds": 182.19,
      "duration_seconds": 2.89,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.45,
      "end_seconds": 195.95,
      "duration_seconds": 2.5,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.16,
      "end_seconds": 215.12,
      "duration_seconds": 8.96,
      "text": "Okay: pressure 126 over 76, heart rate 92. And saturation 91 percent, temperature is 37.3 degrees, respiratory rate 22."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.58,
      "end_seconds": 220.62,
      "duration_seconds": 4.04,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.09,
      "end_seconds": 223.51,
      "duration_seconds": 1.42,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.92,
      "end_seconds": 242.45,
      "duration_seconds": 5.53,
      "text": "You are using your neck muscles to breathe, and your oxygen is low."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.47,
      "end_seconds": 247.07,
      "duration_seconds": 1.6,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.28,
      "end_seconds": 275.59,
      "duration_seconds": 10.31,
      "text": "So where does that leave us? I don't have a clear answer today: a severe asthma attack is possible, and so is a chest infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.03,
      "end_seconds": 287.34,
      "duration_seconds": 5.31,
      "text": "Sorry, what was I saying, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.85,
      "end_seconds": 309.83,
      "duration_seconds": 20.98,
      "text": "I understand the worry. At the moment I'd say it's a severe asthma attack, and we'll know more once the a peak flow is back. I'd like to arrange a peak flow for asthma attack. We should do a chest X-ray for severe breathlessness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.29,
      "end_seconds": 312.88,
      "duration_seconds": 1.59,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.71,
      "end_seconds": 346.28,
      "duration_seconds": 31.57,
      "text": "Let's use prednisolone, 40 milligrams, once now, single dose. You take it by mouth. It's for asthma attack. Sit upright and take slow breaths while the nebuliser is set up. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Come back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.33,
      "end_seconds": 350.1,
      "duration_seconds": 2.77,
      "text": "Mm, thank you, that's helpful."
    }
  ]
}