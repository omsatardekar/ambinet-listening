{
  "schema_version": "1.0",
  "encounter_id": "01398",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.78,
      "duration_seconds": 4.57,
      "text": "Sorry, um, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 11.67,
      "duration_seconds": 4.45,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.54,
      "end_seconds": 17.82,
      "duration_seconds": 4.28,
      "text": "good morning, doctor. I came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.49,
      "end_seconds": 22.54,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.14,
      "end_seconds": 36.56,
      "duration_seconds": 8.42,
      "text": "it's pain much worse than it looks, doctor. He didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.4,
      "end_seconds": 39.75,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.75,
      "end_seconds": 44.53,
      "duration_seconds": 2.78,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.27,
      "end_seconds": 54.7,
      "duration_seconds": 9.43,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.58,
      "end_seconds": 66.51,
      "duration_seconds": 6.93,
      "text": "I'd say on and off. A A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.35,
      "end_seconds": 71.03,
      "duration_seconds": 2.68,
      "text": "Has there been dark blisters too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.4,
      "end_seconds": 77.29,
      "duration_seconds": 4.89,
      "text": "Yeah, that too. I've also had a high fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.12,
      "end_seconds": 81.24,
      "duration_seconds": 2.12,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.78,
      "end_seconds": 88.43,
      "duration_seconds": 5.65,
      "text": "It's something called glic... gliclazide, 80 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.64,
      "end_seconds": 98.18,
      "duration_seconds": 4.54,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.04,
      "end_seconds": 103.44,
      "duration_seconds": 4.4,
      "text": "No, it's at home. Lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.01,
      "end_seconds": 108.88,
      "duration_seconds": 4.87,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.73,
      "end_seconds": 114.43,
      "duration_seconds": 3.7,
      "text": "Kiwi. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.71,
      "end_seconds": 117.98,
      "duration_seconds": 2.27,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.28,
      "end_seconds": 125.4,
      "duration_seconds": 6.12,
      "text": "Diabetes, for about ten years i have acid reflux, for two years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.25,
      "end_seconds": 139.93,
      "duration_seconds": 3.68,
      "text": "Right, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.98,
      "end_seconds": 147.06,
      "duration_seconds": 6.08,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 149.99,
      "duration_seconds": 1.8,
      "text": "okay, are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.99,
      "end_seconds": 156.17,
      "duration_seconds": 3.18,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.87,
      "end_seconds": 164.14,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.17,
      "end_seconds": 171.69,
      "duration_seconds": 5.52,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.05,
      "end_seconds": 180.62,
      "duration_seconds": 4.57,
      "text": "Let me check a few things. Any cut or insect bite?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.44,
      "end_seconds": 186.3,
      "duration_seconds": 3.86,
      "text": "I haven't had cut or insect bite, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.84,
      "end_seconds": 190.08,
      "duration_seconds": 2.24,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.92,
      "end_seconds": 192.61,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.13,
      "end_seconds": 197.69,
      "duration_seconds": 4.56,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.38,
      "end_seconds": 203.9,
      "duration_seconds": 4.52,
      "text": "Sorry, what was I saying, no weakness or anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.13,
      "end_seconds": 217.32,
      "duration_seconds": 3.19,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.65,
      "end_seconds": 229.41,
      "duration_seconds": 2.76,
      "text": "Nearly done with the the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.4,
      "end_seconds": 247.73,
      "duration_seconds": 8.33,
      "text": "Okay: pressure 105 over 73, pulse 89, temperature 39.4, respiratory rate 19, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.58,
      "end_seconds": 253.98,
      "duration_seconds": 3.4,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.54,
      "end_seconds": 257.87,
      "duration_seconds": 2.33,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.71,
      "end_seconds": 274.39,
      "duration_seconds": 7.68,
      "text": "The skin on your leg is dusky with blisters and and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.11,
      "end_seconds": 280.74,
      "duration_seconds": 1.63,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.67,
      "end_seconds": 305.53,
      "duration_seconds": 12.86,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be a severe deep skin infection needing urgent surgery review, or it might be severe cellulitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.63,
      "end_seconds": 308.06,
      "duration_seconds": 1.43,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.03,
      "end_seconds": 330.85,
      "duration_seconds": 20.82,
      "text": "It's reasonable to be concerned, but right now a severe deep skin infection needing urgent surgery review is my leading thought, not anything worse. I'm sending you for urgent blood tests cos of severe skin infection. We should do an urgent surgical review for possible necrotising infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.93,
      "end_seconds": 335.24,
      "duration_seconds": 2.31,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.92,
      "end_seconds": 340.65,
      "duration_seconds": 4.73,
      "text": "I am sending you to hospital now, do not wait."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.22,
      "end_seconds": 348.27,
      "duration_seconds": 7.05,
      "text": "Mm-hmm. I'd like you to see the surgical team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.5,
      "end_seconds": 350.99,
      "duration_seconds": 1.49,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.25,
      "end_seconds": 361.72,
      "duration_seconds": 9.47,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.38,
      "end_seconds": 364.08,
      "duration_seconds": 1.7,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.91,
      "end_seconds": 372.77,
      "duration_seconds": 7.86,
      "text": "See me again straight away. Is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.27,
      "end_seconds": 377.35,
      "duration_seconds": 3.08,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.33,
      "end_seconds": 380.7,
      "duration_seconds": 1.37,
      "text": "Take care now."
    }
  ]
}