{
  "schema_version": "1.0",
  "encounter_id": "01243",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 3.81,
      "duration_seconds": 3.08,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.0,
      "end_seconds": 8.97,
      "duration_seconds": 3.97,
      "text": "Actually, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.86,
      "end_seconds": 17.8,
      "duration_seconds": 6.94,
      "text": "Mm, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.67,
      "end_seconds": 20.71,
      "duration_seconds": 2.04,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.69,
      "end_seconds": 26.65,
      "duration_seconds": 4.96,
      "text": "Only about ten minutes, you know, no trouble."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.35,
      "end_seconds": 31.97,
      "duration_seconds": 3.62,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 32.96,
      "end_seconds": 38.47,
      "duration_seconds": 5.51,
      "text": "Doctor, it's a runny nose. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.11,
      "end_seconds": 45.45,
      "duration_seconds": 3.34,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.94,
      "end_seconds": 49.5,
      "duration_seconds": 2.56,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.28,
      "end_seconds": 59.25,
      "duration_seconds": 8.97,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.25,
      "end_seconds": 92.57,
      "duration_seconds": 31.32,
      "text": "Erm, I'd give it a six, out of ten. It settles a little with tissues. Oh, and a scratchy throat. That's been about the same, about four days. Uh, um, as for mild cough, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.07,
      "end_seconds": 99.01,
      "duration_seconds": 1.94,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.46,
      "end_seconds": 116.42,
      "duration_seconds": 15.96,
      "text": "Um, I get some relief from honey and lemon. Um, you know, I've had sneezing too, for two days. Oh, as for sneezing, it happens on and off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.45,
      "end_seconds": 125.81,
      "duration_seconds": 6.36,
      "text": "Have you had a runny nose before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.93,
      "end_seconds": 141.0,
      "duration_seconds": 11.07,
      "text": "Yes, uh, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.78,
      "end_seconds": 149.01,
      "duration_seconds": 3.23,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.35,
      "end_seconds": 154.14,
      "duration_seconds": 3.79,
      "text": "Mm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.75,
      "end_seconds": 168.2,
      "duration_seconds": 2.45,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.94,
      "end_seconds": 182.16,
      "duration_seconds": 12.22,
      "text": "Hmm, you know, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.28,
      "end_seconds": 186.85,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.45,
      "end_seconds": 200.46,
      "duration_seconds": 12.01,
      "text": "I have arthritis in my knees. Ah, I have gout, for two years. Ah, I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.19,
      "end_seconds": 209.54,
      "duration_seconds": 8.35,
      "text": "Mm-hmm. Alright, gout, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.21,
      "end_seconds": 219.57,
      "duration_seconds": 9.36,
      "text": "It's paracetamol, 650 milligrams, when needed, doctor. It's allopurinol, 100 milligrams, once a day for the gout, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.91,
      "end_seconds": 223.0,
      "duration_seconds": 2.09,
      "text": "So, is that long-standing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 225.05,
      "end_seconds": 230.41,
      "duration_seconds": 5.36,
      "text": "For two months. She takes Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.23,
      "end_seconds": 235.13,
      "duration_seconds": 2.9,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.41,
      "end_seconds": 243.99,
      "duration_seconds": 7.58,
      "text": "Uh, my aunt has rheumatoid arthritis. Yeah, you know, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.69,
      "end_seconds": 255.8,
      "duration_seconds": 3.11,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.29,
      "end_seconds": 263.26,
      "duration_seconds": 3.97,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.67,
      "end_seconds": 267.27,
      "duration_seconds": 2.6,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.15,
      "end_seconds": 273.54,
      "duration_seconds": 4.39,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.45,
      "end_seconds": 276.2,
      "duration_seconds": 1.75,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.23,
      "end_seconds": 282.38,
      "duration_seconds": 4.15,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.2,
      "end_seconds": 299.68,
      "duration_seconds": 5.48,
      "text": "A few quick ones: chest pain, shortness of breath or ear pain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.04,
      "end_seconds": 307.64,
      "duration_seconds": 6.6,
      "text": "No chest pain, shortness of breath or ear pain, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.7,
      "end_seconds": 312.24,
      "duration_seconds": 3.54,
      "text": "Right, have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.73,
      "end_seconds": 317.23,
      "duration_seconds": 3.5,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.14,
      "end_seconds": 323.21,
      "duration_seconds": 4.07,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.48,
      "end_seconds": 326.79,
      "duration_seconds": 2.31,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.7,
      "end_seconds": 333.24,
      "duration_seconds": 4.54,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.95,
      "end_seconds": 348.26,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.14,
      "end_seconds": 378.37,
      "duration_seconds": 9.23,
      "text": "Okay: pulse is 64 beats a minute, BP is 123 over 69, respiratory rate 17, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.89,
      "end_seconds": 384.87,
      "duration_seconds": 3.98,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.87,
      "end_seconds": 387.36,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.54,
      "end_seconds": 389.88,
      "duration_seconds": 1.34,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 399.59,
      "end_seconds": 404.29,
      "duration_seconds": 4.7,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.98,
      "end_seconds": 407.68,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.7,
      "end_seconds": 436.06,
      "duration_seconds": 24.36,
      "text": "Thank you, you can get dressed. Okay, thinking it through, I'm honestly not certain yet. It could be a simple viral cold, or it might be early flu. Rest, plenty of fluids, and paracetamol if you ache. Keep an eye out, and if you develop a high fever or trouble breathing, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 438.05,
      "end_seconds": 439.75,
      "duration_seconds": 1.7,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 441.37,
      "end_seconds": 453.34,
      "duration_seconds": 11.97,
      "text": "I'd like to see you again if it is not better in ten days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 454.08,
      "end_seconds": 458.81,
      "duration_seconds": 4.73,
      "text": "Okay, so good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 459.93,
      "end_seconds": 461.76,
      "duration_seconds": 1.83,
      "text": "So, take care now."
    }
  ]
}