{
  "schema_version": "1.0",
  "encounter_id": "01443",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 6.21,
      "duration_seconds": 5.61,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.91,
      "end_seconds": 8.04,
      "duration_seconds": 1.13,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 10.39,
      "duration_seconds": 1.6,
      "text": "Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.44,
      "end_seconds": 16.42,
      "duration_seconds": 3.98,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.06,
      "end_seconds": 20.55,
      "duration_seconds": 2.49,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.36,
      "end_seconds": 27.94,
      "duration_seconds": 6.58,
      "text": "I've been dealing with skipped beats. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.97,
      "end_seconds": 30.26,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.53,
      "end_seconds": 41.85,
      "duration_seconds": 10.32,
      "text": "I've, I've had it since this morning. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 45.09,
      "duration_seconds": 2.5,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.87,
      "end_seconds": 49.25,
      "duration_seconds": 2.38,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.06,
      "end_seconds": 55.17,
      "duration_seconds": 4.11,
      "text": "So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.11,
      "end_seconds": 58.28,
      "duration_seconds": 1.17,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.95,
      "end_seconds": 62.8,
      "duration_seconds": 2.85,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.85,
      "end_seconds": 69.11,
      "duration_seconds": 4.26,
      "text": "No, you know, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.0,
      "end_seconds": 90.75,
      "duration_seconds": 3.75,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.21,
      "end_seconds": 110.47,
      "duration_seconds": 18.26,
      "text": "I, I take allopurinol, 100 milligrams, once a day for the gout. I told myself I'd wait and see, and here I am. Okay, so I'm on herbal calming tea, in the evening."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.11,
      "end_seconds": 114.52,
      "duration_seconds": 2.41,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.03,
      "end_seconds": 118.42,
      "duration_seconds": 3.39,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.01,
      "end_seconds": 124.18,
      "duration_seconds": 4.17,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.48,
      "end_seconds": 130.33,
      "duration_seconds": 3.85,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.57,
      "end_seconds": 133.6,
      "duration_seconds": 2.03,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.33,
      "end_seconds": 148.28,
      "duration_seconds": 12.95,
      "text": "Gout, for nearly five years. It's a relief to finally sit down and talk about it. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.92,
      "end_seconds": 154.69,
      "duration_seconds": 5.77,
      "text": "Okay, I can see gout in your file as well. Any shortness of breath?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.16,
      "end_seconds": 158.83,
      "duration_seconds": 2.67,
      "text": "Nope, no shortness of breath."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.11,
      "end_seconds": 163.14,
      "duration_seconds": 3.03,
      "text": "Any dizziness, fainting or chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.06,
      "end_seconds": 169.75,
      "duration_seconds": 4.69,
      "text": "I haven't had dizziness, fainting or chest pain, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.65,
      "end_seconds": 175.92,
      "duration_seconds": 4.27,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.07,
      "end_seconds": 180.56,
      "duration_seconds": 3.49,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.43,
      "end_seconds": 185.35,
      "duration_seconds": 2.92,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.05,
      "end_seconds": 188.02,
      "duration_seconds": 1.97,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.69,
      "end_seconds": 194.18,
      "duration_seconds": 4.49,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.08,
      "end_seconds": 208.88,
      "duration_seconds": 2.8,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.31,
      "end_seconds": 231.9,
      "duration_seconds": 10.59,
      "text": "Okay: pressure 113 over 82, pulse is 82 beats a minute, temperature is 36.6 degrees, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.25,
      "end_seconds": 240.77,
      "duration_seconds": 2.52,
      "text": "Ah, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.1,
      "end_seconds": 244.65,
      "duration_seconds": 2.55,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.1,
      "end_seconds": 250.38,
      "duration_seconds": 3.28,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.12,
      "end_seconds": 269.67,
      "duration_seconds": 1.55,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.52,
      "end_seconds": 273.48,
      "duration_seconds": 1.96,
      "text": "Alright, breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.27,
      "end_seconds": 285.9,
      "duration_seconds": 4.63,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.47,
      "end_seconds": 291.2,
      "duration_seconds": 2.73,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.31,
      "end_seconds": 312.64,
      "duration_seconds": 6.33,
      "text": "So where does that leave us? This looks most like harmless extra heartbeats."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.39,
      "end_seconds": 316.19,
      "duration_seconds": 2.8,
      "text": "Okay, so will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.58,
      "end_seconds": 326.05,
      "duration_seconds": 8.47,
      "text": "I can't promise yet, but most people with harmless extra heartbeats do well once it's treated properly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.68,
      "end_seconds": 361.89,
      "duration_seconds": 19.21,
      "text": "We should do an ECG for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens. I'd like to see you again if it carries on after a month. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.48,
      "end_seconds": 367.87,
      "duration_seconds": 5.39,
      "text": "Okay, um, so okay, that makes sense. Thanks for explaining."
    }
  ]
}