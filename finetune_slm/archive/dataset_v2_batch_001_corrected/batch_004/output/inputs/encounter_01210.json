      "role": "DOCTOR",
      "start_seconds": 8.87,
      "end_seconds": 12.69,
      "duration_seconds": 3.82,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.64,
      "end_seconds": 24.61,
      "duration_seconds": 9.97,
      "text": "I'm here because of tearing chest pain going to my back. I just want to get back to normal really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.28,
      "end_seconds": 28.02,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
