    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.15,
      "end_seconds": 33.27,
      "duration_seconds": 4.12,
      "text": "hmm ever since... since this morning really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.49,
      "end_seconds": 39.62,
      "duration_seconds": 5.13,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.22,
      "end_seconds": 45.98,
      "duration_seconds": 4.76,
      "text": "um, I'd call it severe it's every other day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.57,
      "end_seconds": 51.1,
      "duration_seconds": 3.53,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.81,
      "end_seconds": 63.44,
      "duration_seconds": 2.63,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.01,
      "end_seconds": 87.5,
      "duration_seconds": 10.49,
      "text": "Okay: SpO2 97 percent on room air, temperature is 36.7 degrees, BP is 168 over 95, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.56,
      "end_seconds": 90.96,
      "duration_seconds": 1.4,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.28,
      "end_seconds": 96.09,
      "duration_seconds": 3.81,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.19,
      "end_seconds": 101.57,
      "duration_seconds": 4.38,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.19,
      "end_seconds": 118.89,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.87,
      "end_seconds": 122.15,
      "duration_seconds": 2.28,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.43,
      "end_seconds": 134.98,
      "duration_seconds": 5.55,
      "text": "the blood pressure is different in your two arms and you are sweaty"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.49,
      "end_seconds": 145.79,
      "duration_seconds": 5.3,
      "text": "okay, that's enough for me any cough, fever or leg swelling at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.14,
      "end_seconds": 153.94,
      "duration_seconds": 3.8,
      "text": "uh, no, I'd have said so"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.77,
      "end_seconds": 157.67,
      "duration_seconds": 2.9,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.41,
      "end_seconds": 160.87,
      "duration_seconds": 2.46,
      "text": "nothing on the skin no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.41,
      "end_seconds": 163.48,
      "duration_seconds": 2.07,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.42,
      "end_seconds": 167.36,
      "duration_seconds": 1.94,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.99,
      "end_seconds": 186.4,
      "duration_seconds": 2.41,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.66,
      "end_seconds": 191.06,
      "duration_seconds": 3.4,
      "text": "uh, no, I'm not on anything"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.24,
      "end_seconds": 199.52,
      "duration_seconds": 5.28,
      "text": "okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.76,
      "end_seconds": 203.0,
      "duration_seconds": 2.24,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.24,
      "end_seconds": 206.48,
      "duration_seconds": 2.24,
      "text": "Right how active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.76,
      "end_seconds": 211.2,
      "duration_seconds": 3.44,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.88,
      "end_seconds": 214.94,
      "duration_seconds": 3.06,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.69,
      "end_seconds": 221.83,
      "duration_seconds": 5.14,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.8,
      "end_seconds": 226.95,
      "duration_seconds": 3.15,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.13,
      "end_seconds": 231.23,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.53,
      "end_seconds": 255.23,
      "duration_seconds": 6.7,
      "text": "taking everything into account, this is probably a possible tear in the main artery"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.78,
      "end_seconds": 259.49,
      "duration_seconds": 2.71,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.1,
      "end_seconds": 285.68,
      "duration_seconds": 25.58,
      "text": "It's reasonable to be concerned but right now a possible tear in the main artery is my leading thought not anything worse. I'd like to arrange an ECG for chest pain. I want an urgent CT scan of the chest and abdomen done that's for tearing chest pain. Do not move I am calling an ambulance and you are going to a specialist centre."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.55,
      "end_seconds": 293.24,
      "duration_seconds": 6.69,
      "text": "I'd like you to to see the cardiac surgical team as well and I'll write the referral."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.69,
      "end_seconds": 295.39,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.08,
      "end_seconds": 305.12,
      "duration_seconds": 9.04,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.3,
      "end_seconds": 309.66,
      "duration_seconds": 3.36,
      "text": "Um, good, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.88,
      "end_seconds": 313.31,
      "duration_seconds": 2.43,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.62,
      "end_seconds": 317.6,
      "duration_seconds": 2.98,
      "text": "Great thank you for your help."
    }
