{
  "schema_version": "1.0",
  "encounter_id": "01433",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 8.2,
      "duration_seconds": 7.32,
      "text": "I mean, uh, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.73,
      "end_seconds": 15.14,
      "duration_seconds": 5.41,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.53,
      "end_seconds": 24.25,
      "duration_seconds": 7.72,
      "text": "Okay, so doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.26,
      "end_seconds": 29.81,
      "duration_seconds": 4.55,
      "text": "So, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.38,
      "end_seconds": 36.0,
      "duration_seconds": 4.62,
      "text": "Hmm, I've been dealing with an irregular heartbeat."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.66,
      "end_seconds": 43.23,
      "duration_seconds": 6.57,
      "text": "How long has this been bothering you? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.93,
      "end_seconds": 47.57,
      "duration_seconds": 3.64,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.61,
      "end_seconds": 53.34,
      "duration_seconds": 3.73,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.41,
      "end_seconds": 56.64,
      "duration_seconds": 1.23,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.25,
      "end_seconds": 64.13,
      "duration_seconds": 6.88,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 64.23,
      "end_seconds": 71.65,
      "duration_seconds": 7.42,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.57,
      "end_seconds": 76.66,
      "duration_seconds": 4.09,
      "text": "Later, thanks. Please go on. Any occasional bruising as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.49,
      "end_seconds": 88.53,
      "duration_seconds": 11.04,
      "text": "Yes, uh, actually. Being short of breath on slopes was there, you know, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.65,
      "end_seconds": 96.02,
      "duration_seconds": 6.37,
      "text": "Right, have you had an irregular heartbeat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.6,
      "end_seconds": 103.85,
      "duration_seconds": 7.25,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.01,
      "end_seconds": 110.41,
      "duration_seconds": 5.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.16,
      "end_seconds": 122.42,
      "duration_seconds": 11.26,
      "text": "Erm, you know, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.54,
      "end_seconds": 125.88,
      "duration_seconds": 2.34,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.76,
      "end_seconds": 141.25,
      "duration_seconds": 13.49,
      "text": "Right, I have an irregular heartbeat, for about a year. I've been putting this off for weeks. Arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.06,
      "end_seconds": 146.76,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.46,
      "end_seconds": 160.36,
      "duration_seconds": 2.9,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.89,
      "end_seconds": 166.28,
      "duration_seconds": 5.39,
      "text": "Okay, so I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.97,
      "end_seconds": 170.65,
      "duration_seconds": 3.68,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.27,
      "end_seconds": 175.84,
      "duration_seconds": 4.57,
      "text": "I'm, I'm on paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 176.85,
      "end_seconds": 184.02,
      "duration_seconds": 7.17,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 187.99,
      "duration_seconds": 1.94,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.81,
      "end_seconds": 191.56,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.23,
      "end_seconds": 193.59,
      "duration_seconds": 1.36,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.52,
      "end_seconds": 200.81,
      "duration_seconds": 4.29,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.82,
      "end_seconds": 204.01,
      "duration_seconds": 1.19,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.01,
      "end_seconds": 208.72,
      "duration_seconds": 3.71,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.62,
      "end_seconds": 210.86,
      "duration_seconds": 1.24,
      "text": "Any black stools?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.66,
      "end_seconds": 213.97,
      "duration_seconds": 2.31,
      "text": "No, no black stools."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.59,
      "end_seconds": 219.22,
      "duration_seconds": 3.63,
      "text": "Have you noticed fainting, nosebleeds or chest pain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.3,
      "end_seconds": 224.31,
      "duration_seconds": 3.01,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.56,
      "end_seconds": 232.71,
      "duration_seconds": 4.15,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.53,
      "end_seconds": 236.14,
      "duration_seconds": 1.61,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 236.85,
      "end_seconds": 246.0,
      "duration_seconds": 9.15,
      "text": "Here are the numbers, doctor. Heart rate 116, oxygen saturation is 97 percent. Temp 37.1 degrees, pressure 120 over 85, respiratory rate 16."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.27,
      "end_seconds": 258.0,
      "duration_seconds": 10.73,
      "text": "Okay, noted. Going by what you've described, the most likely explanation is atrial fibrillation, rate reasonably controlled. We shouldn't forget anaemia from bleeding."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.55,
      "end_seconds": 278.27,
      "duration_seconds": 4.72,
      "text": "I think kidney function tests makes sense here, for anticoagulant dosing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 278.81,
      "end_seconds": 283.86,
      "duration_seconds": 5.05,
      "text": "We have a slot Monday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.59,
      "end_seconds": 286.75,
      "duration_seconds": 1.16,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 287.29,
      "end_seconds": 290.96,
      "duration_seconds": 3.67,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.27,
      "end_seconds": 314.84,
      "duration_seconds": 20.57,
      "text": "Thanks, that helps. I'm going to order a full blood count, for anticoagulant review. Never skip the blood thinner, and tell any dentist or surgeon you take it. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.8,
      "end_seconds": 317.51,
      "duration_seconds": 1.71,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.26,
      "end_seconds": 326.97,
      "duration_seconds": 8.71,
      "text": "Book a review in three months. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.9,
      "end_seconds": 333.67,
      "duration_seconds": 5.77,
      "text": "So, I come back in three months. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.16,
      "end_seconds": 339.68,
      "duration_seconds": 4.52,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.36,
      "end_seconds": 344.01,
      "duration_seconds": 2.65,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}