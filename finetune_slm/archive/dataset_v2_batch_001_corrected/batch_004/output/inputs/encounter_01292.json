{
  "schema_version": "1.0",
  "encounter_id": "01292",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 6.48,
      "duration_seconds": 5.14,
      "text": "Good morning, grab a seat. Right, what's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.43,
      "end_seconds": 15.43,
      "duration_seconds": 7.0,
      "text": "Honestly, it's crushing chest pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.96,
      "end_seconds": 26.28,
      "duration_seconds": 10.32,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.04,
      "end_seconds": 37.31,
      "duration_seconds": 9.27,
      "text": "Only rest, and it's not much. I'd call it mild. Right, I've also been feeling sick."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.36,
      "end_seconds": 41.92,
      "duration_seconds": 2.56,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.22,
      "end_seconds": 46.33,
      "duration_seconds": 3.11,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.2,
      "end_seconds": 65.72,
      "duration_seconds": 2.52,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.92,
      "end_seconds": 76.35,
      "duration_seconds": 9.43,
      "text": "I have high blood pressure, for five years. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.28,
      "end_seconds": 83.24,
      "duration_seconds": 5.96,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.86,
      "end_seconds": 92.14,
      "duration_seconds": 1.28,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.87,
      "end_seconds": 96.57,
      "duration_seconds": 2.7,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.2,
      "end_seconds": 98.92,
      "duration_seconds": 1.72,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.64,
      "end_seconds": 102.96,
      "duration_seconds": 3.32,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.32,
      "end_seconds": 107.26,
      "duration_seconds": 2.94,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.97,
      "end_seconds": 111.22,
      "duration_seconds": 3.25,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.09,
      "end_seconds": 113.8,
      "duration_seconds": 1.71,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 120.36,
      "duration_seconds": 4.75,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.35,
      "end_seconds": 124.2,
      "duration_seconds": 1.85,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.02,
      "end_seconds": 129.24,
      "duration_seconds": 4.22,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.09,
      "end_seconds": 134.01,
      "duration_seconds": 2.92,
      "text": "Right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.33,
      "end_seconds": 138.28,
      "duration_seconds": 2.95,
      "text": "Yeah, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.86,
      "end_seconds": 140.15,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.19,
      "end_seconds": 143.45,
      "duration_seconds": 1.26,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.22,
      "end_seconds": 148.87,
      "duration_seconds": 3.65,
      "text": "Have you noticed fever, leg swelling or cough?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.89,
      "end_seconds": 155.51,
      "duration_seconds": 4.62,
      "text": "I haven't had fever, leg swelling or cough, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.39,
      "end_seconds": 159.13,
      "duration_seconds": 2.74,
      "text": "Okay, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.08,
      "end_seconds": 162.02,
      "duration_seconds": 0.94,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.64,
      "end_seconds": 165.83,
      "duration_seconds": 3.19,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.49,
      "end_seconds": 167.98,
      "duration_seconds": 1.49,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.23,
      "end_seconds": 171.72,
      "duration_seconds": 2.49,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 185.78,
      "duration_seconds": 2.24,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.36,
      "end_seconds": 215.66,
      "duration_seconds": 12.3,
      "text": "Okay: temperature 36.7, blood pressure 124 over 87, SpO2 96 percent on room air. And pulse is 119 beats a minute, respiratory rate 16."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.42,
      "end_seconds": 221.31,
      "duration_seconds": 3.89,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.31,
      "end_seconds": 224.31,
      "duration_seconds": 2.0,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.92,
      "end_seconds": 238.96,
      "duration_seconds": 4.04,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.6,
      "end_seconds": 252.57,
      "duration_seconds": 0.97,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.63,
      "end_seconds": 273.56,
      "duration_seconds": 17.93,
      "text": "That's the examination finished. So, based on the history and the examination, this looks most like a possible heart attack. We shouldn't forget unstable angina. Just to be sure I understood. You've had crushing chest pain, mild, and no leg swelling or fever."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.54,
      "end_seconds": 276.24,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.67,
      "end_seconds": 292.42,
      "duration_seconds": 14.75,
      "text": "Let's get an ECG, for chest pain. We should do a troponin blood test for chest pain. What I'm giving you is aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.44,
      "end_seconds": 294.9,
      "duration_seconds": 1.46,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.25,
      "end_seconds": 306.26,
      "duration_seconds": 10.01,
      "text": "Stay lying down and do not eat or drink. Please come and see me straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.19,
      "end_seconds": 312.21,
      "duration_seconds": 4.02,
      "text": "Good, um, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.27,
      "end_seconds": 314.58,
      "duration_seconds": 1.31,
      "text": "See you soon."
    }
  ]
}