      "role": "DOCTOR",
      "start_seconds": 226.45,
      "end_seconds": 236.6,
      "duration_seconds": 10.15,
      "text": "okay: temperature is 36.8 degrees, respiratory rate 16. And BP is 125 over 70, heart rate 72, SpO2 97 percent on room air"
