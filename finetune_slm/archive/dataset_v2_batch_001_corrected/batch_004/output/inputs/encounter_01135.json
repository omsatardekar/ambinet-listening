      "role": "PATIENT",
      "start_seconds": 12.78,
      "end_seconds": 20.22,
      "duration_seconds": 7.44,
      "text": "yeah doctor it's a dry cough in the evenings it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.66,
      "end_seconds": 28.02,
      "duration_seconds": 6.36,
      "text": "how long has this been bothering you? I'll explain everything as we go along"
