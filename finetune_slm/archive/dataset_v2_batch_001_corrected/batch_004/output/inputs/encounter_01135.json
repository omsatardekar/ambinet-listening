    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.17,
      "end_seconds": 57.94,
      "duration_seconds": 13.77,
      "text": "Yes, pollen season. That makes it worse. It settles a little with antihistamine. It's every other day. I'd give it a six, out of ten."
