      "role": "DOCTOR",
      "start_seconds": 263.96,
      "end_seconds": 269.05,
      "duration_seconds": 5.09,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.92,
      "end_seconds": 279.0,
      "duration_seconds": 1.08,
      "text": "Sure thing."
