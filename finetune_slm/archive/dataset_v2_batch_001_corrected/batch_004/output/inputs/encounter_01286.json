{
  "schema_version": "1.0",
  "encounter_id": "01286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 5.54,
      "duration_seconds": 4.7,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 11.59,
      "duration_seconds": 4.01,
      "text": "Okay, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.17,
      "end_seconds": 29.47,
      "duration_seconds": 16.3,
      "text": "It's hives all over. I thought I'd wait, but it hasn't gone. I'd rather know what's going on than keep guessing. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.64,
      "end_seconds": 33.54,
      "duration_seconds": 2.9,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.09,
      "end_seconds": 39.55,
      "duration_seconds": 4.46,
      "text": "it's been going on for about a month"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.1,
      "end_seconds": 48.18,
      "duration_seconds": 8.08,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.68,
      "end_seconds": 61.5,
      "duration_seconds": 11.82,
      "text": "Honestly, once or twice a day. I'd give it a three, out of ten. I've been feeling faint too, for about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 62.33,
      "end_seconds": 71.08,
      "duration_seconds": 8.75,
      "text": "Okay, so the vitals from earlier. BP is 96 over 65, pulse 106, temp 36.9 degrees, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.16,
      "end_seconds": 74.6,
      "duration_seconds": 1.44,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.98,
      "end_seconds": 80.52,
      "duration_seconds": 3.54,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.29,
      "end_seconds": 84.63,
      "duration_seconds": 2.34,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.09,
      "end_seconds": 107.81,
      "duration_seconds": 6.72,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.52,
      "end_seconds": 112.92,
      "duration_seconds": 2.4,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.62,
      "end_seconds": 127.47,
      "duration_seconds": 3.85,
      "text": "A few quick ones: recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.52,
      "end_seconds": 131.95,
      "duration_seconds": 3.43,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.75,
      "end_seconds": 135.84,
      "duration_seconds": 2.09,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.85,
      "end_seconds": 140.09,
      "duration_seconds": 3.24,
      "text": "Mm, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.45,
      "end_seconds": 155.4,
      "duration_seconds": 3.95,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.87,
      "end_seconds": 159.31,
      "duration_seconds": 2.44,
      "text": "Asthma, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.9,
      "end_seconds": 165.39,
      "duration_seconds": 5.49,
      "text": "Okay, go on. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.36,
      "end_seconds": 180.51,
      "duration_seconds": 14.15,
      "text": "I gave up cigarettes last spring. I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours. I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.46,
      "end_seconds": 184.84,
      "duration_seconds": 3.38,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.35,
      "end_seconds": 189.59,
      "duration_seconds": 3.24,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.65,
      "end_seconds": 194.0,
      "duration_seconds": 3.35,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.19,
      "end_seconds": 199.66,
      "duration_seconds": 4.47,
      "text": "Seretide inhaler. I take it twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.42,
      "end_seconds": 223.59,
      "duration_seconds": 8.17,
      "text": "Let me tell you where I've got to. I think we're dealing with anaphylaxis at this stage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.65,
      "end_seconds": 227.69,
      "duration_seconds": 2.04,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.68,
      "end_seconds": 236.49,
      "duration_seconds": 6.81,
      "text": "It's reasonable to be concerned, but right now anaphylaxis is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.09,
      "end_seconds": 276.02,
      "duration_seconds": 22.93,
      "text": "I think monitoring makes sense here, for anaphylaxis. That will help us see what's going on underneath and decide the next step. Let's use adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.27,
      "end_seconds": 290.23,
      "duration_seconds": 13.96,
      "text": "Okay, go on. Let's get you seen by the emergency team, I'll arrange the letter. If the symptoms return, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.75,
      "end_seconds": 292.86,
      "duration_seconds": 1.11,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.19,
      "end_seconds": 298.98,
      "duration_seconds": 4.79,
      "text": "We'll catch up straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.81,
      "end_seconds": 303.1,
      "duration_seconds": 3.29,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.78,
      "end_seconds": 306.08,
      "duration_seconds": 1.3,
      "text": "All the best."
    }
  ]
}