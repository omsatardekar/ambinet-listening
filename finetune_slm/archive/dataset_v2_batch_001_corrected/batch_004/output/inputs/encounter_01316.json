{
  "schema_version": "1.0",
  "encounter_id": "01316",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 9.64,
      "duration_seconds": 8.56,
      "text": "Um, um, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.09,
      "end_seconds": 16.31,
      "duration_seconds": 5.22,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.07,
      "end_seconds": 24.71,
      "duration_seconds": 7.64,
      "text": "Um, so... pain on the outside of my elbow. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.57,
      "end_seconds": 29.37,
      "duration_seconds": 2.8,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.05,
      "end_seconds": 37.85,
      "duration_seconds": 2.8,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.23,
      "end_seconds": 47.3,
      "duration_seconds": 8.07,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.3,
      "end_seconds": 57.48,
      "duration_seconds": 9.18,
      "text": "It's worse with lifting the kettle. Rest helps a bit. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.33,
      "end_seconds": 61.68,
      "duration_seconds": 2.35,
      "text": "Have you had a weaker grip?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.82,
      "end_seconds": 70.39,
      "duration_seconds": 4.57,
      "text": "Um, uh, yeah. Three days, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.67,
      "end_seconds": 75.39,
      "duration_seconds": 3.72,
      "text": "Alright, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.8,
      "end_seconds": 80.11,
      "duration_seconds": 3.31,
      "text": "About a three out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.28,
      "end_seconds": 94.33,
      "duration_seconds": 4.05,
      "text": "Any numbness, neck pain or swelling at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.33,
      "end_seconds": 98.51,
      "duration_seconds": 3.18,
      "text": "Actually, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.89,
      "end_seconds": 104.44,
      "duration_seconds": 4.55,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.21,
      "end_seconds": 106.81,
      "duration_seconds": 1.6,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.74,
      "end_seconds": 111.63,
      "duration_seconds": 2.89,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.41,
      "end_seconds": 115.62,
      "duration_seconds": 3.21,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.42,
      "end_seconds": 119.87,
      "duration_seconds": 3.45,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.37,
      "end_seconds": 123.48,
      "duration_seconds": 3.11,
      "text": "Thin bones, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.88,
      "end_seconds": 138.08,
      "duration_seconds": 10.2,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.15,
      "end_seconds": 143.53,
      "duration_seconds": 3.38,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.21,
      "end_seconds": 158.44,
      "duration_seconds": 3.23,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.72,
      "end_seconds": 170.57,
      "duration_seconds": 10.85,
      "text": "I'm on alendronate, 70 milligrams, once a week for my bones. I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.26,
      "end_seconds": 172.58,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.32,
      "end_seconds": 175.53,
      "duration_seconds": 2.21,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.17,
      "end_seconds": 180.42,
      "duration_seconds": 3.25,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.22,
      "end_seconds": 186.66,
      "duration_seconds": 4.44,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.42,
      "end_seconds": 190.19,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.03,
      "end_seconds": 195.69,
      "duration_seconds": 3.66,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.72,
      "end_seconds": 199.53,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.31,
      "end_seconds": 204.22,
      "duration_seconds": 2.91,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.46,
      "end_seconds": 223.72,
      "duration_seconds": 2.26,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 240.02,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 262.05,
      "duration_seconds": 5.01,
      "text": "Okay: heart rate 84, blood pressure 119 over 76, temperature 36.5."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.43,
      "end_seconds": 268.46,
      "duration_seconds": 4.03,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.3,
      "end_seconds": 271.14,
      "duration_seconds": 1.84,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.5,
      "end_seconds": 275.53,
      "duration_seconds": 3.03,
      "text": "Alright, tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.46,
      "end_seconds": 300.13,
      "duration_seconds": 7.67,
      "text": "It's tender over the bony point on the outside, and it hurts when I resist your wrist going up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.03,
      "end_seconds": 302.13,
      "duration_seconds": 1.1,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.2,
      "end_seconds": 337.65,
      "duration_seconds": 32.45,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. This is probably tennis elbow. I want to be honest that this is an impression, not a final answer. Rest it, use a forearm strap and do the stretches I'll show you. Cut down on salt and fried food for now, it really does make a difference. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.04,
      "end_seconds": 347.42,
      "duration_seconds": 8.38,
      "text": "Let's plan a check if it is not better in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.48,
      "end_seconds": 351.68,
      "duration_seconds": 3.2,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}