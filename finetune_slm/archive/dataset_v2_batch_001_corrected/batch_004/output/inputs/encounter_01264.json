{
  "schema_version": "1.0",
  "encounter_id": "01264",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.22,
      "duration_seconds": 2.69,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.86,
      "end_seconds": 7.16,
      "duration_seconds": 3.3,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.7,
      "end_seconds": 11.6,
      "duration_seconds": 3.9,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.49,
      "end_seconds": 27.24,
      "duration_seconds": 13.75,
      "text": "Well, I've been having pain going into my left arm. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.01,
      "end_seconds": 34.59,
      "duration_seconds": 3.58,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 42.53,
      "duration_seconds": 6.24,
      "text": "oh, you know, it's been ten days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.06,
      "end_seconds": 46.86,
      "duration_seconds": 2.8,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.61,
      "end_seconds": 57.18,
      "duration_seconds": 9.57,
      "text": "I, I'd say mild. Okay, so and I've been sweating as well. And I've been feeling sick as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.76,
      "end_seconds": 63.39,
      "duration_seconds": 4.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.12,
      "end_seconds": 68.48,
      "duration_seconds": 3.36,
      "text": "It comes and goes. Mostly moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 76.84,
      "duration_seconds": 6.54,
      "text": "Have you had pain going into your left arm before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.82,
      "end_seconds": 84.17,
      "duration_seconds": 6.35,
      "text": "Yeah, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.9,
      "end_seconds": 87.96,
      "duration_seconds": 2.06,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.0,
      "end_seconds": 92.41,
      "duration_seconds": 3.41,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.72,
      "end_seconds": 96.15,
      "duration_seconds": 3.43,
      "text": "I follow. Any leg swelling or cough?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.99,
      "end_seconds": 100.72,
      "duration_seconds": 3.73,
      "text": "No, no leg swelling or cough."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.94,
      "end_seconds": 105.46,
      "duration_seconds": 1.52,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 108.39,
      "duration_seconds": 2.13,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.14,
      "end_seconds": 111.1,
      "duration_seconds": 1.96,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.62,
      "end_seconds": 117.04,
      "duration_seconds": 4.42,
      "text": "uh, um, no, that's all fine"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.68,
      "end_seconds": 120.61,
      "duration_seconds": 2.93,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.67,
      "end_seconds": 127.24,
      "duration_seconds": 4.57,
      "text": "so, it's amlodipine, 5 milligrams, once a day"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.39,
      "end_seconds": 134.78,
      "duration_seconds": 2.39,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 138.13,
      "duration_seconds": 1.68,
      "text": "Two months now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.33,
      "end_seconds": 141.63,
      "duration_seconds": 2.3,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.3,
      "end_seconds": 152.84,
      "duration_seconds": 9.54,
      "text": "Yes, high blood pressure. Sorry, what was I saying, I have high cholesterol, for two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.8,
      "end_seconds": 162.48,
      "duration_seconds": 8.68,
      "text": "okay, I can see high blood pressure in your file as well what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.35,
      "end_seconds": 165.71,
      "duration_seconds": 2.36,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.24,
      "end_seconds": 167.02,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.35,
      "end_seconds": 171.24,
      "duration_seconds": 2.89,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.91,
      "end_seconds": 174.87,
      "duration_seconds": 1.96,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.51,
      "end_seconds": 179.22,
      "duration_seconds": 3.71,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.14,
      "end_seconds": 182.75,
      "duration_seconds": 2.61,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.04,
      "end_seconds": 188.31,
      "duration_seconds": 4.27,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.08,
      "end_seconds": 193.12,
      "duration_seconds": 3.04,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.71,
      "end_seconds": 198.09,
      "duration_seconds": 3.38,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.4,
      "end_seconds": 208.96,
      "duration_seconds": 3.56,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.59,
      "end_seconds": 223.52,
      "duration_seconds": 2.93,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.26,
      "end_seconds": 244.64,
      "duration_seconds": 10.38,
      "text": "okay: saturation 97 percent, blood pressure 133 over 71. And temperature is 36.8 degrees, pulse is 113 beats a minute"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.74,
      "end_seconds": 248.2,
      "duration_seconds": 2.46,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.39,
      "end_seconds": 251.48,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.97,
      "end_seconds": 265.44,
      "duration_seconds": 4.47,
      "text": "you are pale and sweaty, and your pulse is fast"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.84,
      "end_seconds": 271.61,
      "duration_seconds": 2.77,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.56,
      "end_seconds": 288.56,
      "duration_seconds": 9.0,
      "text": "From what you've told me and what I found, my working impression is a possible heart attack. Another possibility is unstable angina."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.01,
      "end_seconds": 293.78,
      "duration_seconds": 3.77,
      "text": "Actually, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.95,
      "end_seconds": 303.75,
      "duration_seconds": 8.8,
      "text": "I can't promise yet, but most people with a possible heart attack do well once it's treated properly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.16,
      "end_seconds": 343.63,
      "duration_seconds": 30.47,
      "text": "I'm going to order an ECG, for chest pain. I'd rather check than guess, and this is the quickest way to know more. I'm going to order a troponin blood test, for chest pain. You'll be taking aspirin, 300 milligrams, once now, single dose. It's for possible heart attack. The pharmacy will go through the details again when you pick it up. Stay lying down and do not eat or drink."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.16,
      "end_seconds": 355.88,
      "duration_seconds": 10.72,
      "text": "I'm going to send a referral to the cardiac team. Do get help quickly if the pain returns. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.22,
      "end_seconds": 359.53,
      "duration_seconds": 2.31,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.17,
      "end_seconds": 365.65,
      "duration_seconds": 5.48,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.6,
      "end_seconds": 371.65,
      "duration_seconds": 5.05,
      "text": "Well, you know, no, that's all. Thanks a lot."
    }
  ]
}