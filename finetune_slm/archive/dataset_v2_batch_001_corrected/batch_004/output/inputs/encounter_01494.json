{
  "schema_version": "1.0",
  "encounter_id": "01494",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 6.82,
      "duration_seconds": 5.83,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 11.89,
      "duration_seconds": 4.17,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.87,
      "end_seconds": 19.34,
      "duration_seconds": 5.47,
      "text": "Um, so... a lingering cough. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.06,
      "end_seconds": 24.51,
      "duration_seconds": 3.45,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.24,
      "end_seconds": 28.58,
      "duration_seconds": 2.34,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.45,
      "end_seconds": 39.68,
      "duration_seconds": 10.23,
      "text": "So, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.69,
      "end_seconds": 48.6,
      "duration_seconds": 7.91,
      "text": "A three out of ten, I suppose. I notice it more with talking and cold air."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.91,
      "end_seconds": 69.65,
      "duration_seconds": 3.74,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.76,
      "end_seconds": 72.47,
      "duration_seconds": 1.71,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.91,
      "end_seconds": 80.6,
      "duration_seconds": 2.69,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.32,
      "end_seconds": 85.33,
      "duration_seconds": 4.01,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.43,
      "end_seconds": 106.34,
      "duration_seconds": 2.91,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.11,
      "end_seconds": 108.32,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.97,
      "end_seconds": 115.6,
      "duration_seconds": 5.63,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.21,
      "end_seconds": 125.15,
      "duration_seconds": 8.94,
      "text": "I grab fast food at lunch most days. I live with my elderly mother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.74,
      "end_seconds": 138.95,
      "duration_seconds": 3.21,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.75,
      "end_seconds": 146.84,
      "duration_seconds": 2.09,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.2,
      "end_seconds": 154.36,
      "duration_seconds": 4.16,
      "text": "Have you noticed shortness of breath, fever or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.05,
      "end_seconds": 164.54,
      "duration_seconds": 5.49,
      "text": "No, you know, no shortness of breath, fever or weight loss."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.21,
      "end_seconds": 169.02,
      "duration_seconds": 3.81,
      "text": "Have you had coughing up blood, by any chance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.6,
      "end_seconds": 173.19,
      "duration_seconds": 2.59,
      "text": "Nope, no coughing up blood."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.89,
      "end_seconds": 176.46,
      "duration_seconds": 2.57,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.67,
      "end_seconds": 179.03,
      "duration_seconds": 1.36,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.49,
      "end_seconds": 186.71,
      "duration_seconds": 3.22,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.58,
      "end_seconds": 191.44,
      "duration_seconds": 2.86,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.83,
      "end_seconds": 198.04,
      "duration_seconds": 4.21,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.38,
      "end_seconds": 213.97,
      "duration_seconds": 2.59,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.89,
      "end_seconds": 231.87,
      "duration_seconds": 7.98,
      "text": "Okay: saturation 99 percent, temperature 37.0, BP is 115 over 74. And heart rate 70, respiratory rate 17."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.48,
      "end_seconds": 237.83,
      "duration_seconds": 3.35,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.7,
      "end_seconds": 241.45,
      "duration_seconds": 1.75,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.14,
      "end_seconds": 245.55,
      "duration_seconds": 2.41,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.48,
      "end_seconds": 264.31,
      "duration_seconds": 3.83,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.63,
      "end_seconds": 266.55,
      "duration_seconds": 0.92,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.42,
      "end_seconds": 280.31,
      "duration_seconds": 9.89,
      "text": "So, you can relax now. From what you've told me and what I found, it fits best with a post-viral cough that is settling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.27,
      "end_seconds": 283.63,
      "duration_seconds": 1.36,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.12,
      "end_seconds": 293.19,
      "duration_seconds": 8.07,
      "text": "Nothing I've seen today points to an emergency. It looks like a post-viral cough that is settling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.36,
      "end_seconds": 316.45,
      "duration_seconds": 9.09,
      "text": "It should settle over the next two to three weeks; steam and honey can help. Come back if it lasts beyond eight weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.97,
      "end_seconds": 319.98,
      "duration_seconds": 2.01,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.71,
      "end_seconds": 325.12,
      "duration_seconds": 4.41,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.58,
      "end_seconds": 328.62,
      "duration_seconds": 2.04,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}