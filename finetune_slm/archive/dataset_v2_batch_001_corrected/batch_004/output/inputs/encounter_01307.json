{
  "schema_version": "1.0",
  "encounter_id": "01307",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 8.77,
      "duration_seconds": 7.58,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.27,
      "end_seconds": 15.56,
      "duration_seconds": 5.29,
      "text": "Right, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.42,
      "end_seconds": 31.48,
      "duration_seconds": 15.06,
      "text": "ah, uh, hello, doctor i hope it's alright if I stay in for this doctor, it's a pink spotty rash that's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.98,
      "end_seconds": 36.4,
      "duration_seconds": 3.42,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.3,
      "end_seconds": 49.36,
      "duration_seconds": 11.06,
      "text": "It's alendronate, 70 milligrams, once a week, doctor. She is on rosuvastatin, at night, I give it to her."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.52,
      "end_seconds": 56.86,
      "duration_seconds": 2.34,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 58.17,
      "end_seconds": 64.82,
      "duration_seconds": 6.65,
      "text": "It's 10 milligrams. Hmm, it's paracetamol syrup, 5 ml, when needed, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.54,
      "end_seconds": 70.41,
      "duration_seconds": 3.87,
      "text": "Right, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.52,
      "end_seconds": 75.04,
      "duration_seconds": 3.52,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.21,
      "end_seconds": 79.14,
      "duration_seconds": 2.93,
      "text": "Is it it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.81,
      "end_seconds": 83.51,
      "duration_seconds": 3.7,
      "text": "It usually comes with a runny nose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.84,
      "end_seconds": 88.67,
      "duration_seconds": 3.83,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.99,
      "end_seconds": 95.04,
      "duration_seconds": 5.05,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.52,
      "end_seconds": 96.4,
      "duration_seconds": 0.88,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.44,
      "end_seconds": 105.23,
      "duration_seconds": 6.79,
      "text": "oh, and a mild temperature. That's been about the same, two weeks"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.69,
      "end_seconds": 110.35,
      "duration_seconds": 3.66,
      "text": "have you had any stiff neck, drowsiness or breathlessness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.67,
      "end_seconds": 116.53,
      "duration_seconds": 2.86,
      "text": "Yeah, nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.31,
      "end_seconds": 119.3,
      "duration_seconds": 1.99,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.25,
      "end_seconds": 122.85,
      "duration_seconds": 1.6,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 126.23,
      "duration_seconds": 2.79,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.23,
      "end_seconds": 133.91,
      "duration_seconds": 2.68,
      "text": "Nothing unusual, uh, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.67,
      "end_seconds": 137.42,
      "duration_seconds": 2.75,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.33,
      "end_seconds": 146.76,
      "duration_seconds": 7.43,
      "text": "I've had thin bones, yes. I have high cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.14,
      "end_seconds": 159.35,
      "duration_seconds": 2.21,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.21,
      "end_seconds": 164.01,
      "duration_seconds": 2.8,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.05,
      "end_seconds": 168.6,
      "duration_seconds": 2.55,
      "text": "So, how are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.48,
      "end_seconds": 174.96,
      "duration_seconds": 4.48,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.63,
      "end_seconds": 197.81,
      "duration_seconds": 4.18,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.83,
      "end_seconds": 202.65,
      "duration_seconds": 2.82,
      "text": "my mother had a stroke"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.62,
      "end_seconds": 217.14,
      "duration_seconds": 2.52,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.59,
      "end_seconds": 232.01,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.2,
      "end_seconds": 246.66,
      "duration_seconds": 4.46,
      "text": "okay: pulse 71, pressure 125 over 70, temperature 36.6."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.22,
      "end_seconds": 252.77,
      "duration_seconds": 1.55,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.86,
      "end_seconds": 257.22,
      "duration_seconds": 2.36,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 261.66,
      "duration_seconds": 3.26,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 264.64,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.71,
      "end_seconds": 285.99,
      "duration_seconds": 5.28,
      "text": "The spots fade when pressed and he is playful and drinking well."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.02,
      "end_seconds": 296.68,
      "duration_seconds": 7.66,
      "text": "You can sit up now. Taking everything into account, the most likely explanation is a harmless viral rash."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.19,
      "end_seconds": 300.36,
      "duration_seconds": 2.17,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.25,
      "end_seconds": 328.24,
      "duration_seconds": 25.99,
      "text": "I understand the worry. At the moment I'd say it's a harmless viral rash, and we'll watch how it goes. Fluids and paracetamol if he is hot or uncomfortable. Keep an eye out, and if the spots do not fade when pressed or he becomes drowsy, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.35,
      "end_seconds": 331.25,
      "duration_seconds": 1.9,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.35,
      "end_seconds": 343.62,
      "duration_seconds": 9.27,
      "text": "Come back if it lasts more than a week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.16,
      "end_seconds": 347.8,
      "duration_seconds": 3.64,
      "text": "Actually, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.99,
      "end_seconds": 350.82,
      "duration_seconds": 1.83,
      "text": "right, look after yourself"
    }
  ]
}