{
  "schema_version": "1.0",
  "encounter_id": "01031",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.09,
      "duration_seconds": 2.93,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.69,
      "end_seconds": 9.79,
      "duration_seconds": 4.1,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 15.91,
      "duration_seconds": 4.2,
      "text": "It's a red hot swelling on my leg, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.85,
      "end_seconds": 20.08,
      "duration_seconds": 3.23,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.31,
      "end_seconds": 42.78,
      "duration_seconds": 21.47,
      "text": "Severe, I'd say. I've had a high fever too, for one week. Oh, and pain much worse than it looks. That's been about the same, about three months. About pain much worse than it looks, it feels mild to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.66,
      "end_seconds": 49.93,
      "duration_seconds": 3.27,
      "text": "Have you noticed insect bite or cut?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.73,
      "end_seconds": 55.43,
      "duration_seconds": 3.7,
      "text": "No insect bite or cut, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.4,
      "end_seconds": 60.43,
      "duration_seconds": 3.03,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.31,
      "end_seconds": 64.28,
      "duration_seconds": 2.97,
      "text": "Right, no, joints are fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.0,
      "end_seconds": 68.86,
      "duration_seconds": 2.86,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.96,
      "end_seconds": 73.79,
      "duration_seconds": 3.83,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.14,
      "end_seconds": 77.8,
      "duration_seconds": 2.66,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.85,
      "end_seconds": 83.21,
      "duration_seconds": 4.36,
      "text": "I'm allergic to erythromycin, I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.78,
      "end_seconds": 102.99,
      "duration_seconds": 4.21,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.69,
      "end_seconds": 121.18,
      "duration_seconds": 17.49,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. My partner and our baby. I do a yoga class on Thursdays. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.04,
      "end_seconds": 124.97,
      "duration_seconds": 2.93,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.56,
      "end_seconds": 130.56,
      "duration_seconds": 4.0,
      "text": "I've had diabetes for about a year now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.57,
      "end_seconds": 133.62,
      "duration_seconds": 1.05,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.41,
      "end_seconds": 141.05,
      "duration_seconds": 1.64,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.7,
      "end_seconds": 146.81,
      "duration_seconds": 4.11,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.98,
      "end_seconds": 152.86,
      "duration_seconds": 4.88,
      "text": "Febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.65,
      "end_seconds": 158.73,
      "duration_seconds": 4.08,
      "text": "So, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.34,
      "end_seconds": 168.34,
      "duration_seconds": 3.0,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.84,
      "end_seconds": 194.73,
      "duration_seconds": 12.89,
      "text": "Okay: BMI works out to 17.3, respiratory rate 22. And pulse 88, weight 56 kilos, temperature 38.0, height 180 centimetres, pressure 112 over 79."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.73,
      "end_seconds": 197.11,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.9,
      "end_seconds": 203.41,
      "duration_seconds": 4.51,
      "text": "So, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.02,
      "end_seconds": 208.82,
      "duration_seconds": 3.8,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.62,
      "end_seconds": 220.67,
      "duration_seconds": 1.05,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.76,
      "end_seconds": 223.53,
      "duration_seconds": 1.77,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.43,
      "end_seconds": 245.27,
      "duration_seconds": 6.84,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.89,
      "end_seconds": 251.62,
      "duration_seconds": 1.73,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.26,
      "end_seconds": 274.89,
      "duration_seconds": 9.63,
      "text": "Okay, so my impression is this: I'd lean towards a severe deep skin infection needing urgent surgery review. Severe cellulitis is still possible."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.65,
      "end_seconds": 280.67,
      "duration_seconds": 2.02,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.46,
      "end_seconds": 299.88,
      "duration_seconds": 17.42,
      "text": "It's reasonable to be concerned, but right now a severe deep skin infection needing urgent surgery review is my leading thought, not anything worse. I'd like to arrange an urgent surgical review for possible necrotising infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.8,
      "end_seconds": 304.52,
      "duration_seconds": 2.72,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.72,
      "end_seconds": 311.04,
      "duration_seconds": 5.32,
      "text": "I'll request urgent blood tests, it'll help with severe skin infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.58,
      "end_seconds": 314.81,
      "duration_seconds": 2.23,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.68,
      "end_seconds": 321.97,
      "duration_seconds": 6.29,
      "text": "I am sending you to hospital now, do not wait. Let's review you straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.14,
      "end_seconds": 325.08,
      "duration_seconds": 1.94,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.07,
      "end_seconds": 330.88,
      "duration_seconds": 3.81,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.15,
      "end_seconds": 335.99,
      "duration_seconds": 3.84,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.99,
      "end_seconds": 338.16,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}