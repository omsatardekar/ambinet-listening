{
  "schema_version": "1.0",
  "encounter_id": "01008",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 10.38,
      "duration_seconds": 9.28,
      "text": "Sorry, what was I saying, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.21,
      "end_seconds": 16.75,
      "duration_seconds": 4.54,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.58,
      "end_seconds": 27.59,
      "duration_seconds": 9.01,
      "text": "Mainly a red warm patch on my shin. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.95,
      "end_seconds": 32.71,
      "duration_seconds": 3.76,
      "text": "So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.91,
      "end_seconds": 37.22,
      "duration_seconds": 3.31,
      "text": "I've had it for ten days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.65,
      "end_seconds": 41.12,
      "duration_seconds": 2.47,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.99,
      "end_seconds": 44.82,
      "duration_seconds": 2.83,
      "text": "Only elevation, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.61,
      "end_seconds": 57.97,
      "duration_seconds": 3.36,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.42,
      "end_seconds": 69.56,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.7,
      "end_seconds": 93.77,
      "duration_seconds": 8.07,
      "text": "okay: saturation 98 percent, pulse 88. And temp 39.0 degrees, BP is 105 over 71."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.85,
      "end_seconds": 98.5,
      "duration_seconds": 3.65,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.1,
      "end_seconds": 101.22,
      "duration_seconds": 1.12,
      "text": "of course"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.94,
      "end_seconds": 104.39,
      "duration_seconds": 1.45,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.13,
      "end_seconds": 120.41,
      "duration_seconds": 8.28,
      "text": "the shin is red, warm and tender with a clear edge, and I've marked it with a pen"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.2,
      "end_seconds": 133.35,
      "duration_seconds": 9.15,
      "text": "That's all I needed to check. Let me check a few things. Any shortness of breath, cut or rash elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.34,
      "end_seconds": 138.28,
      "duration_seconds": 3.94,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.01,
      "end_seconds": 142.79,
      "duration_seconds": 3.78,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.63,
      "end_seconds": 145.82,
      "duration_seconds": 2.19,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.14,
      "end_seconds": 149.67,
      "duration_seconds": 2.53,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.47,
      "end_seconds": 152.96,
      "duration_seconds": 1.49,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.25,
      "end_seconds": 163.56,
      "duration_seconds": 3.31,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.68,
      "end_seconds": 171.59,
      "duration_seconds": 4.91,
      "text": "I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.42,
      "end_seconds": 176.76,
      "duration_seconds": 3.34,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.55,
      "end_seconds": 178.71,
      "duration_seconds": 1.16,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.18,
      "end_seconds": 201.03,
      "duration_seconds": 3.85,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.65,
      "end_seconds": 204.47,
      "duration_seconds": 2.82,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.35,
      "end_seconds": 209.04,
      "duration_seconds": 3.69,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.96,
      "end_seconds": 214.78,
      "duration_seconds": 3.82,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.56,
      "end_seconds": 216.73,
      "duration_seconds": 1.17,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.68,
      "end_seconds": 222.27,
      "duration_seconds": 4.59,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.23,
      "end_seconds": 227.62,
      "duration_seconds": 4.39,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.31,
      "end_seconds": 231.24,
      "duration_seconds": 2.93,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.49,
      "end_seconds": 254.56,
      "duration_seconds": 7.07,
      "text": "Let me tell you where I've got to. It fits best with cellulitis of the leg."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.98,
      "end_seconds": 257.89,
      "duration_seconds": 1.91,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.09,
      "end_seconds": 295.06,
      "duration_seconds": 35.97,
      "text": "I can't promise yet, but most people with cellulitis of the leg do well once it's treated properly. I'm sending you for blood tests because of cellulitis. I'll start you on flucloxacillin, 500 milligrams, four times a day, seven days. You take it by mouth. That should help with cellulitis. Keep the leg raised and come back if the redness goes past the pen line. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.88,
      "end_seconds": 298.65,
      "duration_seconds": 1.77,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.67,
      "end_seconds": 302.83,
      "duration_seconds": 3.16,
      "text": "let's plan a a check in two days"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.38,
      "end_seconds": 307.52,
      "duration_seconds": 3.14,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 313.29,
      "duration_seconds": 3.73,
      "text": "Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.55,
      "end_seconds": 317.59,
      "duration_seconds": 3.04,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}