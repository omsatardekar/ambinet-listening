{
  "schema_version": "1.0",
  "encounter_id": "01226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.08,
      "end_seconds": 3.68,
      "duration_seconds": 2.6,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.25,
      "end_seconds": 8.5,
      "duration_seconds": 3.25,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.39,
      "end_seconds": 12.2,
      "duration_seconds": 2.81,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.0,
      "end_seconds": 18.08,
      "duration_seconds": 5.08,
      "text": "So the thing is, I've got throbbing headaches on one side."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.66,
      "end_seconds": 22.02,
      "duration_seconds": 3.36,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.08,
      "end_seconds": 27.24,
      "duration_seconds": 4.16,
      "text": "It's, It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.3,
      "end_seconds": 40.39,
      "duration_seconds": 12.09,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.43,
      "end_seconds": 48.09,
      "duration_seconds": 6.66,
      "text": "I'd give it a seven, out of ten. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.0,
      "end_seconds": 52.63,
      "duration_seconds": 2.63,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.67,
      "end_seconds": 62.89,
      "duration_seconds": 2.22,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.6,
      "end_seconds": 84.44,
      "duration_seconds": 7.84,
      "text": "Okay: SpO2 98 percent on room air, BP is 114 over 73, respiratory rate 17. And pulse 81."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.02,
      "end_seconds": 91.04,
      "duration_seconds": 4.02,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.32,
      "end_seconds": 94.98,
      "duration_seconds": 2.66,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.56,
      "end_seconds": 119.41,
      "duration_seconds": 5.85,
      "text": "Your eye movements are normal and there is no weakness in your arms or legs."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.97,
      "end_seconds": 123.57,
      "duration_seconds": 1.6,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.38,
      "end_seconds": 137.32,
      "duration_seconds": 2.94,
      "text": "Any head injury, weakness or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.83,
      "end_seconds": 141.64,
      "duration_seconds": 2.81,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.19,
      "end_seconds": 145.68,
      "duration_seconds": 3.49,
      "text": "Hm, okay. Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.62,
      "end_seconds": 150.84,
      "duration_seconds": 3.22,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.68,
      "end_seconds": 155.76,
      "duration_seconds": 3.08,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.82,
      "end_seconds": 158.53,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.43,
      "end_seconds": 163.02,
      "duration_seconds": 3.59,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.16,
      "end_seconds": 167.91,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.95,
      "end_seconds": 171.34,
      "duration_seconds": 1.39,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.51,
      "end_seconds": 175.35,
      "duration_seconds": 2.84,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.16,
      "end_seconds": 191.48,
      "duration_seconds": 3.32,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.12,
      "end_seconds": 204.53,
      "duration_seconds": 12.41,
      "text": "I'm on propranolol, 40 milligrams, twice a day. I thought it would sort itself out, but it hasn't. I'm on paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.08,
      "end_seconds": 206.13,
      "duration_seconds": 1.05,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.81,
      "end_seconds": 227.01,
      "duration_seconds": 4.2,
      "text": "Right, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.78,
      "end_seconds": 235.68,
      "duration_seconds": 3.9,
      "text": "I have migraines, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.88,
      "end_seconds": 244.54,
      "duration_seconds": 5.66,
      "text": "Have you got any known allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.32,
      "end_seconds": 249.37,
      "duration_seconds": 4.05,
      "text": "Walnuts. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 253.56,
      "duration_seconds": 2.3,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.14,
      "end_seconds": 259.33,
      "duration_seconds": 5.19,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.36,
      "end_seconds": 291.38,
      "duration_seconds": 18.02,
      "text": "Let me tell you where I've got to. My working impression is migraine with aura. Let me just check I've got this right. You've had throbbing headaches on one side for four weeks, and no fever or head injury."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.45,
      "end_seconds": 294.15,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.08,
      "end_seconds": 304.59,
      "duration_seconds": 8.51,
      "text": "Let's get a headache diary, for migraine. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.51,
      "end_seconds": 308.48,
      "duration_seconds": 1.97,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.47,
      "end_seconds": 312.87,
      "duration_seconds": 2.4,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.72,
      "end_seconds": 318.76,
      "duration_seconds": 4.04,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.77,
      "end_seconds": 322.11,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}