{
  "schema_version": "1.0",
  "encounter_id": "01366",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 3.93,
      "duration_seconds": 3.39,
      "text": "Yeah, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.48,
      "end_seconds": 9.96,
      "duration_seconds": 5.48,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.92,
      "end_seconds": 20.14,
      "duration_seconds": 9.22,
      "text": "Mainly a tight band around my head. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 24.58,
      "duration_seconds": 2.74,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.02,
      "end_seconds": 29.78,
      "duration_seconds": 3.76,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.27,
      "end_seconds": 33.01,
      "duration_seconds": 2.74,
      "text": "Understood. Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.06,
      "end_seconds": 40.29,
      "duration_seconds": 5.23,
      "text": "Yeah, stress and long screen days definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.11,
      "end_seconds": 47.18,
      "duration_seconds": 5.07,
      "text": "Have you had any sensitivity to light, weakness or blurred vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.05,
      "end_seconds": 52.14,
      "duration_seconds": 3.09,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.22,
      "end_seconds": 57.66,
      "duration_seconds": 2.44,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.52,
      "end_seconds": 61.21,
      "duration_seconds": 1.69,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.26,
      "end_seconds": 67.44,
      "duration_seconds": 5.18,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.24,
      "end_seconds": 76.47,
      "duration_seconds": 7.23,
      "text": "Sorry, what was I saying, I take paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.24,
      "end_seconds": 93.09,
      "duration_seconds": 3.85,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.06,
      "end_seconds": 96.85,
      "duration_seconds": 1.79,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.32,
      "end_seconds": 117.12,
      "duration_seconds": 4.8,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.67,
      "end_seconds": 122.85,
      "duration_seconds": 4.18,
      "text": "Yeah, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.04,
      "end_seconds": 143.45,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.02,
      "end_seconds": 148.29,
      "duration_seconds": 3.27,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.44,
      "end_seconds": 153.47,
      "duration_seconds": 4.03,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.54,
      "end_seconds": 156.33,
      "duration_seconds": 1.79,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.53,
      "end_seconds": 176.52,
      "duration_seconds": 2.99,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.73,
      "end_seconds": 182.01,
      "duration_seconds": 4.28,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.01,
      "end_seconds": 187.77,
      "duration_seconds": 1.76,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.12,
      "end_seconds": 195.52,
      "duration_seconds": 3.4,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.87,
      "end_seconds": 200.05,
      "duration_seconds": 3.18,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.17,
      "end_seconds": 214.4,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.6,
      "end_seconds": 236.72,
      "duration_seconds": 7.12,
      "text": "Okay: blood pressure 125 over 79, temp 36.5 degrees, saturation 97 percent, heart rate 78."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.4,
      "end_seconds": 240.42,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.65,
      "end_seconds": 244.18,
      "duration_seconds": 2.53,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.79,
      "end_seconds": 249.21,
      "duration_seconds": 2.42,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.03,
      "end_seconds": 254.14,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.22,
      "end_seconds": 256.67,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.61,
      "end_seconds": 279.42,
      "duration_seconds": 5.81,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.82,
      "end_seconds": 311.31,
      "duration_seconds": 27.49,
      "text": "Please sit back down. Taking everything into account, I think we're dealing with tension-type headache at this stage. The reason I say that is that your story and my examination fit together. An eye test is what I'd like next, for eye strain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.1,
      "end_seconds": 313.6,
      "duration_seconds": 1.5,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.2,
      "end_seconds": 327.38,
      "duration_seconds": 12.18,
      "text": "Take screen breaks every hour and try regular neck stretches. If the headache becomes sudden and severe, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.26,
      "end_seconds": 331.73,
      "duration_seconds": 2.47,
      "text": "Actually, that's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.54,
      "end_seconds": 341.82,
      "duration_seconds": 8.28,
      "text": "I'd like to see you again in four weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.75,
      "end_seconds": 348.37,
      "duration_seconds": 2.62,
      "text": "Mm, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.32,
      "end_seconds": 350.61,
      "duration_seconds": 1.29,
      "text": "Goodbye for now."
    }
  ]
}