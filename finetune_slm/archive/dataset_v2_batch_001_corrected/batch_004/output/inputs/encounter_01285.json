{
  "schema_version": "1.0",
  "encounter_id": "01285",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.91,
      "duration_seconds": 3.29,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.02,
      "end_seconds": 11.51,
      "duration_seconds": 4.49,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.02,
      "end_seconds": 32.5,
      "duration_seconds": 15.48,
      "text": "Well, I've been having a pink spotty rash. My sister suggested writing things down, but I forgot. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.12,
      "end_seconds": 36.09,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.13,
      "end_seconds": 42.75,
      "duration_seconds": 4.62,
      "text": "It's been about three months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.34,
      "end_seconds": 48.8,
      "duration_seconds": 5.46,
      "text": "I see, go ahead. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.99,
      "end_seconds": 57.7,
      "duration_seconds": 7.71,
      "text": "It feels moderate to me. I've had a mild temperature too, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.6,
      "end_seconds": 61.77,
      "duration_seconds": 3.17,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.72,
      "end_seconds": 72.22,
      "duration_seconds": 2.5,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.77,
      "end_seconds": 102.7,
      "duration_seconds": 9.93,
      "text": "Okay: temperature is 36.4 degrees, pressure 108 over 80, pulse is 76 beats a minute, respiratory rate 16, saturation 98 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.47,
      "end_seconds": 110.55,
      "duration_seconds": 5.08,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.26,
      "end_seconds": 112.96,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.39,
      "end_seconds": 116.64,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.28,
      "end_seconds": 132.55,
      "duration_seconds": 5.27,
      "text": "The spots fade when pressed and he is playful and drinking well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.25,
      "end_seconds": 142.43,
      "duration_seconds": 6.18,
      "text": "Okay, that's enough for me. Did you get breathlessness, stiff neck or drowsiness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.47,
      "end_seconds": 146.98,
      "duration_seconds": 3.51,
      "text": "Um, no, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.5,
      "end_seconds": 152.98,
      "duration_seconds": 4.48,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.19,
      "end_seconds": 156.11,
      "duration_seconds": 1.92,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.62,
      "end_seconds": 160.44,
      "duration_seconds": 3.82,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.85,
      "end_seconds": 163.65,
      "duration_seconds": 1.8,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.28,
      "end_seconds": 184.98,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.77,
      "end_seconds": 187.83,
      "duration_seconds": 1.06,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.46,
      "end_seconds": 208.28,
      "duration_seconds": 2.82,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.2,
      "end_seconds": 218.17,
      "duration_seconds": 8.97,
      "text": "Eczema, for nearly five years. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.37,
      "end_seconds": 223.54,
      "duration_seconds": 4.17,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.84,
      "end_seconds": 237.12,
      "duration_seconds": 12.28,
      "text": "Yes, I work in a bakery, early starts. I drink a lot of tea and snack through the day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.73,
      "end_seconds": 242.02,
      "duration_seconds": 4.29,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.92,
      "end_seconds": 248.77,
      "duration_seconds": 2.85,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.64,
      "end_seconds": 254.65,
      "duration_seconds": 4.01,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.29,
      "end_seconds": 263.7,
      "duration_seconds": 8.41,
      "text": "Hydrocortisone cream. I take it when needed. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.99,
      "end_seconds": 284.39,
      "duration_seconds": 5.4,
      "text": "Okay, so my impression is this: This is probably a harmless viral rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.57,
      "end_seconds": 287.5,
      "duration_seconds": 1.93,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.78,
      "end_seconds": 308.98,
      "duration_seconds": 20.2,
      "text": "I understand the worry. At the moment I'd say it's a harmless viral rash, and we'll watch how it goes. Let me just check I've got this right. You've had a pink spotty rash for about three months, moderate, and no stiff neck or drowsiness."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.74,
      "end_seconds": 312.37,
      "duration_seconds": 1.63,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.27,
      "end_seconds": 344.93,
      "duration_seconds": 18.66,
      "text": "Fluids and paracetamol if he is hot or uncomfortable. Cut down on salt and fried food for now, it really does make a difference. Book a review if it lasts more than a week. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.73,
      "end_seconds": 349.88,
      "duration_seconds": 4.15,
      "text": "Good, um, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.59,
      "end_seconds": 353.02,
      "duration_seconds": 1.43,
      "text": "Take care now."
    }
  ]
}