{
  "schema_version": "1.0",
  "encounter_id": "01121",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.42,
      "duration_seconds": 4.05,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 11.42,
      "duration_seconds": 4.53,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.12,
      "end_seconds": 25.69,
      "duration_seconds": 12.57,
      "text": "Doctor, thank you for seeing us. Sorry, what was I saying, it's sharp pain when I breathe in, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 30.79,
      "duration_seconds": 4.46,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 31.4,
      "end_seconds": 35.84,
      "duration_seconds": 4.44,
      "text": "It's Asthalin inhaler, when needed for my asthma, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.14,
      "end_seconds": 37.05,
      "duration_seconds": 0.91,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.35,
      "end_seconds": 44.99,
      "duration_seconds": 6.64,
      "text": "Erm, um, she takes sertraline, 50 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.03,
      "end_seconds": 48.81,
      "duration_seconds": 2.78,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 49.66,
      "end_seconds": 57.55,
      "duration_seconds": 7.89,
      "text": "About six months. Yeah, uh, it's naproxen, twice a day for the knee pain, doctor."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.54,
      "end_seconds": 60.76,
      "duration_seconds": 2.22,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 64.33,
      "end_seconds": 68.55,
      "duration_seconds": 4.22,
      "text": "250 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.21,
      "end_seconds": 75.13,
      "duration_seconds": 5.92,
      "text": "Let me think, I was on mirtazapine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.89,
      "end_seconds": 79.47,
      "duration_seconds": 3.58,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.23,
      "end_seconds": 87.57,
      "duration_seconds": 7.34,
      "text": "For four weeks, I'd say. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.64,
      "end_seconds": 97.37,
      "duration_seconds": 7.73,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.2,
      "end_seconds": 122.04,
      "duration_seconds": 23.84,
      "text": "Hmm, it feels mild to me. It comes and goes. Oh, um, and sudden shortness of breath. That's been about the same, about four days. I mean, and there's a swollen painful calf as well, three days now. With swollen painful calf, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.62,
      "end_seconds": 124.82,
      "duration_seconds": 2.2,
      "text": "Any wheeze or chest tightness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.53,
      "end_seconds": 130.29,
      "duration_seconds": 4.76,
      "text": "Sorry, what was I saying, nope, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 133.43,
      "duration_seconds": 1.35,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.09,
      "end_seconds": 136.39,
      "duration_seconds": 2.3,
      "text": "No, none, no fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 137.54,
      "end_seconds": 142.8,
      "duration_seconds": 5.26,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.77,
      "end_seconds": 150.06,
      "duration_seconds": 6.29,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.73,
      "end_seconds": 160.87,
      "duration_seconds": 7.14,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.61,
      "end_seconds": 164.58,
      "duration_seconds": 2.97,
      "text": "No, you know, that's all fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.13,
      "end_seconds": 169.97,
      "duration_seconds": 3.84,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.87,
      "end_seconds": 178.72,
      "duration_seconds": 7.85,
      "text": "I have asthma, for about ten years. I have depression, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.08,
      "end_seconds": 181.59,
      "duration_seconds": 1.51,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.36,
      "end_seconds": 186.22,
      "duration_seconds": 2.86,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.79,
      "end_seconds": 188.72,
      "duration_seconds": 0.93,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.98,
      "end_seconds": 201.91,
      "duration_seconds": 6.93,
      "text": "Okay, I can see depression in your file as well. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.36,
      "end_seconds": 207.93,
      "duration_seconds": 4.57,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.31,
      "end_seconds": 212.43,
      "duration_seconds": 3.12,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.41,
      "end_seconds": 219.15,
      "duration_seconds": 4.74,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.9,
      "end_seconds": 222.7,
      "duration_seconds": 1.8,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.6,
      "end_seconds": 227.47,
      "duration_seconds": 3.87,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.52,
      "end_seconds": 232.58,
      "duration_seconds": 3.06,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.15,
      "end_seconds": 237.3,
      "duration_seconds": 4.15,
      "text": "Let me think, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.93,
      "end_seconds": 252.77,
      "duration_seconds": 4.84,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.86,
      "end_seconds": 256.32,
      "duration_seconds": 2.46,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 258.38,
      "end_seconds": 267.01,
      "duration_seconds": 8.63,
      "text": "Actually, I remember she had some kind of reaction to trimethoprim before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.34,
      "end_seconds": 273.01,
      "duration_seconds": 4.67,
      "text": "Maybe, you know, but I don't recall it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.71,
      "end_seconds": 277.0,
      "duration_seconds": 3.29,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.94,
      "end_seconds": 297.03,
      "duration_seconds": 3.09,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.66,
      "end_seconds": 310.81,
      "duration_seconds": 2.15,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.28,
      "end_seconds": 335.61,
      "duration_seconds": 7.33,
      "text": "Okay: heart rate 84, SpO2 90 percent on room air. And respiratory rate 24, pressure 120 over 73."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.68,
      "end_seconds": 339.01,
      "duration_seconds": 2.33,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.52,
      "end_seconds": 343.98,
      "duration_seconds": 3.46,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.76,
      "end_seconds": 349.99,
      "duration_seconds": 4.23,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.58,
      "end_seconds": 354.52,
      "duration_seconds": 2.94,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.64,
      "end_seconds": 368.69,
      "duration_seconds": 6.05,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.38,
      "end_seconds": 374.23,
      "duration_seconds": 2.85,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.9,
      "end_seconds": 397.87,
      "duration_seconds": 11.97,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be a possible blood clot in the lung, or it might be a chest infection."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.77,
      "end_seconds": 400.25,
      "duration_seconds": 1.48,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.56,
      "end_seconds": 431.69,
      "duration_seconds": 30.13,
      "text": "I can't promise yet, but most people with a possible blood clot in the lung do well once it's treated properly. I'm going to order a D-dimer blood test, for possible clot. I think a CT scan of the chest makes sense here, for breathlessness. You need to go to hospital now for a scan. I'm going to send a referral to the medical team."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.44,
      "end_seconds": 436.16,
      "duration_seconds": 2.72,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.87,
      "end_seconds": 448.11,
      "duration_seconds": 11.24,
      "text": "Do get help quickly if you feel faint. See me again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 448.98,
      "end_seconds": 451.93,
      "duration_seconds": 2.95,
      "text": "I think I understand everything. Thanks."
    }
  ]
}