{
  "schema_version": "1.0",
  "encounter_id": "01376",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 5.91,
      "duration_seconds": 4.9,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.51,
      "end_seconds": 10.48,
      "duration_seconds": 3.97,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 15.65,
      "duration_seconds": 4.29,
      "text": "I've been dealing with a cut on my finger."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.07,
      "end_seconds": 19.98,
      "duration_seconds": 2.91,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.63,
      "end_seconds": 29.29,
      "duration_seconds": 7.66,
      "text": "It's been like this since this morning. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.38,
      "end_seconds": 35.21,
      "duration_seconds": 3.83,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 39.67,
      "duration_seconds": 3.38,
      "text": "I have low haemoglobin, for five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.91,
      "end_seconds": 47.69,
      "duration_seconds": 4.78,
      "text": "Mm-hmm. Alright, low haemoglobin, that matches what I have here."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.92,
      "end_seconds": 58.64,
      "duration_seconds": 3.72,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.01,
      "end_seconds": 63.25,
      "duration_seconds": 3.24,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.6,
      "end_seconds": 79.45,
      "duration_seconds": 3.85,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.98,
      "end_seconds": 87.22,
      "duration_seconds": 6.24,
      "text": "I take iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.99,
      "end_seconds": 91.87,
      "duration_seconds": 2.88,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.51,
      "end_seconds": 106.25,
      "duration_seconds": 12.74,
      "text": "Not much, I mostly stay in these days. My husband and I live above the shop. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.58,
      "end_seconds": 109.71,
      "duration_seconds": 2.13,
      "text": "Any dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.22,
      "end_seconds": 114.55,
      "duration_seconds": 4.33,
      "text": "No dirty blade or numbness, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.33,
      "end_seconds": 120.19,
      "duration_seconds": 3.86,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 125.08,
      "duration_seconds": 2.9,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.53,
      "end_seconds": 128.68,
      "duration_seconds": 2.15,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.01,
      "end_seconds": 135.09,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.66,
      "end_seconds": 143.63,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.95,
      "end_seconds": 157.96,
      "duration_seconds": 2.01,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.13,
      "end_seconds": 184.68,
      "duration_seconds": 10.55,
      "text": "Okay: height 176 centimetres, weight 82 kilos, heart rate 66, oxygen saturation is 97 percent, pressure 112 over 78, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.56,
      "end_seconds": 188.68,
      "duration_seconds": 2.12,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.4,
      "end_seconds": 194.0,
      "duration_seconds": 3.6,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.91,
      "end_seconds": 200.5,
      "duration_seconds": 4.59,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.67,
      "end_seconds": 213.77,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.68,
      "end_seconds": 218.15,
      "duration_seconds": 2.47,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.85,
      "end_seconds": 232.6,
      "duration_seconds": 5.75,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.63,
      "end_seconds": 236.19,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.43,
      "end_seconds": 259.99,
      "duration_seconds": 19.56,
      "text": "That's all I needed to check. Okay, so my impression is this: It fits best with a minor clean wound that needs only dressing. Let me just check I've got this right. You've had a cut on your finger, since this morning, and no numbness or dirty blade."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.26,
      "end_seconds": 264.96,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.49,
      "end_seconds": 292.73,
      "duration_seconds": 10.24,
      "text": "I'll close it with adhesive strips and keep it dry for two days. Please come and see me if it looks red or swollen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.27,
      "end_seconds": 298.97,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.09,
      "end_seconds": 302.82,
      "duration_seconds": 2.73,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.48,
      "end_seconds": 305.62,
      "duration_seconds": 2.14,
      "text": "Alright, thanks, take care."
    }
  ]
}