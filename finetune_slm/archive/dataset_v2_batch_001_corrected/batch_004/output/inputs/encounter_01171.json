      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.98,
      "end_seconds": 111.38,
      "duration_seconds": 1.4,
      "text": "alright, any smoking?"
