      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.64,
      "end_seconds": 280.01,
      "duration_seconds": 2.37,
      "text": "we'll go over that that shortly"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 284.64,
      "duration_seconds": 2.64,
      "text": "Let's move on to the examination."
    },
