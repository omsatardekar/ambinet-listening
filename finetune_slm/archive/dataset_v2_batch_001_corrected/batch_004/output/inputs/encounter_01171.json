    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.68,
      "end_seconds": 124.52,
      "duration_seconds": 3.84,
      "text": "I'll have a glass of wine with dinner"
