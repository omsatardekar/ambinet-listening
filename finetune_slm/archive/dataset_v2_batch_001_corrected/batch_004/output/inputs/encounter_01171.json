      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 74.63,
      "duration_seconds": 5.34,
      "text": "alright, did you get double vision, ringing in the ear or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.48,
      "end_seconds": 81.95,
      "duration_seconds": 5.47,
      "text": "Actually no no double vision ringing in the ear or weakness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.44,
      "end_seconds": 86.24,
      "duration_seconds": 3.8,
      "text": "mm, okay. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.91,
      "end_seconds": 88.71,
      "duration_seconds": 1.8,
