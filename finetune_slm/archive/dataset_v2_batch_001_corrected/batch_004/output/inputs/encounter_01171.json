      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.11,
      "end_seconds": 142.24,
      "duration_seconds": 4.13,
      "text": "I retired from the post office two years ago"
