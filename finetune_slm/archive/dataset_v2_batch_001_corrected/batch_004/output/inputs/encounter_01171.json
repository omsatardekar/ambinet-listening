    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.94,
      "end_seconds": 22.79,
      "duration_seconds": 8.85,
      "text": "yeah it's the room spinning when I turn over in bed i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.53,
      "end_seconds": 24.88,
      "duration_seconds": 1.35,
      "text": "since when exactly?"
