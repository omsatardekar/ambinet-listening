      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.63,
      "end_seconds": 178.66,
      "duration_seconds": 10.03,
      "text": "Okay, I can see COPD and thin bones in your file as well. Do you take any prescribed or over-the-counter medicines?"
