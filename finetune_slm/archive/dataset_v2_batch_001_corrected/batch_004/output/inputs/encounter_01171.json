      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.6,
      "end_seconds": 310.51,
      "duration_seconds": 7.91,
      "text": "when I tip you back the eyes flick for about twenty seconds and the the hearing is normal"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.18,
      "end_seconds": 312.6,
      "duration_seconds": 1.42,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.94,
      "end_seconds": 317.42,
      "duration_seconds": 2.48,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.77,
      "end_seconds": 352.03,
      "duration_seconds": 20.26,
      "text": "Having listened and examined my working impression is benign positional vertigo. It could also be a vestibular neuritis so we'll keep that open. There's nothing new for me to start or arrange today. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.11,
      "end_seconds": 355.43,
      "duration_seconds": 2.32,
      "text": "right thank you doctor goodbye"
    },
    {
      "segment_id": "SEG0051",
