      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.73,
      "end_seconds": 196.3,
      "duration_seconds": 1.57,
      "text": "for six months"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.62,
      "end_seconds": 197.71,
      "duration_seconds": 1.09,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.15,
      "end_seconds": 219.74,
      "duration_seconds": 3.59,
      "text": "alright, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.24,
      "end_seconds": 224.04,
      "duration_seconds": 2.8,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.46,
      "end_seconds": 245.38,
      "duration_seconds": 2.92,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.3,
      "end_seconds": 254.37,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.09,
      "end_seconds": 271.37,
      "duration_seconds": 5.28,
      "text": "Okay: BP is 114 over 76 oxygen saturation is 99 percent pulse 72."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.0,
      "end_seconds": 274.48,
      "duration_seconds": 1.48,
      "text": "is that normal?"
