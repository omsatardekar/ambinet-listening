      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.39,
      "end_seconds": 149.65,
      "duration_seconds": 3.26,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.83,
      "end_seconds": 156.56,
      "duration_seconds": 2.73,
      "text": "Do you have any long-term conditions?"
