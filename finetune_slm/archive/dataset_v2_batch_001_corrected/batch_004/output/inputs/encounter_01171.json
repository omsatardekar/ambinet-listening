    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.91,
      "end_seconds": 145.85,
      "duration_seconds": 2.94,
      "text": "Do you follow any particular diet?"
