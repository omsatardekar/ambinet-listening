    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.59,
      "end_seconds": 60.27,
      "duration_seconds": 23.68,
      "text": "about a four out of ten. I've also had being unsteady for a few minutes. I mean, with being unsteady for a few minutes, maybe a four out of ten on a a bad day. And I've been feeling sick as well, for about two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.36,
      "end_seconds": 64.64,
      "duration_seconds": 3.28,
      "text": "Have you had hearing loss, by any chance?"
