    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.33,
      "end_seconds": 68.19,
      "duration_seconds": 1.86,
      "text": "No. No hearing loss."
