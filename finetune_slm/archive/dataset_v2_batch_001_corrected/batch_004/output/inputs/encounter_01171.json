    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.41,
      "end_seconds": 134.49,
      "duration_seconds": 4.08,
      "text": "My husband and I live above the shop"
