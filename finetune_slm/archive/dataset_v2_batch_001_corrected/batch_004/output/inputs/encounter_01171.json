      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.03,
      "end_seconds": 128.79,
      "duration_seconds": 2.76,
      "text": "right, is there someone at home?"
