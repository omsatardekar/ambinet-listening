      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.67,
      "end_seconds": 189.37,
      "duration_seconds": 9.7,
      "text": "Tiotropium inhaler, once a day for my chest. Um, I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.06,
      "end_seconds": 193.81,
      "duration_seconds": 2.75,
      "text": "how long have you taken that?"
