      "role": "PATIENT",
      "start_seconds": 26.91,
      "end_seconds": 28.97,
      "duration_seconds": 2.06,
      "text": "about... well, two days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.02,
      "end_seconds": 34.93,
      "duration_seconds": 3.91,
      "text": "How much trouble does it it give you?"
