    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.76,
      "end_seconds": 162.28,
      "duration_seconds": 4.52,
      "text": "I've had COPD for nearly five years now"
