{
  "schema_version": "1.0",
  "encounter_id": "01041",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.51,
      "duration_seconds": 4.62,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 11.92,
      "duration_seconds": 4.54,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.96,
      "end_seconds": 19.68,
      "duration_seconds": 6.72,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.44,
      "end_seconds": 23.98,
      "duration_seconds": 3.54,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.85,
      "end_seconds": 29.48,
      "duration_seconds": 3.63,
      "text": "She's been having a sore stiff knee, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.58,
      "end_seconds": 34.53,
      "duration_seconds": 3.95,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.69,
      "end_seconds": 42.06,
      "duration_seconds": 2.37,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.09,
      "end_seconds": 51.7,
      "duration_seconds": 8.61,
      "text": "Right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.88,
      "end_seconds": 73.69,
      "duration_seconds": 18.81,
      "text": "Yes, kneeling and stairs. That makes it worse. Mild, really. It settles a little with rest. I'd say all the time. There's the knee giving way a little as well. With knee giving way a little, it feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.61,
      "end_seconds": 81.57,
      "duration_seconds": 5.96,
      "text": "Have you had a sore stiff knee before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.15,
      "end_seconds": 91.61,
      "duration_seconds": 9.46,
      "text": "Mm, yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.97,
      "end_seconds": 108.38,
      "duration_seconds": 3.41,
      "text": "Any fall, redness or locked knee at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.4,
      "end_seconds": 113.73,
      "duration_seconds": 4.33,
      "text": "No fall, redness or locked knee, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.08,
      "end_seconds": 118.41,
      "duration_seconds": 3.33,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 123.1,
      "duration_seconds": 3.48,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.6,
      "end_seconds": 132.74,
      "duration_seconds": 5.14,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.99,
      "end_seconds": 135.94,
      "duration_seconds": 1.95,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.76,
      "end_seconds": 143.31,
      "duration_seconds": 2.55,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.88,
      "end_seconds": 149.71,
      "duration_seconds": 4.83,
      "text": "Yeah, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 152.89,
      "duration_seconds": 1.97,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.53,
      "end_seconds": 157.17,
      "duration_seconds": 3.64,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.45,
      "end_seconds": 160.95,
      "duration_seconds": 2.5,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.49,
      "end_seconds": 165.39,
      "duration_seconds": 3.9,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.47,
      "end_seconds": 171.01,
      "duration_seconds": 3.54,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.04,
      "end_seconds": 175.73,
      "duration_seconds": 2.69,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.62,
      "end_seconds": 177.46,
      "duration_seconds": 0.84,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.43,
      "end_seconds": 195.33,
      "duration_seconds": 3.9,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.01,
      "end_seconds": 202.59,
      "duration_seconds": 5.58,
      "text": "Right, I'm on naproxen, 250 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.6,
      "end_seconds": 208.35,
      "duration_seconds": 4.75,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.31,
      "end_seconds": 214.29,
      "duration_seconds": 3.98,
      "text": "Mm, you know, no, it's at home."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.58,
      "end_seconds": 220.37,
      "duration_seconds": 4.79,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.85,
      "end_seconds": 224.09,
      "duration_seconds": 2.24,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.94,
      "end_seconds": 230.23,
      "duration_seconds": 3.29,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.85,
      "end_seconds": 234.56,
      "duration_seconds": 2.71,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.7,
      "end_seconds": 257.71,
      "duration_seconds": 9.01,
      "text": "The joint line is tender, there is a bit of crunching, and the knee bends to ninety degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.62,
      "end_seconds": 263.58,
      "duration_seconds": 1.96,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.5,
      "end_seconds": 298.84,
      "duration_seconds": 20.34,
      "text": "Taking everything into account, I think we're dealing with knee osteoarthritis flare at this stage. The reason I say that is that your story and my examination fit together. A meniscal tear is still possible. I'll request an X-ray of the knee, it'll help with knee pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.66,
      "end_seconds": 301.82,
      "duration_seconds": 2.16,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.74,
      "end_seconds": 333.23,
      "duration_seconds": 30.49,
      "text": "I'd like you to take paracetamol, 1 gram, four times a day, two weeks. You take it by mouth. That should help with knee pain. Strengthen the thigh muscles and lose a little weight if you can. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.78,
      "end_seconds": 335.51,
      "duration_seconds": 1.73,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.61,
      "end_seconds": 348.75,
      "duration_seconds": 12.14,
      "text": "I'd like to see you again in six weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.23,
      "end_seconds": 359.74,
      "duration_seconds": 9.51,
      "text": "So, I take the paracetamol, 1 gram, four times a day and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.79,
      "end_seconds": 365.94,
      "duration_seconds": 5.15,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.43,
      "end_seconds": 373.04,
      "duration_seconds": 3.61,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}