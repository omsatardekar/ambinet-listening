{
  "schema_version": "1.0",
  "encounter_id": "01447",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 7.51,
      "duration_seconds": 6.83,
      "text": "Hello, take a seat, I'll be with you in a second. Okay, what's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.7,
      "end_seconds": 12.81,
      "duration_seconds": 4.11,
      "text": "I'm here because of sudden shortness of breath."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.87,
      "end_seconds": 16.93,
      "duration_seconds": 3.06,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.65,
      "end_seconds": 29.15,
      "duration_seconds": 10.5,
      "text": "Um, it's been going on for six months. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.7,
      "end_seconds": 32.76,
      "duration_seconds": 2.06,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.37,
      "end_seconds": 36.93,
      "duration_seconds": 3.56,
      "text": "oh, breathing in definitely sets it off"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.41,
      "end_seconds": 45.33,
      "duration_seconds": 3.92,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.45,
      "end_seconds": 50.28,
      "duration_seconds": 3.83,
      "text": "Only sitting up, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.87,
      "end_seconds": 59.37,
      "duration_seconds": 8.5,
      "text": "Let me think, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 59.47,
      "end_seconds": 65.8,
      "duration_seconds": 6.33,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.28,
      "end_seconds": 69.45,
      "duration_seconds": 2.17,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.32,
      "end_seconds": 75.66,
      "duration_seconds": 4.34,
      "text": "oh, uh, and a swollen painful calf"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.45,
      "end_seconds": 78.51,
      "duration_seconds": 2.06,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.01,
      "end_seconds": 82.88,
      "duration_seconds": 2.87,
      "text": "Walking definitely sets it off"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 86.6,
      "duration_seconds": 2.7,
      "text": "Alright, how frequently does it come?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.41,
      "end_seconds": 91.37,
      "duration_seconds": 3.96,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.69,
      "end_seconds": 95.18,
      "duration_seconds": 2.49,
      "text": "And wheeze, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.02,
      "end_seconds": 100.23,
      "duration_seconds": 3.21,
      "text": "No, I haven't had any wheeze."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.1,
      "end_seconds": 106.2,
      "duration_seconds": 5.1,
      "text": "let me check a few things any chest tightness or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.97,
      "end_seconds": 122.41,
      "duration_seconds": 13.44,
      "text": "Mm, no, no chest tightness, no fever. I was coughing up a little blood at one point, but that that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.21,
      "end_seconds": 126.45,
      "duration_seconds": 2.24,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.0,
      "end_seconds": 130.1,
      "duration_seconds": 2.1,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.51,
      "end_seconds": 135.81,
      "duration_seconds": 4.3,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.41,
      "end_seconds": 144.5,
      "duration_seconds": 4.09,
      "text": "Let me think, no, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.07,
      "end_seconds": 151.08,
      "duration_seconds": 5.01,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.0,
      "end_seconds": 165.86,
      "duration_seconds": 12.86,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.71,
      "end_seconds": 169.24,
      "duration_seconds": 2.53,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.2,
      "end_seconds": 172.11,
      "duration_seconds": 1.91,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.34,
      "end_seconds": 189.28,
      "duration_seconds": 2.94,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.24,
      "end_seconds": 195.35,
      "duration_seconds": 2.11,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.5,
      "end_seconds": 198.68,
      "duration_seconds": 2.18,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.89,
      "end_seconds": 204.15,
      "duration_seconds": 4.26,
      "text": "I have anxiety, for about a year."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.17,
      "end_seconds": 207.12,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.76,
      "end_seconds": 215.47,
      "duration_seconds": 6.71,
      "text": "I mean, you know, it's escitalopram, 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 217.41,
      "end_seconds": 222.35,
      "duration_seconds": 4.94,
      "text": "doctor, our chart from the the last visit lists it as 20 milligrams"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.59,
      "end_seconds": 227.81,
      "duration_seconds": 4.22,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.33,
      "end_seconds": 231.92,
      "duration_seconds": 3.59,
      "text": "no, I left it at home"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.0,
      "end_seconds": 235.75,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.44,
      "end_seconds": 240.29,
      "duration_seconds": 3.85,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.39,
      "end_seconds": 244.84,
      "duration_seconds": 2.45,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.81,
      "end_seconds": 252.69,
      "duration_seconds": 5.88,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 254.15,
      "end_seconds": 262.68,
      "duration_seconds": 8.53,
      "text": "Here are the numbers, doctor. Temperature 37.4, respiratory rate 21, pressure 118 over 80. Oxygen saturation is 89 percent, pulse 84."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.24,
      "end_seconds": 275.11,
      "duration_seconds": 11.87,
      "text": "Good, thank you. Going by what you've described, this is probably a possible blood clot in the lung. I can't rule out a chest infection yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.63,
      "end_seconds": 281.19,
      "duration_seconds": 4.56,
      "text": "Um, um, will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.19,
      "end_seconds": 293.92,
      "duration_seconds": 11.73,
      "text": "I understand the worry. At the moment I'd say it's a possible blood clot in the lung, and we'll know more once the a D-dimer blood test is back"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.75,
      "end_seconds": 309.96,
      "duration_seconds": 4.21,
      "text": "Let's get a D-dimer blood test, for possible clot."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 311.67,
      "end_seconds": 315.97,
      "duration_seconds": 4.3,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.11,
      "end_seconds": 319.37,
      "duration_seconds": 2.26,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.61,
      "end_seconds": 347.98,
      "duration_seconds": 27.37,
      "text": "I'll request a CT scan of the chest, it'll help with breathlessness. You need to go to hospital now for a scan. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.88,
      "end_seconds": 350.87,
      "duration_seconds": 1.99,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.93,
      "end_seconds": 366.32,
      "duration_seconds": 14.39,
      "text": "Keep an eye out, and if you feel faint, call us the same day or go to emergency. Please come and see me straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.21,
      "end_seconds": 371.69,
      "duration_seconds": 3.48,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}