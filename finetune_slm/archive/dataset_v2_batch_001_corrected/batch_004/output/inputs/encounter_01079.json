{
  "schema_version": "1.0",
  "encounter_id": "01079",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.87,
      "duration_seconds": 4.18,
      "text": "Morning, um, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.57,
      "end_seconds": 9.86,
      "duration_seconds": 4.29,
      "text": "Alright, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.4,
      "end_seconds": 20.57,
      "duration_seconds": 10.17,
      "text": "Mainly the room spinning when I turn over in bed. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.88,
      "end_seconds": 26.4,
      "duration_seconds": 4.52,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.43,
      "end_seconds": 44.59,
      "duration_seconds": 16.16,
      "text": "Four weeks, I think... sorry, about a week, I got that wrong. I kept putting it off, which I know isn't sensible. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.02,
      "end_seconds": 55.85,
      "duration_seconds": 10.83,
      "text": "Mm, okay. So, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.59,
      "end_seconds": 74.23,
      "duration_seconds": 17.64,
      "text": "It settles a little with lying still. Yes, turning in bed and looking up. That makes it worse. It just comes and goes. I've also had being unsteady for a few minutes, since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.25,
      "end_seconds": 97.98,
      "duration_seconds": 5.73,
      "text": "Okay, have you had any hearing loss, ringing in the ear or double vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.5,
      "end_seconds": 103.34,
      "duration_seconds": 3.84,
      "text": "Yeah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.98,
      "end_seconds": 108.34,
      "duration_seconds": 3.36,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 112.74,
      "duration_seconds": 2.41,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.06,
      "end_seconds": 121.4,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.4,
      "end_seconds": 125.51,
      "duration_seconds": 3.11,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.14,
      "end_seconds": 128.43,
      "duration_seconds": 2.29,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.33,
      "end_seconds": 130.41,
      "duration_seconds": 1.08,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.14,
      "end_seconds": 133.74,
      "duration_seconds": 1.6,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.81,
      "end_seconds": 136.34,
      "duration_seconds": 1.53,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.79,
      "end_seconds": 139.0,
      "duration_seconds": 1.21,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.91,
      "end_seconds": 143.23,
      "duration_seconds": 3.32,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.04,
      "end_seconds": 146.09,
      "duration_seconds": 2.05,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.0,
      "end_seconds": 153.42,
      "duration_seconds": 5.42,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.99,
      "end_seconds": 159.32,
      "duration_seconds": 5.33,
      "text": "Have you got any known allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.81,
      "end_seconds": 164.83,
      "duration_seconds": 4.02,
      "text": "Milk. I come out in... well, stomach cramps."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.6,
      "end_seconds": 181.24,
      "duration_seconds": 3.64,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.77,
      "end_seconds": 184.35,
      "duration_seconds": 1.58,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.64,
      "end_seconds": 191.58,
      "duration_seconds": 2.94,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.86,
      "end_seconds": 204.75,
      "duration_seconds": 2.89,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.81,
      "end_seconds": 234.0,
      "duration_seconds": 10.19,
      "text": "Okay: temperature is 36.4 degrees, heart rate 83, height 166 centimetres. And pressure 126 over 81, weight 96 kilos, respiratory rate 15."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.87,
      "end_seconds": 237.57,
      "duration_seconds": 1.7,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.91,
      "end_seconds": 243.37,
      "duration_seconds": 4.46,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.38,
      "end_seconds": 249.72,
      "duration_seconds": 5.34,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.52,
      "end_seconds": 251.22,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.01,
      "end_seconds": 254.18,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.59,
      "end_seconds": 270.55,
      "duration_seconds": 6.96,
      "text": "When I tip you back, the eyes flick for about twenty seconds, and the hearing is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.18,
      "end_seconds": 274.1,
      "duration_seconds": 2.92,
      "text": "Yeah, you know, no problem."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.83,
      "end_seconds": 291.76,
      "duration_seconds": 12.93,
      "text": "All finished, thank you. Okay, thinking it through, I'd lean towards benign positional vertigo. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.6,
      "end_seconds": 300.0,
      "duration_seconds": 4.4,
      "text": "Hmm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.0,
      "end_seconds": 308.56,
      "duration_seconds": 6.56,
      "text": "Nothing I've seen today points to an emergency. It looks like benign positional vertigo."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.2,
      "end_seconds": 333.5,
      "duration_seconds": 10.3,
      "text": "I'll do a repositioning manoeuvre now and show you exercises for home. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.25,
      "end_seconds": 337.71,
      "duration_seconds": 3.46,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}