{
  "schema_version": "1.0",
  "encounter_id": "01231",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 2.88,
      "duration_seconds": 2.35,
      "text": "So, welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.81,
      "end_seconds": 6.02,
      "duration_seconds": 1.21,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 9.76,
      "duration_seconds": 3.09,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.42,
      "end_seconds": 20.24,
      "duration_seconds": 9.82,
      "text": "I wanted to get planning a trip looked at. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.8,
      "end_seconds": 24.11,
      "duration_seconds": 3.31,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.14,
      "end_seconds": 33.56,
      "duration_seconds": 8.42,
      "text": "It's alendronate, 70 milligrams, once a week. It's febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.22,
      "end_seconds": 42.94,
      "duration_seconds": 5.72,
      "text": "When did this begin? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.58,
      "end_seconds": 49.01,
      "duration_seconds": 4.43,
      "text": "Hmm, I've had it for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.94,
      "end_seconds": 53.42,
      "duration_seconds": 2.48,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.53,
      "end_seconds": 75.6,
      "duration_seconds": 19.07,
      "text": "Sorry, what was I saying, when it starts I tend to get a mild sore arm from last injection as well. So, the mild sore arm from last injection? That's been for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.42,
      "end_seconds": 83.86,
      "duration_seconds": 6.44,
      "text": "Have you had planning a trip before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.8,
      "end_seconds": 91.2,
      "duration_seconds": 5.4,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.16,
      "end_seconds": 98.65,
      "duration_seconds": 5.49,
      "text": "Let me check a few things. Any fever, rash or recent illness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.32,
      "end_seconds": 101.7,
      "duration_seconds": 2.38,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.64,
      "end_seconds": 106.26,
      "duration_seconds": 3.62,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.83,
      "end_seconds": 109.3,
      "duration_seconds": 1.47,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.09,
      "end_seconds": 113.3,
      "duration_seconds": 3.21,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.57,
      "end_seconds": 115.49,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.53,
      "end_seconds": 129.46,
      "duration_seconds": 1.93,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.56,
      "end_seconds": 134.3,
      "duration_seconds": 3.74,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.16,
      "end_seconds": 136.59,
      "duration_seconds": 1.43,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.92,
      "end_seconds": 142.13,
      "duration_seconds": 4.21,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.81,
      "end_seconds": 148.78,
      "duration_seconds": 1.97,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.05,
      "end_seconds": 154.19,
      "duration_seconds": 4.14,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.16,
      "end_seconds": 157.71,
      "duration_seconds": 2.55,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.12,
      "end_seconds": 162.19,
      "duration_seconds": 3.07,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.4,
      "end_seconds": 165.8,
      "duration_seconds": 2.4,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.63,
      "end_seconds": 169.75,
      "duration_seconds": 3.12,
      "text": "I've got thin bones. Yes, gout."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.9,
      "end_seconds": 182.04,
      "duration_seconds": 3.14,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.02,
      "end_seconds": 187.66,
      "duration_seconds": 4.64,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.5,
      "end_seconds": 192.42,
      "duration_seconds": 2.92,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 205.69,
      "duration_seconds": 2.23,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.0,
      "end_seconds": 232.31,
      "duration_seconds": 8.31,
      "text": "Okay: blood pressure 114 over 82, saturation 98 percent, pulse 71, temperature is 37.0 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.16,
      "end_seconds": 234.61,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.75,
      "end_seconds": 237.77,
      "duration_seconds": 2.02,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.2,
      "end_seconds": 243.25,
      "duration_seconds": 4.05,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.24,
      "end_seconds": 247.08,
      "duration_seconds": 1.84,
      "text": "Okay, breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.94,
      "end_seconds": 262.86,
      "duration_seconds": 3.92,
      "text": "Your temperature is normal and you look well."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.29,
      "end_seconds": 272.42,
      "duration_seconds": 7.13,
      "text": "All finished, thank you. Having listened and examined, this looks most like fit to have travel vaccinations."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.29,
      "end_seconds": 300.0,
      "duration_seconds": 9.71,
      "text": "Right, for now, no new medicines or tests are needed. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.09,
      "end_seconds": 305.5,
      "duration_seconds": 3.41,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}