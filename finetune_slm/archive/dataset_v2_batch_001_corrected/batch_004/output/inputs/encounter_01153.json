{
  "schema_version": "1.0",
  "encounter_id": "01153",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.39,
      "duration_seconds": 3.32,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 9.14,
      "duration_seconds": 3.93,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.96,
      "end_seconds": 16.47,
      "duration_seconds": 6.51,
      "text": "It's headaches in the morning. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.35,
      "end_seconds": 19.56,
      "duration_seconds": 1.21,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.76,
      "end_seconds": 26.37,
      "duration_seconds": 2.61,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.31,
      "end_seconds": 31.13,
      "duration_seconds": 2.82,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.88,
      "end_seconds": 34.59,
      "duration_seconds": 2.71,
      "text": "I, I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.18,
      "end_seconds": 35.88,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.14,
      "end_seconds": 48.56,
      "duration_seconds": 11.42,
      "text": "And there's a pounding in my ears as well, about four days now. About pounding in my ears, it happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.35,
      "end_seconds": 51.83,
      "duration_seconds": 2.48,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.23,
      "end_seconds": 65.3,
      "duration_seconds": 2.07,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.77,
      "end_seconds": 97.91,
      "duration_seconds": 13.14,
      "text": "Okay: saturation 97 percent, weight 79 kilos, height 162 centimetres, BMI works out to to 30.1, BP is 148 over 101, respiratory rate 18, heart rate 93, temperature 36.5."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.88,
      "end_seconds": 104.42,
      "duration_seconds": 3.54,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.32,
      "end_seconds": 109.03,
      "duration_seconds": 2.71,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.24,
      "end_seconds": 130.4,
      "duration_seconds": 6.16,
      "text": "Your heart sounds are normal and there is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.74,
      "end_seconds": 137.36,
      "duration_seconds": 2.62,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.54,
      "end_seconds": 159.74,
      "duration_seconds": 4.2,
      "text": "did you get chest pain, visual changes or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.06,
      "end_seconds": 164.09,
      "duration_seconds": 3.03,
      "text": "no, none that that I've noticed"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 167.39,
      "duration_seconds": 2.46,
      "text": "Right, have you had any breathlessness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.56,
      "end_seconds": 170.89,
      "duration_seconds": 2.33,
      "text": "I haven't noticed any breathlessness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.7,
      "end_seconds": 174.28,
      "duration_seconds": 1.58,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.11,
      "end_seconds": 179.01,
      "duration_seconds": 2.9,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.73,
      "end_seconds": 183.66,
      "duration_seconds": 2.93,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.8,
      "end_seconds": 189.28,
      "duration_seconds": 1.48,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.19,
      "end_seconds": 194.36,
      "duration_seconds": 4.17,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.86,
      "end_seconds": 203.69,
      "duration_seconds": 8.83,
      "text": "Uh, yes, diclofenac. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 208.37,
      "duration_seconds": 2.77,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.12,
      "end_seconds": 219.65,
      "duration_seconds": 10.53,
      "text": "I have high blood pressure, for five years. Let me think, I've had an underactive thyroid for about a year now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.15,
      "end_seconds": 221.06,
      "duration_seconds": 0.91,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.37,
      "end_seconds": 235.49,
      "duration_seconds": 10.12,
      "text": "yes, high blood pressure is known to us, good to have that clear. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.36,
      "end_seconds": 243.73,
      "duration_seconds": 7.37,
      "text": "I'm, I'm on ramipril, 5 milligrams, every morning i'm on Eltroxin, 100 micrograms, every morning"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.1,
      "end_seconds": 244.8,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.38,
      "end_seconds": 257.08,
      "duration_seconds": 3.7,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.19,
      "end_seconds": 262.2,
      "duration_seconds": 4.01,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.09,
      "end_seconds": 266.76,
      "duration_seconds": 2.67,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.07,
      "end_seconds": 272.36,
      "duration_seconds": 4.29,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.25,
      "end_seconds": 297.01,
      "duration_seconds": 6.76,
      "text": "Putting it all together, it fits best with blood pressure above target on current treatment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.38,
      "end_seconds": 301.48,
      "duration_seconds": 3.1,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.99,
      "end_seconds": 330.39,
      "duration_seconds": 28.4,
      "text": "I understand the worry. At the moment I'd say it's blood pressure above target on current treatment, and we'll know more once the an ECG is back. Let's book an ECG to look into hypertension. What I'm giving you is amlodipine, 5 milligrams, once a day, long term. You take it by mouth. That should help with blood pressure. Cut down on salty foods and keep a home blood pressure diary."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.1,
      "end_seconds": 347.08,
      "duration_seconds": 14.98,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'll want another look in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.72,
      "end_seconds": 352.12,
      "duration_seconds": 3.4,
      "text": "I think I understand everything. Thanks"
    }
  ]
}