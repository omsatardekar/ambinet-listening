{
  "schema_version": "1.0",
  "encounter_id": "01377",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.35,
      "duration_seconds": 3.6,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 8.94,
      "duration_seconds": 3.93,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.75,
      "end_seconds": 18.84,
      "duration_seconds": 8.09,
      "text": "Honestly, it's high fevers every other day, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.72,
      "end_seconds": 24.09,
      "duration_seconds": 3.37,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.95,
      "end_seconds": 33.57,
      "duration_seconds": 8.62,
      "text": "For two weeks, I'd say. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.55,
      "end_seconds": 40.34,
      "duration_seconds": 4.79,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.15,
      "end_seconds": 57.86,
      "duration_seconds": 16.71,
      "text": "Honestly, a couple of times a week. And a severe headache, too. Mm, about severe headache, it's severe, honestly. Shaking chills was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.73,
      "end_seconds": 65.3,
      "duration_seconds": 6.57,
      "text": "Have you had high fevers every other day before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.94,
      "end_seconds": 75.25,
      "duration_seconds": 8.31,
      "text": "sorry, what was I saying, a bit, last year it settled by itself back then"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.31,
      "end_seconds": 93.96,
      "duration_seconds": 2.65,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.49,
      "end_seconds": 102.09,
      "duration_seconds": 7.6,
      "text": "it's Tiotropium inhaler, once a day for my chest. It's thyroxine, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.05,
      "end_seconds": 105.4,
      "duration_seconds": 2.35,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.32,
      "end_seconds": 108.4,
      "duration_seconds": 1.08,
      "text": "75 micrograms"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.95,
      "end_seconds": 114.43,
      "duration_seconds": 5.48,
      "text": "Okay, are you allergic to to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.51,
      "end_seconds": 127.04,
      "duration_seconds": 11.53,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.86,
      "end_seconds": 132.28,
      "duration_seconds": 4.42,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.79,
      "end_seconds": 138.58,
      "duration_seconds": 4.79,
      "text": "my grandmother had dementia. My sister had breast cancer"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.11,
      "end_seconds": 142.92,
      "duration_seconds": 2.81,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.29,
      "end_seconds": 151.42,
      "duration_seconds": 7.13,
      "text": "I've had COPD for two years now i didn't wanna make a fuss, you know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.17,
      "end_seconds": 154.1,
      "duration_seconds": 0.93,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.11,
      "end_seconds": 159.61,
      "duration_seconds": 3.5,
      "text": "An underactive thyroid, for two years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.41,
      "end_seconds": 164.55,
      "duration_seconds": 4.14,
      "text": "Alright, an underactive thyroid, that matches what I have here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.62,
      "end_seconds": 187.31,
      "duration_seconds": 4.69,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.79,
      "end_seconds": 208.9,
      "duration_seconds": 20.11,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. My partner and our baby. I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.32,
      "end_seconds": 216.33,
      "duration_seconds": 4.01,
      "text": "A few quick ones: rash, cough or diarrhoea?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.62,
      "end_seconds": 222.24,
      "duration_seconds": 4.62,
      "text": "I haven't had rash, cough or diarrhoea, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.13,
      "end_seconds": 226.5,
      "duration_seconds": 3.37,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.13,
      "end_seconds": 230.29,
      "duration_seconds": 2.16,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.53,
      "end_seconds": 235.14,
      "duration_seconds": 3.61,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.58,
      "end_seconds": 239.13,
      "duration_seconds": 2.55,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.47,
      "end_seconds": 259.08,
      "duration_seconds": 4.61,
      "text": "You are hot and jaundiced, and your spleen is tender."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.47,
      "end_seconds": 276.87,
      "duration_seconds": 12.4,
      "text": "All finished, thank you. From what you've told me and what I found, I'd lean towards possible malaria after travel. I'd also keep dengue in mind."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.29,
      "end_seconds": 312.88,
      "duration_seconds": 25.59,
      "text": "I'd like to arrange blood tests for fever after travel. I think urgent blood films makes sense here, for fever after travel. You need hospital assessment today, this can become serious fast. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.9,
      "end_seconds": 316.41,
      "duration_seconds": 2.51,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.64,
      "end_seconds": 319.41,
      "duration_seconds": 1.77,
      "text": "Have a good day."
    }
  ]
}