  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 3.31,
      "duration_seconds": 2.45,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.57,
      "end_seconds": 7.19,
      "duration_seconds": 2.62,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.47,
      "end_seconds": 11.19,
      "duration_seconds": 2.72,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.34,
      "end_seconds": 15.68,
      "duration_seconds": 3.34,
      "text": "I've been dealing with no real problems"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.3,
      "end_seconds": 20.09,
      "duration_seconds": 3.79,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.58,
      "end_seconds": 23.92,
      "duration_seconds": 2.34,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.11,
      "end_seconds": 28.74,
      "duration_seconds": 3.63,
      "text": "Have you had a bit of back stiffness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.51,
      "end_seconds": 33.26,
      "duration_seconds": 2.75,
      "text": "Mm, yes, since this morning."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.06,
      "end_seconds": 50.99,
      "duration_seconds": 2.93,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.79,
      "end_seconds": 55.65,
      "duration_seconds": 3.86,
      "text": "So, I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.93,
      "end_seconds": 62.21,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.98,
      "end_seconds": 68.74,
      "duration_seconds": 4.76,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.02,
      "end_seconds": 73.76,
      "duration_seconds": 4.74,
      "text": "Sure. So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.26,
      "end_seconds": 80.07,
      "duration_seconds": 1.81,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.13,
      "end_seconds": 82.03,
      "duration_seconds": 0.9,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.22,
      "end_seconds": 86.1,
      "duration_seconds": 2.88,
      "text": "I've had heart disease, yes"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.63,
      "end_seconds": 93.69,
      "duration_seconds": 6.06,
      "text": "okay, I can see high cholesterol and heart disease in your file as well"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.55,
      "end_seconds": 110.47,
      "duration_seconds": 2.92,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.7,
      "end_seconds": 115.23,
      "duration_seconds": 1.53,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.94,
      "end_seconds": 133.68,
      "duration_seconds": 2.74,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.6,
      "end_seconds": 142.57,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.13,
      "end_seconds": 150.03,
      "duration_seconds": 2.9,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.09,
      "end_seconds": 155.32,
      "duration_seconds": 3.23,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.74,
      "end_seconds": 160.1,
      "duration_seconds": 3.36,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.14,
      "end_seconds": 163.03,
      "duration_seconds": 1.89,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.35,
      "end_seconds": 168.6,
      "duration_seconds": 4.25,
      "text": "Okay, have you had shortness of breath, by any chance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.23,
      "end_seconds": 172.06,
      "duration_seconds": 2.83,
      "text": "No. No shortness of breath."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.68,
      "end_seconds": 177.43,
      "duration_seconds": 3.75,
      "text": "and what about chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.86,
      "end_seconds": 188.31,
      "duration_seconds": 4.45,
      "text": "No chest pain or weight loss, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.27,
      "end_seconds": 193.98,
      "duration_seconds": 3.71,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.95,
      "end_seconds": 199.64,
      "duration_seconds": 1.69,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.2,
      "end_seconds": 203.58,
      "duration_seconds": 2.38,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.81,
      "end_seconds": 207.61,
      "duration_seconds": 2.8,
      "text": "Ah, no, skin's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.1,
      "end_seconds": 212.01,
      "duration_seconds": 2.91,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.17,
      "end_seconds": 221.45,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.44,
      "end_seconds": 250.29,
      "duration_seconds": 7.85,
      "text": "Okay: heart rate 83, temperature 36.6. And blood pressure 127 over 70, respiratory rate 15."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.72,
      "end_seconds": 257.8,
      "duration_seconds": 3.08,
      "text": "Okay, so is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.73,
      "end_seconds": 269.77,
      "duration_seconds": 10.04,
      "text": "I'll explain what these mean in a moment. Listening to the whole story, the most likely explanation is a healthy adult with no worrying findings."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.87,
      "end_seconds": 301.91,
      "duration_seconds": 18.04,
      "text": "A cholesterol blood test is what I'd like next, for routine check. Keep up regular exercise and a balanced diet. Come back or go to emergency straight away if new symptoms appear. I'll want another look in twelve months. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.3,
      "end_seconds": 307.34,
      "duration_seconds": 2.04,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.91,
      "end_seconds": 310.21,
      "duration_seconds": 1.3,
      "text": "see you soon"
    }
  ]
