{
  "schema_version": "1.0",
  "encounter_id": "01096",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 5.39,
      "duration_seconds": 4.77,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 12.21,
      "duration_seconds": 4.88,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.96,
      "end_seconds": 20.84,
      "duration_seconds": 3.88,
      "text": "I'm here because of dry gritty eyes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.92,
      "end_seconds": 24.35,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 28.51,
      "duration_seconds": 2.34,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.75,
      "end_seconds": 40.15,
      "duration_seconds": 10.4,
      "text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.5,
      "end_seconds": 57.66,
      "duration_seconds": 12.16,
      "text": "I'd give it a four, out of ten. Yes, air conditioning and screens. That makes it worse. Oh, and tired eyes by evening."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.58,
      "end_seconds": 62.71,
      "duration_seconds": 3.13,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.22,
      "end_seconds": 74.99,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.08,
      "end_seconds": 97.48,
      "duration_seconds": 7.4,
      "text": "Okay: saturation 99 percent, heart rate 85, temp 37.0 degrees, pressure 121 over 81."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 103.27,
      "duration_seconds": 4.0,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.51,
      "end_seconds": 107.25,
      "duration_seconds": 2.74,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.57,
      "end_seconds": 120.82,
      "duration_seconds": 5.25,
      "text": "your eyelids look slightly crusted but the white of the eye is clear"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.18,
      "end_seconds": 128.2,
      "duration_seconds": 2.02,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.63,
      "end_seconds": 140.18,
      "duration_seconds": 4.55,
      "text": "have you noticed loss of vision, redness, pain or light sensitivity?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.29,
      "end_seconds": 147.49,
      "duration_seconds": 6.2,
      "text": "I haven't had loss of vision, redness, pain or light sensitivity, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.12,
      "end_seconds": 151.92,
      "duration_seconds": 2.8,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.54,
      "end_seconds": 154.89,
      "duration_seconds": 1.35,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.85,
      "end_seconds": 160.83,
      "duration_seconds": 3.98,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.85,
      "end_seconds": 165.74,
      "duration_seconds": 2.89,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.63,
      "end_seconds": 183.91,
      "duration_seconds": 2.28,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.28,
      "end_seconds": 193.88,
      "duration_seconds": 8.6,
      "text": "I take escitalopram, 10 milligrams, once a day. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.56,
      "end_seconds": 196.85,
      "duration_seconds": 2.29,
      "text": "Right, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.95,
      "end_seconds": 202.08,
      "duration_seconds": 3.13,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.77,
      "end_seconds": 206.19,
      "duration_seconds": 2.42,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.81,
      "end_seconds": 211.27,
      "duration_seconds": 4.46,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.26,
      "end_seconds": 216.07,
      "duration_seconds": 2.81,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.59,
      "end_seconds": 221.44,
      "duration_seconds": 3.85,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.33,
      "end_seconds": 241.65,
      "duration_seconds": 4.32,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.01,
      "end_seconds": 249.9,
      "duration_seconds": 2.89,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.58,
      "end_seconds": 255.62,
      "duration_seconds": 4.04,
      "text": "Alright, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.18,
      "end_seconds": 259.97,
      "duration_seconds": 2.79,
      "text": "Anxiety, for nearly five years"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.57,
      "end_seconds": 266.19,
      "duration_seconds": 5.62,
      "text": "alright, anxiety, that matches what I have here any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.45,
      "end_seconds": 270.7,
      "duration_seconds": 3.25,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.92,
      "end_seconds": 296.76,
      "duration_seconds": 11.84,
      "text": "Okay, thinking it through, I'd lean towards dry eye disease. Take screen breaks every twenty minutes and use warm compresses on the lids. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.64,
      "end_seconds": 301.19,
      "duration_seconds": 3.55,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}