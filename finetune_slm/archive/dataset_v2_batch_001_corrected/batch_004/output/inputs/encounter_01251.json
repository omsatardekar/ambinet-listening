{
  "schema_version": "1.0",
  "encounter_id": "01251",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 5.63,
      "duration_seconds": 5.02,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 12.05,
      "duration_seconds": 5.05,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.63,
      "end_seconds": 30.36,
      "duration_seconds": 16.73,
      "text": "So, it's a sore ankle. I thought I'd wait, but it hasn't gone. My sister suggested writing things down, but I forgot. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.43,
      "end_seconds": 36.36,
      "duration_seconds": 3.93,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.8,
      "end_seconds": 47.94,
      "duration_seconds": 10.14,
      "text": "It's been going on for two months. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.52,
      "end_seconds": 55.2,
      "duration_seconds": 5.68,
      "text": "Have you had any numbness, pain in the foot or crack or pop?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.73,
      "end_seconds": 60.23,
      "duration_seconds": 3.5,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.47,
      "end_seconds": 68.43,
      "duration_seconds": 3.96,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.14,
      "end_seconds": 73.92,
      "duration_seconds": 3.78,
      "text": "Um, um, no weakness or anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.95,
      "end_seconds": 77.89,
      "duration_seconds": 2.94,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.4,
      "end_seconds": 92.83,
      "duration_seconds": 14.43,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I work in accounts at a hospital. I live with my elderly mother. I swim twice a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.41,
      "end_seconds": 116.05,
      "duration_seconds": 4.64,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.46,
      "end_seconds": 121.52,
      "duration_seconds": 3.06,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.99,
      "end_seconds": 144.48,
      "duration_seconds": 4.49,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.72,
      "end_seconds": 148.25,
      "duration_seconds": 2.53,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.06,
      "end_seconds": 151.54,
      "duration_seconds": 2.48,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.44,
      "end_seconds": 157.05,
      "duration_seconds": 3.61,
      "text": "Um, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.19,
      "end_seconds": 177.87,
      "duration_seconds": 6.68,
      "text": "Do you have any medical conditions I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.48,
      "end_seconds": 180.98,
      "duration_seconds": 1.5,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.43,
      "end_seconds": 189.1,
      "duration_seconds": 2.67,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.84,
      "end_seconds": 200.44,
      "duration_seconds": 2.6,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.08,
      "end_seconds": 223.69,
      "duration_seconds": 12.61,
      "text": "Okay: height 150 centimetres, temperature 36.5, SpO2 99 percent on room air. And BP is 113 over 76, weight 52 kilos, heart rate 70."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.33,
      "end_seconds": 228.21,
      "duration_seconds": 3.88,
      "text": "Let me think, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.84,
      "end_seconds": 232.24,
      "duration_seconds": 3.4,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.5,
      "end_seconds": 252.0,
      "duration_seconds": 6.5,
      "text": "Putting together what you've described, my working impression is a mild ankle sprain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.65,
      "end_seconds": 256.33,
      "duration_seconds": 2.68,
      "text": "Oh, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.83,
      "end_seconds": 269.51,
      "duration_seconds": 12.68,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild ankle sprain. Rest, ice, a compression bandage and keep it raised for two days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.83,
      "end_seconds": 288.26,
      "duration_seconds": 18.43,
      "text": "Understood. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Do get help quickly if you cannot put weight on it. We'll catch up if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.88,
      "end_seconds": 291.87,
      "duration_seconds": 2.99,
      "text": "So, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.47,
      "end_seconds": 294.95,
      "duration_seconds": 2.48,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.48,
      "end_seconds": 299.07,
      "duration_seconds": 3.59,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.73,
      "end_seconds": 302.1,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}