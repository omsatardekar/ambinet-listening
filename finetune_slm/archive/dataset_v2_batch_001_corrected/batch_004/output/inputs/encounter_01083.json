{
  "schema_version": "1.0",
  "encounter_id": "01083",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 6.56,
      "duration_seconds": 5.57,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 7.31,
      "end_seconds": 10.53,
      "duration_seconds": 3.22,
      "text": "doctor, thank you for seeing us"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.04,
      "end_seconds": 16.63,
      "duration_seconds": 5.59,
      "text": "That's fine, sit down. We'll go through it together. Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.95,
      "end_seconds": 25.34,
      "duration_seconds": 4.39,
      "text": "uh, a couple of times, but not recently"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.98,
      "end_seconds": 28.24,
      "duration_seconds": 2.26,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.42,
      "end_seconds": 36.79,
      "duration_seconds": 7.37,
      "text": "Honestly, it's blurred vision at times, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.79,
      "end_seconds": 40.92,
      "duration_seconds": 3.13,
      "text": "How long has it it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.68,
      "end_seconds": 54.4,
      "duration_seconds": 12.72,
      "text": "It's been three days now. Oh, and being thirsty. As for being thirsty, maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.69,
      "end_seconds": 61.77,
      "duration_seconds": 6.08,
      "text": "Have you had blurred vision at times before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.53,
      "end_seconds": 70.43,
      "duration_seconds": 6.9,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.41,
      "end_seconds": 83.45,
      "duration_seconds": 4.04,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.27,
      "end_seconds": 100.7,
      "duration_seconds": 3.43,
      "text": "that's it, just a a little longer.."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.47,
      "end_seconds": 119.57,
      "duration_seconds": 8.1,
      "text": "Okay: pressure 146 over 95, saturation 98 percent. And temperature is 37.0 degrees, pulse 82."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.12,
      "end_seconds": 123.21,
      "duration_seconds": 2.09,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.76,
      "end_seconds": 128.71,
      "duration_seconds": 1.95,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.08,
      "end_seconds": 132.7,
      "duration_seconds": 2.62,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.75,
      "end_seconds": 135.45,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.17,
      "end_seconds": 140.05,
      "duration_seconds": 2.88,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.19,
      "end_seconds": 161.64,
      "duration_seconds": 6.45,
      "text": "your weight is up a little and there are no sores on your feet"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.85,
      "end_seconds": 171.41,
      "duration_seconds": 7.56,
      "text": "okay, that's enough for me. Let me check a few things. Any abdominal pain, vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.41,
      "end_seconds": 175.83,
      "duration_seconds": 2.42,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.59,
      "end_seconds": 179.61,
      "duration_seconds": 3.02,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.87,
      "end_seconds": 187.53,
      "duration_seconds": 3.66,
      "text": "No, um, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.62,
      "end_seconds": 192.61,
      "duration_seconds": 3.99,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.7,
      "end_seconds": 195.2,
      "duration_seconds": 1.5,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.09,
      "end_seconds": 210.18,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 212.21,
      "end_seconds": 219.45,
      "duration_seconds": 7.24,
      "text": "She is on Seretide inhaler, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.53,
      "end_seconds": 239.56,
      "duration_seconds": 4.03,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.33,
      "end_seconds": 246.66,
      "duration_seconds": 6.33,
      "text": "I've got asthma. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.94,
      "end_seconds": 254.15,
      "duration_seconds": 6.21,
      "text": "Alright, asthma, that matches what I have here. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.83,
      "end_seconds": 259.42,
      "duration_seconds": 3.59,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.45,
      "end_seconds": 262.75,
      "duration_seconds": 2.3,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.73,
      "end_seconds": 269.68,
      "duration_seconds": 3.95,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.63,
      "end_seconds": 275.38,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.37,
      "end_seconds": 280.54,
      "duration_seconds": 3.17,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.34,
      "end_seconds": 284.69,
      "duration_seconds": 3.35,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 287.27,
      "end_seconds": 292.66,
      "duration_seconds": 5.39,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.49,
      "end_seconds": 296.44,
      "duration_seconds": 2.95,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.58,
      "end_seconds": 301.31,
      "duration_seconds": 3.73,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.24,
      "end_seconds": 323.85,
      "duration_seconds": 21.61,
      "text": "okay, so my impression is this: It points towards possible type 2 diabetes pending blood tests. Cut sugary drinks and walk after meals while we wait for results. I'd like you back after the results. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.34,
      "end_seconds": 331.9,
      "duration_seconds": 5.56,
      "text": "so, I come back after the results is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.9,
      "end_seconds": 337.06,
      "duration_seconds": 4.16,
      "text": "yes, exactly right that's all from me any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.61,
      "end_seconds": 342.35,
      "duration_seconds": 3.74,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}