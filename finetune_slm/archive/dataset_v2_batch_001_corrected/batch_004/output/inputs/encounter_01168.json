      "role": "PATIENT",
      "start_seconds": 4.7,
      "end_seconds": 8.91,
      "duration_seconds": 4.21,
      "text": "Hello, um, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.25,
      "end_seconds": 13.28,
      "duration_seconds": 3.03,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.35,
      "end_seconds": 25.39,
      "duration_seconds": 7.04,
      "text": "Um, so... sharp pain low on one side. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.42,
      "end_seconds": 30.88,
      "duration_seconds": 3.46,
      "text": "Time for your numbers, if that's okay."
