    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.46,
      "end_seconds": 46.3,
      "duration_seconds": 2.84,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.67,
      "end_seconds": 74.26,
      "duration_seconds": 8.59,
      "text": "Okay: pressure 134 over 73, SpO2 99 percent on room air, heart rate 109. And temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.31,
      "end_seconds": 82.54,
      "duration_seconds": 1.23,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.75,
      "end_seconds": 85.71,
      "duration_seconds": 1.96,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.29,
      "end_seconds": 90.76,
      "duration_seconds": 3.47,
      "text": "Alright, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.99,
      "end_seconds": 102.78,
      "duration_seconds": 10.79,
      "text": "Erm, um, maybe a five out of ten on a bad day. So, I've also had light vaginal bleeding."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.64,
      "end_seconds": 108.38,
      "duration_seconds": 3.74,
      "text": "Have you had any fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.92,
      "end_seconds": 112.0,
      "duration_seconds": 2.08,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.51,
      "end_seconds": 115.36,
      "duration_seconds": 2.85,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.93,
      "end_seconds": 118.61,
      "duration_seconds": 1.68,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.0,
      "end_seconds": 136.69,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.01,
      "end_seconds": 140.1,
      "duration_seconds": 2.09,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.64,
      "end_seconds": 146.54,
      "duration_seconds": 4.9,
      "text": "Okay, I can see eczema in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.33,
      "end_seconds": 162.53,
      "duration_seconds": 4.2,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.7,
      "end_seconds": 167.18,
      "duration_seconds": 3.48,
      "text": "Um, I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.89,
      "end_seconds": 170.3,
      "duration_seconds": 2.41,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.47,
      "end_seconds": 175.37,
      "duration_seconds": 3.9,
      "text": "Okay, so I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.38,
      "end_seconds": 193.72,
      "duration_seconds": 1.34,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.24,
      "end_seconds": 198.54,
      "duration_seconds": 4.3,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.82,
      "end_seconds": 207.23,
      "duration_seconds": 2.41,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.29,
      "end_seconds": 212.89,
      "duration_seconds": 4.6,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.56,
      "end_seconds": 214.94,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.68,
      "end_seconds": 218.45,
      "duration_seconds": 2.77,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.93,
      "end_seconds": 224.06,
      "duration_seconds": 4.13,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.98,
      "end_seconds": 227.03,
      "duration_seconds": 2.05,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.09,
      "end_seconds": 249.89,
      "duration_seconds": 4.8,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 276.92,
      "duration_seconds": 21.87,
      "text": "All finished, thank you. Let me tell you where I've got to. This looks most like a possible ectopic pregnancy. The reason I say that is that your story and my examination fit together. I'll request a pregnancy test, it'll help with pelvic pain and bleeding."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 278.84,
      "end_seconds": 281.69,
      "duration_seconds": 2.85,
      "text": "The earliest is Tuesday, 10 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.68,
      "end_seconds": 300.76,
      "duration_seconds": 17.08,
      "text": "You need to go to the hospital now for an emergency scan. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Come back straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.82,
      "end_seconds": 307.76,
      "duration_seconds": 4.94,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.78,
      "end_seconds": 313.7,
      "duration_seconds": 4.92,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.3,
      "end_seconds": 323.95,
      "duration_seconds": 4.65,
      "text": "Let me think, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.34,
      "end_seconds": 327.37,
      "duration_seconds": 2.03,
      "text": "Alright, goodbye for now."
    }
  ]
