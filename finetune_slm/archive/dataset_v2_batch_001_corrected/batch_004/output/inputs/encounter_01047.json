      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.65,
      "end_seconds": 309.3,
      "duration_seconds": 15.65,
      "text": "I understand the worry. At the moment I'd say it's a minor superficial burn and we'll watch how it goes. I don't need to add any tests or treatment at this point. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
