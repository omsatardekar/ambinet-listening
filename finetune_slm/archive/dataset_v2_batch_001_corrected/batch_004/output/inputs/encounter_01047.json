      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.89,
      "end_seconds": 287.57,
      "duration_seconds": 13.68,
      "text": "you can sit up now. So where does that leave us? This is probably a minor superficial burn. I want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.07,
      "end_seconds": 292.93,
      "duration_seconds": 3.86,
      "text": "what are the the odds it's serious?"
