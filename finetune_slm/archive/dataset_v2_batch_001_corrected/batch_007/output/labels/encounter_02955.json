  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I mean, I've been dealing with a chesty cough for a week. A neighbour of mine said I should see someone about it.",
