      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ah, it usually comes with bloody diarrhoea. The bloody diarrhoea? That's been for about two weeks.",
