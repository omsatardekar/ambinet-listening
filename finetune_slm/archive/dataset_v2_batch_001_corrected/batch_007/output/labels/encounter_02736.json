  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's severe tummy pain out of proportion to the examination. I thought I'd wait, but it hasn't gone. I've been reading about it online and it worried me.",
