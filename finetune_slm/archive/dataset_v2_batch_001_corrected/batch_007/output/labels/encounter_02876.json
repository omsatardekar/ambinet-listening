      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's mild, honestly.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has there been a sore throat earlier too?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, for two months.",
      "start_timestamp": "01:39",
