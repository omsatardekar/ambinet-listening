      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has anyone ever diagnosed you with something?",
      "start_timestamp": "03:22",
      "end_timestamp": "03:25",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, an irregular heartbeat.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:28",
      "supports": [
        "medical_history.past_medical_history[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, I can see an irregular heartbeat in your file as well.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:36",
      "supports": [
        "medical_history.past_medical_history[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So where does that leave us? It fits best with early Lyme disease. The reason I say that is that your story and my examination fit together.",
      "start_timestamp": "03:48",
      "end_timestamp": "04:00",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand the worry. At the moment I'd say it's early Lyme disease, and we'll watch how it goes",
      "start_timestamp": "04:08",
      "end_timestamp": "04:15",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's use doxycycline, 100 milligrams, twice a day, twenty-one days. It's for early Lyme disease. I'll put all of this in writing so you don't have to remember it.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:39",
      "supports": [
        "medications[1]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take the the doxycycline with food and avoid strong sun. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review in three weeks.",
      "start_timestamp": "04:46",
      "end_timestamp": "05:07",
      "supports": [
        "clinical_actions[1]",
        "clinical_actions[2]",
        "clinical_actions[3]",
        "clinical_actions[4]",
        "follow_up[0]"
      ]
    },
