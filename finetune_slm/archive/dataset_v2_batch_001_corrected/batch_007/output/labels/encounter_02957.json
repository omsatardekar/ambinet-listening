        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, about a week.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[1]"
      ]
    },
