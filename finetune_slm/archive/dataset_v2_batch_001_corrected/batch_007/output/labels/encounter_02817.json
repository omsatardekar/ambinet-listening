    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's the timeline, when did it begin?",
      "start_timestamp": "00:20",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I've had it since this morning.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It happens on and off. Severe, really.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, have you noticed anything else alongside it?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When it starts I tend to get a pounding in my neck as well. Oh, and my heart suddenly racing.",
