      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, actually.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been feeling lightheaded during an episode at any time before this?",
