    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. Yes, I work in a bakery, early starts. I hardly move around during the day.",
