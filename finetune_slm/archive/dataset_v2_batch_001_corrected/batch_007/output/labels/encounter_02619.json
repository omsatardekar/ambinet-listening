  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's breathlessness building over weeks, doctor. She didn't want to come, but I insisted.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "How often do you get it?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "00:37",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It happens on and off.",
      "start_timestamp": "00:53",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "How strong would you say it is?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:01",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Mostly moderate.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Have you noticed anything else alongside it?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "When it starts I tend to get a dull ache on one side of the chest as well.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "The dull ache on one side of the chest? That's been for about a week.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "How troublesome is it day to day?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'd give it a seven, out of ten.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:17",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Yes. Have you had breathlessness building over weeks before, or is this the first time?",
