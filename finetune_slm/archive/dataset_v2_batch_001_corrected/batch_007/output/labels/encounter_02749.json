      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let's talk a little about your daily life and habits.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:31",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'm a hairdresser, on my feet all day. I live with my elderly mother. I grab fast food at lunch most days.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:43",
      "supports": [
