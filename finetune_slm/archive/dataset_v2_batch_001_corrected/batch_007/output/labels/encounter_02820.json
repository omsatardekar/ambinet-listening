      "end_timestamp": "02:34",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay: temperature 37.2, respiratory rate 25, pulse is 96 beats a minute, SpO2 89 percent on room air, pressure 138 over 80.",
