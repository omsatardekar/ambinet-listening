{
  "schema_version": "1.0",
  "encounter_id": "02899",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.74,
      "duration_seconds": 4.89,
      "text": "Let me think, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 10.8,
      "duration_seconds": 3.88,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.81,
      "end_seconds": 19.54,
      "duration_seconds": 7.73,
      "text": "Hello, you know, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.48,
      "end_seconds": 24.05,
      "duration_seconds": 2.57,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.17,
      "end_seconds": 29.56,
      "duration_seconds": 4.39,
      "text": "Um, we came because of sneezing in spring."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.4,
      "end_seconds": 34.3,
      "duration_seconds": 2.9,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.71,
      "end_seconds": 45.7,
      "duration_seconds": 6.99,
      "text": "Um, around three weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.98,
      "end_seconds": 48.91,
      "duration_seconds": 2.93,
      "text": "Right, right. What brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.23,
      "end_seconds": 52.29,
      "duration_seconds": 2.06,
      "text": "It's worse with pollen."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.08,
      "end_seconds": 57.96,
      "duration_seconds": 3.88,
      "text": "Has there been a runny itchy nose too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.49,
      "end_seconds": 69.48,
      "duration_seconds": 10.99,
      "text": "Yes, uh, actually. I've also had watery eyes, for ten days. As for watery eyes, it feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.04,
      "end_seconds": 80.36,
      "duration_seconds": 3.32,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.67,
      "end_seconds": 89.8,
      "duration_seconds": 2.13,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.08,
      "end_seconds": 111.81,
      "duration_seconds": 10.73,
      "text": "Okay: temp 36.8 degrees, respiratory rate 18, pulse 69, SpO2 98 percent on room air, blood pressure 124 over 82."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.31,
      "end_seconds": 119.7,
      "duration_seconds": 5.39,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.76,
      "end_seconds": 122.03,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.25,
      "end_seconds": 137.11,
      "duration_seconds": 5.86,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.64,
      "end_seconds": 149.39,
      "duration_seconds": 6.75,
      "text": "Good, you can sit up again. Any loss of smell, facial pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.05,
      "end_seconds": 156.43,
      "duration_seconds": 5.38,
      "text": "No, um, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.21,
      "end_seconds": 159.39,
      "duration_seconds": 2.18,
      "text": "Did you notice any wheeze?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.39,
      "end_seconds": 164.87,
      "duration_seconds": 1.48,
      "text": "Definitely no wheeze."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.36,
      "end_seconds": 169.73,
      "duration_seconds": 3.37,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.3,
      "end_seconds": 172.46,
      "duration_seconds": 2.16,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.07,
      "end_seconds": 176.89,
      "duration_seconds": 2.82,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.61,
      "end_seconds": 181.43,
      "duration_seconds": 2.82,
      "text": "Yeah, no, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.79,
      "end_seconds": 187.88,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.44,
      "end_seconds": 192.13,
      "duration_seconds": 3.69,
      "text": "It's fluoxetine, 20 milligrams, every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.95,
      "end_seconds": 205.32,
      "duration_seconds": 3.37,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.42,
      "end_seconds": 218.57,
      "duration_seconds": 12.15,
      "text": "I swim twice a week. My partner and our baby. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.46,
      "end_seconds": 225.69,
      "duration_seconds": 6.23,
      "text": "Has anyone ever diagnosed you with something? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.28,
      "end_seconds": 234.95,
      "duration_seconds": 3.67,
      "text": "I've had depression for two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.65,
      "end_seconds": 236.57,
      "duration_seconds": 0.92,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.71,
      "end_seconds": 240.08,
      "duration_seconds": 2.37,
      "text": "I've, I've got anxiety."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.15,
      "end_seconds": 250.41,
      "duration_seconds": 8.26,
      "text": "Right, right. Right, so depression and anxiety are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.99,
      "end_seconds": 265.38,
      "duration_seconds": 2.39,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.89,
      "end_seconds": 277.5,
      "duration_seconds": 11.61,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.98,
      "end_seconds": 286.91,
      "duration_seconds": 3.93,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.55,
      "end_seconds": 290.75,
      "duration_seconds": 2.2,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.98,
      "end_seconds": 296.84,
      "duration_seconds": 4.86,
      "text": "Okay, thinking it through, my working impression is seasonal allergic rhinitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.77,
      "end_seconds": 305.05,
      "duration_seconds": 4.28,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.09,
      "end_seconds": 320.6,
      "duration_seconds": 14.51,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal allergic rhinitis. I'm prescribing fluticasone nasal spray, 50 micrograms, once a day, the season. That's for hay fever."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.68,
      "end_seconds": 323.8,
      "duration_seconds": 1.12,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.42,
      "end_seconds": 337.98,
      "duration_seconds": 13.56,
      "text": "Shower after being outdoors and keep windows shut when pollen is high. I'd like to see you again if not better in a month. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.7,
      "end_seconds": 343.68,
      "duration_seconds": 3.98,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}