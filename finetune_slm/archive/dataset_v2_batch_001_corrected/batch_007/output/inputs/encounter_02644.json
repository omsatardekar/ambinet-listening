{
  "schema_version": "1.0",
  "encounter_id": "02644",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 2.53,
      "duration_seconds": 1.65,
      "text": "evening let's get started"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.02,
      "end_seconds": 8.32,
      "duration_seconds": 4.3,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.16,
      "end_seconds": 13.56,
      "duration_seconds": 4.4,
      "text": "Good, that'll be useful. Pull up a chair. What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.9,
      "end_seconds": 19.29,
      "duration_seconds": 4.39,
      "text": "she's been having breathlessness building over weeks, doctor"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.39,
      "end_seconds": 22.48,
      "duration_seconds": 2.09,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.53,
      "end_seconds": 30.94,
      "duration_seconds": 6.41,
      "text": "Let me think, I'd say ten days. Actually, no, closer to two days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.63,
      "end_seconds": 36.53,
      "duration_seconds": 3.9,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 46.17,
      "duration_seconds": 8.6,
      "text": "It's severe, honestly. A dry cough was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.21,
      "end_seconds": 53.64,
      "duration_seconds": 6.43,
      "text": "Have you had breathlessness building over weeks before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.67,
      "end_seconds": 60.86,
      "duration_seconds": 6.19,
      "text": "I had a similar thing a couple of years ago it went away"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.8,
      "end_seconds": 74.12,
      "duration_seconds": 7.32,
      "text": "Let me check a few things. Any coughing up blood, night sweats, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.4,
      "end_seconds": 81.12,
      "duration_seconds": 2.72,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.77,
      "end_seconds": 86.6,
      "duration_seconds": 3.83,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.56,
      "end_seconds": 90.68,
      "duration_seconds": 2.12,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.38,
      "end_seconds": 95.09,
      "duration_seconds": 2.71,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.91,
      "end_seconds": 97.94,
      "duration_seconds": 1.03,
      "text": "yes, COPD"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.48,
      "end_seconds": 118.92,
      "duration_seconds": 2.44,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.88,
      "end_seconds": 124.65,
      "duration_seconds": 3.77,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 128.78,
      "duration_seconds": 2.13,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.66,
      "end_seconds": 136.33,
      "duration_seconds": 5.67,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.98,
      "end_seconds": 140.04,
      "duration_seconds": 2.06,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.96,
      "end_seconds": 144.81,
      "duration_seconds": 2.85,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.93,
      "end_seconds": 151.09,
      "duration_seconds": 5.16,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.92,
      "end_seconds": 158.55,
      "duration_seconds": 6.63,
      "text": "Yeah, not currently, but as a youngster trimethoprim gave me a rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.21,
      "end_seconds": 161.86,
      "duration_seconds": 2.65,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.28,
      "end_seconds": 164.92,
      "duration_seconds": 1.64,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.1,
      "end_seconds": 168.55,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.42,
      "end_seconds": 181.38,
      "duration_seconds": 2.96,
      "text": "nearly done with the the readings.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.99,
      "end_seconds": 209.29,
      "duration_seconds": 8.3,
      "text": "Okay: respiratory rate 22, temp 36.9 degrees, pulse 94, blood pressure 138 over 78, oxygen saturation is 89 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.68,
      "end_seconds": 215.54,
      "duration_seconds": 4.86,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.77,
      "end_seconds": 232.27,
      "duration_seconds": 1.5,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.09,
      "end_seconds": 236.54,
      "duration_seconds": 2.45,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.52,
      "end_seconds": 250.1,
      "duration_seconds": 5.58,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.42,
      "end_seconds": 270.33,
      "duration_seconds": 14.91,
      "text": "Right, you can sit up now. Taking everything into account, it's hard to say. A pleural effusion needing a cause is one possibility and an infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.07,
      "end_seconds": 294.97,
      "duration_seconds": 8.9,
      "text": "Let's book a CT scan of the chest to look into pleural effusion. I am arranging an urgent chest clinic review."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.36,
      "end_seconds": 313.78,
      "duration_seconds": 18.42,
      "text": "Right, right. A short walk every day, even twenty minutes, will help more than you'd think. Come back or go to emergency straight away if the symptoms get worse. Let's review you after the scan. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.72,
      "end_seconds": 320.32,
      "duration_seconds": 4.6,
      "text": "okay, you know, that makes sense. Thanks for explaining"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.4,
      "end_seconds": 324.1,
      "duration_seconds": 1.7,
      "text": "Have a good day."
    }
  ]
}