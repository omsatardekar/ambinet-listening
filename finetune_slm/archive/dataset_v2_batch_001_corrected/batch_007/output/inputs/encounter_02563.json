{
  "schema_version": "1.0",
  "encounter_id": "02563",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 3.6,
      "duration_seconds": 3.09,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.32,
      "end_seconds": 6.32,
      "duration_seconds": 1.0,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.16,
      "end_seconds": 12.23,
      "duration_seconds": 5.07,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.99,
      "end_seconds": 20.87,
      "duration_seconds": 6.88,
      "text": "Good, that'll be useful. Pull up a chair. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.58,
      "end_seconds": 26.58,
      "duration_seconds": 5.0,
      "text": "Um, so... being thirsty. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.24,
      "end_seconds": 30.55,
      "duration_seconds": 2.31,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.28,
      "end_seconds": 34.03,
      "duration_seconds": 2.75,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.94,
      "end_seconds": 41.69,
      "duration_seconds": 2.75,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.25,
      "end_seconds": 59.01,
      "duration_seconds": 16.76,
      "text": "I mean, pretty severe, if I'm being honest. As for aching bones, I honestly can't say when that began. It might have been last month or the month before. And constipation as well, since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.32,
      "end_seconds": 63.97,
      "duration_seconds": 3.65,
      "text": "Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.1,
      "end_seconds": 73.64,
      "duration_seconds": 8.54,
      "text": "Maybe a five out of ten on a bad day. I've been passing kidney stones too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.45,
      "end_seconds": 78.74,
      "duration_seconds": 3.29,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.74,
      "end_seconds": 82.75,
      "duration_seconds": 2.01,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.71,
      "end_seconds": 87.59,
      "duration_seconds": 3.88,
      "text": "Right, have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.84,
      "end_seconds": 90.41,
      "duration_seconds": 1.57,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 94.12,
      "duration_seconds": 2.89,
      "text": "Any weight loss, low mood or fractures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.65,
      "end_seconds": 100.91,
      "duration_seconds": 5.26,
      "text": "I haven't had weight loss, low mood or fractures, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.31,
      "end_seconds": 108.9,
      "duration_seconds": 3.59,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.64,
      "end_seconds": 113.02,
      "duration_seconds": 2.38,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.64,
      "end_seconds": 116.46,
      "duration_seconds": 2.82,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.5,
      "end_seconds": 121.19,
      "duration_seconds": 2.69,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.24,
      "end_seconds": 129.15,
      "duration_seconds": 5.91,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.06,
      "end_seconds": 140.22,
      "duration_seconds": 5.16,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.43,
      "end_seconds": 143.15,
      "duration_seconds": 1.72,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.46,
      "end_seconds": 148.42,
      "duration_seconds": 3.96,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.37,
      "end_seconds": 151.68,
      "duration_seconds": 1.31,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.64,
      "end_seconds": 156.63,
      "duration_seconds": 3.99,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.99,
      "end_seconds": 174.7,
      "duration_seconds": 2.71,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.54,
      "end_seconds": 181.97,
      "duration_seconds": 5.43,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.06,
      "end_seconds": 200.68,
      "duration_seconds": 3.62,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.86,
      "end_seconds": 210.81,
      "duration_seconds": 8.95,
      "text": "I have eczema. Acid reflux, for about a year. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.21,
      "end_seconds": 213.9,
      "duration_seconds": 1.69,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.9,
      "end_seconds": 220.57,
      "duration_seconds": 1.67,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.37,
      "end_seconds": 228.85,
      "duration_seconds": 7.48,
      "text": "Right, right. Okay, I can see eczema and acid reflux in your file as well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.66,
      "end_seconds": 250.83,
      "duration_seconds": 3.17,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.14,
      "end_seconds": 267.5,
      "duration_seconds": 15.36,
      "text": "Hydrocortisone cream, when needed. Omeprazole, 20 milligrams, once a day for the reflux. A neighbour of mine said I should see someone about it. Metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 269.17,
      "end_seconds": 279.17,
      "duration_seconds": 10.0,
      "text": "Doctor, I think the last prescription for the metoprolol was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.73,
      "end_seconds": 283.55,
      "duration_seconds": 2.82,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.14,
      "end_seconds": 294.39,
      "duration_seconds": 8.25,
      "text": "No, I left it at home. I had aspirin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 296.13,
      "end_seconds": 311.57,
      "duration_seconds": 15.44,
      "text": "Doctor, I've got the readings for you. Height 157 centimetres, SpO2 99 percent on room air, weight 90 kilos. BP is 125 over 70, pulse is 69 beats a minute, temp 36.5 degrees, BMI works out to 36.5."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.29,
      "end_seconds": 314.21,
      "duration_seconds": 1.92,
      "text": "So, good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.94,
      "end_seconds": 319.64,
      "duration_seconds": 3.7,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.79,
      "end_seconds": 325.49,
      "duration_seconds": 1.7,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.49,
      "end_seconds": 329.22,
      "duration_seconds": 2.73,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.13,
      "end_seconds": 344.05,
      "duration_seconds": 5.92,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.27,
      "end_seconds": 368.54,
      "duration_seconds": 22.27,
      "text": "Right, you can relax now. Taking everything into account, I think we're dealing with possible raised calcium from an overactive parathyroid at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep vitamin D excess in mind."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.96,
      "end_seconds": 372.7,
      "duration_seconds": 2.74,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.29,
      "end_seconds": 393.46,
      "duration_seconds": 19.17,
      "text": "I can't promise yet, but most people with possible raised calcium from an overactive parathyroid do well once it's treated properly. I'll request a kidney ultrasound, it'll help with kidney stones. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.48,
      "end_seconds": 395.57,
      "duration_seconds": 1.09,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.27,
      "end_seconds": 419.48,
      "duration_seconds": 23.21,
      "text": "We should do a bone density scan for possible hyperparathyroidism. I'll request a calcium and parathyroid hormone test, it'll help with kidney stones. Drink plenty of water and avoid calcium supplements until the results. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 420.53,
      "end_seconds": 422.64,
      "duration_seconds": 2.11,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.18,
      "end_seconds": 429.81,
      "duration_seconds": 6.63,
      "text": "Do get help quickly if the symptoms get worse. Let's review you after the results."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.85,
      "end_seconds": 434.69,
      "duration_seconds": 2.84,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 436.65,
      "end_seconds": 439.47,
      "duration_seconds": 2.82,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 441.14,
      "end_seconds": 445.07,
      "duration_seconds": 3.93,
      "text": "Uh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 447.11,
      "end_seconds": 448.33,
      "duration_seconds": 1.22,
      "text": "All the best."
    }
  ]
}