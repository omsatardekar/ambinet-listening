{
  "schema_version": "1.0",
  "encounter_id": "02624",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 3.0,
      "duration_seconds": 1.66,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.85,
      "end_seconds": 9.03,
      "duration_seconds": 5.18,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.67,
      "end_seconds": 17.2,
      "duration_seconds": 6.53,
      "text": "um, um, so... a rolled ankle that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.87,
      "end_seconds": 22.49,
      "duration_seconds": 3.62,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.07,
      "end_seconds": 30.61,
      "duration_seconds": 6.54,
      "text": "it started yesterday my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.86,
      "end_seconds": 32.76,
      "duration_seconds": 1.9,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.16,
      "end_seconds": 44.51,
      "duration_seconds": 10.35,
      "text": "So, and some swelling as well, since this morning. As for swelling, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.12,
      "end_seconds": 51.51,
      "duration_seconds": 3.39,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.56,
      "end_seconds": 64.15,
      "duration_seconds": 10.59,
      "text": "I'm a hairdresser, on my feet all day. Lots of rice, lentils and some fruit. My partner and our baby."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 69.27,
      "duration_seconds": 3.71,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.01,
      "end_seconds": 73.48,
      "duration_seconds": 2.47,
      "text": "Right, no, nothing at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.2,
      "end_seconds": 93.72,
      "duration_seconds": 4.52,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.32,
      "end_seconds": 98.21,
      "duration_seconds": 3.89,
      "text": "No, you know, not that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.91,
      "end_seconds": 114.62,
      "duration_seconds": 2.71,
      "text": "so, any regular medication at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.48,
      "end_seconds": 120.35,
      "duration_seconds": 3.87,
      "text": "Hmm, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.33,
      "end_seconds": 128.69,
      "duration_seconds": 2.36,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 135.04,
      "duration_seconds": 4.7,
      "text": "Um, just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 143.21,
      "duration_seconds": 6.66,
      "text": "Did you get pain in the foot, pain in the shin, pop or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.7,
      "end_seconds": 151.51,
      "duration_seconds": 6.81,
      "text": "No, no pain in the foot, pain in the shin, pop or numbness."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.21,
      "end_seconds": 157.69,
      "duration_seconds": 4.48,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.77,
      "end_seconds": 160.76,
      "duration_seconds": 1.99,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.98,
      "end_seconds": 164.6,
      "duration_seconds": 2.62,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.16,
      "end_seconds": 168.53,
      "duration_seconds": 2.37,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.84,
      "end_seconds": 187.25,
      "duration_seconds": 3.41,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 197.78,
      "duration_seconds": 2.14,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.58,
      "end_seconds": 225.23,
      "duration_seconds": 13.65,
      "text": "Okay: temperature 36.7, BMI works out to 31.4. And saturation 97 percent, pulse is 64 beats a minute, weight 94 kilos, blood pressure 116 over 79, height 173 centimetres."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 230.43,
      "duration_seconds": 3.27,
      "text": "let's move on to the the examination"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.68,
      "end_seconds": 234.58,
      "duration_seconds": 0.9,
      "text": "of course"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 238.03,
      "duration_seconds": 2.15,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.12,
      "end_seconds": 257.16,
      "duration_seconds": 9.04,
      "text": "There is mild swelling over the the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.73,
      "end_seconds": 263.13,
      "duration_seconds": 2.4,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.51,
      "end_seconds": 284.14,
      "duration_seconds": 5.63,
      "text": "okay, so my impression is this: It points towards a mild ankle sprain"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.64,
      "end_seconds": 287.59,
      "duration_seconds": 2.95,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.38,
      "end_seconds": 310.52,
      "duration_seconds": 18.14,
      "text": "I understand the worry. At the moment I'd say it's a mild ankle sprain, and we'll watch how it goes. Stop me if I've got anything wrong. You've had a rolled ankle, yesterday, and no pain in the shin or pain in the foot."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.23,
      "end_seconds": 313.21,
      "duration_seconds": 1.98,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.86,
      "end_seconds": 324.24,
      "duration_seconds": 9.38,
      "text": "rest, ice, compression and elevation, then gradual strengthening if the symptoms get worse, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.32,
      "end_seconds": 326.31,
      "duration_seconds": 0.99,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.99,
      "end_seconds": 334.6,
      "duration_seconds": 7.61,
      "text": "I'll want another look if not better in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.51,
      "end_seconds": 340.04,
      "duration_seconds": 3.53,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}