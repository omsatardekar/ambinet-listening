{
  "schema_version": "1.0",
  "encounter_id": "02762",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.03,
      "duration_seconds": 2.83,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 11.53,
      "duration_seconds": 5.73,
      "text": "Right, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.62,
      "end_seconds": 18.07,
      "duration_seconds": 5.45,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.49,
      "end_seconds": 29.25,
      "duration_seconds": 4.76,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.29,
      "end_seconds": 37.75,
      "duration_seconds": 6.46,
      "text": "Ah, honestly, it's difficulty concentrating, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.59,
      "end_seconds": 42.79,
      "duration_seconds": 3.2,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.28,
      "end_seconds": 48.32,
      "duration_seconds": 4.04,
      "text": "Erm, it's been about four days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.54,
      "end_seconds": 52.3,
      "duration_seconds": 2.76,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.43,
      "end_seconds": 59.71,
      "duration_seconds": 2.28,
      "text": "It usually comes with impatience."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.5,
      "end_seconds": 62.62,
      "duration_seconds": 2.12,
      "text": "Has there been restlessness too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.3,
      "end_seconds": 74.91,
      "duration_seconds": 6.61,
      "text": "Yeah. Ten days, I'd say. The impatience? That's been for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.11,
      "end_seconds": 87.42,
      "duration_seconds": 6.31,
      "text": "Let me check a few things. Any low mood, thoughts of self-harm or drug use?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.25,
      "end_seconds": 93.74,
      "duration_seconds": 4.49,
      "text": "Um, no, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.49,
      "end_seconds": 100.84,
      "duration_seconds": 1.35,
      "text": "Any head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.51,
      "end_seconds": 103.43,
      "duration_seconds": 1.92,
      "text": "No. No head injury."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.52,
      "end_seconds": 106.18,
      "duration_seconds": 1.66,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.79,
      "end_seconds": 108.86,
      "duration_seconds": 2.07,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 114.41,
      "duration_seconds": 4.48,
      "text": "So, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.16,
      "end_seconds": 116.59,
      "duration_seconds": 1.43,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.87,
      "end_seconds": 120.98,
      "duration_seconds": 3.11,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.85,
      "end_seconds": 135.28,
      "duration_seconds": 12.43,
      "text": "I'm vegetarian and have been for years. Yes, I work in a bakery, early starts. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.01,
      "end_seconds": 154.28,
      "duration_seconds": 2.27,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.2,
      "end_seconds": 157.7,
      "duration_seconds": 2.5,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.21,
      "end_seconds": 162.62,
      "duration_seconds": 4.41,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.67,
      "end_seconds": 166.33,
      "duration_seconds": 1.66,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.18,
      "end_seconds": 170.27,
      "duration_seconds": 3.09,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.65,
      "end_seconds": 176.57,
      "duration_seconds": 4.92,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.62,
      "end_seconds": 181.62,
      "duration_seconds": 4.0,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.13,
      "end_seconds": 184.89,
      "duration_seconds": 2.76,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.34,
      "end_seconds": 203.79,
      "duration_seconds": 4.45,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.47,
      "end_seconds": 207.39,
      "duration_seconds": 2.92,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.74,
      "end_seconds": 211.18,
      "duration_seconds": 2.44,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.92,
      "end_seconds": 227.98,
      "duration_seconds": 3.06,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.24,
      "end_seconds": 245.01,
      "duration_seconds": 7.77,
      "text": "Okay: saturation 97 percent, pressure 121 over 81. And pulse is 77 beats a minute, temperature 37.0."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.88,
      "end_seconds": 248.38,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.34,
      "end_seconds": 252.21,
      "duration_seconds": 2.87,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.63,
      "end_seconds": 258.11,
      "duration_seconds": 3.48,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.99,
      "end_seconds": 261.1,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.88,
      "end_seconds": 265.06,
      "duration_seconds": 2.18,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.19,
      "end_seconds": 280.99,
      "duration_seconds": 4.8,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.03,
      "end_seconds": 283.17,
      "duration_seconds": 1.14,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.83,
      "end_seconds": 300.87,
      "duration_seconds": 13.04,
      "text": "Good, you can sit up again. So, based on the history and the examination, I can't pin this down yet. We're looking at possible adult attention deficit disorder or thyroid problems."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.99,
      "end_seconds": 340.27,
      "duration_seconds": 21.28,
      "text": "We should do a thyroid test for poor concentration. I'm sending you for a questionnaire because of attention problems. Use lists and reminders while we arrange the specialist assessment. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.82,
      "end_seconds": 343.35,
      "duration_seconds": 2.53,
      "text": "Alright, you know, I follow."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.5,
      "end_seconds": 348.1,
      "duration_seconds": 3.6,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.06,
      "end_seconds": 352.12,
      "duration_seconds": 2.06,
      "text": "Alright, thanks, take care."
    }
  ]
}