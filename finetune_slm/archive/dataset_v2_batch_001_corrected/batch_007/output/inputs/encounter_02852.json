{
  "schema_version": "1.0",
  "encounter_id": "02852",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 6.69,
      "duration_seconds": 5.89,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.18,
      "duration_seconds": 3.85,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.79,
      "end_seconds": 22.16,
      "duration_seconds": 9.37,
      "text": "Hmm, mainly a severe headache. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.99,
      "end_seconds": 25.63,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.46,
      "end_seconds": 37.26,
      "duration_seconds": 2.8,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.74,
      "end_seconds": 55.42,
      "duration_seconds": 8.68,
      "text": "Okay: temperature 37.0, saturation 97 percent, pulse is 93 beats a minute, BP is 168 over 95."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.1,
      "end_seconds": 59.48,
      "duration_seconds": 2.38,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.05,
      "end_seconds": 68.8,
      "duration_seconds": 7.75,
      "text": "I'll explain what these mean in a moment. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.46,
      "end_seconds": 73.35,
      "duration_seconds": 2.89,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.16,
      "end_seconds": 77.09,
      "duration_seconds": 2.93,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.77,
      "end_seconds": 83.14,
      "duration_seconds": 5.37,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.33,
      "end_seconds": 87.05,
      "duration_seconds": 2.72,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.98,
      "end_seconds": 91.09,
      "duration_seconds": 2.11,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.49,
      "end_seconds": 95.64,
      "duration_seconds": 3.15,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.63,
      "end_seconds": 105.98,
      "duration_seconds": 8.35,
      "text": "It usually comes with swollen face and hands. The swollen face and hands? That's been for one week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.97,
      "end_seconds": 113.93,
      "duration_seconds": 5.96,
      "text": "Have you had any reduced baby movements, vaginal bleeding or leaking fluid?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.15,
      "end_seconds": 118.66,
      "duration_seconds": 3.51,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.91,
      "end_seconds": 125.58,
      "duration_seconds": 2.67,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.46,
      "end_seconds": 129.93,
      "duration_seconds": 3.47,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.83,
      "end_seconds": 135.14,
      "duration_seconds": 3.31,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.95,
      "end_seconds": 141.87,
      "duration_seconds": 3.92,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 145.53,
      "duration_seconds": 2.35,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.45,
      "end_seconds": 152.58,
      "duration_seconds": 3.13,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.16,
      "end_seconds": 155.15,
      "duration_seconds": 1.99,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.76,
      "end_seconds": 160.72,
      "duration_seconds": 3.96,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.03,
      "end_seconds": 164.24,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.88,
      "end_seconds": 168.56,
      "duration_seconds": 3.68,
      "text": "I take sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.21,
      "end_seconds": 188.42,
      "duration_seconds": 2.21,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.49,
      "end_seconds": 196.64,
      "duration_seconds": 6.15,
      "text": "Migraines, for five years. I have eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.55,
      "end_seconds": 203.9,
      "duration_seconds": 4.35,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.99,
      "end_seconds": 217.07,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.29,
      "end_seconds": 221.69,
      "duration_seconds": 3.4,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.07,
      "end_seconds": 244.96,
      "duration_seconds": 4.89,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.06,
      "end_seconds": 247.09,
      "duration_seconds": 1.03,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.81,
      "end_seconds": 260.37,
      "duration_seconds": 8.56,
      "text": "All finished, thank you. Taking everything into account, this is probably severe pre-eclampsia. A migraine is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.08,
      "end_seconds": 266.25,
      "duration_seconds": 5.17,
      "text": "Let me think, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.03,
      "end_seconds": 283.08,
      "duration_seconds": 16.05,
      "text": "I understand the worry. At the moment I'd say it's severe pre-eclampsia, and we'll know more once the urgent blood tests is back. Urgent blood tests is what I'd like next, for pre-eclampsia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.6,
      "end_seconds": 285.78,
      "duration_seconds": 2.18,
      "text": "Right, you know, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.98,
      "end_seconds": 311.34,
      "duration_seconds": 24.36,
      "text": "A urine protein test is what I'd like next, for pre-eclampsia. The treatment will be labetalol, 200 milligrams, once now, single dose. That's for severe hypertension. You need to go to the maternity unit straight away. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'll also refer you to the obstetric team."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.41,
      "end_seconds": 313.11,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.82,
      "end_seconds": 320.42,
      "duration_seconds": 6.6,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.38,
      "end_seconds": 323.56,
      "duration_seconds": 2.18,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.71,
      "end_seconds": 326.98,
      "duration_seconds": 2.27,
      "text": "See me again straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.6,
      "end_seconds": 329.54,
      "duration_seconds": 1.94,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.49,
      "end_seconds": 334.66,
      "duration_seconds": 3.17,
      "text": "So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.84,
      "end_seconds": 343.38,
      "duration_seconds": 3.54,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}