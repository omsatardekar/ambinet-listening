{
  "schema_version": "1.0",
  "encounter_id": "02840",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.68,
      "duration_seconds": 3.86,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.7,
      "end_seconds": 15.14,
      "duration_seconds": 4.44,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.47,
      "end_seconds": 22.02,
      "duration_seconds": 5.55,
      "text": "Um, you know, so... a postnasal drip. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.82,
      "end_seconds": 25.56,
      "duration_seconds": 2.74,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.0,
      "end_seconds": 35.07,
      "duration_seconds": 2.07,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.49,
      "end_seconds": 59.49,
      "duration_seconds": 14.0,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 15, pulse is 75 beats a minute, blood pressure 125 over 73. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.28,
      "end_seconds": 65.28,
      "duration_seconds": 5.0,
      "text": "Around five days... no wait, it's more like two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.86,
      "end_seconds": 69.93,
      "duration_seconds": 3.07,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.82,
      "end_seconds": 79.39,
      "duration_seconds": 8.57,
      "text": "It's, It's severe, honestly. I've, I've been losing my sense of smell too, for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.58,
      "end_seconds": 84.06,
      "duration_seconds": 3.48,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.43,
      "end_seconds": 91.29,
      "duration_seconds": 5.86,
      "text": "I'd call it severe. There's a dull pressure over my face as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.98,
      "end_seconds": 96.99,
      "duration_seconds": 4.01,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.83,
      "end_seconds": 101.92,
      "duration_seconds": 4.09,
      "text": "Well, a five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.01,
      "end_seconds": 104.93,
      "duration_seconds": 1.92,
      "text": "Okay, how about nosebleeds?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.7,
      "end_seconds": 109.53,
      "duration_seconds": 2.83,
      "text": "Not at all, no nosebleeds."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.79,
      "end_seconds": 113.96,
      "duration_seconds": 4.17,
      "text": "Right, right. Any vision changes or fever at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.74,
      "end_seconds": 119.66,
      "duration_seconds": 3.92,
      "text": "I mean, um, none of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.01,
      "end_seconds": 122.36,
      "duration_seconds": 1.35,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.17,
      "end_seconds": 129.39,
      "duration_seconds": 3.22,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.4,
      "end_seconds": 133.71,
      "duration_seconds": 3.31,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.59,
      "end_seconds": 138.87,
      "duration_seconds": 3.28,
      "text": "Ah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.35,
      "end_seconds": 152.66,
      "duration_seconds": 4.31,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.02,
      "end_seconds": 155.61,
      "duration_seconds": 1.59,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.79,
      "end_seconds": 173.95,
      "duration_seconds": 3.16,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.56,
      "end_seconds": 177.35,
      "duration_seconds": 1.79,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.91,
      "end_seconds": 181.86,
      "duration_seconds": 2.95,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.25,
      "end_seconds": 192.18,
      "duration_seconds": 8.93,
      "text": "I mean, I have asthma, for nearly five years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.54,
      "end_seconds": 197.39,
      "duration_seconds": 3.85,
      "text": "Right, right. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.67,
      "end_seconds": 203.52,
      "duration_seconds": 4.85,
      "text": "Oh, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.49,
      "end_seconds": 208.23,
      "duration_seconds": 2.74,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.32,
      "end_seconds": 223.5,
      "duration_seconds": 13.18,
      "text": "I only drink at family occasions. No, I've never smoked in my life. I do a yoga class on Thursdays. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.43,
      "end_seconds": 229.0,
      "duration_seconds": 3.57,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.57,
      "end_seconds": 237.68,
      "duration_seconds": 4.11,
      "text": "Saline spray. I take it three times a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.57,
      "end_seconds": 247.31,
      "duration_seconds": 7.74,
      "text": "Going by what you've described, this looks most like nasal polyps. We shouldn't forget chronic sinusitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.46,
      "end_seconds": 251.2,
      "duration_seconds": 2.74,
      "text": "Um, will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.53,
      "end_seconds": 265.15,
      "duration_seconds": 10.62,
      "text": "I understand the worry. At the moment I'd say it's nasal polyps, and we'll know more once the a nasal endoscopy is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.94,
      "end_seconds": 293.17,
      "duration_seconds": 16.23,
      "text": "Let's book a nasal endoscopy to look into nasal obstruction. We'll begin with mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for nasal polyps. Rinse with saline and use the spray daily."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.38,
      "end_seconds": 301.95,
      "duration_seconds": 8.57,
      "text": "Understood. I think the ENT clinic should see you too. Come back in eight weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.63,
      "end_seconds": 304.72,
      "duration_seconds": 2.09,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}