{
  "schema_version": "1.0",
  "encounter_id": "02863",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.25,
      "duration_seconds": 3.43,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.92,
      "end_seconds": 8.65,
      "duration_seconds": 3.73,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.35,
      "end_seconds": 12.08,
      "duration_seconds": 2.73,
      "text": "I'm here because of chest tightness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.05,
      "end_seconds": 19.22,
      "duration_seconds": 3.17,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.08,
      "end_seconds": 28.47,
      "duration_seconds": 3.39,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.03,
      "end_seconds": 32.85,
      "duration_seconds": 2.82,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.19,
      "end_seconds": 35.67,
      "duration_seconds": 1.48,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.51,
      "end_seconds": 39.65,
      "duration_seconds": 2.14,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.09,
      "end_seconds": 53.77,
      "duration_seconds": 12.68,
      "text": "Swollen ankles goes along with it, most of the time. The swollen ankles? That's been for five days. And fainting on exertion as well, since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.5,
      "end_seconds": 62.56,
      "duration_seconds": 5.06,
      "text": "Have you had chest tightness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.63,
      "end_seconds": 73.25,
      "duration_seconds": 4.62,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.88,
      "end_seconds": 91.48,
      "duration_seconds": 3.6,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.8,
      "end_seconds": 97.52,
      "duration_seconds": 4.72,
      "text": "I take Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.7,
      "end_seconds": 102.56,
      "duration_seconds": 3.86,
      "text": "Right, how long have you been on it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.08,
      "end_seconds": 112.77,
      "duration_seconds": 8.69,
      "text": "About six months. Right, I'm on sumatriptan, 50 milligrams, maybe, when needed for my migraines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.9,
      "end_seconds": 116.89,
      "duration_seconds": 2.99,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.54,
      "end_seconds": 125.8,
      "duration_seconds": 7.26,
      "text": "Not with me. I'll bring it next time. It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.62,
      "end_seconds": 132.02,
      "duration_seconds": 4.4,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.59,
      "end_seconds": 137.9,
      "duration_seconds": 4.31,
      "text": "Let me think, no, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.83,
      "end_seconds": 141.61,
      "duration_seconds": 2.78,
      "text": "Right, what about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.71,
      "end_seconds": 143.75,
      "duration_seconds": 1.04,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.8,
      "end_seconds": 146.5,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.16,
      "end_seconds": 149.46,
      "duration_seconds": 2.3,
      "text": "I've, I've got migraines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.83,
      "end_seconds": 151.88,
      "duration_seconds": 1.05,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.54,
      "end_seconds": 154.59,
      "duration_seconds": 2.05,
      "text": "Eczema, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.55,
      "end_seconds": 165.04,
      "duration_seconds": 5.49,
      "text": "Alright, yes, asthma is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.66,
      "end_seconds": 182.3,
      "duration_seconds": 1.64,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.93,
      "end_seconds": 187.98,
      "duration_seconds": 4.05,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 190.26,
      "duration_seconds": 0.82,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.95,
      "end_seconds": 193.28,
      "duration_seconds": 2.33,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.01,
      "end_seconds": 197.7,
      "duration_seconds": 3.69,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.84,
      "end_seconds": 206.14,
      "duration_seconds": 3.3,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.87,
      "end_seconds": 209.88,
      "duration_seconds": 3.01,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.64,
      "end_seconds": 215.68,
      "duration_seconds": 4.04,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.74,
      "end_seconds": 220.26,
      "duration_seconds": 2.52,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.14,
      "end_seconds": 228.28,
      "duration_seconds": 6.14,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.09,
      "end_seconds": 231.54,
      "duration_seconds": 1.45,
      "text": "How about cough?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.41,
      "end_seconds": 236.74,
      "duration_seconds": 3.33,
      "text": "Not that I've noticed, no cough."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 242.32,
      "duration_seconds": 3.75,
      "text": "A few quick ones: leg pain or fever?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.37,
      "end_seconds": 247.35,
      "duration_seconds": 3.98,
      "text": "Let me think, nope, nothing like that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.48,
      "end_seconds": 251.84,
      "duration_seconds": 3.36,
      "text": "So, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.34,
      "end_seconds": 255.4,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.72,
      "end_seconds": 262.75,
      "duration_seconds": 4.03,
      "text": "So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.5,
      "end_seconds": 266.46,
      "duration_seconds": 1.96,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 285.41,
      "end_seconds": 301.5,
      "duration_seconds": 16.09,
      "text": "Okay, so the vitals from earlier. Height 156 centimetres, oxygen saturation is 90 percent, weight 63 kilos. BMI works out to 25.9, temp 37.0 degrees, pulse 102, respiratory rate 23, pressure 125 over 81."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.38,
      "end_seconds": 304.48,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.16,
      "end_seconds": 310.26,
      "duration_seconds": 4.1,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.62,
      "end_seconds": 314.44,
      "duration_seconds": 2.82,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.93,
      "end_seconds": 319.3,
      "duration_seconds": 3.37,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.08,
      "end_seconds": 336.03,
      "duration_seconds": 4.95,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.6,
      "end_seconds": 352.56,
      "duration_seconds": 12.96,
      "text": "You can relax now. So, based on the history and the examination, it fits best with possible pulmonary hypertension. A heart valve problem is also on my list."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 353.36,
      "end_seconds": 356.97,
      "duration_seconds": 3.61,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.19,
      "end_seconds": 371.86,
      "duration_seconds": 8.67,
      "text": "Thanks, I'll have a look. I'm sending you for blood tests because of breathlessness. We should do an echocardiogram for exertional syncope."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.58,
      "end_seconds": 375.49,
      "duration_seconds": 1.91,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.79,
      "end_seconds": 399.48,
      "duration_seconds": 22.69,
      "text": "No exertion for now, I am arranging urgent specialist tests. Cut down on salt and fried food for now, it really does make a difference. I think the pulmonary hypertension service should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.81,
      "end_seconds": 404.21,
      "duration_seconds": 3.4,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.03,
      "end_seconds": 417.38,
      "duration_seconds": 12.35,
      "text": "Come back or go to emergency straight away if the symptoms get worse. I'll want another look in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.69,
      "end_seconds": 421.65,
      "duration_seconds": 2.96,
      "text": "Thank you, you know, that's helpful."
    }
  ]
}