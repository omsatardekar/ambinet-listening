{
  "schema_version": "1.0",
  "encounter_id": "02982",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.2,
      "end_seconds": 8.96,
      "duration_seconds": 7.76,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.38,
      "end_seconds": 18.31,
      "duration_seconds": 3.93,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.59,
      "end_seconds": 26.81,
      "duration_seconds": 4.22,
      "text": "Ah, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 32.43,
      "duration_seconds": 3.59,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.33,
      "end_seconds": 40.51,
      "duration_seconds": 6.18,
      "text": "Okay, uh, so we came because of sneezing in spring."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 41.54,
      "end_seconds": 55.13,
      "duration_seconds": 13.59,
      "text": "Doctor, I've got the readings for you. BP is 118 over 75, heart rate 76, temperature is 36.7 degrees, SpO2 99 percent on room air, respiratory rate 14."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.21,
      "end_seconds": 61.02,
      "duration_seconds": 4.81,
      "text": "Okay, noted. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.82,
      "end_seconds": 67.35,
      "duration_seconds": 4.53,
      "text": "Um, I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.36,
      "end_seconds": 71.49,
      "duration_seconds": 2.13,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.57,
      "end_seconds": 75.84,
      "duration_seconds": 2.27,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 80.86,
      "duration_seconds": 3.63,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.19,
      "end_seconds": 83.37,
      "duration_seconds": 1.18,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.99,
      "end_seconds": 87.09,
      "duration_seconds": 2.1,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.88,
      "end_seconds": 91.67,
      "duration_seconds": 3.79,
      "text": "Mm, I notice it more with pollen."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.65,
      "end_seconds": 99.82,
      "duration_seconds": 7.17,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 99.92,
      "end_seconds": 105.53,
      "duration_seconds": 5.61,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.15,
      "end_seconds": 116.24,
      "duration_seconds": 10.09,
      "text": "I was getting to that! And there's a runny itchy nose as well, about two weeks now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.6,
      "end_seconds": 128.15,
      "duration_seconds": 5.55,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.9,
      "end_seconds": 139.26,
      "duration_seconds": 9.36,
      "text": "I'd say every other day. Moderate, really. I've also had watery eyes, for five days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 140.19,
      "end_seconds": 144.37,
      "duration_seconds": 4.18,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.13,
      "end_seconds": 148.24,
      "duration_seconds": 3.11,
      "text": "Has there been any loss of smell?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.77,
      "end_seconds": 152.25,
      "duration_seconds": 2.48,
      "text": "Definitely no loss of smell."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.86,
      "end_seconds": 157.76,
      "duration_seconds": 3.9,
      "text": "Have you noticed facial pain, fever or wheeze?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.82,
      "end_seconds": 162.56,
      "duration_seconds": 3.74,
      "text": "No, you know, nothing to report there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.86,
      "end_seconds": 165.92,
      "duration_seconds": 2.06,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.24,
      "end_seconds": 170.0,
      "duration_seconds": 2.76,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.7,
      "end_seconds": 174.59,
      "duration_seconds": 2.89,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.92,
      "end_seconds": 179.95,
      "duration_seconds": 4.03,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.32,
      "end_seconds": 185.09,
      "duration_seconds": 3.77,
      "text": "Alright, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.91,
      "end_seconds": 210.86,
      "duration_seconds": 23.95,
      "text": "I have acid reflux, for about ten years. I told my wife I'd come today. I mean, uh, I've had asthma, yes. I took the morning off to come in today. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 216.29,
      "duration_seconds": 3.53,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.01,
      "end_seconds": 229.86,
      "duration_seconds": 11.85,
      "text": "I'm on pantoprazole, 40 milligrams, before breakfast. Foracort inhaler, twice a day for my asthma. Loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 231.38,
      "end_seconds": 236.2,
      "duration_seconds": 4.82,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.68,
      "end_seconds": 242.22,
      "duration_seconds": 4.54,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 243.82,
      "end_seconds": 248.34,
      "duration_seconds": 4.52,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.06,
      "end_seconds": 254.39,
      "duration_seconds": 4.33,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.86,
      "end_seconds": 259.93,
      "duration_seconds": 4.07,
      "text": "Let me think, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.5,
      "end_seconds": 264.97,
      "duration_seconds": 4.47,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.39,
      "end_seconds": 271.68,
      "duration_seconds": 3.29,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 274.59,
      "end_seconds": 281.68,
      "duration_seconds": 7.09,
      "text": "Actually, I'm not sure that's right. I seem to recall a problem with trimethoprim."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.23,
      "end_seconds": 284.93,
      "duration_seconds": 2.7,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.44,
      "end_seconds": 291.72,
      "duration_seconds": 5.28,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.25,
      "end_seconds": 304.91,
      "duration_seconds": 4.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.72,
      "end_seconds": 319.27,
      "duration_seconds": 13.55,
      "text": "I'll have a glass of wine with dinner. I drink a lot of tea and snack through the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.48,
      "end_seconds": 325.22,
      "duration_seconds": 3.74,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 327.13,
      "end_seconds": 328.2,
      "duration_seconds": 1.07,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.62,
      "end_seconds": 331.0,
      "duration_seconds": 1.38,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.35,
      "end_seconds": 350.73,
      "duration_seconds": 5.38,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.36,
      "end_seconds": 355.52,
      "duration_seconds": 2.16,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.39,
      "end_seconds": 379.31,
      "duration_seconds": 6.92,
      "text": "Okay, so my impression is this: I think we're dealing with seasonal allergic rhinitis at this stage."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.85,
      "end_seconds": 385.68,
      "duration_seconds": 4.83,
      "text": "Oh, um, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.88,
      "end_seconds": 403.75,
      "duration_seconds": 13.87,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal allergic rhinitis. I'll start you on fluticasone nasal spray, 50 micrograms, once a day, the season. That's for hay fever."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 404.35,
      "end_seconds": 407.85,
      "duration_seconds": 3.5,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.84,
      "end_seconds": 424.15,
      "duration_seconds": 15.31,
      "text": "Shower after being outdoors and keep windows shut when pollen is high. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 429.64,
      "end_seconds": 431.28,
      "duration_seconds": 1.64,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.43,
      "end_seconds": 438.82,
      "duration_seconds": 6.39,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 440.78,
      "end_seconds": 444.63,
      "duration_seconds": 3.85,
      "text": "Oh, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.5,
      "end_seconds": 453.52,
      "duration_seconds": 8.02,
      "text": "Please come and see me if not better in a month. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 455.38,
      "end_seconds": 457.93,
      "duration_seconds": 2.55,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.65,
      "end_seconds": 460.86,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}