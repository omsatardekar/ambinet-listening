{
  "schema_version": "1.0",
  "encounter_id": "02993",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 6.04,
      "duration_seconds": 5.45,
      "text": "Okay, so good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.48,
      "end_seconds": 11.71,
      "duration_seconds": 4.23,
      "text": "Alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 22.04,
      "duration_seconds": 8.5,
      "text": "Mainly a dry cough. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.79,
      "end_seconds": 25.19,
      "duration_seconds": 2.4,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.1,
      "end_seconds": 29.22,
      "duration_seconds": 3.12,
      "text": "Well, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.97,
      "end_seconds": 38.71,
      "duration_seconds": 8.74,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.25,
      "end_seconds": 52.54,
      "duration_seconds": 12.29,
      "text": "Maybe a three out of ten on a bad day. It's a couple of times a week. I've had breathlessness building over weeks too, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.52,
      "end_seconds": 56.27,
      "duration_seconds": 2.75,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.84,
      "end_seconds": 58.53,
      "duration_seconds": 1.69,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.85,
      "end_seconds": 80.21,
      "duration_seconds": 4.36,
      "text": "Did you get night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.36,
      "end_seconds": 83.73,
      "duration_seconds": 2.37,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.05,
      "end_seconds": 88.07,
      "duration_seconds": 3.02,
      "text": "And what about fever or leg swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.08,
      "end_seconds": 93.03,
      "duration_seconds": 3.95,
      "text": "No fever or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.45,
      "end_seconds": 96.58,
      "duration_seconds": 2.13,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.16,
      "end_seconds": 99.57,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.14,
      "end_seconds": 103.64,
      "duration_seconds": 2.5,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.36,
      "end_seconds": 107.88,
      "duration_seconds": 2.52,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.87,
      "end_seconds": 114.44,
      "duration_seconds": 4.57,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.45,
      "end_seconds": 120.05,
      "duration_seconds": 4.6,
      "text": "Yeah, yes, grass pollen, it gives me sneezing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.36,
      "end_seconds": 138.36,
      "duration_seconds": 4.0,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.43,
      "end_seconds": 141.94,
      "duration_seconds": 1.51,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.87,
      "end_seconds": 147.63,
      "duration_seconds": 3.76,
      "text": "Okay, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.74,
      "end_seconds": 154.44,
      "duration_seconds": 5.7,
      "text": "Erm, I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.45,
      "end_seconds": 160.14,
      "duration_seconds": 3.69,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.17,
      "end_seconds": 163.67,
      "duration_seconds": 2.5,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.37,
      "end_seconds": 168.5,
      "duration_seconds": 3.13,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.79,
      "end_seconds": 173.51,
      "duration_seconds": 3.72,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.04,
      "end_seconds": 175.95,
      "duration_seconds": 1.91,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.05,
      "end_seconds": 181.55,
      "duration_seconds": 3.5,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.99,
      "end_seconds": 185.64,
      "duration_seconds": 2.65,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.26,
      "end_seconds": 194.53,
      "duration_seconds": 3.27,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.5,
      "end_seconds": 198.41,
      "duration_seconds": 2.91,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.18,
      "end_seconds": 212.65,
      "duration_seconds": 3.47,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.04,
      "end_seconds": 242.49,
      "duration_seconds": 10.45,
      "text": "Okay: pulse is 89 beats a minute, temperature 37.6, oxygen saturation is 93 percent. And BP is 122 over 76, respiratory rate 20."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.68,
      "end_seconds": 248.3,
      "duration_seconds": 3.62,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.0,
      "end_seconds": 250.07,
      "duration_seconds": 1.07,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.77,
      "end_seconds": 253.45,
      "duration_seconds": 1.68,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.32,
      "end_seconds": 271.63,
      "duration_seconds": 6.31,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.89,
      "end_seconds": 284.92,
      "duration_seconds": 11.03,
      "text": "Thank you, you can get dressed. Right, here's what I'm thinking. It points towards a pleural effusion needing a cause. We shouldn't forget heart failure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.71,
      "end_seconds": 303.11,
      "duration_seconds": 4.4,
      "text": "I'm going to order a chest X-ray, for breathlessness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 303.68,
      "end_seconds": 306.58,
      "duration_seconds": 2.9,
      "text": "The earliest is Friday, 11:30 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.54,
      "end_seconds": 310.46,
      "duration_seconds": 2.92,
      "text": "Friday, that works for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.68,
      "end_seconds": 330.9,
      "duration_seconds": 19.22,
      "text": "I am arranging an urgent chest clinic review. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again after the scan. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.89,
      "end_seconds": 333.39,
      "duration_seconds": 1.5,
      "text": "That's clear, thanks."
    }
  ]
}