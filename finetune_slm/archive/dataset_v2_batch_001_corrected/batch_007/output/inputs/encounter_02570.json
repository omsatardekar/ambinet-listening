{
  "schema_version": "1.0",
  "encounter_id": "02570",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 4.22,
      "duration_seconds": 3.04,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.26,
      "end_seconds": 9.11,
      "duration_seconds": 3.85,
      "text": "Oh, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.12,
      "end_seconds": 12.53,
      "duration_seconds": 2.41,
      "text": "Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.1,
      "end_seconds": 20.22,
      "duration_seconds": 6.12,
      "text": "So, uh, it is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.36,
      "end_seconds": 23.37,
      "duration_seconds": 2.01,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.98,
      "end_seconds": 28.21,
      "duration_seconds": 3.23,
      "text": "It's breathlessness building over weeks, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.32,
      "end_seconds": 32.98,
      "duration_seconds": 3.66,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.06,
      "end_seconds": 37.33,
      "duration_seconds": 2.27,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.98,
      "end_seconds": 42.35,
      "duration_seconds": 3.37,
      "text": "Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.03,
      "end_seconds": 50.38,
      "duration_seconds": 6.35,
      "text": "It's mild, honestly. Yeah, I've had weight loss too, for two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.38,
      "end_seconds": 54.46,
      "duration_seconds": 3.08,
      "text": "And what about fever or leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.76,
      "end_seconds": 58.22,
      "duration_seconds": 2.46,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 63.26,
      "duration_seconds": 3.63,
      "text": "And what about coughing up blood or night sweats?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.56,
      "end_seconds": 66.85,
      "duration_seconds": 2.29,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.28,
      "end_seconds": 71.04,
      "duration_seconds": 2.76,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.58,
      "end_seconds": 76.21,
      "duration_seconds": 3.63,
      "text": "Nothing on the skin, uh, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.2,
      "end_seconds": 80.29,
      "duration_seconds": 3.09,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.1,
      "end_seconds": 86.79,
      "duration_seconds": 4.69,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.33,
      "end_seconds": 107.71,
      "duration_seconds": 3.38,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.6,
      "end_seconds": 110.86,
      "duration_seconds": 2.26,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.47,
      "end_seconds": 126.2,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.83,
      "end_seconds": 140.16,
      "duration_seconds": 9.33,
      "text": "I'm on something called metf... metformin, 500 milligrams, maybe, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.13,
      "end_seconds": 145.67,
      "duration_seconds": 3.54,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.12,
      "end_seconds": 151.07,
      "duration_seconds": 3.95,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.07,
      "end_seconds": 154.15,
      "duration_seconds": 2.08,
      "text": "Alright, who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.67,
      "end_seconds": 158.71,
      "duration_seconds": 3.04,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.94,
      "end_seconds": 161.4,
      "duration_seconds": 1.46,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.03,
      "end_seconds": 166.39,
      "duration_seconds": 4.36,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.72,
      "end_seconds": 176.33,
      "duration_seconds": 4.61,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.45,
      "end_seconds": 180.82,
      "duration_seconds": 3.37,
      "text": "Um, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.71,
      "end_seconds": 196.5,
      "duration_seconds": 9.79,
      "text": "Okay, I can see diabetes in your file as well. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.03,
      "end_seconds": 201.75,
      "duration_seconds": 3.72,
      "text": "Not to my knowledge, uh, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 214.68,
      "end_seconds": 223.73,
      "duration_seconds": 9.05,
      "text": "Here are the numbers, doctor. Respiratory rate 22, heart rate 84. Oxygen saturation is 90 percent, temperature 37.0, pressure 122 over 73."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.42,
      "end_seconds": 226.35,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.23,
      "end_seconds": 230.22,
      "duration_seconds": 1.99,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.67,
      "end_seconds": 233.9,
      "duration_seconds": 2.23,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 256.48,
      "duration_seconds": 5.22,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.8,
      "end_seconds": 279.69,
      "duration_seconds": 17.89,
      "text": "That's the examination finished. Having listened and examined, I think we're dealing with a pleural effusion needing a cause at this stage. We shouldn't forget an infection. I'll request a chest X-ray, it'll help with breathlessness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.1,
      "end_seconds": 282.62,
      "duration_seconds": 1.52,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.46,
      "end_seconds": 306.09,
      "duration_seconds": 21.63,
      "text": "I'd like to arrange a pleural fluid sample for pleural effusion. I am arranging an urgent chest clinic review. Don't skip meals, and try to eat smaller portions more often through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.66,
      "end_seconds": 310.6,
      "duration_seconds": 2.94,
      "text": "So, that's fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.33,
      "end_seconds": 325.81,
      "duration_seconds": 14.48,
      "text": "If it hasn't settled in a month, we'd think about a CT scan of the chest, but not now. I'd like to see you again after the scan. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.13,
      "end_seconds": 331.48,
      "duration_seconds": 4.35,
      "text": "Okay, so good, thanks, I'll see you then."
    }
  ]
}