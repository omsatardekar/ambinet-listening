{
  "schema_version": "1.0",
  "encounter_id": "02971",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.92,
      "end_seconds": 8.48,
      "duration_seconds": 7.56,
      "text": "Okay, doctor, we're all set in here. I'll give you the the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.59,
      "end_seconds": 15.66,
      "duration_seconds": 4.07,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.75,
      "end_seconds": 22.95,
      "duration_seconds": 5.2,
      "text": "I wanted to to get fainting on exertion looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.04,
      "end_seconds": 28.35,
      "duration_seconds": 3.31,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.27,
      "end_seconds": 36.59,
      "duration_seconds": 7.32,
      "text": "Allopurinol. I take it 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.55,
      "end_seconds": 40.6,
      "duration_seconds": 3.05,
      "text": "Roughly how long on that that one?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.8,
      "end_seconds": 48.74,
      "duration_seconds": 6.94,
      "text": "About three months now. Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 49.75,
      "end_seconds": 54.96,
      "duration_seconds": 5.21,
      "text": "Doctor, our chart from the last visit lists it as 35 milligrams."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.76,
      "end_seconds": 59.51,
      "duration_seconds": 3.75,
      "text": "I see is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.1,
      "end_seconds": 72.59,
      "duration_seconds": 12.49,
      "text": "Sorry, what was I saying, not with me. I'll bring it next time. I'd been on atorvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.22,
      "end_seconds": 82.79,
      "duration_seconds": 8.57,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.21,
      "end_seconds": 88.5,
      "duration_seconds": 4.29,
      "text": "Well, it's every other day. I'd say moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.35,
      "end_seconds": 96.26,
      "duration_seconds": 6.91,
      "text": "Ah, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 96.36,
      "end_seconds": 103.8,
      "duration_seconds": 7.44,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.73,
      "end_seconds": 106.94,
      "duration_seconds": 2.21,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.73,
      "end_seconds": 113.37,
      "duration_seconds": 4.64,
      "text": "I've also had swollen ankles, for five days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.23,
      "end_seconds": 117.35,
      "duration_seconds": 3.12,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.39,
      "end_seconds": 124.31,
      "duration_seconds": 4.92,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.91,
      "end_seconds": 129.28,
      "duration_seconds": 4.37,
      "text": "hm, okay what about chest tightness, have you noticed that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 132.42,
      "duration_seconds": 1.74,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.84,
      "end_seconds": 142.23,
      "duration_seconds": 5.39,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.24,
      "end_seconds": 145.51,
      "duration_seconds": 2.27,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 146.03,
      "end_seconds": 147.97,
      "duration_seconds": 1.94,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.36,
      "end_seconds": 152.95,
      "duration_seconds": 3.59,
      "text": "any fever, leg pain or cough at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.51,
      "end_seconds": 168.15,
      "duration_seconds": 13.64,
      "text": "No, no fever, no leg pain, no cough. I did have being very breathless at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.49,
      "end_seconds": 171.56,
      "duration_seconds": 2.07,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.97,
      "end_seconds": 174.15,
      "duration_seconds": 1.18,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.01,
      "end_seconds": 181.33,
      "duration_seconds": 5.32,
      "text": "so, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.99,
      "end_seconds": 185.84,
      "duration_seconds": 2.85,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.52,
      "end_seconds": 188.26,
      "duration_seconds": 1.74,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.78,
      "end_seconds": 191.85,
      "duration_seconds": 2.07,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.02,
      "end_seconds": 197.9,
      "duration_seconds": 4.88,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.68,
      "end_seconds": 203.94,
      "duration_seconds": 4.26,
      "text": "Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.78,
      "end_seconds": 223.11,
      "duration_seconds": 4.33,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 262.55,
      "duration_seconds": 38.81,
      "text": "I have high cholesterol i told myself I'd wait and see, and here I am work has been very busy so I kept ignoring it i've had gout for nearly five years now i thought it would sort itself out, but it hasn't i didn't want to make a fuss, you know i've had thin bones for nearly five years now it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 273.03,
      "duration_seconds": 8.96,
      "text": "understood. Alright, gout, that matches what I have here. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 273.61,
      "end_seconds": 279.28,
      "duration_seconds": 5.67,
      "text": "um, my grandmother had dementia my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.12,
      "end_seconds": 281.86,
      "duration_seconds": 1.74,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.86,
      "end_seconds": 285.44,
      "duration_seconds": 1.58,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.1,
      "end_seconds": 289.07,
      "duration_seconds": 1.97,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 290.86,
      "end_seconds": 293.82,
      "duration_seconds": 2.96,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 311.51,
      "end_seconds": 324.26,
      "duration_seconds": 12.75,
      "text": "Here are the numbers, doctor. Temp 37.4 degrees, respiratory rate 22, height 165 centimetres, pulse 100, saturation 93 percent, pressure 129 over 72, weight 88 kilos."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.94,
      "end_seconds": 327.33,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.29,
      "end_seconds": 331.6,
      "duration_seconds": 2.31,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.98,
      "end_seconds": 335.51,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.9,
      "end_seconds": 348.8,
      "duration_seconds": 4.9,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.75,
      "end_seconds": 375.33,
      "duration_seconds": 22.58,
      "text": "You can relax now. Let me tell you where I've got to. The most likely explanation is possible pulmonary hypertension. That's my thinking for now, and it may change as we learn more. A heart valve problem is still possible. It could also be chronic clots in the lungs, so we'll keep that open."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 376.64,
      "end_seconds": 382.76,
      "duration_seconds": 6.12,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.66,
      "end_seconds": 389.32,
      "duration_seconds": 4.66,
      "text": "Right, thank you. I'll request blood tests, it'll help with breathlessness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 391.39,
      "end_seconds": 395.59,
      "duration_seconds": 4.2,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.03,
      "end_seconds": 401.77,
      "duration_seconds": 4.74,
      "text": "I'm sending you for an echocardiogram because of exertional syncope."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 406.56,
      "end_seconds": 409.54,
      "duration_seconds": 2.98,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.64,
      "end_seconds": 433.68,
      "duration_seconds": 22.04,
      "text": "No exertion for now, I am arranging urgent specialist tests. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 434.63,
      "end_seconds": 438.84,
      "duration_seconds": 4.21,
      "text": "No, um, that's all. Thanks a lot."
    }
  ]
}