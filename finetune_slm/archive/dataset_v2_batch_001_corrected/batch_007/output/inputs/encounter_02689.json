{
  "schema_version": "1.0",
  "encounter_id": "02689",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 4.21,
      "duration_seconds": 2.94,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.03,
      "end_seconds": 8.68,
      "duration_seconds": 2.65,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.66,
      "end_seconds": 13.89,
      "duration_seconds": 3.23,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.4,
      "end_seconds": 22.1,
      "duration_seconds": 6.7,
      "text": "Mainly vomiting. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.0,
      "end_seconds": 27.69,
      "duration_seconds": 4.69,
      "text": "When did this begin? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.56,
      "end_seconds": 32.1,
      "duration_seconds": 3.54,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.35,
      "end_seconds": 36.18,
      "duration_seconds": 2.83,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.76,
      "end_seconds": 41.49,
      "duration_seconds": 3.73,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.75,
      "end_seconds": 47.45,
      "duration_seconds": 4.7,
      "text": "Have you had severe thirst and passing lots of urine?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.34,
      "end_seconds": 56.03,
      "duration_seconds": 7.69,
      "text": "Yes, about the same, two months. There was being very confused, yes, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.91,
      "end_seconds": 59.8,
      "duration_seconds": 2.89,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.85,
      "end_seconds": 64.48,
      "duration_seconds": 2.63,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.08,
      "end_seconds": 75.46,
      "duration_seconds": 3.38,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.53,
      "end_seconds": 78.21,
      "duration_seconds": 1.68,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.64,
      "end_seconds": 87.15,
      "duration_seconds": 2.51,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.22,
      "end_seconds": 92.72,
      "duration_seconds": 3.5,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.49,
      "end_seconds": 98.1,
      "duration_seconds": 4.61,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.99,
      "end_seconds": 108.54,
      "duration_seconds": 9.55,
      "text": "Yes, kiwi. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.58,
      "end_seconds": 127.31,
      "duration_seconds": 4.73,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.24,
      "end_seconds": 150.56,
      "duration_seconds": 22.32,
      "text": "I gave up cigarettes last spring. I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. Yes, I work in a bakery, early starts. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.18,
      "end_seconds": 157.61,
      "duration_seconds": 5.43,
      "text": "Let me check a few things. Any chest pain, fall or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.89,
      "end_seconds": 160.89,
      "duration_seconds": 2.0,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 165.34,
      "duration_seconds": 2.86,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.27,
      "end_seconds": 167.89,
      "duration_seconds": 1.62,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.46,
      "end_seconds": 171.94,
      "duration_seconds": 2.48,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.47,
      "end_seconds": 175.05,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.04,
      "end_seconds": 190.29,
      "duration_seconds": 4.25,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.07,
      "end_seconds": 205.67,
      "duration_seconds": 2.6,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.83,
      "end_seconds": 223.68,
      "duration_seconds": 6.85,
      "text": "Okay: temperature 36.5, blood pressure 102 over 57, saturation 98 percent, heart rate 103."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.66,
      "end_seconds": 226.94,
      "duration_seconds": 2.28,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.25,
      "end_seconds": 232.58,
      "duration_seconds": 4.33,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.28,
      "end_seconds": 236.28,
      "duration_seconds": 2.0,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.24,
      "end_seconds": 239.33,
      "duration_seconds": 1.09,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.62,
      "end_seconds": 241.88,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.29,
      "end_seconds": 261.03,
      "duration_seconds": 5.74,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.38,
      "end_seconds": 271.35,
      "duration_seconds": 6.97,
      "text": "Good, you can sit up again. Putting it all together, it points towards a high calcium emergency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.84,
      "end_seconds": 274.23,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.18,
      "end_seconds": 290.08,
      "duration_seconds": 13.9,
      "text": "Nothing I've seen today points to an emergency. It looks like a high calcium emergency, but I'd like to confirm. Urgent blood tests is what I'd like next, for confusion and polyuria."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.52,
      "end_seconds": 293.93,
      "duration_seconds": 2.41,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.58,
      "end_seconds": 304.41,
      "duration_seconds": 9.83,
      "text": "I'm going to put you on sodium chloride 0.9%, 1 litre, over one hour, single dose. It's for dehydration."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.26,
      "end_seconds": 307.75,
      "duration_seconds": 2.49,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.61,
      "end_seconds": 317.65,
      "duration_seconds": 8.04,
      "text": "You need hospital fluids and treatment now. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.24,
      "end_seconds": 320.61,
      "duration_seconds": 1.37,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.29,
      "end_seconds": 327.65,
      "duration_seconds": 5.36,
      "text": "Come back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.56,
      "end_seconds": 330.37,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    }
  ]
}