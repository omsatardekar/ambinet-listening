{
  "schema_version": "1.0",
  "encounter_id": "02745",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.69,
      "duration_seconds": 3.85,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 11.65,
      "duration_seconds": 4.89,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.32,
      "end_seconds": 19.51,
      "duration_seconds": 7.19,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.88,
      "end_seconds": 25.14,
      "duration_seconds": 4.26,
      "text": "I'm here because of a rolled ankle."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.02,
      "end_seconds": 27.45,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.04,
      "end_seconds": 35.92,
      "duration_seconds": 7.88,
      "text": "About three months, I think... sorry, about a month, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.63,
      "end_seconds": 42.83,
      "duration_seconds": 5.2,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.59,
      "end_seconds": 60.51,
      "duration_seconds": 15.92,
      "text": "so, um, I notice it more with walking i get some relief from rest and bruising, too. Some swelling was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.56,
      "end_seconds": 66.7,
      "duration_seconds": 4.14,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.47,
      "end_seconds": 69.89,
      "duration_seconds": 2.42,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.45,
      "end_seconds": 72.12,
      "duration_seconds": 1.67,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.99,
      "end_seconds": 77.2,
      "duration_seconds": 3.21,
      "text": "I, I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.22,
      "end_seconds": 80.85,
      "duration_seconds": 1.63,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.62,
      "end_seconds": 84.71,
      "duration_seconds": 2.09,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.97,
      "end_seconds": 89.91,
      "duration_seconds": 3.94,
      "text": "Yes, carry on. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.0,
      "end_seconds": 95.47,
      "duration_seconds": 3.47,
      "text": "I take alendronate, once a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.99,
      "end_seconds": 99.61,
      "duration_seconds": 2.62,
      "text": "so, how much do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.95,
      "end_seconds": 110.16,
      "duration_seconds": 9.21,
      "text": "70 milligrams, I think that's what's on the box. Well, uh, it's thyroxine, 75 micrograms, every morning"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.63,
      "end_seconds": 112.55,
      "duration_seconds": 1.92,
      "text": "I see, go ahead"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.33,
      "end_seconds": 119.72,
      "duration_seconds": 6.39,
      "text": "Metoprolol, 50 milligrams, maybe, twice a day for my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.63,
      "end_seconds": 124.79,
      "duration_seconds": 4.16,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.51,
      "end_seconds": 143.52,
      "duration_seconds": 17.01,
      "text": "So, you know, not with me. I'll bring it next time. Ibuprofen gel, three times a day. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.02,
      "end_seconds": 149.28,
      "duration_seconds": 3.26,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.95,
      "end_seconds": 156.86,
      "duration_seconds": 5.91,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.3,
      "end_seconds": 163.08,
      "duration_seconds": 4.78,
      "text": "Any inherited conditions that that you know of in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.17,
      "end_seconds": 166.6,
      "duration_seconds": 2.43,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.81,
      "end_seconds": 171.73,
      "duration_seconds": 3.92,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.81,
      "end_seconds": 189.79,
      "duration_seconds": 11.98,
      "text": "I'm a bus driver, so I sit for long hours. No, I share a house with my brother. I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.14,
      "end_seconds": 209.39,
      "duration_seconds": 4.25,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.67,
      "end_seconds": 215.67,
      "duration_seconds": 5.0,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.0,
      "end_seconds": 230.35,
      "duration_seconds": 1.35,
      "text": "What about numbness?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.86,
      "end_seconds": 236.44,
      "duration_seconds": 4.58,
      "text": "Let me think, not at all, no numbness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.18,
      "end_seconds": 245.85,
      "duration_seconds": 5.67,
      "text": "Have you had any pain in the foot, pain in the shin or pop?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.15,
      "end_seconds": 249.82,
      "duration_seconds": 2.67,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.94,
      "end_seconds": 253.44,
      "duration_seconds": 2.5,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.11,
      "end_seconds": 257.95,
      "duration_seconds": 2.84,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.22,
      "end_seconds": 262.98,
      "duration_seconds": 3.76,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.3,
      "end_seconds": 267.35,
      "duration_seconds": 3.05,
      "text": "actually, no, that's all normal"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.53,
      "end_seconds": 271.13,
      "duration_seconds": 2.6,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.63,
      "end_seconds": 280.58,
      "duration_seconds": 1.95,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.27,
      "end_seconds": 302.46,
      "duration_seconds": 5.19,
      "text": "Okay: saturation 99 percent, blood pressure 111 over 69, heart rate 79."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.27,
      "end_seconds": 307.62,
      "duration_seconds": 3.35,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.15,
      "end_seconds": 309.85,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.7,
      "end_seconds": 314.01,
      "duration_seconds": 2.31,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.85,
      "end_seconds": 338.31,
      "duration_seconds": 7.46,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.11,
      "end_seconds": 346.81,
      "duration_seconds": 2.7,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.8,
      "end_seconds": 384.04,
      "duration_seconds": 23.24,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. Book a review if not better in two weeks. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.58,
      "end_seconds": 392.29,
      "duration_seconds": 3.71,
      "text": "Great, thank you for your help."
    }
  ]
}