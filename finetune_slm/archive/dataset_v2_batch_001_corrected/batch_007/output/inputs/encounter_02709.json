{
  "schema_version": "1.0",
  "encounter_id": "02709",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 4.19,
      "duration_seconds": 3.02,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.15,
      "end_seconds": 13.34,
      "duration_seconds": 3.19,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.2,
      "end_seconds": 19.63,
      "duration_seconds": 2.43,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.39,
      "end_seconds": 23.85,
      "duration_seconds": 3.46,
      "text": "Well, I've been having being very breathless."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.36,
      "end_seconds": 31.42,
      "duration_seconds": 7.06,
      "text": "What's the timeline, when did it begin? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.42,
      "end_seconds": 36.81,
      "duration_seconds": 3.39,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.39,
      "end_seconds": 46.16,
      "duration_seconds": 8.77,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.67,
      "end_seconds": 52.0,
      "duration_seconds": 4.33,
      "text": "I'd call it moderate. It happens all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.95,
      "end_seconds": 56.05,
      "duration_seconds": 2.1,
      "text": "Any chest tightness as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.55,
      "end_seconds": 71.46,
      "duration_seconds": 13.91,
      "text": "Yeah, I've had that since last weekend. About chest tightness, it's mild, honestly. Honestly, every other day. And there's swollen ankles as well, about three months now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.08,
      "end_seconds": 76.79,
      "duration_seconds": 3.71,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.03,
      "end_seconds": 90.31,
      "duration_seconds": 11.28,
      "text": "I'm on iron tablets, once a day for my blood count. Allopurinol, 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.62,
      "end_seconds": 109.79,
      "duration_seconds": 4.17,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.36,
      "end_seconds": 116.37,
      "duration_seconds": 6.01,
      "text": "I have low haemoglobin, for about ten years. I've had gout, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.46,
      "end_seconds": 126.03,
      "duration_seconds": 4.57,
      "text": "Understood. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.2,
      "end_seconds": 128.66,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.53,
      "end_seconds": 133.47,
      "duration_seconds": 2.94,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.0,
      "end_seconds": 139.03,
      "duration_seconds": 4.03,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.87,
      "end_seconds": 141.78,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.44,
      "end_seconds": 145.73,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.52,
      "end_seconds": 149.63,
      "duration_seconds": 2.11,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.2,
      "end_seconds": 153.9,
      "duration_seconds": 2.7,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.41,
      "end_seconds": 157.98,
      "duration_seconds": 3.57,
      "text": "Have you noticed fever, leg pain or cough?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.73,
      "end_seconds": 161.84,
      "duration_seconds": 2.11,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.8,
      "end_seconds": 165.5,
      "duration_seconds": 2.7,
      "text": "Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.96,
      "end_seconds": 171.09,
      "duration_seconds": 2.13,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 174.71,
      "end_seconds": 184.42,
      "duration_seconds": 9.71,
      "text": "Here are the numbers, doctor. Oxygen saturation is 92 percent, pulse is 99 beats a minute. Temperature is 37.5 degrees, blood pressure 138 over 82."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.1,
      "end_seconds": 187.48,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.08,
      "end_seconds": 192.1,
      "duration_seconds": 2.02,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.64,
      "end_seconds": 200.78,
      "duration_seconds": 1.14,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.67,
      "end_seconds": 203.11,
      "duration_seconds": 1.44,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.27,
      "end_seconds": 220.35,
      "duration_seconds": 5.08,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.49,
      "end_seconds": 226.03,
      "duration_seconds": 2.54,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.98,
      "end_seconds": 245.95,
      "duration_seconds": 4.97,
      "text": "Putting it all together, it points towards possible pulmonary hypertension."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.08,
      "end_seconds": 250.14,
      "duration_seconds": 3.06,
      "text": "Mm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.81,
      "end_seconds": 283.76,
      "duration_seconds": 32.95,
      "text": "It's reasonable to be concerned, but right now possible pulmonary hypertension is my leading thought, not anything worse. Let's book an echocardiogram to look into exertional syncope. Let's book blood tests to look into breathlessness. It's a routine test and it'll give us a much clearer picture. No exertion for now, I am arranging urgent specialist tests. Let's get you seen by the pulmonary hypertension service, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.61,
      "end_seconds": 289.93,
      "duration_seconds": 5.32,
      "text": "Yeah, do I need an ECG? I read it might help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.59,
      "end_seconds": 300.79,
      "duration_seconds": 9.2,
      "text": "Not at this point, no. It isn't indicated yet. I'd like you back in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.19,
      "end_seconds": 306.16,
      "duration_seconds": 3.97,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.35,
      "end_seconds": 313.18,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}