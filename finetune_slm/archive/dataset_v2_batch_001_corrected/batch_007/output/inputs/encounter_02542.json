  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.75,
      "duration_seconds": 4.6,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.44,
      "end_seconds": 12.95,
      "duration_seconds": 5.51,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.83,
      "end_seconds": 17.56,
      "duration_seconds": 3.73,
      "text": "I've been dealing with a sudden high fever."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.7,
      "end_seconds": 24.4,
      "duration_seconds": 5.7,
      "text": "When did this begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.89,
      "end_seconds": 33.69,
      "duration_seconds": 7.8,
      "text": "I've had it it for three days. I've had vomiting and diarrhoea too, for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.02,
      "end_seconds": 52.13,
      "duration_seconds": 3.11,
      "text": "Did you get stiff neck or cough?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.57,
      "end_seconds": 57.11,
      "duration_seconds": 3.54,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.63,
      "end_seconds": 60.62,
      "duration_seconds": 2.99,
      "text": "Mm, okay. Right, what about sore throat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.57,
      "end_seconds": 64.9,
      "duration_seconds": 2.33,
      "text": "Nope, no sore throat."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.9,
      "end_seconds": 69.89,
      "duration_seconds": 2.99,
      "text": "alright, has your skin been okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.75,
      "end_seconds": 72.83,
      "duration_seconds": 1.08,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.84,
      "end_seconds": 76.85,
      "duration_seconds": 3.01,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.54,
      "end_seconds": 79.59,
      "duration_seconds": 2.05,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 96.78,
      "duration_seconds": 2.89,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.8,
      "end_seconds": 102.21,
      "duration_seconds": 3.41,
      "text": "Yes, trimethoprim, it gives me a rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.28,
      "end_seconds": 106.06,
      "duration_seconds": 2.78,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.64,
      "end_seconds": 111.59,
      "duration_seconds": 3.95,
      "text": "I had a bunion operation six years ago"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.6,
      "end_seconds": 115.36,
      "duration_seconds": 2.76,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.75,
      "end_seconds": 120.58,
      "duration_seconds": 3.83,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.61,
      "end_seconds": 126.62,
      "duration_seconds": 4.01,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.1,
      "end_seconds": 132.06,
      "duration_seconds": 3.96,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.73,
      "end_seconds": 136.66,
      "duration_seconds": 2.93,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.37,
      "end_seconds": 141.54,
      "duration_seconds": 3.17,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.03,
      "end_seconds": 146.74,
      "duration_seconds": 3.71,
      "text": "So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.6,
      "end_seconds": 161.45,
      "duration_seconds": 12.85,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast for my acidity. Mm, uh, I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.5,
      "end_seconds": 166.56,
      "duration_seconds": 4.06,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.4,
      "end_seconds": 176.31,
      "duration_seconds": 7.91,
      "text": "Acid reflux, for five years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.33,
      "end_seconds": 184.45,
      "duration_seconds": 7.12,
      "text": "Alright, acid reflux, that matches what I have here. Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.67,
      "end_seconds": 195.16,
      "duration_seconds": 2.49,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.02,
      "end_seconds": 224.22,
      "duration_seconds": 15.2,
      "text": "okay: respiratory rate 20, height 181 centimetres, heart rate 112. And BMI works out to 28.1, weight 92 kilos, temperature is 37.1 degrees, BP is 97 over 64, oxygen saturation is 96 percent"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.31,
      "end_seconds": 259.54,
      "duration_seconds": 26.23,
      "text": "let's book blood cultures to look into possible toxic shock. I'm going to put you on flucloxacillin, 2 grams, now, single dose. That should help with possible toxic shock syndrome. Remove any tampon, you are going to hospital now. I'd like you to see the emergency team as well, and I'll write the referral"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.15,
      "end_seconds": 263.98,
      "duration_seconds": 3.83,
      "text": "Can you send me for a vaginal swab?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.0,
      "end_seconds": 281.36,
      "duration_seconds": 16.36,
      "text": "Not at this point, no. It isn't indicated yet. Let's plan a check straight away. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.82,
      "end_seconds": 291.83,
      "duration_seconds": 8.01,
      "text": "so, I take the flucloxacillin, 2 grams, now and come back straight away is that right?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.82,
      "end_seconds": 298.0,
      "duration_seconds": 4.18,
      "text": "yes, exactly right that's all from me any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.86,
      "end_seconds": 301.78,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.84,
      "end_seconds": 305.54,
      "duration_seconds": 1.7,
      "text": "right, take care now"
    }
  ]
}