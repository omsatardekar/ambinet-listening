{
  "schema_version": "1.0",
  "encounter_id": "02873",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 5.49,
      "duration_seconds": 4.32,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 11.25,
      "duration_seconds": 4.46,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.32,
      "end_seconds": 19.35,
      "duration_seconds": 7.03,
      "text": "Okay, so hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.62,
      "end_seconds": 24.5,
      "duration_seconds": 3.88,
      "text": "it's, It's a sudden painful cold leg, mostly"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.57,
      "end_seconds": 29.55,
      "duration_seconds": 2.98,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.13,
      "end_seconds": 32.53,
      "duration_seconds": 2.4,
      "text": "I'd say three days, maybe"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 34.03,
      "end_seconds": 38.43,
      "duration_seconds": 4.4,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.02,
      "end_seconds": 44.02,
      "duration_seconds": 4.0,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 46.84,
      "duration_seconds": 1.22,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.54,
      "end_seconds": 54.04,
      "duration_seconds": 5.5,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.43,
      "end_seconds": 57.95,
      "duration_seconds": 2.52,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.55,
      "end_seconds": 65.27,
      "duration_seconds": 6.72,
      "text": "Right, right. What about not being able to move the foot, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.81,
      "end_seconds": 76.41,
      "duration_seconds": 9.6,
      "text": "Yes, since Monday. With not being able to move the foot, I'd say mild. There's a pale leg as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.22,
      "end_seconds": 82.68,
      "duration_seconds": 4.46,
      "text": "A few quick ones: chest pain, fever or recent injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.49,
      "end_seconds": 89.46,
      "duration_seconds": 1.97,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.99,
      "end_seconds": 92.9,
      "duration_seconds": 2.91,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.28,
      "end_seconds": 96.5,
      "duration_seconds": 2.22,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 100.41,
      "duration_seconds": 2.28,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.75,
      "end_seconds": 102.81,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.56,
      "end_seconds": 115.13,
      "duration_seconds": 3.57,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.08,
      "end_seconds": 119.88,
      "duration_seconds": 3.8,
      "text": "yes, an irregular heartbeat. I've got heart disease"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.41,
      "end_seconds": 121.67,
      "duration_seconds": 1.26,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.68,
      "end_seconds": 141.23,
      "duration_seconds": 3.55,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.36,
      "end_seconds": 150.86,
      "duration_seconds": 3.5,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.41,
      "end_seconds": 155.32,
      "duration_seconds": 2.91,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.12,
      "end_seconds": 161.63,
      "duration_seconds": 4.51,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.37,
      "end_seconds": 166.08,
      "duration_seconds": 2.71,
      "text": "alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.17,
      "end_seconds": 171.91,
      "duration_seconds": 3.74,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.5,
      "end_seconds": 179.14,
      "duration_seconds": 6.64,
      "text": "Let me ask about allergies, anything at all? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.99,
      "end_seconds": 185.49,
      "duration_seconds": 4.5,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.1,
      "end_seconds": 198.31,
      "duration_seconds": 2.21,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 200.18,
      "end_seconds": 204.37,
      "duration_seconds": 4.19,
      "text": "He takes bisoprolol, 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.92,
      "end_seconds": 205.85,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 206.76,
      "end_seconds": 211.68,
      "duration_seconds": 4.92,
      "text": "he takes aspirin, 75 milligrams, once a day for my heart"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.25,
      "end_seconds": 217.21,
      "duration_seconds": 4.96,
      "text": "I see, go ahead. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.54,
      "end_seconds": 221.38,
      "duration_seconds": 2.84,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.89,
      "end_seconds": 226.3,
      "duration_seconds": 4.41,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.39,
      "end_seconds": 234.74,
      "duration_seconds": 2.35,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.16,
      "end_seconds": 263.33,
      "duration_seconds": 16.17,
      "text": "Okay: temperature is 36.6 degrees, oxygen saturation is 96 percent, pulse is 108 beats a minute. And weight 55 kilos, pressure 120 over 77, BMI works out to 20.7, height 163 centimetres."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.36,
      "end_seconds": 266.77,
      "duration_seconds": 1.41,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.04,
      "end_seconds": 271.83,
      "duration_seconds": 3.79,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.52,
      "end_seconds": 277.76,
      "duration_seconds": 4.24,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.81,
      "end_seconds": 282.51,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.25,
      "end_seconds": 285.54,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.72,
      "end_seconds": 299.6,
      "duration_seconds": 6.88,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.04,
      "end_seconds": 319.84,
      "duration_seconds": 17.8,
      "text": "you can relax now okay, thinking it through, this is probably an acutely ischaemic leg stop me if I've got anything wrong you've had a sudden painful cold leg, and and no recent injury or fever"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.84,
      "end_seconds": 322.62,
      "duration_seconds": 1.78,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.16,
      "end_seconds": 333.44,
      "duration_seconds": 9.28,
      "text": "Let's book an urgent CT angiogram to look into acute limb ischaemia. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.98,
      "end_seconds": 336.03,
      "duration_seconds": 1.05,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.86,
      "end_seconds": 363.36,
      "duration_seconds": 25.5,
      "text": "Let's use heparin, 5000 units, bolus now, single dose. It's for limb ischaemia. You need the vascular surgeons now, this is time critical. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.58,
      "end_seconds": 368.0,
      "duration_seconds": 3.42,
      "text": "I know what to to watch for."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.6,
      "end_seconds": 370.62,
      "duration_seconds": 2.02,
      "text": "We'll catch up straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.21,
      "end_seconds": 374.33,
      "duration_seconds": 2.12,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.86,
      "end_seconds": 379.67,
      "duration_seconds": 3.81,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.54,
      "end_seconds": 385.59,
      "duration_seconds": 4.05,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.84,
      "end_seconds": 388.06,
      "duration_seconds": 1.22,
      "text": "Take care now."
    }
  ]
}