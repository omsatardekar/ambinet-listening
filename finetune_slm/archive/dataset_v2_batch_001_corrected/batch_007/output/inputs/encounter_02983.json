{
  "schema_version": "1.0",
  "encounter_id": "02983",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.32,
      "end_seconds": 5.51,
      "duration_seconds": 4.19,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.87,
      "end_seconds": 10.86,
      "duration_seconds": 3.99,
      "text": "So, perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.92,
      "end_seconds": 17.27,
      "duration_seconds": 5.35,
      "text": "It's swollen glands. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.7,
      "end_seconds": 22.83,
      "duration_seconds": 4.13,
      "text": "Alright, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.46,
      "end_seconds": 32.32,
      "duration_seconds": 3.86,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.51,
      "end_seconds": 36.33,
      "duration_seconds": 2.82,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.74,
      "end_seconds": 67.45,
      "duration_seconds": 29.71,
      "text": "Sorry, what was I saying, about a four out of ten. And a recent new medicine, too. About recent new medicine, mostly mild. Oh, and swollen face. About swollen face, I'd say every other day. And a widespread rash with fever, too. Erm, about widespread rash with fever, it's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 80.04,
      "duration_seconds": 4.8,
      "text": "Okay, and what about blisters, breathing difficulty or mouth sores?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.75,
      "end_seconds": 86.31,
      "duration_seconds": 4.56,
      "text": "Let me think, no, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.68,
      "end_seconds": 90.81,
      "duration_seconds": 4.13,
      "text": "Hm, okay. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.44,
      "end_seconds": 95.21,
      "duration_seconds": 2.77,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.43,
      "end_seconds": 102.94,
      "duration_seconds": 2.51,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.81,
      "end_seconds": 107.01,
      "duration_seconds": 2.2,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.48,
      "end_seconds": 120.47,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.99,
      "end_seconds": 137.47,
      "duration_seconds": 15.48,
      "text": "I take iron tablets, once a day. I, I take alendronate, 70 milligrams, once a week for my bones. I'm on allopurinol, 300 milligrams, started four weeks ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 139.47,
      "end_seconds": 144.86,
      "duration_seconds": 5.39,
      "text": "Doctor, our chart from the last visit lists it as 600 milligrams."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 149.95,
      "duration_seconds": 4.55,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.96,
      "end_seconds": 156.26,
      "duration_seconds": 4.3,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.3,
      "end_seconds": 162.25,
      "duration_seconds": 3.95,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.0,
      "end_seconds": 166.84,
      "duration_seconds": 3.84,
      "text": "I have low haemoglobin, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.74,
      "end_seconds": 169.72,
      "duration_seconds": 0.98,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.43,
      "end_seconds": 173.51,
      "duration_seconds": 2.08,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.66,
      "end_seconds": 184.99,
      "duration_seconds": 10.33,
      "text": "Understood. Right, so low haemoglobin is already on your record. We'll keep that in mind today. Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.01,
      "end_seconds": 188.32,
      "duration_seconds": 2.31,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.18,
      "end_seconds": 191.17,
      "duration_seconds": 1.99,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.6,
      "end_seconds": 198.51,
      "duration_seconds": 5.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.44,
      "end_seconds": 222.62,
      "duration_seconds": 5.18,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.86,
      "end_seconds": 230.24,
      "duration_seconds": 6.38,
      "text": "I'm allergic to grass pollen, I get sneezing. Yes, tramadol. I get vomiting."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.57,
      "end_seconds": 234.37,
      "duration_seconds": 2.8,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.28,
      "end_seconds": 240.5,
      "duration_seconds": 5.22,
      "text": "My mother has an underactive thyroid. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 241.58,
      "end_seconds": 251.82,
      "duration_seconds": 10.24,
      "text": "Here are the numbers, doctor. Heart rate 91, BP is 112 over 69. Respiratory rate 21, temp 38.8 degrees, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.03,
      "end_seconds": 256.73,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.51,
      "end_seconds": 260.95,
      "duration_seconds": 2.44,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.93,
      "end_seconds": 264.27,
      "duration_seconds": 2.34,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.88,
      "end_seconds": 289.25,
      "duration_seconds": 7.37,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.67,
      "end_seconds": 324.13,
      "duration_seconds": 30.46,
      "text": "Okay, that's enough for me. I want urgent blood tests done, that's for severe drug reaction. The treatment will be prednisolone, 40 milligrams, once a day, until review. You take it by mouth. That should help with severe drug reaction. Stop the allopurinol now and you need admission. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.7,
      "end_seconds": 332.78,
      "duration_seconds": 3.08,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.76,
      "end_seconds": 342.12,
      "duration_seconds": 7.36,
      "text": "Do get help quickly if the symptoms get worse. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 344.19,
      "end_seconds": 344.89,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.43,
      "end_seconds": 351.78,
      "duration_seconds": 5.35,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.17,
      "end_seconds": 357.22,
      "duration_seconds": 4.05,
      "text": "Hmm, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.47,
      "end_seconds": 359.73,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}