{
  "schema_version": "1.0",
  "encounter_id": "02687",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 2.39,
      "duration_seconds": 1.62,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.26,
      "end_seconds": 7.96,
      "duration_seconds": 3.7,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.49,
      "end_seconds": 17.59,
      "duration_seconds": 9.1,
      "text": "Okay, so honestly, it's a new headache at the temple, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.36,
      "end_seconds": 21.77,
      "duration_seconds": 3.41,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.68,
      "end_seconds": 31.47,
      "duration_seconds": 8.79,
      "text": "I've, I've had it for two weeks. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.07,
      "end_seconds": 38.17,
      "duration_seconds": 5.1,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.59,
      "end_seconds": 62.71,
      "duration_seconds": 23.12,
      "text": "Touching definitely sets it off. Maybe a three out of ten on a bad day. I kept putting it off, which I know isn't sensible. I've never really been one for hospitals. And there's a scalp that hurts to brush as well, two days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.08,
      "end_seconds": 83.35,
      "duration_seconds": 4.27,
      "text": "A few quick ones: weight loss or shoulder stiffness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.35,
      "end_seconds": 89.1,
      "duration_seconds": 3.75,
      "text": "No, no weight loss or shoulder stiffness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.77,
      "end_seconds": 91.88,
      "duration_seconds": 2.11,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 95.99,
      "duration_seconds": 2.38,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.29,
      "end_seconds": 98.89,
      "duration_seconds": 1.6,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.32,
      "end_seconds": 107.22,
      "duration_seconds": 2.9,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.64,
      "end_seconds": 110.34,
      "duration_seconds": 1.7,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.15,
      "end_seconds": 114.56,
      "duration_seconds": 2.41,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.31,
      "end_seconds": 118.62,
      "duration_seconds": 3.31,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.76,
      "end_seconds": 121.25,
      "duration_seconds": 1.49,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.97,
      "end_seconds": 132.49,
      "duration_seconds": 5.52,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.05,
      "end_seconds": 148.35,
      "duration_seconds": 14.3,
      "text": "My husband and I live above the shop. I drink a lot of tea and snack through the day. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.83,
      "end_seconds": 165.12,
      "duration_seconds": 2.29,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.17,
      "end_seconds": 170.11,
      "duration_seconds": 2.94,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.18,
      "end_seconds": 174.1,
      "duration_seconds": 2.92,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.74,
      "end_seconds": 177.32,
      "duration_seconds": 2.58,
      "text": "Ah, no allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.81,
      "end_seconds": 193.99,
      "duration_seconds": 4.18,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.13,
      "end_seconds": 209.23,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.15,
      "end_seconds": 238.58,
      "duration_seconds": 8.43,
      "text": "Okay: pulse is 69 beats a minute, BP is 126 over 71, temperature 36.6. And saturation 97 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.12,
      "end_seconds": 245.12,
      "duration_seconds": 2.0,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.54,
      "end_seconds": 249.19,
      "duration_seconds": 2.65,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.49,
      "end_seconds": 254.13,
      "duration_seconds": 3.64,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.08,
      "end_seconds": 258.54,
      "duration_seconds": 2.46,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.78,
      "end_seconds": 273.2,
      "duration_seconds": 4.42,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 277.74,
      "duration_seconds": 2.34,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.85,
      "end_seconds": 319.02,
      "duration_seconds": 30.17,
      "text": "I'd like to arrange a temporal artery biopsy for possible giant cell arteritis. What I'm giving you is prednisolone, 60 milligrams, once a day, until review. You take it by mouth. That should help with possible giant cell arteritis. Start the steroid today, this is to protect your sight. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.25,
      "end_seconds": 323.04,
      "duration_seconds": 3.79,
      "text": "Mm, okay. We'll refer you to the rheumatology team."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.11,
      "end_seconds": 329.68,
      "duration_seconds": 2.57,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.5,
      "end_seconds": 334.77,
      "duration_seconds": 3.27,
      "text": "I'd like to see you again tomorrow."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.51,
      "end_seconds": 340.24,
      "duration_seconds": 3.73,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.95,
      "end_seconds": 346.37,
      "duration_seconds": 4.42,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.55,
      "end_seconds": 351.12,
      "duration_seconds": 3.57,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}