{
  "schema_version": "1.0",
  "encounter_id": "02854",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 7.24,
      "duration_seconds": 6.34,
      "text": "Okay, so hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 12.77,
      "duration_seconds": 3.98,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.81,
      "end_seconds": 26.64,
      "duration_seconds": 11.83,
      "text": "Hello, doctor. I'm here with them in case I can help. Mm, doctor, it's tiredness. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.88,
      "end_seconds": 30.24,
      "duration_seconds": 2.36,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.52,
      "end_seconds": 36.61,
      "duration_seconds": 5.09,
      "text": "So, uh, it's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.2,
      "end_seconds": 40.78,
      "duration_seconds": 2.58,
      "text": "Right, any aching muscles as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.41,
      "end_seconds": 58.03,
      "duration_seconds": 15.62,
      "text": "uh, yeah. Four weeks, I'd say. As for aching muscles, I'd call it severe. A mild headache was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.94,
      "end_seconds": 68.79,
      "duration_seconds": 1.85,
      "text": "Nothing like facial weakness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.67,
      "end_seconds": 72.7,
      "duration_seconds": 2.03,
      "text": "Definitely no facial weakness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.85,
      "end_seconds": 78.14,
      "duration_seconds": 4.29,
      "text": "A few quick ones: joint swelling, stiff neck or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.28,
      "end_seconds": 84.67,
      "duration_seconds": 5.39,
      "text": "No, um, no joint swelling, stiff neck or palpitations."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.65,
      "end_seconds": 88.78,
      "duration_seconds": 2.13,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.12,
      "end_seconds": 92.08,
      "duration_seconds": 1.96,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.76,
      "end_seconds": 98.42,
      "duration_seconds": 4.66,
      "text": "So, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.34,
      "end_seconds": 103.96,
      "duration_seconds": 3.62,
      "text": "Uh, no, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 111.84,
      "duration_seconds": 3.92,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 112.61,
      "end_seconds": 121.35,
      "duration_seconds": 8.74,
      "text": "it's tamsulosin, 0.4 milligrams, at night, doctor. He takes diclofenac, 50 milligrams, when needed"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.12,
      "end_seconds": 126.25,
      "duration_seconds": 3.13,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 127.53,
      "end_seconds": 138.22,
      "duration_seconds": 10.69,
      "text": "about about three months right, he is on losartan, once a day for my blood pressure, I give it to him"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.31,
      "end_seconds": 141.72,
      "duration_seconds": 2.41,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 142.76,
      "end_seconds": 145.19,
      "duration_seconds": 2.43,
      "text": "it's, It's 50 milligrams"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.48,
      "end_seconds": 153.64,
      "duration_seconds": 5.16,
      "text": "Before this I was on ramipril; that's been stopped."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.52,
      "end_seconds": 157.25,
      "duration_seconds": 2.73,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.22,
      "end_seconds": 170.08,
      "duration_seconds": 10.86,
      "text": "I look after my grandchildren most days. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.91,
      "end_seconds": 175.5,
      "duration_seconds": 3.59,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.23,
      "end_seconds": 188.87,
      "duration_seconds": 12.64,
      "text": "Oh, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.47,
      "end_seconds": 192.71,
      "duration_seconds": 3.24,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.21,
      "end_seconds": 196.58,
      "duration_seconds": 3.37,
      "text": "Well, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.67,
      "end_seconds": 208.51,
      "duration_seconds": 4.84,
      "text": "Right, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.02,
      "end_seconds": 221.0,
      "duration_seconds": 10.98,
      "text": "An enlarged prostate, for two years. I've had arthritis in my knees, yes. High blood pressure, for about ten years"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.47,
      "end_seconds": 225.03,
      "duration_seconds": 2.56,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.56,
      "end_seconds": 237.05,
      "duration_seconds": 3.49,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.69,
      "end_seconds": 252.68,
      "duration_seconds": 4.99,
      "text": "Okay: heart rate 72, respiratory rate 15, blood pressure 124 over 70."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.5,
      "end_seconds": 256.17,
      "duration_seconds": 1.67,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.75,
      "end_seconds": 258.98,
      "duration_seconds": 2.23,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.12,
      "end_seconds": 263.78,
      "duration_seconds": 3.66,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.01,
      "end_seconds": 279.23,
      "duration_seconds": 1.22,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.82,
      "end_seconds": 283.18,
      "duration_seconds": 2.36,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.59,
      "end_seconds": 304.65,
      "duration_seconds": 6.06,
      "text": "there is an expanding ring-shaped red patch, about eight centimetres across, on the thigh"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.1,
      "end_seconds": 327.06,
      "duration_seconds": 16.96,
      "text": "Okay, that's enough for me. So where does that leave us? My working impression is early Lyme disease. Another possibility is cellulitis. Take the doxycycline with food and avoid strong sun. Is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.8,
      "end_seconds": 332.6,
      "duration_seconds": 4.8,
      "text": "Okay, uh, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.2,
      "end_seconds": 334.54,
      "duration_seconds": 1.34,
      "text": "all the best"
    }
  ]
}