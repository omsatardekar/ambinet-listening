      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.11,
      "end_seconds": 373.72,
      "duration_seconds": 16.61,
      "text": "you need hospital fluids and treatment now let's get you seen by the emergency team I'll arrange the letter and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
