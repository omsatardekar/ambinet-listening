      "role": "DOCTOR",
      "start_seconds": 250.19,
      "end_seconds": 265.77,
      "duration_seconds": 15.58,
      "text": "okay: SpO2 98 percent on room air, temp 36.7 degrees, height 176 centimetres, BMI works out to 18.1, BP is 97 over 58, respiratory rate 18, pulse 93, weight 56 kilos"
    },
    {
      "segment_id": "SEG0032",
