      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.74,
      "end_seconds": 376.76,
      "duration_seconds": 2.02,
      "text": "that's fine by me"
    },
