{
  "schema_version": "1.0",
  "encounter_id": "02529",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 4.18,
      "duration_seconds": 3.03,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.8,
      "end_seconds": 7.73,
      "duration_seconds": 2.93,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.34,
      "end_seconds": 11.88,
      "duration_seconds": 2.54,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.42,
      "end_seconds": 16.55,
      "duration_seconds": 3.13,
      "text": "I've been dealing with sneezing in spring."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.0,
      "end_seconds": 22.83,
      "duration_seconds": 5.83,
      "text": "Yes, carry on. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.96,
      "end_seconds": 37.06,
      "duration_seconds": 13.1,
      "text": "Pretty severe, if I'm being honest. I'd say every other day. Pollen definitely sets it off. I've also had watery eyes, since yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.4,
      "end_seconds": 43.25,
      "duration_seconds": 4.85,
      "text": "What about a runny itchy nose, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.59,
      "end_seconds": 48.12,
      "duration_seconds": 1.53,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.57,
      "end_seconds": 51.98,
      "duration_seconds": 2.41,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.68,
      "end_seconds": 55.86,
      "duration_seconds": 2.18,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.82,
      "end_seconds": 60.72,
      "duration_seconds": 2.9,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.13,
      "end_seconds": 75.25,
      "duration_seconds": 3.12,
      "text": "Alright, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.75,
      "end_seconds": 103.34,
      "duration_seconds": 12.59,
      "text": "Okay: BMI works out to 23.5, pressure 109 over 71. And heart rate 74, temperature 36.8, respiratory rate 16, weight 72 kilos, height 175 centimetres."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.3,
      "end_seconds": 109.61,
      "duration_seconds": 4.31,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.81,
      "end_seconds": 112.42,
      "duration_seconds": 1.61,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.95,
      "end_seconds": 136.48,
      "duration_seconds": 5.53,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.38,
      "end_seconds": 144.53,
      "duration_seconds": 4.15,
      "text": "Please sit back down. Did you notice any wheeze?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.96,
      "end_seconds": 147.52,
      "duration_seconds": 1.56,
      "text": "Nope, no wheeze."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.9,
      "end_seconds": 153.31,
      "duration_seconds": 4.41,
      "text": "And what about fever, facial pain or loss of smell?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.24,
      "end_seconds": 161.85,
      "duration_seconds": 2.61,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.92,
      "end_seconds": 166.29,
      "duration_seconds": 2.37,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.82,
      "end_seconds": 169.45,
      "duration_seconds": 1.63,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.38,
      "end_seconds": 175.5,
      "duration_seconds": 4.12,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.03,
      "end_seconds": 177.96,
      "duration_seconds": 1.93,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.75,
      "end_seconds": 193.98,
      "duration_seconds": 2.23,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.64,
      "end_seconds": 196.86,
      "duration_seconds": 1.22,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.28,
      "end_seconds": 203.32,
      "duration_seconds": 5.04,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.09,
      "end_seconds": 213.35,
      "duration_seconds": 5.26,
      "text": "Diclofenac. I come out in... well, swelling of my lips."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.63,
      "end_seconds": 217.04,
      "duration_seconds": 2.41,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.64,
      "end_seconds": 225.91,
      "duration_seconds": 7.27,
      "text": "Erm, um, yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.48,
      "end_seconds": 230.25,
      "duration_seconds": 3.77,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.94,
      "end_seconds": 234.55,
      "duration_seconds": 3.61,
      "text": "It's gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.83,
      "end_seconds": 235.53,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.01,
      "end_seconds": 240.51,
      "duration_seconds": 3.5,
      "text": "Loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.47,
      "end_seconds": 245.2,
      "duration_seconds": 3.73,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.18,
      "end_seconds": 249.1,
      "duration_seconds": 1.92,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.12,
      "end_seconds": 253.02,
      "duration_seconds": 1.9,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.56,
      "end_seconds": 260.63,
      "duration_seconds": 4.07,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.75,
      "end_seconds": 263.32,
      "duration_seconds": 1.57,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.74,
      "end_seconds": 268.36,
      "duration_seconds": 3.62,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.94,
      "end_seconds": 271.91,
      "duration_seconds": 2.97,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.79,
      "end_seconds": 276.23,
      "duration_seconds": 3.44,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.54,
      "end_seconds": 297.96,
      "duration_seconds": 4.42,
      "text": "Taking everything into account, it points towards seasonal allergic rhinitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.53,
      "end_seconds": 302.35,
      "duration_seconds": 2.82,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.44,
      "end_seconds": 311.4,
      "duration_seconds": 7.96,
      "text": "I understand the worry. At the moment I'd say it's seasonal allergic rhinitis, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.62,
      "end_seconds": 345.12,
      "duration_seconds": 25.5,
      "text": "What I'm giving you is fluticasone nasal spray, 50 micrograms, once a day, the season. That should help with hay fever. Shower after being outdoors and keep windows shut when pollen is high. Please don't wait if the symptoms get worse. That's when to be seen urgently. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.1,
      "end_seconds": 350.76,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.94,
      "end_seconds": 353.14,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}