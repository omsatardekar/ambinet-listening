  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 2.71,
      "duration_seconds": 1.64,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.8,
      "end_seconds": 8.68,
      "duration_seconds": 4.88,
      "text": "hi doctor, I got here as fast as I could"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.29,
      "end_seconds": 10.93,
      "duration_seconds": 1.64,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 17.6,
      "duration_seconds": 5.55,
      "text": "Well, I've been having bright red blood on the paper."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.82,
      "end_seconds": 22.56,
      "duration_seconds": 3.74,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.01,
      "end_seconds": 29.49,
      "duration_seconds": 5.48,
      "text": "probably four weeks yeah i had itching before that's settled now, though"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.15,
      "end_seconds": 43.79,
      "duration_seconds": 2.64,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.54,
      "end_seconds": 59.7,
      "duration_seconds": 2.16,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.03,
      "end_seconds": 90.41,
      "duration_seconds": 16.38,
      "text": "okay: height 168 centimetres, BMI works out to 34.0, pulse is 84 beats a minute, oxygen saturation is 98 percent, pressure 126 over 76, weight 96 kilos, temperature is 36.8 degrees"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.09,
      "end_seconds": 97.62,
      "duration_seconds": 4.53,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.57,
      "end_seconds": 101.38,
      "duration_seconds": 1.81,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.19,
      "end_seconds": 106.64,
      "duration_seconds": 3.45,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.51,
      "end_seconds": 123.32,
      "duration_seconds": 8.81,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.35,
      "end_seconds": 135.68,
      "duration_seconds": 8.33,
      "text": "you can sit up now right, did you get tummy pain, change in bowel habit or black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.2,
      "end_seconds": 138.82,
      "duration_seconds": 2.62,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.76,
      "end_seconds": 142.67,
      "duration_seconds": 1.91,
      "text": "What about weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.69,
      "end_seconds": 145.68,
      "duration_seconds": 1.99,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.3,
      "end_seconds": 150.68,
      "duration_seconds": 3.38,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.96,
      "end_seconds": 154.49,
      "duration_seconds": 2.53,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.56,
      "end_seconds": 159.46,
      "duration_seconds": 3.9,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 164.47,
      "duration_seconds": 4.07,
      "text": "well, um, no, that's all normal"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.77,
      "end_seconds": 169.32,
      "duration_seconds": 3.55,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.23,
      "end_seconds": 188.67,
      "duration_seconds": 17.44,
      "text": "COPD, for nearly five years. A neighbour of mine said I should see someone about it. I've had gout, yes. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.45,
      "end_seconds": 192.03,
      "duration_seconds": 2.58,
      "text": "alright, is there anything more?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.06,
      "end_seconds": 200.42,
      "duration_seconds": 6.36,
      "text": "Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.95,
      "end_seconds": 213.72,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.13,
      "end_seconds": 218.37,
      "duration_seconds": 3.24,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.97,
      "end_seconds": 222.23,
      "duration_seconds": 3.26,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.3,
      "end_seconds": 229.44,
      "duration_seconds": 5.14,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.0,
      "end_seconds": 232.78,
      "duration_seconds": 1.78,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.29,
      "end_seconds": 235.6,
      "duration_seconds": 2.31,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.25,
      "end_seconds": 241.02,
      "duration_seconds": 4.77,
      "text": "Any allergies to tablets, food or anything in the the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.68,
      "end_seconds": 244.16,
      "duration_seconds": 2.48,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.3,
      "end_seconds": 248.99,
      "duration_seconds": 3.69,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.77,
      "end_seconds": 265.1,
      "duration_seconds": 14.33,
      "text": "Allopurinol. I take it 100 milligrams, once a day. Hmm, you know, I had Tiotropium inhaler at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.51,
      "end_seconds": 288.05,
      "duration_seconds": 11.54,
      "text": "Let me tell you where I've got to. I'd lean towards haemorrhoids. It could also be an anal fissure, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.77,
      "end_seconds": 291.44,
      "duration_seconds": 2.67,
      "text": "So, will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.44,
      "end_seconds": 323.93,
      "duration_seconds": 30.49,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a blood count is back. a blood count is what I'd like next, for rectal bleeding. I'll start you on lactulose, 15 ml, twice a day, four weeks. That should help with constipation. Eat more fibre and drink water. See me again in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.27,
      "end_seconds": 328.44,
      "duration_seconds": 3.17,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}