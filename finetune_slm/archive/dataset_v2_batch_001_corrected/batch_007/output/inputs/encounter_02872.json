{
  "schema_version": "1.0",
  "encounter_id": "02872",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.52,
      "duration_seconds": 4.68,
      "text": "Morning, you know, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 10.66,
      "duration_seconds": 3.62,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.93,
      "end_seconds": 18.44,
      "duration_seconds": 6.51,
      "text": "Doctor, uh, it's my heart suddenly racing. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.15,
      "end_seconds": 23.54,
      "duration_seconds": 3.39,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.97,
      "end_seconds": 30.58,
      "duration_seconds": 5.61,
      "text": "Just since yesterday. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.57,
      "end_seconds": 37.99,
      "duration_seconds": 5.42,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.76,
      "end_seconds": 41.54,
      "duration_seconds": 2.78,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.35,
      "end_seconds": 46.3,
      "duration_seconds": 2.95,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.34,
      "end_seconds": 57.87,
      "duration_seconds": 9.53,
      "text": "It usually comes with it stopping just as suddenly. The it stopping just as suddenly? That's been since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.6,
      "end_seconds": 67.56,
      "duration_seconds": 4.96,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.32,
      "end_seconds": 72.15,
      "duration_seconds": 2.83,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.41,
      "end_seconds": 89.82,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.95,
      "end_seconds": 95.54,
      "duration_seconds": 4.59,
      "text": "Let me think, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 100.68,
      "duration_seconds": 3.26,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.32,
      "end_seconds": 103.36,
      "duration_seconds": 2.04,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.8,
      "end_seconds": 125.49,
      "duration_seconds": 3.69,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.05,
      "end_seconds": 129.92,
      "duration_seconds": 3.87,
      "text": "Actually, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.48,
      "end_seconds": 134.22,
      "duration_seconds": 2.74,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 148.58,
      "duration_seconds": 12.59,
      "text": "I hardly move around during the day. I grab fast food at lunch most days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.32,
      "end_seconds": 153.53,
      "duration_seconds": 4.21,
      "text": "Have you noticed breathlessness or family history of sudden death?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.55,
      "end_seconds": 161.38,
      "duration_seconds": 5.83,
      "text": "I haven't had breathlessness or family history of sudden death, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.99,
      "end_seconds": 167.12,
      "duration_seconds": 4.13,
      "text": "Right, a few quick ones: fainting or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.74,
      "end_seconds": 172.63,
      "duration_seconds": 3.89,
      "text": "No fainting or chest pain, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.98,
      "end_seconds": 176.45,
      "duration_seconds": 2.47,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.0,
      "end_seconds": 179.09,
      "duration_seconds": 1.09,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.74,
      "end_seconds": 199.89,
      "duration_seconds": 3.15,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.3,
      "end_seconds": 215.96,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.99,
      "end_seconds": 248.62,
      "duration_seconds": 12.63,
      "text": "Okay: BMI works out to 27.6, weight 68 kilos, height 157 centimetres, heart rate 68, BP is 111 over 81, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.14,
      "end_seconds": 253.84,
      "duration_seconds": 3.7,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.71,
      "end_seconds": 258.02,
      "duration_seconds": 2.31,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.97,
      "end_seconds": 280.83,
      "duration_seconds": 3.86,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.24,
      "end_seconds": 289.07,
      "duration_seconds": 2.83,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.8,
      "end_seconds": 302.34,
      "duration_seconds": 5.54,
      "text": "Taking everything into account, the most likely explanation is episodes of supraventricular tachycardia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.78,
      "end_seconds": 305.13,
      "duration_seconds": 1.35,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.19,
      "end_seconds": 323.13,
      "duration_seconds": 15.94,
      "text": "I understand the worry. At the moment I'd say it's episodes of supraventricular tachycardia, and we'll watch how it goes. Today I'm not changing anything. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.53,
      "end_seconds": 326.85,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.76,
      "end_seconds": 329.55,
      "duration_seconds": 1.79,
      "text": "Have a good day."
    }
  ]
}