{
  "schema_version": "1.0",
  "encounter_id": "02909",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 4.74,
      "duration_seconds": 3.54,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.02,
      "end_seconds": 7.04,
      "duration_seconds": 1.02,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.43,
      "end_seconds": 11.07,
      "duration_seconds": 2.64,
      "text": "Did you take the bus in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.77,
      "end_seconds": 16.03,
      "duration_seconds": 3.26,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.26,
      "end_seconds": 20.18,
      "duration_seconds": 2.92,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.06,
      "end_seconds": 27.24,
      "duration_seconds": 5.18,
      "text": "It's severe tummy pain out of proportion to the examination, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.21,
      "end_seconds": 30.96,
      "duration_seconds": 2.75,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.07,
      "end_seconds": 39.15,
      "duration_seconds": 2.08,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.16,
      "end_seconds": 66.21,
      "duration_seconds": 12.05,
      "text": "Okay: temperature 37.1, pulse is 108 beats a minute, saturation 97 percent, pressure 127 over 72. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.25,
      "end_seconds": 70.19,
      "duration_seconds": 1.94,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.73,
      "end_seconds": 75.98,
      "duration_seconds": 5.25,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 89.48,
      "duration_seconds": 12.76,
      "text": "I'd say every other day. Maybe a three out of ten on a bad day. Oh, and bloody diarrhoea. There was vomiting, yes, but that went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 109.49,
      "duration_seconds": 4.45,
      "text": "Have you had any hernia, fever or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.69,
      "end_seconds": 115.75,
      "duration_seconds": 5.06,
      "text": "No hernia, fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.84,
      "end_seconds": 120.87,
      "duration_seconds": 3.03,
      "text": "So, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.93,
      "end_seconds": 126.47,
      "duration_seconds": 3.54,
      "text": "Nothing on the skin, uh, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.22,
      "end_seconds": 149.53,
      "duration_seconds": 4.31,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.17,
      "end_seconds": 153.58,
      "duration_seconds": 3.41,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.95,
      "end_seconds": 164.49,
      "duration_seconds": 6.54,
      "text": "Okay, any medical conditions, anything you've been treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.48,
      "end_seconds": 168.71,
      "duration_seconds": 3.23,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.63,
      "end_seconds": 174.44,
      "duration_seconds": 3.81,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.2,
      "end_seconds": 187.07,
      "duration_seconds": 10.87,
      "text": "I'm on a blood thinner, 5 milligrams, stopped last month. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.23,
      "end_seconds": 190.62,
      "duration_seconds": 2.39,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.75,
      "end_seconds": 193.18,
      "duration_seconds": 1.43,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.06,
      "end_seconds": 196.4,
      "duration_seconds": 2.34,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.82,
      "end_seconds": 203.23,
      "duration_seconds": 2.41,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.17,
      "end_seconds": 207.75,
      "duration_seconds": 2.58,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.57,
      "end_seconds": 214.29,
      "duration_seconds": 3.72,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.53,
      "end_seconds": 217.69,
      "duration_seconds": 2.16,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.1,
      "end_seconds": 221.54,
      "duration_seconds": 2.44,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.0,
      "end_seconds": 225.51,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.2,
      "end_seconds": 229.97,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.13,
      "end_seconds": 253.48,
      "duration_seconds": 9.35,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.79,
      "end_seconds": 259.58,
      "duration_seconds": 2.79,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.66,
      "end_seconds": 282.94,
      "duration_seconds": 7.28,
      "text": "Okay, thinking it through, it points towards possible bowel ischaemia. Pancreatitis is also on my list."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.75,
      "end_seconds": 286.71,
      "duration_seconds": 1.96,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.95,
      "end_seconds": 302.76,
      "duration_seconds": 14.81,
      "text": "It's reasonable to be concerned, but right now possible bowel ischaemia is my leading thought, not anything worse. I'd like to arrange an urgent CT angiogram for possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.54,
      "end_seconds": 306.8,
      "duration_seconds": 2.26,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.31,
      "end_seconds": 331.56,
      "duration_seconds": 23.25,
      "text": "I'd like to arrange urgent blood tests for severe abdominal pain. The result will help us decide whether anything more is needed. This is an emergency, you are going to hospital now. Let's plan a check straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.08,
      "end_seconds": 333.76,
      "duration_seconds": 1.68,
      "text": "That's clear, thanks."
    }
  ]
}