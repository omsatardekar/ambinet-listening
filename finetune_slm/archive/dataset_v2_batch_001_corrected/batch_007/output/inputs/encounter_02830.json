{
  "schema_version": "1.0",
  "encounter_id": "02830",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.26,
      "duration_seconds": 5.04,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.13,
      "end_seconds": 15.45,
      "duration_seconds": 5.32,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.14,
      "end_seconds": 21.87,
      "duration_seconds": 5.73,
      "text": "Doctor, it's swollen glands. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.4,
      "end_seconds": 25.25,
      "duration_seconds": 2.85,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.86,
      "end_seconds": 52.06,
      "duration_seconds": 21.2,
      "text": "It's been going on for ten days. I told myself I'd wait and see, and here I am. And a widespread rash with fever, too. With widespread rash with fever, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.29,
      "end_seconds": 65.44,
      "duration_seconds": 4.15,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.15,
      "end_seconds": 74.59,
      "duration_seconds": 2.44,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.54,
      "end_seconds": 100.67,
      "duration_seconds": 12.13,
      "text": "Okay: BMI works out to 24.6, weight 63 kilos, temperature is 38.3 degrees. And pulse 99, height 160 centimetres, pressure 111 over 74."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.57,
      "end_seconds": 104.1,
      "duration_seconds": 1.53,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.99,
      "end_seconds": 109.71,
      "duration_seconds": 4.72,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.99,
      "end_seconds": 115.49,
      "duration_seconds": 3.5,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.41,
      "end_seconds": 119.45,
      "duration_seconds": 2.04,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.15,
      "end_seconds": 142.1,
      "duration_seconds": 6.95,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.54,
      "end_seconds": 147.49,
      "duration_seconds": 2.95,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.6,
      "end_seconds": 166.3,
      "duration_seconds": 1.7,
      "text": "Nothing like breathing difficulty?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.86,
      "end_seconds": 170.13,
      "duration_seconds": 2.27,
      "text": "No breathing difficulty, thankfully."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.34,
      "end_seconds": 173.42,
      "duration_seconds": 3.08,
      "text": "Right, right. Any mouth sores or blisters?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.36,
      "end_seconds": 177.86,
      "duration_seconds": 2.5,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.3,
      "end_seconds": 181.27,
      "duration_seconds": 1.97,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.1,
      "end_seconds": 185.83,
      "duration_seconds": 2.73,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.91,
      "end_seconds": 189.15,
      "duration_seconds": 2.24,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.13,
      "end_seconds": 192.72,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.72,
      "end_seconds": 196.02,
      "duration_seconds": 2.3,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.35,
      "end_seconds": 203.24,
      "duration_seconds": 5.89,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.29,
      "end_seconds": 214.61,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.33,
      "end_seconds": 219.14,
      "duration_seconds": 2.81,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.11,
      "end_seconds": 224.01,
      "duration_seconds": 3.9,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.09,
      "end_seconds": 231.0,
      "duration_seconds": 2.91,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.87,
      "end_seconds": 235.56,
      "duration_seconds": 2.69,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.14,
      "end_seconds": 239.99,
      "duration_seconds": 3.85,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.47,
      "end_seconds": 244.29,
      "duration_seconds": 2.82,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.52,
      "end_seconds": 248.53,
      "duration_seconds": 3.01,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.05,
      "end_seconds": 251.78,
      "duration_seconds": 2.73,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.76,
      "end_seconds": 255.52,
      "duration_seconds": 2.76,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.59,
      "end_seconds": 268.04,
      "duration_seconds": 5.45,
      "text": "Okay, thinking it through, the most likely explanation is a severe drug reaction."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.36,
      "end_seconds": 271.28,
      "duration_seconds": 1.92,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 309.34,
      "duration_seconds": 37.25,
      "text": "I can't promise yet, but most people with a severe drug reaction do well once it's treated properly. I'm sending you for urgent blood tests because of severe drug reaction. I'm going to put you on prednisolone, 40 milligrams, once a day, until review. You take it by mouth. That's for severe drug reaction. I'll put all of this in writing so you don't have to remember it. Stop the allopurinol now and you need admission."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.77,
      "end_seconds": 317.04,
      "duration_seconds": 6.27,
      "text": "We'll refer you to the dermatology team. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.55,
      "end_seconds": 321.07,
      "duration_seconds": 3.52,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.7,
      "end_seconds": 326.57,
      "duration_seconds": 4.87,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.84,
      "end_seconds": 334.08,
      "duration_seconds": 3.24,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.3,
      "end_seconds": 336.66,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    }
  ]
}