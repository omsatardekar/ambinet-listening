{
  "schema_version": "1.0",
  "encounter_id": "02660",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.89,
      "duration_seconds": 5.76,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.67,
      "end_seconds": 16.47,
      "duration_seconds": 3.8,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.9,
      "end_seconds": 24.31,
      "duration_seconds": 3.41,
      "text": "I'm here because of periods becoming irregular."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.03,
      "end_seconds": 29.36,
      "duration_seconds": 4.33,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.67,
      "end_seconds": 38.73,
      "duration_seconds": 8.06,
      "text": "Valsartan. I take it 80 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.87,
      "end_seconds": 43.57,
      "duration_seconds": 3.7,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.18,
      "end_seconds": 47.88,
      "duration_seconds": 3.7,
      "text": "It's, It's been two days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 51.86,
      "duration_seconds": 3.44,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.8,
      "end_seconds": 57.29,
      "duration_seconds": 3.49,
      "text": "Mostly moderate. I've also had poor sleep."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.23,
      "end_seconds": 61.35,
      "duration_seconds": 3.12,
      "text": "Have you had any bleeding after sex?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.06,
      "end_seconds": 67.01,
      "duration_seconds": 4.95,
      "text": "Not that I've noticed, no bleeding after sex."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.02,
      "end_seconds": 72.44,
      "duration_seconds": 4.42,
      "text": "Have you noticed very heavy bleeding, weight loss or pelvic pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.42,
      "end_seconds": 76.62,
      "duration_seconds": 3.2,
      "text": "Ah, nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.26,
      "end_seconds": 81.2,
      "duration_seconds": 3.94,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.69,
      "end_seconds": 85.93,
      "duration_seconds": 3.24,
      "text": "I mean, no, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.87,
      "end_seconds": 89.15,
      "duration_seconds": 2.28,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.7,
      "end_seconds": 94.57,
      "duration_seconds": 3.87,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.4,
      "end_seconds": 112.76,
      "duration_seconds": 4.36,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.55,
      "end_seconds": 121.07,
      "duration_seconds": 3.52,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.86,
      "end_seconds": 124.22,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.31,
      "end_seconds": 128.47,
      "duration_seconds": 3.16,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.18,
      "end_seconds": 132.49,
      "duration_seconds": 2.31,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.02,
      "end_seconds": 139.08,
      "duration_seconds": 6.06,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.17,
      "end_seconds": 143.98,
      "duration_seconds": 2.81,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.78,
      "end_seconds": 153.15,
      "duration_seconds": 5.37,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.55,
      "end_seconds": 157.0,
      "duration_seconds": 2.45,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.1,
      "end_seconds": 165.65,
      "duration_seconds": 7.55,
      "text": "Hmm, um, I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.49,
      "end_seconds": 172.56,
      "duration_seconds": 5.07,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 176.6,
      "end_seconds": 185.6,
      "duration_seconds": 9.0,
      "text": "Okay, so the vitals from earlier. Pulse is 65 beats a minute, blood pressure 128 over 69, temperature 36.9."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.13,
      "end_seconds": 193.54,
      "duration_seconds": 1.41,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.39,
      "end_seconds": 198.75,
      "duration_seconds": 2.36,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.68,
      "end_seconds": 201.38,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.55,
      "end_seconds": 203.91,
      "duration_seconds": 1.36,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.45,
      "end_seconds": 222.06,
      "duration_seconds": 4.61,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.35,
      "end_seconds": 226.51,
      "duration_seconds": 2.16,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.41,
      "end_seconds": 250.35,
      "duration_seconds": 8.94,
      "text": "Putting it all together, this looks most like perimenopause. It could also be a thyroid problem, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.42,
      "end_seconds": 255.48,
      "duration_seconds": 3.06,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.35,
      "end_seconds": 266.44,
      "duration_seconds": 10.09,
      "text": "I understand the worry. At the moment I'd say it's perimenopause, and we'll know more once the a blood count is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.16,
      "end_seconds": 308.49,
      "duration_seconds": 32.33,
      "text": "Let's get a blood count, for irregular periods. A thyroid test is what I'd like next, for hot flushes. I'm going to put you on estradiol gel, 1 pump, once a day, long term. That should help with menopausal symptoms. Regular exercise, light layers and avoiding triggers can help. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's review you in three months."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.27,
      "end_seconds": 315.38,
      "duration_seconds": 5.11,
      "text": "Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.85,
      "end_seconds": 319.81,
      "duration_seconds": 2.96,
      "text": "That's clear, uh, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.39,
      "end_seconds": 322.37,
      "duration_seconds": 1.98,
      "text": "Alright, see you soon."
    }
  ]
}