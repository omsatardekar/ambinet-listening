{
  "schema_version": "1.0",
  "encounter_id": "02781",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 3.37,
      "duration_seconds": 2.69,
      "text": "Right, good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.52,
      "end_seconds": 9.97,
      "duration_seconds": 2.45,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.6,
      "end_seconds": 17.31,
      "duration_seconds": 5.71,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.36,
      "end_seconds": 21.82,
      "duration_seconds": 3.46,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.79,
      "end_seconds": 31.1,
      "duration_seconds": 7.31,
      "text": "Yeah, it's weakness climbing up my legs. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.17,
      "end_seconds": 34.9,
      "duration_seconds": 2.73,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.65,
      "end_seconds": 41.14,
      "duration_seconds": 4.49,
      "text": "Hmm, it's been going on for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.34,
      "end_seconds": 45.48,
      "duration_seconds": 4.14,
      "text": "Right, right. So, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.5,
      "end_seconds": 50.57,
      "duration_seconds": 3.07,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.18,
      "end_seconds": 54.4,
      "duration_seconds": 2.22,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.21,
      "end_seconds": 61.31,
      "duration_seconds": 5.1,
      "text": "Difficulty walking goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.06,
      "end_seconds": 67.37,
      "duration_seconds": 4.31,
      "text": "Okay, has there been tingling in your feet too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.32,
      "end_seconds": 80.79,
      "duration_seconds": 11.47,
      "text": "Mm, yes. About tingling in my feet, a seven out of ten, I suppose. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.39,
      "end_seconds": 89.77,
      "duration_seconds": 7.38,
      "text": "Have you had weakness climbing up your legs before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.04,
      "end_seconds": 100.51,
      "duration_seconds": 5.47,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.48,
      "end_seconds": 106.36,
      "duration_seconds": 3.88,
      "text": "Any back pain, fever or bladder problems at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.2,
      "end_seconds": 109.82,
      "duration_seconds": 2.62,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.71,
      "end_seconds": 115.91,
      "duration_seconds": 4.2,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.53,
      "end_seconds": 118.74,
      "duration_seconds": 2.21,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.71,
      "end_seconds": 123.36,
      "duration_seconds": 2.65,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.13,
      "end_seconds": 125.08,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.2,
      "end_seconds": 134.08,
      "duration_seconds": 7.88,
      "text": "Any allergies to tablets, food or anything in the environment? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.85,
      "end_seconds": 137.71,
      "duration_seconds": 2.86,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.91,
      "end_seconds": 144.06,
      "duration_seconds": 3.15,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 147.5,
      "end_seconds": 151.85,
      "duration_seconds": 4.35,
      "text": "It's metoprolol, 50 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.0,
      "end_seconds": 155.3,
      "duration_seconds": 2.3,
      "text": "So, and for how long?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 158.9,
      "end_seconds": 165.2,
      "duration_seconds": 6.3,
      "text": "About two months. It's telmisartan, 40 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.14,
      "end_seconds": 169.63,
      "duration_seconds": 2.49,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.67,
      "end_seconds": 177.56,
      "duration_seconds": 5.89,
      "text": "Yes, heart failure. High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.68,
      "end_seconds": 179.38,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.9,
      "end_seconds": 202.0,
      "duration_seconds": 4.1,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.06,
      "end_seconds": 206.63,
      "duration_seconds": 2.57,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.1,
      "end_seconds": 222.93,
      "duration_seconds": 1.83,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.27,
      "end_seconds": 227.9,
      "duration_seconds": 3.63,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.61,
      "end_seconds": 230.84,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.55,
      "end_seconds": 234.98,
      "duration_seconds": 3.43,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.09,
      "end_seconds": 242.86,
      "duration_seconds": 2.77,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.48,
      "end_seconds": 247.29,
      "duration_seconds": 3.81,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.6,
      "end_seconds": 250.61,
      "duration_seconds": 2.01,
      "text": "So, are you active?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.38,
      "end_seconds": 255.1,
      "duration_seconds": 2.72,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.37,
      "end_seconds": 259.14,
      "duration_seconds": 2.77,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.97,
      "end_seconds": 265.91,
      "duration_seconds": 4.94,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.76,
      "end_seconds": 271.63,
      "duration_seconds": 3.87,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.03,
      "end_seconds": 285.21,
      "duration_seconds": 2.18,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.7,
      "end_seconds": 310.63,
      "duration_seconds": 9.93,
      "text": "Okay: oxygen saturation is 99 percent, respiratory rate 18, pulse 78. And pressure 120 over 69, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.48,
      "end_seconds": 316.89,
      "duration_seconds": 4.41,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.97,
      "end_seconds": 320.65,
      "duration_seconds": 2.68,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.34,
      "end_seconds": 344.57,
      "duration_seconds": 6.23,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.43,
      "end_seconds": 351.42,
      "duration_seconds": 2.99,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.1,
      "end_seconds": 397.47,
      "duration_seconds": 27.37,
      "text": "Right, here's what I'm thinking. It fits best with possible Guillain-Barre syndrome. A spinal cord problem is still possible. A lumbar puncture is what I'd like next, for possible GBS. You must be admitted today for monitoring of your breathing. I'm going to send a referral to the neurology team. If it hasn't settled next month, we'd think about a breathing test, but not now. Come back straight away."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.46,
      "end_seconds": 404.79,
      "duration_seconds": 6.33,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.43,
      "end_seconds": 409.75,
      "duration_seconds": 4.32,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.85,
      "end_seconds": 416.57,
      "duration_seconds": 5.72,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 418.66,
      "end_seconds": 421.16,
      "duration_seconds": 2.5,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}