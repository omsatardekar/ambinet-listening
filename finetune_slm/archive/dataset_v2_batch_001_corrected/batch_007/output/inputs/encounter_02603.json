{
  "schema_version": "1.0",
  "encounter_id": "02603",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 2.5,
      "duration_seconds": 1.74,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.89,
      "end_seconds": 9.35,
      "duration_seconds": 5.46,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.23,
      "end_seconds": 15.97,
      "duration_seconds": 4.74,
      "text": "I've been dealing with a sudden painful cold leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.33,
      "end_seconds": 26.82,
      "duration_seconds": 5.49,
      "text": "Did it come on recently? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.3,
      "end_seconds": 31.2,
      "duration_seconds": 2.9,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.36,
      "end_seconds": 37.37,
      "duration_seconds": 3.01,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.08,
      "end_seconds": 40.32,
      "duration_seconds": 1.24,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.99,
      "end_seconds": 45.77,
      "duration_seconds": 4.78,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.74,
      "end_seconds": 55.27,
      "duration_seconds": 8.53,
      "text": "I had a reaction to naproxen when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.48,
      "end_seconds": 58.16,
      "duration_seconds": 1.68,
      "text": "So, what about alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.14,
      "end_seconds": 65.63,
      "duration_seconds": 5.49,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.29,
      "end_seconds": 69.41,
      "duration_seconds": 3.12,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.11,
      "end_seconds": 73.28,
      "duration_seconds": 3.17,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.03,
      "end_seconds": 79.41,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.84,
      "end_seconds": 83.52,
      "duration_seconds": 2.68,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.25,
      "end_seconds": 104.61,
      "duration_seconds": 4.36,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.69,
      "end_seconds": 107.44,
      "duration_seconds": 1.75,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.0,
      "end_seconds": 118.33,
      "duration_seconds": 3.33,
      "text": "Any recent injury, fever or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.95,
      "end_seconds": 122.52,
      "duration_seconds": 2.57,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.13,
      "end_seconds": 125.5,
      "duration_seconds": 2.37,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.49,
      "end_seconds": 127.48,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.55,
      "end_seconds": 132.16,
      "duration_seconds": 2.61,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.9,
      "end_seconds": 136.46,
      "duration_seconds": 2.56,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.73,
      "end_seconds": 150.63,
      "duration_seconds": 3.9,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.55,
      "end_seconds": 162.65,
      "duration_seconds": 2.1,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.84,
      "end_seconds": 193.97,
      "duration_seconds": 10.13,
      "text": "Okay: weight 55 kilos, height 184 centimetres, temperature is 36.8 degrees. And pressure 116 over 70, heart rate 109."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.58,
      "end_seconds": 196.68,
      "duration_seconds": 2.1,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.12,
      "end_seconds": 202.62,
      "duration_seconds": 4.5,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.47,
      "end_seconds": 208.55,
      "duration_seconds": 4.08,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.37,
      "end_seconds": 212.05,
      "duration_seconds": 1.68,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.4,
      "end_seconds": 229.42,
      "duration_seconds": 8.02,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.72,
      "end_seconds": 233.82,
      "duration_seconds": 2.1,
      "text": "So, that's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.64,
      "end_seconds": 262.54,
      "duration_seconds": 20.9,
      "text": "Putting it all together, the most likely explanation is an acutely ischaemic leg. That's my thinking for now, and it may change as we learn more. We should do an urgent CT angiogram for acute limb ischaemia. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.74,
      "end_seconds": 265.42,
      "duration_seconds": 1.68,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.36,
      "end_seconds": 279.72,
      "duration_seconds": 11.36,
      "text": "The treatment will be heparin, 5000 units, bolus now, single dose. That should help with limb ischaemia. You need the vascular surgeons now, this is time critical."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.16,
      "end_seconds": 294.97,
      "duration_seconds": 14.81,
      "text": "Okay, go on. I'd like you to see the vascular team as well, and I'll write the referral. I'd like you back straight away. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.97,
      "end_seconds": 299.9,
      "duration_seconds": 2.93,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.96,
      "end_seconds": 302.37,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}