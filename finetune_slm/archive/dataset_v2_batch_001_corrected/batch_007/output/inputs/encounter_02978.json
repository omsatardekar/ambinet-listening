{
  "schema_version": "1.0",
  "encounter_id": "02978",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 6.76,
      "duration_seconds": 5.38,
      "text": "So, um, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 12.54,
      "duration_seconds": 3.78,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.13,
      "end_seconds": 29.05,
      "duration_seconds": 14.92,
      "text": "Yeah, it's a new headache at the temple. I don't know what's causing it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.62,
      "end_seconds": 33.57,
      "duration_seconds": 2.95,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 41.12,
      "duration_seconds": 6.63,
      "text": "I'm on bisoprolol, 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 45.74,
      "duration_seconds": 3.26,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.94,
      "end_seconds": 50.84,
      "duration_seconds": 3.9,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 56.91,
      "duration_seconds": 4.0,
      "text": "Right, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.17,
      "end_seconds": 62.91,
      "duration_seconds": 4.74,
      "text": "Well, um, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.09,
      "end_seconds": 69.44,
      "duration_seconds": 5.35,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.93,
      "end_seconds": 74.67,
      "duration_seconds": 3.74,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.73,
      "end_seconds": 78.23,
      "duration_seconds": 2.5,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.8,
      "end_seconds": 82.27,
      "duration_seconds": 3.47,
      "text": "I notice it more with touching."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.51,
      "end_seconds": 83.21,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.1,
      "end_seconds": 98.68,
      "duration_seconds": 14.58,
      "text": "Oh, and pain when chewing. That's been about the same, four weeks. Okay, so I had a scalp that hurts to brush before. That's settled now, though."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.48,
      "end_seconds": 103.13,
      "duration_seconds": 3.65,
      "text": "A few quick ones: weight loss or shoulder stiffness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.13,
      "end_seconds": 107.72,
      "duration_seconds": 2.59,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.76,
      "end_seconds": 112.17,
      "duration_seconds": 1.41,
      "text": "Okay, any fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.81,
      "end_seconds": 114.35,
      "duration_seconds": 1.54,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.34,
      "end_seconds": 117.48,
      "duration_seconds": 2.14,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.44,
      "end_seconds": 121.31,
      "duration_seconds": 1.87,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.08,
      "end_seconds": 128.13,
      "duration_seconds": 6.05,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.62,
      "end_seconds": 133.93,
      "duration_seconds": 4.31,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.24,
      "end_seconds": 152.58,
      "duration_seconds": 2.34,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.67,
      "end_seconds": 163.11,
      "duration_seconds": 8.44,
      "text": "I have low haemoglobin. Uh, I have an irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.83,
      "end_seconds": 171.01,
      "duration_seconds": 7.18,
      "text": "Okay, I can see low haemoglobin in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.2,
      "end_seconds": 179.01,
      "duration_seconds": 4.81,
      "text": "Nothing, uh, I haven't had any operations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.83,
      "end_seconds": 184.95,
      "duration_seconds": 4.12,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.77,
      "end_seconds": 201.85,
      "duration_seconds": 15.08,
      "text": "I'll have a glass of wine with dinner. I quit smoking around ten years ago. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 203.03,
      "end_seconds": 212.29,
      "duration_seconds": 9.26,
      "text": "Here are the numbers, doctor. Pressure 111 over 79, respiratory rate 17, temp 36.6 degrees. Pulse 64, saturation 99 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.14,
      "end_seconds": 214.84,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.92,
      "end_seconds": 220.97,
      "duration_seconds": 4.05,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.79,
      "end_seconds": 224.55,
      "duration_seconds": 1.76,
      "text": "So, does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.4,
      "end_seconds": 244.94,
      "duration_seconds": 4.54,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.71,
      "end_seconds": 250.86,
      "duration_seconds": 2.15,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.37,
      "end_seconds": 282.26,
      "duration_seconds": 15.89,
      "text": "From what you've told me and what I found, my working impression is possible giant cell arteritis threatening sight. I want to be honest that this is an impression, not a final answer. A migraine is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.58,
      "end_seconds": 286.94,
      "duration_seconds": 3.36,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.57,
      "end_seconds": 301.62,
      "duration_seconds": 13.05,
      "text": "I understand the worry. At the moment I'd say it's possible giant cell arteritis threatening sight, and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.39,
      "end_seconds": 322.42,
      "duration_seconds": 5.03,
      "text": "Let's get urgent blood tests, for possible giant cell arteritis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.03,
      "end_seconds": 325.73,
      "duration_seconds": 2.7,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.82,
      "end_seconds": 331.59,
      "duration_seconds": 4.77,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.76,
      "end_seconds": 337.49,
      "duration_seconds": 4.73,
      "text": "No, uh, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.26,
      "end_seconds": 339.45,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}