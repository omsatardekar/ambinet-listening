{
  "schema_version": "1.0",
  "encounter_id": "02576",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.53,
      "duration_seconds": 3.27,
      "text": "good evening doctor thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 9.04,
      "duration_seconds": 3.58,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.68,
      "end_seconds": 17.86,
      "duration_seconds": 5.18,
      "text": "sorry what was I saying thank you for fitting us in doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.46,
      "end_seconds": 21.11,
      "duration_seconds": 2.65,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.53,
      "end_seconds": 33.01,
      "duration_seconds": 10.48,
      "text": "Mainly severe thirst and passing lots of urine. There's a a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.76,
      "end_seconds": 37.57,
      "duration_seconds": 2.81,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.25,
      "end_seconds": 49.83,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.18,
      "end_seconds": 72.71,
      "duration_seconds": 6.53,
      "text": "Okay: pulse 109, blood pressure 103 over 62, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.88,
      "end_seconds": 84.74,
      "duration_seconds": 2.86,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.24,
      "end_seconds": 94.35,
      "duration_seconds": 8.11,
      "text": "it's been about a month now i told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.52,
      "end_seconds": 99.23,
      "duration_seconds": 3.71,
      "text": "how troublesome is it day to to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.11,
      "end_seconds": 102.47,
      "duration_seconds": 1.36,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.37,
      "end_seconds": 110.13,
      "duration_seconds": 6.76,
      "text": "And And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 110.23,
      "end_seconds": 115.78,
      "duration_seconds": 5.55,
      "text": "Tell the the doctor about the other thing that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.42,
      "end_seconds": 120.03,
      "duration_seconds": 2.61,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.09,
      "end_seconds": 128.37,
      "duration_seconds": 6.28,
      "text": "that's fine, one at a time i'll ask about everything have you had bone pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.33,
      "end_seconds": 132.69,
      "duration_seconds": 2.36,
      "text": "Yeah. One week, I'd say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.23,
      "end_seconds": 144.9,
      "duration_seconds": 11.67,
      "text": "tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse bear with me I'm just building up the picture"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.66,
      "end_seconds": 158.77,
      "duration_seconds": 13.11,
      "text": "Moderate, really. Honestly, once or twice a day. I didn't wanna bother you but it it keeps coming back. I've also had vomiting, since yesterday."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.09,
      "end_seconds": 165.55,
      "duration_seconds": 5.46,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.98,
      "end_seconds": 174.43,
      "duration_seconds": 7.45,
      "text": "pretty mild, if I'm being honest it happens a few times a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.18,
      "end_seconds": 179.29,
      "duration_seconds": 3.11,
      "text": "have you noticed fever chest pain or fall?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.32,
      "end_seconds": 182.42,
      "duration_seconds": 2.1,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.46,
      "end_seconds": 185.76,
      "duration_seconds": 2.3,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.8,
      "end_seconds": 187.7,
      "duration_seconds": 0.9,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.45,
      "end_seconds": 200.03,
      "duration_seconds": 3.58,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.85,
      "end_seconds": 208.15,
      "duration_seconds": 6.3,
      "text": "It's escitalopram, 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.48,
      "end_seconds": 213.06,
      "duration_seconds": 3.58,
      "text": "is the the packet here or the prescription?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.3,
      "end_seconds": 216.22,
      "duration_seconds": 1.92,
      "text": "no it's at home"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.33,
      "end_seconds": 225.83,
      "duration_seconds": 7.5,
      "text": "it's a... um I can't remember what it's called it's a small white one"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.44,
      "end_seconds": 229.15,
      "duration_seconds": 2.71,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.05,
      "end_seconds": 238.41,
      "duration_seconds": 8.36,
      "text": "for my bones, I believe my wife sets them out for me, I just take what I'm given"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.33,
      "end_seconds": 242.83,
      "duration_seconds": 2.5,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.93,
      "end_seconds": 257.2,
      "duration_seconds": 13.27,
      "text": "Yes kiwi it gives me an itchy mouth. Yes erythromycin. I've no idea what the reaction was only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.35,
      "end_seconds": 259.82,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.63,
      "end_seconds": 265.47,
      "duration_seconds": 3.84,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.64,
      "end_seconds": 269.15,
      "duration_seconds": 2.51,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.0,
      "end_seconds": 274.19,
      "duration_seconds": 3.19,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.81,
      "end_seconds": 282.07,
      "duration_seconds": 6.26,
      "text": "has anyone ever diagnosed you with something? I ask cos it helps me narrow things down"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.89,
      "end_seconds": 286.74,
      "duration_seconds": 3.85,
      "text": "I've got anxiety. I have thin bones"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.16,
      "end_seconds": 293.59,
      "duration_seconds": 5.43,
      "text": "okay, I can see thin bones in your file as well"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.5,
      "end_seconds": 300.6,
      "duration_seconds": 5.1,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.56,
      "end_seconds": 302.52,
      "duration_seconds": 0.96,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.48,
      "end_seconds": 306.21,
      "duration_seconds": 2.73,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.44,
      "end_seconds": 325.76,
      "duration_seconds": 5.32,
      "text": "you are dehydrated and drowsy with a slow, odd rhythm on the monitor"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.16,
      "end_seconds": 347.92,
      "duration_seconds": 16.76,
      "text": "That's all I needed to check. Taking everything into account, it's hard to say. A high calcium emergency is one possibility and a kidney failure another, and I'd rather not commit yet. I want an ECG done, that's for hypercalcaemia."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 348.64,
      "end_seconds": 351.12,
      "duration_seconds": 2.48,
      "text": "the earliest is Friday, 9 am"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.56,
      "end_seconds": 354.47,
      "duration_seconds": 1.91,
      "text": "Okay I'll be there."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.79,
      "end_seconds": 390.78,
      "duration_seconds": 34.99,
      "text": "I'm sending you for urgent blood tests because of confusion and polyuria. What I'm giving you is sodium chloride 0.9%, 1 litre, over one hour, single dose. It's for dehydration. You need hospital fluids and treatment now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.31,
      "end_seconds": 394.1,
      "duration_seconds": 2.79,
      "text": "I think I understand everything. Thanks"
    }
  ]
}