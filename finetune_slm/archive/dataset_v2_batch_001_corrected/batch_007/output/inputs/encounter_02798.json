{
  "schema_version": "1.0",
  "encounter_id": "02798",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 3.35,
      "duration_seconds": 2.7,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.08,
      "end_seconds": 5.03,
      "duration_seconds": 0.95,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 7.69,
      "duration_seconds": 1.44,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.16,
      "end_seconds": 15.0,
      "duration_seconds": 5.84,
      "text": "Um, so... a chesty cough for a week. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.51,
      "end_seconds": 21.69,
      "duration_seconds": 6.18,
      "text": "How long has this been bothering you? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.04,
      "end_seconds": 27.05,
      "duration_seconds": 4.01,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.59,
      "end_seconds": 32.59,
      "duration_seconds": 5.0,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.93,
      "end_seconds": 41.34,
      "duration_seconds": 7.41,
      "text": "A five out of ten, uh, I suppose. Only honey, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.25,
      "end_seconds": 47.38,
      "duration_seconds": 4.13,
      "text": "What about a sore throat earlier, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.26,
      "end_seconds": 61.02,
      "duration_seconds": 8.76,
      "text": "Yeah, that too. I've had slight aching too, for one week. With slight aching, it comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.08,
      "end_seconds": 82.82,
      "duration_seconds": 5.74,
      "text": "Okay, a few quick ones: breathlessness, fever, chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.35,
      "end_seconds": 90.59,
      "duration_seconds": 6.24,
      "text": "I haven't had breathlessness, fever, chest pain or coughing up blood, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 95.41,
      "duration_seconds": 3.33,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.43,
      "end_seconds": 97.86,
      "duration_seconds": 1.43,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.76,
      "end_seconds": 102.09,
      "duration_seconds": 2.33,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.84,
      "end_seconds": 105.21,
      "duration_seconds": 2.37,
      "text": "I've, I've got depression."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.55,
      "end_seconds": 125.74,
      "duration_seconds": 2.19,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.3,
      "end_seconds": 136.87,
      "duration_seconds": 7.57,
      "text": "Um, I take sertraline, 50 milligrams, once a day. Honey and lemon, at night."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.26,
      "end_seconds": 141.53,
      "duration_seconds": 3.27,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.43,
      "end_seconds": 147.31,
      "duration_seconds": 4.88,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.2,
      "end_seconds": 150.24,
      "duration_seconds": 2.04,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.68,
      "end_seconds": 156.01,
      "duration_seconds": 4.33,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.97,
      "end_seconds": 159.98,
      "duration_seconds": 3.01,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.99,
      "end_seconds": 165.31,
      "duration_seconds": 3.32,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.95,
      "end_seconds": 171.23,
      "duration_seconds": 4.28,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.28,
      "end_seconds": 176.43,
      "duration_seconds": 3.15,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.42,
      "end_seconds": 181.57,
      "duration_seconds": 3.15,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.49,
      "end_seconds": 198.17,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.67,
      "end_seconds": 228.0,
      "duration_seconds": 11.33,
      "text": "Okay: respiratory rate 17, BP is 114 over 82. And temperature is 36.5 degrees, pulse is 79 beats a minute, saturation 98 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.54,
      "end_seconds": 234.07,
      "duration_seconds": 4.53,
      "text": "Alright, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.02,
      "end_seconds": 237.62,
      "duration_seconds": 1.6,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.19,
      "end_seconds": 255.38,
      "duration_seconds": 4.19,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.17,
      "end_seconds": 266.38,
      "duration_seconds": 8.21,
      "text": "That's all I needed to check. Okay, so my impression is this: This is probably acute viral bronchitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.65,
      "end_seconds": 301.59,
      "duration_seconds": 24.94,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. The thing that would worry me is if you get a fever or breathlessness. If that happens, go to emergency. I'll want another look if not better in three weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.04,
      "end_seconds": 307.35,
      "duration_seconds": 4.31,
      "text": "Oh, uh, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.0,
      "end_seconds": 309.77,
      "duration_seconds": 1.77,
      "text": "Alright, goodbye for now."
    }
  ]
}