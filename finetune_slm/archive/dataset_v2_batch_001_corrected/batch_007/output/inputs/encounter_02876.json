{
  "schema_version": "1.0",
  "encounter_id": "02876",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 4.93,
      "duration_seconds": 3.62,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 10.37,
      "duration_seconds": 4.4,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.14,
      "end_seconds": 18.06,
      "duration_seconds": 5.92,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.89,
      "end_seconds": 23.23,
      "duration_seconds": 4.34,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.27,
      "end_seconds": 30.32,
      "duration_seconds": 5.05,
      "text": "We came because of a chesty cough for a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.81,
      "end_seconds": 33.08,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.07,
      "end_seconds": 37.4,
      "duration_seconds": 3.33,
      "text": "Around two weeks, um, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 43.2,
      "end_seconds": 46.91,
      "duration_seconds": 3.71,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.74,
      "end_seconds": 53.35,
      "duration_seconds": 4.61,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.22,
      "end_seconds": 57.86,
      "duration_seconds": 3.64,
      "text": "Well, um, I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.54,
      "end_seconds": 62.34,
      "duration_seconds": 2.8,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.84,
      "end_seconds": 70.44,
      "duration_seconds": 6.6,
      "text": "Mm, it's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.48,
      "end_seconds": 77.87,
      "duration_seconds": 6.39,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.29,
      "end_seconds": 83.14,
      "duration_seconds": 3.85,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 90.56,
      "duration_seconds": 3.57,
      "text": "Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.91,
      "end_seconds": 93.49,
      "duration_seconds": 1.58,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.78,
      "end_seconds": 98.17,
      "duration_seconds": 3.39,
      "text": "Has there been a sore throat earlier too?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 101.28,
      "duration_seconds": 1.94,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.53,
      "end_seconds": 104.88,
      "duration_seconds": 2.35,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.88,
      "end_seconds": 107.28,
      "duration_seconds": 1.4,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 109.26,
      "end_seconds": 111.52,
      "duration_seconds": 2.26,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.02,
      "end_seconds": 118.58,
      "duration_seconds": 5.56,
      "text": "Tell me your medicines, please. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.18,
      "end_seconds": 130.27,
      "duration_seconds": 10.09,
      "text": "I take iron tablets, once a day for my blood count. Warfarin. I take it in the evening."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.14,
      "end_seconds": 134.86,
      "duration_seconds": 2.72,
      "text": "Alright, do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.75,
      "end_seconds": 141.16,
      "duration_seconds": 4.41,
      "text": "3 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.85,
      "end_seconds": 150.67,
      "duration_seconds": 7.82,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.21,
      "end_seconds": 154.89,
      "duration_seconds": 2.68,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.76,
      "end_seconds": 165.63,
      "duration_seconds": 9.87,
      "text": "For the prostate, I believe. My wife sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.31,
      "end_seconds": 182.48,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.46,
      "end_seconds": 187.79,
      "duration_seconds": 3.33,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.41,
      "end_seconds": 193.02,
      "duration_seconds": 4.61,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.72,
      "end_seconds": 198.78,
      "duration_seconds": 4.06,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 203.66,
      "duration_seconds": 3.06,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.28,
      "end_seconds": 211.66,
      "duration_seconds": 6.38,
      "text": "I've had low haemoglobin for two years now. Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.78,
      "end_seconds": 213.81,
      "duration_seconds": 1.03,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.56,
      "end_seconds": 223.1,
      "duration_seconds": 4.54,
      "text": "I've had an enlarged prostate, yes. Yes, heart disease."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.41,
      "end_seconds": 235.7,
      "duration_seconds": 11.29,
      "text": "Right, right. Alright, low haemoglobin and heart disease, that matches what I have here. Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.01,
      "end_seconds": 248.77,
      "duration_seconds": 11.76,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.3,
      "end_seconds": 257.07,
      "duration_seconds": 4.77,
      "text": "Right, any breathlessness, chest pain or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.55,
      "end_seconds": 271.05,
      "duration_seconds": 12.5,
      "text": "No, no breathlessness, no chest pain, no coughing up blood. I did have slight aching at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.56,
      "end_seconds": 274.81,
      "duration_seconds": 2.25,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.78,
      "end_seconds": 278.58,
      "duration_seconds": 1.8,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.58,
      "end_seconds": 283.08,
      "duration_seconds": 2.5,
      "text": "Alright, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.13,
      "end_seconds": 285.67,
      "duration_seconds": 1.54,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.98,
      "end_seconds": 290.62,
      "duration_seconds": 3.64,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.58,
      "end_seconds": 294.32,
      "duration_seconds": 2.74,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 307.02,
      "end_seconds": 320.27,
      "duration_seconds": 13.25,
      "text": "Doctor, I've got the readings for you. Temperature is 36.6 degrees, oxygen saturation is 99 percent, BP is 117 over 69, respiratory rate 15, heart rate 75."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.22,
      "end_seconds": 322.81,
      "duration_seconds": 1.59,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.42,
      "end_seconds": 328.08,
      "duration_seconds": 2.66,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.94,
      "end_seconds": 332.37,
      "duration_seconds": 2.43,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.03,
      "end_seconds": 344.01,
      "duration_seconds": 3.98,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.58,
      "end_seconds": 345.28,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.48,
      "end_seconds": 356.58,
      "duration_seconds": 8.1,
      "text": "Good, you can sit up again. Okay, so my impression is this: It points towards acute viral bronchitis."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.06,
      "end_seconds": 360.42,
      "duration_seconds": 2.36,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.09,
      "end_seconds": 376.41,
      "duration_seconds": 14.32,
      "text": "Nothing I've seen today points to an emergency. It looks like acute viral bronchitis. So, to recap quickly. You've had a chesty cough for a week, mild, and no breathlessness or chest pain."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.29,
      "end_seconds": 378.99,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.88,
      "end_seconds": 394.06,
      "duration_seconds": 14.18,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Come back if not better in three weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.04,
      "end_seconds": 398.23,
      "duration_seconds": 2.19,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.38,
      "end_seconds": 401.0,
      "duration_seconds": 1.62,
      "text": "Have a good day."
    }
  ]
}