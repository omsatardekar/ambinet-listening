{
  "schema_version": "1.0",
  "encounter_id": "02973",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 7.08,
      "duration_seconds": 6.48,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.07,
      "end_seconds": 12.51,
      "duration_seconds": 4.44,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.63,
      "end_seconds": 23.54,
      "duration_seconds": 6.91,
      "text": "Doctor, it's a widespread sunburn-like rash. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.16,
      "end_seconds": 28.85,
      "duration_seconds": 3.69,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.49,
      "end_seconds": 44.99,
      "duration_seconds": 14.5,
      "text": "Uh, I've had it for about a month. It's a relief to finally sit down and talk about it. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.95,
      "end_seconds": 49.88,
      "duration_seconds": 2.93,
      "text": "Okay, does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.65,
      "end_seconds": 54.91,
      "duration_seconds": 4.26,
      "text": "it usually comes with a sudden high fever"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.98,
      "end_seconds": 58.65,
      "duration_seconds": 1.67,
      "text": "how about sore throat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.49,
      "end_seconds": 61.99,
      "duration_seconds": 2.5,
      "text": "No sore throat, thankfully."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.19,
      "end_seconds": 65.15,
      "duration_seconds": 1.96,
      "text": "Any cough or stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.18,
      "end_seconds": 72.92,
      "duration_seconds": 6.74,
      "text": "okay, uh, so I haven't had cough or stiff neck, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.22,
      "end_seconds": 76.39,
      "duration_seconds": 2.17,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.93,
      "end_seconds": 81.41,
      "duration_seconds": 3.48,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.6,
      "end_seconds": 85.98,
      "duration_seconds": 3.38,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.18,
      "end_seconds": 92.74,
      "duration_seconds": 5.56,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.76,
      "end_seconds": 106.04,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.92,
      "end_seconds": 112.31,
      "duration_seconds": 4.39,
      "text": "It's thyroxine, 75 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.22,
      "end_seconds": 118.48,
      "duration_seconds": 4.26,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.22,
      "end_seconds": 126.48,
      "duration_seconds": 6.26,
      "text": "No, it's at home. I take a tampon, in use."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.46,
      "end_seconds": 135.57,
      "duration_seconds": 5.11,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.67,
      "end_seconds": 140.53,
      "duration_seconds": 3.86,
      "text": "Yes, um, I'm allergic to milk."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.06,
      "end_seconds": 143.83,
      "duration_seconds": 1.77,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.34,
      "end_seconds": 148.39,
      "duration_seconds": 3.05,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.34,
      "end_seconds": 151.75,
      "duration_seconds": 1.41,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.96,
      "end_seconds": 156.07,
      "duration_seconds": 3.11,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.32,
      "end_seconds": 161.65,
      "duration_seconds": 4.33,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 166.97,
      "duration_seconds": 4.11,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.78,
      "end_seconds": 171.71,
      "duration_seconds": 3.93,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.84,
      "end_seconds": 182.67,
      "duration_seconds": 7.83,
      "text": "Uh, you know, I have an underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.21,
      "end_seconds": 189.72,
      "duration_seconds": 5.51,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.52,
      "end_seconds": 195.06,
      "duration_seconds": 2.54,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.79,
      "end_seconds": 213.81,
      "duration_seconds": 3.02,
      "text": "Yeah, you know, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.77,
      "end_seconds": 218.69,
      "duration_seconds": 2.92,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.61,
      "end_seconds": 246.65,
      "duration_seconds": 9.04,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.92,
      "end_seconds": 251.57,
      "duration_seconds": 1.65,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.74,
      "end_seconds": 286.43,
      "duration_seconds": 27.69,
      "text": "Okay, thinking it through, it points towards possible toxic shock syndrome. I want to be honest that this is an impression, not a final answer. Let's get a vaginal swab, for possible toxic shock. Let's get blood cultures, for possible toxic shock. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.4,
      "end_seconds": 290.09,
      "duration_seconds": 2.69,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.81,
      "end_seconds": 297.84,
      "duration_seconds": 7.03,
      "text": "I'll start you on flucloxacillin, 2 grams, now, single dose it's for possible toxic shock syndrome"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.53,
      "end_seconds": 301.34,
      "duration_seconds": 1.81,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.05,
      "end_seconds": 310.21,
      "duration_seconds": 7.16,
      "text": "Remove any tampon, you are going to hospital now. I think the emergency team should see you too."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.04,
      "end_seconds": 312.73,
      "duration_seconds": 1.69,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.31,
      "end_seconds": 327.46,
      "duration_seconds": 14.15,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you straight away. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.26,
      "end_seconds": 330.04,
      "duration_seconds": 1.78,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.54,
      "end_seconds": 331.93,
      "duration_seconds": 1.39,
      "text": "Look after yourself."
    }
  ]
}