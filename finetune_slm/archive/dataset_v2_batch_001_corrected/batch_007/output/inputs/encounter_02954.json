{
  "schema_version": "1.0",
  "encounter_id": "02954",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.14,
      "end_seconds": 5.37,
      "duration_seconds": 4.23,
      "text": "Right, thanks for waiting, come in. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.98,
      "end_seconds": 15.96,
      "duration_seconds": 9.98,
      "text": "Oh, mainly weakness climbing up my legs. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.39,
      "end_seconds": 20.28,
      "duration_seconds": 2.89,
      "text": "Right, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.71,
      "end_seconds": 23.41,
      "duration_seconds": 1.7,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 27.55,
      "duration_seconds": 2.84,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.86,
      "end_seconds": 32.16,
      "duration_seconds": 3.3,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 36.17,
      "duration_seconds": 3.34,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.93,
      "end_seconds": 39.77,
      "duration_seconds": 2.84,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.52,
      "end_seconds": 44.34,
      "duration_seconds": 2.82,
      "text": "Has there been difficulty walking too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.1,
      "end_seconds": 52.27,
      "duration_seconds": 7.17,
      "text": "Yes, actually. Let me think, with difficulty walking, it feels moderate to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.87,
      "end_seconds": 57.44,
      "duration_seconds": 3.57,
      "text": "Any back pain, bladder problems or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.12,
      "end_seconds": 62.37,
      "duration_seconds": 4.25,
      "text": "No, no back pain, bladder problems or fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.45,
      "end_seconds": 73.33,
      "duration_seconds": 4.88,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.81,
      "end_seconds": 80.88,
      "duration_seconds": 3.07,
      "text": "Yeah, no, all normal there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.91,
      "end_seconds": 86.21,
      "duration_seconds": 3.3,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.73,
      "end_seconds": 93.2,
      "duration_seconds": 3.47,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.91,
      "end_seconds": 109.87,
      "duration_seconds": 3.96,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.12,
      "end_seconds": 113.96,
      "duration_seconds": 2.84,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.97,
      "end_seconds": 117.71,
      "duration_seconds": 2.74,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.24,
      "end_seconds": 133.0,
      "duration_seconds": 14.76,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. I'm a plumber, lots of bending and kneeling. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.03,
      "end_seconds": 137.65,
      "duration_seconds": 3.62,
      "text": "Alright, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.58,
      "end_seconds": 148.96,
      "duration_seconds": 3.38,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.17,
      "end_seconds": 181.03,
      "duration_seconds": 10.86,
      "text": "Okay: BMI works out to 31.2, temp 37.0 degrees, pressure 116 over 77, weight 79 kilos, pulse 80, height 159 centimetres, saturation 99 percent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.33,
      "end_seconds": 183.74,
      "duration_seconds": 1.41,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.55,
      "end_seconds": 187.54,
      "duration_seconds": 2.99,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.38,
      "end_seconds": 194.14,
      "duration_seconds": 3.76,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.13,
      "end_seconds": 198.14,
      "duration_seconds": 2.01,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.62,
      "end_seconds": 222.36,
      "duration_seconds": 5.74,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.51,
      "end_seconds": 229.22,
      "duration_seconds": 1.71,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.13,
      "end_seconds": 244.7,
      "duration_seconds": 4.57,
      "text": "Having listened and examined, my working impression is possible Guillain-Barre syndrome."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.22,
      "end_seconds": 264.25,
      "duration_seconds": 5.03,
      "text": "An urgent admission is what I'd like next, for ascending weakness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.79,
      "end_seconds": 266.47,
      "duration_seconds": 1.68,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.47,
      "end_seconds": 281.22,
      "duration_seconds": 12.75,
      "text": "You must be admitted today for monitoring of your breathing. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.58,
      "end_seconds": 284.58,
      "duration_seconds": 2.0,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.25,
      "end_seconds": 293.49,
      "duration_seconds": 7.24,
      "text": "I'd like to see you again straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.77,
      "end_seconds": 299.96,
      "duration_seconds": 5.19,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.58,
      "end_seconds": 307.25,
      "duration_seconds": 3.67,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.01,
      "end_seconds": 311.13,
      "duration_seconds": 2.12,
      "text": "Thank you, that's helpful."
    }
  ]
}