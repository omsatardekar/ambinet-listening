{
  "schema_version": "1.0",
  "encounter_id": "02802",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 9.97,
      "duration_seconds": 8.86,
      "text": "So, uh, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.91,
      "end_seconds": 15.19,
      "duration_seconds": 4.28,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.46,
      "end_seconds": 26.14,
      "duration_seconds": 9.68,
      "text": "Ah, it's a new headache at the temple. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.91,
      "end_seconds": 29.76,
      "duration_seconds": 2.85,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.57,
      "end_seconds": 33.67,
      "duration_seconds": 2.1,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.41,
      "end_seconds": 43.16,
      "duration_seconds": 5.75,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.17,
      "end_seconds": 60.27,
      "duration_seconds": 15.1,
      "text": "It happens on and off. Uh, I've also had blurred vision in one eye, for four weeks. As for blurred vision in one eye, severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.47,
      "end_seconds": 65.98,
      "duration_seconds": 4.51,
      "text": "Right, any a scalp that hurts to brush as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.31,
      "end_seconds": 70.06,
      "duration_seconds": 2.75,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.6,
      "end_seconds": 72.82,
      "duration_seconds": 2.22,
      "text": "Alright, what about weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.78,
      "end_seconds": 77.79,
      "duration_seconds": 4.01,
      "text": "No, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.55,
      "end_seconds": 82.28,
      "duration_seconds": 3.73,
      "text": "Alright, any shoulder stiffness or fever at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.35,
      "end_seconds": 90.07,
      "duration_seconds": 5.72,
      "text": "Yeah, uh, no shoulder stiffness or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.25,
      "end_seconds": 96.04,
      "duration_seconds": 4.79,
      "text": "So, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.58,
      "end_seconds": 101.14,
      "duration_seconds": 3.56,
      "text": "Okay, so no, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.88,
      "end_seconds": 104.51,
      "duration_seconds": 2.63,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.55,
      "end_seconds": 107.39,
      "duration_seconds": 1.84,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.03,
      "end_seconds": 127.37,
      "duration_seconds": 1.34,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.92,
      "end_seconds": 136.2,
      "duration_seconds": 4.28,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.25,
      "end_seconds": 143.16,
      "duration_seconds": 2.91,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.89,
      "end_seconds": 148.97,
      "duration_seconds": 4.08,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.77,
      "end_seconds": 153.1,
      "duration_seconds": 2.33,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.05,
      "end_seconds": 160.64,
      "duration_seconds": 5.59,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.24,
      "end_seconds": 164.04,
      "duration_seconds": 1.8,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.58,
      "end_seconds": 168.28,
      "duration_seconds": 2.7,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.52,
      "end_seconds": 181.64,
      "duration_seconds": 5.12,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.95,
      "end_seconds": 186.41,
      "duration_seconds": 3.46,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.02,
      "end_seconds": 190.31,
      "duration_seconds": 3.29,
      "text": "Right, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.86,
      "end_seconds": 196.32,
      "duration_seconds": 5.46,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.0,
      "end_seconds": 206.46,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.63,
      "end_seconds": 219.5,
      "duration_seconds": 2.87,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.45,
      "end_seconds": 242.69,
      "duration_seconds": 8.24,
      "text": "Okay: pulse is 80 beats a minute, oxygen saturation is 98 percent, blood pressure 114 over 68."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.68,
      "end_seconds": 245.31,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.57,
      "end_seconds": 248.96,
      "duration_seconds": 2.39,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.13,
      "end_seconds": 256.08,
      "duration_seconds": 4.95,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.76,
      "end_seconds": 258.93,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.71,
      "end_seconds": 277.75,
      "duration_seconds": 4.04,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.33,
      "end_seconds": 290.99,
      "duration_seconds": 9.66,
      "text": "Thank you, you can get dressed. So where does that leave us? I'd lean towards possible giant cell arteritis threatening sight."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.79,
      "end_seconds": 295.94,
      "duration_seconds": 4.15,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.59,
      "end_seconds": 334.45,
      "duration_seconds": 33.86,
      "text": "I understand the worry. At the moment I'd say it's possible giant cell arteritis threatening sight, and we'll know more once the urgent blood tests is back. I'd like to arrange urgent blood tests for possible giant cell arteritis. I think a temporal artery biopsy makes sense here, for possible giant cell arteritis. For this, prednisolone, 60 milligrams, once a day, until review. It's for possible giant cell arteritis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.37,
      "end_seconds": 349.01,
      "duration_seconds": 12.64,
      "text": "Start the steroid today, this is to protect your sight. Let's get you seen by the rheumatology team, I'll arrange the letter. I'd like to see you again tomorrow."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.93,
      "end_seconds": 354.22,
      "duration_seconds": 3.29,
      "text": "Alright, uh, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.3,
      "end_seconds": 359.11,
      "duration_seconds": 2.81,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.64,
      "end_seconds": 361.91,
      "duration_seconds": 2.27,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.65,
      "end_seconds": 364.58,
      "duration_seconds": 1.93,
      "text": "Have a good day."
    }
  ]
