{
  "schema_version": "1.0",
  "encounter_id": "02858",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 3.97,
      "duration_seconds": 3.22,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.55,
      "end_seconds": 5.45,
      "duration_seconds": 0.9,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.44,
      "end_seconds": 9.9,
      "duration_seconds": 2.46,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.59,
      "end_seconds": 13.49,
      "duration_seconds": 2.9,
      "text": "It's numbness in the foot, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.49,
      "end_seconds": 19.49,
      "duration_seconds": 4.0,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.34,
      "end_seconds": 33.03,
      "duration_seconds": 11.69,
      "text": "It's metoprolol, 50 milligrams, twice a day for the heart rhythm. I had bisoprolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.56,
      "end_seconds": 36.51,
      "duration_seconds": 2.95,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.93,
      "end_seconds": 46.25,
      "duration_seconds": 6.32,
      "text": "Mm, about... well, two weeks. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.47,
      "end_seconds": 49.31,
      "duration_seconds": 2.84,
      "text": "Yes. Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.89,
      "end_seconds": 58.5,
      "duration_seconds": 8.61,
      "text": "Honestly, on and off. A pale leg was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.92,
      "end_seconds": 66.7,
      "duration_seconds": 4.78,
      "text": "Alright, did you get fever, recent injury or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.04,
      "end_seconds": 71.92,
      "duration_seconds": 3.88,
      "text": "No, no fever, recent injury or chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.0,
      "end_seconds": 77.83,
      "duration_seconds": 3.83,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.63,
      "end_seconds": 82.68,
      "duration_seconds": 3.05,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.22,
      "end_seconds": 86.5,
      "duration_seconds": 3.28,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.73,
      "end_seconds": 89.32,
      "duration_seconds": 1.59,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.67,
      "end_seconds": 93.79,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 100.3,
      "duration_seconds": 4.71,
      "text": "I have an irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.65,
      "end_seconds": 104.36,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.55,
      "end_seconds": 107.1,
      "duration_seconds": 1.55,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.01,
      "end_seconds": 109.83,
      "duration_seconds": 0.82,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 114.47,
      "duration_seconds": 3.06,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.21,
      "end_seconds": 117.43,
      "duration_seconds": 1.22,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.36,
      "end_seconds": 121.64,
      "duration_seconds": 3.28,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.49,
      "end_seconds": 124.37,
      "duration_seconds": 1.88,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.77,
      "end_seconds": 128.31,
      "duration_seconds": 2.54,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.0,
      "end_seconds": 131.21,
      "duration_seconds": 1.21,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.89,
      "end_seconds": 135.65,
      "duration_seconds": 2.76,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.8,
      "end_seconds": 138.39,
      "duration_seconds": 1.59,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.63,
      "end_seconds": 147.44,
      "duration_seconds": 4.81,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.92,
      "end_seconds": 165.67,
      "duration_seconds": 4.75,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.54,
      "end_seconds": 174.63,
      "duration_seconds": 7.09,
      "text": "Years back I got a rash from naproxen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.32,
      "end_seconds": 177.73,
      "duration_seconds": 2.41,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.04,
      "end_seconds": 192.66,
      "duration_seconds": 2.62,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.72,
      "end_seconds": 216.34,
      "duration_seconds": 12.62,
      "text": "Okay: blood pressure 138 over 79, pulse 114, height 180 centimetres. And weight 76 kilos, BMI works out to 23.5, respiratory rate 19, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.86,
      "end_seconds": 221.58,
      "duration_seconds": 3.72,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.98,
      "end_seconds": 224.15,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.93,
      "end_seconds": 250.11,
      "duration_seconds": 7.18,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.32,
      "end_seconds": 255.38,
      "duration_seconds": 2.06,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.52,
      "end_seconds": 284.29,
      "duration_seconds": 15.77,
      "text": "Okay, thinking it through, this is probably an acutely ischaemic leg. I want to be honest that this is an impression, not a final answer. A deep vein thrombosis is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.39,
      "end_seconds": 316.46,
      "duration_seconds": 21.07,
      "text": "I'd like to arrange an urgent CT angiogram for acute limb ischaemia. Let's use heparin, 5000 units, bolus now, single dose. It's for limb ischaemia. You need the vascular surgeons now, this is time critical. If the symptoms get worse, that's the point to come in urgently. Book a review straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.23,
      "end_seconds": 321.06,
      "duration_seconds": 3.83,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.64,
      "end_seconds": 326.0,
      "duration_seconds": 3.36,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.09,
      "end_seconds": 333.36,
      "duration_seconds": 3.27,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.37,
      "end_seconds": 336.0,
      "duration_seconds": 1.63,
      "text": "Have a good day."
    }
  ]
}