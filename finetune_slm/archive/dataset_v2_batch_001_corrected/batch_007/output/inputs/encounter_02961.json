{
  "schema_version": "1.0",
  "encounter_id": "02961",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 6.35,
      "duration_seconds": 5.56,
      "text": "Ah, um, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 11.65,
      "duration_seconds": 4.11,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.34,
      "end_seconds": 17.64,
      "duration_seconds": 4.3,
      "text": "So, I'm here because of difficulty walking."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.31,
      "end_seconds": 24.56,
      "duration_seconds": 3.25,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.21,
      "end_seconds": 33.74,
      "duration_seconds": 7.53,
      "text": "Two months, I think... sorry, about three months, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.27,
      "end_seconds": 38.17,
      "duration_seconds": 3.9,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.22,
      "end_seconds": 48.91,
      "duration_seconds": 9.69,
      "text": "I'd call it mild. I had weakness climbing up my legs before. That's settled now, um, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.1,
      "end_seconds": 68.72,
      "duration_seconds": 1.62,
      "text": "What about back pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.64,
      "end_seconds": 72.8,
      "duration_seconds": 2.16,
      "text": "No. No back pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.42,
      "end_seconds": 76.94,
      "duration_seconds": 3.52,
      "text": "A few quick ones: fever or bladder problems?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.85,
      "end_seconds": 81.57,
      "duration_seconds": 3.72,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.85,
      "end_seconds": 86.15,
      "duration_seconds": 4.3,
      "text": "I see, go ahead. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.14,
      "end_seconds": 88.19,
      "duration_seconds": 1.05,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.69,
      "end_seconds": 96.5,
      "duration_seconds": 2.81,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.55,
      "end_seconds": 101.29,
      "duration_seconds": 3.74,
      "text": "Yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.09,
      "end_seconds": 118.44,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.73,
      "end_seconds": 122.86,
      "duration_seconds": 3.13,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.18,
      "end_seconds": 139.32,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.94,
      "end_seconds": 145.55,
      "duration_seconds": 5.61,
      "text": "Escitalopram, 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.53,
      "end_seconds": 151.11,
      "duration_seconds": 4.58,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.55,
      "end_seconds": 157.15,
      "duration_seconds": 4.6,
      "text": "Well, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.94,
      "end_seconds": 161.79,
      "duration_seconds": 3.85,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.57,
      "end_seconds": 166.23,
      "duration_seconds": 3.66,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.89,
      "end_seconds": 170.5,
      "duration_seconds": 2.61,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.35,
      "end_seconds": 176.63,
      "duration_seconds": 4.28,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.14,
      "end_seconds": 180.99,
      "duration_seconds": 2.85,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.61,
      "end_seconds": 185.6,
      "duration_seconds": 2.99,
      "text": "Anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.9,
      "end_seconds": 193.42,
      "duration_seconds": 6.52,
      "text": "Alright, anxiety, that matches what I have here. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.6,
      "end_seconds": 202.57,
      "duration_seconds": 2.97,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.1,
      "end_seconds": 221.18,
      "duration_seconds": 9.08,
      "text": "Okay: temperature is 36.6 degrees, BP is 114 over 73, pulse 83. And SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.1,
      "end_seconds": 223.86,
      "duration_seconds": 1.76,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.98,
      "end_seconds": 227.09,
      "duration_seconds": 2.11,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.65,
      "end_seconds": 233.56,
      "duration_seconds": 3.91,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.23,
      "end_seconds": 236.5,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.65,
      "end_seconds": 254.05,
      "duration_seconds": 5.4,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.29,
      "end_seconds": 271.58,
      "duration_seconds": 12.29,
      "text": "So, you can sit up now. Putting it all together, the most likely explanation is possible Guillain-Barre syndrome. A spinal cord problem is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.18,
      "end_seconds": 277.63,
      "duration_seconds": 2.45,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.46,
      "end_seconds": 315.81,
      "duration_seconds": 37.35,
      "text": "I understand the worry. At the moment I'd say it's possible Guillain-Barre syndrome, and we'll know more once the a breathing test is back. I think a breathing test makes sense here, for possible GBS. I'd like to arrange a lumbar puncture for possible GBS. You must be admitted today for monitoring of your breathing. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.0,
      "end_seconds": 319.68,
      "duration_seconds": 2.68,
      "text": "Alright, uh, I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.53,
      "end_seconds": 326.95,
      "duration_seconds": 6.42,
      "text": "I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.56,
      "end_seconds": 336.47,
      "duration_seconds": 4.91,
      "text": "I mean, great, thank you for your help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.24,
      "end_seconds": 338.92,
      "duration_seconds": 1.68,
      "text": "Okay, all the best."
    }
  ]
}