{
  "schema_version": "1.0",
  "encounter_id": "02721",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 4.08,
      "duration_seconds": 2.96,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.08,
      "end_seconds": 8.25,
      "duration_seconds": 3.17,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.21,
      "end_seconds": 12.91,
      "duration_seconds": 2.7,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.94,
      "end_seconds": 20.16,
      "duration_seconds": 6.22,
      "text": "I wanted to get weakness climbing up my legs looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.86,
      "end_seconds": 25.13,
      "duration_seconds": 3.27,
      "text": "So, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.85,
      "end_seconds": 34.72,
      "duration_seconds": 3.87,
      "text": "Let me think, it feels mild to me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.54,
      "end_seconds": 39.0,
      "duration_seconds": 2.46,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.08,
      "end_seconds": 50.88,
      "duration_seconds": 10.8,
      "text": "Tingling in my feet goes along with it, most of the time. The tingling in my feet? That's been for about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.78,
      "end_seconds": 57.65,
      "duration_seconds": 3.87,
      "text": "Have you noticed bladder problems, fever or back pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.06,
      "end_seconds": 64.02,
      "duration_seconds": 4.96,
      "text": "I haven't had bladder problems, fever or back pain, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.05,
      "end_seconds": 67.63,
      "duration_seconds": 2.58,
      "text": "So, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.13,
      "end_seconds": 72.49,
      "duration_seconds": 3.36,
      "text": "Right, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.54,
      "end_seconds": 75.69,
      "duration_seconds": 2.15,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.22,
      "end_seconds": 79.41,
      "duration_seconds": 3.19,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.44,
      "end_seconds": 84.08,
      "duration_seconds": 3.64,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.11,
      "end_seconds": 92.02,
      "duration_seconds": 6.91,
      "text": "Sorry, uh, what was I saying, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.39,
      "end_seconds": 110.7,
      "duration_seconds": 2.31,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.61,
      "end_seconds": 114.23,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.01,
      "end_seconds": 120.48,
      "duration_seconds": 2.47,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.73,
      "end_seconds": 125.98,
      "duration_seconds": 4.25,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.48,
      "end_seconds": 128.85,
      "duration_seconds": 1.37,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.1,
      "end_seconds": 133.04,
      "duration_seconds": 2.94,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.98,
      "end_seconds": 137.61,
      "duration_seconds": 3.63,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.52,
      "end_seconds": 142.36,
      "duration_seconds": 2.84,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.81,
      "end_seconds": 146.2,
      "duration_seconds": 2.39,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.77,
      "end_seconds": 157.07,
      "duration_seconds": 9.3,
      "text": "Hydrocortisone cream, when needed for the eczema. Tamsulosin. I take it 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.6,
      "end_seconds": 160.8,
      "duration_seconds": 3.2,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.52,
      "end_seconds": 163.95,
      "duration_seconds": 1.43,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 167.76,
      "duration_seconds": 2.8,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.5,
      "end_seconds": 178.73,
      "duration_seconds": 10.23,
      "text": "Eczema, for about a year. An enlarged prostate, for nearly five years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.82,
      "end_seconds": 186.68,
      "duration_seconds": 5.86,
      "text": "Ah. Yes, an enlarged prostate is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.19,
      "end_seconds": 191.65,
      "duration_seconds": 3.46,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.47,
      "end_seconds": 201.95,
      "duration_seconds": 1.48,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 204.69,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.97,
      "end_seconds": 218.43,
      "duration_seconds": 5.46,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.36,
      "end_seconds": 232.54,
      "duration_seconds": 11.18,
      "text": "Good, you can sit up again. So, based on the history and the examination, this is probably possible Guillain-Barre syndrome. We shouldn't forget a spinal cord problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.04,
      "end_seconds": 236.45,
      "duration_seconds": 3.41,
      "text": "Erm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.37,
      "end_seconds": 251.65,
      "duration_seconds": 10.28,
      "text": "I understand the worry. At the moment I'd say it's possible Guillain-Barre syndrome, and we'll know more once the a lumbar puncture is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.0,
      "end_seconds": 270.14,
      "duration_seconds": 4.14,
      "text": "I'd like to arrange a lumbar puncture for possible GBS."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.39,
      "end_seconds": 274.59,
      "duration_seconds": 3.2,
      "text": "Oh, when would that take place?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.51,
      "end_seconds": 301.05,
      "duration_seconds": 24.54,
      "text": "Let's get a breathing test, for possible GBS. I'd like to arrange an urgent admission for ascending weakness. You must be admitted today for monitoring of your breathing. If the symptoms get worse, that's the point to come in urgently. Book a review straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.15,
      "end_seconds": 305.28,
      "duration_seconds": 3.13,
      "text": "Thank you, uh, doctor, goodbye."
    }
  ]
}