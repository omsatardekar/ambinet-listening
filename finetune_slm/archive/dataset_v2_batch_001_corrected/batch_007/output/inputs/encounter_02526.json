{
  "schema_version": "1.0",
  "encounter_id": "02526",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.58,
      "end_seconds": 8.84,
      "duration_seconds": 8.26,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.68,
      "end_seconds": 18.64,
      "duration_seconds": 4.96,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.42,
      "end_seconds": 27.23,
      "duration_seconds": 6.81,
      "text": "Um, um, so... being very confused. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.96,
      "end_seconds": 30.99,
      "duration_seconds": 3.03,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.88,
      "end_seconds": 34.11,
      "duration_seconds": 2.23,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.33,
      "end_seconds": 38.65,
      "duration_seconds": 4.32,
      "text": "I follow rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.14,
      "end_seconds": 43.22,
      "duration_seconds": 3.08,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.43,
      "end_seconds": 44.9,
      "duration_seconds": 1.47,
      "text": "yes, carry on"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.53,
      "end_seconds": 52.21,
      "duration_seconds": 5.68,
      "text": "Bone pain was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.09,
      "end_seconds": 58.36,
      "duration_seconds": 5.27,
      "text": "Let me check a few things. Any chest pain, fall or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.04,
      "end_seconds": 67.06,
      "duration_seconds": 5.02,
      "text": "No chest pain, fall or fever, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.76,
      "end_seconds": 70.5,
      "duration_seconds": 2.74,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.33,
      "end_seconds": 72.33,
      "duration_seconds": 1.0,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.07,
      "end_seconds": 76.05,
      "duration_seconds": 2.98,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.21,
      "end_seconds": 78.82,
      "duration_seconds": 1.61,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.19,
      "end_seconds": 92.4,
      "duration_seconds": 4.21,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.54,
      "end_seconds": 100.73,
      "duration_seconds": 7.19,
      "text": "I have thin bones actually, I have heart disease, for five years"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.3,
      "end_seconds": 102.0,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.67,
      "end_seconds": 109.78,
      "duration_seconds": 7.11,
      "text": "Migraines, for two years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.35,
      "end_seconds": 116.19,
      "duration_seconds": 5.84,
      "text": "Alright, thin bones, that matches what I have here. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.71,
      "end_seconds": 123.72,
      "duration_seconds": 7.01,
      "text": "It's alendronate, 70 milligrams, once a week. Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.41,
      "end_seconds": 127.2,
      "duration_seconds": 2.79,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.98,
      "end_seconds": 135.1,
      "duration_seconds": 7.12,
      "text": "Actually, I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.58,
      "end_seconds": 144.06,
      "duration_seconds": 4.48,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.29,
      "end_seconds": 156.97,
      "duration_seconds": 11.68,
      "text": "Sorry, what was I saying, I was told I'm allergic to to erythromycin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.91,
      "end_seconds": 167.48,
      "duration_seconds": 2.57,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.04,
      "end_seconds": 186.01,
      "duration_seconds": 17.97,
      "text": "Nothing, I'm teetotal. I gave up cigarettes last spring. No, I share a house with my brother. I grab fast food at lunch most days. I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.69,
      "end_seconds": 192.31,
      "duration_seconds": 4.62,
      "text": "So, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.14,
      "end_seconds": 197.23,
      "duration_seconds": 4.09,
      "text": "uh, my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 207.68,
      "end_seconds": 215.87,
      "duration_seconds": 8.19,
      "text": "Okay, so the vitals from earlier. Temperature 36.5, pulse is 108 beats a minute, pressure 99 over 66."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.9,
      "end_seconds": 218.19,
      "duration_seconds": 1.29,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.68,
      "end_seconds": 221.72,
      "duration_seconds": 2.04,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.54,
      "end_seconds": 225.53,
      "duration_seconds": 0.99,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.87,
      "end_seconds": 228.65,
      "duration_seconds": 1.78,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.3,
      "end_seconds": 251.15,
      "duration_seconds": 5.85,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.08,
      "end_seconds": 274.75,
      "duration_seconds": 18.67,
      "text": "All finished, thank you. So, based on the history and the examination, it's hard to say. A high calcium emergency is one possibility and a kidney failure another, and I'd rather not commit yet. I'm going to order urgent blood tests, for confusion and polyuria."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 276.03,
      "end_seconds": 279.32,
      "duration_seconds": 3.29,
      "text": "we've already done an ECG this morning, doctor"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.14,
      "end_seconds": 291.95,
      "duration_seconds": 11.81,
      "text": "thanks, I'll have a look. I'd like you to take sodium chloride 0.9%, 1 litre, over one hour, single dose. It's for dehydration"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.69,
      "end_seconds": 294.87,
      "duration_seconds": 1.18,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.96,
      "end_seconds": 302.69,
      "duration_seconds": 6.73,
      "text": "You need hospital fluids and treatment now. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 303.82,
      "end_seconds": 307.24,
      "duration_seconds": 3.42,
      "text": "Yeah, sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.8,
      "end_seconds": 318.63,
      "duration_seconds": 10.83,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.66,
      "end_seconds": 325.19,
      "duration_seconds": 4.53,
      "text": "Yeah, um, alright, thanks, take care."
    }
  ]
}