{
  "schema_version": "1.0",
  "encounter_id": "02591",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 4.79,
      "duration_seconds": 3.76,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.57,
      "end_seconds": 11.41,
      "duration_seconds": 4.84,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.5,
      "end_seconds": 19.76,
      "duration_seconds": 6.26,
      "text": "It's a rolled ankle. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.55,
      "end_seconds": 24.82,
      "duration_seconds": 3.27,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.56,
      "end_seconds": 28.77,
      "duration_seconds": 2.21,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.5,
      "end_seconds": 32.59,
      "duration_seconds": 2.09,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 40.91,
      "duration_seconds": 2.95,
      "text": "I notice it more with walking."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.05,
      "end_seconds": 63.06,
      "duration_seconds": 5.01,
      "text": "Any pop, pain in the foot or pain in the shin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.14,
      "end_seconds": 67.24,
      "duration_seconds": 3.1,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.26,
      "end_seconds": 71.87,
      "duration_seconds": 2.61,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.05,
      "end_seconds": 75.85,
      "duration_seconds": 2.8,
      "text": "So, no, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.22,
      "end_seconds": 81.79,
      "duration_seconds": 4.57,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.84,
      "end_seconds": 84.41,
      "duration_seconds": 1.57,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 89.67,
      "duration_seconds": 3.21,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.2,
      "end_seconds": 101.5,
      "duration_seconds": 11.3,
      "text": "I grab fast food at lunch most days. No, I share a house with my brother. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.29,
      "end_seconds": 105.63,
      "duration_seconds": 2.34,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.73,
      "end_seconds": 117.94,
      "duration_seconds": 6.21,
      "text": "I, I have gout. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.58,
      "end_seconds": 121.53,
      "duration_seconds": 1.95,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.58,
      "end_seconds": 124.61,
      "duration_seconds": 2.03,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.47,
      "end_seconds": 133.22,
      "duration_seconds": 6.75,
      "text": "Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.11,
      "end_seconds": 155.64,
      "duration_seconds": 8.53,
      "text": "Can you list what you take, tablets, creams or inhalers? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.09,
      "end_seconds": 173.48,
      "duration_seconds": 13.39,
      "text": "It's allopurinol, 100 milligrams, once a day for the gout. Pantoprazole, 40 milligrams, before breakfast for my acidity. I'm on ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.14,
      "end_seconds": 190.24,
      "duration_seconds": 4.1,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.47,
      "end_seconds": 195.73,
      "duration_seconds": 4.26,
      "text": "Right, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.79,
      "end_seconds": 210.28,
      "duration_seconds": 2.49,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.52,
      "end_seconds": 220.89,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.54,
      "end_seconds": 244.28,
      "duration_seconds": 6.74,
      "text": "Okay: BP is 115 over 77, heart rate 66, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.33,
      "end_seconds": 247.83,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.82,
      "end_seconds": 256.65,
      "duration_seconds": 3.83,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.23,
      "end_seconds": 261.61,
      "duration_seconds": 3.38,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.3,
      "end_seconds": 265.11,
      "duration_seconds": 1.81,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.51,
      "end_seconds": 268.56,
      "duration_seconds": 2.05,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.0,
      "end_seconds": 285.07,
      "duration_seconds": 7.07,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.31,
      "end_seconds": 311.22,
      "duration_seconds": 21.91,
      "text": "Please sit back down. Right, here's what I'm thinking. This looks most like a mild ankle sprain. I want to be honest that this is an impression, not a final answer. Rest, ice, compression and elevation, then gradual strengthening. Let's review you if not better in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.23,
      "end_seconds": 316.21,
      "duration_seconds": 3.98,
      "text": "Okay, so no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.32,
      "end_seconds": 318.6,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}