{
  "schema_version": "1.0",
  "encounter_id": "02984",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.12,
      "duration_seconds": 3.97,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.1,
      "end_seconds": 13.78,
      "duration_seconds": 3.68,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.15,
      "end_seconds": 22.17,
      "duration_seconds": 7.02,
      "text": "Well, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.13,
      "end_seconds": 28.73,
      "duration_seconds": 4.6,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.3,
      "end_seconds": 36.06,
      "duration_seconds": 6.76,
      "text": "Doctor, it's a chesty cough for a week. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.84,
      "end_seconds": 44.26,
      "duration_seconds": 3.42,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.98,
      "end_seconds": 48.34,
      "duration_seconds": 2.36,
      "text": "For six months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.55,
      "end_seconds": 54.29,
      "duration_seconds": 4.74,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.28,
      "end_seconds": 66.87,
      "duration_seconds": 8.59,
      "text": "I'd say all the time. Oh, and a sore throat earlier. Oh, and slight aching."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.66,
      "end_seconds": 71.98,
      "duration_seconds": 4.32,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.69,
      "end_seconds": 77.92,
      "duration_seconds": 4.23,
      "text": "My son has asthma. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.01,
      "end_seconds": 81.45,
      "duration_seconds": 2.44,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.4,
      "end_seconds": 87.12,
      "duration_seconds": 3.72,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 91.81,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.4,
      "end_seconds": 96.79,
      "duration_seconds": 4.39,
      "text": "Thyronorm. I take it 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 98.7,
      "end_seconds": 107.51,
      "duration_seconds": 8.81,
      "text": "Doctor, I think the last prescription for the Thyronorm was 25 micrograms. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.6,
      "end_seconds": 114.64,
      "duration_seconds": 5.04,
      "text": "Alright, hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.65,
      "end_seconds": 132.21,
      "duration_seconds": 15.56,
      "text": "Not with me. I'll bring it next time. Rosuvastatin. I take it 10 milligrams, at night for my cholesterol. So, before this I was on atorvastatin; that's been stopped."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.56,
      "end_seconds": 146.07,
      "duration_seconds": 2.51,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.92,
      "end_seconds": 152.79,
      "duration_seconds": 5.87,
      "text": "I've got an underactive thyroid. I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.07,
      "end_seconds": 161.38,
      "duration_seconds": 7.31,
      "text": "Okay, I can see an underactive thyroid in your file as well. So, are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.25,
      "end_seconds": 165.03,
      "duration_seconds": 2.78,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.21,
      "end_seconds": 172.3,
      "duration_seconds": 2.09,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.63,
      "end_seconds": 179.16,
      "duration_seconds": 5.53,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.1,
      "end_seconds": 183.89,
      "duration_seconds": 2.79,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.95,
      "end_seconds": 188.24,
      "duration_seconds": 2.29,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.19,
      "end_seconds": 195.14,
      "duration_seconds": 4.95,
      "text": "Let me check a few things. Any breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.94,
      "end_seconds": 201.68,
      "duration_seconds": 4.74,
      "text": "Yeah, I haven't had breathlessness or chest pain, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.22,
      "end_seconds": 205.44,
      "duration_seconds": 3.22,
      "text": "Any fever or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.69,
      "end_seconds": 212.08,
      "duration_seconds": 2.39,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.74,
      "end_seconds": 217.54,
      "duration_seconds": 3.8,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.73,
      "end_seconds": 220.8,
      "duration_seconds": 2.07,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.0,
      "end_seconds": 227.37,
      "duration_seconds": 5.37,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.02,
      "end_seconds": 243.36,
      "duration_seconds": 2.34,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.98,
      "end_seconds": 272.51,
      "duration_seconds": 8.53,
      "text": "Okay: temperature is 36.8 degrees, oxygen saturation is 97 percent, pulse 79, pressure 110 over 73, respiratory rate 15."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.63,
      "end_seconds": 278.4,
      "duration_seconds": 4.77,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.48,
      "end_seconds": 281.93,
      "duration_seconds": 2.45,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.42,
      "end_seconds": 304.76,
      "duration_seconds": 4.34,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.37,
      "end_seconds": 308.13,
      "duration_seconds": 1.76,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.02,
      "end_seconds": 316.7,
      "duration_seconds": 2.68,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.24,
      "end_seconds": 339.34,
      "duration_seconds": 9.1,
      "text": "So, based on the history and the examination, I think we're dealing with acute viral bronchitis at this stage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.65,
      "end_seconds": 378.31,
      "duration_seconds": 27.66,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up if not better in three weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.04,
      "end_seconds": 382.12,
      "duration_seconds": 2.08,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.63,
      "end_seconds": 383.99,
      "duration_seconds": 1.36,
      "text": "Take care now."
    }
  ]
}