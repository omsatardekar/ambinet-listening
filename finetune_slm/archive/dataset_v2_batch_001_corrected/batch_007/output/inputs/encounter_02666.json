{
  "schema_version": "1.0",
  "encounter_id": "02666",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.59,
      "end_seconds": 6.39,
      "duration_seconds": 5.8,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.6,
      "end_seconds": 10.87,
      "duration_seconds": 3.27,
      "text": "thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.56,
      "end_seconds": 15.88,
      "duration_seconds": 3.32,
      "text": "thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.63,
      "end_seconds": 21.2,
      "duration_seconds": 3.57,
      "text": "yes, that's no problem at all please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.98,
      "end_seconds": 26.19,
      "duration_seconds": 4.21,
      "text": "Doctor, it's aching muscles. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.99,
      "end_seconds": 31.3,
      "duration_seconds": 3.31,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.37,
      "end_seconds": 46.74,
      "duration_seconds": 14.37,
      "text": "I take mirtazapine, 15 milligrams, at night for my mood. Pantoprazole. I take it 40 milligrams, before breakfast for my acidity. Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.53,
      "end_seconds": 53.89,
      "duration_seconds": 5.36,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.66,
      "end_seconds": 58.67,
      "duration_seconds": 3.01,
      "text": "It's iron tablets, once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.04,
      "end_seconds": 63.31,
      "duration_seconds": 3.27,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.9,
      "end_seconds": 66.5,
      "duration_seconds": 2.6,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.55,
      "end_seconds": 71.33,
      "duration_seconds": 2.78,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.83,
      "end_seconds": 74.36,
      "duration_seconds": 1.53,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.29,
      "end_seconds": 81.3,
      "duration_seconds": 6.01,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 81.4,
      "end_seconds": 88.18,
      "duration_seconds": 6.78,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.82,
      "end_seconds": 92.11,
      "duration_seconds": 2.29,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.74,
      "end_seconds": 102.33,
      "duration_seconds": 8.59,
      "text": "I've also had tiredness, for two days. Oh, and a growing red ring on my thigh."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 103.07,
      "end_seconds": 105.54,
      "duration_seconds": 2.47,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.09,
      "end_seconds": 108.49,
      "duration_seconds": 2.4,
      "text": "any joint swelling or facial weakness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 121.98,
      "duration_seconds": 11.65,
      "text": "No, no joint swelling, no facial weakness. I did have a mild headache at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.87,
      "end_seconds": 127.32,
      "duration_seconds": 3.45,
      "text": "have you had any palpitations or stiff neck?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.96,
      "end_seconds": 130.5,
      "duration_seconds": 2.54,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.09,
      "end_seconds": 134.14,
      "duration_seconds": 2.05,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.79,
      "end_seconds": 137.61,
      "duration_seconds": 1.82,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.13,
      "end_seconds": 146.51,
      "duration_seconds": 7.38,
      "text": "Tell me about any past illnesses or ongoing conditions. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.62,
      "end_seconds": 155.01,
      "duration_seconds": 7.39,
      "text": "I've had depression for nearly five years now. Acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.63,
      "end_seconds": 157.93,
      "duration_seconds": 1.3,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.92,
      "end_seconds": 168.71,
      "duration_seconds": 8.79,
      "text": "I've got eczema. Low haemoglobin, for five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.65,
      "end_seconds": 175.95,
      "duration_seconds": 6.3,
      "text": "I see, go ahead. Okay, I can see low haemoglobin in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.87,
      "end_seconds": 188.41,
      "duration_seconds": 4.54,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.12,
      "end_seconds": 198.82,
      "duration_seconds": 9.7,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.89,
      "end_seconds": 202.9,
      "duration_seconds": 2.01,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.18,
      "end_seconds": 205.99,
      "duration_seconds": 1.81,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.6,
      "end_seconds": 207.78,
      "duration_seconds": 1.18,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.3,
      "end_seconds": 212.13,
      "duration_seconds": 2.83,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.18,
      "end_seconds": 217.12,
      "duration_seconds": 2.94,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.91,
      "end_seconds": 221.25,
      "duration_seconds": 3.34,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.62,
      "end_seconds": 223.91,
      "duration_seconds": 1.29,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.53,
      "end_seconds": 232.17,
      "duration_seconds": 3.64,
      "text": "so, nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.81,
      "end_seconds": 237.11,
      "duration_seconds": 3.3,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.92,
      "end_seconds": 240.45,
      "duration_seconds": 2.53,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 256.75,
      "end_seconds": 265.08,
      "duration_seconds": 8.33,
      "text": "Here are the numbers, doctor. Heart rate 73, BP is 113 over 70, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.89,
      "end_seconds": 273.69,
      "duration_seconds": 7.8,
      "text": "Thanks. So, based on your history, I'd lean towards early Lyme disease. We shouldn't forget cellulitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 277.65,
      "end_seconds": 280.85,
      "duration_seconds": 3.2,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.46,
      "end_seconds": 296.31,
      "duration_seconds": 14.85,
      "text": "I understand the worry at the moment I'd say it's early Lyme disease, and we'll watch how it goes i'm prescribing doxycycline, 100 milligrams, twice a day, twenty-one days that should help with early Lyme disease"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 298.33,
      "end_seconds": 300.02,
      "duration_seconds": 1.69,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.54,
      "end_seconds": 315.1,
      "duration_seconds": 14.56,
      "text": "Take the doxycycline with food and avoid strong sun. Come back or go to emergency straight away if the symptoms get worse. Come back in three weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 316.18,
      "end_seconds": 318.54,
      "duration_seconds": 2.36,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.58,
      "end_seconds": 321.78,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}