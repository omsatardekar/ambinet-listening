      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.24,
      "end_seconds": 172.04,
      "duration_seconds": 4.8,
      "text": "Alright, did you get weight loss, shoulder stiffness or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.66,
      "end_seconds": 176.31,
      "duration_seconds": 2.65,
      "text": "mm, nope, nothing like that"
    },
