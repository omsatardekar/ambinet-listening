      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.48,
      "end_seconds": 179.5,
      "duration_seconds": 2.02,
      "text": "is your mobility otherwise okay?"
