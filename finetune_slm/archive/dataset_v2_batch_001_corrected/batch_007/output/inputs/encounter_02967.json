      "role": "DOCTOR",
      "start_seconds": 183.88,
      "end_seconds": 187.12,
      "duration_seconds": 3.24,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.26,
      "end_seconds": 192.76,
      "duration_seconds": 4.5,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.1,
      "end_seconds": 210.66,
      "duration_seconds": 3.56,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.24,
      "end_seconds": 221.09,
      "duration_seconds": 2.85,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.77,
      "end_seconds": 252.4,
      "duration_seconds": 17.63,
      "text": "Okay: temp 36.8 degrees, BMI works out to 28.4, pulse is 66 beats a minute, blood pressure 126 over 68, weight 84 kilos, oxygen saturation is 99 percent, respiratory rate 15, height 172 centimetres."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.6,
      "end_seconds": 255.18,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.14,
      "end_seconds": 259.1,
      "duration_seconds": 1.96,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.62,
      "end_seconds": 265.2,
      "duration_seconds": 3.58,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.34,
      "end_seconds": 272.13,
      "duration_seconds": 1.79,
      "text": "Yeah, no problem."
