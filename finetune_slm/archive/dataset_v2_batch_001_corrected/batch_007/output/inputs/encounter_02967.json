      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.08,
      "end_seconds": 182.23,
      "duration_seconds": 2.15,
      "text": "I move fine otherwise."
    },
