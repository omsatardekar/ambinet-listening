    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.06,
      "end_seconds": 276.1,
      "duration_seconds": 2.04,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.5,
      "end_seconds": 299.31,
      "duration_seconds": 4.81,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.4,
      "end_seconds": 336.39,
      "duration_seconds": 33.99,
      "text": "Okay, that's enough for me. So where does that leave us? This looks most like possible giant cell arteritis threatening sight. I'll request urgent blood tests, it'll help with possible giant cell arteritis. I'd like you to take prednisolone, 60 milligrams, once a day, until review. It's for possible giant cell arteritis. Start the steroid today, this is to protect your sight. Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.42,
      "end_seconds": 342.33,
