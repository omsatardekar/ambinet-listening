{
  "schema_version": "1.0",
  "encounter_id": "02627",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.47,
      "duration_seconds": 3.82,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.89,
      "end_seconds": 10.94,
      "duration_seconds": 5.05,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.31,
      "end_seconds": 15.59,
      "duration_seconds": 3.28,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.46,
      "end_seconds": 21.4,
      "duration_seconds": 4.94,
      "text": "Well, I've been having stiff aching shoulders and hips."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.39,
      "end_seconds": 25.69,
      "duration_seconds": 3.3,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.76,
      "end_seconds": 31.87,
      "duration_seconds": 5.11,
      "text": "Around about four days... no wait, it's more like two days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.61,
      "end_seconds": 39.18,
      "duration_seconds": 5.57,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.98,
      "end_seconds": 43.02,
      "duration_seconds": 3.04,
      "text": "Moderate, really. It comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.28,
      "end_seconds": 47.04,
      "duration_seconds": 2.76,
      "text": "Have you had a mild temperature?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.19,
      "end_seconds": 56.86,
      "duration_seconds": 8.67,
      "text": "Yes, I have. As for mild temperature, mostly mild. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.41,
      "end_seconds": 63.87,
      "duration_seconds": 5.46,
      "text": "What about difficulty getting out of bed, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.39,
      "end_seconds": 66.85,
      "duration_seconds": 1.46,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.45,
      "end_seconds": 74.98,
      "duration_seconds": 6.53,
      "text": "Have you had stiff aching shoulders and hips before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.26,
      "end_seconds": 82.52,
      "duration_seconds": 6.26,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.19,
      "end_seconds": 88.81,
      "duration_seconds": 5.62,
      "text": "And what about visual changes, weight loss, jaw pain on chewing or headache?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.12,
      "end_seconds": 92.85,
      "duration_seconds": 2.73,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 95.86,
      "duration_seconds": 2.02,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.2,
      "end_seconds": 99.54,
      "duration_seconds": 2.34,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.36,
      "end_seconds": 113.89,
      "duration_seconds": 3.53,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.56,
      "end_seconds": 117.38,
      "duration_seconds": 2.82,
      "text": "Low haemoglobin, for five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.06,
      "end_seconds": 119.76,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.77,
      "end_seconds": 124.25,
      "duration_seconds": 3.48,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.05,
      "end_seconds": 137.96,
      "duration_seconds": 11.91,
      "text": "Right, so low haemoglobin and high blood pressure are already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.78,
      "end_seconds": 142.45,
      "duration_seconds": 2.67,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.07,
      "end_seconds": 150.87,
      "duration_seconds": 3.8,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.74,
      "end_seconds": 156.34,
      "duration_seconds": 4.6,
      "text": "Right, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.6,
      "end_seconds": 169.92,
      "duration_seconds": 3.32,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 171.96,
      "end_seconds": 177.04,
      "duration_seconds": 5.08,
      "text": "He takes iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.27,
      "end_seconds": 182.77,
      "duration_seconds": 4.5,
      "text": "I was on telmisartan before. I stopped taking it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.9,
      "end_seconds": 203.75,
      "duration_seconds": 2.85,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.59,
      "end_seconds": 209.41,
      "duration_seconds": 4.82,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.53,
      "end_seconds": 213.39,
      "duration_seconds": 2.86,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.3,
      "end_seconds": 236.14,
      "duration_seconds": 20.84,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I look after my grandchildren most days. I drink a lot of tea and snack through the day. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.61,
      "end_seconds": 240.78,
      "duration_seconds": 3.17,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.7,
      "end_seconds": 251.2,
      "duration_seconds": 2.5,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.8,
      "end_seconds": 276.48,
      "duration_seconds": 5.68,
      "text": "Okay: pulse 81, blood pressure 111 over 77, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.68,
      "end_seconds": 279.93,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.4,
      "end_seconds": 283.82,
      "duration_seconds": 2.42,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.49,
      "end_seconds": 290.2,
      "duration_seconds": 4.71,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.49,
      "end_seconds": 292.69,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.75,
      "end_seconds": 316.1,
      "duration_seconds": 6.35,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.92,
      "end_seconds": 348.37,
      "duration_seconds": 29.45,
      "text": "Okay, that's enough for me. So where does that leave us? My working impression is polymyalgia rheumatica. The reason I say that is that your story and my examination fit together. Another possibility is rheumatoid arthritis. I'm going to order blood tests, for proximal stiffness. What I'm giving you is prednisolone, 15 milligrams, once a day, reducing course. That's for polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.22,
      "end_seconds": 353.43,
      "duration_seconds": 4.21,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.43,
      "end_seconds": 374.67,
      "duration_seconds": 19.24,
      "text": "Report any headache or jaw pain immediately. Don't skip meals, and try to eat smaller portions more often through the day. Please don't wait if you get a new headache or visual changes. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.73,
      "end_seconds": 377.22,
      "duration_seconds": 1.49,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.11,
      "end_seconds": 380.54,
      "duration_seconds": 2.43,
      "text": "Book a review in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.46,
      "end_seconds": 384.33,
      "duration_seconds": 2.87,
      "text": "Um, that's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.83,
      "end_seconds": 388.38,
      "duration_seconds": 3.55,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.98,
      "end_seconds": 394.41,
      "duration_seconds": 3.43,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}