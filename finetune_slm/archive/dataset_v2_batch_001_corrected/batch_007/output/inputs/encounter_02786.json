{
  "schema_version": "1.0",
  "encounter_id": "02786",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 7.22,
      "duration_seconds": 5.86,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.93,
      "end_seconds": 11.62,
      "duration_seconds": 3.69,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.28,
      "end_seconds": 19.84,
      "duration_seconds": 3.56,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.36,
      "end_seconds": 25.34,
      "duration_seconds": 4.98,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.85,
      "end_seconds": 31.52,
      "duration_seconds": 4.67,
      "text": "I've been dealing with a sudden painful cold leg."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.55,
      "end_seconds": 37.9,
      "duration_seconds": 4.35,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.11,
      "end_seconds": 46.33,
      "duration_seconds": 7.22,
      "text": "it's bisoprolol, 2.5 milligrams, once a day for the heart rhythm, doctor"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.3,
      "end_seconds": 52.27,
      "duration_seconds": 1.97,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 53.02,
      "end_seconds": 65.64,
      "duration_seconds": 12.62,
      "text": "About a month now. It's rosuvastatin, 10 milligrams, at night for my cholesterol, doctor. Uh, he is on Asthalin inhaler, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.2,
      "end_seconds": 72.95,
      "duration_seconds": 5.75,
      "text": "I'd been on atorvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.11,
      "end_seconds": 85.57,
      "duration_seconds": 2.46,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.16,
      "end_seconds": 102.79,
      "duration_seconds": 15.63,
      "text": "I'd say once or twice a day. Oh, and a pale leg. I've also had not being able to move the foot. About not being able to move the foot, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.7,
      "end_seconds": 111.17,
      "duration_seconds": 3.47,
      "text": "alright, any numbness in the foot as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.03,
      "end_seconds": 118.71,
      "duration_seconds": 6.68,
      "text": "Yes, I have. As for numbness in the foot, I'd say mild."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.19,
      "end_seconds": 123.57,
      "duration_seconds": 3.38,
      "text": "Did you get chest pain or recent injury?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.59,
      "end_seconds": 126.98,
      "duration_seconds": 2.39,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.8,
      "end_seconds": 129.61,
      "duration_seconds": 0.81,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.11,
      "end_seconds": 132.55,
      "duration_seconds": 1.44,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.84,
      "end_seconds": 139.75,
      "duration_seconds": 2.91,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.99,
      "end_seconds": 143.67,
      "duration_seconds": 2.68,
      "text": "Ah, no, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.34,
      "end_seconds": 147.67,
      "duration_seconds": 3.33,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.23,
      "end_seconds": 150.61,
      "duration_seconds": 1.38,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.36,
      "end_seconds": 161.68,
      "duration_seconds": 3.32,
      "text": "What do you do during the the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.83,
      "end_seconds": 170.78,
      "duration_seconds": 3.95,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.76,
      "end_seconds": 176.07,
      "duration_seconds": 3.31,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.09,
      "end_seconds": 181.17,
      "duration_seconds": 3.08,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.69,
      "end_seconds": 185.87,
      "duration_seconds": 4.18,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.48,
      "end_seconds": 197.85,
      "duration_seconds": 11.37,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.17,
      "end_seconds": 202.75,
      "duration_seconds": 3.58,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.33,
      "end_seconds": 218.88,
      "duration_seconds": 15.55,
      "text": "I've had an irregular heartbeat for two years now. I thought it would sort itself out, but it hasn't. High cholesterol, for five years. I've had asthma, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.51,
      "end_seconds": 221.11,
      "duration_seconds": 1.6,
      "text": "okay, what else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.78,
      "end_seconds": 229.52,
      "duration_seconds": 6.74,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.73,
      "end_seconds": 234.46,
      "duration_seconds": 2.73,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.73,
      "end_seconds": 237.75,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.29,
      "end_seconds": 259.19,
      "duration_seconds": 6.9,
      "text": "the right leg is cold, pale and mottled, with no pulses at the groin or below"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.8,
      "end_seconds": 282.45,
      "duration_seconds": 18.65,
      "text": "Please sit back down. Having listened and examined, my working impression is an acutely ischaemic leg. That's my thinking for now, and it may change as we learn more. It could also be a deep vein thrombosis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.46,
      "end_seconds": 285.79,
      "duration_seconds": 2.33,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.56,
      "end_seconds": 294.58,
      "duration_seconds": 8.02,
      "text": "Nothing I've seen today points to an emergency. It looks like an acutely ischaemic leg, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.48,
      "end_seconds": 328.05,
      "duration_seconds": 22.57,
      "text": "We should do an urgent CT angiogram for acute limb ischaemia. I'll start you on heparin, 5000 units, bolus now, single dose. That's for limb ischaemia. You need the vascular surgeons now, this is time critical. I'd like you to see the vascular team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.0,
      "end_seconds": 329.7,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.19,
      "end_seconds": 334.13,
      "duration_seconds": 2.94,
      "text": "let's plan a check straight away"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.79,
      "end_seconds": 335.49,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.36,
      "end_seconds": 340.94,
      "duration_seconds": 4.58,
      "text": "Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.61,
      "end_seconds": 345.03,
      "duration_seconds": 2.42,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.97,
      "end_seconds": 347.25,
      "duration_seconds": 1.28,
      "text": "goodbye for now"
    }
  ]
}