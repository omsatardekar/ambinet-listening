{
  "schema_version": "1.0",
  "encounter_id": "02615",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.15,
      "end_seconds": 6.91,
      "duration_seconds": 5.76,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.42,
      "end_seconds": 14.01,
      "duration_seconds": 3.59,
      "text": "perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.72,
      "end_seconds": 23.16,
      "duration_seconds": 4.44,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.12,
      "end_seconds": 28.69,
      "duration_seconds": 3.57,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 36.48,
      "duration_seconds": 6.31,
      "text": "Honestly, it's chest tightness, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.42,
      "end_seconds": 42.63,
      "duration_seconds": 3.21,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.25,
      "end_seconds": 50.82,
      "duration_seconds": 6.57,
      "text": "it's Seretide inhaler, twice a day i take sumatriptan, 50 milligrams, when needed"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.88,
      "end_seconds": 60.36,
      "duration_seconds": 7.48,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.38,
      "end_seconds": 64.93,
      "duration_seconds": 2.55,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.73,
      "end_seconds": 78.39,
      "duration_seconds": 11.66,
      "text": "For the anxiety, I believe. My wife sets them out for me, I just take what I'm given. It's iron tablets, once a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.89,
      "end_seconds": 84.34,
      "duration_seconds": 5.45,
      "text": "Yes, carry on. Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.2,
      "end_seconds": 87.57,
      "duration_seconds": 2.37,
      "text": "ever since... since Monday, really"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.63,
      "end_seconds": 91.09,
      "duration_seconds": 2.46,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.84,
      "end_seconds": 95.88,
      "duration_seconds": 3.04,
      "text": "yes, exertion. That makes it worse"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.47,
      "end_seconds": 99.43,
      "duration_seconds": 2.96,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.95,
      "end_seconds": 102.59,
      "duration_seconds": 2.64,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.51,
      "end_seconds": 110.07,
      "duration_seconds": 6.56,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 110.17,
      "end_seconds": 115.73,
      "duration_seconds": 5.56,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.82,
      "end_seconds": 120.5,
      "duration_seconds": 2.68,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.32,
      "end_seconds": 125.45,
      "duration_seconds": 4.13,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.3,
      "end_seconds": 131.04,
      "duration_seconds": 4.74,
      "text": "I've also had being very breathless, for about four days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 140.7,
      "duration_seconds": 8.62,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.6,
      "end_seconds": 155.49,
      "duration_seconds": 9.89,
      "text": "It happens all the time. Mild, really. I had fainting on exertion before. That's settled now, though."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.79,
      "end_seconds": 159.78,
      "duration_seconds": 2.99,
      "text": "Have you had any cough or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.85,
      "end_seconds": 165.18,
      "duration_seconds": 3.33,
      "text": "I haven't had cough or fever, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.58,
      "end_seconds": 167.33,
      "duration_seconds": 1.75,
      "text": "sure. Any leg pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.6,
      "end_seconds": 170.83,
      "duration_seconds": 2.23,
      "text": "No. No leg pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.53,
      "end_seconds": 177.7,
      "duration_seconds": 2.17,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.4,
      "end_seconds": 181.99,
      "duration_seconds": 2.59,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.58,
      "end_seconds": 185.37,
      "duration_seconds": 2.79,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.26,
      "end_seconds": 188.28,
      "duration_seconds": 2.02,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.02,
      "end_seconds": 210.27,
      "duration_seconds": 4.25,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.33,
      "end_seconds": 216.98,
      "duration_seconds": 4.65,
      "text": "My grandfather had a stroke. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.47,
      "end_seconds": 221.66,
      "duration_seconds": 3.19,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.17,
      "end_seconds": 226.26,
      "duration_seconds": 3.09,
      "text": "I have asthma, for two years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.81,
      "end_seconds": 229.38,
      "duration_seconds": 2.57,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.11,
      "end_seconds": 237.31,
      "duration_seconds": 7.2,
      "text": "Migraines, for about a year. I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.2,
      "end_seconds": 239.9,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.8,
      "end_seconds": 242.41,
      "duration_seconds": 1.61,
      "text": "Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.05,
      "end_seconds": 254.17,
      "duration_seconds": 10.12,
      "text": "Yes, carry on. Yes, asthma is known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.15,
      "end_seconds": 264.69,
      "duration_seconds": 9.54,
      "text": "I think I reacted to to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.2,
      "end_seconds": 276.6,
      "duration_seconds": 3.4,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 278.18,
      "end_seconds": 291.74,
      "duration_seconds": 13.56,
      "text": "Nothing, I'm teetotal. No, I've never smoked in my life. I look after my grandchildren most days. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.36,
      "end_seconds": 294.8,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.62,
      "end_seconds": 297.22,
      "duration_seconds": 1.6,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 299.07,
      "end_seconds": 308.0,
      "duration_seconds": 8.93,
      "text": "Here are the numbers, doctor. BP is 120 over 90, heart rate 100. SpO2 90 percent on room air, temp 37.4 degrees."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.89,
      "end_seconds": 309.59,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.51,
      "end_seconds": 314.14,
      "duration_seconds": 2.63,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.68,
      "end_seconds": 318.6,
      "duration_seconds": 2.92,
      "text": "Right, tell me if that's sore."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.59,
      "end_seconds": 337.75,
      "duration_seconds": 5.16,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.73,
      "end_seconds": 355.55,
      "duration_seconds": 12.82,
      "text": "you can relax now right, here's what I'm thinking this looks most like possible pulmonary hypertension. Chronic clots in the lungs is also on my list"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 356.66,
      "end_seconds": 359.78,
      "duration_seconds": 3.12,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.02,
      "end_seconds": 379.36,
      "duration_seconds": 18.34,
      "text": "I understand the worry at the moment I'd say it's possible pulmonary hypertension, and we'll know more once the an ECG is back let me just check I've got this right you've had chest tightness, since Monday, moderate, and no leg pain or fever"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 381.42,
      "end_seconds": 382.12,
      "duration_seconds": 0.7,
      "text": "exactly"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 383.72,
      "end_seconds": 390.06,
      "duration_seconds": 6.34,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.09,
      "end_seconds": 410.24,
      "duration_seconds": 18.15,
      "text": "Alright, thanks, I'll have a look. I'd like to arrange blood tests for breathlessness. Let's book an echocardiogram to look into exertional syncope. No exertion for now, I am arranging urgent specialist tests. Come back in one week."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 412.28,
      "end_seconds": 414.24,
      "duration_seconds": 1.96,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.33,
      "end_seconds": 417.76,
      "duration_seconds": 2.43,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 418.93,
      "end_seconds": 420.88,
      "duration_seconds": 1.95,
      "text": "thank you, that's helpful"
    }
  ]
}