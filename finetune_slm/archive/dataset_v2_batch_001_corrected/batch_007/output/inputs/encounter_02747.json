{
  "schema_version": "1.0",
  "encounter_id": "02747",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 4.31,
      "duration_seconds": 3.68,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.69,
      "end_seconds": 10.72,
      "duration_seconds": 3.03,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.43,
      "end_seconds": 15.93,
      "duration_seconds": 4.5,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.51,
      "end_seconds": 19.55,
      "duration_seconds": 2.04,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.14,
      "end_seconds": 30.25,
      "duration_seconds": 10.11,
      "text": "It's a dull ache on one side of the chest, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.08,
      "end_seconds": 35.01,
      "duration_seconds": 2.93,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.75,
      "end_seconds": 38.81,
      "duration_seconds": 2.06,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.62,
      "end_seconds": 43.82,
      "duration_seconds": 3.2,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.5,
      "end_seconds": 49.94,
      "duration_seconds": 4.44,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.15,
      "end_seconds": 54.77,
      "duration_seconds": 3.62,
      "text": "What about weight loss, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.21,
      "end_seconds": 58.5,
      "duration_seconds": 2.29,
      "text": "Yes, for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.65,
      "end_seconds": 63.89,
      "duration_seconds": 4.24,
      "text": "What about breathlessness building over weeks, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.16,
      "end_seconds": 66.38,
      "duration_seconds": 1.22,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.97,
      "end_seconds": 69.9,
      "duration_seconds": 2.93,
      "text": "Okay, how often do you get it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.17,
      "end_seconds": 85.78,
      "duration_seconds": 14.61,
      "text": "It's a few times a day. And there's a dry cough as well, two days now. With dry cough, it happens a few times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.6,
      "end_seconds": 92.94,
      "duration_seconds": 5.34,
      "text": "Did you get leg swelling, coughing up blood, fever or night sweats?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.79,
      "end_seconds": 97.24,
      "duration_seconds": 2.45,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.21,
      "end_seconds": 101.57,
      "duration_seconds": 3.36,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.64,
      "end_seconds": 104.73,
      "duration_seconds": 2.09,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.77,
      "end_seconds": 111.11,
      "duration_seconds": 5.34,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.72,
      "end_seconds": 114.19,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.7,
      "end_seconds": 125.54,
      "duration_seconds": 2.84,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.56,
      "end_seconds": 131.6,
      "duration_seconds": 4.04,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.91,
      "end_seconds": 152.37,
      "duration_seconds": 4.46,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.42,
      "end_seconds": 166.11,
      "duration_seconds": 12.69,
      "text": "Nothing, I'm teetotal. I gave up cigarettes last spring. I'm vegetarian and have been for years. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.68,
      "end_seconds": 172.68,
      "duration_seconds": 4.0,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.32,
      "end_seconds": 179.17,
      "duration_seconds": 4.85,
      "text": "I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.12,
      "end_seconds": 181.82,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.58,
      "end_seconds": 194.09,
      "duration_seconds": 10.51,
      "text": "I've got diabetes. I have heart failure, for about a year. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.17,
      "end_seconds": 199.41,
      "duration_seconds": 3.24,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.02,
      "end_seconds": 210.38,
      "duration_seconds": 5.36,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.26,
      "end_seconds": 213.72,
      "duration_seconds": 2.46,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.66,
      "end_seconds": 218.35,
      "duration_seconds": 3.69,
      "text": "It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 219.39,
      "end_seconds": 227.64,
      "duration_seconds": 8.25,
      "text": "Um, she is supposed to take it twice a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.05,
      "end_seconds": 238.97,
      "duration_seconds": 9.92,
      "text": "Gliclazide. I take it 80 milligrams, twice a day. I'm, I'm on spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.22,
      "end_seconds": 240.16,
      "duration_seconds": 0.94,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.92,
      "end_seconds": 245.99,
      "duration_seconds": 5.07,
      "text": "I had ramipril at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 247.59,
      "end_seconds": 258.61,
      "duration_seconds": 11.02,
      "text": "Okay, so the vitals from earlier. SpO2 92 percent on room air, temperature is 36.7 degrees, respiratory rate 24, blood pressure 133 over 89, pulse 97."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.94,
      "end_seconds": 260.98,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.05,
      "end_seconds": 265.84,
      "duration_seconds": 3.79,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.75,
      "end_seconds": 284.78,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.78,
      "end_seconds": 287.67,
      "duration_seconds": 1.89,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.3,
      "end_seconds": 307.78,
      "duration_seconds": 5.48,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.58,
      "end_seconds": 339.7,
      "duration_seconds": 27.12,
      "text": "That's all I needed to check. Okay, so my impression is this: I can't pin this down yet. We're looking at a pleural effusion needing a cause or heart failure. Just to be sure I understood. You've had a dull ache on one side of the chest for six months, and no fever or night sweats."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.81,
      "end_seconds": 342.32,
      "duration_seconds": 1.51,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.3,
      "end_seconds": 378.66,
      "duration_seconds": 31.36,
      "text": "I'm going to order a CT scan of the chest, for pleural effusion. I'm sending you for a pleural fluid sample because of pleural effusion. I am arranging an urgent chest clinic review. The chest clinic would be the right next step, I'll refer you. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.65,
      "end_seconds": 384.55,
      "duration_seconds": 3.9,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.31,
      "end_seconds": 386.48,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}