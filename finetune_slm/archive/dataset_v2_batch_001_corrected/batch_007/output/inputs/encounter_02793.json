{
  "schema_version": "1.0",
  "encounter_id": "02793",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.72,
      "duration_seconds": 5.54,
      "text": "Mm, uh, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.13,
      "end_seconds": 12.51,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.03,
      "end_seconds": 22.2,
      "duration_seconds": 6.17,
      "text": "It's a rolled ankle. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.44,
      "end_seconds": 26.77,
      "duration_seconds": 3.33,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.68,
      "end_seconds": 31.32,
      "duration_seconds": 3.64,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.2,
      "end_seconds": 33.82,
      "duration_seconds": 1.62,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.03,
      "end_seconds": 41.86,
      "duration_seconds": 1.83,
      "text": "Rest helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.99,
      "end_seconds": 45.81,
      "duration_seconds": 2.82,
      "text": "What about pain in the shin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.94,
      "end_seconds": 53.02,
      "duration_seconds": 6.08,
      "text": "Mm, you know, no, none, no pain in the shin."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.1,
      "end_seconds": 57.82,
      "duration_seconds": 2.72,
      "text": "Any pain in the foot or pop?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.34,
      "end_seconds": 61.82,
      "duration_seconds": 3.48,
      "text": "Okay, so no, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.68,
      "end_seconds": 65.21,
      "duration_seconds": 2.53,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.6,
      "end_seconds": 67.56,
      "duration_seconds": 0.96,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.63,
      "end_seconds": 93.14,
      "duration_seconds": 8.51,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.99,
      "end_seconds": 96.51,
      "duration_seconds": 2.52,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.23,
      "end_seconds": 100.78,
      "duration_seconds": 2.55,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 104.41,
      "duration_seconds": 2.14,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.77,
      "end_seconds": 111.31,
      "duration_seconds": 3.54,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.19,
      "end_seconds": 114.72,
      "duration_seconds": 1.53,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.75,
      "end_seconds": 134.45,
      "duration_seconds": 3.7,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 141.36,
      "duration_seconds": 4.98,
      "text": "Ibuprofen gel. I take it three times a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.27,
      "end_seconds": 144.67,
      "duration_seconds": 2.4,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.88,
      "end_seconds": 149.5,
      "duration_seconds": 3.62,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.48,
      "end_seconds": 153.79,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.33,
      "end_seconds": 159.15,
      "duration_seconds": 3.82,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.9,
      "end_seconds": 162.71,
      "duration_seconds": 1.81,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.43,
      "end_seconds": 166.71,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.7,
      "end_seconds": 184.38,
      "duration_seconds": 2.68,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.26,
      "end_seconds": 198.85,
      "duration_seconds": 2.59,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.9,
      "end_seconds": 219.16,
      "duration_seconds": 5.26,
      "text": "Okay: respiratory rate 18, heart rate 82, blood pressure 128 over 77."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.53,
      "end_seconds": 224.31,
      "duration_seconds": 3.78,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.42,
      "end_seconds": 227.38,
      "duration_seconds": 1.96,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.07,
      "end_seconds": 244.4,
      "duration_seconds": 7.33,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 258.71,
      "duration_seconds": 8.69,
      "text": "You can relax now. So where does that leave us? My working impression is a mild ankle sprain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.58,
      "end_seconds": 261.58,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 271.69,
      "duration_seconds": 9.17,
      "text": "I understand the worry. At the moment I'd say it's a mild ankle sprain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.7,
      "end_seconds": 313.69,
      "duration_seconds": 25.99,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. One warning sign to remember: the symptoms get worse. In that case don't wait. See me again if not better in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.29,
      "end_seconds": 318.5,
      "duration_seconds": 3.21,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}