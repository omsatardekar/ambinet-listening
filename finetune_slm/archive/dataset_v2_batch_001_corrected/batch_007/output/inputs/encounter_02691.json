{
  "schema_version": "1.0",
  "encounter_id": "02691",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 5.18,
      "duration_seconds": 4.67,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 10.88,
      "duration_seconds": 4.0,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.35,
      "end_seconds": 16.14,
      "duration_seconds": 3.79,
      "text": "it's breathlessness building over weeks, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.71,
      "end_seconds": 20.73,
      "duration_seconds": 4.02,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.55,
      "end_seconds": 35.48,
      "duration_seconds": 2.93,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.97,
      "end_seconds": 61.62,
      "duration_seconds": 6.65,
      "text": "Okay: blood pressure 132 over 80, respiratory rate 25. And pulse 86, saturation 90 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.45,
      "end_seconds": 66.82,
      "duration_seconds": 3.37,
      "text": "is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.33,
      "end_seconds": 75.62,
      "duration_seconds": 5.29,
      "text": "That's fine, I'll explain it soon. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.31,
      "end_seconds": 82.48,
      "duration_seconds": 6.17,
      "text": "For four weeks, I'd say. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.38,
      "end_seconds": 93.62,
      "duration_seconds": 9.24,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.79,
      "end_seconds": 104.88,
      "duration_seconds": 10.09,
      "text": "I'd say a couple of times a week. Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.64,
      "end_seconds": 108.43,
      "duration_seconds": 2.79,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.06,
      "end_seconds": 127.28,
      "duration_seconds": 18.22,
      "text": "hmm, it usually comes with a dull ache on one side of the chest the dull ache on one side of the chest? That's been for about three months"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.26,
      "end_seconds": 135.51,
      "duration_seconds": 6.25,
      "text": "Have you had breathlessness building over weeks before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.85,
      "end_seconds": 145.2,
      "duration_seconds": 8.35,
      "text": "Well, um, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.79,
      "end_seconds": 148.1,
      "duration_seconds": 2.31,
      "text": "What about coughing up blood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.03,
      "end_seconds": 154.25,
      "duration_seconds": 4.22,
      "text": "Nope, uh, no coughing up blood."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.04,
      "end_seconds": 161.19,
      "duration_seconds": 6.15,
      "text": "Let me check a few things. Any leg swelling, fever or night sweats?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.01,
      "end_seconds": 169.64,
      "duration_seconds": 6.63,
      "text": "Um, no leg swelling, fever or night sweats, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.51,
      "end_seconds": 174.25,
      "duration_seconds": 2.74,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.26,
      "end_seconds": 176.86,
      "duration_seconds": 1.6,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.71,
      "end_seconds": 179.76,
      "duration_seconds": 2.05,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.96,
      "end_seconds": 182.69,
      "duration_seconds": 1.73,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 186.05,
      "duration_seconds": 2.51,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.2,
      "end_seconds": 207.57,
      "duration_seconds": 17.37,
      "text": "I had two stents put in my heart three years ago my sister suggested writing things down, but I forgot i told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.17,
      "end_seconds": 210.13,
      "duration_seconds": 1.96,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.12,
      "end_seconds": 214.14,
      "duration_seconds": 3.02,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.99,
      "end_seconds": 218.4,
      "duration_seconds": 2.41,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.35,
      "end_seconds": 223.29,
      "duration_seconds": 3.94,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 228.55,
      "duration_seconds": 3.85,
      "text": "So, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.31,
      "end_seconds": 233.52,
      "duration_seconds": 4.21,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.36,
      "end_seconds": 237.7,
      "duration_seconds": 2.34,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.46,
      "end_seconds": 243.63,
      "duration_seconds": 4.17,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.93,
      "end_seconds": 249.63,
      "duration_seconds": 4.7,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.63,
      "end_seconds": 256.07,
      "duration_seconds": 4.44,
      "text": "Mm, no, not that I know of."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.84,
      "end_seconds": 260.36,
      "duration_seconds": 3.52,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.96,
      "end_seconds": 269.92,
      "duration_seconds": 8.96,
      "text": "Oh, um, I've had heart failure, yes. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.61,
      "end_seconds": 274.31,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.85,
      "end_seconds": 283.67,
      "duration_seconds": 8.82,
      "text": "Yeah, I've got heart disease. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.61,
      "end_seconds": 286.31,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.34,
      "end_seconds": 298.18,
      "duration_seconds": 3.84,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.73,
      "end_seconds": 308.09,
      "duration_seconds": 5.36,
      "text": "It's spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.78,
      "end_seconds": 311.92,
      "duration_seconds": 2.14,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.74,
      "end_seconds": 313.96,
      "duration_seconds": 1.22,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.15,
      "end_seconds": 334.23,
      "duration_seconds": 6.08,
      "text": "there is dullness to percussion and reduced breath sounds at the right base"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.64,
      "end_seconds": 352.72,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.81,
      "end_seconds": 358.57,
      "duration_seconds": 1.76,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.95,
      "end_seconds": 378.48,
      "duration_seconds": 5.53,
      "text": "Taking everything into account, this is probably a pleural effusion needing a cause."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.73,
      "end_seconds": 382.48,
      "duration_seconds": 2.75,
      "text": "Yeah, will it clear up?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.63,
      "end_seconds": 399.95,
      "duration_seconds": 16.32,
      "text": "Nothing I've seen today points to an emergency. It looks like a pleural effusion needing a cause, but I'd like to confirm. Let's book a pleural fluid sample to look into pleural effusion."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.0,
      "end_seconds": 402.23,
      "duration_seconds": 1.23,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.48,
      "end_seconds": 415.68,
      "duration_seconds": 12.2,
      "text": "let's book a chest X-ray to look into breathlessness. I am arranging an urgent chest clinic review. I'd like to see you again after the scan"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.18,
      "end_seconds": 422.06,
      "duration_seconds": 4.88,
      "text": "well, um, I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.77,
      "end_seconds": 426.37,
      "duration_seconds": 2.6,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.52,
      "end_seconds": 433.78,
      "duration_seconds": 4.26,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.49,
      "end_seconds": 436.7,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}