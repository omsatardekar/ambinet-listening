{
  "schema_version": "1.0",
  "encounter_id": "02724",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.57,
      "duration_seconds": 2.64,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.93,
      "end_seconds": 7.7,
      "duration_seconds": 2.77,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.86,
      "end_seconds": 10.11,
      "duration_seconds": 1.25,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.9,
      "end_seconds": 15.46,
      "duration_seconds": 3.56,
      "text": "It's a blocked nose for months, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.39,
      "end_seconds": 21.81,
      "duration_seconds": 4.42,
      "text": "Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.01,
      "end_seconds": 32.24,
      "duration_seconds": 2.23,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.58,
      "end_seconds": 60.4,
      "duration_seconds": 7.82,
      "text": "Okay: pulse is 77 beats a minute, BP is 125 over 72. And temperature 36.7, respiratory rate 18."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.26,
      "end_seconds": 62.77,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.95,
      "end_seconds": 71.03,
      "duration_seconds": 7.08,
      "text": "I'll explain what these mean in a moment. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.9,
      "end_seconds": 80.44,
      "duration_seconds": 7.54,
      "text": "About a month, I think... sorry, about three months, I got that wrong."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.96,
      "end_seconds": 85.3,
      "duration_seconds": 3.34,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.6,
      "end_seconds": 95.35,
      "duration_seconds": 8.75,
      "text": "About a three out of ten. And I've been losing my sense of smell as well."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.47,
      "end_seconds": 112.35,
      "duration_seconds": 2.88,
      "text": "Any facial swelling or nosebleeds at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.77,
      "end_seconds": 116.29,
      "duration_seconds": 2.52,
      "text": "Ah, nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.6,
      "end_seconds": 119.8,
      "duration_seconds": 2.2,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.64,
      "end_seconds": 122.11,
      "duration_seconds": 1.47,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.26,
      "end_seconds": 125.71,
      "duration_seconds": 2.45,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.55,
      "end_seconds": 129.71,
      "duration_seconds": 3.16,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.87,
      "end_seconds": 135.41,
      "duration_seconds": 2.54,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.13,
      "end_seconds": 138.99,
      "duration_seconds": 1.86,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.58,
      "end_seconds": 141.29,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.22,
      "end_seconds": 146.74,
      "duration_seconds": 3.52,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.07,
      "end_seconds": 151.01,
      "duration_seconds": 2.94,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.3,
      "end_seconds": 155.23,
      "duration_seconds": 2.93,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.23,
      "end_seconds": 160.62,
      "duration_seconds": 3.39,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.73,
      "end_seconds": 168.82,
      "duration_seconds": 4.09,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.67,
      "end_seconds": 178.71,
      "duration_seconds": 8.04,
      "text": "Alright, can you list what you take, tablets, creams or inhalers? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.54,
      "end_seconds": 184.1,
      "duration_seconds": 4.56,
      "text": "Saline spray. I take it three times a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.95,
      "end_seconds": 200.71,
      "duration_seconds": 3.76,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.53,
      "end_seconds": 204.32,
      "duration_seconds": 1.79,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.95,
      "end_seconds": 220.84,
      "duration_seconds": 2.89,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.37,
      "end_seconds": 227.48,
      "duration_seconds": 3.11,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 232.67,
      "duration_seconds": 3.68,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.74,
      "end_seconds": 236.24,
      "duration_seconds": 2.5,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.28,
      "end_seconds": 253.26,
      "duration_seconds": 3.98,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.18,
      "end_seconds": 262.74,
      "duration_seconds": 5.56,
      "text": "You can sit up now. Putting it all together, it points towards nasal polyps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.12,
      "end_seconds": 266.12,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.74,
      "end_seconds": 276.47,
      "duration_seconds": 9.73,
      "text": "I understand the worry. At the moment I'd say it's nasal polyps, and we'll know more once the a nasal endoscopy is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.34,
      "end_seconds": 301.08,
      "duration_seconds": 12.74,
      "text": "I'll request a nasal endoscopy, it'll help with nasal obstruction. We'll begin with mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That's for nasal polyps."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.88,
      "end_seconds": 303.36,
      "duration_seconds": 1.48,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.26,
      "end_seconds": 319.44,
      "duration_seconds": 14.18,
      "text": "Rinse with saline and use the spray daily. I'll also refer you to the ENT clinic. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.28,
      "end_seconds": 325.95,
      "duration_seconds": 4.67,
      "text": "Okay, so yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.93,
      "end_seconds": 330.38,
      "duration_seconds": 2.45,
      "text": "Come back in eight weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.16,
      "end_seconds": 335.59,
      "duration_seconds": 3.43,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.43,
      "end_seconds": 341.38,
      "duration_seconds": 3.95,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.92,
      "end_seconds": 345.25,
      "duration_seconds": 3.33,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.08,
      "end_seconds": 348.56,
      "duration_seconds": 1.48,
      "text": "Goodbye for now."
    }
  ]
}