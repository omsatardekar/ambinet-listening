{
  "schema_version": "1.0",
  "encounter_id": "02566",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.49,
      "duration_seconds": 4.34,
      "text": "Hi doctor, uh, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.3,
      "end_seconds": 12.23,
      "duration_seconds": 4.93,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.95,
      "end_seconds": 20.01,
      "duration_seconds": 6.06,
      "text": "Doctor, it's aching all over. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.57,
      "end_seconds": 21.89,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.08,
      "end_seconds": 26.28,
      "duration_seconds": 2.2,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.49,
      "end_seconds": 30.29,
      "duration_seconds": 3.8,
      "text": "I follow. Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.82,
      "end_seconds": 40.32,
      "duration_seconds": 9.5,
      "text": "Uh, uh, only heat, and it's not much. I've, I've also had tender spots."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.95,
      "end_seconds": 45.58,
      "duration_seconds": 3.63,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.37,
      "end_seconds": 57.2,
      "duration_seconds": 9.83,
      "text": "My partner and our baby. I walk the dog every morning. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.16,
      "end_seconds": 64.17,
      "duration_seconds": 5.01,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.26,
      "end_seconds": 71.6,
      "duration_seconds": 5.34,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 75.77,
      "duration_seconds": 3.34,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.24,
      "end_seconds": 84.45,
      "duration_seconds": 7.21,
      "text": "Yeah, it's something called dicl... diclofenac, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.29,
      "end_seconds": 89.33,
      "duration_seconds": 4.04,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.73,
      "end_seconds": 97.3,
      "duration_seconds": 6.57,
      "text": "So, no, it's at home. Okay, so I take paracetamol, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.18,
      "end_seconds": 101.29,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 103.74,
      "duration_seconds": 1.47,
      "text": "It's 1 gram."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.64,
      "end_seconds": 107.49,
      "duration_seconds": 2.85,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.93,
      "end_seconds": 115.1,
      "duration_seconds": 6.17,
      "text": "I mean, I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.84,
      "end_seconds": 136.24,
      "duration_seconds": 4.4,
      "text": "Any joint swelling, fever or weight loss at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.27,
      "end_seconds": 144.21,
      "duration_seconds": 5.94,
      "text": "I haven't had joint swelling, fever or weight loss, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.58,
      "end_seconds": 148.57,
      "duration_seconds": 2.99,
      "text": "Alright, has there been any rash?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.88,
      "end_seconds": 153.65,
      "duration_seconds": 1.77,
      "text": "No rash, thankfully."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.28,
      "end_seconds": 158.34,
      "duration_seconds": 4.06,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.3,
      "end_seconds": 161.07,
      "duration_seconds": 1.77,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.85,
      "end_seconds": 165.39,
      "duration_seconds": 2.54,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.83,
      "end_seconds": 167.83,
      "duration_seconds": 1.0,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.33,
      "end_seconds": 185.13,
      "duration_seconds": 2.8,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.4,
      "end_seconds": 197.03,
      "duration_seconds": 2.63,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.96,
      "end_seconds": 226.17,
      "duration_seconds": 14.21,
      "text": "Okay: weight 58 kilos, blood pressure 116 over 82, heart rate 67, temperature 36.6, oxygen saturation is 99 percent, respiratory rate 17, BMI works out to 21.3, height 165 centimetres."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.78,
      "end_seconds": 228.89,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.66,
      "end_seconds": 233.89,
      "duration_seconds": 3.23,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.41,
      "end_seconds": 239.81,
      "duration_seconds": 4.4,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.71,
      "end_seconds": 243.81,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.22,
      "end_seconds": 267.73,
      "duration_seconds": 5.51,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.92,
      "end_seconds": 281.05,
      "duration_seconds": 10.13,
      "text": "That's all I needed to check. Okay, so my impression is this: My working impression is fibromyalgia. Polymyalgia is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.06,
      "end_seconds": 283.83,
      "duration_seconds": 1.77,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.8,
      "end_seconds": 295.03,
      "duration_seconds": 10.23,
      "text": "I understand the worry. At the moment I'd say it's fibromyalgia, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.38,
      "end_seconds": 331.39,
      "duration_seconds": 20.01,
      "text": "Let's book blood tests to look into widespread pain. You'll be taking amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That's for pain and sleep. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.15,
      "end_seconds": 339.33,
      "duration_seconds": 4.18,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.76,
      "end_seconds": 345.39,
      "duration_seconds": 4.63,
      "text": "Gentle graded exercise such as swimming helps more than rest."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.93,
      "end_seconds": 362.48,
      "duration_seconds": 16.55,
      "text": "Mm, okay. The pain clinic would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.07,
      "end_seconds": 371.73,
      "duration_seconds": 3.66,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.91,
      "end_seconds": 384.27,
      "duration_seconds": 7.36,
      "text": "Let's review you in six weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.54,
      "end_seconds": 388.88,
      "duration_seconds": 3.34,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.66,
      "end_seconds": 392.41,
      "duration_seconds": 1.75,
      "text": "Have a good day."
    }
  ]
}