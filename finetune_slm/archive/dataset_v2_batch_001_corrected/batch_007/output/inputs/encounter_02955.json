{
  "schema_version": "1.0",
  "encounter_id": "02955",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 7.36,
      "duration_seconds": 6.58,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.43,
      "end_seconds": 13.14,
      "duration_seconds": 4.71,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.92,
      "end_seconds": 25.66,
      "duration_seconds": 11.74,
      "text": "I mean, I've been dealing with a chesty cough for a week. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.67,
      "end_seconds": 31.17,
      "duration_seconds": 3.5,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.84,
      "end_seconds": 34.91,
      "duration_seconds": 2.07,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.62,
      "end_seconds": 38.72,
      "duration_seconds": 3.1,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.72,
      "end_seconds": 44.77,
      "duration_seconds": 4.05,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.1,
      "end_seconds": 48.33,
      "duration_seconds": 2.23,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.98,
      "end_seconds": 52.8,
      "duration_seconds": 2.82,
      "text": "It's, It's all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.42,
      "end_seconds": 57.84,
      "duration_seconds": 3.42,
      "text": "Have you had a sore throat earlier?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.93,
      "end_seconds": 67.11,
      "duration_seconds": 8.18,
      "text": "Yes, about the same, two months. And slight aching, too. With slight aching, it comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.25,
      "end_seconds": 82.29,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.83,
      "end_seconds": 85.29,
      "duration_seconds": 1.46,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.56,
      "end_seconds": 92.37,
      "duration_seconds": 5.81,
      "text": "I follow. Yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.93,
      "end_seconds": 105.23,
      "duration_seconds": 3.3,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.08,
      "end_seconds": 115.62,
      "duration_seconds": 6.54,
      "text": "It's escitalopram, 10 milligrams, once a day. Honey and lemon, at night."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.52,
      "end_seconds": 126.4,
      "duration_seconds": 2.88,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.11,
      "end_seconds": 131.7,
      "duration_seconds": 4.59,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.84,
      "end_seconds": 134.79,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.19,
      "end_seconds": 140.22,
      "duration_seconds": 4.03,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.89,
      "end_seconds": 144.91,
      "duration_seconds": 3.02,
      "text": "Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.65,
      "end_seconds": 149.15,
      "duration_seconds": 2.5,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.29,
      "end_seconds": 153.27,
      "duration_seconds": 2.98,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.99,
      "end_seconds": 155.71,
      "duration_seconds": 1.72,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.99,
      "end_seconds": 161.37,
      "duration_seconds": 4.38,
      "text": "Any breathlessness, chest pain or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 169.11,
      "duration_seconds": 6.25,
      "text": "No breathlessness, chest pain or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.35,
      "end_seconds": 175.44,
      "duration_seconds": 5.09,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.23,
      "end_seconds": 182.25,
      "duration_seconds": 2.02,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.21,
      "end_seconds": 188.03,
      "duration_seconds": 3.82,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.04,
      "end_seconds": 192.05,
      "duration_seconds": 3.01,
      "text": "Well, no, all normal there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.79,
      "end_seconds": 196.46,
      "duration_seconds": 2.67,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.65,
      "end_seconds": 208.44,
      "duration_seconds": 2.79,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.78,
      "end_seconds": 233.96,
      "duration_seconds": 6.18,
      "text": "Okay: respiratory rate 14, pulse 73. And saturation 98 percent, pressure 124 over 71."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.18,
      "end_seconds": 239.39,
      "duration_seconds": 4.21,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.23,
      "end_seconds": 241.93,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.14,
      "end_seconds": 245.94,
      "duration_seconds": 2.8,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.42,
      "end_seconds": 261.74,
      "duration_seconds": 4.32,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.74,
      "end_seconds": 270.42,
      "duration_seconds": 6.68,
      "text": "You can sit up now. Having listened and examined, this is probably acute viral bronchitis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.06,
      "end_seconds": 275.23,
      "duration_seconds": 3.17,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.17,
      "end_seconds": 300.99,
      "duration_seconds": 23.82,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. A short walk every day, even twenty minutes, will help more than you'd think. I'd like you back if not better in three weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 301.5,
      "end_seconds": 306.18,
      "duration_seconds": 4.68,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.28,
      "end_seconds": 311.05,
      "duration_seconds": 3.77,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.04,
      "end_seconds": 316.71,
      "duration_seconds": 3.67,
      "text": "Oh, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.23,
      "end_seconds": 318.66,
      "duration_seconds": 1.43,
      "text": "See you soon."
    }
  ]
}