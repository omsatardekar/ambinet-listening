{
  "schema_version": "1.0",
  "encounter_id": "02867",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.82,
      "end_seconds": 4.92,
      "duration_seconds": 4.1,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.17,
      "duration_seconds": 3.68,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.67,
      "end_seconds": 18.47,
      "duration_seconds": 5.8,
      "text": "so the thing is, I've got a widespread rash with fever"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.04,
      "end_seconds": 21.29,
      "duration_seconds": 2.25,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.92,
      "end_seconds": 25.88,
      "duration_seconds": 3.96,
      "text": "I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 26.55,
      "end_seconds": 31.88,
      "duration_seconds": 5.33,
      "text": "Doctor, our chart from the last visit lists it as 160 milligrams."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.96,
      "end_seconds": 38.16,
      "duration_seconds": 5.2,
      "text": "okay have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 47.87,
      "duration_seconds": 9.07,
      "text": "Let me think, not with me. I'll bring it it next time. Lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.16,
      "end_seconds": 52.52,
      "duration_seconds": 3.36,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.98,
      "end_seconds": 65.17,
      "duration_seconds": 11.19,
      "text": "it's been like this since last weekend. My neighbour said I should get it looked at. I told my wife I'd come today"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.43,
      "end_seconds": 71.67,
      "duration_seconds": 3.24,
      "text": "Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.18,
      "end_seconds": 103.0,
      "duration_seconds": 30.82,
      "text": "I'd call it moderate. Oh, and swollen glands. With swollen glands, I'd call it mild. As for swollen face, I honestly can't say when that began. It might have been last month or the month before. With swollen face, I'd say every other day. And a recent new medicine as well, since this morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.51,
      "end_seconds": 109.27,
      "duration_seconds": 5.76,
      "text": "I follow. A few quick ones: breathing difficulty, mouth sores or blisters?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.83,
      "end_seconds": 113.65,
      "duration_seconds": 3.82,
      "text": "No, no breathing difficulty, mouth sores or blisters."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.34,
      "end_seconds": 120.63,
      "duration_seconds": 2.29,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.46,
      "end_seconds": 123.08,
      "duration_seconds": 1.62,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.19,
      "end_seconds": 126.56,
      "duration_seconds": 2.37,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.37,
      "end_seconds": 130.95,
      "duration_seconds": 2.58,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.96,
      "end_seconds": 136.64,
      "duration_seconds": 3.68,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.11,
      "end_seconds": 142.91,
      "duration_seconds": 4.8,
      "text": "I've had gout, yes. Epilepsy, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.27,
      "end_seconds": 149.21,
      "duration_seconds": 4.94,
      "text": "Alright, gout and epilepsy, that matches what I have here."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 166.76,
      "duration_seconds": 4.28,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.06,
      "end_seconds": 175.79,
      "duration_seconds": 4.73,
      "text": "my grandfather had a stroke my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.97,
      "end_seconds": 194.49,
      "duration_seconds": 8.52,
      "text": "Are there any allergies I should be aware of? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.29,
      "end_seconds": 205.1,
      "duration_seconds": 9.81,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.87,
      "end_seconds": 228.05,
      "duration_seconds": 4.18,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.02,
      "end_seconds": 245.31,
      "duration_seconds": 15.29,
      "text": "Nothing, I'm teetotal. I smoke roughly a pack every two days. I do a yoga class on Thursdays. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.22,
      "end_seconds": 250.43,
      "duration_seconds": 3.21,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.04,
      "end_seconds": 255.03,
      "duration_seconds": 3.99,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 258.32,
      "end_seconds": 273.64,
      "duration_seconds": 15.32,
      "text": "Okay, so the vitals from earlier. Pulse 97, respiratory rate 17, height 159 centimetres, BMI works out to 29.7, temperature is 39.1 degrees, blood pressure 119 over 72, weight 75 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.2,
      "end_seconds": 277.9,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.83,
      "end_seconds": 283.39,
      "duration_seconds": 2.56,
      "text": "alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.22,
      "end_seconds": 287.15,
      "duration_seconds": 1.93,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.6,
      "end_seconds": 302.34,
      "duration_seconds": 6.74,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.21,
      "end_seconds": 305.25,
      "duration_seconds": 1.04,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.64,
      "end_seconds": 335.04,
      "duration_seconds": 25.4,
      "text": "All finished, thank you. Having listened and examined, this is probably a severe drug reaction. Another possibility is a viral rash. I think urgent blood tests makes sense here, for severe drug reaction. I'd like you to take prednisolone, 40 milligrams, once a day, until review. That should help with severe drug reaction. Stop the allopurinol now and you need admission."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.02,
      "end_seconds": 347.64,
      "duration_seconds": 10.62,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'll also refer you to the dermatology team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.75,
      "end_seconds": 350.4,
      "duration_seconds": 1.65,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.05,
      "end_seconds": 359.12,
      "duration_seconds": 8.07,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.76,
      "end_seconds": 360.65,
      "duration_seconds": 0.89,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.41,
      "end_seconds": 369.11,
      "duration_seconds": 6.7,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 369.85,
      "end_seconds": 371.76,
      "duration_seconds": 1.91,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.48,
      "end_seconds": 379.79,
      "duration_seconds": 6.31,
      "text": "I'll want another look straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 380.88,
      "end_seconds": 383.0,
      "duration_seconds": 2.12,
      "text": "Thank you, that's helpful."
    }
  ]
}