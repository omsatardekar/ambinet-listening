{
  "schema_version": "1.0",
  "encounter_id": "02628",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 3.17,
      "duration_seconds": 2.59,
      "text": "right, thanks for waiting, come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.03,
      "end_seconds": 11.6,
      "duration_seconds": 6.57,
      "text": "Mm, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.19,
      "end_seconds": 16.45,
      "duration_seconds": 4.26,
      "text": "Absolutely, come and sit beside them. Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.23,
      "end_seconds": 26.1,
      "duration_seconds": 4.87,
      "text": "so the thing is, I've got sneezing in spring"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.7,
      "end_seconds": 30.43,
      "duration_seconds": 3.73,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.28,
      "end_seconds": 37.3,
      "duration_seconds": 5.02,
      "text": "it's, It's been about a week, I'm fairly sure"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 42.05,
      "duration_seconds": 3.58,
      "text": "Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.98,
      "end_seconds": 43.97,
      "duration_seconds": 0.99,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.24,
      "end_seconds": 47.42,
      "duration_seconds": 2.18,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.14,
      "end_seconds": 51.98,
      "duration_seconds": 2.84,
      "text": "I notice it more with pollen."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.78,
      "end_seconds": 59.1,
      "duration_seconds": 6.32,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 59.2,
      "end_seconds": 64.66,
      "duration_seconds": 5.46,
      "text": "Oh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.26,
      "end_seconds": 80.41,
      "duration_seconds": 14.15,
      "text": "I was getting to that! As for runny itchy nose, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.23,
      "end_seconds": 85.15,
      "duration_seconds": 3.92,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.89,
      "end_seconds": 90.78,
      "duration_seconds": 3.89,
      "text": "I'd give it a eight, out of ten"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.57,
      "end_seconds": 106.44,
      "duration_seconds": 3.87,
      "text": "did you get loss of smell or wheeze?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.04,
      "end_seconds": 120.33,
      "duration_seconds": 12.29,
      "text": "I mean, no, no loss of smell, no wheeze. I did have watery eyes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.22,
      "end_seconds": 124.24,
      "duration_seconds": 3.02,
      "text": "did you get fever or facial pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.22,
      "end_seconds": 128.01,
      "duration_seconds": 2.79,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.04,
      "end_seconds": 138.47,
      "duration_seconds": 4.43,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.2,
      "end_seconds": 143.11,
      "duration_seconds": 2.91,
      "text": "No, that that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.72,
      "end_seconds": 152.86,
      "duration_seconds": 8.14,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.62,
      "end_seconds": 156.93,
      "duration_seconds": 2.31,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 158.15,
      "end_seconds": 164.92,
      "duration_seconds": 6.77,
      "text": "Hold on, doctor, I think she reacted to diclofenac once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.29,
      "end_seconds": 169.49,
      "duration_seconds": 3.2,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.17,
      "end_seconds": 181.63,
      "duration_seconds": 6.46,
      "text": "Alright, so that's unclear. I'll record what each of you said. Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.0,
      "end_seconds": 185.8,
      "duration_seconds": 2.8,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.04,
      "end_seconds": 190.74,
      "duration_seconds": 3.7,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.35,
      "end_seconds": 194.74,
      "duration_seconds": 2.39,
      "text": "It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 195.24,
      "end_seconds": 202.95,
      "duration_seconds": 7.71,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.4,
      "end_seconds": 214.72,
      "duration_seconds": 10.32,
      "text": "Rosuvastatin, 10 milligrams, at night for my cholesterol it's something called lora... loratadine, 10 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.5,
      "end_seconds": 221.2,
      "duration_seconds": 4.7,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.73,
      "end_seconds": 223.76,
      "duration_seconds": 2.03,
      "text": "no, it's at home"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.74,
      "end_seconds": 229.24,
      "duration_seconds": 3.5,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.71,
      "end_seconds": 238.9,
      "duration_seconds": 8.19,
      "text": "I've had eczema for about a year now. Ah, I have high cholesterol, for about a year"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.65,
      "end_seconds": 249.26,
      "duration_seconds": 4.61,
      "text": "alright, high cholesterol, that matches what I have here"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 250.1,
      "end_seconds": 258.22,
      "duration_seconds": 8.12,
      "text": "doctor, I've got the readings for you. Saturation 97 percent, pulse 71, temperature is 36.4 degrees. Pressure 126 over 82."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.59,
      "end_seconds": 260.56,
      "duration_seconds": 0.97,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.13,
      "end_seconds": 264.9,
      "duration_seconds": 2.77,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.62,
      "end_seconds": 268.49,
      "duration_seconds": 2.87,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.87,
      "end_seconds": 272.78,
      "duration_seconds": 2.91,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.88,
      "end_seconds": 294.99,
      "duration_seconds": 5.11,
      "text": "the inside of the nose is pale and boggy with clear mucus"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.09,
      "end_seconds": 302.97,
      "duration_seconds": 2.88,
      "text": "Right, you can sit up now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.67,
      "end_seconds": 342.71,
      "duration_seconds": 31.04,
      "text": "Right, here's what I'm thinking. It fits best with seasonal allergic rhinitis. For this, fluticasone nasal spray, 50 micrograms, once a day, the season. That That should help with hay fever. Shower after being outdoors and keep windows shut when pollen is high. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review if not better in a month."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 343.61,
      "end_seconds": 346.92,
      "duration_seconds": 3.31,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.9,
      "end_seconds": 351.82,
      "duration_seconds": 2.92,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.73,
      "end_seconds": 357.93,
      "duration_seconds": 4.2,
      "text": "right, you know, alright, thanks, take care"
    }
  ]
}