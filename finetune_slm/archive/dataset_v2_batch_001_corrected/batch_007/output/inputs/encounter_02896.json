{
  "schema_version": "1.0",
  "encounter_id": "02896",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.97,
      "duration_seconds": 3.68,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 11.14,
      "duration_seconds": 4.26,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.09,
      "end_seconds": 19.12,
      "duration_seconds": 6.03,
      "text": "Hello, you know, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.11,
      "end_seconds": 24.74,
      "duration_seconds": 4.63,
      "text": "I've been dealing with a blister on my heel."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.97,
      "end_seconds": 29.37,
      "duration_seconds": 3.4,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.15,
      "end_seconds": 32.82,
      "duration_seconds": 2.67,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.6,
      "end_seconds": 36.54,
      "duration_seconds": 1.94,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.53,
      "end_seconds": 47.95,
      "duration_seconds": 9.42,
      "text": "I mean, it's worse with new shoes. Um, um, I've also had a little soreness, for three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.28,
      "end_seconds": 51.31,
      "duration_seconds": 2.03,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.97,
      "end_seconds": 67.3,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.26,
      "end_seconds": 91.95,
      "duration_seconds": 6.69,
      "text": "Okay: saturation 98 percent, temp 36.7 degrees, pulse 77. And BP is 120 over 69."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.73,
      "end_seconds": 99.22,
      "duration_seconds": 4.49,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 103.34,
      "duration_seconds": 2.44,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.95,
      "end_seconds": 118.71,
      "duration_seconds": 6.76,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.61,
      "end_seconds": 124.95,
      "duration_seconds": 2.34,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.7,
      "end_seconds": 142.14,
      "duration_seconds": 3.44,
      "text": "A few quick ones: fever or pus?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.19,
      "end_seconds": 148.49,
      "duration_seconds": 5.3,
      "text": "Okay, so no fever or pus, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.81,
      "end_seconds": 154.03,
      "duration_seconds": 4.22,
      "text": "Right, a few quick ones: redness spreading or diabetes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.94,
      "end_seconds": 159.46,
      "duration_seconds": 3.52,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.48,
      "end_seconds": 165.5,
      "duration_seconds": 4.02,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.41,
      "end_seconds": 170.58,
      "duration_seconds": 4.17,
      "text": "I mean, no, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.43,
      "end_seconds": 173.84,
      "duration_seconds": 2.41,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.51,
      "end_seconds": 178.94,
      "duration_seconds": 3.43,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.21,
      "end_seconds": 197.58,
      "duration_seconds": 3.37,
      "text": "Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.87,
      "end_seconds": 204.03,
      "duration_seconds": 5.16,
      "text": "Oh, I'm allergic to naproxen, I get a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.91,
      "end_seconds": 208.44,
      "duration_seconds": 3.53,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.07,
      "end_seconds": 225.02,
      "duration_seconds": 15.95,
      "text": "I have arthritis in my knees. I've got an irregular heartbeat. I've never really been one for hospitals. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.1,
      "end_seconds": 233.21,
      "duration_seconds": 7.11,
      "text": "Okay, go on. Alright, an irregular heartbeat, that matches what I have here. Any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.68,
      "end_seconds": 238.84,
      "duration_seconds": 4.16,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.81,
      "end_seconds": 243.58,
      "duration_seconds": 2.77,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.31,
      "end_seconds": 249.18,
      "duration_seconds": 3.87,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.72,
      "end_seconds": 253.41,
      "duration_seconds": 2.69,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.08,
      "end_seconds": 258.35,
      "duration_seconds": 3.27,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.83,
      "end_seconds": 262.93,
      "duration_seconds": 3.1,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.57,
      "end_seconds": 267.97,
      "duration_seconds": 3.4,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.55,
      "end_seconds": 271.9,
      "duration_seconds": 3.35,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.86,
      "end_seconds": 280.95,
      "duration_seconds": 8.09,
      "text": "Diclofenac. I take it 50 milligrams, when needed. Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.02,
      "end_seconds": 298.77,
      "duration_seconds": 16.75,
      "text": "Okay, so my impression is this: The most likely explanation is a simple friction blister. Leave it intact, cover it with a padded plaster and change the shoes. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.92,
      "end_seconds": 302.35,
      "duration_seconds": 2.43,
      "text": "Alright, thanks, take care."
    }
  ]
}