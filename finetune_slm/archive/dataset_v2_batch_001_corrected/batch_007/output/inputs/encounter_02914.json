{
  "schema_version": "1.0",
  "encounter_id": "02914",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.23,
      "duration_seconds": 3.09,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.25,
      "end_seconds": 11.12,
      "duration_seconds": 5.87,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.02,
      "end_seconds": 22.32,
      "duration_seconds": 10.3,
      "text": "Well, I've been having blurred vision in one eye. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.94,
      "end_seconds": 27.6,
      "duration_seconds": 3.66,
      "text": "Alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.77,
      "end_seconds": 35.66,
      "duration_seconds": 6.89,
      "text": "Sorry, what was I saying, it's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.75,
      "end_seconds": 40.48,
      "duration_seconds": 2.73,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.44,
      "end_seconds": 50.79,
      "duration_seconds": 9.35,
      "text": "Mild, really. I've had a scalp that hurts to brush too, for about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.54,
      "end_seconds": 55.02,
      "duration_seconds": 2.48,
      "text": "Any pain when chewing as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.93,
      "end_seconds": 71.65,
      "duration_seconds": 15.72,
      "text": "Yeah. Five days, I'd say. Right, about pain when chewing, it happens on and off. I did have a new headache at the temple at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.97,
      "end_seconds": 84.1,
      "duration_seconds": 2.13,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.35,
      "end_seconds": 89.38,
      "duration_seconds": 4.03,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.19,
      "end_seconds": 93.16,
      "duration_seconds": 1.97,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.3,
      "end_seconds": 98.87,
      "duration_seconds": 4.57,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.66,
      "end_seconds": 102.61,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.07,
      "end_seconds": 112.88,
      "duration_seconds": 4.81,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.09,
      "end_seconds": 118.64,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 127.46,
      "duration_seconds": 7.84,
      "text": "Okay, so I take something called pant... pantoprazole, 40 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.39,
      "end_seconds": 131.6,
      "duration_seconds": 3.21,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.24,
      "end_seconds": 135.48,
      "duration_seconds": 2.24,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.07,
      "end_seconds": 140.31,
      "duration_seconds": 3.24,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.14,
      "end_seconds": 151.75,
      "duration_seconds": 9.61,
      "text": "Just keyhole surgery on my gallbladder, two years back. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.1,
      "end_seconds": 157.02,
      "duration_seconds": 3.92,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.07,
      "end_seconds": 170.22,
      "duration_seconds": 11.15,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.86,
      "end_seconds": 174.38,
      "duration_seconds": 3.52,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.73,
      "end_seconds": 184.49,
      "duration_seconds": 8.76,
      "text": "I've had acid reflux, yes. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.89,
      "end_seconds": 194.64,
      "duration_seconds": 4.75,
      "text": "Yes. Any shoulder stiffness, fever or weight loss at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.58,
      "end_seconds": 200.8,
      "duration_seconds": 4.22,
      "text": "Right, um, nope, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.29,
      "end_seconds": 204.78,
      "duration_seconds": 2.49,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.43,
      "end_seconds": 209.15,
      "duration_seconds": 2.72,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.04,
      "end_seconds": 212.46,
      "duration_seconds": 2.42,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.14,
      "end_seconds": 218.13,
      "duration_seconds": 3.99,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.23,
      "end_seconds": 225.92,
      "duration_seconds": 3.69,
      "text": "So, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.77,
      "end_seconds": 239.3,
      "duration_seconds": 2.53,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.19,
      "end_seconds": 268.62,
      "duration_seconds": 7.43,
      "text": "Okay: heart rate 69, oxygen saturation is 98 percent, pressure 113 over 70, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.86,
      "end_seconds": 271.55,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.48,
      "end_seconds": 275.34,
      "duration_seconds": 2.86,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.03,
      "end_seconds": 282.25,
      "duration_seconds": 4.22,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.38,
      "end_seconds": 284.78,
      "duration_seconds": 1.4,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.74,
      "end_seconds": 303.5,
      "duration_seconds": 4.76,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.21,
      "end_seconds": 309.88,
      "duration_seconds": 2.67,
      "text": "Right, you can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.27,
      "end_seconds": 333.4,
      "duration_seconds": 10.13,
      "text": "So where does that leave us? It points towards possible giant cell arteritis threatening sight. A migraine is also on my list."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.17,
      "end_seconds": 336.76,
      "duration_seconds": 1.59,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.36,
      "end_seconds": 346.78,
      "duration_seconds": 9.42,
      "text": "Nothing I've seen today points to an emergency. It looks like possible giant cell arteritis threatening sight, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.41,
      "end_seconds": 363.3,
      "duration_seconds": 5.89,
      "text": "I want a temporal artery biopsy done, that's for possible giant cell arteritis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 365.17,
      "end_seconds": 367.94,
      "duration_seconds": 2.77,
      "text": "The earliest is Tuesday, 11:30 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.16,
      "end_seconds": 374.6,
      "duration_seconds": 5.44,
      "text": "I'd like to arrange urgent blood tests for possible giant cell arteritis."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.15,
      "end_seconds": 382.22,
      "duration_seconds": 2.07,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.91,
      "end_seconds": 403.78,
      "duration_seconds": 20.87,
      "text": "I'll start you on prednisolone, 60 milligrams, once a day, until review. That's for possible giant cell arteritis. Start the steroid today, this is to protect your sight. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.62,
      "end_seconds": 408.71,
      "duration_seconds": 3.09,
      "text": "Okay, you know, makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.62,
      "end_seconds": 415.54,
      "duration_seconds": 5.92,
      "text": "We'll catch up tomorrow. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.64,
      "end_seconds": 420.34,
      "duration_seconds": 2.7,
      "text": "That's clear, uh, thanks."
    }
  ]
}