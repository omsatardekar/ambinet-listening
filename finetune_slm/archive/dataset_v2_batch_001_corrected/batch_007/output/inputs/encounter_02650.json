{
  "schema_version": "1.0",
  "encounter_id": "02650",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 5.93,
      "duration_seconds": 5.17,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 11.1,
      "duration_seconds": 4.24,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.91,
      "end_seconds": 21.49,
      "duration_seconds": 9.58,
      "text": "I've been dealing with weakness climbing up my legs. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.28,
      "end_seconds": 25.05,
      "duration_seconds": 1.77,
      "text": "Okay, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.96,
      "end_seconds": 29.68,
      "duration_seconds": 2.72,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 39.46,
      "duration_seconds": 3.44,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.35,
      "end_seconds": 41.46,
      "duration_seconds": 1.11,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.25,
      "end_seconds": 46.13,
      "duration_seconds": 2.88,
      "text": "And back pain, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.85,
      "end_seconds": 51.24,
      "duration_seconds": 3.39,
      "text": "Not that I've noticed, no back pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.83,
      "end_seconds": 55.79,
      "duration_seconds": 3.96,
      "text": "So, did you get fever or bladder problems?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.78,
      "end_seconds": 61.24,
      "duration_seconds": 3.46,
      "text": "No, no fever or bladder problems."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.97,
      "end_seconds": 68.57,
      "duration_seconds": 4.6,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.38,
      "end_seconds": 72.9,
      "duration_seconds": 2.52,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.76,
      "end_seconds": 80.36,
      "duration_seconds": 2.6,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.41,
      "end_seconds": 82.43,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.95,
      "end_seconds": 96.69,
      "duration_seconds": 3.74,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.28,
      "end_seconds": 100.93,
      "duration_seconds": 3.65,
      "text": "Yes, walnuts. I get my lips swelling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.19,
      "end_seconds": 102.99,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.51,
      "end_seconds": 106.64,
      "duration_seconds": 3.13,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.9,
      "end_seconds": 109.28,
      "duration_seconds": 1.38,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.03,
      "end_seconds": 114.98,
      "duration_seconds": 3.95,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.14,
      "end_seconds": 121.17,
      "duration_seconds": 3.03,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.68,
      "end_seconds": 124.59,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.61,
      "end_seconds": 129.42,
      "duration_seconds": 2.81,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.84,
      "end_seconds": 135.66,
      "duration_seconds": 2.82,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.74,
      "end_seconds": 155.73,
      "duration_seconds": 3.99,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.22,
      "end_seconds": 158.99,
      "duration_seconds": 1.77,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.27,
      "end_seconds": 178.6,
      "duration_seconds": 2.33,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.45,
      "end_seconds": 194.13,
      "duration_seconds": 2.68,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.7,
      "end_seconds": 219.89,
      "duration_seconds": 10.19,
      "text": "Okay: pulse 65, height 167 centimetres. And weight 64 kilos, BP is 115 over 82, respiratory rate 18, BMI works out to 22.9."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.25,
      "end_seconds": 223.46,
      "duration_seconds": 2.21,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.1,
      "end_seconds": 236.32,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.77,
      "end_seconds": 239.87,
      "duration_seconds": 2.1,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.36,
      "end_seconds": 256.65,
      "duration_seconds": 6.29,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.19,
      "end_seconds": 274.71,
      "duration_seconds": 12.52,
      "text": "Okay, that's enough for me. Stop me if I've got anything wrong. You've had weakness climbing up your legs for three weeks, moderate, and no back pain or fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.05,
      "end_seconds": 281.71,
      "duration_seconds": 1.66,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.59,
      "end_seconds": 317.94,
      "duration_seconds": 34.35,
      "text": "Let's get a breathing test, for possible GBS. I'd rather check than guess, and this is the quickest way to know more. You must be admitted today for monitoring of your breathing. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. See me again straight away. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.96,
      "end_seconds": 327.37,
      "duration_seconds": 4.41,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.1,
      "end_seconds": 335.15,
      "duration_seconds": 5.05,
      "text": "Yes, exactly right. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.72,
      "end_seconds": 338.31,
      "duration_seconds": 2.59,
      "text": "Yeah, thank you, that's helpful."
    }
  ]
}