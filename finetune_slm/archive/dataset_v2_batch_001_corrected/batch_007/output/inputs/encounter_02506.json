{
  "schema_version": "1.0",
  "encounter_id": "02506",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 4.48,
      "duration_seconds": 3.88,
      "text": "Hi there, the the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.39,
      "end_seconds": 8.31,
      "duration_seconds": 2.92,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.89,
      "end_seconds": 11.61,
      "duration_seconds": 2.72,
      "text": "what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 20.02,
      "duration_seconds": 7.81,
      "text": "Mainly weakness climbing up my legs. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.95,
      "end_seconds": 25.12,
      "duration_seconds": 3.17,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 33.01,
      "duration_seconds": 6.84,
      "text": "it's been four weeks, I'm fairly sure. I'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.62,
      "end_seconds": 41.33,
      "duration_seconds": 3.71,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.0,
      "end_seconds": 45.27,
      "duration_seconds": 2.27,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.68,
      "end_seconds": 49.53,
      "duration_seconds": 2.85,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.71,
      "end_seconds": 58.84,
      "duration_seconds": 8.13,
      "text": "It usually comes with a recent stomach bug. The recent stomach bug? That's been for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.06,
      "end_seconds": 62.06,
      "duration_seconds": 2.0,
      "text": "Any difficulty walking as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.02,
      "end_seconds": 67.23,
      "duration_seconds": 3.21,
      "text": "Okay, so yes, for one week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.95,
      "end_seconds": 86.16,
      "duration_seconds": 4.21,
      "text": "Have you noticed fever, bladder problems or back pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.62,
      "end_seconds": 90.42,
      "duration_seconds": 2.8,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.9,
      "end_seconds": 94.16,
      "duration_seconds": 2.26,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.92,
      "end_seconds": 95.85,
      "duration_seconds": 0.93,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.76,
      "end_seconds": 109.37,
      "duration_seconds": 3.61,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.57,
      "end_seconds": 119.09,
      "duration_seconds": 4.52,
      "text": "I've had thin bones for two years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.71,
      "end_seconds": 121.49,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.51,
      "end_seconds": 130.57,
      "duration_seconds": 8.06,
      "text": "Uh, you know, I have heart failure. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.24,
      "end_seconds": 143.18,
      "duration_seconds": 10.94,
      "text": "Hm, okay. Yes, thin bones and heart failure are known to us, good to have that clear. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.56,
      "end_seconds": 153.58,
      "duration_seconds": 4.02,
      "text": "no, not that that I know of"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.13,
      "end_seconds": 159.78,
      "duration_seconds": 4.65,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.43,
      "end_seconds": 172.75,
      "duration_seconds": 12.32,
      "text": "I'm a plumber, lots of bending and kneeling. I'm vegetarian and have been for years. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.53,
      "end_seconds": 176.85,
      "duration_seconds": 3.32,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 177.6,
      "end_seconds": 189.12,
      "duration_seconds": 11.52,
      "text": "It's alendronate, 70 milligrams, once a week for my bones, doctor. Erm, she takes metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.81,
      "end_seconds": 203.53,
      "duration_seconds": 3.72,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.38,
      "end_seconds": 214.95,
      "duration_seconds": 2.57,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.63,
      "end_seconds": 237.39,
      "duration_seconds": 7.76,
      "text": "okay: pulse is 71 beats a minute, pressure 120 over 74, respiratory rate 14, temperature is 36.8 degrees"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.1,
      "end_seconds": 240.69,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.12,
      "end_seconds": 246.09,
      "duration_seconds": 3.97,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.91,
      "end_seconds": 252.07,
      "duration_seconds": 4.16,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.98,
      "end_seconds": 256.27,
      "duration_seconds": 2.29,
      "text": "okay, um, doctor"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.18,
      "end_seconds": 259.2,
      "duration_seconds": 2.02,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.53,
      "end_seconds": 283.05,
      "duration_seconds": 5.52,
      "text": "your ankle reflexes are absent and the strength in both legs is reduced"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.41,
      "end_seconds": 287.0,
      "duration_seconds": 2.59,
      "text": "yeah, you know, no problem"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.49,
      "end_seconds": 300.81,
      "duration_seconds": 10.32,
      "text": "Please sit back down. Okay, so my impression is this: This is probably possible Guillain-Barre syndrome. I can't rule out a spinal cord problem yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.2,
      "end_seconds": 304.41,
      "duration_seconds": 2.21,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.02,
      "end_seconds": 324.1,
      "duration_seconds": 18.08,
      "text": "Nothing I've seen today points to an emergency. It looks like possible Guillain-Barre syndrome, but I'd like to confirm. Let me just check I've got this right. You've had weakness climbing up your legs for four weeks, moderate, and no fever or bladder problems."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.33,
      "end_seconds": 326.03,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.0,
      "end_seconds": 332.15,
      "duration_seconds": 4.15,
      "text": "let's book a breathing test to look into possible GBS"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.89,
      "end_seconds": 335.44,
      "duration_seconds": 1.55,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.5,
      "end_seconds": 352.39,
      "duration_seconds": 14.89,
      "text": "We should do a lumbar puncture for possible GBS. You must be admitted today for monitoring of your breathing. Let's get you seen by the neurology team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 354.15,
      "end_seconds": 354.85,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.95,
      "end_seconds": 366.03,
      "duration_seconds": 10.08,
      "text": "if the symptoms get worse, that's the point to come in urgently. I'll want another look straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 369.95,
      "end_seconds": 372.29,
      "duration_seconds": 2.34,
      "text": "Thank you, that's helpful."
    }
  ]
}