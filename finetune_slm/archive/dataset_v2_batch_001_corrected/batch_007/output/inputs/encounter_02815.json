{
  "schema_version": "1.0",
  "encounter_id": "02815",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.43,
      "duration_seconds": 3.69,
      "text": "Sorry I'm a a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 9.87,
      "duration_seconds": 3.67,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.54,
      "end_seconds": 17.52,
      "duration_seconds": 5.98,
      "text": "Yeah, it's numbness in the foot. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.37,
      "end_seconds": 22.74,
      "duration_seconds": 3.37,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.98,
      "end_seconds": 36.62,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.46,
      "end_seconds": 62.68,
      "duration_seconds": 12.22,
      "text": "okay: pulse 116, respiratory rate 16. And BP is 120 over 74, temp 37.0 degrees, oxygen saturation is 98 percent how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.24,
      "end_seconds": 76.28,
      "duration_seconds": 12.04,
      "text": "Ever since... since Monday, really. I had not being able to move the foot before. That's settled now, um, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.48,
      "end_seconds": 91.65,
      "duration_seconds": 5.17,
      "text": "let me check a few things. Any recent injury, chest pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.28,
      "end_seconds": 98.11,
      "duration_seconds": 5.83,
      "text": "I haven't had recent injury, chest pain or fever, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.24,
      "end_seconds": 102.18,
      "duration_seconds": 2.94,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.39,
      "end_seconds": 106.14,
      "duration_seconds": 2.75,
      "text": "actually, no, joints are fine"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.81,
      "end_seconds": 108.91,
      "duration_seconds": 2.1,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.63,
      "end_seconds": 112.29,
      "duration_seconds": 2.66,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.05,
      "end_seconds": 118.42,
      "duration_seconds": 5.37,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.8,
      "end_seconds": 127.16,
      "duration_seconds": 4.36,
      "text": "oh, uh, yes, milk i get stomach cramps"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.13,
      "end_seconds": 133.55,
      "duration_seconds": 4.42,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.24,
      "end_seconds": 136.51,
      "duration_seconds": 2.27,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.79,
      "end_seconds": 145.2,
      "duration_seconds": 7.41,
      "text": "right, right yes, an irregular heartbeat is known to us, good to have that clear how about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.81,
      "end_seconds": 149.89,
      "duration_seconds": 3.08,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.86,
      "end_seconds": 153.37,
      "duration_seconds": 2.51,
      "text": "Okay, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.6,
      "end_seconds": 157.29,
      "duration_seconds": 2.69,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.92,
      "end_seconds": 160.73,
      "duration_seconds": 1.81,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.14,
      "end_seconds": 165.48,
      "duration_seconds": 3.34,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.35,
      "end_seconds": 168.34,
      "duration_seconds": 1.99,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.45,
      "end_seconds": 173.33,
      "duration_seconds": 3.88,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.36,
      "end_seconds": 176.31,
      "duration_seconds": 1.95,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.9,
      "end_seconds": 184.18,
      "duration_seconds": 7.28,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.71,
      "end_seconds": 203.57,
      "duration_seconds": 2.86,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.44,
      "end_seconds": 207.8,
      "duration_seconds": 2.36,
      "text": "my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.5,
      "end_seconds": 212.28,
      "duration_seconds": 3.78,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.8,
      "end_seconds": 217.28,
      "duration_seconds": 4.48,
      "text": "Metoprolol i take it 50 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.61,
      "end_seconds": 219.13,
      "duration_seconds": 1.52,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.69,
      "end_seconds": 225.6,
      "duration_seconds": 3.91,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.82,
      "end_seconds": 228.19,
      "duration_seconds": 1.37,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.5,
      "end_seconds": 242.7,
      "duration_seconds": 7.2,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.07,
      "end_seconds": 247.74,
      "duration_seconds": 1.67,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.88,
      "end_seconds": 271.8,
      "duration_seconds": 12.92,
      "text": "Let me tell you where I've got to. I don't have a clear answer today: an acutely ischaemic leg is possible, and so is a deep vein thrombosis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.72,
      "end_seconds": 275.79,
      "duration_seconds": 3.07,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.28,
      "end_seconds": 293.48,
      "duration_seconds": 16.2,
      "text": "I understand the worry. At the moment I'd say it's an acutely ischaemic leg, and we'll know more once the an urgent CT angiogram is back. We should do an urgent CT angiogram for acute limb ischaemia."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.57,
      "end_seconds": 296.1,
      "duration_seconds": 1.53,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.69,
      "end_seconds": 314.32,
      "duration_seconds": 16.63,
      "text": "I'm prescribing heparin, 5000 units, bolus now, single dose. That's for limb ischaemia. You need the vascular surgeons now, this is time critical. Please come and see me straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.24,
      "end_seconds": 318.21,
      "duration_seconds": 1.97,
      "text": "Thank you, that's helpful."
    }
  ]
}