{
  "schema_version": "1.0",
  "encounter_id": "02788",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.79,
      "duration_seconds": 4.2,
      "text": "Hi doctor, uh, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 9.71,
      "duration_seconds": 4.0,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.21,
      "end_seconds": 18.5,
      "duration_seconds": 8.29,
      "text": "Yeah, um, it's bright red blood on the paper. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 19.31,
      "end_seconds": 28.41,
      "duration_seconds": 9.1,
      "text": "Okay, so the vitals from earlier. Temperature is 36.5 degrees, oxygen saturation is 99 percent, pressure 116 over 81. Pulse 66."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.97,
      "end_seconds": 33.84,
      "duration_seconds": 4.87,
      "text": "Good, thank you. How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.79,
      "end_seconds": 44.92,
      "duration_seconds": 10.13,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.49,
      "end_seconds": 50.47,
      "duration_seconds": 1.98,
      "text": "Has there been itching too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.05,
      "end_seconds": 62.8,
      "duration_seconds": 10.75,
      "text": "Yes, I have. As for itching, mild, I'd say. I mean, there's a lump around the back passage as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.53,
      "end_seconds": 66.08,
      "duration_seconds": 2.55,
      "text": "Have you had any tummy pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.09,
      "end_seconds": 70.67,
      "duration_seconds": 2.58,
      "text": "No tummy pain, thankfully."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.8,
      "end_seconds": 79.28,
      "duration_seconds": 7.48,
      "text": "Let me check a few things. Any change in bowel habit, black stools or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.85,
      "end_seconds": 83.64,
      "duration_seconds": 2.79,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.17,
      "end_seconds": 87.16,
      "duration_seconds": 1.99,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.69,
      "end_seconds": 92.74,
      "duration_seconds": 4.05,
      "text": "Yeah, you know, I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.47,
      "end_seconds": 99.03,
      "duration_seconds": 2.56,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.19,
      "end_seconds": 102.03,
      "duration_seconds": 1.84,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.42,
      "end_seconds": 114.31,
      "duration_seconds": 2.89,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.14,
      "end_seconds": 124.29,
      "duration_seconds": 8.15,
      "text": "Mm, uh, my father had bowel cancer. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.13,
      "end_seconds": 130.82,
      "duration_seconds": 4.69,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.85,
      "end_seconds": 138.22,
      "duration_seconds": 5.37,
      "text": "Mm, you know, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.33,
      "end_seconds": 140.21,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.12,
      "end_seconds": 145.06,
      "duration_seconds": 2.94,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.7,
      "end_seconds": 147.36,
      "duration_seconds": 1.66,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.04,
      "end_seconds": 152.35,
      "duration_seconds": 4.31,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.41,
      "end_seconds": 159.56,
      "duration_seconds": 3.15,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 164.48,
      "duration_seconds": 2.93,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 167.78,
      "duration_seconds": 2.34,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.46,
      "end_seconds": 175.23,
      "duration_seconds": 6.77,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.18,
      "end_seconds": 190.13,
      "duration_seconds": 6.95,
      "text": "Right, which medicines do you take at the moment? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.2,
      "end_seconds": 205.14,
      "duration_seconds": 12.94,
      "text": "I take valsartan, 80 milligrams, once a day. Actually, it's aspirin, 75 milligrams, once a day. It's alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.68,
      "end_seconds": 211.0,
      "duration_seconds": 4.32,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.63,
      "end_seconds": 216.97,
      "duration_seconds": 5.34,
      "text": "Yeah, no, it's at home. Amlodipine I don't take anymore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 226.36,
      "duration_seconds": 3.92,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.21,
      "end_seconds": 232.83,
      "duration_seconds": 5.62,
      "text": "Yes, high blood pressure. I've, I've got heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.34,
      "end_seconds": 234.39,
      "duration_seconds": 1.05,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.19,
      "end_seconds": 248.11,
      "duration_seconds": 10.92,
      "text": "Ah, I've had thin bones for two years now. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.8,
      "end_seconds": 259.62,
      "duration_seconds": 10.82,
      "text": "Okay, I can see high blood pressure and heart disease in your file as well. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.48,
      "end_seconds": 266.66,
      "duration_seconds": 5.18,
      "text": "Actually, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.45,
      "end_seconds": 270.86,
      "duration_seconds": 2.41,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.97,
      "end_seconds": 274.88,
      "duration_seconds": 2.91,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.37,
      "end_seconds": 300.48,
      "duration_seconds": 8.11,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.23,
      "end_seconds": 325.51,
      "duration_seconds": 20.28,
      "text": "You can sit up now. Putting it all together, this is probably haemorrhoids. I can't rule out an anal fissure yet. Stop me if I've got anything wrong. You've had bright red blood on the paper, and no black stools or change in bowel habit."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.64,
      "end_seconds": 328.25,
      "duration_seconds": 1.61,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.24,
      "end_seconds": 361.31,
      "duration_seconds": 15.07,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I don't need to add any tests or treatment at this point. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.54,
      "end_seconds": 365.71,
      "duration_seconds": 3.17,
      "text": "Thank you, um, that's helpful."
    }
  ]
}