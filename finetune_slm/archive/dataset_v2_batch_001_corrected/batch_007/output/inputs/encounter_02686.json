{
  "schema_version": "1.0",
  "encounter_id": "02686",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.33,
      "duration_seconds": 3.27,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.29,
      "end_seconds": 10.06,
      "duration_seconds": 3.77,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.48,
      "end_seconds": 18.34,
      "duration_seconds": 4.86,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 22.42,
      "duration_seconds": 3.3,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.91,
      "end_seconds": 28.04,
      "duration_seconds": 4.13,
      "text": "Mainly I've been feeling sick. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.04,
      "end_seconds": 33.75,
      "duration_seconds": 3.71,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.96,
      "end_seconds": 37.89,
      "duration_seconds": 2.93,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.33,
      "end_seconds": 42.38,
      "duration_seconds": 3.05,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.22,
      "end_seconds": 52.92,
      "duration_seconds": 9.7,
      "text": "Mostly mild. There's blood in the urine as well. I've also had not being able to lie still, for six months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.42,
      "end_seconds": 56.58,
      "duration_seconds": 2.16,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.37,
      "end_seconds": 67.9,
      "duration_seconds": 2.53,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.7,
      "end_seconds": 94.48,
      "duration_seconds": 7.78,
      "text": "Okay: BP is 125 over 81, temp 36.6 degrees. And pulse 64, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.57,
      "end_seconds": 100.85,
      "duration_seconds": 4.28,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.47,
      "end_seconds": 103.86,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.11,
      "end_seconds": 124.98,
      "duration_seconds": 6.87,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.42,
      "end_seconds": 130.18,
      "duration_seconds": 2.76,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.56,
      "end_seconds": 147.28,
      "duration_seconds": 5.72,
      "text": "A few quick ones: vomiting, fever, burning when passing urine or passing no urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.09,
      "end_seconds": 154.01,
      "duration_seconds": 5.92,
      "text": "No, no vomiting, fever, burning when passing urine or passing no urine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.24,
      "end_seconds": 159.82,
      "duration_seconds": 1.58,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.0,
      "end_seconds": 163.14,
      "duration_seconds": 2.14,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 169.38,
      "duration_seconds": 4.19,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.28,
      "end_seconds": 175.49,
      "duration_seconds": 5.21,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.78,
      "end_seconds": 179.14,
      "duration_seconds": 2.36,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.25,
      "end_seconds": 185.85,
      "duration_seconds": 5.6,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.82,
      "end_seconds": 190.83,
      "duration_seconds": 3.01,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.69,
      "end_seconds": 202.04,
      "duration_seconds": 10.35,
      "text": "I hardly move around during the day. My husband and I live above the shop. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.44,
      "end_seconds": 206.36,
      "duration_seconds": 2.92,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.83,
      "end_seconds": 212.42,
      "duration_seconds": 4.59,
      "text": "Heart failure, for nearly five years. I have heart disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.48,
      "end_seconds": 221.21,
      "duration_seconds": 6.73,
      "text": "Okay, I can see heart failure and heart disease in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.48,
      "end_seconds": 240.6,
      "duration_seconds": 5.12,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.54,
      "end_seconds": 245.68,
      "duration_seconds": 3.14,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 247.48,
      "end_seconds": 253.64,
      "duration_seconds": 6.16,
      "text": "I'm not sure that's right. I seem to recall a problem with amoxicillin."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.44,
      "end_seconds": 258.66,
      "duration_seconds": 3.22,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.59,
      "end_seconds": 266.14,
      "duration_seconds": 5.55,
      "text": "Okay, I'll note both of those. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.09,
      "end_seconds": 272.68,
      "duration_seconds": 5.59,
      "text": "I'm on metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 274.72,
      "end_seconds": 285.01,
      "duration_seconds": 10.29,
      "text": "Doctor, I think the last prescription for the metoprolol was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.37,
      "end_seconds": 290.18,
      "duration_seconds": 3.81,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.83,
      "end_seconds": 296.56,
      "duration_seconds": 5.73,
      "text": "No, I left it at home. Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.35,
      "end_seconds": 311.52,
      "duration_seconds": 13.17,
      "text": "Putting it all together, I'd lean towards kidney stone colic. I want to be honest that this is an impression, not a final answer. A urine infection is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.3,
      "end_seconds": 314.44,
      "duration_seconds": 2.14,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.09,
      "end_seconds": 324.1,
      "duration_seconds": 8.01,
      "text": "I understand the worry. At the moment I'd say it's kidney stone colic, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.75,
      "end_seconds": 339.68,
      "duration_seconds": 6.93,
      "text": "I'd like you to see the urology clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.26,
      "end_seconds": 344.96,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.3,
      "end_seconds": 354.71,
      "duration_seconds": 8.41,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.35,
      "end_seconds": 359.19,
      "duration_seconds": 2.84,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.12,
      "end_seconds": 362.63,
      "duration_seconds": 2.51,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.29,
      "end_seconds": 366.78,
      "duration_seconds": 3.49,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.58,
      "end_seconds": 369.44,
      "duration_seconds": 1.86,
      "text": "Have a good day."
    }
  ]
}