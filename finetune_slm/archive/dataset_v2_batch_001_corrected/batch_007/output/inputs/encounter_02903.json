{
  "schema_version": "1.0",
  "encounter_id": "02903",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.87,
      "duration_seconds": 3.48,
      "text": "Right, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 11.5,
      "duration_seconds": 5.34,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.05,
      "end_seconds": 19.64,
      "duration_seconds": 4.59,
      "text": "Um, so... swollen glands. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.3,
      "end_seconds": 23.55,
      "duration_seconds": 2.25,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.19,
      "end_seconds": 38.64,
      "duration_seconds": 14.45,
      "text": "Um, probably about a week. Yeah. I looked a few things up online, and that probably didn't help. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.04,
      "end_seconds": 43.88,
      "duration_seconds": 3.84,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.8,
      "end_seconds": 51.34,
      "duration_seconds": 5.54,
      "text": "A seven out of ten, I suppose. There's swollen face as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.01,
      "end_seconds": 56.11,
      "duration_seconds": 4.1,
      "text": "A few quick ones: mouth sores, blisters or breathing difficulty?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.81,
      "end_seconds": 61.77,
      "duration_seconds": 3.96,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.43,
      "end_seconds": 67.13,
      "duration_seconds": 3.7,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.19,
      "end_seconds": 71.21,
      "duration_seconds": 2.02,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.36,
      "end_seconds": 76.41,
      "duration_seconds": 4.05,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.02,
      "end_seconds": 78.77,
      "duration_seconds": 1.75,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.53,
      "end_seconds": 82.1,
      "duration_seconds": 2.57,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.8,
      "end_seconds": 88.13,
      "duration_seconds": 4.33,
      "text": "It's allopurinol, 300 milligrams, started four weeks ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.94,
      "end_seconds": 95.43,
      "duration_seconds": 5.49,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.98,
      "end_seconds": 110.06,
      "duration_seconds": 13.08,
      "text": "I retired from the post office two years ago. Not much, I mostly stay in these days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.57,
      "end_seconds": 132.4,
      "duration_seconds": 3.83,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.49,
      "end_seconds": 136.37,
      "duration_seconds": 2.88,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.15,
      "end_seconds": 140.85,
      "duration_seconds": 2.7,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.27,
      "end_seconds": 156.47,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.36,
      "end_seconds": 174.47,
      "duration_seconds": 8.11,
      "text": "Okay: saturation 98 percent, BP is 112 over 79. And pulse 94, temp 39.0 degrees."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.2,
      "end_seconds": 180.15,
      "duration_seconds": 2.95,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 183.31,
      "duration_seconds": 1.2,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.99,
      "end_seconds": 201.07,
      "duration_seconds": 8.08,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.07,
      "end_seconds": 208.62,
      "duration_seconds": 3.55,
      "text": "Alright, good, you can sit up again."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.79,
      "end_seconds": 227.24,
      "duration_seconds": 11.45,
      "text": "Okay, so my impression is this: I don't have a clear answer today: a severe drug reaction is possible, and so is a viral rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.15,
      "end_seconds": 231.89,
      "duration_seconds": 2.74,
      "text": "So, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.81,
      "end_seconds": 246.01,
      "duration_seconds": 12.2,
      "text": "I understand the worry. At the moment I'd say it's a severe drug reaction, and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.58,
      "end_seconds": 278.8,
      "duration_seconds": 21.22,
      "text": "I want urgent blood tests done, that's for severe drug reaction. I'd rather check than guess, and this is the quickest way to know more. Let's use prednisolone, 40 milligrams, once a day, until review. That's for severe drug reaction. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.75,
      "end_seconds": 283.7,
      "duration_seconds": 2.95,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.09,
      "end_seconds": 288.44,
      "duration_seconds": 3.35,
      "text": "Stop the allopurinol now and you need admission."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.81,
      "end_seconds": 303.57,
      "duration_seconds": 14.76,
      "text": "Right, right. Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me straight away. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.14,
      "end_seconds": 308.35,
      "duration_seconds": 3.21,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.59,
      "end_seconds": 310.85,
      "duration_seconds": 1.26,
      "text": "All the best."
    }
  ]
}