{
  "schema_version": "1.0",
  "encounter_id": "02887",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 3.68,
      "duration_seconds": 2.98,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 10.69,
      "duration_seconds": 5.15,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.72,
      "end_seconds": 14.66,
      "duration_seconds": 2.94,
      "text": "I'm here because of poor concentration."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.52,
      "end_seconds": 19.15,
      "duration_seconds": 3.63,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.14,
      "end_seconds": 24.87,
      "duration_seconds": 4.73,
      "text": "It's iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.37,
      "end_seconds": 29.97,
      "duration_seconds": 4.6,
      "text": "Right, right. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.38,
      "end_seconds": 33.61,
      "duration_seconds": 2.23,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 38.59,
      "duration_seconds": 3.55,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.46,
      "end_seconds": 47.15,
      "duration_seconds": 6.69,
      "text": "Pretty moderate, if I'm being honest. Uh, I've also been waking unrefreshed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.58,
      "end_seconds": 55.95,
      "duration_seconds": 3.37,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.98,
      "end_seconds": 68.07,
      "duration_seconds": 10.09,
      "text": "Mostly mild. I've, I've also had aching all over, for three weeks. As for aching all over, mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.82,
      "end_seconds": 73.96,
      "duration_seconds": 4.14,
      "text": "Have you had any weight loss, joint swelling or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.36,
      "end_seconds": 81.14,
      "duration_seconds": 5.78,
      "text": "I haven't had weight loss, joint swelling or rash, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.77,
      "end_seconds": 85.16,
      "duration_seconds": 2.39,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 88.43,
      "duration_seconds": 2.57,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.98,
      "end_seconds": 90.54,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.11,
      "end_seconds": 93.01,
      "duration_seconds": 1.9,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.59,
      "end_seconds": 98.1,
      "duration_seconds": 4.51,
      "text": "Okay, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.0,
      "end_seconds": 101.7,
      "duration_seconds": 1.7,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.07,
      "end_seconds": 116.58,
      "duration_seconds": 2.51,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.04,
      "end_seconds": 132.22,
      "duration_seconds": 14.18,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. Not much, I mostly stay in these days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.4,
      "end_seconds": 137.78,
      "duration_seconds": 4.38,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.13,
      "end_seconds": 152.26,
      "duration_seconds": 13.13,
      "text": "I have migraines. I've had low haemoglobin for about a year now. My sister suggested writing things down, but I forgot. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.29,
      "end_seconds": 162.56,
      "duration_seconds": 9.27,
      "text": "Mm-hmm. Okay, I can see low haemoglobin in your file as well. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.33,
      "end_seconds": 169.75,
      "duration_seconds": 2.42,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.27,
      "end_seconds": 173.96,
      "duration_seconds": 3.69,
      "text": "So, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.53,
      "end_seconds": 182.37,
      "duration_seconds": 6.84,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.93,
      "end_seconds": 186.72,
      "duration_seconds": 3.79,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.67,
      "end_seconds": 191.48,
      "duration_seconds": 2.81,
      "text": "Mm, I've never had an allergy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.6,
      "end_seconds": 207.57,
      "duration_seconds": 3.97,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.95,
      "end_seconds": 222.35,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.53,
      "end_seconds": 251.64,
      "duration_seconds": 9.11,
      "text": "Okay: pulse is 85 beats a minute, respiratory rate 14, temp 36.4 degrees, BP is 126 over 74."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.8,
      "end_seconds": 254.49,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.29,
      "end_seconds": 259.36,
      "duration_seconds": 3.07,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.32,
      "end_seconds": 265.6,
      "duration_seconds": 3.28,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.91,
      "end_seconds": 268.63,
      "duration_seconds": 1.72,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.06,
      "end_seconds": 288.24,
      "duration_seconds": 6.18,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.23,
      "end_seconds": 296.12,
      "duration_seconds": 1.89,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.28,
      "end_seconds": 318.8,
      "duration_seconds": 7.52,
      "text": "Having listened and examined, I think we're dealing with fibromyalgia at this stage. Polymyalgia is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.67,
      "end_seconds": 323.49,
      "duration_seconds": 2.82,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.73,
      "end_seconds": 338.46,
      "duration_seconds": 13.73,
      "text": "I understand the worry. At the moment I'd say it's fibromyalgia, and we'll know more once the blood tests is back. I'll request blood tests, it'll help with widespread pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 339.21,
      "end_seconds": 341.54,
      "duration_seconds": 2.33,
      "text": "The earliest is Wednesday, 10 am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.19,
      "end_seconds": 345.78,
      "duration_seconds": 2.59,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.46,
      "end_seconds": 363.55,
      "duration_seconds": 16.09,
      "text": "The treatment will be amitriptyline, 10 milligrams, at night, long term. You take it by mouth. It's for pain and sleep. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.04,
      "end_seconds": 367.88,
      "duration_seconds": 2.84,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.25,
      "end_seconds": 387.25,
      "duration_seconds": 18.0,
      "text": "Gentle graded exercise such as swimming helps more than rest. Do get help quickly if the symptoms get worse. Come back in six weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.29,
      "end_seconds": 399.32,
      "duration_seconds": 10.03,
      "text": "So, I take the amitriptyline, 10 milligrams, at night and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.26,
      "end_seconds": 408.51,
      "duration_seconds": 4.25,
      "text": "Yes, exactly right. Okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.16,
      "end_seconds": 411.31,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.22,
      "end_seconds": 413.59,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
}