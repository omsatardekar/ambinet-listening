{
  "schema_version": "1.0",
  "encounter_id": "02820",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 7.64,
      "duration_seconds": 6.62,
      "text": "Hello, come in. Mind the step. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.83,
      "end_seconds": 14.12,
      "duration_seconds": 5.29,
      "text": "Doctor, it's a dry cough. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.94,
      "end_seconds": 16.73,
      "duration_seconds": 1.79,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.5,
      "end_seconds": 24.38,
      "duration_seconds": 5.88,
      "text": "About three months, I think... sorry, six months, I got that wrong."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.81,
      "end_seconds": 34.11,
      "duration_seconds": 9.3,
      "text": "Yes. Alright, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.13,
      "end_seconds": 43.51,
      "duration_seconds": 7.38,
      "text": "A three out of ten, I suppose. It's a few times a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.06,
      "end_seconds": 55.25,
      "duration_seconds": 4.19,
      "text": "Did you get night sweats, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.77,
      "end_seconds": 58.92,
      "duration_seconds": 3.15,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.29,
      "end_seconds": 62.14,
      "duration_seconds": 2.85,
      "text": "Understood. What about coughing up blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.47,
      "end_seconds": 66.01,
      "duration_seconds": 2.54,
      "text": "Definitely no coughing up blood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.05,
      "end_seconds": 70.94,
      "duration_seconds": 2.89,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.19,
      "end_seconds": 74.18,
      "duration_seconds": 1.99,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.79,
      "end_seconds": 78.62,
      "duration_seconds": 3.83,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.37,
      "end_seconds": 83.71,
      "duration_seconds": 4.34,
      "text": "It's thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.74,
      "end_seconds": 99.12,
      "duration_seconds": 3.38,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.93,
      "end_seconds": 112.2,
      "duration_seconds": 11.27,
      "text": "I hardly move around during the day. I live with my elderly mother. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.9,
      "end_seconds": 123.17,
      "duration_seconds": 2.27,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.89,
      "end_seconds": 131.65,
      "duration_seconds": 4.76,
      "text": "I have an underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.43,
      "end_seconds": 143.86,
      "duration_seconds": 11.43,
      "text": "Sure. So, yes, an underactive thyroid is known to us, good to have that clear. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.8,
      "end_seconds": 154.31,
      "duration_seconds": 9.51,
      "text": "Yes, naproxen. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.34,
      "end_seconds": 159.27,
      "duration_seconds": 2.93,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.82,
      "end_seconds": 170.66,
      "duration_seconds": 2.84,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.95,
      "end_seconds": 191.67,
      "duration_seconds": 10.72,
      "text": "Okay: temperature 37.2, respiratory rate 25, pulse is 96 beats a minute, SpO2 89 percent on room air, pressure 138 over 80."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.95,
      "end_seconds": 194.36,
      "duration_seconds": 1.41,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.37,
      "end_seconds": 200.73,
      "duration_seconds": 4.36,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.7,
      "end_seconds": 206.16,
      "duration_seconds": 2.46,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.02,
      "end_seconds": 210.31,
      "duration_seconds": 3.29,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.57,
      "end_seconds": 229.02,
      "duration_seconds": 5.45,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.96,
      "end_seconds": 242.37,
      "duration_seconds": 10.41,
      "text": "Good, you can sit up again. Having listened and examined, the most likely explanation is a pleural effusion needing a cause."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.12,
      "end_seconds": 246.12,
      "duration_seconds": 2.0,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.51,
      "end_seconds": 256.24,
      "duration_seconds": 8.73,
      "text": "I can't promise yet, but most people with a pleural effusion needing a cause do well once it's treated properly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.1,
      "end_seconds": 276.13,
      "duration_seconds": 4.03,
      "text": "I'll request a chest X-ray, it'll help with breathlessness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.3,
      "end_seconds": 279.98,
      "duration_seconds": 2.68,
      "text": "The earliest is Wednesday, 11:30 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.1,
      "end_seconds": 282.09,
      "duration_seconds": 0.99,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.14,
      "end_seconds": 307.37,
      "duration_seconds": 24.23,
      "text": "I'm sending you for a CT scan of the chest because of pleural effusion. I am arranging an urgent chest clinic review. I'd like you to see the chest clinic as well, and I'll write the referral. Come back or go to emergency straight away if the symptoms get worse. Please come and see me after the scan."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.46,
      "end_seconds": 310.16,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.23,
      "end_seconds": 316.26,
      "duration_seconds": 4.03,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.12,
      "end_seconds": 320.51,
      "duration_seconds": 2.39,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}