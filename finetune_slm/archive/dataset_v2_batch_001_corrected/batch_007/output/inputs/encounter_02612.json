      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.7,
      "end_seconds": 53.52,
      "duration_seconds": 2.82,
      "text": "It usually comes with vomiting."
    },
