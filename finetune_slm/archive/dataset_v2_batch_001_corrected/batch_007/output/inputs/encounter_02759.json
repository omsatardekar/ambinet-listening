{
  "schema_version": "1.0",
  "encounter_id": "02759",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 3.98,
      "duration_seconds": 3.16,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 9.53,
      "duration_seconds": 4.05,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.82,
      "end_seconds": 19.49,
      "duration_seconds": 8.67,
      "text": "I've been dealing with a widespread rash with fever. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.5,
      "end_seconds": 24.22,
      "duration_seconds": 2.72,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.73,
      "end_seconds": 28.52,
      "duration_seconds": 2.79,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.0,
      "end_seconds": 33.54,
      "duration_seconds": 3.54,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.05,
      "end_seconds": 42.3,
      "duration_seconds": 8.25,
      "text": "It's, It's severe, honestly. And there's a recent new medicine as well, six months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.58,
      "end_seconds": 46.93,
      "duration_seconds": 3.35,
      "text": "Have you had any mouth sores or blisters?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.0,
      "end_seconds": 52.27,
      "duration_seconds": 4.27,
      "text": "No mouth sores or blisters, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.02,
      "end_seconds": 55.63,
      "duration_seconds": 1.61,
      "text": "Nothing like breathing difficulty?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.21,
      "end_seconds": 59.5,
      "duration_seconds": 2.29,
      "text": "No breathing difficulty, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.19,
      "end_seconds": 65.17,
      "duration_seconds": 3.98,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.94,
      "end_seconds": 68.52,
      "duration_seconds": 2.58,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.53,
      "end_seconds": 71.91,
      "duration_seconds": 2.38,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.43,
      "end_seconds": 80.12,
      "duration_seconds": 3.69,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.13,
      "end_seconds": 99.69,
      "duration_seconds": 4.56,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.75,
      "end_seconds": 104.36,
      "duration_seconds": 2.61,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.4,
      "end_seconds": 116.34,
      "duration_seconds": 2.94,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.02,
      "end_seconds": 140.66,
      "duration_seconds": 22.64,
      "text": "I've had COPD, yes. I'd rather know what's going on than keep guessing. I've had acid reflux for about a year now. Yes, heart disease. I'd rather not end up on lots of tablets if I can avoid it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.55,
      "end_seconds": 144.48,
      "duration_seconds": 1.93,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.82,
      "end_seconds": 152.32,
      "duration_seconds": 2.5,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.39,
      "end_seconds": 158.1,
      "duration_seconds": 3.71,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.41,
      "end_seconds": 162.73,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.49,
      "end_seconds": 168.78,
      "duration_seconds": 4.29,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.13,
      "end_seconds": 172.57,
      "duration_seconds": 2.44,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.71,
      "end_seconds": 177.35,
      "duration_seconds": 3.64,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.36,
      "end_seconds": 182.61,
      "duration_seconds": 3.25,
      "text": "I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.43,
      "end_seconds": 186.23,
      "duration_seconds": 2.8,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.73,
      "end_seconds": 195.21,
      "duration_seconds": 7.48,
      "text": "About about three months. I take lansoprazole, 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.72,
      "end_seconds": 199.09,
      "duration_seconds": 3.37,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 210.44,
      "duration_seconds": 10.67,
      "text": "About about three months. Metoprolol. I take it 50 milligrams, twice a day. Allopurinol. I take it 300 milligrams, started four weeks ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.33,
      "end_seconds": 215.71,
      "duration_seconds": 3.38,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.04,
      "end_seconds": 231.36,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.86,
      "end_seconds": 262.14,
      "duration_seconds": 16.28,
      "text": "Okay: blood pressure 115 over 80, weight 62 kilos, pulse is 104 beats a minute, respiratory rate 19, temperature 38.4, oxygen saturation is 98 percent, BMI works out to 25.5, height 156 centimetres."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.42,
      "end_seconds": 267.61,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.15,
      "end_seconds": 270.89,
      "duration_seconds": 2.74,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.01,
      "end_seconds": 275.29,
      "duration_seconds": 2.28,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.21,
      "end_seconds": 279.59,
      "duration_seconds": 2.38,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.85,
      "end_seconds": 300.47,
      "duration_seconds": 6.62,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.7,
      "end_seconds": 302.4,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.87,
      "end_seconds": 318.44,
      "duration_seconds": 10.57,
      "text": "Good, you can sit up again. Okay, so my impression is this: My working impression is a severe drug reaction. A viral rash is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.39,
      "end_seconds": 356.11,
      "duration_seconds": 25.72,
      "text": "Let's book urgent blood tests to look into severe drug reaction. I'm prescribing prednisolone, 40 milligrams, once a day, until review. You take it by mouth. It's for severe drug reaction. Stop the allopurinol now and you need admission. I'm going to send a referral to the dermatology team. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.91,
      "end_seconds": 359.24,
      "duration_seconds": 2.33,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.54,
      "end_seconds": 368.43,
      "duration_seconds": 7.89,
      "text": "I'd like to see you again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.18,
      "end_seconds": 372.14,
      "duration_seconds": 2.96,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.58,
      "end_seconds": 375.53,
      "duration_seconds": 1.95,
      "text": "Have a good day."
    }
  ]
}