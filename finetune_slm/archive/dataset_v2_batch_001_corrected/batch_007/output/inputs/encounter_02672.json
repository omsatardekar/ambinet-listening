{
  "schema_version": "1.0",
  "encounter_id": "02672",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.61,
      "duration_seconds": 3.89,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.9,
      "end_seconds": 10.83,
      "duration_seconds": 4.93,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.89,
      "end_seconds": 27.6,
      "duration_seconds": 14.71,
      "text": "Yeah, um, it's a severe sore throat on one side. I don't know what's causing it. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.32,
      "end_seconds": 30.55,
      "duration_seconds": 2.23,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.15,
      "end_seconds": 34.28,
      "duration_seconds": 3.13,
      "text": "It's, It's been three days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.93,
      "end_seconds": 44.19,
      "duration_seconds": 9.26,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.98,
      "end_seconds": 57.89,
      "duration_seconds": 12.91,
      "text": "Well, yes, swallowing. That makes it worse. About a seven out of ten. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.28,
      "end_seconds": 65.24,
      "duration_seconds": 1.96,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.97,
      "end_seconds": 70.15,
      "duration_seconds": 4.18,
      "text": "It usually comes with a muffled voice."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.34,
      "end_seconds": 75.06,
      "duration_seconds": 3.72,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.37,
      "end_seconds": 88.05,
      "duration_seconds": 7.68,
      "text": "I, I'd give it a three, out of ten. There's drooling as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.76,
      "end_seconds": 92.55,
      "duration_seconds": 3.79,
      "text": "Have you had any rash, noisy breathing or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.38,
      "end_seconds": 97.18,
      "duration_seconds": 3.8,
      "text": "No, no rash, noisy breathing or cough."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.47,
      "end_seconds": 102.03,
      "duration_seconds": 4.56,
      "text": "Understood. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.0,
      "end_seconds": 105.75,
      "duration_seconds": 1.75,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.5,
      "end_seconds": 109.94,
      "duration_seconds": 2.44,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.93,
      "end_seconds": 115.72,
      "duration_seconds": 3.79,
      "text": "I have high cholesterol, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.49,
      "end_seconds": 125.73,
      "duration_seconds": 8.24,
      "text": "Okay, I can see high cholesterol in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.56,
      "end_seconds": 131.02,
      "duration_seconds": 4.46,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 147.67,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.23,
      "end_seconds": 153.04,
      "duration_seconds": 4.81,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.26,
      "end_seconds": 156.53,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.31,
      "end_seconds": 161.47,
      "duration_seconds": 4.16,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.27,
      "end_seconds": 165.92,
      "duration_seconds": 3.65,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.55,
      "end_seconds": 170.95,
      "duration_seconds": 3.4,
      "text": "Simvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.38,
      "end_seconds": 176.68,
      "duration_seconds": 4.3,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.49,
      "end_seconds": 182.1,
      "duration_seconds": 4.61,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.0,
      "end_seconds": 186.4,
      "duration_seconds": 3.4,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.37,
      "end_seconds": 199.28,
      "duration_seconds": 2.91,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.15,
      "end_seconds": 227.36,
      "duration_seconds": 8.21,
      "text": "Okay: temperature is 39.3 degrees, pulse 96. And respiratory rate 16, BP is 126 over 78."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.07,
      "end_seconds": 229.61,
      "duration_seconds": 1.54,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 232.94,
      "duration_seconds": 2.78,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.57,
      "end_seconds": 238.0,
      "duration_seconds": 2.43,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.99,
      "end_seconds": 240.4,
      "duration_seconds": 1.41,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.24,
      "end_seconds": 265.77,
      "duration_seconds": 8.53,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.25,
      "end_seconds": 279.98,
      "duration_seconds": 2.73,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.86,
      "end_seconds": 298.17,
      "duration_seconds": 13.31,
      "text": "Okay, that's enough for me. So, based on the history and the examination, my working impression is a quinsy, a peritonsillar abscess. We shouldn't forget severe tonsillitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.56,
      "end_seconds": 306.84,
      "duration_seconds": 5.28,
      "text": "Mm, uh, is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.73,
      "end_seconds": 316.11,
      "duration_seconds": 8.38,
      "text": "I can't promise yet, but most people with a quinsy, a peritonsillar abscess do well once it's treated properly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.4,
      "end_seconds": 337.71,
      "duration_seconds": 10.31,
      "text": "I want an urgent ENT drainage done, that's for peritonsillar abscess. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.16,
      "end_seconds": 342.1,
      "duration_seconds": 2.94,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.51,
      "end_seconds": 374.26,
      "duration_seconds": 30.75,
      "text": "We should do blood tests for abscess. I'd like you to take benzylpenicillin, 1.2 grams, now, single dose. That should help with peritonsillar abscess. You need to be seen by ENT today to drain it. I'll also refer you to the ENT team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.43,
      "end_seconds": 376.64,
      "duration_seconds": 1.21,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.43,
      "end_seconds": 387.18,
      "duration_seconds": 9.75,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Come back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.42,
      "end_seconds": 390.14,
      "duration_seconds": 1.72,
      "text": "That's clear, thanks."
    }
  ]
}