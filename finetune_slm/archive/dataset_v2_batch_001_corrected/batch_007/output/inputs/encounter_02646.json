    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.1,
      "end_seconds": 111.33,
      "duration_seconds": 3.23,
      "text": "Okay any past operations I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.19,
      "end_seconds": 118.51,
      "duration_seconds": 5.32,
      "text": "I had a meniscus repair on my knee four years ago"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.17,
      "end_seconds": 123.6,
      "duration_seconds": 4.43,
      "text": "are you taking anything regularly including from the pharmacy?"
    },
