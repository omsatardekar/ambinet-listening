      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.62,
      "end_seconds": 136.23,
      "duration_seconds": 10.61,
      "text": "Foracort inhaler. I take it twice a day for my asthma. It's escitalopram, 10 milligrams, maybe, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.89,
      "end_seconds": 140.79,
      "duration_seconds": 3.9,
      "text": "Have you got the box or the prescription on you?"
