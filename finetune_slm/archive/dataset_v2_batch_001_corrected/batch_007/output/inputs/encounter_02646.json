      "role": "PATIENT",
      "start_seconds": 142.0,
      "end_seconds": 146.47,
      "duration_seconds": 4.47,
      "text": "not with me. I'll bring it it next time"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.71,
      "end_seconds": 152.86,
      "duration_seconds": 5.15,
      "text": "has anything ever caused you a reaction? I mean any allergies"
