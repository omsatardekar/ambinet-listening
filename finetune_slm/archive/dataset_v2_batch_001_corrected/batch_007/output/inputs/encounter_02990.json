{
  "schema_version": "1.0",
  "encounter_id": "02990",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.8,
      "duration_seconds": 4.73,
      "text": "hi, doctor, I came as soon as they called me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 12.04,
      "duration_seconds": 5.34,
      "text": "yes, come in and and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.05,
      "end_seconds": 18.87,
      "duration_seconds": 5.82,
      "text": "so the thing is, I've got a blocked nose for months"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.36,
      "end_seconds": 22.17,
      "duration_seconds": 1.81,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.19,
      "end_seconds": 26.99,
      "duration_seconds": 2.8,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.78,
      "end_seconds": 30.15,
      "duration_seconds": 2.37,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.01,
      "end_seconds": 38.19,
      "duration_seconds": 7.18,
      "text": "About a eight out of ten. There's a dull pressure over my face as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.14,
      "end_seconds": 58.43,
      "duration_seconds": 3.29,
      "text": "Any fever or vision changes at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.97,
      "end_seconds": 62.77,
      "duration_seconds": 2.8,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.27,
      "end_seconds": 70.05,
      "duration_seconds": 6.78,
      "text": "I see, go ahead. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.67,
      "end_seconds": 76.54,
      "duration_seconds": 5.87,
      "text": "Sorry, what was I saying, no, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.36,
      "end_seconds": 80.44,
      "duration_seconds": 2.08,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.15,
      "end_seconds": 84.98,
      "duration_seconds": 2.83,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.26,
      "end_seconds": 88.93,
      "duration_seconds": 2.67,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.47,
      "end_seconds": 93.32,
      "duration_seconds": 2.85,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.35,
      "end_seconds": 96.64,
      "duration_seconds": 2.29,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.83,
      "end_seconds": 104.27,
      "duration_seconds": 6.44,
      "text": "well, just a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.07,
      "end_seconds": 110.72,
      "duration_seconds": 4.65,
      "text": "Right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.68,
      "end_seconds": 115.56,
      "duration_seconds": 2.88,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.06,
      "end_seconds": 119.49,
      "duration_seconds": 2.43,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.34,
      "end_seconds": 123.84,
      "duration_seconds": 3.5,
      "text": "Yes, diclofenac, it gives me wheezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.51,
      "end_seconds": 127.27,
      "duration_seconds": 2.76,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.1,
      "end_seconds": 132.12,
      "duration_seconds": 4.02,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.94,
      "end_seconds": 138.12,
      "duration_seconds": 4.18,
      "text": "what does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.24,
      "end_seconds": 142.61,
      "duration_seconds": 3.37,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.52,
      "end_seconds": 155.9,
      "duration_seconds": 3.38,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.06,
      "end_seconds": 169.43,
      "duration_seconds": 3.37,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.54,
      "end_seconds": 187.0,
      "duration_seconds": 7.46,
      "text": "okay: respiratory rate 17, pulse 79, oxygen saturation is 99 percent, pressure 110 over 70."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.55,
      "end_seconds": 195.09,
      "duration_seconds": 5.54,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.72,
      "end_seconds": 207.68,
      "duration_seconds": 0.96,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.54,
      "end_seconds": 212.18,
      "duration_seconds": 2.64,
      "text": "Hold that for a a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.28,
      "end_seconds": 222.73,
      "duration_seconds": 3.45,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.78,
      "end_seconds": 229.45,
      "duration_seconds": 1.67,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.16,
      "end_seconds": 245.45,
      "duration_seconds": 4.29,
      "text": "Taking everything into account, this is probably nasal polyps."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.53,
      "end_seconds": 249.32,
      "duration_seconds": 2.79,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.16,
      "end_seconds": 262.29,
      "duration_seconds": 12.13,
      "text": "Nothing I've seen today points to an emergency. It looks like nasal polyps, but I'd like to confirm. I want a nasal endoscopy done, that's for nasal obstruction."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.33,
      "end_seconds": 265.34,
      "duration_seconds": 2.01,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.69,
      "end_seconds": 280.5,
      "duration_seconds": 9.81,
      "text": "We'll begin with mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That should help with nasal polyps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.58,
      "end_seconds": 283.11,
      "duration_seconds": 1.53,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.88,
      "end_seconds": 297.47,
      "duration_seconds": 11.59,
      "text": "Rinse with saline and use the spray daily. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.33,
      "end_seconds": 302.77,
      "duration_seconds": 3.44,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.46,
      "end_seconds": 309.6,
      "duration_seconds": 5.14,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.42,
      "end_seconds": 313.52,
      "duration_seconds": 2.1,
      "text": "Thank you, that's helpful."
    }
  ]
}