{
  "schema_version": "1.0",
  "encounter_id": "02531",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.14,
      "end_seconds": 3.33,
      "duration_seconds": 2.19,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.65,
      "end_seconds": 8.11,
      "duration_seconds": 3.46,
      "text": "Um, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.4,
      "end_seconds": 10.83,
      "duration_seconds": 1.43,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 17.13,
      "duration_seconds": 5.24,
      "text": "Well, I've been having a chesty cough for a week."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.8,
      "end_seconds": 22.2,
      "duration_seconds": 3.4,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.95,
      "end_seconds": 29.33,
      "duration_seconds": 5.38,
      "text": "Around three weeks... no wait, it's more like about a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.07,
      "end_seconds": 33.54,
      "duration_seconds": 2.47,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 43.96,
      "duration_seconds": 9.71,
      "text": "It settles a little with honey. Oh, and a sore throat earlier. That's been about the same, about four days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.57,
      "end_seconds": 48.52,
      "duration_seconds": 2.95,
      "text": "Alright, has there been slight aching too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.32,
      "end_seconds": 57.61,
      "duration_seconds": 7.29,
      "text": "Ah, yes, about the same, three weeks. As for slight aching, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.99,
      "end_seconds": 62.7,
      "duration_seconds": 4.71,
      "text": "Mm-hmm. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.86,
      "end_seconds": 70.7,
      "duration_seconds": 2.84,
      "text": "Yeah, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.34,
      "end_seconds": 72.54,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.29,
      "end_seconds": 81.66,
      "duration_seconds": 5.37,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.75,
      "end_seconds": 84.9,
      "duration_seconds": 2.15,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.96,
      "end_seconds": 90.57,
      "duration_seconds": 3.61,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.44,
      "end_seconds": 93.48,
      "duration_seconds": 2.04,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.48,
      "end_seconds": 103.31,
      "duration_seconds": 5.83,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.16,
      "end_seconds": 124.52,
      "duration_seconds": 3.36,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.25,
      "end_seconds": 142.61,
      "duration_seconds": 12.36,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.38,
      "end_seconds": 148.6,
      "duration_seconds": 5.22,
      "text": "What's on your current medicine list? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.39,
      "end_seconds": 155.87,
      "duration_seconds": 5.48,
      "text": "I take carvedilol, 6.25 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.24,
      "end_seconds": 161.47,
      "duration_seconds": 4.23,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 181.18,
      "duration_seconds": 18.48,
      "text": "No, it's at home. I take alendronate, 70 milligrams, once a week for my bones. I do miss it now and then, to be fair. I'm on honey and lemon, at night."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.7,
      "end_seconds": 184.8,
      "duration_seconds": 3.1,
      "text": "Right, right. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.7,
      "end_seconds": 199.68,
      "duration_seconds": 12.98,
      "text": "So, just a wisdom tooth extraction under sedation, five years ago. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.37,
      "end_seconds": 203.75,
      "duration_seconds": 2.38,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.73,
      "end_seconds": 229.3,
      "duration_seconds": 21.57,
      "text": "I've got heart failure. I've never really been one for hospitals. I have an irregular heartbeat, for about a year. I've had thin bones for five years now. My neighbour said I should get it looked at. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.92,
      "end_seconds": 251.14,
      "duration_seconds": 6.22,
      "text": "Let me check a few things. Any coughing up blood, fever, breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.89,
      "end_seconds": 255.91,
      "duration_seconds": 3.02,
      "text": "None of those, uh, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.31,
      "end_seconds": 260.95,
      "duration_seconds": 3.64,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.97,
      "end_seconds": 263.33,
      "duration_seconds": 1.36,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.46,
      "end_seconds": 268.76,
      "duration_seconds": 3.3,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.52,
      "end_seconds": 281.22,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.5,
      "end_seconds": 284.9,
      "duration_seconds": 2.4,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.42,
      "end_seconds": 300.86,
      "duration_seconds": 4.44,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 315.66,
      "duration_seconds": 10.5,
      "text": "Alright, good, you can sit up again. So, based on the history and the examination, this looks most like acute viral bronchitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.83,
      "end_seconds": 318.31,
      "duration_seconds": 1.48,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.0,
      "end_seconds": 338.99,
      "duration_seconds": 18.99,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Just to be sure I understood. You've had a chesty cough for a week for about a week, and no chest pain or breathlessness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.86,
      "end_seconds": 340.56,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.44,
      "end_seconds": 357.19,
      "duration_seconds": 14.75,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.83,
      "end_seconds": 361.21,
      "duration_seconds": 2.38,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.17,
      "end_seconds": 375.01,
      "duration_seconds": 12.84,
      "text": "If you get a fever or breathlessness, or you feel really unwell, please come to the emergency department. Let's plan a check if not better in three weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.27,
      "end_seconds": 378.95,
      "duration_seconds": 2.68,
      "text": "Yeah, I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.42,
      "end_seconds": 386.39,
      "duration_seconds": 5.97,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 388.22,
      "end_seconds": 394.97,
      "duration_seconds": 6.75,
      "text": "So, I come back if not better in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.96,
      "end_seconds": 401.5,
      "duration_seconds": 5.54,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.04,
      "end_seconds": 406.21,
      "duration_seconds": 3.17,
      "text": "I think I understand everything. Thanks."
    }
  ]
}