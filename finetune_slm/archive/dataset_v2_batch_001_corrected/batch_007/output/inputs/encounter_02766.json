  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.74,
      "end_seconds": 2.47,
      "duration_seconds": 1.73,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.09,
      "end_seconds": 10.26,
      "duration_seconds": 6.17,
      "text": "mm, doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.9,
      "end_seconds": 16.98,
      "duration_seconds": 5.08,
      "text": "Right, absolutely, come and sit beside them. What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.66,
      "end_seconds": 23.7,
      "duration_seconds": 5.04,
      "text": "Yeah, it's a rolled ankle. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.8,
      "end_seconds": 29.15,
      "duration_seconds": 4.35,
      "text": "Can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.68,
      "end_seconds": 43.16,
      "duration_seconds": 13.48,
      "text": "honestly I can't say exactly when it started it might have been last month or the month before, I really can't pin it down"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.53,
      "end_seconds": 48.0,
      "duration_seconds": 3.47,
      "text": "okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.01,
      "end_seconds": 56.66,
      "duration_seconds": 6.65,
      "text": "Some swelling goes along with it, um, most of the time"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.08,
      "end_seconds": 63.55,
      "duration_seconds": 6.47,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.65,
      "end_seconds": 69.59,
      "duration_seconds": 5.94,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.21,
      "end_seconds": 73.69,
      "duration_seconds": 2.48,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 81.5,
      "duration_seconds": 6.24,
      "text": "Have you had a rolled ankle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.14,
      "end_seconds": 91.08,
      "duration_seconds": 8.94,
      "text": "Right, yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.39,
      "end_seconds": 96.74,
      "duration_seconds": 4.35,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.15,
      "end_seconds": 101.63,
      "duration_seconds": 3.48,
      "text": "So, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 103.57,
      "end_seconds": 110.89,
      "duration_seconds": 7.32,
      "text": "hold on, doctor, I think he reacted to erythromycin once i'm not certain, though"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.65,
      "end_seconds": 116.11,
      "duration_seconds": 3.46,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.94,
      "end_seconds": 126.6,
      "duration_seconds": 9.66,
      "text": "alright, so that's unclear i'll record what each of you said what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.68,
      "end_seconds": 129.82,
      "duration_seconds": 1.14,
      "text": "yes, COPD"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.72,
      "end_seconds": 132.42,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.33,
      "end_seconds": 144.45,
      "duration_seconds": 10.12,
      "text": "I have an underactive thyroid, for five years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.82,
      "end_seconds": 149.02,
      "duration_seconds": 3.2,
      "text": "sure. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.4,
      "end_seconds": 156.53,
      "duration_seconds": 6.13,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.96,
      "end_seconds": 174.42,
      "duration_seconds": 2.46,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 175.81,
      "end_seconds": 185.3,
      "duration_seconds": 9.49,
      "text": "Mm, you know, he takes thyroxine, 75 micrograms, every morning. It's ibuprofen gel, three times a day, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.65,
      "end_seconds": 187.0,
      "duration_seconds": 1.35,
      "text": "yes, carry on"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.69,
      "end_seconds": 194.61,
      "duration_seconds": 5.92,
      "text": "Uh, before this I was on Tiotropium inhaler; that's been stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.11,
      "end_seconds": 197.32,
      "duration_seconds": 1.21,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.59,
      "end_seconds": 204.34,
      "duration_seconds": 2.75,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.89,
      "end_seconds": 208.35,
      "duration_seconds": 2.46,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.86,
      "end_seconds": 211.11,
      "duration_seconds": 2.25,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.7,
      "end_seconds": 215.52,
      "duration_seconds": 2.82,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.39,
      "end_seconds": 221.36,
      "duration_seconds": 3.97,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.55,
      "end_seconds": 228.17,
      "duration_seconds": 5.62,
      "text": "Any pain in the shin or pain in the foot at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.13,
      "end_seconds": 243.29,
      "duration_seconds": 14.16,
      "text": "No, no pain in the shin, no pain in the foot. I did have bruising at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.02,
      "end_seconds": 246.42,
      "duration_seconds": 2.4,
      "text": "Did you get pop or numbness?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.18,
      "end_seconds": 251.31,
      "duration_seconds": 3.13,
      "text": "Yeah, no, not a single one."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 255.51,
      "duration_seconds": 3.42,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 257.52,
      "end_seconds": 261.23,
      "duration_seconds": 3.71,
      "text": "Actually, you know, no weakness or anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.02,
      "end_seconds": 264.49,
      "duration_seconds": 2.47,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.16,
      "end_seconds": 279.61,
      "duration_seconds": 2.45,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.07,
      "end_seconds": 315.23,
      "duration_seconds": 25.16,
      "text": "okay: BP is 121 over 71, SpO2 99 percent on room air, temperature is 36.9 degrees, respiratory rate 14, BMI works out to 28.1, pulse 85, weight 64 kilos, height 151 centimetres let me tell you where I've got to i think we're dealing with a mild ankle sprain at this stage"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.93,
      "end_seconds": 336.65,
      "duration_seconds": 11.72,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. I'd like you back if not better in two weeks. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.68,
      "end_seconds": 340.95,
      "duration_seconds": 3.27,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.15,
      "end_seconds": 343.56,
      "duration_seconds": 1.41,
      "text": "See you soon."
    }
  ]
}