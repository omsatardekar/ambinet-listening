{
  "schema_version": "1.0",
  "encounter_id": "02560",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 3.72,
      "duration_seconds": 3.03,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.47,
      "end_seconds": 7.96,
      "duration_seconds": 3.49,
      "text": "Uh, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.13,
      "end_seconds": 11.49,
      "duration_seconds": 2.36,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.53,
      "end_seconds": 16.38,
      "duration_seconds": 3.85,
      "text": "I'm here because of difficulty opening my mouth."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.62,
      "end_seconds": 20.26,
      "duration_seconds": 2.64,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.37,
      "end_seconds": 35.24,
      "duration_seconds": 2.87,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.41,
      "end_seconds": 57.18,
      "duration_seconds": 7.77,
      "text": "okay: blood pressure 109 over 71, pulse is 105 beats a minute, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.25,
      "end_seconds": 59.88,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.59,
      "end_seconds": 68.52,
      "duration_seconds": 7.93,
      "text": "Don't worry, we'll discuss it in a second. So, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 73.74,
      "duration_seconds": 3.49,
      "text": "Yesterday, it came on out of nowhere"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.74,
      "end_seconds": 77.67,
      "duration_seconds": 2.93,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.16,
      "end_seconds": 81.68,
      "duration_seconds": 2.52,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.76,
      "end_seconds": 84.73,
      "duration_seconds": 1.97,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.29,
      "end_seconds": 91.63,
      "duration_seconds": 5.34,
      "text": "It usually comes with a severe sore throat on one side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.15,
      "end_seconds": 97.42,
      "duration_seconds": 4.27,
      "text": "a few quick ones: rash, cough or noisy breathing?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.48,
      "end_seconds": 103.03,
      "duration_seconds": 3.55,
      "text": "No, no rash, cough or noisy breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.37,
      "end_seconds": 107.72,
      "duration_seconds": 3.35,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.48,
      "end_seconds": 112.65,
      "duration_seconds": 4.17,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.02,
      "end_seconds": 117.19,
      "duration_seconds": 3.17,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.98,
      "end_seconds": 119.93,
      "duration_seconds": 1.95,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.89,
      "end_seconds": 135.95,
      "duration_seconds": 2.06,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.64,
      "end_seconds": 141.36,
      "duration_seconds": 4.72,
      "text": "I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.15,
      "end_seconds": 145.65,
      "duration_seconds": 2.5,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.53,
      "end_seconds": 148.44,
      "duration_seconds": 1.91,
      "text": "I've had anxiety, yes"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.6,
      "end_seconds": 160.42,
      "duration_seconds": 1.82,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.4,
      "end_seconds": 165.37,
      "duration_seconds": 3.97,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.94,
      "end_seconds": 167.33,
      "duration_seconds": 1.39,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.2,
      "end_seconds": 173.86,
      "duration_seconds": 4.66,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.58,
      "end_seconds": 178.64,
      "duration_seconds": 2.06,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.31,
      "end_seconds": 188.51,
      "duration_seconds": 4.2,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.1,
      "end_seconds": 191.73,
      "duration_seconds": 2.63,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.68,
      "end_seconds": 195.96,
      "duration_seconds": 3.28,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.92,
      "end_seconds": 202.1,
      "duration_seconds": 4.18,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.42,
      "end_seconds": 206.14,
      "duration_seconds": 2.72,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.88,
      "end_seconds": 223.85,
      "duration_seconds": 6.97,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.1,
      "end_seconds": 228.8,
      "duration_seconds": 2.7,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.65,
      "end_seconds": 265.66,
      "duration_seconds": 27.01,
      "text": "Taking everything into account, it points towards a quinsy, a peritonsillar abscess. I'll request blood tests, it'll help with abscess. I'd rather check than guess, and this is the quickest way to know more. I'm going to order an urgent ENT drainage, for peritonsillar abscess. I'm prescribing benzylpenicillin, 1.2 grams, now, single dose. That's for peritonsillar abscess."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.67,
      "end_seconds": 269.36,
      "duration_seconds": 2.69,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.62,
      "end_seconds": 275.82,
      "duration_seconds": 5.2,
      "text": "You need to be seen by ENT today to drain it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.24,
      "end_seconds": 300.67,
      "duration_seconds": 24.43,
      "text": "Understood. Cut down on salt and fried food for now, it really does make a difference. Let's get you seen by the ENT team, I'll arrange the letter. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.26,
      "end_seconds": 305.25,
      "duration_seconds": 2.99,
      "text": "no, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.35,
      "end_seconds": 308.59,
      "duration_seconds": 1.24,
      "text": "see you soon"
    }
  ]
}