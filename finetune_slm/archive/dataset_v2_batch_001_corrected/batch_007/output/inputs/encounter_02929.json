{
  "schema_version": "1.0",
  "encounter_id": "02929",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.76,
      "duration_seconds": 4.17,
      "text": "Well, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.42,
      "end_seconds": 9.79,
      "duration_seconds": 4.37,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.73,
      "end_seconds": 18.01,
      "duration_seconds": 6.28,
      "text": "Ah, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.52,
      "end_seconds": 23.22,
      "duration_seconds": 3.7,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.29,
      "end_seconds": 33.42,
      "duration_seconds": 5.13,
      "text": "Um, so... a muffled voice. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.82,
      "end_seconds": 38.1,
      "duration_seconds": 3.28,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.51,
      "end_seconds": 41.28,
      "duration_seconds": 1.77,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.82,
      "end_seconds": 46.05,
      "duration_seconds": 3.23,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.57,
      "end_seconds": 50.78,
      "duration_seconds": 4.21,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.72,
      "end_seconds": 63.35,
      "duration_seconds": 11.63,
      "text": "Sorry, what was I saying, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 63.45,
      "end_seconds": 68.81,
      "duration_seconds": 5.36,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.34,
      "end_seconds": 73.89,
      "duration_seconds": 3.55,
      "text": "Oh, I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.77,
      "end_seconds": 83.14,
      "duration_seconds": 7.37,
      "text": "Okay, that's fine, one at a time. I'll ask about everything. Has there been drooling too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.96,
      "end_seconds": 103.96,
      "duration_seconds": 17.0,
      "text": "Oh, yes, for about three months. Right, I've also had difficulty opening my mouth, since last weekend. And there's a severe sore throat on one side as well, ten days now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.63,
      "end_seconds": 108.5,
      "duration_seconds": 3.87,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.81,
      "end_seconds": 112.21,
      "duration_seconds": 2.4,
      "text": "It's, It's severe, honestly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.31,
      "end_seconds": 120.82,
      "duration_seconds": 6.51,
      "text": "Have you had a muffled voice before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.26,
      "end_seconds": 129.21,
      "duration_seconds": 6.95,
      "text": "Ah, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.53,
      "end_seconds": 151.24,
      "duration_seconds": 4.71,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.34,
      "end_seconds": 161.16,
      "duration_seconds": 7.82,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 164.86,
      "duration_seconds": 2.85,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.67,
      "end_seconds": 184.91,
      "duration_seconds": 18.24,
      "text": "For the gout, I believe. My daughter sets them out for me, I just take what I'm given. Uh, it's aspirin, 75 milligrams, once a day. Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.6,
      "end_seconds": 202.94,
      "duration_seconds": 12.34,
      "text": "Okay, um, so doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.88,
      "end_seconds": 208.27,
      "duration_seconds": 4.39,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.0,
      "end_seconds": 212.99,
      "duration_seconds": 3.99,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.7,
      "end_seconds": 216.18,
      "duration_seconds": 1.48,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.11,
      "end_seconds": 220.6,
      "duration_seconds": 3.49,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 225.03,
      "duration_seconds": 2.52,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.67,
      "end_seconds": 233.13,
      "duration_seconds": 7.46,
      "text": "Sorry, um, what was I saying, yes, trimethoprim, it gives me itching."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.5,
      "end_seconds": 238.42,
      "duration_seconds": 3.92,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.43,
      "end_seconds": 246.66,
      "duration_seconds": 7.23,
      "text": "Uh, my father has Parkinson's disease. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.5,
      "end_seconds": 251.45,
      "duration_seconds": 2.95,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.33,
      "end_seconds": 257.03,
      "duration_seconds": 4.7,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.47,
      "end_seconds": 266.23,
      "duration_seconds": 4.76,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.3,
      "end_seconds": 269.87,
      "duration_seconds": 2.57,
      "text": "High cholesterol, for two years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.6,
      "end_seconds": 273.02,
      "duration_seconds": 1.42,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.4,
      "end_seconds": 294.06,
      "duration_seconds": 19.66,
      "text": "Yes, gout. Work has been very busy so I kept ignoring it. I have heart disease. I have anxiety, for about ten years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.89,
      "end_seconds": 306.7,
      "duration_seconds": 10.81,
      "text": "Right, right. Right, so gout and heart disease are already on your record. We'll keep that in mind today. Did you get noisy breathing or cough?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.27,
      "end_seconds": 311.33,
      "duration_seconds": 4.06,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.14,
      "end_seconds": 315.24,
      "duration_seconds": 2.1,
      "text": "Did you notice any rash?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.94,
      "end_seconds": 317.72,
      "duration_seconds": 1.78,
      "text": "No rash, thankfully."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 319.38,
      "end_seconds": 325.63,
      "duration_seconds": 6.25,
      "text": "Actually, you know, doctor, I did notice rash. He doesn't always say."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.74,
      "end_seconds": 338.05,
      "duration_seconds": 8.31,
      "text": "Right, um, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.47,
      "end_seconds": 346.81,
      "duration_seconds": 7.34,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.62,
      "end_seconds": 350.7,
      "duration_seconds": 2.08,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 353.66,
      "end_seconds": 362.84,
      "duration_seconds": 9.18,
      "text": "Okay, so the vitals from earlier. Pulse is 100 beats a minute, blood pressure 124 over 68, saturation 97 percent. Temperature 38.4."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.32,
      "end_seconds": 365.73,
      "duration_seconds": 1.41,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.96,
      "end_seconds": 369.77,
      "duration_seconds": 2.81,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.58,
      "end_seconds": 373.92,
      "duration_seconds": 2.34,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.05,
      "end_seconds": 391.64,
      "duration_seconds": 7.59,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.91,
      "end_seconds": 398.62,
      "duration_seconds": 2.71,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.75,
      "end_seconds": 433.79,
      "duration_seconds": 18.04,
      "text": "Let me tell you where I've got to. The most likely explanation is a quinsy, a peritonsillar abscess. I'd also keep severe tonsillitis in mind. Let me just check I've got this right. You've had a muffled voice, yesterday, and no cough."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.29,
      "end_seconds": 435.99,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.71,
      "end_seconds": 446.99,
      "duration_seconds": 9.28,
      "text": "I'd like to arrange an urgent ENT drainage for peritonsillar abscess. Let's book blood tests to look into abscess."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.77,
      "end_seconds": 454.07,
      "duration_seconds": 6.3,
      "text": "Sorry, what was I saying, where would I go for that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.29,
      "end_seconds": 463.05,
      "duration_seconds": 7.76,
      "text": "I'm going to put you on benzylpenicillin, 1.2 grams, now, single dose. That's for peritonsillar abscess."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 465.02,
      "end_seconds": 469.47,
      "duration_seconds": 4.45,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 470.93,
      "end_seconds": 486.45,
      "duration_seconds": 15.52,
      "text": "You need to be seen by ENT today to drain it. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 487.76,
      "end_seconds": 491.31,
      "duration_seconds": 3.55,
      "text": "I mean, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 492.11,
      "end_seconds": 493.49,
      "duration_seconds": 1.38,
      "text": "Goodbye for now."
    }
  ]
}