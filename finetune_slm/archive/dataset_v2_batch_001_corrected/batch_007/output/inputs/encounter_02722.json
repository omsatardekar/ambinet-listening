{
  "schema_version": "1.0",
  "encounter_id": "02722",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 3.72,
      "duration_seconds": 2.81,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 9.82,
      "duration_seconds": 4.46,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.84,
      "end_seconds": 18.36,
      "duration_seconds": 7.52,
      "text": "Hmm, um, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.51,
      "end_seconds": 22.45,
      "duration_seconds": 2.94,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.99,
      "end_seconds": 29.41,
      "duration_seconds": 5.42,
      "text": "She's been having a growing red ring on my thigh, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.4,
      "end_seconds": 33.65,
      "duration_seconds": 3.25,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.44,
      "end_seconds": 42.99,
      "duration_seconds": 8.55,
      "text": "I've had it since last night. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.07,
      "end_seconds": 46.08,
      "duration_seconds": 2.01,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.66,
      "end_seconds": 61.23,
      "duration_seconds": 14.57,
      "text": "When it starts I tend to get a mild headache as well. I've had tiredness too, um, for four weeks. Ah, the mild headache? That's been since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.21,
      "end_seconds": 66.9,
      "duration_seconds": 3.69,
      "text": "Right, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.45,
      "end_seconds": 70.08,
      "duration_seconds": 1.63,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.64,
      "end_seconds": 79.22,
      "duration_seconds": 8.58,
      "text": "So, have you had a growing red ring on your thigh before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.07,
      "end_seconds": 89.13,
      "duration_seconds": 5.06,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.03,
      "end_seconds": 94.42,
      "duration_seconds": 4.39,
      "text": "Let me check a few things. Any joint swelling or palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.44,
      "end_seconds": 101.43,
      "duration_seconds": 3.99,
      "text": "I haven't had joint swelling or palpitations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.23,
      "end_seconds": 105.71,
      "duration_seconds": 3.48,
      "text": "Have you noticed facial weakness or stiff neck?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.33,
      "end_seconds": 110.84,
      "duration_seconds": 4.51,
      "text": "No, uh, no facial weakness or stiff neck."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.98,
      "end_seconds": 114.31,
      "duration_seconds": 2.33,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.01,
      "end_seconds": 119.85,
      "duration_seconds": 3.84,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.61,
      "end_seconds": 123.98,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.98,
      "end_seconds": 129.31,
      "duration_seconds": 3.33,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.68,
      "end_seconds": 144.12,
      "duration_seconds": 4.44,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.38,
      "end_seconds": 150.81,
      "duration_seconds": 2.43,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.78,
      "end_seconds": 156.34,
      "duration_seconds": 3.56,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.21,
      "end_seconds": 162.38,
      "duration_seconds": 4.17,
      "text": "No, you know, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.24,
      "end_seconds": 166.5,
      "duration_seconds": 2.26,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 174.29,
      "duration_seconds": 6.5,
      "text": "Uh, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.61,
      "end_seconds": 185.86,
      "duration_seconds": 2.25,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.51,
      "end_seconds": 189.81,
      "duration_seconds": 3.3,
      "text": "Metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 191.58,
      "end_seconds": 200.05,
      "duration_seconds": 8.47,
      "text": "Doctor, I think the last prescription for the metformin was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.53,
      "end_seconds": 205.68,
      "duration_seconds": 4.15,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.57,
      "end_seconds": 215.02,
      "duration_seconds": 7.45,
      "text": "I don't think I have it with me. Aspirin. I take it once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.09,
      "end_seconds": 218.54,
      "duration_seconds": 2.45,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.45,
      "end_seconds": 242.14,
      "duration_seconds": 21.69,
      "text": "It's 75 milligrams. I'm on bisoprolol, 2.5 milligrams, once a day for the heart rhythm. I kept putting it off, which I know isn't sensible. I've never really been one for hospitals. Let me think, I'm on furosemide, 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.78,
      "end_seconds": 247.81,
      "duration_seconds": 4.03,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.8,
      "end_seconds": 251.05,
      "duration_seconds": 1.25,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.84,
      "end_seconds": 253.8,
      "duration_seconds": 1.96,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.31,
      "end_seconds": 260.51,
      "duration_seconds": 6.2,
      "text": "I've had heart disease for two years now. I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.77,
      "end_seconds": 263.2,
      "duration_seconds": 1.43,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.2,
      "end_seconds": 272.06,
      "duration_seconds": 6.86,
      "text": "Heart failure, for about ten years. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.49,
      "end_seconds": 280.8,
      "duration_seconds": 7.31,
      "text": "Okay, I can see diabetes and heart failure in your file as well. How active are you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.76,
      "end_seconds": 284.89,
      "duration_seconds": 3.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.5,
      "end_seconds": 289.55,
      "duration_seconds": 4.05,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.22,
      "end_seconds": 292.95,
      "duration_seconds": 2.73,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.46,
      "end_seconds": 296.25,
      "duration_seconds": 2.79,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.48,
      "end_seconds": 311.79,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.27,
      "end_seconds": 329.49,
      "duration_seconds": 7.22,
      "text": "Okay: pressure 122 over 73, temperature 36.8, respiratory rate 15, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.22,
      "end_seconds": 332.56,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.61,
      "end_seconds": 338.29,
      "duration_seconds": 3.68,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.45,
      "end_seconds": 341.45,
      "duration_seconds": 2.0,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.77,
      "end_seconds": 355.71,
      "duration_seconds": 0.94,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.95,
      "end_seconds": 359.5,
      "duration_seconds": 2.55,
      "text": "So, tell me if that's sore."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.02,
      "end_seconds": 374.78,
      "duration_seconds": 6.76,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.15,
      "end_seconds": 386.19,
      "duration_seconds": 8.04,
      "text": "Please sit back down. Taking everything into account, this is probably early Lyme disease. Another possibility is cellulitis."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.22,
      "end_seconds": 389.6,
      "duration_seconds": 1.38,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.77,
      "end_seconds": 418.84,
      "duration_seconds": 28.07,
      "text": "Nothing I've seen today points to an emergency. It looks like early Lyme disease. For this, doxycycline, 100 milligrams, twice a day, twenty-one days. It's for early Lyme disease. Take the doxycycline with food and avoid strong sun. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.92,
      "end_seconds": 423.49,
      "duration_seconds": 2.57,
      "text": "Actually, that's fine by me."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.53,
      "end_seconds": 439.09,
      "duration_seconds": 13.56,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. I'll want another look in three weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.6,
      "end_seconds": 444.92,
      "duration_seconds": 4.32,
      "text": "I mean, um, thank you, doctor, goodbye."
    }
  ]
}