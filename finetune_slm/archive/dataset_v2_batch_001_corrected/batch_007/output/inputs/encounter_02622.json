{
  "schema_version": "1.0",
  "encounter_id": "02622",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.45,
      "duration_seconds": 4.77,
      "text": "Right, you know, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 13.72,
      "duration_seconds": 5.39,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.77,
      "end_seconds": 20.54,
      "duration_seconds": 3.77,
      "text": "Well, I've been having a rolled ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 24.37,
      "duration_seconds": 2.88,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.35,
      "end_seconds": 32.1,
      "duration_seconds": 5.75,
      "text": "Mm, you know, I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.66,
      "end_seconds": 35.24,
      "duration_seconds": 2.58,
      "text": "Sure. Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.15,
      "end_seconds": 45.21,
      "duration_seconds": 9.06,
      "text": "It's worse with walking. Let me think, I've also had some swelling. I mean, there's bruising as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.66,
      "end_seconds": 51.75,
      "duration_seconds": 5.09,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.21,
      "end_seconds": 61.02,
      "duration_seconds": 4.81,
      "text": "Iron tablets. I take it once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.16,
      "end_seconds": 65.64,
      "duration_seconds": 3.48,
      "text": "Okay, how long have you taken that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 73.68,
      "duration_seconds": 7.25,
      "text": "For two years. Okay, so I'm on spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.36,
      "end_seconds": 77.04,
      "duration_seconds": 2.68,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.54,
      "end_seconds": 79.68,
      "duration_seconds": 2.14,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.22,
      "end_seconds": 80.92,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.23,
      "end_seconds": 86.26,
      "duration_seconds": 4.03,
      "text": "I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.94,
      "end_seconds": 90.28,
      "duration_seconds": 3.34,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.45,
      "end_seconds": 97.72,
      "duration_seconds": 2.27,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.18,
      "end_seconds": 110.36,
      "duration_seconds": 5.18,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.37,
      "end_seconds": 124.44,
      "duration_seconds": 13.07,
      "text": "No, I share a house with my brother. I look after my grandchildren most days. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.36,
      "end_seconds": 129.48,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.94,
      "end_seconds": 137.64,
      "duration_seconds": 6.7,
      "text": "I've had low haemoglobin, yes. Right, uh, I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.04,
      "end_seconds": 140.39,
      "duration_seconds": 1.35,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.45,
      "end_seconds": 154.21,
      "duration_seconds": 12.76,
      "text": "Right, so low haemoglobin and heart failure are already on your record. We'll keep that in mind today. So, have you had any pain in the shin?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.97,
      "end_seconds": 158.43,
      "duration_seconds": 3.46,
      "text": "No. No pain in the shin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.86,
      "end_seconds": 165.12,
      "duration_seconds": 5.26,
      "text": "Right, and what about pop, numbness or pain in the foot?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.66,
      "end_seconds": 169.54,
      "duration_seconds": 2.88,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.56,
      "end_seconds": 172.91,
      "duration_seconds": 1.35,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.83,
      "end_seconds": 182.65,
      "duration_seconds": 5.82,
      "text": "Sorry, what was I saying, no, that's all normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.73,
      "end_seconds": 187.27,
      "duration_seconds": 2.54,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.52,
      "end_seconds": 196.97,
      "duration_seconds": 2.45,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.96,
      "end_seconds": 222.75,
      "duration_seconds": 11.79,
      "text": "Okay: blood pressure 125 over 69, respiratory rate 14, heart rate 69, height 159 centimetres, temp 37.0 degrees, weight 83 kilos, BMI works out to 32.8."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.46,
      "end_seconds": 228.48,
      "duration_seconds": 4.02,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.05,
      "end_seconds": 234.8,
      "duration_seconds": 1.75,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.09,
      "end_seconds": 237.45,
      "duration_seconds": 1.36,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.63,
      "end_seconds": 259.55,
      "duration_seconds": 7.92,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.09,
      "end_seconds": 267.0,
      "duration_seconds": 2.91,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.84,
      "end_seconds": 297.16,
      "duration_seconds": 22.32,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. A short walk every day, even twenty minutes, will help more than you'd think. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Book a review if not better in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.16,
      "end_seconds": 303.97,
      "duration_seconds": 4.81,
      "text": "Okay, so good, thanks, I'll see you then."
    }
  ]
}