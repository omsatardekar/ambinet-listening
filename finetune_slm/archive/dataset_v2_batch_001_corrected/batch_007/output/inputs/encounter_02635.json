{
  "schema_version": "1.0",
  "encounter_id": "02635",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 5.19,
      "duration_seconds": 4.62,
      "text": "hello? Doctor? I was told to to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.1,
      "end_seconds": 9.83,
      "duration_seconds": 3.73,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.91,
      "end_seconds": 17.85,
      "duration_seconds": 6.94,
      "text": "honestly, it's being very confused, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.32,
      "end_seconds": 22.06,
      "duration_seconds": 2.74,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.09,
      "end_seconds": 26.53,
      "duration_seconds": 3.44,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.6,
      "end_seconds": 30.59,
      "duration_seconds": 2.99,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.07,
      "end_seconds": 35.22,
      "duration_seconds": 3.15,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.0,
      "end_seconds": 38.0,
      "duration_seconds": 2.0,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.96,
      "end_seconds": 53.47,
      "duration_seconds": 14.51,
      "text": "Bone pain goes along with it, most of the time. The Bone pain? That's been for about a week. With Bone pain, I'd say severe. It happens all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.35,
      "end_seconds": 58.66,
      "duration_seconds": 4.31,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.26,
      "end_seconds": 74.83,
      "duration_seconds": 2.57,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.12,
      "end_seconds": 95.69,
      "duration_seconds": 8.57,
      "text": "Okay: blood pressure 94 over 57, temperature is 36.5 degrees, saturation 96 percent, pulse is 107 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.56,
      "end_seconds": 101.92,
      "duration_seconds": 4.36,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.36,
      "end_seconds": 105.53,
      "duration_seconds": 2.17,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.27,
      "end_seconds": 127.58,
      "duration_seconds": 5.31,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.2,
      "end_seconds": 132.83,
      "duration_seconds": 1.63,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.92,
      "end_seconds": 145.76,
      "duration_seconds": 3.84,
      "text": "Right, any fever, fall or chest pain at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.48,
      "end_seconds": 149.96,
      "duration_seconds": 2.48,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.82,
      "end_seconds": 153.53,
      "duration_seconds": 2.71,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.47,
      "end_seconds": 156.65,
      "duration_seconds": 2.18,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.28,
      "end_seconds": 161.02,
      "duration_seconds": 2.74,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.28,
      "end_seconds": 166.3,
      "duration_seconds": 4.02,
      "text": "Yes, naproxen, it gives me stomach pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.6,
      "end_seconds": 179.84,
      "duration_seconds": 1.24,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.31,
      "end_seconds": 187.65,
      "duration_seconds": 3.34,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.34,
      "end_seconds": 191.22,
      "duration_seconds": 1.88,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.83,
      "end_seconds": 194.56,
      "duration_seconds": 2.73,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.18,
      "end_seconds": 197.46,
      "duration_seconds": 2.28,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.98,
      "end_seconds": 200.56,
      "duration_seconds": 2.58,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.48,
      "end_seconds": 223.32,
      "duration_seconds": 3.84,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.04,
      "end_seconds": 226.21,
      "duration_seconds": 2.17,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.06,
      "end_seconds": 231.05,
      "duration_seconds": 3.99,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.17,
      "end_seconds": 234.34,
      "duration_seconds": 2.17,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.82,
      "end_seconds": 238.17,
      "duration_seconds": 2.35,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.73,
      "end_seconds": 239.92,
      "duration_seconds": 1.19,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.3,
      "end_seconds": 252.4,
      "duration_seconds": 5.1,
      "text": "having listened and examined, this looks most like a high calcium emergency"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.47,
      "end_seconds": 258.13,
      "duration_seconds": 3.66,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.76,
      "end_seconds": 283.09,
      "duration_seconds": 23.33,
      "text": "Nothing I've seen today points to an emergency. It looks like a high calcium emergency, but I'd like to confirm. I'll request an ECG, it'll help with hypercalcaemia. Let's use sodium chloride 0.9%, 1 litre, over one hour, single dose. It's for dehydration. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.13,
      "end_seconds": 286.74,
      "duration_seconds": 1.61,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.04,
      "end_seconds": 294.42,
      "duration_seconds": 6.38,
      "text": "you need hospital fluids and treatment now. I'll also refer you to the emergency team"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.28,
      "end_seconds": 295.98,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 302.55,
      "duration_seconds": 5.38,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.54,
      "end_seconds": 305.3,
      "duration_seconds": 1.76,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.62,
      "end_seconds": 311.71,
      "duration_seconds": 5.09,
      "text": "come back straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.49,
      "end_seconds": 316.46,
      "duration_seconds": 3.97,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.26,
      "end_seconds": 318.94,
      "duration_seconds": 1.68,
      "text": "have a good day"
    }
  ]
