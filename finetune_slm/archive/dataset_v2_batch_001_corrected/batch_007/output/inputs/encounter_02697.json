{
  "schema_version": "1.0",
  "encounter_id": "02697",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 6.89,
      "duration_seconds": 5.95,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.56,
      "end_seconds": 12.14,
      "duration_seconds": 3.58,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.07,
      "end_seconds": 20.31,
      "duration_seconds": 7.24,
      "text": "Actually, you know, it's difficulty concentrating. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.94,
      "end_seconds": 24.78,
      "duration_seconds": 2.84,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.81,
      "end_seconds": 32.76,
      "duration_seconds": 5.95,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.67,
      "end_seconds": 39.71,
      "duration_seconds": 6.04,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.21,
      "end_seconds": 47.29,
      "duration_seconds": 6.08,
      "text": "Sorry, what was I saying, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.86,
      "end_seconds": 53.35,
      "duration_seconds": 5.49,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 53.45,
      "end_seconds": 60.15,
      "duration_seconds": 6.7,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.49,
      "end_seconds": 65.58,
      "duration_seconds": 4.09,
      "text": "Later, thanks. Please go on. Have you been losing things?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.34,
      "end_seconds": 72.82,
      "duration_seconds": 5.48,
      "text": "Yes, I have. I've also had impatience, for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.34,
      "end_seconds": 77.73,
      "duration_seconds": 3.39,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.79,
      "end_seconds": 82.0,
      "duration_seconds": 3.21,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.21,
      "end_seconds": 88.31,
      "duration_seconds": 5.1,
      "text": "Have you had difficulty concentrating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.18,
      "end_seconds": 97.07,
      "duration_seconds": 6.89,
      "text": "So, a bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.62,
      "end_seconds": 101.1,
      "duration_seconds": 3.48,
      "text": "Have you noticed head injury or drug use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.78,
      "end_seconds": 113.03,
      "duration_seconds": 10.25,
      "text": "No, no head injury, no drug use. I did have restlessness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.06,
      "end_seconds": 119.81,
      "duration_seconds": 4.75,
      "text": "So, have you noticed low mood or thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.24,
      "end_seconds": 124.32,
      "duration_seconds": 3.08,
      "text": "Oh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.06,
      "end_seconds": 129.54,
      "duration_seconds": 4.48,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.53,
      "end_seconds": 134.34,
      "duration_seconds": 2.81,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.54,
      "end_seconds": 137.88,
      "duration_seconds": 2.34,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.08,
      "end_seconds": 144.47,
      "duration_seconds": 3.39,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.89,
      "end_seconds": 150.29,
      "duration_seconds": 4.4,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.43,
      "end_seconds": 156.85,
      "duration_seconds": 5.42,
      "text": "My son has asthma. Oh, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.01,
      "end_seconds": 174.19,
      "duration_seconds": 4.18,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.86,
      "end_seconds": 178.13,
      "duration_seconds": 3.27,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.53,
      "end_seconds": 184.79,
      "duration_seconds": 3.26,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.64,
      "end_seconds": 192.65,
      "duration_seconds": 6.01,
      "text": "I've got migraines. Yes, gout. I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.38,
      "end_seconds": 202.22,
      "duration_seconds": 7.84,
      "text": "I see, go ahead. Okay, I can see gout and diabetes in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.64,
      "end_seconds": 212.79,
      "duration_seconds": 2.15,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.43,
      "end_seconds": 219.66,
      "duration_seconds": 6.23,
      "text": "Propranolol, 40 milligrams, maybe, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.24,
      "end_seconds": 223.64,
      "duration_seconds": 3.4,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.55,
      "end_seconds": 233.61,
      "duration_seconds": 9.06,
      "text": "Not with me. I'll bring it next time. Allopurinol. I take it 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 234.35,
      "end_seconds": 239.12,
      "duration_seconds": 4.77,
      "text": "Doctor, our chart from the last visit lists it as 50 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.97,
      "end_seconds": 246.62,
      "duration_seconds": 5.65,
      "text": "Okay, hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.51,
      "end_seconds": 255.54,
      "duration_seconds": 8.03,
      "text": "No, I left it at home. Before this I was on metformin; that's been stopped."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 256.14,
      "end_seconds": 267.6,
      "duration_seconds": 11.46,
      "text": "Doctor, I've got the readings for you. Pulse is 74 beats a minute, temperature is 36.8 degrees. Blood pressure 115 over 68, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.94,
      "end_seconds": 269.64,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.47,
      "end_seconds": 276.25,
      "duration_seconds": 3.78,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.05,
      "end_seconds": 279.42,
      "duration_seconds": 1.37,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 298.51,
      "duration_seconds": 5.89,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.55,
      "end_seconds": 313.97,
      "duration_seconds": 13.42,
      "text": "That's all I needed to check. From what you've told me and what I found, I can't pin this down yet. We're looking at possible adult attention deficit disorder or anxiety."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.14,
      "end_seconds": 317.27,
      "duration_seconds": 2.13,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.06,
      "end_seconds": 333.1,
      "duration_seconds": 15.04,
      "text": "I understand the worry. At the moment I'd say it's possible adult attention deficit disorder, and we'll know more once the a questionnaire is back. Let's book a questionnaire to look into attention problems."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 333.86,
      "end_seconds": 337.87,
      "duration_seconds": 4.01,
      "text": "I can book that for Thursday at 2 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.45,
      "end_seconds": 344.28,
      "duration_seconds": 4.83,
      "text": "I'm sending you for a thyroid test because of poor concentration."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 344.96,
      "end_seconds": 347.02,
      "duration_seconds": 2.06,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.47,
      "end_seconds": 362.16,
      "duration_seconds": 13.69,
      "text": "Use lists and reminders while we arrange the specialist assessment. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 363.58,
      "end_seconds": 366.55,
      "duration_seconds": 2.97,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.67,
      "end_seconds": 376.17,
      "duration_seconds": 8.5,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Let's plan a check after the assessment."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.1,
      "end_seconds": 378.8,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.85,
      "end_seconds": 386.96,
      "duration_seconds": 6.11,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 388.75,
      "end_seconds": 394.02,
      "duration_seconds": 5.27,
      "text": "So, I come back after the assessment. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.09,
      "end_seconds": 400.02,
      "duration_seconds": 3.93,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.92,
      "end_seconds": 404.22,
      "duration_seconds": 3.3,
      "text": "I mean, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.81,
      "end_seconds": 405.98,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}