{
  "schema_version": "1.0",
  "encounter_id": "02508",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.58,
      "duration_seconds": 4.23,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 14.19,
      "duration_seconds": 4.26,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.09,
      "end_seconds": 23.57,
      "duration_seconds": 7.48,
      "text": "it's a sudden painful cold leg i thought I'd wait, but it it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.51,
      "end_seconds": 29.03,
      "duration_seconds": 3.52,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.5,
      "end_seconds": 39.45,
      "duration_seconds": 2.95,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.43,
      "end_seconds": 60.36,
      "duration_seconds": 8.93,
      "text": "Okay: SpO2 98 percent on room air, pressure 134 over 85, temperature 36.5. And pulse is 120 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.93,
      "end_seconds": 62.3,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.86,
      "end_seconds": 67.84,
      "duration_seconds": 3.98,
      "text": "That's fine, I'll explain it soon. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.14,
      "end_seconds": 76.26,
      "duration_seconds": 3.12,
      "text": "it's been like this since Friday"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.09,
      "end_seconds": 81.45,
      "duration_seconds": 3.36,
      "text": "Is it it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.32,
      "end_seconds": 84.45,
      "duration_seconds": 2.13,
      "text": "honestly, every other day"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.56,
      "end_seconds": 89.45,
      "duration_seconds": 3.89,
      "text": "Any not being able to move the foot as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.96,
      "end_seconds": 101.39,
      "duration_seconds": 10.43,
      "text": "Well, yeah. Three days, I'd say. With not being able to move the foot, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.35,
      "end_seconds": 105.37,
      "duration_seconds": 3.02,
      "text": "Any numbness in the foot as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.27,
      "end_seconds": 107.84,
      "duration_seconds": 1.57,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 113.56,
      "duration_seconds": 3.8,
      "text": "and what about recent injury, fever or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.36,
      "end_seconds": 117.31,
      "duration_seconds": 2.95,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.27,
      "end_seconds": 121.75,
      "duration_seconds": 3.48,
      "text": "right, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.12,
      "end_seconds": 125.04,
      "duration_seconds": 1.92,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.64,
      "end_seconds": 130.08,
      "duration_seconds": 3.44,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.35,
      "end_seconds": 134.81,
      "duration_seconds": 3.46,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.17,
      "end_seconds": 137.35,
      "duration_seconds": 1.18,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.35,
      "end_seconds": 141.84,
      "duration_seconds": 3.49,
      "text": "No, you know, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.25,
      "end_seconds": 147.68,
      "duration_seconds": 3.43,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.25,
      "end_seconds": 155.07,
      "duration_seconds": 5.82,
      "text": "Right, it's metoprolol, 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.4,
      "end_seconds": 156.1,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.94,
      "end_seconds": 172.76,
      "duration_seconds": 2.82,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.97,
      "end_seconds": 183.46,
      "duration_seconds": 9.49,
      "text": "I drink a lot of tea and snack through the day. My partner and our baby. I swim twice a week"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.89,
      "end_seconds": 188.52,
      "duration_seconds": 3.63,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.46,
      "end_seconds": 202.63,
      "duration_seconds": 13.17,
      "text": "Yes, an irregular heartbeat. Work has been very busy so so I kept ignoring it. Um, I've had high cholesterol for five years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.15,
      "end_seconds": 204.85,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.74,
      "end_seconds": 212.21,
      "duration_seconds": 4.47,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.5,
      "end_seconds": 215.6,
      "duration_seconds": 2.1,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.55,
      "end_seconds": 233.55,
      "duration_seconds": 8.0,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.52,
      "end_seconds": 249.22,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.91,
      "end_seconds": 254.1,
      "duration_seconds": 2.19,
      "text": "Alright, please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.94,
      "end_seconds": 271.92,
      "duration_seconds": 5.98,
      "text": "Right, here's what I'm thinking. My working impression is an acutely ischaemic leg."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.9,
      "end_seconds": 276.74,
      "duration_seconds": 2.84,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.31,
      "end_seconds": 315.41,
      "duration_seconds": 33.1,
      "text": "Nothing I've seen today points to an emergency. It looks like an acutely ischaemic leg, but I'd like to confirm. Let's get an urgent CT angiogram, for acute limb ischaemia. For this, heparin, 5000 units, bolus now, single dose. That's for limb ischaemia. The pharmacy will go through the details again when you pick it up. You need the vascular surgeons now, this is time critical."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.86,
      "end_seconds": 328.08,
      "duration_seconds": 7.22,
      "text": "One warning sign to remember: the the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.68,
      "end_seconds": 330.32,
      "duration_seconds": 1.64,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.0,
      "end_seconds": 338.38,
      "duration_seconds": 7.38,
      "text": "Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.99,
      "end_seconds": 342.36,
      "duration_seconds": 2.37,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.38,
      "end_seconds": 345.69,
      "duration_seconds": 1.31,
      "text": "see you soon"
    }
  ]
}