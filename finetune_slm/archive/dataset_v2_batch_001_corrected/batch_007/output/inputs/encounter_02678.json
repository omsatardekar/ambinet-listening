{
  "schema_version": "1.0",
  "encounter_id": "02678",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 4.66,
      "duration_seconds": 3.29,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.52,
      "end_seconds": 10.69,
      "duration_seconds": 5.17,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.36,
      "end_seconds": 15.96,
      "duration_seconds": 3.6,
      "text": "I've been dealing with fainting on exertion"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.55,
      "end_seconds": 19.85,
      "duration_seconds": 3.3,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.58,
      "end_seconds": 22.92,
      "duration_seconds": 2.34,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 27.8,
      "duration_seconds": 3.09,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.66,
      "end_seconds": 32.61,
      "duration_seconds": 2.95,
      "text": "It feels mild to to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 36.2,
      "duration_seconds": 1.61,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.29,
      "end_seconds": 43.95,
      "duration_seconds": 2.66,
      "text": "So, it's worse with exertion."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.03,
      "end_seconds": 49.25,
      "duration_seconds": 3.22,
      "text": "Alright, is it it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.03,
      "end_seconds": 62.65,
      "duration_seconds": 11.62,
      "text": "Swollen ankles goes along with it, uh, most of the time. The Swollen ankles? That's been for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.29,
      "end_seconds": 75.79,
      "duration_seconds": 2.5,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.91,
      "end_seconds": 87.7,
      "duration_seconds": 2.79,
      "text": "sit still for a a moment.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.6,
      "end_seconds": 112.04,
      "duration_seconds": 9.44,
      "text": "Okay: pulse is 95 beats a minute, temperature 37.6. And saturation 89 percent, blood pressure 136 over 89."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.51,
      "end_seconds": 117.53,
      "duration_seconds": 3.02,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.51,
      "end_seconds": 120.41,
      "duration_seconds": 0.9,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.3,
      "end_seconds": 123.59,
      "duration_seconds": 1.29,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.41,
      "end_seconds": 147.54,
      "duration_seconds": 5.13,
      "text": "there is a loud second heart sound and a raised jugular pulse"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.34,
      "end_seconds": 153.0,
      "duration_seconds": 2.66,
      "text": "okay, you can sit up now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 167.79,
      "duration_seconds": 3.59,
      "text": "Did you get cough, fever or leg pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.71,
      "end_seconds": 174.69,
      "duration_seconds": 4.98,
      "text": "No cough, fever or leg pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.54,
      "end_seconds": 181.0,
      "duration_seconds": 3.46,
      "text": "Right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.18,
      "end_seconds": 185.06,
      "duration_seconds": 2.88,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.4,
      "end_seconds": 192.01,
      "duration_seconds": 2.61,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.44,
      "end_seconds": 194.51,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.74,
      "end_seconds": 205.54,
      "duration_seconds": 2.8,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 210.17,
      "duration_seconds": 3.49,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.82,
      "end_seconds": 225.82,
      "duration_seconds": 4.0,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.47,
      "end_seconds": 230.5,
      "duration_seconds": 3.03,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.57,
      "end_seconds": 232.79,
      "duration_seconds": 1.22,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.52,
      "end_seconds": 241.41,
      "duration_seconds": 2.89,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.98,
      "end_seconds": 245.02,
      "duration_seconds": 2.04,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.72,
      "end_seconds": 250.08,
      "duration_seconds": 4.36,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.02,
      "end_seconds": 255.43,
      "duration_seconds": 3.41,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.84,
      "end_seconds": 258.66,
      "duration_seconds": 1.82,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.09,
      "end_seconds": 264.83,
      "duration_seconds": 2.74,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.44,
      "end_seconds": 271.59,
      "duration_seconds": 5.15,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.53,
      "end_seconds": 277.96,
      "duration_seconds": 5.43,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.77,
      "end_seconds": 288.98,
      "duration_seconds": 9.21,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.47,
      "end_seconds": 294.97,
      "duration_seconds": 4.5,
      "text": "Putting it all together, this is probably possible pulmonary hypertension."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.75,
      "end_seconds": 298.59,
      "duration_seconds": 1.84,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 316.92,
      "duration_seconds": 17.63,
      "text": "I can't promise yet, but most people with possible pulmonary hypertension do well once it's treated properly. So, to recap quickly. You've had fainting on exertion for about two weeks, mild, and no leg pain or cough"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.32,
      "end_seconds": 319.98,
      "duration_seconds": 1.66,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.57,
      "end_seconds": 327.11,
      "duration_seconds": 3.54,
      "text": "I want an ECG done, that's for syncope."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.49,
      "end_seconds": 330.46,
      "duration_seconds": 1.97,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.53,
      "end_seconds": 347.69,
      "duration_seconds": 15.16,
      "text": "I'm sending you for an echocardiogram because of exertional syncope. The result will help us decide whether anything more is needed. No exertion for now, I am arranging urgent specialist tests."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.93,
      "end_seconds": 353.65,
      "duration_seconds": 5.72,
      "text": "Ah. Let's get you seen by the pulmonary hypertension service, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.02,
      "end_seconds": 357.67,
      "duration_seconds": 2.65,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.01,
      "end_seconds": 372.65,
      "duration_seconds": 13.64,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Come back in one week. Okay, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.6,
      "end_seconds": 380.18,
      "duration_seconds": 5.58,
      "text": "So, I come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.27,
      "end_seconds": 384.95,
      "duration_seconds": 3.68,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.35,
      "end_seconds": 388.27,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    }
  ]
}