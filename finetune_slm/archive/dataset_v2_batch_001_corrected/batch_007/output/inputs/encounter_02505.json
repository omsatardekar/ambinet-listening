{
  "schema_version": "1.0",
  "encounter_id": "02505",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.37,
      "duration_seconds": 3.78,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.04,
      "duration_seconds": 3.86,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.43,
      "end_seconds": 17.93,
      "duration_seconds": 6.5,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.13,
      "end_seconds": 22.66,
      "duration_seconds": 3.53,
      "text": "Okay, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.98,
      "end_seconds": 27.44,
      "duration_seconds": 3.46,
      "text": "I've been dealing with sneezing in spring."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 33.34,
      "duration_seconds": 4.0,
      "text": "Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.31,
      "end_seconds": 38.1,
      "duration_seconds": 3.79,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.46,
      "end_seconds": 46.18,
      "duration_seconds": 4.72,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.83,
      "end_seconds": 50.32,
      "duration_seconds": 2.49,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.92,
      "end_seconds": 54.05,
      "duration_seconds": 2.13,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.14,
      "end_seconds": 58.28,
      "duration_seconds": 2.14,
      "text": "It's worse with pollen."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.79,
      "end_seconds": 63.76,
      "duration_seconds": 3.97,
      "text": "So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.63,
      "end_seconds": 72.94,
      "duration_seconds": 7.31,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.88,
      "end_seconds": 79.7,
      "duration_seconds": 5.82,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.13,
      "end_seconds": 82.31,
      "duration_seconds": 1.18,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.12,
      "end_seconds": 92.07,
      "duration_seconds": 8.95,
      "text": "I mean, uh, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 92.17,
      "end_seconds": 98.63,
      "duration_seconds": 6.46,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.48,
      "end_seconds": 103.0,
      "duration_seconds": 2.52,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.81,
      "end_seconds": 110.05,
      "duration_seconds": 6.24,
      "text": "Oh, and watery eyes. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.02,
      "end_seconds": 114.57,
      "duration_seconds": 3.55,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.0,
      "end_seconds": 125.97,
      "duration_seconds": 9.97,
      "text": "About a eight out of ten. Oh, and a runny itchy nose. Had that since this morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.67,
      "end_seconds": 130.84,
      "duration_seconds": 4.17,
      "text": "So, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.94,
      "end_seconds": 137.85,
      "duration_seconds": 5.91,
      "text": "Well, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.53,
      "end_seconds": 140.46,
      "duration_seconds": 1.93,
      "text": "What about facial pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.68,
      "end_seconds": 145.95,
      "duration_seconds": 4.27,
      "text": "I, I haven't noticed any facial pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.5,
      "end_seconds": 149.61,
      "duration_seconds": 3.11,
      "text": "And what about wheeze or loss of smell?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.57,
      "end_seconds": 158.78,
      "duration_seconds": 5.21,
      "text": "I haven't had wheeze or loss of smell, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.62,
      "end_seconds": 161.92,
      "duration_seconds": 1.3,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.86,
      "end_seconds": 165.46,
      "duration_seconds": 1.6,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 169.0,
      "end_seconds": 174.19,
      "duration_seconds": 5.19,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.84,
      "end_seconds": 181.21,
      "duration_seconds": 6.37,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.6,
      "end_seconds": 190.01,
      "duration_seconds": 7.41,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.74,
      "end_seconds": 198.1,
      "duration_seconds": 3.36,
      "text": "No, uh, skin's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.59,
      "end_seconds": 204.69,
      "duration_seconds": 5.1,
      "text": "Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.18,
      "end_seconds": 208.99,
      "duration_seconds": 2.81,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.65,
      "end_seconds": 224.11,
      "duration_seconds": 3.46,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.86,
      "end_seconds": 237.47,
      "duration_seconds": 11.61,
      "text": "Sorry, what was I saying, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.56,
      "end_seconds": 241.05,
      "duration_seconds": 2.49,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.64,
      "end_seconds": 257.11,
      "duration_seconds": 14.47,
      "text": "Yeah, for my acidity, I believe. My wife sets them out for me, I just take what I'm given. Loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.3,
      "end_seconds": 264.54,
      "duration_seconds": 2.24,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.33,
      "end_seconds": 268.48,
      "duration_seconds": 2.15,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.23,
      "end_seconds": 270.67,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.79,
      "end_seconds": 274.11,
      "duration_seconds": 2.32,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.63,
      "end_seconds": 280.14,
      "duration_seconds": 4.51,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.1,
      "end_seconds": 293.92,
      "duration_seconds": 11.82,
      "text": "I think I reacted to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.15,
      "end_seconds": 298.79,
      "duration_seconds": 3.64,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.6,
      "end_seconds": 304.61,
      "duration_seconds": 5.01,
      "text": "My aunt has rheumatoid arthritis. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.97,
      "end_seconds": 312.64,
      "duration_seconds": 6.67,
      "text": "What conditions have you been treated for in the past? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.69,
      "end_seconds": 317.87,
      "duration_seconds": 3.18,
      "text": "I, I have acid reflux."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.04,
      "end_seconds": 319.93,
      "duration_seconds": 0.89,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.17,
      "end_seconds": 326.78,
      "duration_seconds": 1.61,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.37,
      "end_seconds": 328.66,
      "duration_seconds": 1.29,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.32,
      "end_seconds": 333.9,
      "duration_seconds": 3.58,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.73,
      "end_seconds": 336.04,
      "duration_seconds": 1.31,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.92,
      "end_seconds": 340.21,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 351.03,
      "end_seconds": 360.17,
      "duration_seconds": 9.14,
      "text": "Doctor, I've got the readings for you. Temp 36.5 degrees, blood pressure 119 over 81, heart rate 73, saturation 98 percent."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.26,
      "end_seconds": 362.82,
      "duration_seconds": 1.56,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.66,
      "end_seconds": 369.84,
      "duration_seconds": 4.18,
      "text": "Okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.67,
      "end_seconds": 374.53,
      "duration_seconds": 2.86,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.08,
      "end_seconds": 396.75,
      "duration_seconds": 5.67,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.12,
      "end_seconds": 416.38,
      "duration_seconds": 14.26,
      "text": "All finished, thank you. Putting it all together, I'd lean towards seasonal allergic rhinitis. So, to recap quickly. You've had sneezing in spring for about a week, mild, and no wheeze."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.57,
      "end_seconds": 421.44,
      "duration_seconds": 3.87,
      "text": "So, um, that's what happened, yes."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.35,
      "end_seconds": 449.47,
      "duration_seconds": 27.12,
      "text": "The treatment will be fluticasone nasal spray, 50 micrograms, once a day, the season. It's for hay fever. Shower after being outdoors and keep windows shut when pollen is high. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again if not better in a month."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 450.9,
      "end_seconds": 454.97,
      "duration_seconds": 4.07,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.28,
      "end_seconds": 460.57,
      "duration_seconds": 4.29,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 461.96,
      "end_seconds": 465.71,
      "duration_seconds": 3.75,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 467.56,
      "end_seconds": 469.03,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}