{
  "schema_version": "1.0",
  "encounter_id": "02874",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 7.36,
      "duration_seconds": 6.05,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.99,
      "end_seconds": 14.28,
      "duration_seconds": 4.29,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.17,
      "end_seconds": 22.52,
      "duration_seconds": 6.35,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.93,
      "end_seconds": 28.02,
      "duration_seconds": 4.09,
      "text": "Okay, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.74,
      "end_seconds": 32.57,
      "duration_seconds": 3.83,
      "text": "It's a blister on my heel, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.4,
      "end_seconds": 36.49,
      "duration_seconds": 2.09,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.01,
      "end_seconds": 40.86,
      "duration_seconds": 3.85,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 46.68,
      "duration_seconds": 2.53,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.69,
      "end_seconds": 51.24,
      "duration_seconds": 3.55,
      "text": "Only a plaster, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.8,
      "end_seconds": 58.79,
      "duration_seconds": 6.99,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 58.89,
      "end_seconds": 65.47,
      "duration_seconds": 6.58,
      "text": "Tell the doctor about the other thing, you know, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.1,
      "end_seconds": 68.5,
      "duration_seconds": 2.4,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 70.54,
      "end_seconds": 74.52,
      "duration_seconds": 3.98,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.27,
      "end_seconds": 91.11,
      "duration_seconds": 3.84,
      "text": "A few quick ones: fever, diabetes or redness spreading?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.76,
      "end_seconds": 105.66,
      "duration_seconds": 12.9,
      "text": "Actually, no, no fever, no diabetes, no redness spreading. I did have a little soreness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.12,
      "end_seconds": 110.31,
      "duration_seconds": 4.19,
      "text": "Okay, go on. And pus, any of that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.32,
      "end_seconds": 113.9,
      "duration_seconds": 1.58,
      "text": "No pus, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 118.3,
      "duration_seconds": 3.83,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.85,
      "end_seconds": 120.91,
      "duration_seconds": 2.06,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.77,
      "end_seconds": 124.08,
      "duration_seconds": 2.31,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.47,
      "end_seconds": 130.35,
      "duration_seconds": 4.88,
      "text": "I, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.08,
      "end_seconds": 152.33,
      "duration_seconds": 3.25,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.03,
      "end_seconds": 157.06,
      "duration_seconds": 4.03,
      "text": "My grandmother had dementia. My son has asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.58,
      "end_seconds": 166.29,
      "duration_seconds": 8.71,
      "text": "Can you list what you take, tablets, creams or inhalers? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.5,
      "end_seconds": 173.17,
      "duration_seconds": 5.67,
      "text": "Lamotrigine. I take it 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 174.5,
      "end_seconds": 179.96,
      "duration_seconds": 5.46,
      "text": "Doctor, our chart from the last visit lists it as 50 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.0,
      "end_seconds": 183.79,
      "duration_seconds": 2.79,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 197.1,
      "duration_seconds": 11.28,
      "text": "Not with me. I'll bring it next time. I take Tiotropium inhaler, once a day. I used to take pantoprazole, but I stopped it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.97,
      "end_seconds": 202.51,
      "duration_seconds": 4.54,
      "text": "Alright, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.32,
      "end_seconds": 219.13,
      "duration_seconds": 15.81,
      "text": "I've got epilepsy. Yes, acid reflux. It's a relief to finally sit down and talk about it. I took the morning off to come in today. I've, I've had COPD, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.19,
      "end_seconds": 234.72,
      "duration_seconds": 9.53,
      "text": "I follow. Alright, epilepsy and acid reflux, that matches what I have here. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.19,
      "end_seconds": 252.53,
      "duration_seconds": 13.34,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.3,
      "end_seconds": 256.9,
      "duration_seconds": 2.6,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.76,
      "end_seconds": 265.07,
      "duration_seconds": 4.31,
      "text": "Naproxen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 266.2,
      "end_seconds": 274.2,
      "duration_seconds": 8.0,
      "text": "Here are the numbers, doctor. Pressure 128 over 81, saturation 98 percent, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.75,
      "end_seconds": 278.82,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.89,
      "end_seconds": 285.44,
      "duration_seconds": 4.55,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.09,
      "end_seconds": 290.6,
      "duration_seconds": 3.51,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.01,
      "end_seconds": 312.3,
      "duration_seconds": 6.29,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.16,
      "end_seconds": 341.09,
      "duration_seconds": 22.93,
      "text": "That's the examination finished. Okay, thinking it through, it fits best with a simple friction blister. The reason I say that is that your story and my examination fit together. So, to recap quickly. You've had a blister on your heel for about a week, and no diabetes or fever."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.34,
      "end_seconds": 343.04,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.13,
      "end_seconds": 358.72,
      "duration_seconds": 14.59,
      "text": "Leave it intact, cover it with a padded plaster and change the shoes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.54,
      "end_seconds": 362.17,
      "duration_seconds": 1.63,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.97,
      "end_seconds": 371.16,
      "duration_seconds": 8.19,
      "text": "One warning sign to remember: the area becomes red, hot or pus-filled. In that case don't wait."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.51,
      "end_seconds": 373.47,
      "duration_seconds": 0.96,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.27,
      "end_seconds": 384.36,
      "duration_seconds": 9.09,
      "text": "I'd like to see you again if it looks infected. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.76,
      "end_seconds": 389.39,
      "duration_seconds": 3.63,
      "text": "Yeah, um, thank you, doctor, goodbye."
    }
  ]
}