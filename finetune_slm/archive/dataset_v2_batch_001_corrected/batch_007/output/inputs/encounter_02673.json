{
  "schema_version": "1.0",
  "encounter_id": "02673",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 5.69,
      "duration_seconds": 5.05,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.49,
      "end_seconds": 14.62,
      "duration_seconds": 4.13,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.14,
      "end_seconds": 23.34,
      "duration_seconds": 7.2,
      "text": "Yeah, it's a severe sore throat on one side. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.76,
      "end_seconds": 28.52,
      "duration_seconds": 3.76,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.93,
      "end_seconds": 32.65,
      "duration_seconds": 2.72,
      "text": "It's been like this since Friday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.88,
      "end_seconds": 36.97,
      "duration_seconds": 3.09,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.6,
      "end_seconds": 42.57,
      "duration_seconds": 3.97,
      "text": "It's severe, honestly. I've also had drooling."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.16,
      "end_seconds": 46.5,
      "duration_seconds": 3.34,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.74,
      "end_seconds": 51.12,
      "duration_seconds": 3.38,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.97,
      "end_seconds": 76.08,
      "duration_seconds": 9.11,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.74,
      "end_seconds": 81.0,
      "duration_seconds": 3.26,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.77,
      "end_seconds": 87.89,
      "duration_seconds": 3.12,
      "text": "Right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.55,
      "end_seconds": 93.78,
      "duration_seconds": 4.23,
      "text": "I mean, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.48,
      "end_seconds": 96.43,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.01,
      "end_seconds": 104.15,
      "duration_seconds": 3.14,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.21,
      "end_seconds": 110.08,
      "duration_seconds": 1.87,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.0,
      "end_seconds": 119.07,
      "duration_seconds": 5.07,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.16,
      "end_seconds": 122.22,
      "duration_seconds": 2.06,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.34,
      "end_seconds": 127.55,
      "duration_seconds": 4.21,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.13,
      "end_seconds": 131.95,
      "duration_seconds": 2.82,
      "text": "Alright, tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.69,
      "end_seconds": 138.38,
      "duration_seconds": 5.69,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.69,
      "end_seconds": 143.68,
      "duration_seconds": 3.99,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.19,
      "end_seconds": 148.29,
      "duration_seconds": 3.1,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.97,
      "end_seconds": 153.7,
      "duration_seconds": 3.73,
      "text": "Any cough, rash or noisy breathing at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.3,
      "end_seconds": 159.31,
      "duration_seconds": 5.01,
      "text": "I haven't had cough, rash or noisy breathing, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.9,
      "end_seconds": 164.65,
      "duration_seconds": 3.75,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.74,
      "end_seconds": 167.68,
      "duration_seconds": 0.94,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.52,
      "end_seconds": 174.97,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.7,
      "end_seconds": 189.21,
      "duration_seconds": 2.51,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.01,
      "end_seconds": 208.42,
      "duration_seconds": 9.41,
      "text": "Okay: pulse is 100 beats a minute, blood pressure 109 over 70. And saturation 97 percent, temperature is 39.2 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.51,
      "end_seconds": 212.18,
      "duration_seconds": 1.67,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.05,
      "end_seconds": 218.54,
      "duration_seconds": 4.49,
      "text": "Right, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 241.86,
      "duration_seconds": 5.98,
      "text": "Putting together what you've described, I'd lean towards a quinsy, a peritonsillar abscess."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.64,
      "end_seconds": 257.93,
      "duration_seconds": 5.29,
      "text": "I'm going to order an urgent ENT drainage, for peritonsillar abscess."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.7,
      "end_seconds": 261.68,
      "duration_seconds": 2.98,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.0,
      "end_seconds": 279.34,
      "duration_seconds": 16.34,
      "text": "We should do blood tests for abscess. The result will help us decide whether anything more is needed. The treatment will be benzylpenicillin, 1.2 grams, now, single dose. It's for peritonsillar abscess."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.81,
      "end_seconds": 282.93,
      "duration_seconds": 2.12,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.78,
      "end_seconds": 300.71,
      "duration_seconds": 15.93,
      "text": "You need to be seen by ENT today to drain it. I'll also refer you to the ENT team. I'll want another look straight away. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.36,
      "end_seconds": 304.67,
      "duration_seconds": 2.31,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}