{
  "schema_version": "1.0",
  "encounter_id": "02631",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.96,
      "duration_seconds": 4.08,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 12.78,
      "duration_seconds": 6.12,
      "text": "Right, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.71,
      "end_seconds": 19.65,
      "duration_seconds": 5.94,
      "text": "So the thing is, I've got a blister on my heel."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.2,
      "end_seconds": 24.77,
      "duration_seconds": 3.57,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.76,
      "end_seconds": 47.16,
      "duration_seconds": 21.4,
      "text": "I'm on febuxostat, 80 milligrams, once a day for the gout. I'm, I'm on bisoprolol, 2.5 milligrams, once a day for the heart rhythm. My sister suggested writing things down, but I forgot. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.73,
      "end_seconds": 63.14,
      "duration_seconds": 3.41,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.76,
      "end_seconds": 67.66,
      "duration_seconds": 2.9,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.38,
      "end_seconds": 71.31,
      "duration_seconds": 2.93,
      "text": "Has there been a little soreness too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.26,
      "end_seconds": 76.39,
      "duration_seconds": 3.13,
      "text": "Yeah, I've had that since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.22,
      "end_seconds": 82.58,
      "duration_seconds": 2.36,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.33,
      "end_seconds": 86.1,
      "duration_seconds": 2.77,
      "text": "Walking definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 97.77,
      "duration_seconds": 2.59,
      "text": "Have you noticed pus or diabetes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.46,
      "end_seconds": 102.25,
      "duration_seconds": 3.79,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.82,
      "end_seconds": 105.84,
      "duration_seconds": 2.02,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.95,
      "end_seconds": 109.52,
      "duration_seconds": 2.57,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.06,
      "end_seconds": 115.02,
      "duration_seconds": 3.96,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.62,
      "end_seconds": 119.56,
      "duration_seconds": 3.94,
      "text": "No, um, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.84,
      "end_seconds": 122.22,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.57,
      "end_seconds": 126.73,
      "duration_seconds": 3.16,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.42,
      "end_seconds": 133.71,
      "duration_seconds": 3.29,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.2,
      "end_seconds": 138.5,
      "duration_seconds": 3.3,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.66,
      "end_seconds": 142.1,
      "duration_seconds": 2.44,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.13,
      "end_seconds": 147.97,
      "duration_seconds": 3.84,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.88,
      "end_seconds": 153.94,
      "duration_seconds": 4.06,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.83,
      "end_seconds": 160.73,
      "duration_seconds": 5.9,
      "text": "Yes, gout. I've had an irregular heartbeat for five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.98,
      "end_seconds": 164.93,
      "duration_seconds": 2.95,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.22,
      "end_seconds": 176.05,
      "duration_seconds": 1.83,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.71,
      "end_seconds": 180.21,
      "duration_seconds": 3.5,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.01,
      "end_seconds": 184.69,
      "duration_seconds": 3.68,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.79,
      "end_seconds": 195.79,
      "duration_seconds": 8.0,
      "text": "I was told I'm allergic to nickel, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.88,
      "end_seconds": 201.26,
      "duration_seconds": 3.38,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.12,
      "end_seconds": 217.74,
      "duration_seconds": 2.62,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.65,
      "end_seconds": 241.36,
      "duration_seconds": 11.71,
      "text": "Okay: blood pressure 123 over 73, respiratory rate 17, SpO2 98 percent on room air. And heart rate 77, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.59,
      "end_seconds": 244.02,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.37,
      "end_seconds": 249.92,
      "duration_seconds": 4.55,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.4,
      "end_seconds": 273.72,
      "duration_seconds": 5.32,
      "text": "Right, here's what I'm thinking. This looks most like a simple friction blister."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.77,
      "end_seconds": 276.9,
      "duration_seconds": 2.13,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.73,
      "end_seconds": 310.18,
      "duration_seconds": 32.45,
      "text": "I understand the worry. At the moment I'd say it's a simple friction blister, and we'll watch how it goes. Leave it intact, cover it with a padded plaster and change the shoes. Please don't wait if the area becomes red, hot or pus-filled. That's when to be seen urgently. See me again if it looks infected. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.86,
      "end_seconds": 313.88,
      "duration_seconds": 3.02,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.67,
      "end_seconds": 315.87,
      "duration_seconds": 1.2,
      "text": "Look after yourself."
    }
  ]
}