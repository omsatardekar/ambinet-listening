{
  "schema_version": "1.0",
  "encounter_id": "02892",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.35,
      "duration_seconds": 3.52,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.75,
      "end_seconds": 9.32,
      "duration_seconds": 3.57,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.4,
      "end_seconds": 18.62,
      "duration_seconds": 8.22,
      "text": "Yeah, you know, it's a widespread rash with fever. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.08,
      "end_seconds": 24.03,
      "duration_seconds": 3.95,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.21,
      "end_seconds": 27.59,
      "duration_seconds": 2.38,
      "text": "for three days, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.98,
      "end_seconds": 34.7,
      "duration_seconds": 5.72,
      "text": "Alright, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 38.91,
      "duration_seconds": 3.51,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.04,
      "end_seconds": 41.51,
      "duration_seconds": 1.47,
      "text": "any breathing difficulty?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.97,
      "end_seconds": 45.87,
      "duration_seconds": 2.9,
      "text": "Not at all, no breathing difficulty."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.0,
      "end_seconds": 50.99,
      "duration_seconds": 3.99,
      "text": "Okay, have you had any blisters or mouth sores?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.94,
      "end_seconds": 56.75,
      "duration_seconds": 3.81,
      "text": "I haven't had blisters or mouth sores, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.2,
      "end_seconds": 60.73,
      "duration_seconds": 2.53,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.38,
      "end_seconds": 63.37,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.19,
      "end_seconds": 67.47,
      "duration_seconds": 3.28,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.45,
      "end_seconds": 70.59,
      "duration_seconds": 2.14,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.79,
      "end_seconds": 87.87,
      "duration_seconds": 2.08,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.65,
      "end_seconds": 95.47,
      "duration_seconds": 1.82,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 97.74,
      "duration_seconds": 1.25,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.71,
      "end_seconds": 103.39,
      "duration_seconds": 3.68,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.53,
      "end_seconds": 106.94,
      "duration_seconds": 2.41,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.83,
      "end_seconds": 113.82,
      "duration_seconds": 4.99,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.49,
      "end_seconds": 117.84,
      "duration_seconds": 2.35,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.24,
      "end_seconds": 126.38,
      "duration_seconds": 4.14,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.28,
      "end_seconds": 139.83,
      "duration_seconds": 3.55,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.51,
      "end_seconds": 142.0,
      "duration_seconds": 1.49,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.53,
      "end_seconds": 161.34,
      "duration_seconds": 6.81,
      "text": "Any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.83,
      "end_seconds": 164.38,
      "duration_seconds": 1.55,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 170.11,
      "duration_seconds": 5.13,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.63,
      "end_seconds": 182.44,
      "duration_seconds": 6.81,
      "text": "Not currently, but as a a youngster tramadol gave me feeling very drowsy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.91,
      "end_seconds": 186.11,
      "duration_seconds": 2.2,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.75,
      "end_seconds": 190.59,
      "duration_seconds": 2.84,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.37,
      "end_seconds": 196.36,
      "duration_seconds": 2.99,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.77,
      "end_seconds": 199.47,
      "duration_seconds": 1.7,
      "text": "so, look straight ahead"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.09,
      "end_seconds": 225.96,
      "duration_seconds": 7.87,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.58,
      "end_seconds": 231.24,
      "duration_seconds": 1.66,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.77,
      "end_seconds": 254.56,
      "duration_seconds": 5.79,
      "text": "So where does that leave us? My working impression is a severe drug reaction."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.51,
      "end_seconds": 257.45,
      "duration_seconds": 1.94,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.12,
      "end_seconds": 278.95,
      "duration_seconds": 19.83,
      "text": "It's reasonable to be concerned, but right now a severe drug reaction is my leading thought, not anything worse. Just to be sure I understood. You've had a widespread rash with fever for three days, and no mouth sores or blisters."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.71,
      "end_seconds": 281.26,
      "duration_seconds": 1.55,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.4,
      "end_seconds": 296.17,
      "duration_seconds": 13.77,
      "text": "I'd like to arrange urgent blood tests for severe drug reaction. Let's use prednisolone, 40 milligrams, once a day, until review. That should help with severe drug reaction"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.07,
      "end_seconds": 300.32,
      "duration_seconds": 2.25,
      "text": "how soon will it work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.47,
      "end_seconds": 315.23,
      "duration_seconds": 13.76,
      "text": "Stop the allopurinol now and you need admission. I'll also refer you to the dermatology team. See me again straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.48,
      "end_seconds": 319.74,
      "duration_seconds": 3.26,
      "text": "good, thanks, I'll see you then"
    }
  ]
}