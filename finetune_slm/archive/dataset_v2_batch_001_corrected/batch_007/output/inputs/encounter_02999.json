{
  "schema_version": "1.0",
  "encounter_id": "02999",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 2.89,
      "duration_seconds": 1.8,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.49,
      "end_seconds": 8.84,
      "duration_seconds": 4.35,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.84,
      "end_seconds": 21.26,
      "duration_seconds": 7.42,
      "text": "Doctor, thank you for seeing us. We came because of weakness climbing up my legs."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.08,
      "end_seconds": 24.88,
      "duration_seconds": 2.8,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.93,
      "end_seconds": 35.66,
      "duration_seconds": 4.73,
      "text": "It's been about two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.06,
      "end_seconds": 39.75,
      "duration_seconds": 3.69,
      "text": "Understood. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.48,
      "end_seconds": 41.69,
      "duration_seconds": 1.21,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.79,
      "end_seconds": 44.85,
      "duration_seconds": 2.06,
      "text": "Have you had difficulty walking?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.74,
      "end_seconds": 52.02,
      "duration_seconds": 6.28,
      "text": "Yeah. Five days, I'd say. And a recent stomach bug, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.85,
      "end_seconds": 58.38,
      "duration_seconds": 4.53,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.77,
      "end_seconds": 62.84,
      "duration_seconds": 3.07,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.95,
      "end_seconds": 68.51,
      "duration_seconds": 4.56,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.21,
      "end_seconds": 70.79,
      "duration_seconds": 1.58,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.49,
      "end_seconds": 84.91,
      "duration_seconds": 2.42,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 86.37,
      "end_seconds": 98.91,
      "duration_seconds": 12.54,
      "text": "Oh, it's omeprazole, 20 milligrams, once a day, doctor. He is on rosuvastatin, 10 milligrams, at night for my cholesterol, I give it to him."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.37,
      "end_seconds": 103.8,
      "duration_seconds": 3.43,
      "text": "So, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 104.88,
      "end_seconds": 106.82,
      "duration_seconds": 1.94,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.83,
      "end_seconds": 113.75,
      "duration_seconds": 4.92,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.11,
      "end_seconds": 121.57,
      "duration_seconds": 6.46,
      "text": "I have acid reflux, for about a year. I have high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.23,
      "end_seconds": 131.09,
      "duration_seconds": 7.86,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.59,
      "end_seconds": 133.78,
      "duration_seconds": 1.19,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.57,
      "end_seconds": 137.93,
      "duration_seconds": 2.36,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.13,
      "end_seconds": 143.12,
      "duration_seconds": 3.99,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.19,
      "end_seconds": 146.55,
      "duration_seconds": 2.36,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.6,
      "end_seconds": 154.98,
      "duration_seconds": 4.38,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.62,
      "end_seconds": 160.81,
      "duration_seconds": 2.19,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.78,
      "end_seconds": 165.47,
      "duration_seconds": 2.69,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.98,
      "end_seconds": 168.95,
      "duration_seconds": 2.97,
      "text": "Any fever, bladder problems or back pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.76,
      "end_seconds": 179.49,
      "duration_seconds": 5.73,
      "text": "So, no fever, bladder problems or back pain, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.46,
      "end_seconds": 183.96,
      "duration_seconds": 3.5,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.73,
      "end_seconds": 188.55,
      "duration_seconds": 2.82,
      "text": "Well, no, that's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.13,
      "end_seconds": 199.98,
      "duration_seconds": 2.85,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.89,
      "end_seconds": 209.69,
      "duration_seconds": 2.8,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.74,
      "end_seconds": 227.76,
      "duration_seconds": 5.02,
      "text": "Okay: pulse 77, BP is 112 over 78, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.71,
      "end_seconds": 234.23,
      "duration_seconds": 4.52,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.81,
      "end_seconds": 237.25,
      "duration_seconds": 1.44,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.11,
      "end_seconds": 258.98,
      "duration_seconds": 5.87,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.5,
      "end_seconds": 266.91,
      "duration_seconds": 2.41,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.06,
      "end_seconds": 283.46,
      "duration_seconds": 8.4,
      "text": "Right, here's what I'm thinking. It fits best with possible Guillain-Barre syndrome. We shouldn't forget a spinal cord problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.52,
      "end_seconds": 289.71,
      "duration_seconds": 4.19,
      "text": "Yeah, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.75,
      "end_seconds": 309.88,
      "duration_seconds": 19.13,
      "text": "I understand the worry. At the moment I'd say it's possible Guillain-Barre syndrome, and we'll know more once the an urgent admission is back. An urgent admission is what I'd like next, for ascending weakness. Let's get a lumbar puncture, for possible GBS."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.45,
      "end_seconds": 313.53,
      "duration_seconds": 3.08,
      "text": "Actually, when would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.32,
      "end_seconds": 324.41,
      "duration_seconds": 9.09,
      "text": "You must be admitted today for monitoring of your breathing. Come back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.17,
      "end_seconds": 326.99,
      "duration_seconds": 1.82,
      "text": "That's clear, thanks."
    }
  ]
}