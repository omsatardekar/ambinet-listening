{
  "schema_version": "1.0",
  "encounter_id": "02919",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 2.69,
      "duration_seconds": 1.57,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 11.4,
      "duration_seconds": 4.48,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.52,
      "end_seconds": 16.13,
      "duration_seconds": 3.61,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.18,
      "end_seconds": 22.22,
      "duration_seconds": 4.04,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.88,
      "end_seconds": 28.07,
      "duration_seconds": 5.19,
      "text": "Doctor, it's periods becoming irregular. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.53,
      "end_seconds": 32.57,
      "duration_seconds": 3.04,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.27,
      "end_seconds": 34.36,
      "duration_seconds": 1.09,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.9,
      "end_seconds": 38.37,
      "duration_seconds": 2.47,
      "text": "Have you had poor sleep?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.89,
      "end_seconds": 48.0,
      "duration_seconds": 6.11,
      "text": "Yes, about the same, about a week. There's mood swings as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.32,
      "end_seconds": 53.6,
      "duration_seconds": 4.28,
      "text": "Right, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.37,
      "end_seconds": 62.44,
      "duration_seconds": 5.07,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.37,
      "end_seconds": 75.29,
      "duration_seconds": 2.92,
      "text": "Did you notice any very heavy bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.36,
      "end_seconds": 79.79,
      "duration_seconds": 2.43,
      "text": "No. No very heavy bleeding."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.64,
      "end_seconds": 85.89,
      "duration_seconds": 4.25,
      "text": "Any weight loss, pelvic pain or bleeding after sex?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.92,
      "end_seconds": 90.28,
      "duration_seconds": 2.36,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.68,
      "end_seconds": 95.31,
      "duration_seconds": 3.63,
      "text": "Alright, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.94,
      "end_seconds": 98.29,
      "duration_seconds": 1.35,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.12,
      "end_seconds": 102.43,
      "duration_seconds": 2.31,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 115.77,
      "duration_seconds": 11.63,
      "text": "I take bisoprolol, 2.5 milligrams, once a day for the heart rhythm. I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.03,
      "end_seconds": 121.39,
      "duration_seconds": 4.36,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.01,
      "end_seconds": 125.69,
      "duration_seconds": 2.68,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.4,
      "end_seconds": 139.46,
      "duration_seconds": 3.06,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.33,
      "end_seconds": 148.97,
      "duration_seconds": 7.64,
      "text": "I've had an irregular heartbeat for five years now. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.36,
      "end_seconds": 164.92,
      "duration_seconds": 11.56,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.39,
      "end_seconds": 170.23,
      "duration_seconds": 3.84,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.22,
      "end_seconds": 172.45,
      "duration_seconds": 1.23,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.04,
      "end_seconds": 175.56,
      "duration_seconds": 2.52,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.65,
      "end_seconds": 178.31,
      "duration_seconds": 1.66,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.15,
      "end_seconds": 183.18,
      "duration_seconds": 4.03,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.81,
      "end_seconds": 185.07,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.72,
      "end_seconds": 189.63,
      "duration_seconds": 2.91,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.37,
      "end_seconds": 192.8,
      "duration_seconds": 1.43,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.32,
      "end_seconds": 198.94,
      "duration_seconds": 4.62,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.37,
      "end_seconds": 202.72,
      "duration_seconds": 2.35,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.97,
      "end_seconds": 211.55,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.46,
      "end_seconds": 234.37,
      "duration_seconds": 6.91,
      "text": "Okay: saturation 99 percent, pulse is 82 beats a minute, pressure 110 over 69."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.49,
      "end_seconds": 236.91,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.51,
      "end_seconds": 241.2,
      "duration_seconds": 2.69,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 246.12,
      "duration_seconds": 2.77,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.67,
      "end_seconds": 248.68,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.9,
      "end_seconds": 252.33,
      "duration_seconds": 2.43,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.72,
      "end_seconds": 270.71,
      "duration_seconds": 3.99,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.44,
      "end_seconds": 282.24,
      "duration_seconds": 5.8,
      "text": "Please sit back down. Putting it all together, the most likely explanation is perimenopause."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.86,
      "end_seconds": 286.75,
      "duration_seconds": 2.89,
      "text": "Right, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.01,
      "end_seconds": 297.89,
      "duration_seconds": 6.88,
      "text": "It's reasonable to be concerned, but right now perimenopause is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.3,
      "end_seconds": 313.52,
      "duration_seconds": 4.22,
      "text": "I want a blood count done, that's for irregular periods."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.23,
      "end_seconds": 315.8,
      "duration_seconds": 1.57,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.01,
      "end_seconds": 339.09,
      "duration_seconds": 22.08,
      "text": "I want a thyroid test done, that's for hot flushes. I'm going to put you on estradiol gel, 1 pump, once a day, long term. It's for menopausal symptoms. Regular exercise, light layers and avoiding triggers can help. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.97,
      "end_seconds": 343.87,
      "duration_seconds": 3.9,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.82,
      "end_seconds": 347.27,
      "duration_seconds": 1.45,
      "text": "All the best."
    }
  ]
}