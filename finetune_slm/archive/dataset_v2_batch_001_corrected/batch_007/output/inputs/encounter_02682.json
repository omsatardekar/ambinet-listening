{
  "schema_version": "1.0",
  "encounter_id": "02682",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 6.07,
      "duration_seconds": 5.52,
      "text": "Hi, sit anywhere you like. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.85,
      "end_seconds": 13.51,
      "duration_seconds": 5.66,
      "text": "Sorry, what was I saying, I've been dealing with itchy blisters."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.28,
      "end_seconds": 18.74,
      "duration_seconds": 3.46,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.08,
      "end_seconds": 37.33,
      "duration_seconds": 17.25,
      "text": "Around one week... no wait, uh, it's more like two weeks. Uh, there's an itchy rash first as well. So, with itchy rash first, it just comes and goes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.05,
      "end_seconds": 40.45,
      "duration_seconds": 2.4,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.62,
      "end_seconds": 48.62,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.44,
      "end_seconds": 68.14,
      "duration_seconds": 7.7,
      "text": "Okay: temperature 36.9, blood pressure 112 over 70. And SpO2 99 percent on room air, heart rate 81."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.83,
      "end_seconds": 72.46,
      "duration_seconds": 3.63,
      "text": "I mean, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.44,
      "end_seconds": 75.89,
      "duration_seconds": 2.45,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.63,
      "end_seconds": 80.64,
      "duration_seconds": 2.01,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.73,
      "end_seconds": 83.29,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.39,
      "end_seconds": 107.07,
      "duration_seconds": 5.68,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.57,
      "end_seconds": 111.7,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 128.35,
      "duration_seconds": 3.8,
      "text": "Have you had any mouth sores or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.17,
      "end_seconds": 135.09,
      "duration_seconds": 4.92,
      "text": "Actually, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.86,
      "end_seconds": 144.72,
      "duration_seconds": 3.86,
      "text": "A few quick ones: eye problems or new medicine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.03,
      "end_seconds": 150.57,
      "duration_seconds": 4.54,
      "text": "Hmm, no, no eye problems or new medicine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.64,
      "end_seconds": 156.66,
      "duration_seconds": 4.02,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.2,
      "end_seconds": 159.87,
      "duration_seconds": 2.67,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.05,
      "end_seconds": 162.38,
      "duration_seconds": 1.33,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.43,
      "end_seconds": 166.25,
      "duration_seconds": 2.82,
      "text": "Oh, no, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.98,
      "end_seconds": 179.84,
      "duration_seconds": 4.86,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.73,
      "end_seconds": 186.98,
      "duration_seconds": 5.25,
      "text": "Sorry, what was I saying, I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.85,
      "end_seconds": 191.59,
      "duration_seconds": 2.74,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.48,
      "end_seconds": 211.11,
      "duration_seconds": 18.63,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. I do a yoga class on Thursdays. No, I share a house with my brother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.09,
      "end_seconds": 217.51,
      "duration_seconds": 4.42,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.23,
      "end_seconds": 226.59,
      "duration_seconds": 3.36,
      "text": "It's, It's metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.47,
      "end_seconds": 230.51,
      "duration_seconds": 2.04,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.12,
      "end_seconds": 257.54,
      "duration_seconds": 25.42,
      "text": "50 milligrams. Oh, uh, it's hydrocortisone cream, when needed for the eczema. I did try to ignore it for a while. I'm not great at remembering details, so bear with me. Before this I was on losartan; that's been stopped."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.43,
      "end_seconds": 262.33,
      "duration_seconds": 2.9,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.43,
      "end_seconds": 269.61,
      "duration_seconds": 5.18,
      "text": "I've, I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.59,
      "end_seconds": 271.45,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.27,
      "end_seconds": 278.13,
      "duration_seconds": 4.86,
      "text": "Uh, I have eczema, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.97,
      "end_seconds": 285.5,
      "duration_seconds": 5.53,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.36,
      "end_seconds": 301.14,
      "duration_seconds": 2.78,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.88,
      "end_seconds": 304.19,
      "duration_seconds": 1.31,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.36,
      "end_seconds": 309.66,
      "duration_seconds": 4.3,
      "text": "Having listened and examined, this is probably bullous pemphigoid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.5,
      "end_seconds": 316.5,
      "duration_seconds": 5.0,
      "text": "Ah, uh, is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.54,
      "end_seconds": 323.58,
      "duration_seconds": 6.04,
      "text": "Nothing I've seen today points to an emergency. It looks like bullous pemphigoid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.65,
      "end_seconds": 333.75,
      "duration_seconds": 5.1,
      "text": "Do I need blood tests? I read it might help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.41,
      "end_seconds": 348.11,
      "duration_seconds": 12.7,
      "text": "Alright, not right now, it wouldn't change what we do today. For now, no new medicines or tests are needed. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.55,
      "end_seconds": 353.36,
      "duration_seconds": 3.81,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.4,
      "end_seconds": 356.6,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
