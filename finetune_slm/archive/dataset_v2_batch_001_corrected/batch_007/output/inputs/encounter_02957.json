{
  "schema_version": "1.0",
  "encounter_id": "02957",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 5.54,
      "duration_seconds": 4.3,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 10.66,
      "duration_seconds": 4.53,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.39,
      "end_seconds": 17.78,
      "duration_seconds": 6.39,
      "text": "Erm, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.89,
      "end_seconds": 22.67,
      "duration_seconds": 3.78,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.52,
      "end_seconds": 27.26,
      "duration_seconds": 3.74,
      "text": "She's been having breathlessness building over weeks, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.12,
      "end_seconds": 31.85,
      "duration_seconds": 3.73,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.55,
      "end_seconds": 44.11,
      "duration_seconds": 7.56,
      "text": "It's been like this since last Tuesday. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.48,
      "end_seconds": 50.87,
      "duration_seconds": 5.39,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.71,
      "end_seconds": 54.68,
      "duration_seconds": 1.97,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.61,
      "end_seconds": 59.08,
      "duration_seconds": 3.47,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.0,
      "end_seconds": 62.23,
      "duration_seconds": 1.23,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.88,
      "end_seconds": 74.14,
      "duration_seconds": 6.26,
      "text": "What about a dull ache on one side of the chest, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.92,
      "end_seconds": 79.95,
      "duration_seconds": 4.03,
      "text": "Yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.6,
      "end_seconds": 86.91,
      "duration_seconds": 5.31,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.25,
      "end_seconds": 98.58,
      "duration_seconds": 8.33,
      "text": "I'd say on and off. A eight out of ten, I suppose. I've also had weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.91,
      "end_seconds": 117.54,
      "duration_seconds": 1.63,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.45,
      "end_seconds": 120.03,
      "duration_seconds": 1.58,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.74,
      "end_seconds": 121.99,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.49,
      "end_seconds": 126.92,
      "duration_seconds": 3.43,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.79,
      "end_seconds": 129.68,
      "duration_seconds": 1.89,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.31,
      "end_seconds": 135.22,
      "duration_seconds": 3.91,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.02,
      "end_seconds": 139.25,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.89,
      "end_seconds": 143.81,
      "duration_seconds": 2.92,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.03,
      "end_seconds": 148.91,
      "duration_seconds": 3.88,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.5,
      "end_seconds": 154.31,
      "duration_seconds": 4.81,
      "text": "I have low haemoglobin. I've got heart failure. Yes, diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.81,
      "end_seconds": 157.41,
      "duration_seconds": 1.6,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.08,
      "end_seconds": 160.67,
      "duration_seconds": 2.59,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 165.91,
      "duration_seconds": 3.9,
      "text": "Okay, go on. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.51,
      "end_seconds": 170.01,
      "duration_seconds": 2.5,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 175.16,
      "duration_seconds": 3.15,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.55,
      "end_seconds": 187.33,
      "duration_seconds": 10.78,
      "text": "I take iron tablets, once a day. It's, It's something called carv... carvedilol, 6.25 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.33,
      "end_seconds": 193.25,
      "duration_seconds": 4.92,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.01,
      "end_seconds": 211.7,
      "duration_seconds": 17.69,
      "text": "Not with me. I'll bring it next time. Sitagliptin. I take it 100 milligrams, once a day. I'm not great at remembering details, so bear with me. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.18,
      "end_seconds": 212.88,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.85,
      "end_seconds": 221.66,
      "duration_seconds": 6.81,
      "text": "Metoprolol. I take it 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 223.08,
      "end_seconds": 233.67,
      "duration_seconds": 10.59,
      "text": "Doctor, you know, I think the last prescription for the metoprolol was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.88,
      "end_seconds": 239.0,
      "duration_seconds": 4.12,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.54,
      "end_seconds": 244.63,
      "duration_seconds": 5.09,
      "text": "Right, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.26,
      "end_seconds": 249.32,
      "duration_seconds": 4.06,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.88,
      "end_seconds": 254.95,
      "duration_seconds": 5.07,
      "text": "My father had bowel cancer. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.94,
      "end_seconds": 258.37,
      "duration_seconds": 1.43,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.32,
      "end_seconds": 262.96,
      "duration_seconds": 2.64,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 264.15,
      "end_seconds": 269.03,
      "duration_seconds": 4.88,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.26,
      "end_seconds": 279.15,
      "duration_seconds": 6.89,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.82,
      "end_seconds": 289.66,
      "duration_seconds": 8.84,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any coughing up blood or night sweats at all?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.82,
      "end_seconds": 296.23,
      "duration_seconds": 5.41,
      "text": "So, I haven't had coughing up blood or night sweats, no."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.26,
      "end_seconds": 299.02,
      "duration_seconds": 1.76,
      "text": "What about leg swelling?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.84,
      "end_seconds": 304.01,
      "duration_seconds": 4.17,
      "text": "No, uh, I haven't had any leg swelling."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.08,
      "end_seconds": 308.65,
      "duration_seconds": 3.57,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.57,
      "end_seconds": 316.94,
      "duration_seconds": 6.37,
      "text": "My heart's been fine, you know, as far as I know."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.34,
      "end_seconds": 331.57,
      "duration_seconds": 4.23,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.05,
      "end_seconds": 346.3,
      "duration_seconds": 3.25,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.01,
      "end_seconds": 378.27,
      "duration_seconds": 12.26,
      "text": "Okay: temperature is 36.9 degrees, oxygen saturation is 93 percent, blood pressure 125 over 81, respiratory rate 24, pulse is 104 beats a minute."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.03,
      "end_seconds": 384.77,
      "duration_seconds": 3.74,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.63,
      "end_seconds": 386.9,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.94,
      "end_seconds": 404.78,
      "duration_seconds": 5.84,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.66,
      "end_seconds": 426.51,
      "duration_seconds": 15.85,
      "text": "That's the examination finished. Let me tell you where I've got to. I don't have a clear answer today: a pleural effusion needing a cause is possible, and so is heart failure."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.32,
      "end_seconds": 430.7,
      "duration_seconds": 2.38,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.23,
      "end_seconds": 439.17,
      "duration_seconds": 7.94,
      "text": "I can't promise yet, but most people with a pleural effusion needing a cause do well once it's treated properly."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.37,
      "end_seconds": 482.24,
      "duration_seconds": 26.87,
      "text": "A CT scan of the chest is what I'd like next, for pleural effusion. I'm going to order a chest X-ray, for breathlessness. I am arranging an urgent chest clinic review. A short walk every day, even twenty minutes, will help more than you'd think. I think the chest clinic should see you too."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 484.17,
      "end_seconds": 487.14,
      "duration_seconds": 2.97,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.81,
      "end_seconds": 499.33,
      "duration_seconds": 11.52,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 500.63,
      "end_seconds": 502.59,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 503.49,
      "end_seconds": 505.9,
      "duration_seconds": 2.41,
      "text": "Alright, have a good day."
    }
  ]
}