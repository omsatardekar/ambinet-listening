{
  "schema_version": "1.0",
  "encounter_id": "02574",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 5.8,
      "duration_seconds": 4.41,
      "text": "Good morning. I've just opened your notes. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.22,
      "end_seconds": 21.76,
      "duration_seconds": 14.54,
      "text": "Mainly a chesty cough for a week. There's a couple of other things, but that's the main one. I told my wife I'd come today. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.92,
      "end_seconds": 26.54,
      "duration_seconds": 3.62,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.19,
      "end_seconds": 30.47,
      "duration_seconds": 3.28,
      "text": "Um, it's been two days now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.13,
      "end_seconds": 35.64,
      "duration_seconds": 3.51,
      "text": "Okay, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.39,
      "end_seconds": 39.69,
      "duration_seconds": 3.3,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.36,
      "end_seconds": 47.93,
      "duration_seconds": 7.57,
      "text": "Let me check a few things. Any coughing up blood, fever, chest pain or breathlessness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.89,
      "end_seconds": 51.3,
      "duration_seconds": 2.41,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.99,
      "end_seconds": 55.61,
      "duration_seconds": 2.62,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.2,
      "end_seconds": 63.63,
      "duration_seconds": 3.43,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.32,
      "end_seconds": 84.93,
      "duration_seconds": 3.61,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.81,
      "end_seconds": 90.07,
      "duration_seconds": 3.26,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.9,
      "end_seconds": 107.05,
      "duration_seconds": 5.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.08,
      "end_seconds": 112.28,
      "duration_seconds": 4.2,
      "text": "It's, It's honey and lemon, at night."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.48,
      "end_seconds": 117.8,
      "duration_seconds": 4.32,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.01,
      "end_seconds": 120.61,
      "duration_seconds": 1.6,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.8,
      "end_seconds": 140.37,
      "duration_seconds": 2.57,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.88,
      "end_seconds": 145.59,
      "duration_seconds": 3.71,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.92,
      "end_seconds": 149.31,
      "duration_seconds": 2.39,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.52,
      "end_seconds": 154.43,
      "duration_seconds": 3.91,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.59,
      "end_seconds": 157.02,
      "duration_seconds": 1.43,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.25,
      "end_seconds": 161.54,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.83,
      "end_seconds": 165.24,
      "duration_seconds": 2.41,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.71,
      "end_seconds": 172.68,
      "duration_seconds": 5.97,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.72,
      "end_seconds": 179.88,
      "duration_seconds": 3.16,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.2,
      "end_seconds": 183.61,
      "duration_seconds": 2.41,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.2,
      "end_seconds": 187.17,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.52,
      "end_seconds": 202.12,
      "duration_seconds": 3.6,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.87,
      "end_seconds": 219.92,
      "duration_seconds": 8.05,
      "text": "Okay: BP is 123 over 68, saturation 99 percent. And temp 36.8 degrees, respiratory rate 18, pulse 74."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.59,
      "end_seconds": 224.92,
      "duration_seconds": 3.33,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.14,
      "end_seconds": 228.38,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.5,
      "end_seconds": 250.49,
      "duration_seconds": 3.99,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 263.2,
      "duration_seconds": 8.56,
      "text": "You can sit up now. From what you've told me and what I found, this is probably acute viral bronchitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.96,
      "end_seconds": 268.12,
      "duration_seconds": 3.16,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.23,
      "end_seconds": 274.75,
      "duration_seconds": 5.52,
      "text": "Nothing I've seen today points to an emergency. It looks like acute viral bronchitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.65,
      "end_seconds": 317.37,
      "duration_seconds": 30.72,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please don't wait if you get a fever or breathlessness. That's when to be seen urgently. I'd like to see you again if not better in three weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.09,
      "end_seconds": 320.31,
      "duration_seconds": 2.22,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.91,
      "end_seconds": 325.61,
      "duration_seconds": 1.7,
      "text": "So, look after yourself."
    }
  ]
}