{
  "schema_version": "1.0",
  "encounter_id": "02639",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.39,
      "end_seconds": 6.93,
      "duration_seconds": 5.54,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.82,
      "end_seconds": 12.26,
      "duration_seconds": 4.44,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.11,
      "end_seconds": 20.55,
      "duration_seconds": 5.44,
      "text": "Actually, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.81,
      "end_seconds": 24.59,
      "duration_seconds": 2.78,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.38,
      "end_seconds": 31.75,
      "duration_seconds": 6.37,
      "text": "It's poor concentration, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 32.9,
      "end_seconds": 37.49,
      "duration_seconds": 4.59,
      "text": "Here are the numbers, doctor. Pressure 117 over 68, heart rate 84."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.08,
      "end_seconds": 42.58,
      "duration_seconds": 3.5,
      "text": "Thanks. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.59,
      "end_seconds": 44.61,
      "duration_seconds": 1.02,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.23,
      "end_seconds": 47.36,
      "duration_seconds": 2.13,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.72,
      "end_seconds": 55.84,
      "duration_seconds": 7.12,
      "text": "It usually comes with tender spots. Ah, I've been waking unrefreshed too, since Monday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.47,
      "end_seconds": 61.86,
      "duration_seconds": 2.39,
      "text": "Have you had aching all over?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.88,
      "end_seconds": 85.96,
      "duration_seconds": 23.08,
      "text": "Ah, yes, for four weeks. About aching all over, maybe a eight out of ten on a bad day. Ah, as for tender spots, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.89,
      "end_seconds": 90.04,
      "duration_seconds": 2.15,
      "text": "Have you had any rash?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.82,
      "end_seconds": 95.36,
      "duration_seconds": 4.54,
      "text": "Erm, not that I've noticed, no rash."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.27,
      "end_seconds": 99.92,
      "duration_seconds": 3.65,
      "text": "Any joint swelling, fever or weight loss at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.15,
      "end_seconds": 103.62,
      "duration_seconds": 2.47,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.33,
      "end_seconds": 108.69,
      "duration_seconds": 3.36,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.71,
      "end_seconds": 112.83,
      "duration_seconds": 3.12,
      "text": "Erm, no, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.9,
      "end_seconds": 115.91,
      "duration_seconds": 2.01,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.71,
      "end_seconds": 117.76,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.6,
      "end_seconds": 122.29,
      "duration_seconds": 2.69,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.87,
      "end_seconds": 137.19,
      "duration_seconds": 13.32,
      "text": "Not much, I mostly stay in these days. Yes, I work in a bakery, early starts. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.05,
      "end_seconds": 155.42,
      "duration_seconds": 4.37,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.65,
      "end_seconds": 166.41,
      "duration_seconds": 9.76,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.96,
      "end_seconds": 183.71,
      "duration_seconds": 2.75,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.23,
      "end_seconds": 188.15,
      "duration_seconds": 2.92,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.34,
      "end_seconds": 207.2,
      "duration_seconds": 2.86,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.73,
      "end_seconds": 217.95,
      "duration_seconds": 5.22,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.62,
      "end_seconds": 221.98,
      "duration_seconds": 2.36,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.0,
      "end_seconds": 230.32,
      "duration_seconds": 7.32,
      "text": "Paracetamol. I take it 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 232.02,
      "end_seconds": 241.74,
      "duration_seconds": 9.72,
      "text": "Doctor, I think the last prescription for the paracetamol was 1300 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.68,
      "end_seconds": 246.72,
      "duration_seconds": 4.04,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.69,
      "end_seconds": 263.44,
      "duration_seconds": 15.75,
      "text": "Not with me. I'll bring it next time. Mm, I'm on gliclazide, 80 milligrams, twice a day. I mean, I'm on metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.14,
      "end_seconds": 269.36,
      "duration_seconds": 4.22,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.35,
      "end_seconds": 281.65,
      "duration_seconds": 10.3,
      "text": "Arthritis in my knees, for about ten years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.3,
      "end_seconds": 283.0,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.97,
      "end_seconds": 287.15,
      "duration_seconds": 2.18,
      "text": "Diabetes, for five years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.27,
      "end_seconds": 290.85,
      "duration_seconds": 2.58,
      "text": "So, is there anything more?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 292.69,
      "end_seconds": 295.57,
      "duration_seconds": 2.88,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.19,
      "end_seconds": 301.98,
      "duration_seconds": 3.79,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.93,
      "end_seconds": 305.29,
      "duration_seconds": 2.36,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.05,
      "end_seconds": 328.26,
      "duration_seconds": 6.21,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.56,
      "end_seconds": 343.12,
      "duration_seconds": 9.56,
      "text": "So, all finished, thank you. Let me tell you where I've got to. It fits best with fibromyalgia. I can't rule out polymyalgia yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 347.14,
      "end_seconds": 350.37,
      "duration_seconds": 3.23,
      "text": "Right, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.44,
      "end_seconds": 366.98,
      "duration_seconds": 15.54,
      "text": "I understand the worry. At the moment I'd say it's fibromyalgia, and we'll watch how it goes. Just to be sure I understood. You've had poor concentration, mild, and no rash or weight loss."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.67,
      "end_seconds": 374.46,
      "duration_seconds": 2.79,
      "text": "Actually, yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.23,
      "end_seconds": 391.16,
      "duration_seconds": 14.93,
      "text": "Gentle graded exercise such as swimming helps more than rest. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 393.19,
      "end_seconds": 397.18,
      "duration_seconds": 3.99,
      "text": "Uh, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.63,
      "end_seconds": 406.86,
      "duration_seconds": 7.23,
      "text": "Please come and see me in six weeks. Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.57,
      "end_seconds": 409.79,
      "duration_seconds": 2.22,
      "text": "Alright, thanks, take care."
    }
  ]
}