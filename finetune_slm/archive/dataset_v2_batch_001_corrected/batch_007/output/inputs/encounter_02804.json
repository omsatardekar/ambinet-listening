{
  "schema_version": "1.0",
  "encounter_id": "02804",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.56,
      "duration_seconds": 3.55,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 9.65,
      "duration_seconds": 3.94,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.7,
      "end_seconds": 14.92,
      "duration_seconds": 3.22,
      "text": "It's my heart suddenly racing, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.97,
      "end_seconds": 20.26,
      "duration_seconds": 3.29,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.61,
      "end_seconds": 33.48,
      "duration_seconds": 11.87,
      "text": "Yeah, it's been like this since Friday. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.11,
      "end_seconds": 36.27,
      "duration_seconds": 2.16,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.35,
      "end_seconds": 40.73,
      "duration_seconds": 3.38,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.48,
      "end_seconds": 44.34,
      "duration_seconds": 2.86,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.99,
      "end_seconds": 57.1,
      "duration_seconds": 9.11,
      "text": "It, It usually comes with a pounding in my neck. About pounding in my neck, I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.17,
      "end_seconds": 67.4,
      "duration_seconds": 4.23,
      "text": "And family history of sudden death, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.18,
      "end_seconds": 73.09,
      "duration_seconds": 3.91,
      "text": "Definitely no family history of sudden death."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.15,
      "end_seconds": 77.06,
      "duration_seconds": 2.91,
      "text": "Alright, have you noticed fainting or breathlessness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.92,
      "end_seconds": 81.56,
      "duration_seconds": 2.64,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.9,
      "end_seconds": 88.98,
      "duration_seconds": 3.08,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.56,
      "end_seconds": 93.31,
      "duration_seconds": 3.75,
      "text": "Nothing on the skin, um, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.48,
      "end_seconds": 100.8,
      "duration_seconds": 3.32,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.07,
      "end_seconds": 103.54,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.6,
      "end_seconds": 112.03,
      "duration_seconds": 7.43,
      "text": "Can you list what you take, tablets, creams or inhalers? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.74,
      "end_seconds": 124.36,
      "duration_seconds": 10.62,
      "text": "I take bisoprolol, 2.5 milligrams, once a day. I take clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.38,
      "end_seconds": 135.23,
      "duration_seconds": 2.85,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.06,
      "end_seconds": 139.5,
      "duration_seconds": 2.44,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.65,
      "end_seconds": 154.64,
      "duration_seconds": 3.99,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.83,
      "end_seconds": 165.03,
      "duration_seconds": 8.2,
      "text": "I walk the dog every morning. My partner and our baby. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.37,
      "end_seconds": 169.33,
      "duration_seconds": 2.96,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.02,
      "end_seconds": 176.65,
      "duration_seconds": 6.63,
      "text": "I have an irregular heartbeat, for five years. I have heart disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.22,
      "end_seconds": 184.79,
      "duration_seconds": 7.57,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.18,
      "end_seconds": 203.39,
      "duration_seconds": 4.21,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.95,
      "end_seconds": 209.02,
      "duration_seconds": 4.07,
      "text": "Well, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 214.53,
      "duration_seconds": 3.64,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.99,
      "end_seconds": 218.07,
      "duration_seconds": 2.08,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.59,
      "end_seconds": 235.22,
      "duration_seconds": 3.63,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.16,
      "end_seconds": 242.55,
      "duration_seconds": 2.39,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 270.12,
      "duration_seconds": 14.8,
      "text": "Okay, so my impression is this: It fits best with episodes of supraventricular tachycardia. Just to be sure I understood. You've had your heart suddenly racing, since Friday, and no family history of sudden death or fainting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.57,
      "end_seconds": 276.57,
      "duration_seconds": 2.0,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.03,
      "end_seconds": 293.33,
      "duration_seconds": 15.3,
      "text": "Let's get an ECG, for palpitations. I'm sending you for a thyroid test because of palpitations. Try blowing hard against a closed mouth and nose when it starts. I'm going to send a referral to the cardiology clinic."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.04,
      "end_seconds": 295.68,
      "duration_seconds": 1.64,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.24,
      "end_seconds": 299.07,
      "duration_seconds": 2.83,
      "text": "I'll want another look after the monitor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.63,
      "end_seconds": 301.68,
      "duration_seconds": 2.05,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.51,
      "end_seconds": 307.11,
      "duration_seconds": 3.6,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.57,
      "end_seconds": 314.36,
      "duration_seconds": 2.79,
      "text": "Right, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.93,
      "end_seconds": 316.19,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}