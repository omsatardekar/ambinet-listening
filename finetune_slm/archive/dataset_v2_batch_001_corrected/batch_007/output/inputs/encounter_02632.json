      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.27,
      "end_seconds": 17.15,
      "duration_seconds": 3.88,
      "text": "I mean, doctor, thank you for seeing us."
