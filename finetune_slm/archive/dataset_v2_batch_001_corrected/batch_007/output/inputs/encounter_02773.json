{
  "schema_version": "1.0",
  "encounter_id": "02773",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 4.4,
      "duration_seconds": 3.78,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 12.09,
      "duration_seconds": 5.24,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.64,
      "end_seconds": 19.92,
      "duration_seconds": 6.28,
      "text": "Well, I've been having severe tummy pain out of proportion to the examination."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.77,
      "end_seconds": 24.51,
      "duration_seconds": 2.74,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.75,
      "end_seconds": 31.91,
      "duration_seconds": 6.16,
      "text": "About a week, I think... sorry, two weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.62,
      "end_seconds": 38.41,
      "duration_seconds": 4.79,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.42,
      "end_seconds": 45.03,
      "duration_seconds": 4.61,
      "text": "it happens every other day. There's bloody diarrhoea as well"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.54,
      "end_seconds": 49.3,
      "duration_seconds": 3.76,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.16,
      "end_seconds": 62.62,
      "duration_seconds": 2.46,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.81,
      "end_seconds": 83.11,
      "duration_seconds": 8.3,
      "text": "okay: pulse 124, SpO2 98 percent on room air, temp 36.9 degrees, blood pressure 118 over 72."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.65,
      "end_seconds": 85.69,
      "duration_seconds": 2.04,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.21,
      "end_seconds": 89.86,
      "duration_seconds": 2.65,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.0,
      "end_seconds": 94.04,
      "duration_seconds": 2.04,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.35,
      "end_seconds": 97.41,
      "duration_seconds": 2.06,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.53,
      "end_seconds": 118.13,
      "duration_seconds": 10.6,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.11,
      "end_seconds": 125.71,
      "duration_seconds": 2.6,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.47,
      "end_seconds": 147.35,
      "duration_seconds": 3.88,
      "text": "and what about hernia, fever or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.68,
      "end_seconds": 153.23,
      "duration_seconds": 4.55,
      "text": "I haven't had hernia, fever or chest pain, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.86,
      "end_seconds": 156.11,
      "duration_seconds": 2.25,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.44,
      "end_seconds": 159.03,
      "duration_seconds": 1.59,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.98,
      "end_seconds": 179.51,
      "duration_seconds": 3.53,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.73,
      "end_seconds": 183.33,
      "duration_seconds": 2.6,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.84,
      "end_seconds": 188.48,
      "duration_seconds": 3.64,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.15,
      "end_seconds": 194.46,
      "duration_seconds": 5.31,
      "text": "It's a blood thinner, 5 milligrams, stopped last month."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.9,
      "end_seconds": 195.6,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.14,
      "end_seconds": 205.43,
      "duration_seconds": 2.29,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.2,
      "end_seconds": 208.79,
      "duration_seconds": 2.59,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.37,
      "end_seconds": 211.21,
      "duration_seconds": 1.84,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.82,
      "end_seconds": 216.33,
      "duration_seconds": 4.51,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.77,
      "end_seconds": 221.84,
      "duration_seconds": 4.07,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.62,
      "end_seconds": 225.8,
      "duration_seconds": 2.18,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.57,
      "end_seconds": 240.97,
      "duration_seconds": 14.4,
      "text": "From what you've told me and what I found, the most likely explanation is possible bowel ischaemia. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.08,
      "end_seconds": 247.65,
      "duration_seconds": 3.57,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.72,
      "end_seconds": 256.32,
      "duration_seconds": 7.6,
      "text": "It's reasonable to be concerned, but right now possible bowel ischaemia is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.7,
      "end_seconds": 298.25,
      "duration_seconds": 23.55,
      "text": "I think an urgent CT angiogram makes sense here, for possible bowel ischaemia. This is an emergency, you are going to hospital now. I'll want another look straight away. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.89,
      "end_seconds": 303.98,
      "duration_seconds": 5.09,
      "text": "so, I come back straight away is that that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.94,
      "end_seconds": 311.82,
      "duration_seconds": 5.88,
      "text": "yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.58,
      "end_seconds": 319.52,
      "duration_seconds": 3.94,
      "text": "Hmm, I think I understand everything. Thanks."
    }
  ]
}