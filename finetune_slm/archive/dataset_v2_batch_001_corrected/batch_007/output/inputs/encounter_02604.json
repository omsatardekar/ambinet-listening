  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 3.37,
      "duration_seconds": 2.49,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.2,
      "end_seconds": 8.93,
      "duration_seconds": 4.73,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.69,
      "end_seconds": 13.49,
      "duration_seconds": 2.8,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.35,
      "end_seconds": 17.31,
      "duration_seconds": 2.96,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.75,
      "end_seconds": 21.45,
      "duration_seconds": 2.7,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.64,
      "end_seconds": 31.25,
      "duration_seconds": 8.61,
      "text": "It's bright red blood on the paper. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.96,
      "end_seconds": 36.34,
      "duration_seconds": 3.38,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.77,
      "end_seconds": 47.59,
      "duration_seconds": 9.82,
      "text": "Around two weeks... no wait, it's more like three weeks. Oh, and a lump around the back passage."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.49,
      "end_seconds": 52.09,
      "duration_seconds": 3.6,
      "text": "Okay, what about itching, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.44,
      "end_seconds": 55.45,
      "duration_seconds": 2.01,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.22,
      "end_seconds": 63.96,
      "duration_seconds": 3.74,
      "text": "Any black stools, tummy pain or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.77,
      "end_seconds": 66.71,
      "duration_seconds": 1.94,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.71,
      "end_seconds": 69.94,
      "duration_seconds": 2.23,
      "text": "Any change in bowel habit?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.84,
      "end_seconds": 73.91,
      "duration_seconds": 3.07,
      "text": "No, no change in bowel habit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.67,
      "end_seconds": 80.77,
      "duration_seconds": 5.1,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.34,
      "end_seconds": 84.55,
      "duration_seconds": 2.21,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.24,
      "end_seconds": 89.22,
      "duration_seconds": 2.98,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.81,
      "end_seconds": 91.9,
      "duration_seconds": 1.09,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.52,
      "end_seconds": 108.08,
      "duration_seconds": 3.56,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.14,
      "end_seconds": 117.17,
      "duration_seconds": 8.03,
      "text": "Years back I got a rash from erythromycin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.93,
      "end_seconds": 121.48,
      "duration_seconds": 2.55,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.39,
      "end_seconds": 134.05,
      "duration_seconds": 10.66,
      "text": "My partner and our baby. I'm vegetarian and have been for years. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.35,
      "end_seconds": 138.31,
      "duration_seconds": 2.96,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.49,
      "end_seconds": 141.96,
      "duration_seconds": 2.47,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.87,
      "end_seconds": 163.86,
      "duration_seconds": 3.99,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.62,
      "end_seconds": 170.25,
      "duration_seconds": 2.63,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.01,
      "end_seconds": 173.74,
      "duration_seconds": 2.73,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.22,
      "end_seconds": 188.42,
      "duration_seconds": 2.2,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.35,
      "end_seconds": 219.33,
      "duration_seconds": 8.98,
      "text": "Okay: oxygen saturation is 97 percent, pulse is 81 beats a minute, temperature is 36.9 degrees, pressure 123 over 71."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.05,
      "end_seconds": 221.43,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.73,
      "end_seconds": 225.5,
      "duration_seconds": 2.77,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.58,
      "end_seconds": 230.44,
      "duration_seconds": 2.86,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.51,
      "end_seconds": 233.4,
      "duration_seconds": 1.89,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.95,
      "end_seconds": 249.07,
      "duration_seconds": 8.12,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.81,
      "end_seconds": 256.34,
      "duration_seconds": 2.53,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.1,
      "end_seconds": 275.94,
      "duration_seconds": 10.84,
      "text": "Okay, thinking it through, this is probably haemorrhoids. I can't rule out an anal fissure yet. I'm sending you for a blood count because of rectal bleeding."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.76,
      "end_seconds": 281.27,
      "duration_seconds": 1.51,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.51,
      "end_seconds": 300.74,
      "duration_seconds": 18.23,
      "text": "We'll begin with a haemorrhoid cream, 1 application, twice a day, one week. That should help with haemorrhoids. The pharmacy will go through the details again when you pick it up. Eat more fibre and drink water. See me again in four weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.63,
      "end_seconds": 304.54,
      "duration_seconds": 1.91,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.06,
      "end_seconds": 307.55,
      "duration_seconds": 2.49,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.53,
      "end_seconds": 311.56,
      "duration_seconds": 3.03,
      "text": "I think I understand everything. Thanks."
    }
  ]
}