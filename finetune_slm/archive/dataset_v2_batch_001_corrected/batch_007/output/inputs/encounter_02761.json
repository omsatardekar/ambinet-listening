{
  "schema_version": "1.0",
  "encounter_id": "02761",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.26,
      "end_seconds": 7.62,
      "duration_seconds": 6.36,
      "text": "okay doctor we're all set in here. I'll give you the numbers when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 12.65,
      "duration_seconds": 3.89,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.16,
      "end_seconds": 23.64,
      "duration_seconds": 10.48,
      "text": "Hello doctor I came in with them if that's okay. We came because of bright red blood on the paper."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.58,
      "end_seconds": 26.98,
      "duration_seconds": 2.4,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.23,
      "end_seconds": 32.98,
      "duration_seconds": 4.75,
      "text": "Itching goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 38.27,
      "duration_seconds": 3.62,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 40.64,
      "end_seconds": 46.8,
      "duration_seconds": 6.16,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.9,
      "end_seconds": 52.97,
      "duration_seconds": 5.07,
      "text": "take your time mild moderate or severe if you had to pick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.18,
      "end_seconds": 60.03,
      "duration_seconds": 1.85,
      "text": "I'd call it severe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 61.13,
      "end_seconds": 65.02,
      "duration_seconds": 3.89,
      "text": "yes that's right that's how it was"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.66,
      "end_seconds": 67.92,
      "duration_seconds": 2.26,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.4,
      "end_seconds": 74.25,
      "duration_seconds": 4.85,
      "text": "yes, I had a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.21,
      "end_seconds": 77.27,
      "duration_seconds": 2.06,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.56,
      "end_seconds": 87.32,
      "duration_seconds": 7.76,
      "text": "it's a... um, I can't remember what it's called it's a round yellow one"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.11,
      "end_seconds": 91.64,
      "duration_seconds": 2.53,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.56,
      "end_seconds": 109.04,
      "duration_seconds": 15.48,
      "text": "for the blood thinning I believe my husband sets them out for me I just take what I'm given i'm on metoprolol 50 milligrams maybe twice a day for my heart"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 115.14,
      "duration_seconds": 4.24,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.08,
      "end_seconds": 125.2,
      "duration_seconds": 8.12,
      "text": "ah, not with me. I'll bring it next time. I'm on lansoprazole, 30 milligrams, before breakfast"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 126.66,
      "end_seconds": 133.75,
      "duration_seconds": 7.09,
      "text": "It's meant to be before breakfast, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 134.81,
      "end_seconds": 138.95,
      "duration_seconds": 4.14,
      "text": "before this I was on clopidogrel; that's been stopped"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.99,
      "end_seconds": 143.12,
      "duration_seconds": 3.13,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.86,
      "end_seconds": 149.03,
      "duration_seconds": 5.17,
      "text": "my cousin has psoriasis my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.75,
      "end_seconds": 153.1,
      "duration_seconds": 2.35,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.68,
      "end_seconds": 167.62,
      "duration_seconds": 12.94,
      "text": "Yes, an irregular heartbeat. I've got anxiety. I've had heart disease for nearly five years now. I have acid reflux, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.74,
      "end_seconds": 176.42,
      "duration_seconds": 7.68,
      "text": "Yes, acid reflux is known to us, good to to have that clear. So, what about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.27,
      "end_seconds": 182.52,
      "duration_seconds": 4.25,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.73,
      "end_seconds": 185.57,
      "duration_seconds": 1.84,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.67,
      "end_seconds": 189.43,
      "duration_seconds": 2.76,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.65,
      "end_seconds": 209.58,
      "duration_seconds": 4.93,
      "text": "so, any tummy pain, black stools or change in bowel habit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.2,
      "end_seconds": 225.02,
      "duration_seconds": 14.82,
      "text": "Ah no no tummy pain no black stools no change in bowel habit. I did have a lump around the back passage at one point but that went away on its own."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.45,
      "end_seconds": 230.88,
      "duration_seconds": 2.43,
      "text": "okay, nothing like weight loss?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.45,
      "end_seconds": 233.31,
      "duration_seconds": 1.86,
      "text": "definitely no weight loss"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.21,
      "end_seconds": 237.23,
      "duration_seconds": 3.02,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.28,
      "end_seconds": 239.88,
      "duration_seconds": 1.6,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.86,
      "end_seconds": 245.17,
      "duration_seconds": 3.31,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.01,
      "end_seconds": 247.5,
      "duration_seconds": 1.49,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 248.11,
      "end_seconds": 258.05,
      "duration_seconds": 9.94,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 98 percent, pulse is 79 beats a minute, temperature 36.5, BP is 116 over 77."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.68,
      "end_seconds": 259.38,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.65,
      "end_seconds": 264.89,
      "duration_seconds": 4.24,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.88,
      "end_seconds": 268.14,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 289.7,
      "duration_seconds": 8.07,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.65,
      "end_seconds": 296.54,
      "duration_seconds": 2.89,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.95,
      "end_seconds": 320.15,
      "duration_seconds": 8.2,
      "text": "okay, so my impression is this: The most likely explanation is haemorrhoids an anal fissure is also on my list"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.02,
      "end_seconds": 326.13,
      "duration_seconds": 3.11,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.77,
      "end_seconds": 351.17,
      "duration_seconds": 20.4,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll watch how it goes. Eat more fibre and drink water. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 352.94,
      "end_seconds": 356.17,
      "duration_seconds": 3.23,
      "text": "okay, I'll look out for that"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.26,
      "end_seconds": 363.83,
      "duration_seconds": 6.57,
      "text": "I'll want another look in four weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.75,
      "end_seconds": 367.75,
      "duration_seconds": 3.0,
      "text": "I think I understand everything. Thanks."
    }
  ]
}