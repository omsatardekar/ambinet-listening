{
  "schema_version": "1.0",
  "encounter_id": "02668",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.12,
      "end_seconds": 5.88,
      "duration_seconds": 4.76,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 11.0,
      "duration_seconds": 4.05,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.7,
      "end_seconds": 20.07,
      "duration_seconds": 8.37,
      "text": "Okay, so doctor, it's a blocked nose for months. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.65,
      "end_seconds": 23.79,
      "duration_seconds": 3.14,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.74,
      "end_seconds": 26.72,
      "duration_seconds": 0.98,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.38,
      "end_seconds": 30.79,
      "duration_seconds": 2.41,
      "text": "Have you had a postnasal drip?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.71,
      "end_seconds": 35.27,
      "duration_seconds": 3.56,
      "text": "Uh, yes, for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.86,
      "end_seconds": 39.4,
      "duration_seconds": 3.54,
      "text": "A few quick ones: fever or vision changes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.02,
      "end_seconds": 42.92,
      "duration_seconds": 2.9,
      "text": "Erm, none of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.07,
      "end_seconds": 46.84,
      "duration_seconds": 2.77,
      "text": "Any facial swelling or nosebleeds at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.42,
      "end_seconds": 49.86,
      "duration_seconds": 2.44,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.76,
      "end_seconds": 53.97,
      "duration_seconds": 2.21,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.36,
      "end_seconds": 56.28,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.24,
      "end_seconds": 62.1,
      "duration_seconds": 3.86,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.03,
      "end_seconds": 66.05,
      "duration_seconds": 2.02,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.68,
      "end_seconds": 69.21,
      "duration_seconds": 2.53,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.94,
      "end_seconds": 76.48,
      "duration_seconds": 5.54,
      "text": "Asthma, for two years. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.73,
      "end_seconds": 81.08,
      "duration_seconds": 3.35,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.71,
      "end_seconds": 89.44,
      "duration_seconds": 7.73,
      "text": "I'm on Seretide inhaler, twice a day. It's saline spray, three times a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.4,
      "end_seconds": 109.83,
      "duration_seconds": 5.43,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.47,
      "end_seconds": 113.48,
      "duration_seconds": 3.01,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.86,
      "end_seconds": 123.31,
      "duration_seconds": 2.45,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.36,
      "end_seconds": 138.54,
      "duration_seconds": 13.18,
      "text": "I do a yoga class on Thursdays. My husband and I live above the shop. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 139.44,
      "end_seconds": 149.24,
      "duration_seconds": 9.8,
      "text": "Okay, so the vitals from earlier. Temperature 36.8, oxygen saturation is 97 percent, pulse 75, BP is 116 over 76."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.56,
      "end_seconds": 155.26,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.98,
      "end_seconds": 160.75,
      "duration_seconds": 3.77,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.6,
      "end_seconds": 181.22,
      "duration_seconds": 1.62,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.19,
      "end_seconds": 183.57,
      "duration_seconds": 1.38,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.63,
      "end_seconds": 199.04,
      "duration_seconds": 3.41,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.67,
      "end_seconds": 211.24,
      "duration_seconds": 8.57,
      "text": "That's all I needed to check. Having listened and examined, this looks most like nasal polyps. Chronic sinusitis is still possible."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.84,
      "end_seconds": 216.14,
      "duration_seconds": 4.3,
      "text": "Hmm, is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.99,
      "end_seconds": 233.77,
      "duration_seconds": 15.78,
      "text": "Nothing I've seen today points to an emergency. It looks like nasal polyps, but I'd like to confirm. Just to be sure I understood. You've had a blocked nose for months, severe, and no nosebleeds or facial swelling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 234.66,
      "end_seconds": 235.36,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.37,
      "end_seconds": 240.93,
      "duration_seconds": 3.56,
      "text": "We should do a nasal endoscopy for nasal obstruction."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.68,
      "end_seconds": 242.76,
      "duration_seconds": 1.08,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.41,
      "end_seconds": 255.72,
      "duration_seconds": 11.31,
      "text": "What I'm giving you is mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for nasal polyps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.54,
      "end_seconds": 260.84,
      "duration_seconds": 4.3,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.78,
      "end_seconds": 268.84,
      "duration_seconds": 6.06,
      "text": "Rinse with saline and use the spray daily. Come back in eight weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 270.09,
      "end_seconds": 272.31,
      "duration_seconds": 2.22,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.79,
      "end_seconds": 279.74,
      "duration_seconds": 5.95,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 281.64,
      "end_seconds": 293.59,
      "duration_seconds": 11.95,
      "text": "So, I take the mometasone nasal spray, 50 micrograms, two sprays each side once a day and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.58,
      "end_seconds": 298.59,
      "duration_seconds": 4.01,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.83,
      "end_seconds": 301.91,
      "duration_seconds": 2.08,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.83,
      "end_seconds": 305.29,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}