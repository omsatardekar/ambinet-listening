{
  "schema_version": "1.0",
  "encounter_id": "02695",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 5.09,
      "duration_seconds": 4.11,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.39,
      "end_seconds": 10.59,
      "duration_seconds": 4.2,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.63,
      "end_seconds": 17.2,
      "duration_seconds": 5.57,
      "text": "Let me think, I've been dealing with chest tightness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 27.32,
      "duration_seconds": 5.42,
      "text": "Did it come on recently? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.35,
      "end_seconds": 30.92,
      "duration_seconds": 1.57,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.87,
      "end_seconds": 34.69,
      "duration_seconds": 1.82,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.26,
      "end_seconds": 50.54,
      "duration_seconds": 15.28,
      "text": "It's worse with exertion. Oh, and being very breathless. That's been about the same, about three months. About being very breathless, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.4,
      "end_seconds": 55.14,
      "duration_seconds": 3.74,
      "text": "Have you had any fever, cough or leg pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.87,
      "end_seconds": 60.07,
      "duration_seconds": 4.2,
      "text": "Uh, no, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.87,
      "end_seconds": 65.25,
      "duration_seconds": 4.38,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.18,
      "end_seconds": 72.2,
      "duration_seconds": 3.02,
      "text": "Uh, no, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.97,
      "end_seconds": 84.6,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.02,
      "end_seconds": 89.82,
      "duration_seconds": 3.8,
      "text": "Yes, erythromycin, it gives me a rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.71,
      "end_seconds": 101.17,
      "duration_seconds": 3.46,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 108.48,
      "duration_seconds": 6.21,
      "text": "Yes, uh, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.43,
      "end_seconds": 111.11,
      "duration_seconds": 1.68,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.35,
      "end_seconds": 118.48,
      "duration_seconds": 6.13,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.33,
      "end_seconds": 121.65,
      "duration_seconds": 1.32,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.73,
      "end_seconds": 126.75,
      "duration_seconds": 3.02,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.83,
      "end_seconds": 130.85,
      "duration_seconds": 3.02,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.07,
      "end_seconds": 135.44,
      "duration_seconds": 3.37,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.79,
      "end_seconds": 138.09,
      "duration_seconds": 1.3,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.75,
      "end_seconds": 143.77,
      "duration_seconds": 4.02,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.47,
      "end_seconds": 150.29,
      "duration_seconds": 4.82,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.35,
      "end_seconds": 157.37,
      "duration_seconds": 3.02,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 162.17,
      "duration_seconds": 3.71,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.81,
      "end_seconds": 165.54,
      "duration_seconds": 2.73,
      "text": "Right, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.41,
      "end_seconds": 174.97,
      "duration_seconds": 7.56,
      "text": "Alright, diabetes, that matches what I have here. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.59,
      "end_seconds": 178.82,
      "duration_seconds": 3.23,
      "text": "Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 180.63,
      "duration_seconds": 1.44,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 198.55,
      "end_seconds": 207.76,
      "duration_seconds": 9.21,
      "text": "Here are the numbers, doctor. Blood pressure 131 over 88, pulse is 89 beats a minute, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.7,
      "end_seconds": 210.25,
      "duration_seconds": 1.55,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.52,
      "end_seconds": 216.96,
      "duration_seconds": 5.44,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.26,
      "end_seconds": 219.35,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.74,
      "end_seconds": 223.15,
      "duration_seconds": 2.41,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.59,
      "end_seconds": 242.99,
      "duration_seconds": 5.4,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.48,
      "end_seconds": 258.87,
      "duration_seconds": 12.39,
      "text": "All finished, thank you. So, based on the history and the examination, I can't pin this down yet. We're looking at possible pulmonary hypertension or chronic clots in the lungs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 260.81,
      "end_seconds": 263.83,
      "duration_seconds": 3.02,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.27,
      "end_seconds": 275.69,
      "duration_seconds": 10.42,
      "text": "Good, thanks for doing that. I'd like to arrange an echocardiogram for exertional syncope. No exertion for now, I am arranging urgent specialist tests."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.49,
      "end_seconds": 280.46,
      "duration_seconds": 3.97,
      "text": "Should I have blood tests as well?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.23,
      "end_seconds": 292.13,
      "duration_seconds": 9.9,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.19,
      "end_seconds": 300.54,
      "duration_seconds": 3.35,
      "text": "Alright, um, thanks, take care."
    }
  ]
}