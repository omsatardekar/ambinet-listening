{
  "schema_version": "1.0",
  "encounter_id": "02915",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 6.6,
      "duration_seconds": 5.23,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 12.99,
      "duration_seconds": 4.55,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.7,
      "end_seconds": 20.98,
      "duration_seconds": 6.28,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.17,
      "end_seconds": 26.47,
      "duration_seconds": 4.3,
      "text": "Right, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.1,
      "end_seconds": 34.33,
      "duration_seconds": 6.23,
      "text": "So the thing is, you know, I've got itchy blisters."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.12,
      "end_seconds": 40.15,
      "duration_seconds": 4.03,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 46.77,
      "duration_seconds": 4.67,
      "text": "Metoprolol, 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.58,
      "end_seconds": 52.03,
      "duration_seconds": 4.45,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.89,
      "end_seconds": 57.07,
      "duration_seconds": 4.18,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.51,
      "end_seconds": 62.33,
      "duration_seconds": 3.82,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.96,
      "end_seconds": 68.38,
      "duration_seconds": 4.42,
      "text": "About about a month, give or take."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.21,
      "end_seconds": 74.92,
      "duration_seconds": 4.71,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.83,
      "end_seconds": 81.7,
      "duration_seconds": 4.87,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.37,
      "end_seconds": 89.68,
      "duration_seconds": 2.31,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.38,
      "end_seconds": 93.9,
      "duration_seconds": 2.52,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.81,
      "end_seconds": 105.23,
      "duration_seconds": 8.42,
      "text": "It usually comes with an itchy rash first. I've also had raw areas where blisters burst."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.93,
      "end_seconds": 112.73,
      "duration_seconds": 5.8,
      "text": "A few quick ones: mouth sores, fever, new medicine or eye problems?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.31,
      "end_seconds": 120.87,
      "duration_seconds": 2.56,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.29,
      "end_seconds": 125.67,
      "duration_seconds": 3.38,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.31,
      "end_seconds": 131.76,
      "duration_seconds": 4.45,
      "text": "Let me think, no, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.11,
      "end_seconds": 136.11,
      "duration_seconds": 3.0,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.38,
      "end_seconds": 141.07,
      "duration_seconds": 3.69,
      "text": "No, you know, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.1,
      "end_seconds": 148.1,
      "duration_seconds": 5.0,
      "text": "Alright, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.67,
      "end_seconds": 151.35,
      "duration_seconds": 2.68,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.02,
      "end_seconds": 155.76,
      "duration_seconds": 2.74,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.37,
      "end_seconds": 164.3,
      "duration_seconds": 3.93,
      "text": "I have eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.14,
      "end_seconds": 177.79,
      "duration_seconds": 11.65,
      "text": "Yes, high blood pressure and eczema are known to us, good to have that clear. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.5,
      "end_seconds": 186.36,
      "duration_seconds": 6.86,
      "text": "Um, my sister had breast cancer. Ah, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.77,
      "end_seconds": 192.79,
      "duration_seconds": 5.02,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.59,
      "end_seconds": 204.41,
      "duration_seconds": 9.82,
      "text": "Hmm, years back I got vomiting from tramadol, so I stay away from it now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.63,
      "end_seconds": 218.39,
      "duration_seconds": 1.76,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.55,
      "end_seconds": 225.24,
      "duration_seconds": 5.69,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.04,
      "end_seconds": 228.4,
      "duration_seconds": 1.36,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.97,
      "end_seconds": 234.11,
      "duration_seconds": 4.14,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 235.15,
      "end_seconds": 243.88,
      "duration_seconds": 8.73,
      "text": "Okay, so the vitals from earlier. Pulse is 74 beats a minute, temperature is 36.6 degrees, BP is 122 over 80."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.72,
      "end_seconds": 246.81,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.76,
      "end_seconds": 253.27,
      "duration_seconds": 4.51,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.0,
      "end_seconds": 256.29,
      "duration_seconds": 1.29,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.74,
      "end_seconds": 281.71,
      "duration_seconds": 6.97,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.98,
      "end_seconds": 288.09,
      "duration_seconds": 2.11,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.8,
      "end_seconds": 317.38,
      "duration_seconds": 12.58,
      "text": "Taking everything into account, I'd lean towards bullous pemphigoid. Another possibility is a drug reaction. I can't rule out pemphigus yet. Do not burst the blisters and keep the raw areas dressed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.91,
      "end_seconds": 326.98,
      "duration_seconds": 9.07,
      "text": "Yes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.59,
      "end_seconds": 335.24,
      "duration_seconds": 6.65,
      "text": "Do I need a skin biopsy? I read it might help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.51,
      "end_seconds": 349.94,
      "duration_seconds": 9.43,
      "text": "Not right now, it wouldn't change what we do today. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.34,
      "end_seconds": 352.04,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.01,
      "end_seconds": 356.62,
      "duration_seconds": 2.61,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.75,
      "end_seconds": 363.35,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.99,
      "end_seconds": 368.19,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}