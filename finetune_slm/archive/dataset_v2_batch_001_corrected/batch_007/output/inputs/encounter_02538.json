{
  "schema_version": "1.0",
  "encounter_id": "02538",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 6.13,
      "duration_seconds": 5.45,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.15,
      "end_seconds": 13.08,
      "duration_seconds": 4.93,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.33,
      "end_seconds": 25.81,
      "duration_seconds": 7.48,
      "text": "So the thing is, I've got a growing red ring on my thigh."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.58,
      "end_seconds": 28.33,
      "duration_seconds": 1.75,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.19,
      "end_seconds": 36.33,
      "duration_seconds": 7.14,
      "text": "Probably four weeks. Yeah. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.73,
      "end_seconds": 38.55,
      "duration_seconds": 1.82,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.25,
      "end_seconds": 44.49,
      "duration_seconds": 4.24,
      "text": "And there's aching muscles as well, five days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.71,
      "end_seconds": 53.55,
      "duration_seconds": 4.84,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.41,
      "end_seconds": 58.75,
      "duration_seconds": 3.34,
      "text": "I'm allergic to tramadol, I get vomiting."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.35,
      "end_seconds": 61.69,
      "duration_seconds": 1.34,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.16,
      "end_seconds": 66.11,
      "duration_seconds": 2.95,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.12,
      "end_seconds": 71.42,
      "duration_seconds": 3.3,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.15,
      "end_seconds": 77.23,
      "duration_seconds": 4.08,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.01,
      "end_seconds": 80.32,
      "duration_seconds": 2.31,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.38,
      "end_seconds": 87.74,
      "duration_seconds": 5.36,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.48,
      "end_seconds": 93.13,
      "duration_seconds": 3.65,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.19,
      "end_seconds": 97.01,
      "duration_seconds": 1.82,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.63,
      "end_seconds": 100.27,
      "duration_seconds": 2.64,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.02,
      "end_seconds": 103.08,
      "duration_seconds": 1.06,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.0,
      "end_seconds": 123.8,
      "duration_seconds": 5.8,
      "text": "Let me check a few things. Any joint swelling or facial weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.57,
      "end_seconds": 126.65,
      "duration_seconds": 2.08,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.99,
      "end_seconds": 130.59,
      "duration_seconds": 2.6,
      "text": "And stiff neck, any of that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.0,
      "end_seconds": 134.99,
      "duration_seconds": 2.99,
      "text": "I haven't noticed any stiff neck."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.29,
      "end_seconds": 137.94,
      "duration_seconds": 1.65,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.74,
      "end_seconds": 140.97,
      "duration_seconds": 2.23,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.36,
      "end_seconds": 146.86,
      "duration_seconds": 4.5,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.85,
      "end_seconds": 151.34,
      "duration_seconds": 2.49,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.76,
      "end_seconds": 155.87,
      "duration_seconds": 3.11,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.52,
      "end_seconds": 168.07,
      "duration_seconds": 2.55,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.46,
      "end_seconds": 184.82,
      "duration_seconds": 6.36,
      "text": "Okay: pressure 128 over 79, temp 36.5 degrees, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.88,
      "end_seconds": 189.62,
      "duration_seconds": 3.74,
      "text": "Let me think, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.57,
      "end_seconds": 194.89,
      "duration_seconds": 3.32,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.89,
      "end_seconds": 200.43,
      "duration_seconds": 3.54,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.25,
      "end_seconds": 202.64,
      "duration_seconds": 1.39,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.49,
      "end_seconds": 221.64,
      "duration_seconds": 6.15,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.28,
      "end_seconds": 227.04,
      "duration_seconds": 2.76,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.71,
      "end_seconds": 251.43,
      "duration_seconds": 7.72,
      "text": "Okay, so my impression is this: I think we're dealing with early Lyme disease at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.28,
      "end_seconds": 256.83,
      "duration_seconds": 3.55,
      "text": "Well, is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.46,
      "end_seconds": 263.86,
      "duration_seconds": 6.4,
      "text": "Nothing I've seen today points to an emergency. It looks like early Lyme disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.25,
      "end_seconds": 287.84,
      "duration_seconds": 10.59,
      "text": "I'm going to put you on doxycycline, 100 milligrams, twice a day, twenty-one days. That should help with early Lyme disease."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.57,
      "end_seconds": 292.59,
      "duration_seconds": 3.02,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 301.82,
      "duration_seconds": 7.27,
      "text": "Take the doxycycline with food and avoid strong sun. See me again in three weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.84,
      "end_seconds": 307.67,
      "duration_seconds": 3.83,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.75,
      "end_seconds": 311.96,
      "duration_seconds": 3.21,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.99,
      "end_seconds": 315.81,
      "duration_seconds": 2.82,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.67,
      "end_seconds": 318.23,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}