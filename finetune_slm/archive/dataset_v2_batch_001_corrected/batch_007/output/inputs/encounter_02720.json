{
  "schema_version": "1.0",
  "encounter_id": "02720",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.28,
      "duration_seconds": 3.9,
      "text": "Hmm, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.25,
      "end_seconds": 10.95,
      "duration_seconds": 3.7,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.72,
      "end_seconds": 18.45,
      "duration_seconds": 5.73,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.47,
      "end_seconds": 25.45,
      "duration_seconds": 4.98,
      "text": "Hmm, I've been dealing with stiff aching shoulders and hips."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.32,
      "end_seconds": 29.49,
      "duration_seconds": 3.17,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.86,
      "end_seconds": 37.93,
      "duration_seconds": 3.07,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.59,
      "end_seconds": 41.1,
      "duration_seconds": 2.51,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.32,
      "end_seconds": 46.74,
      "duration_seconds": 4.42,
      "text": "Yeah, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.54,
      "end_seconds": 49.87,
      "duration_seconds": 2.33,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.67,
      "end_seconds": 55.04,
      "duration_seconds": 4.37,
      "text": "Right, I get some relief from moving about."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.08,
      "end_seconds": 59.93,
      "duration_seconds": 2.85,
      "text": "Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.5,
      "end_seconds": 65.9,
      "duration_seconds": 5.4,
      "text": "A mild temperature goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.27,
      "end_seconds": 69.59,
      "duration_seconds": 2.32,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.6,
      "end_seconds": 85.44,
      "duration_seconds": 14.84,
      "text": "It happens a couple of times a week. Let me think, I did have difficulty getting out of bed at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 94.59,
      "duration_seconds": 5.34,
      "text": "And what about visual changes, weight loss, jaw pain on chewing or headache?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 106.61,
      "duration_seconds": 7.91,
      "text": "Right, no visual changes, weight loss, jaw pain on chewing or headache, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.05,
      "end_seconds": 110.49,
      "duration_seconds": 1.44,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.25,
      "end_seconds": 113.52,
      "duration_seconds": 2.27,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.21,
      "end_seconds": 117.66,
      "duration_seconds": 2.45,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.7,
      "end_seconds": 122.94,
      "duration_seconds": 3.24,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 123.48,
      "end_seconds": 131.01,
      "duration_seconds": 7.53,
      "text": "Okay, so I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.63,
      "end_seconds": 135.57,
      "duration_seconds": 3.94,
      "text": "Actually, you know, really? I don't think so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.88,
      "end_seconds": 145.41,
      "duration_seconds": 8.53,
      "text": "Alright, so that's unclear. I'll record what each of you said. What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.55,
      "end_seconds": 152.77,
      "duration_seconds": 6.22,
      "text": "I have high blood pressure, for nearly five years. Yes, heart disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.94,
      "end_seconds": 158.01,
      "duration_seconds": 4.07,
      "text": "Yes. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 163.37,
      "end_seconds": 168.97,
      "duration_seconds": 5.6,
      "text": "It's lisinopril, 10 milligrams, once a day for my pressure, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.03,
      "end_seconds": 171.36,
      "duration_seconds": 1.33,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.98,
      "end_seconds": 174.8,
      "duration_seconds": 1.82,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.1,
      "end_seconds": 177.43,
      "duration_seconds": 1.33,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.81,
      "end_seconds": 183.35,
      "duration_seconds": 4.54,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.24,
      "end_seconds": 188.35,
      "duration_seconds": 4.11,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.19,
      "end_seconds": 193.97,
      "duration_seconds": 3.78,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 198.56,
      "duration_seconds": 2.92,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.34,
      "end_seconds": 204.01,
      "duration_seconds": 3.67,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.54,
      "end_seconds": 207.42,
      "duration_seconds": 2.88,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.13,
      "end_seconds": 212.82,
      "duration_seconds": 3.69,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 228.5,
      "end_seconds": 238.7,
      "duration_seconds": 10.2,
      "text": "Okay, so the vitals from earlier. SpO2 99 percent on room air, pulse is 69 beats a minute. Respiratory rate 15, BP is 126 over 73."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 240.71,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.67,
      "end_seconds": 247.59,
      "duration_seconds": 3.92,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.51,
      "end_seconds": 251.05,
      "duration_seconds": 1.54,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.65,
      "end_seconds": 255.66,
      "duration_seconds": 3.01,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.1,
      "end_seconds": 279.44,
      "duration_seconds": 6.34,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.94,
      "end_seconds": 280.64,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.75,
      "end_seconds": 286.35,
      "duration_seconds": 1.6,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.63,
      "end_seconds": 311.83,
      "duration_seconds": 13.2,
      "text": "So where does that leave us? It fits best with polymyalgia rheumatica. I want to be honest that this is an impression, not a final answer. Rheumatoid arthritis is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.68,
      "end_seconds": 316.03,
      "duration_seconds": 3.35,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.53,
      "end_seconds": 322.78,
      "duration_seconds": 5.25,
      "text": "Nothing I've seen today points to an emergency. It looks like polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.22,
      "end_seconds": 356.91,
      "duration_seconds": 16.69,
      "text": "Report any headache or jaw pain immediately. I'd like to see you again in two weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.25,
      "end_seconds": 364.7,
      "duration_seconds": 5.45,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.55,
      "end_seconds": 370.08,
      "duration_seconds": 4.53,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.81,
      "end_seconds": 378.8,
      "duration_seconds": 3.99,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}