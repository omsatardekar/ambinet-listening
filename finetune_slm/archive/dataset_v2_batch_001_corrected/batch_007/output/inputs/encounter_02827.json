{
  "schema_version": "1.0",
  "encounter_id": "02827",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.58,
      "duration_seconds": 4.69,
      "text": "Hello, you know, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.16,
      "end_seconds": 11.29,
      "duration_seconds": 4.13,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.14,
      "end_seconds": 15.87,
      "duration_seconds": 2.73,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.96,
      "end_seconds": 19.79,
      "duration_seconds": 2.83,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.58,
      "end_seconds": 25.83,
      "duration_seconds": 5.25,
      "text": "Doctor, it's a widespread rash with fever. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.9,
      "end_seconds": 31.13,
      "duration_seconds": 3.23,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.5,
      "end_seconds": 35.27,
      "duration_seconds": 2.77,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 36.64,
      "end_seconds": 41.01,
      "duration_seconds": 4.37,
      "text": "It was closer to three weeks, um, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.9,
      "end_seconds": 47.43,
      "duration_seconds": 4.53,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.2,
      "end_seconds": 54.34,
      "duration_seconds": 2.14,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.59,
      "end_seconds": 57.59,
      "duration_seconds": 2.0,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.21,
      "end_seconds": 65.14,
      "duration_seconds": 5.93,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.74,
      "end_seconds": 72.72,
      "duration_seconds": 6.98,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.26,
      "end_seconds": 81.08,
      "duration_seconds": 2.82,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 87.89,
      "duration_seconds": 5.96,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 87.99,
      "end_seconds": 94.87,
      "duration_seconds": 6.88,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.88,
      "end_seconds": 100.08,
      "duration_seconds": 3.2,
      "text": "Right, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.23,
      "end_seconds": 105.68,
      "duration_seconds": 4.45,
      "text": "I've also had swollen glands, for about a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.58,
      "end_seconds": 108.71,
      "duration_seconds": 2.13,
      "text": "Any swollen face as well?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.51,
      "end_seconds": 115.59,
      "duration_seconds": 1.08,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 116.64,
      "end_seconds": 119.12,
      "duration_seconds": 2.48,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.46,
      "end_seconds": 124.69,
      "duration_seconds": 4.23,
      "text": "Have you had any blisters, breathing difficulty or mouth sores?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.81,
      "end_seconds": 130.16,
      "duration_seconds": 4.35,
      "text": "No, no blisters, breathing difficulty or mouth sores."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.03,
      "end_seconds": 136.38,
      "duration_seconds": 4.35,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.81,
      "end_seconds": 140.22,
      "duration_seconds": 2.41,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.73,
      "end_seconds": 143.18,
      "duration_seconds": 2.45,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.26,
      "end_seconds": 147.36,
      "duration_seconds": 2.1,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.81,
      "end_seconds": 151.97,
      "duration_seconds": 3.16,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.82,
      "end_seconds": 159.19,
      "duration_seconds": 5.37,
      "text": "I have depression. I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.07,
      "end_seconds": 171.22,
      "duration_seconds": 10.15,
      "text": "Yes, asthma is known to us, good to have that clear. So, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.83,
      "end_seconds": 177.8,
      "duration_seconds": 4.97,
      "text": "Uh, I take fluoxetine, every morning for my mood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.35,
      "end_seconds": 180.58,
      "duration_seconds": 2.23,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.14,
      "end_seconds": 190.0,
      "duration_seconds": 7.86,
      "text": "20 milligrams, I think that's what's on the box. It's Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 192.78,
      "duration_seconds": 1.2,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.38,
      "end_seconds": 200.81,
      "duration_seconds": 6.43,
      "text": "About a month now. Allopurinol, 300 milligrams, maybe, started four weeks ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.41,
      "end_seconds": 210.6,
      "duration_seconds": 4.19,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.04,
      "end_seconds": 222.69,
      "duration_seconds": 10.65,
      "text": "Not with me. I'll bring it next time. I had mirtazapine at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.96,
      "end_seconds": 226.91,
      "duration_seconds": 2.95,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.48,
      "end_seconds": 230.11,
      "duration_seconds": 2.63,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 252.12,
      "duration_seconds": 5.53,
      "text": "Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.21,
      "end_seconds": 255.65,
      "duration_seconds": 1.44,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.43,
      "end_seconds": 261.73,
      "duration_seconds": 5.3,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.39,
      "end_seconds": 273.25,
      "duration_seconds": 9.86,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 274.62,
      "end_seconds": 282.84,
      "duration_seconds": 8.22,
      "text": "Okay, so the vitals from earlier. BP is 116 over 75, pulse 90, respiratory rate 19. Saturation 95 percent."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.7,
      "end_seconds": 285.4,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.79,
      "end_seconds": 291.0,
      "duration_seconds": 3.21,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.45,
      "end_seconds": 295.83,
      "duration_seconds": 3.38,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.0,
      "end_seconds": 320.74,
      "duration_seconds": 6.74,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.65,
      "end_seconds": 339.33,
      "duration_seconds": 1.68,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.79,
      "end_seconds": 380.86,
      "duration_seconds": 37.07,
      "text": "All finished, thank you. From what you've told me and what I found, it's hard to say. A severe drug reaction is one possibility and a viral rash another, and I'd rather not commit yet. I'll request urgent blood tests, it'll help with severe drug reaction. I'll start you on prednisolone, 40 milligrams, once a day, until review. You take it by mouth. That should help with severe drug reaction. Stop the allopurinol now and you need admission."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.8,
      "end_seconds": 395.73,
      "duration_seconds": 8.93,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.59,
      "end_seconds": 401.11,
      "duration_seconds": 3.52,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.68,
      "end_seconds": 404.05,
      "duration_seconds": 2.37,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.23,
      "end_seconds": 405.93,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.34,
      "end_seconds": 410.24,
      "duration_seconds": 2.9,
      "text": "So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.32,
      "end_seconds": 416.34,
      "duration_seconds": 4.02,
      "text": "Good, you know, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.53,
      "end_seconds": 419.17,
      "duration_seconds": 1.64,
      "text": "Have a good day."
    }
  ]
}