{
  "schema_version": "1.0",
  "encounter_id": "02814",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 6.15,
      "duration_seconds": 5.3,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 11.77,
      "duration_seconds": 4.91,
      "text": "So, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.34,
      "end_seconds": 23.06,
      "duration_seconds": 9.72,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. She's been having sneezing in spring, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.88,
      "end_seconds": 26.65,
      "duration_seconds": 2.77,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.62,
      "end_seconds": 29.12,
      "duration_seconds": 1.5,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.84,
      "end_seconds": 39.64,
      "duration_seconds": 9.8,
      "text": "right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.44,
      "end_seconds": 59.52,
      "duration_seconds": 18.08,
      "text": "Pollen definitely sets it off. Severe, really. I thought it would sort itself out, but it hasn't. And there's a runny itchy nose as well, about three months now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.43,
      "end_seconds": 62.9,
      "duration_seconds": 2.47,
      "text": "How frequently does it it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.77,
      "end_seconds": 77.41,
      "duration_seconds": 12.64,
      "text": "Honestly, all the time. Oh, and watery eyes. Had that since Friday. With watery eyes, maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.05,
      "end_seconds": 85.12,
      "duration_seconds": 6.07,
      "text": "Have you had sneezing in spring before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.81,
      "end_seconds": 92.91,
      "duration_seconds": 6.1,
      "text": "hmm, I had a similar thing last year. It went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.27,
      "end_seconds": 98.59,
      "duration_seconds": 4.32,
      "text": "alright, have you had any facial pain or wheeze?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.13,
      "end_seconds": 103.94,
      "duration_seconds": 3.81,
      "text": "no, uh, none that I've noticed"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.9,
      "end_seconds": 109.03,
      "duration_seconds": 4.13,
      "text": "Have you had any loss of smell or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.56,
      "end_seconds": 113.42,
      "duration_seconds": 2.86,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.19,
      "end_seconds": 117.81,
      "duration_seconds": 3.62,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.53,
      "end_seconds": 122.7,
      "duration_seconds": 3.17,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 127.51,
      "duration_seconds": 2.83,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.26,
      "end_seconds": 130.08,
      "duration_seconds": 1.82,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.22,
      "end_seconds": 132.42,
      "duration_seconds": 1.2,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.75,
      "end_seconds": 137.04,
      "duration_seconds": 3.29,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.86,
      "end_seconds": 139.18,
      "duration_seconds": 1.32,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.0,
      "end_seconds": 147.66,
      "duration_seconds": 6.66,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.08,
      "end_seconds": 151.91,
      "duration_seconds": 2.83,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.86,
      "end_seconds": 157.86,
      "duration_seconds": 4.0,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.5,
      "end_seconds": 161.14,
      "duration_seconds": 1.64,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.22,
      "end_seconds": 165.7,
      "duration_seconds": 2.48,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.5,
      "end_seconds": 169.09,
      "duration_seconds": 1.59,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.82,
      "end_seconds": 175.23,
      "duration_seconds": 4.41,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.59,
      "end_seconds": 195.72,
      "duration_seconds": 4.13,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.78,
      "end_seconds": 201.36,
      "duration_seconds": 4.58,
      "text": "actually, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.0,
      "end_seconds": 205.93,
      "duration_seconds": 3.93,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 207.39,
      "end_seconds": 211.17,
      "duration_seconds": 3.78,
      "text": "It's, It's metoprolol, twice a day, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.63,
      "end_seconds": 214.79,
      "duration_seconds": 2.16,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 216.32,
      "end_seconds": 228.74,
      "duration_seconds": 12.42,
      "text": "50 milligrams. Sorry, what was I saying, she is on loratadine, 10 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.14,
      "end_seconds": 237.56,
      "duration_seconds": 4.42,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.2,
      "end_seconds": 255.08,
      "duration_seconds": 11.88,
      "text": "Erm, yes, heart disease. I took the morning off to come in today. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.46,
      "end_seconds": 258.97,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.72,
      "end_seconds": 264.74,
      "duration_seconds": 4.02,
      "text": "nothing, uh, I haven't had any operations"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.79,
      "end_seconds": 269.42,
      "duration_seconds": 3.63,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.61,
      "end_seconds": 282.4,
      "duration_seconds": 2.79,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.9,
      "end_seconds": 307.84,
      "duration_seconds": 12.94,
      "text": "Okay: oxygen saturation is 97 percent, height 158 centimetres. And BP is 110 over 74, weight 77 kilos, pulse is 65 beats a minute, BMI works out to 30.8."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.6,
      "end_seconds": 314.78,
      "duration_seconds": 4.18,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.63,
      "end_seconds": 317.6,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.58,
      "end_seconds": 334.34,
      "duration_seconds": 4.76,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.75,
      "end_seconds": 338.39,
      "duration_seconds": 1.64,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.88,
      "end_seconds": 351.64,
      "duration_seconds": 4.76,
      "text": "Having listened and examined, it points towards seasonal allergic rhinitis."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.25,
      "end_seconds": 355.49,
      "duration_seconds": 2.24,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.12,
      "end_seconds": 372.21,
      "duration_seconds": 15.09,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal allergic rhinitis. Just to be sure I understood. You've had sneezing in spring, yesterday, severe, and no loss of smell or wheeze."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.85,
      "end_seconds": 373.55,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.36,
      "end_seconds": 382.84,
      "duration_seconds": 7.48,
      "text": "You'll be taking fluticasone nasal spray, 50 micrograms, once a day, the season. That's for hay fever."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.34,
      "end_seconds": 388.42,
      "duration_seconds": 4.08,
      "text": "Erm, is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.26,
      "end_seconds": 392.82,
      "duration_seconds": 2.56,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.02,
      "end_seconds": 397.58,
      "duration_seconds": 3.56,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.56,
      "end_seconds": 399.75,
      "duration_seconds": 1.19,
      "text": "all the best"
    }
  ]
}