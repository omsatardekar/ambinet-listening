{
  "schema_version": "1.0",
  "encounter_id": "02894",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 2.64,
      "duration_seconds": 1.93,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.35,
      "end_seconds": 4.28,
      "duration_seconds": 0.93,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 8.54,
      "duration_seconds": 2.47,
      "text": "Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.04,
      "end_seconds": 14.38,
      "duration_seconds": 4.34,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.59,
      "end_seconds": 18.27,
      "duration_seconds": 2.68,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.9,
      "end_seconds": 26.62,
      "duration_seconds": 6.72,
      "text": "Honestly, it's weakness climbing up my legs, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.3,
      "end_seconds": 31.69,
      "duration_seconds": 3.39,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.88,
      "end_seconds": 36.51,
      "duration_seconds": 3.63,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.02,
      "end_seconds": 42.0,
      "duration_seconds": 3.98,
      "text": "Right, have you had bladder problems, by any chance?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.96,
      "end_seconds": 45.09,
      "duration_seconds": 2.13,
      "text": "No bladder problems, thankfully."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.99,
      "end_seconds": 50.36,
      "duration_seconds": 3.37,
      "text": "Have you noticed fever or back pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.73,
      "end_seconds": 54.51,
      "duration_seconds": 2.78,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.91,
      "end_seconds": 58.37,
      "duration_seconds": 3.46,
      "text": "Okay, go on. Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.59,
      "end_seconds": 66.18,
      "duration_seconds": 2.59,
      "text": "Yeah, no, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.36,
      "end_seconds": 79.64,
      "duration_seconds": 3.28,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.61,
      "end_seconds": 85.23,
      "duration_seconds": 3.62,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.26,
      "end_seconds": 89.33,
      "duration_seconds": 2.07,
      "text": "So, how are your meals?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.92,
      "end_seconds": 98.71,
      "duration_seconds": 3.79,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.76,
      "end_seconds": 105.7,
      "duration_seconds": 3.94,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.49,
      "end_seconds": 110.52,
      "duration_seconds": 3.03,
      "text": "It's mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.88,
      "end_seconds": 112.77,
      "duration_seconds": 1.89,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.42,
      "end_seconds": 128.0,
      "duration_seconds": 4.58,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.95,
      "end_seconds": 138.16,
      "duration_seconds": 6.21,
      "text": "So, um, I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.94,
      "end_seconds": 147.13,
      "duration_seconds": 4.19,
      "text": "Okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.97,
      "end_seconds": 151.12,
      "duration_seconds": 2.15,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.28,
      "end_seconds": 160.47,
      "duration_seconds": 3.19,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.52,
      "end_seconds": 170.61,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.89,
      "end_seconds": 197.31,
      "duration_seconds": 5.42,
      "text": "Okay: pulse 82, SpO2 99 percent on room air, pressure 122 over 70."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 200.96,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.56,
      "end_seconds": 206.47,
      "duration_seconds": 3.91,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.69,
      "end_seconds": 211.13,
      "duration_seconds": 3.44,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.79,
      "end_seconds": 214.09,
      "duration_seconds": 1.3,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.18,
      "end_seconds": 231.9,
      "duration_seconds": 5.72,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 238.4,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.57,
      "end_seconds": 254.38,
      "duration_seconds": 4.81,
      "text": "Right, here's what I'm thinking. It points towards possible Guillain-Barre syndrome."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.17,
      "end_seconds": 257.09,
      "duration_seconds": 1.92,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.09,
      "end_seconds": 276.83,
      "duration_seconds": 18.74,
      "text": "Nothing I've seen today points to an emergency. It looks like possible Guillain-Barre syndrome, but I'd like to confirm. So, to recap quickly. You've had weakness climbing up your legs for one week, and no fever or bladder problems."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.63,
      "end_seconds": 280.68,
      "duration_seconds": 3.05,
      "text": "That's it, you know, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.83,
      "end_seconds": 308.2,
      "duration_seconds": 26.37,
      "text": "Let's get a lumbar puncture, for possible GBS. We should do an urgent admission for ascending weakness. You must be admitted today for monitoring of your breathing. I'm going to send a referral to the neurology team. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.31,
      "end_seconds": 314.48,
      "duration_seconds": 5.17,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.6,
      "end_seconds": 319.89,
      "duration_seconds": 4.29,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.72,
      "end_seconds": 325.73,
      "duration_seconds": 4.01,
      "text": "Great, uh, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.84,
      "end_seconds": 328.81,
      "duration_seconds": 1.97,
      "text": "Okay, see you soon."
    }
  ]
}