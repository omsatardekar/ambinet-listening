{
  "schema_version": "1.0",
  "encounter_id": "02992",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 2.47,
      "duration_seconds": 1.92,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.33,
      "end_seconds": 6.82,
      "duration_seconds": 3.49,
      "text": "Okay, so good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 11.35,
      "duration_seconds": 3.77,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.92,
      "end_seconds": 21.28,
      "duration_seconds": 9.36,
      "text": "Erm, doctor, it's itchy blisters. It's getting on my nerves now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.2,
      "end_seconds": 25.2,
      "duration_seconds": 2.0,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.27,
      "end_seconds": 34.75,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.84,
      "end_seconds": 65.75,
      "duration_seconds": 10.91,
      "text": "Okay: respiratory rate 14, pressure 121 over 75, temperature 36.4. And pulse 76, oxygen saturation is 99 percent. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.95,
      "end_seconds": 68.89,
      "duration_seconds": 1.94,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.48,
      "end_seconds": 72.11,
      "duration_seconds": 2.63,
      "text": "Sure. How frequently does it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.89,
      "end_seconds": 75.01,
      "duration_seconds": 2.12,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.74,
      "end_seconds": 81.34,
      "duration_seconds": 4.6,
      "text": "What about raw areas where blisters burst, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.14,
      "end_seconds": 84.21,
      "duration_seconds": 1.07,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.33,
      "end_seconds": 92.23,
      "duration_seconds": 3.9,
      "text": "Have you noticed new medicine or eye problems?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.11,
      "end_seconds": 97.01,
      "duration_seconds": 3.9,
      "text": "No, no new medicine or eye problems."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.45,
      "end_seconds": 102.15,
      "duration_seconds": 3.7,
      "text": "Have you had any fever or mouth sores?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.75,
      "end_seconds": 106.58,
      "duration_seconds": 2.83,
      "text": "Mm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.28,
      "end_seconds": 110.14,
      "duration_seconds": 2.86,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.76,
      "end_seconds": 113.99,
      "duration_seconds": 3.23,
      "text": "No, you know, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.7,
      "end_seconds": 120.1,
      "duration_seconds": 4.4,
      "text": "Right, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.33,
      "end_seconds": 127.0,
      "duration_seconds": 4.67,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.26,
      "end_seconds": 134.96,
      "duration_seconds": 3.7,
      "text": "Okay, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.74,
      "end_seconds": 139.07,
      "duration_seconds": 2.33,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.32,
      "end_seconds": 150.67,
      "duration_seconds": 3.35,
      "text": "Okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.6,
      "end_seconds": 154.26,
      "duration_seconds": 2.66,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.61,
      "end_seconds": 165.09,
      "duration_seconds": 3.48,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.96,
      "end_seconds": 175.21,
      "duration_seconds": 5.25,
      "text": "High blood pressure, for two years. Acid reflux, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.27,
      "end_seconds": 179.94,
      "duration_seconds": 1.67,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.65,
      "end_seconds": 193.75,
      "duration_seconds": 13.1,
      "text": "Yes, high blood pressure and acid reflux are known to us, good to have that clear. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.73,
      "end_seconds": 205.66,
      "duration_seconds": 10.93,
      "text": "I live with my elderly mother. I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.73,
      "end_seconds": 212.81,
      "duration_seconds": 5.08,
      "text": "So, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.62,
      "end_seconds": 216.83,
      "duration_seconds": 3.21,
      "text": "I take valsartan, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.45,
      "end_seconds": 219.72,
      "duration_seconds": 2.27,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.11,
      "end_seconds": 223.22,
      "duration_seconds": 2.11,
      "text": "It's, It's 80 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.92,
      "end_seconds": 228.14,
      "duration_seconds": 3.22,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.67,
      "end_seconds": 233.9,
      "duration_seconds": 4.23,
      "text": "For about three months. I take lansoprazole, before breakfast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.56,
      "end_seconds": 236.92,
      "duration_seconds": 2.36,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.63,
      "end_seconds": 240.2,
      "duration_seconds": 1.57,
      "text": "It's 30 milligrams."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.65,
      "end_seconds": 244.4,
      "duration_seconds": 2.75,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.91,
      "end_seconds": 246.46,
      "duration_seconds": 1.55,
      "text": "Two months now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.72,
      "end_seconds": 247.74,
      "duration_seconds": 1.02,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.69,
      "end_seconds": 252.04,
      "duration_seconds": 2.35,
      "text": "Amlodipine I don't take anymore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.74,
      "end_seconds": 259.27,
      "duration_seconds": 4.53,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.96,
      "end_seconds": 261.92,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.49,
      "end_seconds": 264.82,
      "duration_seconds": 1.33,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.84,
      "end_seconds": 284.48,
      "duration_seconds": 5.64,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.92,
      "end_seconds": 295.82,
      "duration_seconds": 8.9,
      "text": "All finished, thank you. Right, here's what I'm thinking. This looks most like bullous pemphigoid. A drug reaction is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.02,
      "end_seconds": 298.82,
      "duration_seconds": 1.8,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.26,
      "end_seconds": 307.88,
      "duration_seconds": 7.62,
      "text": "I understand the worry. At the moment I'd say it's bullous pemphigoid, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.6,
      "end_seconds": 327.61,
      "duration_seconds": 7.01,
      "text": "There's nothing new for me to start or arrange today. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.13,
      "end_seconds": 331.7,
      "duration_seconds": 3.57,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.54,
      "end_seconds": 334.71,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}