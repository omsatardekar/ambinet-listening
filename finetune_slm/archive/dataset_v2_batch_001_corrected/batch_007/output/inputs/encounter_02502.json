{
  "schema_version": "1.0",
  "encounter_id": "02502",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 4.24,
      "duration_seconds": 3.0,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.82,
      "end_seconds": 8.83,
      "duration_seconds": 4.01,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.61,
      "end_seconds": 15.03,
      "duration_seconds": 4.42,
      "text": "absolutely, come and sit beside them what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 16.57,
      "end_seconds": 23.24,
      "duration_seconds": 6.67,
      "text": "it's itchy blisters, doctor. She didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 28.13,
      "duration_seconds": 3.42,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.82,
      "end_seconds": 31.83,
      "duration_seconds": 3.01,
      "text": "I've had it since last weekend"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.44,
      "end_seconds": 37.05,
      "duration_seconds": 2.61,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.58,
      "end_seconds": 42.89,
      "duration_seconds": 4.31,
      "text": "It usually comes with raw areas where blisters burst."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.06,
      "end_seconds": 50.16,
      "duration_seconds": 6.1,
      "text": "Have you had itchy blisters before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.25,
      "end_seconds": 57.15,
      "duration_seconds": 5.9,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.1,
      "end_seconds": 62.67,
      "duration_seconds": 3.57,
      "text": "Alright, any mouth sores, new medicine or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.74,
      "end_seconds": 70.0,
      "duration_seconds": 5.26,
      "text": "okay, so no, no mouth sores, new medicine or fever"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.82,
      "end_seconds": 73.53,
      "duration_seconds": 2.71,
      "text": "Did you notice any eye problems?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.48,
      "end_seconds": 80.59,
      "duration_seconds": 2.11,
      "text": "Nope, no eye problems."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.44,
      "end_seconds": 84.87,
      "duration_seconds": 2.43,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.93,
      "end_seconds": 87.95,
      "duration_seconds": 2.02,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.04,
      "end_seconds": 93.61,
      "duration_seconds": 3.57,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 100.46,
      "duration_seconds": 4.87,
      "text": "I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.19,
      "end_seconds": 112.3,
      "duration_seconds": 11.11,
      "text": "I see, go ahead. Alright, high blood pressure, that matches what I have here. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 112.82,
      "end_seconds": 119.67,
      "duration_seconds": 6.85,
      "text": "She is on ramipril, 5 milligrams, every morning, I give it to her."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.43,
      "end_seconds": 124.66,
      "duration_seconds": 3.23,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.23,
      "end_seconds": 129.79,
      "duration_seconds": 3.56,
      "text": "Hmm, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.81,
      "end_seconds": 136.28,
      "duration_seconds": 4.47,
      "text": "Any allergies to tablets, food or anything in the the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.95,
      "end_seconds": 143.72,
      "duration_seconds": 2.77,
      "text": "Yes, wheat. I get bloating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.67,
      "end_seconds": 161.37,
      "duration_seconds": 2.7,
      "text": "Okay, do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.25,
      "end_seconds": 166.69,
      "duration_seconds": 4.44,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.2,
      "end_seconds": 169.69,
      "duration_seconds": 2.49,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.41,
      "end_seconds": 174.62,
      "duration_seconds": 3.21,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.97,
      "end_seconds": 178.66,
      "duration_seconds": 2.69,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.45,
      "end_seconds": 190.6,
      "duration_seconds": 2.15,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 217.88,
      "duration_seconds": 14.42,
      "text": "Okay: weight 58 kilos, temperature 36.7. And respiratory rate 15, saturation 97 percent, heart rate 85, BP is 115 over 73, height 164 centimetres, BMI works out to 21.6."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.14,
      "end_seconds": 224.47,
      "duration_seconds": 4.33,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.77,
      "end_seconds": 228.19,
      "duration_seconds": 2.42,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.18,
      "end_seconds": 248.02,
      "duration_seconds": 6.84,
      "text": "there are firm, tense blisters on a red base on the arms and legs"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.39,
      "end_seconds": 252.05,
      "duration_seconds": 1.66,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.93,
      "end_seconds": 296.93,
      "duration_seconds": 26.0,
      "text": "So where does that leave us? This looks most like bullous pemphigoid. I want to be honest that this is an impression, not a final answer. Let's book a skin biopsy to look into blistering. The result will help us decide whether anything more is needed. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.74,
      "end_seconds": 302.55,
      "duration_seconds": 1.81,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.56,
      "end_seconds": 306.68,
      "duration_seconds": 3.12,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.67,
      "end_seconds": 310.9,
      "duration_seconds": 2.23,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.98,
      "end_seconds": 313.18,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}