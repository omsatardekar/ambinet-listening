{
  "schema_version": "1.0",
  "encounter_id": "02594",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 3.37,
      "duration_seconds": 2.81,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.52,
      "end_seconds": 9.07,
      "duration_seconds": 4.55,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.14,
      "end_seconds": 14.54,
      "duration_seconds": 4.4,
      "text": "I wanted to get being very breathless looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.11,
      "end_seconds": 19.02,
      "duration_seconds": 2.91,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.3,
      "end_seconds": 22.67,
      "duration_seconds": 2.37,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.69,
      "end_seconds": 29.48,
      "duration_seconds": 2.79,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.74,
      "end_seconds": 35.73,
      "duration_seconds": 4.99,
      "text": "Right, you know, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.78,
      "end_seconds": 41.56,
      "duration_seconds": 3.78,
      "text": "And what about cough, leg pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.18,
      "end_seconds": 45.03,
      "duration_seconds": 2.85,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.73,
      "end_seconds": 49.84,
      "duration_seconds": 3.11,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.86,
      "end_seconds": 53.92,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.55,
      "end_seconds": 58.15,
      "duration_seconds": 2.6,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.11,
      "end_seconds": 63.7,
      "duration_seconds": 1.59,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.51,
      "end_seconds": 76.01,
      "duration_seconds": 4.5,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.74,
      "end_seconds": 81.79,
      "duration_seconds": 4.05,
      "text": "Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.94,
      "end_seconds": 99.58,
      "duration_seconds": 4.64,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.27,
      "end_seconds": 104.54,
      "duration_seconds": 3.27,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.01,
      "end_seconds": 124.67,
      "duration_seconds": 5.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.04,
      "end_seconds": 137.11,
      "duration_seconds": 11.07,
      "text": "Lots of rice, lentils and some fruit. I do a yoga class on Thursdays. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.28,
      "end_seconds": 140.3,
      "duration_seconds": 2.02,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.02,
      "end_seconds": 143.11,
      "duration_seconds": 2.09,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.88,
      "end_seconds": 146.19,
      "duration_seconds": 1.31,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.18,
      "end_seconds": 148.93,
      "duration_seconds": 1.75,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.65,
      "end_seconds": 159.86,
      "duration_seconds": 10.21,
      "text": "Yes, eczema is known to us, good to have that clear. Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.63,
      "end_seconds": 164.55,
      "duration_seconds": 2.92,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.68,
      "end_seconds": 168.62,
      "duration_seconds": 2.94,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.51,
      "end_seconds": 176.24,
      "duration_seconds": 5.73,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.26,
      "end_seconds": 180.93,
      "duration_seconds": 3.67,
      "text": "So, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.6,
      "end_seconds": 194.99,
      "duration_seconds": 2.39,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.83,
      "end_seconds": 216.35,
      "duration_seconds": 10.52,
      "text": "Okay: BP is 135 over 73, temperature 37.1. And respiratory rate 23, SpO2 91 percent on room air, pulse 91."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.95,
      "end_seconds": 219.21,
      "duration_seconds": 2.26,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.86,
      "end_seconds": 222.23,
      "duration_seconds": 2.37,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 226.97,
      "duration_seconds": 2.12,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.51,
      "end_seconds": 231.14,
      "duration_seconds": 2.63,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.2,
      "end_seconds": 251.64,
      "duration_seconds": 5.44,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.19,
      "end_seconds": 263.87,
      "duration_seconds": 1.68,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.98,
      "end_seconds": 285.2,
      "duration_seconds": 16.22,
      "text": "You can sit up now. From what you've told me and what I found, this is probably possible pulmonary hypertension. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.78,
      "end_seconds": 290.71,
      "duration_seconds": 4.93,
      "text": "Um, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.23,
      "end_seconds": 326.12,
      "duration_seconds": 34.89,
      "text": "I understand the worry. At the moment I'd say it's possible pulmonary hypertension, and we'll know more once the blood tests is back. We should do blood tests for breathlessness. The result will help us decide whether anything more is needed. No exertion for now, I am arranging urgent specialist tests. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.08,
      "end_seconds": 331.01,
      "duration_seconds": 2.93,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.41,
      "end_seconds": 333.67,
      "duration_seconds": 1.26,
      "text": "All the best."
    }
  ]
}