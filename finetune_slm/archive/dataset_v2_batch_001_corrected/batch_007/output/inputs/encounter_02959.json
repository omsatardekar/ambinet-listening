{
  "schema_version": "1.0",
  "encounter_id": "02959",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 2.96,
      "duration_seconds": 1.87,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.45,
      "end_seconds": 7.94,
      "duration_seconds": 3.49,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.44,
      "end_seconds": 14.68,
      "duration_seconds": 5.24,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.54,
      "end_seconds": 18.46,
      "duration_seconds": 2.92,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.71,
      "end_seconds": 23.69,
      "duration_seconds": 3.98,
      "text": "Mm, um, she's been feeling sick, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.64,
      "end_seconds": 27.2,
      "duration_seconds": 2.56,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.4,
      "end_seconds": 32.46,
      "duration_seconds": 4.06,
      "text": "Um, I take aspirin, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.71,
      "end_seconds": 36.0,
      "duration_seconds": 2.29,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.2,
      "end_seconds": 49.94,
      "duration_seconds": 12.74,
      "text": "75 milligrams, I think that's what's on the box. Hmm, uh, I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 51.09,
      "end_seconds": 62.59,
      "duration_seconds": 11.5,
      "text": "Doctor, um, I think the last prescription for the alendronate was 35 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.4,
      "end_seconds": 67.41,
      "duration_seconds": 3.01,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.46,
      "end_seconds": 72.53,
      "duration_seconds": 4.07,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.22,
      "end_seconds": 89.65,
      "duration_seconds": 3.43,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.33,
      "end_seconds": 95.43,
      "duration_seconds": 5.1,
      "text": "Mm, um, around about a month, I think."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 96.75,
      "end_seconds": 101.69,
      "duration_seconds": 4.94,
      "text": "Yeah, it was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.83,
      "end_seconds": 107.77,
      "duration_seconds": 4.94,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.35,
      "end_seconds": 114.91,
      "duration_seconds": 3.56,
      "text": "I suppose so, you know, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 119.31,
      "duration_seconds": 3.35,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.1,
      "end_seconds": 124.14,
      "duration_seconds": 3.04,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.02,
      "end_seconds": 128.84,
      "duration_seconds": 3.82,
      "text": "Okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.86,
      "end_seconds": 139.39,
      "duration_seconds": 8.53,
      "text": "Blood in the urine goes along with it, uh, most of the time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.56,
      "end_seconds": 147.35,
      "duration_seconds": 4.79,
      "text": "Has there been not being able to lie still too?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.22,
      "end_seconds": 150.91,
      "duration_seconds": 1.69,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.64,
      "end_seconds": 157.09,
      "duration_seconds": 4.45,
      "text": "Let me check a few things. Any fever or vomiting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.11,
      "end_seconds": 162.26,
      "duration_seconds": 4.15,
      "text": "Ah, I haven't had fever or vomiting, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 168.52,
      "duration_seconds": 4.4,
      "text": "Did you get burning when passing urine or passing no urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.38,
      "end_seconds": 174.81,
      "duration_seconds": 4.43,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.78,
      "end_seconds": 180.07,
      "duration_seconds": 3.29,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.69,
      "end_seconds": 187.33,
      "duration_seconds": 1.64,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.07,
      "end_seconds": 193.58,
      "duration_seconds": 2.51,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.39,
      "end_seconds": 195.57,
      "duration_seconds": 1.18,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.31,
      "end_seconds": 215.82,
      "duration_seconds": 3.51,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.86,
      "end_seconds": 241.58,
      "duration_seconds": 20.72,
      "text": "I have heart disease, for nearly five years. Thin bones, for two years. I kept putting it off, which I know isn't sensible. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.83,
      "end_seconds": 248.48,
      "duration_seconds": 2.65,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.4,
      "end_seconds": 259.38,
      "duration_seconds": 8.98,
      "text": "Alright, heart disease, that matches what I have here. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.91,
      "end_seconds": 271.38,
      "duration_seconds": 11.47,
      "text": "No, I've never smoked in my life. Nothing, I'm teetotal. My partner and our baby. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.22,
      "end_seconds": 276.1,
      "duration_seconds": 3.88,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.85,
      "end_seconds": 284.52,
      "duration_seconds": 6.67,
      "text": "Well, my grandfather had a stroke. Actually, uh, my son has asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.39,
      "end_seconds": 287.66,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.45,
      "end_seconds": 294.14,
      "duration_seconds": 4.69,
      "text": "I mean, um, no, not at all."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.11,
      "end_seconds": 302.76,
      "duration_seconds": 4.65,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.66,
      "end_seconds": 318.22,
      "duration_seconds": 14.56,
      "text": "Hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 319.96,
      "end_seconds": 333.79,
      "duration_seconds": 13.83,
      "text": "Here are the numbers, doctor. Height 160 centimetres, respiratory rate 18, temp 36.5 degrees, oxygen saturation is 97 percent, BMI works out to 31.2, pressure 127 over 71, weight 80 kilos, pulse 75."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.05,
      "end_seconds": 335.75,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.08,
      "end_seconds": 341.43,
      "duration_seconds": 4.35,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.5,
      "end_seconds": 344.14,
      "duration_seconds": 1.64,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.59,
      "end_seconds": 361.68,
      "duration_seconds": 7.09,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.84,
      "end_seconds": 385.18,
      "duration_seconds": 20.34,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, my working impression is kidney stone colic. The reason I say that is that your story and my examination fit together. Another possibility is a urine infection."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.28,
      "end_seconds": 389.72,
      "duration_seconds": 3.44,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.5,
      "end_seconds": 406.75,
      "duration_seconds": 16.25,
      "text": "I can't promise yet, but most people with kidney stone colic do well once it's treated properly. Let me just check I've got this right. You've been feeling sick, mild, and no passing no urine or burning when passing urine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 408.01,
      "end_seconds": 411.64,
      "duration_seconds": 3.63,
      "text": "Yes, you know, you've got it."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 430.4,
      "end_seconds": 434.12,
      "duration_seconds": 3.72,
      "text": "We've already done a urine dipstick this morning, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.31,
      "end_seconds": 458.81,
      "duration_seconds": 23.5,
      "text": "Good, thanks for doing that. I think kidney function tests makes sense here, for renal colic. It's a routine test and it'll give us a much clearer picture. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 460.57,
      "end_seconds": 464.08,
      "duration_seconds": 3.51,
      "text": "I think I understand everything. Thanks."
    }
  ]
}