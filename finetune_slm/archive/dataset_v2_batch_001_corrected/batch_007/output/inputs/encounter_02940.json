{
  "schema_version": "1.0",
  "encounter_id": "02940",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 3.09,
      "duration_seconds": 1.74,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.92,
      "end_seconds": 5.07,
      "duration_seconds": 1.15,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.84,
      "end_seconds": 11.24,
      "duration_seconds": 4.4,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.41,
      "end_seconds": 18.77,
      "duration_seconds": 6.36,
      "text": "Of course, please stay. It's helpful to have you here. Where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.44,
      "end_seconds": 24.87,
      "duration_seconds": 4.43,
      "text": "He's been having a sudden high fever, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.48,
      "end_seconds": 28.7,
      "duration_seconds": 3.22,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.52,
      "end_seconds": 31.69,
      "duration_seconds": 2.17,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.84,
      "end_seconds": 35.13,
      "duration_seconds": 2.29,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.7,
      "end_seconds": 54.71,
      "duration_seconds": 19.01,
      "text": "Vomiting and diarrhoea goes along with it, most of the time. And there's a widespread sunburn-like rash as well, you know, about a week now. The vomiting and diarrhoea? That's been for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.68,
      "end_seconds": 77.8,
      "duration_seconds": 4.12,
      "text": "And what about sore throat, cough or stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.68,
      "end_seconds": 84.37,
      "duration_seconds": 4.69,
      "text": "No, no sore throat, cough or stiff neck."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.18,
      "end_seconds": 86.82,
      "duration_seconds": 1.64,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.32,
      "end_seconds": 90.45,
      "duration_seconds": 2.13,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.29,
      "end_seconds": 100.0,
      "duration_seconds": 4.71,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.53,
      "end_seconds": 104.31,
      "duration_seconds": 2.78,
      "text": "Depression, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.43,
      "end_seconds": 107.18,
      "duration_seconds": 1.75,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.84,
      "end_seconds": 111.68,
      "duration_seconds": 2.84,
      "text": "I've had an enlarged prostate, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.25,
      "end_seconds": 126.07,
      "duration_seconds": 13.82,
      "text": "Right, so depression and an enlarged prostate are already on your record. We'll keep that in mind today. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.45,
      "end_seconds": 129.7,
      "duration_seconds": 2.25,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.61,
      "end_seconds": 134.44,
      "duration_seconds": 2.83,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.2,
      "end_seconds": 154.69,
      "duration_seconds": 18.49,
      "text": "I have about eight cigarettes in a day. I work in accounts at a hospital. No, I share a house with my brother. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.5,
      "end_seconds": 172.77,
      "duration_seconds": 2.27,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.7,
      "end_seconds": 180.74,
      "duration_seconds": 7.04,
      "text": "I'm on something called sert... sertraline, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.75,
      "end_seconds": 185.75,
      "duration_seconds": 4.0,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.27,
      "end_seconds": 193.58,
      "duration_seconds": 7.31,
      "text": "No, it's at home. Tamsulosin. I take it at night for the prostate."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.63,
      "end_seconds": 197.81,
      "duration_seconds": 2.18,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.47,
      "end_seconds": 200.7,
      "duration_seconds": 2.23,
      "text": "It's 0.4 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 204.51,
      "duration_seconds": 2.13,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.01,
      "end_seconds": 208.31,
      "duration_seconds": 3.3,
      "text": "About two months. A tampon, in use."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.33,
      "end_seconds": 211.73,
      "duration_seconds": 2.4,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.41,
      "end_seconds": 216.05,
      "duration_seconds": 3.64,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.46,
      "end_seconds": 220.25,
      "duration_seconds": 2.79,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.43,
      "end_seconds": 224.16,
      "duration_seconds": 2.73,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 225.17,
      "end_seconds": 233.54,
      "duration_seconds": 8.37,
      "text": "Actually, I remember he had some kind of reaction to naproxen before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.7,
      "end_seconds": 237.1,
      "duration_seconds": 2.4,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.58,
      "end_seconds": 242.69,
      "duration_seconds": 4.11,
      "text": "Alright, fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.36,
      "end_seconds": 247.46,
      "duration_seconds": 2.1,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.51,
      "end_seconds": 252.52,
      "duration_seconds": 4.01,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.25,
      "end_seconds": 278.68,
      "duration_seconds": 9.43,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.34,
      "end_seconds": 286.12,
      "duration_seconds": 2.78,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.21,
      "end_seconds": 305.58,
      "duration_seconds": 9.37,
      "text": "Right, here's what I'm thinking. My working impression is possible toxic shock syndrome. Another possibility is a viral illness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.04,
      "end_seconds": 309.04,
      "duration_seconds": 2.0,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.31,
      "end_seconds": 330.87,
      "duration_seconds": 20.56,
      "text": "I understand the worry. At the moment I'd say it's possible toxic shock syndrome, and we'll know more once the a vaginal swab is back. Stop me if I've got anything wrong. You've had a sudden high fever for two months, and no sore throat or stiff neck."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.61,
      "end_seconds": 334.2,
      "duration_seconds": 1.59,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.83,
      "end_seconds": 345.15,
      "duration_seconds": 9.32,
      "text": "Let's book a vaginal swab to look into possible toxic shock. Blood cultures is what I'd like next, for possible toxic shock."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.24,
      "end_seconds": 350.02,
      "duration_seconds": 2.78,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.5,
      "end_seconds": 359.22,
      "duration_seconds": 7.72,
      "text": "You'll be taking flucloxacillin, 2 grams, now, single dose. That should help with possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.81,
      "end_seconds": 364.18,
      "duration_seconds": 3.37,
      "text": "Erm, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.0,
      "end_seconds": 390.14,
      "duration_seconds": 24.14,
      "text": "Remove any tampon, you are going to hospital now. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.42,
      "end_seconds": 394.73,
      "duration_seconds": 3.31,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.39,
      "end_seconds": 397.66,
      "duration_seconds": 1.27,
      "text": "Look after yourself."
    }
  ]
}