{
  "schema_version": "1.0",
  "encounter_id": "02597",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 4.67,
      "duration_seconds": 3.75,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 11.17,
      "duration_seconds": 5.14,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.11,
      "end_seconds": 20.11,
      "duration_seconds": 7.0,
      "text": "Honestly, it's a blister on my heel, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 25.16,
      "duration_seconds": 3.26,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.0,
      "end_seconds": 30.41,
      "duration_seconds": 4.41,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.51,
      "end_seconds": 33.51,
      "duration_seconds": 2.0,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.86,
      "end_seconds": 38.19,
      "duration_seconds": 3.33,
      "text": "I notice it more with new shoes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.54,
      "end_seconds": 41.18,
      "duration_seconds": 1.64,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.71,
      "end_seconds": 46.16,
      "duration_seconds": 3.45,
      "text": "I get some relief from a plaster."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.74,
      "end_seconds": 48.93,
      "duration_seconds": 2.19,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.88,
      "end_seconds": 58.69,
      "duration_seconds": 2.81,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.24,
      "end_seconds": 78.9,
      "duration_seconds": 8.66,
      "text": "Okay: pulse is 69 beats a minute, BP is 111 over 82, oxygen saturation is 97 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.54,
      "end_seconds": 82.65,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.58,
      "end_seconds": 87.24,
      "duration_seconds": 2.66,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.78,
      "end_seconds": 91.1,
      "duration_seconds": 2.32,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.99,
      "end_seconds": 94.8,
      "duration_seconds": 1.81,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.22,
      "end_seconds": 113.57,
      "duration_seconds": 6.35,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.41,
      "end_seconds": 119.04,
      "duration_seconds": 2.63,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.49,
      "end_seconds": 136.4,
      "duration_seconds": 2.91,
      "text": "And what about pus or redness spreading?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.4,
      "end_seconds": 143.73,
      "duration_seconds": 3.33,
      "text": "No, no pus or redness spreading."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.03,
      "end_seconds": 147.79,
      "duration_seconds": 2.76,
      "text": "Did you get diabetes or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.0,
      "end_seconds": 153.16,
      "duration_seconds": 4.16,
      "text": "Oh, um, no, no diabetes or fever."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.48,
      "end_seconds": 158.11,
      "duration_seconds": 3.63,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.19,
      "end_seconds": 161.32,
      "duration_seconds": 2.13,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.6,
      "end_seconds": 166.22,
      "duration_seconds": 3.62,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.8,
      "end_seconds": 169.38,
      "duration_seconds": 1.58,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.2,
      "end_seconds": 189.51,
      "duration_seconds": 5.31,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.71,
      "end_seconds": 206.35,
      "duration_seconds": 15.64,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. I do a yoga class on Thursdays. My husband and I live above the shop. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.71,
      "end_seconds": 212.79,
      "duration_seconds": 5.08,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.07,
      "end_seconds": 221.52,
      "duration_seconds": 4.45,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.11,
      "end_seconds": 225.37,
      "duration_seconds": 3.26,
      "text": "Okay, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.94,
      "end_seconds": 227.52,
      "duration_seconds": 1.58,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.95,
      "end_seconds": 245.08,
      "duration_seconds": 5.13,
      "text": "Okay, thinking it through, this looks most like a simple friction blister."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.9,
      "end_seconds": 249.13,
      "duration_seconds": 3.23,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.74,
      "end_seconds": 255.59,
      "duration_seconds": 5.85,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple friction blister."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.07,
      "end_seconds": 286.31,
      "duration_seconds": 12.24,
      "text": "Leave it intact, cover it with a padded plaster and change the shoes. Please don't wait if the area becomes red, hot or pus-filled. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.1,
      "end_seconds": 288.63,
      "duration_seconds": 1.53,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.09,
      "end_seconds": 295.6,
      "duration_seconds": 5.51,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.71,
      "end_seconds": 302.47,
      "duration_seconds": 3.76,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}