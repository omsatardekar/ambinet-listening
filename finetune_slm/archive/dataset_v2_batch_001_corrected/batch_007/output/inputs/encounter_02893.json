{
  "schema_version": "1.0",
  "encounter_id": "02893",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.81,
      "duration_seconds": 3.92,
      "text": "Ah, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 10.99,
      "duration_seconds": 4.54,
      "text": "Alright, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.02,
      "end_seconds": 14.74,
      "duration_seconds": 2.72,
      "text": "I'm here because of poor concentration."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.42,
      "end_seconds": 19.27,
      "duration_seconds": 3.85,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.3,
      "end_seconds": 25.93,
      "duration_seconds": 4.63,
      "text": "Let me think, I'm on paracetamol, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.43,
      "end_seconds": 32.74,
      "duration_seconds": 2.31,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.72,
      "end_seconds": 36.75,
      "duration_seconds": 2.03,
      "text": "It's, It's 1 gram."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.45,
      "end_seconds": 49.67,
      "duration_seconds": 3.22,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.96,
      "end_seconds": 60.41,
      "duration_seconds": 9.45,
      "text": "Since Friday, that's when it began. Let me think, I've been waking unrefreshed too. About waking unrefreshed, mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.67,
      "end_seconds": 77.34,
      "duration_seconds": 2.67,
      "text": "Any joint swelling, fever or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.77,
      "end_seconds": 84.03,
      "duration_seconds": 5.26,
      "text": "No joint swelling, fever or rash, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.66,
      "end_seconds": 88.09,
      "duration_seconds": 3.43,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.43,
      "end_seconds": 92.01,
      "duration_seconds": 2.58,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.35,
      "end_seconds": 112.09,
      "duration_seconds": 1.74,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.08,
      "end_seconds": 119.48,
      "duration_seconds": 2.4,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.71,
      "end_seconds": 123.8,
      "duration_seconds": 3.09,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.75,
      "end_seconds": 128.68,
      "duration_seconds": 3.93,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 134.56,
      "duration_seconds": 4.76,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.79,
      "end_seconds": 139.19,
      "duration_seconds": 3.4,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.91,
      "end_seconds": 143.97,
      "duration_seconds": 4.06,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.18,
      "end_seconds": 146.84,
      "duration_seconds": 1.66,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.48,
      "end_seconds": 151.81,
      "duration_seconds": 3.33,
      "text": "Right, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 165.68,
      "duration_seconds": 2.29,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.12,
      "end_seconds": 194.36,
      "duration_seconds": 14.24,
      "text": "Okay: blood pressure 113 over 77, temperature is 36.6 degrees. And respiratory rate 14, pulse 86, oxygen saturation is 98 percent, weight 89 kilos, height 169 centimetres, BMI works out to 31.2."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.21,
      "end_seconds": 198.67,
      "duration_seconds": 2.46,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.55,
      "end_seconds": 201.73,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.34,
      "end_seconds": 214.7,
      "duration_seconds": 5.36,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.62,
      "end_seconds": 228.16,
      "duration_seconds": 7.54,
      "text": "Okay, that's enough for me. Okay, thinking it through, I think we're dealing with fibromyalgia at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.44,
      "end_seconds": 234.62,
      "duration_seconds": 2.18,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.48,
      "end_seconds": 245.03,
      "duration_seconds": 6.55,
      "text": "I can't promise yet, but most people with fibromyalgia do well once it's treated properly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.22,
      "end_seconds": 294.56,
      "duration_seconds": 31.34,
      "text": "We should do blood tests for widespread pain. Let's use amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That should help with pain and sleep. It's a commonly used medicine and most people tolerate it well. Gentle graded exercise such as swimming helps more than rest. I'm going to send a referral to the pain clinic. Do get help quickly if the symptoms get worse. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.41,
      "end_seconds": 299.87,
      "duration_seconds": 3.46,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.16,
      "end_seconds": 303.42,
      "duration_seconds": 2.26,
      "text": "Thank you, that's helpful."
    }
  ]
}