{
  "schema_version": "1.0",
  "encounter_id": "02822",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.48,
      "duration_seconds": 3.19,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 9.78,
      "duration_seconds": 4.02,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 20.29,
      "duration_seconds": 9.53,
      "text": "Mainly a widespread rash with fever. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.9,
      "end_seconds": 24.11,
      "duration_seconds": 3.21,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.6,
      "end_seconds": 28.03,
      "duration_seconds": 2.43,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.98,
      "end_seconds": 32.65,
      "duration_seconds": 2.67,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.71,
      "end_seconds": 38.11,
      "duration_seconds": 3.4,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.85,
      "end_seconds": 43.8,
      "duration_seconds": 3.95,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.97,
      "end_seconds": 54.78,
      "duration_seconds": 9.81,
      "text": "Hmm, it's Foracort inhaler, twice a day for my asthma. I take allopurinol, 300 milligrams, started four weeks ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.18,
      "end_seconds": 59.37,
      "duration_seconds": 3.19,
      "text": "So, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.26,
      "end_seconds": 67.82,
      "duration_seconds": 6.56,
      "text": "Yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.35,
      "end_seconds": 75.99,
      "duration_seconds": 2.64,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.87,
      "end_seconds": 86.48,
      "duration_seconds": 9.61,
      "text": "I swim twice a week. I look after my grandchildren most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.35,
      "end_seconds": 91.3,
      "duration_seconds": 2.95,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.22,
      "end_seconds": 95.47,
      "duration_seconds": 2.25,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.88,
      "end_seconds": 107.87,
      "duration_seconds": 1.99,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.59,
      "end_seconds": 114.02,
      "duration_seconds": 3.43,
      "text": "I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.9,
      "end_seconds": 132.69,
      "duration_seconds": 2.79,
      "text": "Did you notice any breathing difficulty?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.29,
      "end_seconds": 135.3,
      "duration_seconds": 2.01,
      "text": "Nope, no breathing difficulty."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.09,
      "end_seconds": 139.1,
      "duration_seconds": 2.01,
      "text": "Any mouth sores or blisters?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.56,
      "end_seconds": 143.89,
      "duration_seconds": 3.33,
      "text": "Yeah, no, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.03,
      "end_seconds": 149.06,
      "duration_seconds": 4.03,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.56,
      "end_seconds": 155.42,
      "duration_seconds": 4.86,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.5,
      "end_seconds": 160.54,
      "duration_seconds": 4.04,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.83,
      "end_seconds": 164.46,
      "duration_seconds": 2.63,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.5,
      "end_seconds": 169.36,
      "duration_seconds": 3.86,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.85,
      "end_seconds": 181.41,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.29,
      "end_seconds": 185.09,
      "duration_seconds": 1.8,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.65,
      "end_seconds": 208.39,
      "duration_seconds": 6.74,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.42,
      "end_seconds": 219.01,
      "duration_seconds": 8.59,
      "text": "Good, you can sit up again. Having listened and examined, the most likely explanation is a severe drug reaction."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.34,
      "end_seconds": 222.54,
      "duration_seconds": 2.2,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.11,
      "end_seconds": 241.57,
      "duration_seconds": 17.46,
      "text": "I can't promise yet, but most people with a severe drug reaction do well once it's treated properly. Stop me if I've got anything wrong. You've had a widespread rash with fever, since yesterday, and no blisters or breathing difficulty."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.44,
      "end_seconds": 244.14,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.09,
      "end_seconds": 270.96,
      "duration_seconds": 15.87,
      "text": "We should do urgent blood tests for severe drug reaction. The treatment will be prednisolone, 40 milligrams, once a day, until review. You take it by mouth. It's for severe drug reaction."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.9,
      "end_seconds": 277.4,
      "duration_seconds": 4.5,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.27,
      "end_seconds": 293.41,
      "duration_seconds": 14.14,
      "text": "Stop the allopurinol now and you need admission. I think the dermatology team should see you too. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.4,
      "end_seconds": 296.94,
      "duration_seconds": 2.54,
      "text": "Alright, you know, I follow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.64,
      "end_seconds": 304.96,
      "duration_seconds": 6.32,
      "text": "Book a review straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.13,
      "end_seconds": 309.74,
      "duration_seconds": 3.61,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}