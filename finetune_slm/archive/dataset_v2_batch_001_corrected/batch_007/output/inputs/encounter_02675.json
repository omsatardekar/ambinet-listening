{
  "schema_version": "1.0",
  "encounter_id": "02675",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 6.37,
      "duration_seconds": 5.7,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 12.51,
      "duration_seconds": 4.18,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.03,
      "end_seconds": 18.47,
      "duration_seconds": 5.44,
      "text": "Uh, so the thing is, I've got being very confused."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.52,
      "end_seconds": 22.29,
      "duration_seconds": 1.77,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.24,
      "end_seconds": 26.99,
      "duration_seconds": 3.75,
      "text": "Uh, I've had it since Friday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.57,
      "end_seconds": 30.57,
      "duration_seconds": 3.0,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.53,
      "end_seconds": 34.1,
      "duration_seconds": 1.57,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.69,
      "end_seconds": 37.54,
      "duration_seconds": 2.85,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.23,
      "end_seconds": 51.36,
      "duration_seconds": 12.13,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. Lots of rice, lentils and some fruit. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.98,
      "end_seconds": 66.28,
      "duration_seconds": 4.3,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.98,
      "end_seconds": 71.2,
      "duration_seconds": 3.22,
      "text": "Yes, wheat, it gives me bloating."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 77.15,
      "duration_seconds": 4.72,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.94,
      "end_seconds": 79.89,
      "duration_seconds": 1.95,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.43,
      "end_seconds": 84.51,
      "duration_seconds": 3.08,
      "text": "So, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.28,
      "end_seconds": 90.73,
      "duration_seconds": 4.45,
      "text": "Hmm, you know, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.13,
      "end_seconds": 96.12,
      "duration_seconds": 3.99,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.2,
      "end_seconds": 101.36,
      "duration_seconds": 3.16,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 111.5,
      "duration_seconds": 1.44,
      "text": "What about fall?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.15,
      "end_seconds": 115.36,
      "duration_seconds": 3.21,
      "text": "No, I haven't had any fall."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.15,
      "end_seconds": 119.5,
      "duration_seconds": 3.35,
      "text": "Any chest pain or fever at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.34,
      "end_seconds": 123.56,
      "duration_seconds": 3.22,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.26,
      "end_seconds": 126.24,
      "duration_seconds": 1.98,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.05,
      "end_seconds": 128.82,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.41,
      "end_seconds": 131.66,
      "duration_seconds": 2.25,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.07,
      "end_seconds": 134.6,
      "duration_seconds": 1.53,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.27,
      "end_seconds": 147.68,
      "duration_seconds": 3.41,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.17,
      "end_seconds": 159.31,
      "duration_seconds": 2.14,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.76,
      "end_seconds": 186.42,
      "duration_seconds": 7.66,
      "text": "Okay: heart rate 100, BP is 95 over 61, temperature 36.9. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.6,
      "end_seconds": 189.58,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.56,
      "end_seconds": 193.86,
      "duration_seconds": 2.3,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.6,
      "end_seconds": 200.41,
      "duration_seconds": 3.81,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.87,
      "end_seconds": 203.05,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.59,
      "end_seconds": 217.14,
      "duration_seconds": 5.55,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.73,
      "end_seconds": 221.83,
      "duration_seconds": 1.1,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.92,
      "end_seconds": 226.73,
      "duration_seconds": 1.81,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.59,
      "end_seconds": 256.93,
      "duration_seconds": 12.34,
      "text": "Right, here's what I'm thinking. I'd lean towards a high calcium emergency. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.6,
      "end_seconds": 259.54,
      "duration_seconds": 1.94,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.72,
      "end_seconds": 286.03,
      "duration_seconds": 25.31,
      "text": "I can't promise yet, but most people with a high calcium emergency do well once it's treated properly. Let's get urgent blood tests, for confusion and polyuria. I think an ECG makes sense here, for hypercalcaemia. I'll start you on sodium chloride 0.9%, 1 litre, over one hour, single dose. That's for dehydration."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.08,
      "end_seconds": 292.26,
      "duration_seconds": 4.18,
      "text": "So, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.16,
      "end_seconds": 317.35,
      "duration_seconds": 23.19,
      "text": "You need hospital fluids and treatment now. Cut down on salt and fried food for now, it really does make a difference. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.95,
      "end_seconds": 320.92,
      "duration_seconds": 2.97,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}