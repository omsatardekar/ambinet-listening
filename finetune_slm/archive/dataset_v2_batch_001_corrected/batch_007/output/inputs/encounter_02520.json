{
  "schema_version": "1.0",
  "encounter_id": "02520",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.75,
      "end_seconds": 8.85,
      "duration_seconds": 8.1,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.6,
      "end_seconds": 13.86,
      "duration_seconds": 4.26,
      "text": "Right, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.33,
      "end_seconds": 20.12,
      "duration_seconds": 4.79,
      "text": "Right, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.55,
      "end_seconds": 25.02,
      "duration_seconds": 3.47,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.7,
      "end_seconds": 28.65,
      "duration_seconds": 2.95,
      "text": "He's been having difficulty concentrating, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.47,
      "end_seconds": 33.83,
      "duration_seconds": 3.36,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.69,
      "end_seconds": 37.61,
      "duration_seconds": 2.92,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.22,
      "end_seconds": 41.05,
      "duration_seconds": 2.83,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 61.07,
      "duration_seconds": 18.06,
      "text": "A four out of ten, I suppose. Erm, I've had impatience too, for about a week. About impatience, mild, I'd say. Oh, and restlessness. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 67.22,
      "duration_seconds": 2.02,
      "text": "Have you been losing things?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.99,
      "end_seconds": 72.36,
      "duration_seconds": 3.37,
      "text": "Yeah, I've had that since this morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.29,
      "end_seconds": 79.34,
      "duration_seconds": 5.05,
      "text": "Have you had difficulty concentrating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.76,
      "end_seconds": 89.67,
      "duration_seconds": 8.91,
      "text": "Right, yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.56,
      "end_seconds": 98.88,
      "duration_seconds": 7.32,
      "text": "Let me check a few things. Any thoughts of self-harm, head injury or drug use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.58,
      "end_seconds": 102.87,
      "duration_seconds": 3.29,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.76,
      "end_seconds": 107.26,
      "duration_seconds": 2.5,
      "text": "Have you had any low mood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.28,
      "end_seconds": 111.13,
      "duration_seconds": 2.85,
      "text": "No, none, no low mood."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.49,
      "end_seconds": 115.42,
      "duration_seconds": 2.93,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.13,
      "end_seconds": 118.89,
      "duration_seconds": 1.76,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.81,
      "end_seconds": 122.09,
      "duration_seconds": 2.28,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.93,
      "end_seconds": 125.39,
      "duration_seconds": 1.46,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.96,
      "end_seconds": 129.58,
      "duration_seconds": 3.62,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.46,
      "end_seconds": 134.95,
      "duration_seconds": 4.49,
      "text": "My son has asthma. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 152.47,
      "duration_seconds": 3.75,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.63,
      "end_seconds": 159.47,
      "duration_seconds": 5.84,
      "text": "I'm on clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 161.22,
      "end_seconds": 166.0,
      "duration_seconds": 4.78,
      "text": "Doctor, our chart from the last visit lists it as 37.5 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.41,
      "end_seconds": 173.02,
      "duration_seconds": 3.61,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.03,
      "end_seconds": 177.65,
      "duration_seconds": 3.62,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.96,
      "end_seconds": 181.7,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.87,
      "end_seconds": 188.47,
      "duration_seconds": 5.6,
      "text": "I've got gout. I have heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.95,
      "end_seconds": 196.53,
      "duration_seconds": 6.58,
      "text": "Alright, gout, that matches what I have here. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.29,
      "end_seconds": 202.12,
      "duration_seconds": 4.83,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.64,
      "end_seconds": 211.49,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.27,
      "end_seconds": 217.02,
      "duration_seconds": 3.75,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.27,
      "end_seconds": 220.77,
      "duration_seconds": 2.5,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.7,
      "end_seconds": 225.5,
      "duration_seconds": 3.8,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.62,
      "end_seconds": 232.06,
      "duration_seconds": 2.44,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.56,
      "end_seconds": 236.45,
      "duration_seconds": 3.89,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.88,
      "end_seconds": 259.96,
      "duration_seconds": 5.08,
      "text": "Okay, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.88,
      "end_seconds": 262.39,
      "duration_seconds": 1.51,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 262.9,
      "end_seconds": 269.98,
      "duration_seconds": 7.08,
      "text": "Hold on, doctor, I think he reacted to amoxicillin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.24,
      "end_seconds": 274.43,
      "duration_seconds": 3.19,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.34,
      "end_seconds": 279.82,
      "duration_seconds": 4.48,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 281.13,
      "end_seconds": 297.76,
      "duration_seconds": 16.63,
      "text": "Doctor, I've got the readings for you. Weight 53 kilos, temperature is 36.9 degrees, pulse 76, SpO2 98 percent on room air, blood pressure 111 over 71, BMI works out to 18.1, height 171 centimetres, respiratory rate 15."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 299.13,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.2,
      "end_seconds": 305.17,
      "duration_seconds": 4.97,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.28,
      "end_seconds": 308.42,
      "duration_seconds": 2.14,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.51,
      "end_seconds": 321.31,
      "duration_seconds": 4.8,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.96,
      "end_seconds": 340.88,
      "duration_seconds": 16.92,
      "text": "You can sit up now. From what you've told me and what I found, this is probably possible adult attention deficit disorder. The reason I say that is that your story and my examination fit together. I'd also keep anxiety in mind."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 342.29,
      "end_seconds": 344.21,
      "duration_seconds": 1.92,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.85,
      "end_seconds": 361.77,
      "duration_seconds": 14.92,
      "text": "I understand the worry. At the moment I'd say it's possible adult attention deficit disorder, and we'll know more once the a questionnaire is back. I think a questionnaire makes sense here, for attention problems."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.48,
      "end_seconds": 363.58,
      "duration_seconds": 1.1,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.78,
      "end_seconds": 369.64,
      "duration_seconds": 4.86,
      "text": "I'm going to order a thyroid test, for poor concentration."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.34,
      "end_seconds": 372.43,
      "duration_seconds": 2.09,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.16,
      "end_seconds": 391.44,
      "duration_seconds": 18.28,
      "text": "Use lists and reminders while we arrange the specialist assessment. The adult ADHD service would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 392.57,
      "end_seconds": 394.07,
      "duration_seconds": 1.5,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.29,
      "end_seconds": 399.37,
      "duration_seconds": 4.08,
      "text": "Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 401.06,
      "end_seconds": 402.54,
      "duration_seconds": 1.48,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.9,
      "end_seconds": 412.41,
      "duration_seconds": 5.51,
      "text": "Come back after the assessment. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 413.88,
      "end_seconds": 416.79,
      "duration_seconds": 2.91,
      "text": "I think I understand everything. Thanks."
    }
  ]
}