{
  "schema_version": "1.0",
  "encounter_id": "02776",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 4.58,
      "duration_seconds": 3.33,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 11.11,
      "duration_seconds": 4.52,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 16.84,
      "duration_seconds": 4.79,
      "text": "well, I've been having bright red blood on the paper"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.11,
      "end_seconds": 20.49,
      "duration_seconds": 2.38,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.01,
      "end_seconds": 29.52,
      "duration_seconds": 2.51,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.29,
      "end_seconds": 58.95,
      "duration_seconds": 7.66,
      "text": "Okay: temp 36.5 degrees, pulse is 64 beats a minute, BP is 111 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.71,
      "end_seconds": 62.98,
      "duration_seconds": 2.27,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.85,
      "end_seconds": 70.37,
      "duration_seconds": 6.52,
      "text": "I'll explain what these mean in a moment does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.22,
      "end_seconds": 85.42,
      "duration_seconds": 10.2,
      "text": "When it starts I tend to get itching as well. About itching, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.25,
      "end_seconds": 91.15,
      "duration_seconds": 3.9,
      "text": "And change in bowel habit, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.55,
      "end_seconds": 95.4,
      "duration_seconds": 2.85,
      "text": "Nope, no change in bowel habit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.32,
      "end_seconds": 102.22,
      "duration_seconds": 5.9,
      "text": "Let me check a few things. Any tummy pain, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.46,
      "end_seconds": 112.24,
      "duration_seconds": 5.78,
      "text": "no tummy pain, weight loss or black stools, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.75,
      "end_seconds": 116.88,
      "duration_seconds": 4.13,
      "text": "Okay, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.28,
      "end_seconds": 120.92,
      "duration_seconds": 2.64,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.73,
      "end_seconds": 125.61,
      "duration_seconds": 3.88,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.28,
      "end_seconds": 131.88,
      "duration_seconds": 1.6,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 143.84,
      "duration_seconds": 4.56,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.44,
      "end_seconds": 151.15,
      "duration_seconds": 5.71,
      "text": "Sumatriptan, 50 milligrams, when needed i take sitagliptin, once a day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.78,
      "end_seconds": 157.22,
      "duration_seconds": 2.44,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.01,
      "end_seconds": 170.08,
      "duration_seconds": 12.07,
      "text": "100 milligrams. Losartan, 50 milligrams, once a day for my blood pressure. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.32,
      "end_seconds": 190.06,
      "duration_seconds": 2.74,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.85,
      "end_seconds": 195.14,
      "duration_seconds": 3.29,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.71,
      "end_seconds": 200.05,
      "duration_seconds": 3.34,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.24,
      "end_seconds": 205.84,
      "duration_seconds": 4.6,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.27,
      "end_seconds": 211.31,
      "duration_seconds": 4.04,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.26,
      "end_seconds": 220.96,
      "duration_seconds": 7.7,
      "text": "I was told I'm allergic to walnuts, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.27,
      "end_seconds": 225.22,
      "duration_seconds": 2.95,
      "text": "Any surgery in the the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.12,
      "end_seconds": 230.81,
      "duration_seconds": 3.69,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.58,
      "end_seconds": 234.96,
      "duration_seconds": 3.38,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.82,
      "end_seconds": 238.48,
      "duration_seconds": 2.66,
      "text": "Migraines, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.28,
      "end_seconds": 239.98,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.06,
      "end_seconds": 242.17,
      "duration_seconds": 1.11,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.51,
      "end_seconds": 244.21,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.86,
      "end_seconds": 249.39,
      "duration_seconds": 3.53,
      "text": "High blood pressure, for about ten years"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.88,
      "end_seconds": 258.37,
      "duration_seconds": 7.49,
      "text": "okay, go on yes, high blood pressure is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.97,
      "end_seconds": 264.4,
      "duration_seconds": 4.43,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.49,
      "end_seconds": 267.49,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.81,
      "end_seconds": 286.45,
      "duration_seconds": 7.64,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.53,
      "end_seconds": 301.91,
      "duration_seconds": 13.38,
      "text": "All finished, thank you. So, based on the history and the examination, it points towards haemorrhoids. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.93,
      "end_seconds": 307.03,
      "duration_seconds": 3.1,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.96,
      "end_seconds": 316.79,
      "duration_seconds": 8.83,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a blood count is back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.67,
      "end_seconds": 343.88,
      "duration_seconds": 12.21,
      "text": "I think a blood count makes sense here, for rectal bleeding. I'm prescribing a haemorrhoid cream, 1 application, twice a day, one week. It's for haemorrhoids."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.84,
      "end_seconds": 348.88,
      "duration_seconds": 3.04,
      "text": "alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.91,
      "end_seconds": 360.58,
      "duration_seconds": 9.67,
      "text": "I'd like you to take lactulose, 15 ml, twice a day, four weeks. You take it by mouth. It's for constipation."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.63,
      "end_seconds": 365.94,
      "duration_seconds": 3.31,
      "text": "alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.62,
      "end_seconds": 378.86,
      "duration_seconds": 11.24,
      "text": "Eat more fibre and drink water. Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.96,
      "end_seconds": 382.92,
      "duration_seconds": 1.96,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.51,
      "end_seconds": 386.71,
      "duration_seconds": 3.2,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.38,
      "end_seconds": 392.25,
      "duration_seconds": 3.87,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}