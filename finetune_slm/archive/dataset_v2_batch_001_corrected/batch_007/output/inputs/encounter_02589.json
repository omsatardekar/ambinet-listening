{
  "schema_version": "1.0",
  "encounter_id": "02589",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 6.63,
      "duration_seconds": 5.25,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 12.08,
      "duration_seconds": 4.89,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.97,
      "end_seconds": 23.88,
      "duration_seconds": 9.91,
      "text": "Doctor, it's a sudden high fever. It's getting on my nerves now. There's dizziness on standing as well."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.39,
      "end_seconds": 34.58,
      "duration_seconds": 9.19,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.13,
      "end_seconds": 47.44,
      "duration_seconds": 12.31,
      "text": "um, you know, honestly, once or twice a day. About a seven out of ten. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.22,
      "end_seconds": 53.46,
      "duration_seconds": 4.24,
      "text": "what about a widespread sunburn-like rash, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.11,
      "end_seconds": 59.25,
      "duration_seconds": 4.14,
      "text": "Yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.64,
      "end_seconds": 66.23,
      "duration_seconds": 5.59,
      "text": "have you had a sudden high fever before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.97,
      "end_seconds": 72.04,
      "duration_seconds": 5.07,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.82,
      "end_seconds": 76.27,
      "duration_seconds": 2.45,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.68,
      "end_seconds": 90.13,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.8,
      "end_seconds": 121.47,
      "duration_seconds": 12.67,
      "text": "Okay: BMI works out to 26.4, oxygen saturation is 96 percent. And weight 71 kilos, height 164 centimetres, BP is 96 over 63, pulse 92, temperature is 37.1 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.85,
      "end_seconds": 124.4,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.32,
      "end_seconds": 129.69,
      "duration_seconds": 3.37,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.42,
      "end_seconds": 134.69,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.3,
      "end_seconds": 138.65,
      "duration_seconds": 2.35,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.38,
      "end_seconds": 163.6,
      "duration_seconds": 9.22,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.37,
      "end_seconds": 169.0,
      "duration_seconds": 1.63,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.76,
      "end_seconds": 180.89,
      "duration_seconds": 3.13,
      "text": "any sore throat, stiff neck or cough?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.56,
      "end_seconds": 186.33,
      "duration_seconds": 4.77,
      "text": "No sore throat, stiff neck or cough, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.58,
      "end_seconds": 190.47,
      "duration_seconds": 2.89,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.84,
      "end_seconds": 195.38,
      "duration_seconds": 1.54,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.09,
      "end_seconds": 198.14,
      "duration_seconds": 2.05,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.93,
      "end_seconds": 204.63,
      "duration_seconds": 5.7,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.89,
      "end_seconds": 207.27,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.97,
      "end_seconds": 210.7,
      "duration_seconds": 2.73,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.59,
      "end_seconds": 215.36,
      "duration_seconds": 3.77,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.25,
      "end_seconds": 221.66,
      "duration_seconds": 4.41,
      "text": "I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.07,
      "end_seconds": 239.51,
      "duration_seconds": 4.44,
      "text": "okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.5,
      "end_seconds": 250.12,
      "duration_seconds": 5.62,
      "text": "let me think, I have an underactive thyroid, for nearly five years"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.11,
      "end_seconds": 255.0,
      "duration_seconds": 3.89,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.71,
      "end_seconds": 271.33,
      "duration_seconds": 15.62,
      "text": "Thyroxine. I take it 75 micrograms, every morning for my thyroid. Sorry, I know I'm rambling a bit. It's a relief to finally sit down and talk about it. It's a tampon, in use."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.19,
      "end_seconds": 274.49,
      "duration_seconds": 1.3,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.31,
      "end_seconds": 279.52,
      "duration_seconds": 4.21,
      "text": "No, uh, I've never been operated on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.75,
      "end_seconds": 294.64,
      "duration_seconds": 13.89,
      "text": "Okay, thinking it through, it fits best with possible toxic shock syndrome. The reason I say that is that your story and my examination fit together. I can't rule out a viral illness yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.69,
      "end_seconds": 299.1,
      "duration_seconds": 3.41,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.2,
      "end_seconds": 310.38,
      "duration_seconds": 10.18,
      "text": "I understand the worry. At the moment I'd say it's possible toxic shock syndrome, and we'll know more once the blood cultures is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.44,
      "end_seconds": 336.22,
      "duration_seconds": 13.78,
      "text": "Blood cultures is what I'd like next, for possible toxic shock i'd like you to take flucloxacillin, 2 grams, now, single dose it's for possible toxic shock syndrome"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.2,
      "end_seconds": 340.88,
      "duration_seconds": 3.68,
      "text": "Well, should I take that with food?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.2,
      "end_seconds": 353.93,
      "duration_seconds": 11.73,
      "text": "Remove any tampon, you are going to hospital now. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.32,
      "end_seconds": 362.16,
      "duration_seconds": 7.84,
      "text": "right, right we'll catch up straight away right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.95,
      "end_seconds": 367.33,
      "duration_seconds": 3.38,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.12,
      "end_seconds": 370.98,
      "duration_seconds": 1.86,
      "text": "Have a good day."
    }
  ]
}