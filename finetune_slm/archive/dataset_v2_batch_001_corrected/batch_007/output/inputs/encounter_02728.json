{
  "schema_version": "1.0",
  "encounter_id": "02728",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 5.67,
      "duration_seconds": 4.27,
      "text": "Morning, um, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 10.22,
      "duration_seconds": 4.01,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.94,
      "end_seconds": 16.49,
      "duration_seconds": 5.55,
      "text": "Well, mainly I've been passing kidney stones. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.46,
      "end_seconds": 19.91,
      "duration_seconds": 2.45,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.9,
      "end_seconds": 33.2,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.16,
      "end_seconds": 68.63,
      "duration_seconds": 14.47,
      "text": "Okay: weight 53 kilos, BP is 113 over 81. And height 156 centimetres, temperature is 36.7 degrees, pulse is 80 beats a minute, BMI works out to 21.8, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.95,
      "end_seconds": 71.64,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.81,
      "end_seconds": 75.27,
      "duration_seconds": 2.46,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.84,
      "end_seconds": 95.99,
      "duration_seconds": 3.15,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.24,
      "end_seconds": 109.47,
      "duration_seconds": 12.23,
      "text": "About a month, I think... sorry, two months, I got that wrong. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.11,
      "end_seconds": 112.35,
      "duration_seconds": 2.24,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.13,
      "end_seconds": 126.99,
      "duration_seconds": 12.86,
      "text": "I mean, uh, when it starts I tend to get aching bones as well. So, the aching bones? That's been for two days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.88,
      "end_seconds": 129.62,
      "duration_seconds": 1.74,
      "text": "Any sign of fractures?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.13,
      "end_seconds": 131.69,
      "duration_seconds": 1.56,
      "text": "No. No fractures."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.14,
      "end_seconds": 137.59,
      "duration_seconds": 4.45,
      "text": "And what about weight loss, low mood or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.32,
      "end_seconds": 145.81,
      "duration_seconds": 2.49,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.75,
      "end_seconds": 150.12,
      "duration_seconds": 2.37,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.95,
      "end_seconds": 151.97,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 155.6,
      "duration_seconds": 2.32,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.23,
      "end_seconds": 158.15,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.9,
      "end_seconds": 163.44,
      "duration_seconds": 4.54,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.3,
      "end_seconds": 182.73,
      "duration_seconds": 18.43,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. I'm a bus driver, so I sit for long hours. I walk the dog every morning. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.59,
      "end_seconds": 186.58,
      "duration_seconds": 2.99,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.49,
      "end_seconds": 192.85,
      "duration_seconds": 4.36,
      "text": "Mm, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.43,
      "end_seconds": 198.22,
      "duration_seconds": 3.79,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.1,
      "end_seconds": 202.75,
      "duration_seconds": 2.65,
      "text": "I take thyroxine, every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.39,
      "end_seconds": 205.5,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.18,
      "end_seconds": 210.24,
      "duration_seconds": 4.06,
      "text": "It's 75 micrograms. Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.53,
      "end_seconds": 215.38,
      "duration_seconds": 3.85,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.03,
      "end_seconds": 219.76,
      "duration_seconds": 3.73,
      "text": "I mean, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.85,
      "end_seconds": 222.15,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.12,
      "end_seconds": 226.89,
      "duration_seconds": 3.77,
      "text": "Hmm, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.4,
      "end_seconds": 232.86,
      "duration_seconds": 2.46,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.24,
      "end_seconds": 236.98,
      "duration_seconds": 2.74,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.24,
      "end_seconds": 239.04,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.74,
      "end_seconds": 241.83,
      "duration_seconds": 1.09,
      "text": "Yes, COPD."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.64,
      "end_seconds": 249.5,
      "duration_seconds": 5.86,
      "text": "Okay, yes, an underactive thyroid is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.42,
      "end_seconds": 256.29,
      "duration_seconds": 3.87,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.14,
      "end_seconds": 259.51,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.69,
      "end_seconds": 273.29,
      "duration_seconds": 5.6,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.12,
      "end_seconds": 278.93,
      "duration_seconds": 1.81,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.89,
      "end_seconds": 306.41,
      "duration_seconds": 9.52,
      "text": "Okay, thinking it through, it points towards possible raised calcium from an overactive parathyroid. I can't rule out vitamin D excess yet."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.85,
      "end_seconds": 346.57,
      "duration_seconds": 29.72,
      "text": "I'll request a bone density scan, it'll help with possible hyperparathyroidism. The result will help us decide whether anything more is needed. I'd like to arrange a calcium and parathyroid hormone test for kidney stones. Drink plenty of water and avoid calcium supplements until the results. Do get help quickly if the symptoms get worse. Book a review after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.19,
      "end_seconds": 349.65,
      "duration_seconds": 2.46,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}