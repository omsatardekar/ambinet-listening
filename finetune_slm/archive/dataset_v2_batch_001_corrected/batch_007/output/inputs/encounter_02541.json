  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.28,
      "end_seconds": 6.02,
      "duration_seconds": 4.74,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 11.14,
      "duration_seconds": 4.2,
      "text": "Alright, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 27.88,
      "duration_seconds": 15.94,
      "text": "Let me think, so the thing is, I've got being thirsty. It's a relief to finally sit down and talk about it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.47,
      "end_seconds": 33.22,
      "duration_seconds": 3.75,
      "text": "Okay, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.86,
      "end_seconds": 35.42,
      "duration_seconds": 1.56,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.7,
      "end_seconds": 39.11,
      "duration_seconds": 2.41,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.92,
      "end_seconds": 43.23,
      "duration_seconds": 2.31,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.8,
      "end_seconds": 46.9,
      "duration_seconds": 3.1,
      "text": "I follow. Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.93,
      "end_seconds": 57.02,
      "duration_seconds": 9.09,
      "text": "Constipation goes along with it, most of the time. The, The constipation? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.16,
      "end_seconds": 65.77,
      "duration_seconds": 3.61,
      "text": "And what about low mood, fever or fractures?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.63,
      "end_seconds": 76.05,
      "duration_seconds": 6.42,
      "text": "Erm, no low mood, fever or fractures, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.98,
      "end_seconds": 80.5,
      "duration_seconds": 3.52,
      "text": "Have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.17,
      "end_seconds": 85.75,
      "duration_seconds": 3.58,
      "text": "Not that I've noticed, no weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.74,
      "end_seconds": 90.5,
      "duration_seconds": 2.76,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.34,
      "end_seconds": 94.67,
      "duration_seconds": 2.33,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.28,
      "end_seconds": 100.65,
      "duration_seconds": 4.37,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.7,
      "end_seconds": 105.37,
      "duration_seconds": 3.67,
      "text": "Yes, diclofenac, it gives me wheezing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.69,
      "end_seconds": 121.11,
      "duration_seconds": 3.42,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.76,
      "end_seconds": 125.35,
      "duration_seconds": 2.59,
      "text": "Gout, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.22,
      "end_seconds": 147.08,
      "duration_seconds": 3.86,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.92,
      "end_seconds": 154.92,
      "duration_seconds": 6.0,
      "text": "It's febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.31,
      "end_seconds": 159.03,
      "duration_seconds": 2.72,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.08,
      "end_seconds": 168.6,
      "duration_seconds": 4.52,
      "text": "Okay, um, so my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.31,
      "end_seconds": 184.75,
      "duration_seconds": 1.44,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.51,
      "end_seconds": 189.56,
      "duration_seconds": 3.05,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.45,
      "end_seconds": 193.9,
      "duration_seconds": 2.45,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.88,
      "end_seconds": 201.25,
      "duration_seconds": 5.37,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.78,
      "end_seconds": 203.98,
      "duration_seconds": 2.2,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.54,
      "end_seconds": 209.64,
      "duration_seconds": 4.1,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 210.27,
      "end_seconds": 223.84,
      "duration_seconds": 13.57,
      "text": "Here are the numbers, doctor. Height 164 centimetres, pulse 85, BP is 122 over 78, weight 57 kilos, temp 36.5 degrees, SpO2 97 percent on room air, BMI works out to 21.2."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.04,
      "end_seconds": 226.02,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.32,
      "end_seconds": 232.22,
      "duration_seconds": 3.9,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.0,
      "end_seconds": 234.51,
      "duration_seconds": 1.51,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.39,
      "end_seconds": 237.77,
      "duration_seconds": 2.38,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.37,
      "end_seconds": 253.83,
      "duration_seconds": 5.46,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.01,
      "end_seconds": 290.91,
      "duration_seconds": 31.9,
      "text": "Please sit back down. So, based on the history and the examination, this is probably possible raised calcium from an overactive parathyroid. I can't rule out vitamin D excess yet. I'm going to order a bone density scan, for possible hyperparathyroidism. Drink plenty of water and avoid calcium supplements until the results. A short walk every day, even twenty minutes, will help more than you'd think. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 297.34,
      "duration_seconds": 5.34,
      "text": "I'd like you back after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.32,
      "end_seconds": 303.8,
      "duration_seconds": 5.48,
      "text": "Let me think, um, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.01,
      "end_seconds": 306.23,
      "duration_seconds": 1.22,
      "text": "Take care now."
    }
  ]
