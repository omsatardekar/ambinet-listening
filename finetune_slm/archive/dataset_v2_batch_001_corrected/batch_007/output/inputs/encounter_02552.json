  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.16,
      "end_seconds": 6.82,
      "duration_seconds": 5.66,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 11.57,
      "duration_seconds": 3.85,
      "text": "perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.47,
      "end_seconds": 21.61,
      "duration_seconds": 8.14,
      "text": "hmm, uh, good afternoon, doctor i look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.14,
      "end_seconds": 26.05,
      "duration_seconds": 2.91,
      "text": "absolutely come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.94,
      "end_seconds": 30.74,
      "duration_seconds": 3.8,
      "text": "he's been having a rolled ankle, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.54,
      "end_seconds": 35.16,
      "duration_seconds": 3.62,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 39.33,
      "duration_seconds": 3.04,
      "text": "I've had it since last night"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.38,
      "end_seconds": 43.64,
      "duration_seconds": 3.26,
      "text": "is there something that that settles it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.72,
      "end_seconds": 56.19,
      "duration_seconds": 10.47,
      "text": "Uh you know it settles a a little with rest and ice. Erm I've also had some swelling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.89,
      "end_seconds": 63.11,
      "duration_seconds": 5.22,
      "text": "Have you had a rolled ankle before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.73,
      "end_seconds": 71.95,
      "duration_seconds": 7.22,
      "text": "okay, so a bit, about six months ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.48,
      "end_seconds": 76.26,
      "duration_seconds": 3.78,
      "text": "any pop numbness or pain in the shin?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.57,
      "end_seconds": 91.82,
      "duration_seconds": 14.25,
      "text": "no, no pop, no numbness, no pain in the shin i did have bruising at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.83,
      "end_seconds": 97.45,
      "duration_seconds": 3.62,
      "text": "Okay did you notice any pain in the foot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 103.17,
      "duration_seconds": 4.47,
      "text": "not that I've noticed no pain in the foot"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.58,
      "end_seconds": 107.96,
      "duration_seconds": 3.38,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.82,
      "end_seconds": 113.66,
      "duration_seconds": 1.84,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.19,
      "end_seconds": 115.56,
      "duration_seconds": 1.37,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.19,
      "end_seconds": 118.21,
      "duration_seconds": 2.02,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.92,
      "end_seconds": 123.17,
      "duration_seconds": 4.25,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.18,
      "end_seconds": 128.67,
      "duration_seconds": 3.49,
      "text": "no nothing as far as I know"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 129.41,
      "end_seconds": 136.6,
      "duration_seconds": 7.19,
      "text": "hold on, doctor, I think he reacted to erythromycin once. I'm not certain, though"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.59,
      "end_seconds": 140.63,
      "duration_seconds": 2.04,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.19,
      "end_seconds": 151.19,
      "duration_seconds": 10.0,
      "text": "alright, so that's unclear. I'll record what each of you said. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.79,
      "end_seconds": 157.59,
      "duration_seconds": 4.8,
      "text": "well I'm on escitalopram 10 milligrams once a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.4,
      "end_seconds": 161.92,
      "duration_seconds": 2.52,
      "text": "right when did you start it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 162.51,
      "end_seconds": 172.32,
      "duration_seconds": 9.81,
      "text": "Two years now it's, It's hydrocortisone cream, when needed it's ibuprofen gel, three times a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.03,
      "end_seconds": 176.04,
      "duration_seconds": 3.01,
      "text": "right, do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.38,
      "end_seconds": 181.94,
      "duration_seconds": 4.56,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.93,
      "end_seconds": 186.71,
      "duration_seconds": 2.78,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.75,
      "end_seconds": 192.51,
      "duration_seconds": 3.76,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.21,
      "end_seconds": 195.41,
      "duration_seconds": 2.2,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.45,
      "end_seconds": 209.46,
      "duration_seconds": 10.01,
      "text": "I have anxiety. I have eczema for two years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.51,
      "end_seconds": 218.84,
      "duration_seconds": 7.33,
      "text": "Yes, anxiety is known to us, good to have that clear. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.84,
      "end_seconds": 226.5,
      "duration_seconds": 6.66,
      "text": "uh, yes, I had part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.09,
      "end_seconds": 230.43,
      "duration_seconds": 3.34,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.25,
      "end_seconds": 237.88,
      "duration_seconds": 6.63,
      "text": "right you know my cousin has psoriasis oh my father had bowel cancer"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 248.2,
      "end_seconds": 259.22,
      "duration_seconds": 11.02,
      "text": "okay, so the vitals from earlier respiratory rate 14, pulse 72. Blood pressure 128 over 81, temperature is 36.6 degrees, oxygen saturation is 97 percent"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.99,
      "end_seconds": 260.69,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.07,
      "end_seconds": 265.28,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.6,
      "end_seconds": 268.23,
      "duration_seconds": 1.63,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.72,
      "end_seconds": 289.17,
      "duration_seconds": 7.45,
      "text": "there is mild swelling over the outer ankle but no bony tenderness and you can take four steps"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.03,
      "end_seconds": 299.93,
      "duration_seconds": 6.9,
      "text": "please sit back down putting it all together, the most likely explanation is a mild ankle sprain"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 300.83,
      "end_seconds": 304.42,
      "duration_seconds": 3.59,
      "text": "is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 314.04,
      "duration_seconds": 8.88,
      "text": "I understand the the worry. At the moment I'd say it's a mild ankle sprain and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.0,
      "end_seconds": 334.23,
      "duration_seconds": 8.23,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. We'll catch up if not better in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 335.22,
      "end_seconds": 340.22,
      "duration_seconds": 5.0,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.82,
      "end_seconds": 344.22,
      "duration_seconds": 3.4,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.69,
      "end_seconds": 349.02,
      "duration_seconds": 3.33,
      "text": "alright, um, thanks, take care"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.88,
      "end_seconds": 351.09,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}