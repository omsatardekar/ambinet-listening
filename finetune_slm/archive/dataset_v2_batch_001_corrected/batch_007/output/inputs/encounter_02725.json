{
  "schema_version": "1.0",
  "encounter_id": "02725",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 5.91,
      "duration_seconds": 4.61,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.91,
      "end_seconds": 9.13,
      "duration_seconds": 1.22,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.28,
      "end_seconds": 13.32,
      "duration_seconds": 3.04,
      "text": "Was it a long journey this morning?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.39,
      "end_seconds": 17.96,
      "duration_seconds": 3.57,
      "text": "Not too bad, the roads were quiet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.5,
      "end_seconds": 20.72,
      "duration_seconds": 2.22,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.19,
      "end_seconds": 26.04,
      "duration_seconds": 3.85,
      "text": "Well, I've been having breathlessness building over weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.1,
      "end_seconds": 34.75,
      "duration_seconds": 3.65,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.61,
      "end_seconds": 37.66,
      "duration_seconds": 2.05,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.7,
      "end_seconds": 49.11,
      "duration_seconds": 9.41,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.18,
      "end_seconds": 58.42,
      "duration_seconds": 7.24,
      "text": "Mostly severe. It's once or twice a day. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 80.58,
      "duration_seconds": 4.45,
      "text": "A few quick ones: coughing up blood, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.63,
      "end_seconds": 88.01,
      "duration_seconds": 5.38,
      "text": "No coughing up blood, fever or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.91,
      "end_seconds": 94.72,
      "duration_seconds": 4.81,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.28,
      "end_seconds": 100.71,
      "duration_seconds": 1.43,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.67,
      "end_seconds": 105.36,
      "duration_seconds": 3.69,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.02,
      "end_seconds": 109.24,
      "duration_seconds": 2.22,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.03,
      "end_seconds": 129.03,
      "duration_seconds": 2.0,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.58,
      "end_seconds": 132.24,
      "duration_seconds": 1.66,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.09,
      "end_seconds": 138.14,
      "duration_seconds": 4.05,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.2,
      "end_seconds": 140.7,
      "duration_seconds": 1.5,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 163.17,
      "duration_seconds": 4.21,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.12,
      "end_seconds": 168.48,
      "duration_seconds": 4.36,
      "text": "Um, yes, wheat. I get itchy skin."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.44,
      "end_seconds": 178.59,
      "duration_seconds": 5.15,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.14,
      "end_seconds": 193.96,
      "duration_seconds": 13.82,
      "text": "I've never touched a cigarette. Yes, I work in a bakery, early starts. My partner and our baby. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.69,
      "end_seconds": 198.65,
      "duration_seconds": 2.96,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.43,
      "end_seconds": 213.79,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.86,
      "end_seconds": 242.35,
      "duration_seconds": 9.49,
      "text": "Okay: BP is 122 over 76, respiratory rate 26, heart rate 93, SpO2 94 percent on room air, temp 37.2 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.7,
      "end_seconds": 246.96,
      "duration_seconds": 3.26,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.57,
      "end_seconds": 265.5,
      "duration_seconds": 0.93,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.21,
      "end_seconds": 269.73,
      "duration_seconds": 2.52,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 282.14,
      "duration_seconds": 5.09,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.71,
      "end_seconds": 300.64,
      "duration_seconds": 12.93,
      "text": "Right, you can relax now. Let me tell you where I've got to. I can't pin this down yet. We're looking at a pleural effusion needing a cause or a tumour."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.76,
      "end_seconds": 305.03,
      "duration_seconds": 3.27,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 324.83,
      "duration_seconds": 14.91,
      "text": "It's reasonable to be concerned, but right now a pleural effusion needing a cause is my leading thought, not anything worse. I'd like to arrange a pleural fluid sample for pleural effusion."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.9,
      "end_seconds": 327.94,
      "duration_seconds": 1.04,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.4,
      "end_seconds": 346.68,
      "duration_seconds": 17.28,
      "text": "I am arranging an urgent chest clinic review. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.5,
      "end_seconds": 350.84,
      "duration_seconds": 2.34,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.16,
      "end_seconds": 353.58,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}