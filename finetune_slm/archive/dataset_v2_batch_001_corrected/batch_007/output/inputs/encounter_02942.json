{
  "schema_version": "1.0",
  "encounter_id": "02942",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 3.77,
      "duration_seconds": 3.08,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.58,
      "end_seconds": 6.64,
      "duration_seconds": 1.06,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.44,
      "end_seconds": 12.89,
      "duration_seconds": 4.45,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.93,
      "end_seconds": 20.17,
      "duration_seconds": 5.24,
      "text": "Please do. Extra information is always welcome. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.91,
      "end_seconds": 28.53,
      "duration_seconds": 6.62,
      "text": "I mean, it's itchy blisters. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.95,
      "end_seconds": 37.11,
      "duration_seconds": 3.16,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.05,
      "end_seconds": 39.5,
      "duration_seconds": 1.45,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.25,
      "end_seconds": 43.26,
      "duration_seconds": 2.01,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.36,
      "end_seconds": 46.98,
      "duration_seconds": 2.62,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.47,
      "end_seconds": 53.93,
      "duration_seconds": 6.46,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 54.03,
      "end_seconds": 59.63,
      "duration_seconds": 5.6,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.41,
      "end_seconds": 69.97,
      "duration_seconds": 8.56,
      "text": "I was getting to that! I've had raw areas where blisters burst too, for six months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.82,
      "end_seconds": 79.64,
      "duration_seconds": 5.82,
      "text": "Have you had itchy blisters before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.67,
      "end_seconds": 88.43,
      "duration_seconds": 6.76,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 89.92,
      "end_seconds": 92.83,
      "duration_seconds": 2.91,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.0,
      "end_seconds": 97.05,
      "duration_seconds": 3.05,
      "text": "Have you noticed fever or mouth sores?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.98,
      "end_seconds": 111.48,
      "duration_seconds": 13.5,
      "text": "No, um, no fever, no mouth sores. I did have an itchy rash first at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.32,
      "end_seconds": 115.69,
      "duration_seconds": 3.37,
      "text": "Have you noticed eye problems or new medicine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.37,
      "end_seconds": 120.92,
      "duration_seconds": 4.55,
      "text": "No eye problems or new medicine, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.94,
      "end_seconds": 127.04,
      "duration_seconds": 4.1,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.95,
      "end_seconds": 132.19,
      "duration_seconds": 4.24,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.75,
      "end_seconds": 137.33,
      "duration_seconds": 4.58,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.87,
      "end_seconds": 153.65,
      "duration_seconds": 15.78,
      "text": "Well, you know, yes, grass pollen. I've no idea what the reaction was, only that I'm not supposed to have it. Actually, yes, naproxen, it gives me a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.88,
      "end_seconds": 158.62,
      "duration_seconds": 3.74,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.12,
      "end_seconds": 171.31,
      "duration_seconds": 11.19,
      "text": "I have high blood pressure, for nearly five years. I've had thin bones, yes. Um, I've had eczema for about a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.69,
      "end_seconds": 179.69,
      "duration_seconds": 7.0,
      "text": "I see, go ahead. Alright, high blood pressure and eczema, that matches what I have here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.23,
      "end_seconds": 195.49,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.82,
      "end_seconds": 199.81,
      "duration_seconds": 2.99,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.68,
      "end_seconds": 202.75,
      "duration_seconds": 2.07,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.71,
      "end_seconds": 207.44,
      "duration_seconds": 3.73,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.29,
      "end_seconds": 212.55,
      "duration_seconds": 3.26,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.41,
      "end_seconds": 216.69,
      "duration_seconds": 2.28,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.54,
      "end_seconds": 219.92,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.5,
      "end_seconds": 228.92,
      "duration_seconds": 7.42,
      "text": "It's, It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.93,
      "end_seconds": 234.3,
      "duration_seconds": 3.37,
      "text": "Okay, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.87,
      "end_seconds": 247.64,
      "duration_seconds": 12.77,
      "text": "For my pressure, I believe. My wife sets them out for me, I just take what I'm given. Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_6",
      "role": "NURSE",
      "start_seconds": 248.24,
      "end_seconds": 252.99,
      "duration_seconds": 4.75,
      "text": "Doctor, our chart from the last visit lists it as 35 milligrams."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.62,
      "end_seconds": 258.06,
      "duration_seconds": 4.44,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.51,
      "end_seconds": 268.96,
      "duration_seconds": 9.45,
      "text": "I don't think I have it with me. Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 270.14,
      "end_seconds": 277.54,
      "duration_seconds": 7.4,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_6",
      "role": "NURSE",
      "start_seconds": 279.54,
      "end_seconds": 290.89,
      "duration_seconds": 11.35,
      "text": "Doctor, I've got the readings for you. Pulse 65, SpO2 97 percent on room air, temperature is 36.9 degrees, respiratory rate 18, BP is 122 over 75."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.54,
      "end_seconds": 292.24,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.22,
      "end_seconds": 298.0,
      "duration_seconds": 3.78,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.28,
      "end_seconds": 301.03,
      "duration_seconds": 1.75,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.59,
      "end_seconds": 324.94,
      "duration_seconds": 6.35,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.37,
      "end_seconds": 343.32,
      "duration_seconds": 12.95,
      "text": "You can sit up now. Having listened and examined, I don't have a clear answer today: bullous pemphigoid is possible, and so is pemphigus. We shouldn't forget a drug reaction."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.56,
      "end_seconds": 347.58,
      "duration_seconds": 3.02,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.11,
      "end_seconds": 356.93,
      "duration_seconds": 7.82,
      "text": "I understand the worry. At the moment I'd say it's bullous pemphigoid, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.39,
      "end_seconds": 384.7,
      "duration_seconds": 15.31,
      "text": "Do not burst the blisters and keep the raw areas dressed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.06,
      "end_seconds": 389.8,
      "duration_seconds": 3.74,
      "text": "Erm, great, thank you for your help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.33,
      "end_seconds": 391.7,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}