{
  "schema_version": "1.0",
  "encounter_id": "02991",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 6.88,
      "duration_seconds": 5.5,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.46,
      "end_seconds": 12.71,
      "duration_seconds": 4.25,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.07,
      "end_seconds": 20.46,
      "duration_seconds": 6.39,
      "text": "Mainly swollen face. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.96,
      "end_seconds": 25.23,
      "duration_seconds": 3.27,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.4,
      "end_seconds": 39.87,
      "duration_seconds": 2.47,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.64,
      "end_seconds": 65.62,
      "duration_seconds": 9.98,
      "text": "Okay: pulse is 95 beats a minute, SpO2 96 percent on room air, temp 38.5 degrees, blood pressure 108 over 68."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.4,
      "end_seconds": 88.38,
      "duration_seconds": 5.98,
      "text": "what's the timeline, when did it begin? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.1,
      "end_seconds": 91.8,
      "duration_seconds": 2.7,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.28,
      "end_seconds": 98.16,
      "duration_seconds": 2.88,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.8,
      "end_seconds": 104.77,
      "duration_seconds": 1.97,
      "text": "I'd call it mild"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.23,
      "end_seconds": 110.47,
      "duration_seconds": 4.24,
      "text": "have you noticed blisters breathing difficulty or mouth sores?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.09,
      "end_seconds": 115.81,
      "duration_seconds": 4.72,
      "text": "I haven't had blisters, breathing difficulty or mouth sores, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.04,
      "end_seconds": 120.58,
      "duration_seconds": 4.54,
      "text": "okay go on any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.07,
      "end_seconds": 123.87,
      "duration_seconds": 1.8,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.58,
      "end_seconds": 126.91,
      "duration_seconds": 2.33,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.33,
      "end_seconds": 130.65,
      "duration_seconds": 2.32,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.47,
      "end_seconds": 132.7,
      "duration_seconds": 1.23,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.27,
      "end_seconds": 137.57,
      "duration_seconds": 4.3,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.9,
      "end_seconds": 143.66,
      "duration_seconds": 4.76,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.17,
      "end_seconds": 145.63,
      "duration_seconds": 1.46,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.54,
      "end_seconds": 151.28,
      "duration_seconds": 4.74,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.04,
      "end_seconds": 158.64,
      "duration_seconds": 2.6,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.2,
      "end_seconds": 173.39,
      "duration_seconds": 5.19,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.85,
      "end_seconds": 181.6,
      "duration_seconds": 6.75,
      "text": "years back I got stomach pain from naproxen so I stay away from it now"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.45,
      "end_seconds": 185.7,
      "duration_seconds": 3.25,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.79,
      "end_seconds": 195.79,
      "duration_seconds": 9.0,
      "text": "I take allopurinol 300 milligrams started four weeks ago. I've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.49,
      "end_seconds": 201.45,
      "duration_seconds": 3.96,
      "text": "now I'm going to do a a short physical check"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 206.11,
      "duration_seconds": 2.68,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.99,
      "end_seconds": 229.67,
      "duration_seconds": 6.68,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.82,
      "end_seconds": 240.6,
      "duration_seconds": 1.78,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.1,
      "end_seconds": 246.16,
      "duration_seconds": 3.06,
      "text": "so, you can sit up now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.29,
      "end_seconds": 272.72,
      "duration_seconds": 8.43,
      "text": "putting it all together, this looks most like a severe drug reaction let's get urgent blood tests, for severe drug reaction"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.28,
      "end_seconds": 275.17,
      "duration_seconds": 1.89,
      "text": "Okay I'll do it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.87,
      "end_seconds": 299.6,
      "duration_seconds": 23.73,
      "text": "I'll start you on prednisolone, 40 milligrams, once a day, until review. You take it by mouth. That's for severe drug reaction. Stop the allopurinol now and you need admission. I'd like you to see the dermatology team as well, and I'll write the referral. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.25,
      "end_seconds": 303.02,
      "duration_seconds": 1.77,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.8,
      "end_seconds": 313.12,
      "duration_seconds": 8.32,
      "text": "Please come and see me straight away. So that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.94,
      "end_seconds": 320.46,
      "duration_seconds": 3.52,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.0,
      "end_seconds": 322.4,
      "duration_seconds": 1.4,
      "text": "goodbye for now"
    }
  ]
}