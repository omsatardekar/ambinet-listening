{
  "schema_version": "1.0",
  "encounter_id": "02573",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 4.15,
      "duration_seconds": 3.44,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.17,
      "end_seconds": 14.11,
      "duration_seconds": 4.94,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.79,
      "end_seconds": 23.1,
      "duration_seconds": 8.31,
      "text": "Well, I've been having itchy blisters. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.13,
      "end_seconds": 31.37,
      "duration_seconds": 3.24,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.46,
      "end_seconds": 34.93,
      "duration_seconds": 2.47,
      "text": "For two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.03,
      "end_seconds": 41.91,
      "duration_seconds": 5.88,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.63,
      "end_seconds": 45.22,
      "duration_seconds": 2.59,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.16,
      "end_seconds": 48.22,
      "duration_seconds": 2.06,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.19,
      "end_seconds": 63.33,
      "duration_seconds": 13.14,
      "text": "When it starts I tend to get raw areas where blisters burst as well. The raw areas where blisters burst? That's been for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.67,
      "end_seconds": 64.37,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.3,
      "end_seconds": 85.44,
      "duration_seconds": 4.14,
      "text": "Have you noticed mouth sores, eye problems or new medicine?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.45,
      "end_seconds": 92.77,
      "duration_seconds": 5.32,
      "text": "No, no mouth sores, eye problems or new medicine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.21,
      "end_seconds": 96.56,
      "duration_seconds": 2.35,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.37,
      "end_seconds": 98.93,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.53,
      "end_seconds": 105.06,
      "duration_seconds": 4.53,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.8,
      "end_seconds": 109.17,
      "duration_seconds": 3.37,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.36,
      "end_seconds": 130.2,
      "duration_seconds": 2.84,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.95,
      "end_seconds": 133.5,
      "duration_seconds": 2.55,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.02,
      "end_seconds": 140.72,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.33,
      "end_seconds": 142.84,
      "duration_seconds": 1.51,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.95,
      "end_seconds": 150.55,
      "duration_seconds": 3.6,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.26,
      "end_seconds": 156.79,
      "duration_seconds": 1.53,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.77,
      "end_seconds": 162.42,
      "duration_seconds": 4.65,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.02,
      "end_seconds": 180.44,
      "duration_seconds": 16.42,
      "text": "I have about eight cigarettes in a day. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.19,
      "end_seconds": 185.0,
      "duration_seconds": 2.81,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.25,
      "end_seconds": 187.72,
      "duration_seconds": 1.47,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.48,
      "end_seconds": 191.4,
      "duration_seconds": 2.92,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.98,
      "end_seconds": 206.99,
      "duration_seconds": 3.01,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.41,
      "end_seconds": 239.39,
      "duration_seconds": 12.98,
      "text": "Okay: temp 36.4 degrees, height 158 centimetres, weight 53 kilos, SpO2 97 percent on room air, pulse is 75 beats a minute, pressure 118 over 74."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.21,
      "end_seconds": 245.61,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.38,
      "end_seconds": 250.59,
      "duration_seconds": 3.21,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.09,
      "end_seconds": 256.4,
      "duration_seconds": 3.31,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.3,
      "end_seconds": 259.5,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.87,
      "end_seconds": 279.53,
      "duration_seconds": 6.66,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.99,
      "end_seconds": 281.9,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.0,
      "end_seconds": 289.99,
      "duration_seconds": 2.99,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.51,
      "end_seconds": 309.7,
      "duration_seconds": 6.19,
      "text": "From what you've told me and what I found, it fits best with bullous pemphigoid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.41,
      "end_seconds": 313.33,
      "duration_seconds": 1.92,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.44,
      "end_seconds": 320.12,
      "duration_seconds": 5.68,
      "text": "Nothing I've seen today points to an emergency. It looks like bullous pemphigoid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.12,
      "end_seconds": 342.63,
      "duration_seconds": 8.51,
      "text": "Do not burst the blisters and keep the raw areas dressed. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.8,
      "end_seconds": 347.36,
      "duration_seconds": 3.56,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}