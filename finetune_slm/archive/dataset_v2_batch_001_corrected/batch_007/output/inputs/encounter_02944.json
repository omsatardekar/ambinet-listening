{
  "schema_version": "1.0",
  "encounter_id": "02944",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 6.01,
      "duration_seconds": 4.85,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 10.42,
      "duration_seconds": 3.72,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.31,
      "end_seconds": 16.17,
      "duration_seconds": 4.86,
      "text": "So, uh, I've been feeling tired and low, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.98,
      "end_seconds": 20.85,
      "duration_seconds": 3.87,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.18,
      "end_seconds": 27.05,
      "duration_seconds": 4.87,
      "text": "I'd say four weeks. Actually, no, closer to three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.27,
      "end_seconds": 31.44,
      "duration_seconds": 4.17,
      "text": "Right, right. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.14,
      "end_seconds": 37.62,
      "duration_seconds": 4.48,
      "text": "A six out of ten, you know, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.33,
      "end_seconds": 43.04,
      "duration_seconds": 4.71,
      "text": "What about difficulty getting out of bed, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.32,
      "end_seconds": 45.48,
      "duration_seconds": 1.16,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.93,
      "end_seconds": 50.36,
      "duration_seconds": 4.43,
      "text": "Right, right. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.26,
      "end_seconds": 60.9,
      "duration_seconds": 9.64,
      "text": "Yes, milk. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.25,
      "end_seconds": 79.63,
      "duration_seconds": 1.38,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.53,
      "end_seconds": 84.77,
      "duration_seconds": 3.24,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.3,
      "end_seconds": 87.62,
      "duration_seconds": 1.32,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.11,
      "end_seconds": 92.7,
      "duration_seconds": 3.59,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.77,
      "end_seconds": 97.0,
      "duration_seconds": 2.23,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.86,
      "end_seconds": 102.99,
      "duration_seconds": 4.13,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.75,
      "end_seconds": 107.93,
      "duration_seconds": 4.18,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.45,
      "end_seconds": 113.53,
      "duration_seconds": 4.08,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.47,
      "end_seconds": 118.03,
      "duration_seconds": 2.56,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.24,
      "end_seconds": 123.27,
      "duration_seconds": 4.03,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 144.83,
      "duration_seconds": 2.93,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.0,
      "end_seconds": 148.9,
      "duration_seconds": 2.9,
      "text": "I have heart failure. Yes, diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.59,
      "end_seconds": 168.71,
      "duration_seconds": 3.12,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.93,
      "end_seconds": 178.47,
      "duration_seconds": 8.54,
      "text": "Metoprolol i take it 50 milligrams, twice a day well, it's sitagliptin, 100 milligrams, once a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.98,
      "end_seconds": 184.05,
      "duration_seconds": 5.07,
      "text": "alright, any visual changes, jaw pain on chewing, weight loss or headache?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.42,
      "end_seconds": 188.11,
      "duration_seconds": 2.69,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.18,
      "end_seconds": 193.1,
      "duration_seconds": 2.92,
      "text": "so, has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.96,
      "end_seconds": 195.05,
      "duration_seconds": 1.09,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.83,
      "end_seconds": 199.71,
      "duration_seconds": 2.88,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.61,
      "end_seconds": 204.48,
      "duration_seconds": 2.87,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 228.89,
      "duration_seconds": 6.38,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.52,
      "end_seconds": 238.7,
      "duration_seconds": 7.18,
      "text": "okay, that's enough for me. Right, here's what I'm thinking. My working impression is polymyalgia rheumatica"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.95,
      "end_seconds": 242.05,
      "duration_seconds": 2.1,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.52,
      "end_seconds": 251.15,
      "duration_seconds": 7.63,
      "text": "It's reasonable to be concerned, but right now polymyalgia rheumatica is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.74,
      "end_seconds": 269.26,
      "duration_seconds": 3.52,
      "text": "We should do blood tests for proximal stiffness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.83,
      "end_seconds": 272.01,
      "duration_seconds": 2.18,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.23,
      "end_seconds": 298.37,
      "duration_seconds": 25.14,
      "text": "What I'm giving you is prednisolone, 15 milligrams, once a day, reducing course. It's for polymyalgia rheumatica. Report any headache or jaw pain immediately. If you get a new headache or visual changes, that's the point to come in urgently. Let's plan a check in two weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.22,
      "end_seconds": 309.1,
      "duration_seconds": 9.88,
      "text": "So, I take the prednisolone, 15 milligrams, once a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.11,
      "end_seconds": 315.28,
      "duration_seconds": 4.17,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.84,
      "end_seconds": 318.3,
      "duration_seconds": 1.46,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.31,
      "end_seconds": 320.53,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}