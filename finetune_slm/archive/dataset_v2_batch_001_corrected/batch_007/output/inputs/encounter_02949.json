{
  "schema_version": "1.0",
  "encounter_id": "02949",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 5.45,
      "duration_seconds": 4.05,
      "text": "hello? Doctor? I was told to to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.75,
      "duration_seconds": 4.42,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.62,
      "end_seconds": 22.11,
      "duration_seconds": 6.49,
      "text": "good afternoon, doctor i look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.14,
      "end_seconds": 26.54,
      "duration_seconds": 3.4,
      "text": "yes, that's no problem at all. Please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.04,
      "end_seconds": 35.32,
      "duration_seconds": 7.28,
      "text": "Sorry, what was I saying, I'm here because of breathlessness building over weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.62,
      "end_seconds": 43.94,
      "duration_seconds": 3.32,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.32,
      "end_seconds": 56.46,
      "duration_seconds": 11.14,
      "text": "It feels severe to me. And a dull ache on one side of the chest, too. I've also had weight loss, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.0,
      "end_seconds": 69.99,
      "duration_seconds": 1.99,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.78,
      "end_seconds": 79.52,
      "duration_seconds": 2.74,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.84,
      "end_seconds": 106.68,
      "duration_seconds": 7.84,
      "text": "Okay: respiratory rate 24, pulse 92, pressure 140 over 84. And temperature 36.9, oxygen saturation is 90 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.83,
      "end_seconds": 110.21,
      "duration_seconds": 2.38,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.77,
      "end_seconds": 114.11,
      "duration_seconds": 2.34,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.28,
      "end_seconds": 135.24,
      "duration_seconds": 5.96,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.87,
      "end_seconds": 141.75,
      "duration_seconds": 1.88,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.48,
      "end_seconds": 156.05,
      "duration_seconds": 4.57,
      "text": "A few quick ones: night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.63,
      "end_seconds": 160.25,
      "duration_seconds": 2.62,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.46,
      "end_seconds": 165.18,
      "duration_seconds": 3.72,
      "text": "a few quick ones: fever or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.41,
      "end_seconds": 169.24,
      "duration_seconds": 2.83,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.99,
      "end_seconds": 174.05,
      "duration_seconds": 4.06,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.61,
      "end_seconds": 176.95,
      "duration_seconds": 2.34,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.72,
      "end_seconds": 182.55,
      "duration_seconds": 1.83,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.1,
      "end_seconds": 189.58,
      "duration_seconds": 5.48,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.33,
      "end_seconds": 195.57,
      "duration_seconds": 1.24,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.58,
      "end_seconds": 200.39,
      "duration_seconds": 3.81,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.57,
      "end_seconds": 203.53,
      "duration_seconds": 1.96,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.14,
      "end_seconds": 206.76,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.85,
      "end_seconds": 210.93,
      "duration_seconds": 2.08,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.67,
      "end_seconds": 215.99,
      "duration_seconds": 4.32,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 220.91,
      "duration_seconds": 4.31,
      "text": "Right, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.29,
      "end_seconds": 224.81,
      "duration_seconds": 2.52,
      "text": "Anxiety, for about ten years"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.56,
      "end_seconds": 232.19,
      "duration_seconds": 5.63,
      "text": "Are you allergic to to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.15,
      "end_seconds": 247.29,
      "duration_seconds": 14.14,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.36,
      "end_seconds": 252.76,
      "duration_seconds": 3.4,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.39,
      "end_seconds": 259.56,
      "duration_seconds": 5.17,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.18,
      "end_seconds": 263.65,
      "duration_seconds": 3.47,
      "text": "Okay, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.53,
      "end_seconds": 269.28,
      "duration_seconds": 3.75,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.61,
      "end_seconds": 273.46,
      "duration_seconds": 2.85,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.21,
      "end_seconds": 276.28,
      "duration_seconds": 1.07,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.72,
      "end_seconds": 281.05,
      "duration_seconds": 3.33,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.42,
      "end_seconds": 285.76,
      "duration_seconds": 3.34,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.97,
      "end_seconds": 296.2,
      "duration_seconds": 7.23,
      "text": "putting it all together, it points towards a pleural effusion needing a cause. We shouldn't forget an infection"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.48,
      "end_seconds": 339.44,
      "duration_seconds": 32.96,
      "text": "I want a chest X-ray done, that's for breathlessness. I'm sending you for a pleural fluid sample cos of pleural effusion. I am arranging an urgent chest clinic review. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back after the scan. Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.95,
      "end_seconds": 344.21,
      "duration_seconds": 3.26,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}