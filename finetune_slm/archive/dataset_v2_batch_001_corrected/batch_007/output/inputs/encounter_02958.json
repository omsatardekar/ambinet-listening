      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.26,
      "end_seconds": 50.71,
      "duration_seconds": 7.45,
      "text": "Honestly, a few times a day. Cold water on the face helps a bit."
