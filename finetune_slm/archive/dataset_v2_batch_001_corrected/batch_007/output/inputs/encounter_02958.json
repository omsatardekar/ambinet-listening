      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.84,
      "end_seconds": 302.54,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.62,
      "end_seconds": 308.36,
      "duration_seconds": 4.74,
      "text": "right that's the plan. Do you want to ask me anything?"
