      "start_seconds": 104.1,
      "end_seconds": 105.13,
      "duration_seconds": 1.03,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 108.82,
      "duration_seconds": 1.76,
      "text": "so, breathe out slowly"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.76,
      "end_seconds": 123.11,
      "duration_seconds": 3.35,
      "text": "your heart sounds and rhythm are normal today"
