      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.05,
      "end_seconds": 135.79,
      "duration_seconds": 9.74,
      "text": "all finished, thank you let me check a few things any family history of sudden death, chest pain or breathlessness?"
