      "role": "DOCTOR",
      "start_seconds": 82.74,
      "end_seconds": 92.21,
      "duration_seconds": 9.47,
      "text": "Okay: pulse 67 pressure 117 over 82. And temp 36.6 degrees respiratory rate 16 SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.14,
      "end_seconds": 96.77,
      "duration_seconds": 2.63,
      "text": "shall I start the the examination?"
