      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.24,
      "end_seconds": 174.99,
      "duration_seconds": 2.75,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.03,
      "end_seconds": 183.47,
      "duration_seconds": 6.44,
      "text": "yes, I had a mole taken off my arm, a few years ago"
