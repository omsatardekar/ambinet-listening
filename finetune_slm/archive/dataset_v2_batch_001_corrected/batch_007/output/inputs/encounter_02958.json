    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.75,
      "end_seconds": 196.07,
      "duration_seconds": 1.32,
      "text": "what's your work?"
