{
  "schema_version": "1.0",
  "encounter_id": "02883",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 4.47,
      "duration_seconds": 3.55,
      "text": "Actually, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.39,
      "end_seconds": 10.37,
      "duration_seconds": 4.98,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.05,
      "end_seconds": 16.98,
      "duration_seconds": 5.93,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.17,
      "end_seconds": 21.06,
      "duration_seconds": 2.89,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.47,
      "end_seconds": 27.39,
      "duration_seconds": 4.92,
      "text": "Doctor, it's poor concentration. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.56,
      "end_seconds": 32.72,
      "duration_seconds": 4.16,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 34.74,
      "end_seconds": 48.93,
      "duration_seconds": 14.19,
      "text": "Okay, so it's allopurinol, 100 milligrams, once a day for the gout, doctor. He is on paracetamol, 1 gram, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.59,
      "end_seconds": 57.54,
      "duration_seconds": 2.95,
      "text": "Alright, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 59.29,
      "end_seconds": 61.37,
      "duration_seconds": 2.08,
      "text": "About about a year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.49,
      "end_seconds": 68.13,
      "duration_seconds": 1.64,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.75,
      "end_seconds": 72.0,
      "duration_seconds": 3.25,
      "text": "It's been like this since last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.04,
      "end_seconds": 76.56,
      "duration_seconds": 3.52,
      "text": "Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.43,
      "end_seconds": 85.28,
      "duration_seconds": 7.85,
      "text": "Severe, I'd say. I've, I've also been waking unrefreshed. Oh, and aching all over."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.5,
      "end_seconds": 91.61,
      "duration_seconds": 5.11,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.46,
      "end_seconds": 102.6,
      "duration_seconds": 9.14,
      "text": "Heat helps a bit. I'd give it a four, out of ten. I notice it more with cold weather."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.31,
      "end_seconds": 109.6,
      "duration_seconds": 5.29,
      "text": "Have you had poor concentration before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.38,
      "end_seconds": 119.29,
      "duration_seconds": 7.91,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.85,
      "end_seconds": 125.07,
      "duration_seconds": 5.22,
      "text": "Let me check a few things. Any fever, joint swelling or rash?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.11,
      "end_seconds": 131.34,
      "duration_seconds": 5.23,
      "text": "I haven't had fever, joint swelling or rash, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.69,
      "end_seconds": 133.66,
      "duration_seconds": 1.97,
      "text": "Understood. Nothing like weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.77,
      "end_seconds": 136.57,
      "duration_seconds": 1.8,
      "text": "Definitely no weight loss."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.71,
      "end_seconds": 140.4,
      "duration_seconds": 2.69,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.31,
      "end_seconds": 144.51,
      "duration_seconds": 2.2,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.38,
      "end_seconds": 147.64,
      "duration_seconds": 2.26,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.9,
      "end_seconds": 150.97,
      "duration_seconds": 2.07,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.27,
      "end_seconds": 157.46,
      "duration_seconds": 2.19,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.59,
      "end_seconds": 162.61,
      "duration_seconds": 4.02,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.49,
      "end_seconds": 165.92,
      "duration_seconds": 1.43,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.93,
      "end_seconds": 171.13,
      "duration_seconds": 3.2,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.83,
      "end_seconds": 174.29,
      "duration_seconds": 1.46,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.58,
      "end_seconds": 180.18,
      "duration_seconds": 4.6,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.54,
      "end_seconds": 184.22,
      "duration_seconds": 2.68,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.45,
      "end_seconds": 188.68,
      "duration_seconds": 3.23,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.97,
      "end_seconds": 192.37,
      "duration_seconds": 2.4,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.84,
      "end_seconds": 197.13,
      "duration_seconds": 3.29,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.18,
      "end_seconds": 209.1,
      "duration_seconds": 2.92,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.02,
      "end_seconds": 214.63,
      "duration_seconds": 4.61,
      "text": "Well, I've had gout for five years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.56,
      "end_seconds": 228.09,
      "duration_seconds": 3.53,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.87,
      "end_seconds": 233.94,
      "duration_seconds": 5.07,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 240.34,
      "duration_seconds": 4.46,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.33,
      "end_seconds": 256.89,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.22,
      "end_seconds": 282.88,
      "duration_seconds": 8.66,
      "text": "Okay: SpO2 99 percent on room air, pressure 113 over 70. And pulse 65, temp 37.0 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.66,
      "end_seconds": 287.47,
      "duration_seconds": 2.81,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.13,
      "end_seconds": 290.91,
      "duration_seconds": 1.78,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.31,
      "end_seconds": 294.58,
      "duration_seconds": 2.27,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.62,
      "end_seconds": 308.83,
      "duration_seconds": 5.21,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.76,
      "end_seconds": 313.39,
      "duration_seconds": 1.63,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.31,
      "end_seconds": 336.0,
      "duration_seconds": 3.69,
      "text": "Right, here's what I'm thinking. I'd lean towards fibromyalgia."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.99,
      "end_seconds": 338.49,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.08,
      "end_seconds": 372.1,
      "duration_seconds": 32.02,
      "text": "I can't promise yet, but most people with fibromyalgia do well once it's treated properly. I'm sending you for blood tests because of widespread pain. I'm going to put you on amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That should help with pain and sleep. Gentle graded exercise such as swimming helps more than rest. The pain clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.63,
      "end_seconds": 385.08,
      "duration_seconds": 12.45,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'll want another look in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.47,
      "end_seconds": 388.6,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.51,
      "end_seconds": 392.84,
      "duration_seconds": 1.33,
      "text": "See you soon."
    }
  ]
}