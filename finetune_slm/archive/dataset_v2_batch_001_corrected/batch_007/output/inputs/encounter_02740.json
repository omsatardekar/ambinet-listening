{
  "schema_version": "1.0",
  "encounter_id": "02740",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 6.36,
      "duration_seconds": 5.66,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.18,
      "end_seconds": 12.8,
      "duration_seconds": 4.62,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.51,
      "end_seconds": 26.46,
      "duration_seconds": 11.95,
      "text": "Good morning, doctor. I came along to help out. It's a sudden high fever, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.47,
      "end_seconds": 29.48,
      "duration_seconds": 2.01,
      "text": "So, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.38,
      "end_seconds": 33.95,
      "duration_seconds": 3.57,
      "text": "it's been like this since this morning"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.81,
      "end_seconds": 38.74,
      "duration_seconds": 2.93,
      "text": "Has there been vomiting and diarrhoea too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.97,
      "end_seconds": 42.54,
      "duration_seconds": 2.57,
      "text": "Yes, for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.56,
      "end_seconds": 47.46,
      "duration_seconds": 3.9,
      "text": "what about dizziness on standing, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.05,
      "end_seconds": 49.22,
      "duration_seconds": 1.17,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.2,
      "end_seconds": 52.71,
      "duration_seconds": 2.51,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.22,
      "end_seconds": 56.37,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.0,
      "end_seconds": 78.73,
      "duration_seconds": 3.73,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.37,
      "end_seconds": 81.43,
      "duration_seconds": 1.06,
      "text": "yes, anxiety"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.23,
      "end_seconds": 90.42,
      "duration_seconds": 8.19,
      "text": "Okay, I can see anxiety in your file as well. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 91.91,
      "end_seconds": 102.55,
      "duration_seconds": 10.64,
      "text": "she takes escitalopram, 10 milligrams, once a day she is on a tampon, in use, I give it to her"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.91,
      "end_seconds": 109.37,
      "duration_seconds": 6.46,
      "text": "hm, okay. Tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.61,
      "end_seconds": 125.14,
      "duration_seconds": 14.53,
      "text": "I quit smoking around ten years ago. I'm a hairdresser, on my feet all day. My husband and I live above the shop. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.54,
      "end_seconds": 136.98,
      "duration_seconds": 3.44,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.13,
      "end_seconds": 147.07,
      "duration_seconds": 4.94,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.13,
      "end_seconds": 152.57,
      "duration_seconds": 4.44,
      "text": "have you noticed sore throat, stiff neck or cough?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.09,
      "end_seconds": 156.9,
      "duration_seconds": 2.81,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.16,
      "end_seconds": 161.66,
      "duration_seconds": 3.5,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.07,
      "end_seconds": 169.66,
      "duration_seconds": 3.59,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.86,
      "end_seconds": 174.53,
      "duration_seconds": 2.67,
      "text": "Right, may I examine you now?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.11,
      "end_seconds": 188.08,
      "duration_seconds": 0.97,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.94,
      "end_seconds": 191.7,
      "duration_seconds": 1.76,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.04,
      "end_seconds": 215.86,
      "duration_seconds": 9.82,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.68,
      "end_seconds": 229.95,
      "duration_seconds": 10.27,
      "text": "Alright, you can sit up now. So, based on the history and the examination, the most likely explanation is possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.78,
      "end_seconds": 232.9,
      "duration_seconds": 2.12,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.9,
      "end_seconds": 250.14,
      "duration_seconds": 16.24,
      "text": "it's reasonable to be concerned, but right now possible toxic shock syndrome is my leading thought, not anything worse just to be sure I understood you've had a sudden high fever, since this morning, and no cough or stiff neck"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.36,
      "end_seconds": 257.94,
      "duration_seconds": 1.58,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.17,
      "end_seconds": 268.96,
      "duration_seconds": 9.79,
      "text": "A vaginal swab is what I'd like next, for possible toxic shock. I'd like to arrange blood cultures for possible toxic shock."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.83,
      "end_seconds": 276.3,
      "duration_seconds": 2.47,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.34,
      "end_seconds": 293.59,
      "duration_seconds": 16.25,
      "text": "I'll start you on flucloxacillin, 2 grams, now, single dose. That should help with possible toxic shock syndrome. Remove any tampon, you are gonna hospital now. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.19,
      "end_seconds": 295.89,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.81,
      "end_seconds": 299.57,
      "duration_seconds": 2.76,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.6,
      "end_seconds": 303.71,
      "duration_seconds": 3.11,
      "text": "Thank you, uh, that's helpful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.43,
      "end_seconds": 305.72,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}