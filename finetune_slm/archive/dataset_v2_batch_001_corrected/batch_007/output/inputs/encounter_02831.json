{
  "schema_version": "1.0",
  "encounter_id": "02831",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 3.91,
      "duration_seconds": 3.14,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 9.18,
      "duration_seconds": 4.17,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.78,
      "end_seconds": 16.94,
      "duration_seconds": 6.16,
      "text": "Um, you know, so... fainting on exertion. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.67,
      "end_seconds": 18.87,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.19,
      "end_seconds": 29.64,
      "duration_seconds": 9.45,
      "text": "I've had it for three weeks. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 39.24,
      "duration_seconds": 7.71,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.33,
      "end_seconds": 44.41,
      "duration_seconds": 4.08,
      "text": "I'd say moderate. Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.04,
      "end_seconds": 48.71,
      "duration_seconds": 3.67,
      "text": "Have you noticed leg pain, fever or cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.47,
      "end_seconds": 55.21,
      "duration_seconds": 5.74,
      "text": "Oh, I haven't had leg pain, fever or cough, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.8,
      "end_seconds": 60.03,
      "duration_seconds": 4.23,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.9,
      "end_seconds": 64.59,
      "duration_seconds": 2.69,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.93,
      "end_seconds": 70.28,
      "duration_seconds": 4.35,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.1,
      "end_seconds": 73.56,
      "duration_seconds": 2.46,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.32,
      "end_seconds": 77.14,
      "duration_seconds": 2.82,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.29,
      "end_seconds": 79.73,
      "duration_seconds": 1.44,
      "text": "I've got gout."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.9,
      "end_seconds": 101.99,
      "duration_seconds": 4.09,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.76,
      "end_seconds": 105.03,
      "duration_seconds": 2.27,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.02,
      "end_seconds": 122.24,
      "duration_seconds": 3.22,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.06,
      "end_seconds": 130.27,
      "duration_seconds": 4.21,
      "text": "I'm on febuxostat, once a day for the gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.31,
      "end_seconds": 134.27,
      "duration_seconds": 1.96,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.88,
      "end_seconds": 140.04,
      "duration_seconds": 4.16,
      "text": "80 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 145.52,
      "duration_seconds": 4.22,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.54,
      "end_seconds": 150.87,
      "duration_seconds": 3.33,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.32,
      "end_seconds": 154.48,
      "duration_seconds": 2.16,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.4,
      "end_seconds": 159.19,
      "duration_seconds": 3.79,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.31,
      "end_seconds": 171.8,
      "duration_seconds": 3.49,
      "text": "Right, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.25,
      "end_seconds": 184.32,
      "duration_seconds": 3.07,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.88,
      "end_seconds": 213.78,
      "duration_seconds": 7.9,
      "text": "Okay: saturation 93 percent, temperature 37.3, heart rate 100. And respiratory rate 21, blood pressure 121 over 88."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.52,
      "end_seconds": 218.19,
      "duration_seconds": 2.67,
      "text": "Oh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.84,
      "end_seconds": 221.64,
      "duration_seconds": 2.8,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.29,
      "end_seconds": 229.31,
      "duration_seconds": 6.02,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.0,
      "end_seconds": 233.01,
      "duration_seconds": 2.01,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.56,
      "end_seconds": 256.52,
      "duration_seconds": 4.96,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.41,
      "end_seconds": 264.91,
      "duration_seconds": 3.5,
      "text": "Right, that's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.73,
      "end_seconds": 287.31,
      "duration_seconds": 11.58,
      "text": "Okay, so my impression is this: I don't have a clear answer today: possible pulmonary hypertension is possible, and so is chronic clots in the lungs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.43,
      "end_seconds": 289.85,
      "duration_seconds": 1.42,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.43,
      "end_seconds": 307.99,
      "duration_seconds": 17.56,
      "text": "It's reasonable to be concerned, but right now possible pulmonary hypertension is my leading thought, not anything worse. I'll request blood tests, it'll help with breathlessness. Let's book an echocardiogram to look into exertional syncope."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.58,
      "end_seconds": 310.92,
      "duration_seconds": 2.34,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.36,
      "end_seconds": 339.5,
      "duration_seconds": 27.14,
      "text": "No exertion for now, I am arranging urgent specialist tests. I'm going to send a referral to the pulmonary hypertension service. An ECG is something we might do if this doesn't improve in two weeks. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back in one week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.22,
      "end_seconds": 344.16,
      "duration_seconds": 2.94,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.93,
      "end_seconds": 346.87,
      "duration_seconds": 1.94,
      "text": "Have a good day."
    }
  ]
}