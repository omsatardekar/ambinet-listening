{
  "schema_version": "1.0",
  "encounter_id": "02779",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.06,
      "duration_seconds": 3.31,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.63,
      "end_seconds": 8.77,
      "duration_seconds": 4.14,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.49,
      "end_seconds": 13.42,
      "duration_seconds": 2.93,
      "text": "It's seeing flashing lights, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.35,
      "end_seconds": 18.0,
      "duration_seconds": 3.65,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.6,
      "end_seconds": 25.27,
      "duration_seconds": 5.67,
      "text": "Around three days... no wait, it's more like about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.63,
      "end_seconds": 29.93,
      "duration_seconds": 4.3,
      "text": "Right, right. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.39,
      "end_seconds": 34.98,
      "duration_seconds": 3.59,
      "text": "Actually, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.77,
      "end_seconds": 48.65,
      "duration_seconds": 2.88,
      "text": "Has there been any vaginal bleeding?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.22,
      "end_seconds": 52.37,
      "duration_seconds": 2.15,
      "text": "No vaginal bleeding, thankfully."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.55,
      "end_seconds": 57.5,
      "duration_seconds": 3.95,
      "text": "Any leaking fluid or reduced baby movements at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.97,
      "end_seconds": 61.05,
      "duration_seconds": 2.08,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.01,
      "end_seconds": 65.66,
      "duration_seconds": 2.65,
      "text": "Alright, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.32,
      "end_seconds": 68.95,
      "duration_seconds": 1.63,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.71,
      "end_seconds": 73.2,
      "duration_seconds": 2.49,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.15,
      "end_seconds": 77.58,
      "duration_seconds": 3.43,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.37,
      "end_seconds": 81.62,
      "duration_seconds": 3.25,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.41,
      "end_seconds": 85.93,
      "duration_seconds": 2.52,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.66,
      "end_seconds": 105.03,
      "duration_seconds": 4.37,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.29,
      "end_seconds": 109.41,
      "duration_seconds": 3.12,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.29,
      "end_seconds": 112.03,
      "duration_seconds": 1.74,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.35,
      "end_seconds": 120.65,
      "duration_seconds": 4.3,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.77,
      "end_seconds": 123.15,
      "duration_seconds": 1.38,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.85,
      "end_seconds": 129.47,
      "duration_seconds": 4.62,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.28,
      "end_seconds": 132.38,
      "duration_seconds": 2.1,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.05,
      "end_seconds": 140.87,
      "duration_seconds": 3.82,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.62,
      "end_seconds": 144.16,
      "duration_seconds": 2.54,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.72,
      "end_seconds": 148.45,
      "duration_seconds": 3.73,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.43,
      "end_seconds": 152.07,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.73,
      "end_seconds": 161.87,
      "duration_seconds": 2.14,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.29,
      "end_seconds": 187.53,
      "duration_seconds": 8.24,
      "text": "Okay: pressure 144 over 103, pulse 74, oxygen saturation is 99 percent. And temp 36.7 degrees, respiratory rate 15."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.07,
      "end_seconds": 195.17,
      "duration_seconds": 5.1,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.95,
      "end_seconds": 198.36,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.24,
      "end_seconds": 217.9,
      "duration_seconds": 4.66,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.63,
      "end_seconds": 223.45,
      "duration_seconds": 1.82,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.71,
      "end_seconds": 247.64,
      "duration_seconds": 7.93,
      "text": "Taking everything into account, I can't pin this down yet. We're looking at severe pre-eclampsia or a migraine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.19,
      "end_seconds": 252.52,
      "duration_seconds": 3.33,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.12,
      "end_seconds": 285.17,
      "duration_seconds": 31.05,
      "text": "Nothing I've seen today points to an emergency. It looks like severe pre-eclampsia, but I'd like to confirm. A urine protein test is what I'd like next, for pre-eclampsia. I'm going to order urgent blood tests, for pre-eclampsia. I'll start you on labetalol, 200 milligrams, once now, single dose. That should help with severe hypertension. You need to go to the maternity unit straight away. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.21,
      "end_seconds": 289.06,
      "duration_seconds": 2.85,
      "text": "We'll refer you to the obstetric team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.88,
      "end_seconds": 292.57,
      "duration_seconds": 2.69,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.83,
      "end_seconds": 299.94,
      "duration_seconds": 6.11,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.35,
      "end_seconds": 303.14,
      "duration_seconds": 1.79,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.86,
      "end_seconds": 309.55,
      "duration_seconds": 4.69,
      "text": "We'll catch up straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.06,
      "end_seconds": 312.87,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.64,
      "end_seconds": 316.32,
      "duration_seconds": 1.68,
      "text": "Have a good day."
    }
  ]
}