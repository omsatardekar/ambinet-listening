{
  "schema_version": "1.0",
  "encounter_id": "02866",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 5.97,
      "duration_seconds": 5.43,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.08,
      "duration_seconds": 4.38,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.9,
      "end_seconds": 27.84,
      "duration_seconds": 15.94,
      "text": "Mainly severe tummy pain out of proportion to the examination. There's a couple of other things, but that's the main one. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.75,
      "end_seconds": 32.38,
      "duration_seconds": 2.63,
      "text": "Okay, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.21,
      "end_seconds": 42.4,
      "duration_seconds": 8.19,
      "text": "I mean, for three weeks, I'd say. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.61,
      "end_seconds": 47.36,
      "duration_seconds": 4.75,
      "text": "Yes, carry on. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.99,
      "end_seconds": 50.13,
      "duration_seconds": 1.14,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.8,
      "end_seconds": 54.01,
      "duration_seconds": 2.21,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.93,
      "end_seconds": 64.15,
      "duration_seconds": 8.22,
      "text": "Sorry, what was I saying, when it starts I tend to get bloody diarrhoea as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.44,
      "end_seconds": 68.52,
      "duration_seconds": 3.08,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.25,
      "end_seconds": 75.34,
      "duration_seconds": 6.09,
      "text": "Ah, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.43,
      "end_seconds": 81.36,
      "duration_seconds": 3.93,
      "text": "Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.62,
      "end_seconds": 93.22,
      "duration_seconds": 10.6,
      "text": "I work in accounts at a hospital. I'm vegetarian and have been for years. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.75,
      "end_seconds": 101.41,
      "duration_seconds": 3.66,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.35,
      "end_seconds": 110.36,
      "duration_seconds": 7.01,
      "text": "It's bisoprolol, 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.03,
      "end_seconds": 116.1,
      "duration_seconds": 4.07,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.34,
      "end_seconds": 121.06,
      "duration_seconds": 3.72,
      "text": "An irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.87,
      "end_seconds": 126.86,
      "duration_seconds": 4.99,
      "text": "Alright, an irregular heartbeat, that matches what I have here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.22,
      "end_seconds": 141.24,
      "duration_seconds": 2.02,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.3,
      "end_seconds": 145.86,
      "duration_seconds": 1.56,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.62,
      "end_seconds": 163.76,
      "duration_seconds": 4.14,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.08,
      "end_seconds": 171.84,
      "duration_seconds": 2.76,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.31,
      "end_seconds": 175.61,
      "duration_seconds": 2.3,
      "text": "And hernia, any of that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.63,
      "end_seconds": 178.14,
      "duration_seconds": 1.51,
      "text": "No. No hernia."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.82,
      "end_seconds": 182.45,
      "duration_seconds": 3.63,
      "text": "A few quick ones: chest pain or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.47,
      "end_seconds": 187.29,
      "duration_seconds": 2.82,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.79,
      "end_seconds": 189.96,
      "duration_seconds": 2.17,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.34,
      "end_seconds": 192.99,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.55,
      "end_seconds": 199.58,
      "duration_seconds": 4.03,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.12,
      "end_seconds": 203.1,
      "duration_seconds": 1.98,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.08,
      "end_seconds": 209.26,
      "duration_seconds": 4.18,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.7,
      "end_seconds": 224.98,
      "duration_seconds": 2.28,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 254.51,
      "duration_seconds": 9.49,
      "text": "Okay: blood pressure 113 over 70, temperature 36.8. And pulse 107, oxygen saturation is 96 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.15,
      "end_seconds": 256.52,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.5,
      "end_seconds": 260.99,
      "duration_seconds": 2.49,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 266.07,
      "duration_seconds": 3.55,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.72,
      "end_seconds": 268.63,
      "duration_seconds": 0.91,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.2,
      "end_seconds": 273.08,
      "duration_seconds": 2.88,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.46,
      "end_seconds": 296.63,
      "duration_seconds": 10.17,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.76,
      "end_seconds": 308.39,
      "duration_seconds": 8.63,
      "text": "Okay, that's enough for me. From what you've told me and what I found, this is probably possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.79,
      "end_seconds": 311.42,
      "duration_seconds": 1.63,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.23,
      "end_seconds": 322.02,
      "duration_seconds": 8.79,
      "text": "Nothing I've seen today points to an emergency. It looks like possible bowel ischaemia, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.67,
      "end_seconds": 355.13,
      "duration_seconds": 22.46,
      "text": "I'll request an urgent CT angiogram, it'll help with possible bowel ischaemia. I'll request urgent blood tests, it'll help with severe abdominal pain. This is an emergency, you are going to hospital now. I'd like you to see the surgical team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.65,
      "end_seconds": 358.23,
      "duration_seconds": 1.58,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.25,
      "end_seconds": 361.14,
      "duration_seconds": 1.89,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.04,
      "end_seconds": 365.0,
      "duration_seconds": 1.96,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.91,
      "end_seconds": 371.17,
      "duration_seconds": 5.26,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.97,
      "end_seconds": 374.93,
      "duration_seconds": 2.96,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.29,
      "end_seconds": 378.09,
      "duration_seconds": 1.8,
      "text": "So, all the best."
    }
  ]
}