{
  "schema_version": "1.0",
  "encounter_id": "02932",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.54,
      "duration_seconds": 3.96,
      "text": "Okay, so hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.19,
      "end_seconds": 10.62,
      "duration_seconds": 4.43,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.16,
      "end_seconds": 25.23,
      "duration_seconds": 13.07,
      "text": "It's periods becoming irregular, mostly. My sister suggested writing things down, but I forgot. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.82,
      "end_seconds": 28.34,
      "duration_seconds": 2.52,
      "text": "Alright, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.86,
      "end_seconds": 33.08,
      "duration_seconds": 4.22,
      "text": "Mm, it's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.54,
      "end_seconds": 37.69,
      "duration_seconds": 3.15,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.92,
      "end_seconds": 42.02,
      "duration_seconds": 3.1,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.38,
      "end_seconds": 45.44,
      "duration_seconds": 2.06,
      "text": "Any hot flushes as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.17,
      "end_seconds": 53.32,
      "duration_seconds": 7.15,
      "text": "Yes, uh, actually. About hot flushes, only a fan, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.32,
      "end_seconds": 67.6,
      "duration_seconds": 7.28,
      "text": "Let me check a few things. Any pelvic pain, weight loss, very heavy bleeding or bleeding after sex?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.68,
      "end_seconds": 71.19,
      "duration_seconds": 2.51,
      "text": "Ah, nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.23,
      "end_seconds": 75.07,
      "duration_seconds": 2.84,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.75,
      "end_seconds": 78.54,
      "duration_seconds": 1.79,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.19,
      "end_seconds": 86.55,
      "duration_seconds": 3.36,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.47,
      "end_seconds": 90.26,
      "duration_seconds": 1.79,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.44,
      "end_seconds": 102.0,
      "duration_seconds": 1.56,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.64,
      "end_seconds": 106.29,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.38,
      "end_seconds": 111.26,
      "duration_seconds": 2.88,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.29,
      "end_seconds": 117.4,
      "duration_seconds": 4.11,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.5,
      "end_seconds": 120.46,
      "duration_seconds": 1.96,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.08,
      "end_seconds": 125.56,
      "duration_seconds": 4.48,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.07,
      "end_seconds": 133.96,
      "duration_seconds": 3.89,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.25,
      "end_seconds": 142.05,
      "duration_seconds": 6.8,
      "text": "Mm, I'm on ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.8,
      "end_seconds": 145.2,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.24,
      "end_seconds": 148.99,
      "duration_seconds": 2.75,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.65,
      "end_seconds": 154.22,
      "duration_seconds": 4.57,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.05,
      "end_seconds": 159.39,
      "duration_seconds": 4.34,
      "text": "Walnuts. I come out in... well, my lips swelling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.98,
      "end_seconds": 162.86,
      "duration_seconds": 2.88,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.13,
      "end_seconds": 167.06,
      "duration_seconds": 2.93,
      "text": "Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.49,
      "end_seconds": 169.9,
      "duration_seconds": 1.41,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.63,
      "end_seconds": 175.97,
      "duration_seconds": 4.34,
      "text": "I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.01,
      "end_seconds": 189.03,
      "duration_seconds": 12.02,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.32,
      "end_seconds": 202.92,
      "duration_seconds": 2.6,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.48,
      "end_seconds": 221.89,
      "duration_seconds": 8.41,
      "text": "Okay: heart rate 85, temp 36.6 degrees, BP is 108 over 72. And respiratory rate 18."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.71,
      "end_seconds": 229.54,
      "duration_seconds": 4.83,
      "text": "So, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.09,
      "end_seconds": 231.02,
      "duration_seconds": 0.93,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.25,
      "end_seconds": 233.94,
      "duration_seconds": 1.69,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.19,
      "end_seconds": 255.08,
      "duration_seconds": 3.89,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.03,
      "end_seconds": 263.0,
      "duration_seconds": 1.97,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.61,
      "end_seconds": 302.01,
      "duration_seconds": 24.4,
      "text": "So, based on the history and the examination, my working impression is perimenopause. We should do a blood count for irregular periods. I'd like to arrange a thyroid test for hot flushes. You'll be taking estradiol gel, 1 pump, once a day, long term. That should help with menopausal symptoms. Regular exercise, light layers and avoiding triggers can help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.36,
      "end_seconds": 314.75,
      "duration_seconds": 12.39,
      "text": "Okay, go on. If the symptoms get worse, that's the point to come in urgently. Come back in three months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.3,
      "end_seconds": 317.43,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}