{
  "schema_version": "1.0",
  "encounter_id": "02534",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.64,
      "duration_seconds": 4.76,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.63,
      "end_seconds": 13.78,
      "duration_seconds": 4.15,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.83,
      "end_seconds": 23.91,
      "duration_seconds": 6.08,
      "text": "I've been feeling sick, and I wanted to get it it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.73,
      "end_seconds": 28.05,
      "duration_seconds": 3.32,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.61,
      "end_seconds": 32.0,
      "duration_seconds": 3.39,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.77,
      "end_seconds": 42.13,
      "duration_seconds": 9.36,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.3,
      "end_seconds": 52.0,
      "duration_seconds": 4.7,
      "text": "it's mild, honestly. It sort of comes and goes"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.92,
      "end_seconds": 56.55,
      "duration_seconds": 3.63,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.42,
      "end_seconds": 59.07,
      "duration_seconds": 1.65,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.19,
      "end_seconds": 68.11,
      "duration_seconds": 4.92,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.87,
      "end_seconds": 71.77,
      "duration_seconds": 1.9,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.44,
      "end_seconds": 77.02,
      "duration_seconds": 3.58,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.71,
      "end_seconds": 81.05,
      "duration_seconds": 3.34,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.65,
      "end_seconds": 87.22,
      "duration_seconds": 2.57,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.9,
      "end_seconds": 91.73,
      "duration_seconds": 3.83,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.22,
      "end_seconds": 95.43,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.82,
      "end_seconds": 104.37,
      "duration_seconds": 4.55,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.43,
      "end_seconds": 119.01,
      "duration_seconds": 2.58,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.71,
      "end_seconds": 123.14,
      "duration_seconds": 3.43,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.09,
      "end_seconds": 144.88,
      "duration_seconds": 3.79,
      "text": "Any fever, burning when passing urine or vomiting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.46,
      "end_seconds": 147.9,
      "duration_seconds": 2.44,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.33,
      "end_seconds": 152.03,
      "duration_seconds": 2.7,
      "text": "Any sign of passing no urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.27,
      "end_seconds": 155.79,
      "duration_seconds": 2.52,
      "text": "definitely no passing no urine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.56,
      "end_seconds": 159.23,
      "duration_seconds": 1.67,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.79,
      "end_seconds": 162.49,
      "duration_seconds": 2.7,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.26,
      "end_seconds": 166.61,
      "duration_seconds": 3.35,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.5,
      "end_seconds": 169.73,
      "duration_seconds": 2.23,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.23,
      "end_seconds": 173.82,
      "duration_seconds": 2.59,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.08,
      "end_seconds": 189.31,
      "duration_seconds": 2.23,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.88,
      "end_seconds": 210.97,
      "duration_seconds": 8.09,
      "text": "Okay: SpO2 98 percent on room air, blood pressure 122 over 79, heart rate 74, respiratory rate 18."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.53,
      "end_seconds": 213.1,
      "duration_seconds": 1.57,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.82,
      "end_seconds": 217.04,
      "duration_seconds": 2.22,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.57,
      "end_seconds": 224.53,
      "duration_seconds": 4.96,
      "text": "So, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.81,
      "end_seconds": 227.06,
      "duration_seconds": 1.25,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.46,
      "end_seconds": 247.69,
      "duration_seconds": 6.23,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.04,
      "end_seconds": 252.23,
      "duration_seconds": 2.19,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.67,
      "end_seconds": 257.09,
      "duration_seconds": 2.42,
      "text": "Alright, you can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.56,
      "end_seconds": 281.54,
      "duration_seconds": 15.98,
      "text": "I'd like to arrange a CT scan of the kidneys and bladder for renal colic. I'm sending you for a urine dipstick because of haematuria. You'll be taking diclofenac, 75 milligrams, once now, single dose. That's for renal colic."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.62,
      "end_seconds": 285.79,
      "duration_seconds": 3.17,
      "text": "alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.45,
      "end_seconds": 315.63,
      "duration_seconds": 29.18,
      "text": "Drink plenty of water and strain the urine to catch the stone. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. If it hasn't settled in two weeks, we'd think about kidney function tests, but not now. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.24,
      "end_seconds": 319.95,
      "duration_seconds": 3.71,
      "text": "uh, I know what to watch for"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.03,
      "end_seconds": 328.3,
      "duration_seconds": 6.27,
      "text": "I'd like you back in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.89,
      "end_seconds": 333.33,
      "duration_seconds": 3.44,
      "text": "Alright, uh, thanks, take care."
    }
  ]
}