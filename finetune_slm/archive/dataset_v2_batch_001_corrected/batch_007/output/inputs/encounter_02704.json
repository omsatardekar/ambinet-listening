{
  "schema_version": "1.0",
  "encounter_id": "02704",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.6,
      "duration_seconds": 4.51,
      "text": "Morning, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.41,
      "end_seconds": 10.74,
      "duration_seconds": 4.33,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.43,
      "end_seconds": 25.7,
      "duration_seconds": 13.27,
      "text": "Sorry, you know, what was I saying, I wanted to get tiredness looked at. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.95,
      "end_seconds": 30.52,
      "duration_seconds": 3.57,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.5,
      "end_seconds": 40.06,
      "duration_seconds": 7.56,
      "text": "I'm, I'm on sumatriptan, 50 milligrams, maybe, when needed for my migraines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.69,
      "end_seconds": 45.28,
      "duration_seconds": 4.59,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.58,
      "end_seconds": 52.07,
      "duration_seconds": 5.49,
      "text": "Um, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.17,
      "end_seconds": 56.96,
      "duration_seconds": 3.79,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.53,
      "end_seconds": 65.05,
      "duration_seconds": 6.52,
      "text": "Oh, around six months... no wait, it's more like two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 66.29,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.98,
      "end_seconds": 78.06,
      "duration_seconds": 6.08,
      "text": "Oh, and aching muscles. That's been about the same, about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.88,
      "end_seconds": 84.2,
      "duration_seconds": 4.32,
      "text": "Any facial weakness, joint swelling or stiff neck at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.53,
      "end_seconds": 91.71,
      "duration_seconds": 6.18,
      "text": "Well, no, no facial weakness, joint swelling or stiff neck."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.25,
      "end_seconds": 94.57,
      "duration_seconds": 2.32,
      "text": "And palpitations, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.38,
      "end_seconds": 97.08,
      "duration_seconds": 1.7,
      "text": "Definitely no palpitations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.95,
      "end_seconds": 100.42,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.57,
      "end_seconds": 103.13,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 109.2,
      "duration_seconds": 4.32,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.75,
      "end_seconds": 113.99,
      "duration_seconds": 4.24,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 120.34,
      "duration_seconds": 4.59,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.54,
      "end_seconds": 124.58,
      "duration_seconds": 3.04,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.78,
      "end_seconds": 130.14,
      "duration_seconds": 1.36,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.9,
      "end_seconds": 134.49,
      "duration_seconds": 3.59,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.95,
      "end_seconds": 137.39,
      "duration_seconds": 1.44,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.92,
      "end_seconds": 143.42,
      "duration_seconds": 4.5,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 146.04,
      "duration_seconds": 1.64,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.73,
      "end_seconds": 149.21,
      "duration_seconds": 2.48,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.27,
      "end_seconds": 153.11,
      "duration_seconds": 2.84,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.06,
      "end_seconds": 159.3,
      "duration_seconds": 4.24,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.37,
      "end_seconds": 163.48,
      "duration_seconds": 3.11,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.85,
      "end_seconds": 169.53,
      "duration_seconds": 3.68,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.59,
      "end_seconds": 173.37,
      "duration_seconds": 2.78,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.12,
      "end_seconds": 177.45,
      "duration_seconds": 2.33,
      "text": "Migraines, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.87,
      "end_seconds": 189.34,
      "duration_seconds": 2.47,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.09,
      "end_seconds": 198.94,
      "duration_seconds": 8.85,
      "text": "Sorry, what was I saying, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.29,
      "end_seconds": 206.24,
      "duration_seconds": 2.95,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.07,
      "end_seconds": 221.03,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.6,
      "end_seconds": 246.36,
      "duration_seconds": 8.76,
      "text": "Okay: BP is 125 over 72, temperature 36.6. And oxygen saturation is 98 percent, heart rate 64."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.45,
      "end_seconds": 252.02,
      "duration_seconds": 4.57,
      "text": "Uh, um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.61,
      "end_seconds": 255.96,
      "duration_seconds": 3.35,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.67,
      "end_seconds": 261.74,
      "duration_seconds": 4.07,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.17,
      "end_seconds": 270.82,
      "duration_seconds": 1.65,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.58,
      "end_seconds": 275.2,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.86,
      "end_seconds": 291.67,
      "duration_seconds": 6.81,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.98,
      "end_seconds": 297.85,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.04,
      "end_seconds": 329.05,
      "duration_seconds": 14.01,
      "text": "Having listened and examined, this is probably early Lyme disease. I want to be honest that this is an impression, not a final answer. I'd also keep cellulitis in mind."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.79,
      "end_seconds": 333.43,
      "duration_seconds": 3.64,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.01,
      "end_seconds": 370.66,
      "duration_seconds": 35.65,
      "text": "Nothing I've seen today points to an emergency. It looks like early Lyme disease. You'll be taking doxycycline, 100 milligrams, twice a day, twenty-one days. It's for early Lyme disease. Take the doxycycline with food and avoid strong sun. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.92,
      "end_seconds": 381.52,
      "duration_seconds": 9.6,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.84,
      "end_seconds": 386.58,
      "duration_seconds": 3.74,
      "text": "Well, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.2,
      "end_seconds": 393.63,
      "duration_seconds": 5.43,
      "text": "Book a review in three weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.14,
      "end_seconds": 397.9,
      "duration_seconds": 3.76,
      "text": "Great, thank you for your help."
    }
  ]
}