{
  "schema_version": "1.0",
  "encounter_id": "02783",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 5.25,
      "duration_seconds": 4.52,
      "text": "Morning, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 9.91,
      "duration_seconds": 4.0,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.53,
      "end_seconds": 20.46,
      "duration_seconds": 4.93,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.77,
      "end_seconds": 25.64,
      "duration_seconds": 3.87,
      "text": "Alright, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.3,
      "end_seconds": 30.84,
      "duration_seconds": 3.54,
      "text": "We came because of difficulty opening my mouth."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.92,
      "end_seconds": 35.03,
      "duration_seconds": 2.11,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.51,
      "end_seconds": 40.07,
      "duration_seconds": 3.56,
      "text": "About about a month, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.15,
      "end_seconds": 45.36,
      "duration_seconds": 4.21,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.5,
      "end_seconds": 51.33,
      "duration_seconds": 4.83,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.92,
      "end_seconds": 54.12,
      "duration_seconds": 2.2,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.84,
      "end_seconds": 58.73,
      "duration_seconds": 2.89,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.65,
      "end_seconds": 63.96,
      "duration_seconds": 3.31,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.78,
      "end_seconds": 72.43,
      "duration_seconds": 7.65,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.53,
      "end_seconds": 77.77,
      "duration_seconds": 5.24,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.78,
      "end_seconds": 82.66,
      "duration_seconds": 2.88,
      "text": "Oh, I was getting to that!"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.71,
      "end_seconds": 89.9,
      "duration_seconds": 5.19,
      "text": "What about a severe sore throat on one side, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.95,
      "end_seconds": 93.79,
      "duration_seconds": 2.84,
      "text": "Yes, um, for three weeks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.34,
      "end_seconds": 105.34,
      "duration_seconds": 8.0,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.48,
      "end_seconds": 114.85,
      "duration_seconds": 8.37,
      "text": "Severe, really. Swallowing definitely sets it off. I've also had a muffled voice, since yesterday."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.59,
      "end_seconds": 122.39,
      "duration_seconds": 5.8,
      "text": "Have you had difficulty opening your mouth before, or is this the first time?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.2,
      "end_seconds": 129.88,
      "duration_seconds": 5.68,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.76,
      "end_seconds": 135.15,
      "duration_seconds": 4.39,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.98,
      "end_seconds": 144.38,
      "duration_seconds": 7.4,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.46,
      "end_seconds": 149.75,
      "duration_seconds": 4.29,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.15,
      "end_seconds": 155.31,
      "duration_seconds": 4.16,
      "text": "No, it's at home. Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.93,
      "end_seconds": 159.9,
      "duration_seconds": 3.97,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.5,
      "end_seconds": 163.44,
      "duration_seconds": 2.94,
      "text": "Depression, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.28,
      "end_seconds": 164.98,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.52,
      "end_seconds": 174.66,
      "duration_seconds": 5.14,
      "text": "Migraines, for five years. Eczema, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.01,
      "end_seconds": 195.98,
      "duration_seconds": 3.97,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.62,
      "end_seconds": 199.9,
      "duration_seconds": 3.28,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.77,
      "end_seconds": 205.62,
      "duration_seconds": 4.85,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.28,
      "end_seconds": 216.11,
      "duration_seconds": 9.83,
      "text": "I only drink at family occasions. I quit smoking around ten years ago. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.54,
      "end_seconds": 226.18,
      "duration_seconds": 3.64,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.02,
      "end_seconds": 234.0,
      "duration_seconds": 1.98,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.5,
      "end_seconds": 251.99,
      "duration_seconds": 4.49,
      "text": "Let me check a few things. Any cough or noisy breathing?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.9,
      "end_seconds": 256.34,
      "duration_seconds": 3.44,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.54,
      "end_seconds": 258.38,
      "duration_seconds": 0.84,
      "text": "Any rash?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.41,
      "end_seconds": 262.11,
      "duration_seconds": 1.7,
      "text": "No, no rash."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.1,
      "end_seconds": 268.99,
      "duration_seconds": 5.89,
      "text": "So, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.31,
      "end_seconds": 272.27,
      "duration_seconds": 1.96,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.3,
      "end_seconds": 277.17,
      "duration_seconds": 3.87,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.26,
      "end_seconds": 287.72,
      "duration_seconds": 3.46,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.62,
      "end_seconds": 316.65,
      "duration_seconds": 8.03,
      "text": "Okay: heart rate 91, respiratory rate 17, saturation 96 percent. And temp 38.4 degrees, pressure 121 over 67."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.34,
      "end_seconds": 323.71,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.62,
      "end_seconds": 327.14,
      "duration_seconds": 2.52,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.72,
      "end_seconds": 331.59,
      "duration_seconds": 2.87,
      "text": "Right, may I examine you now?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.43,
      "end_seconds": 335.21,
      "duration_seconds": 1.78,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.13,
      "end_seconds": 340.59,
      "duration_seconds": 3.46,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.34,
      "end_seconds": 357.6,
      "duration_seconds": 7.26,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.64,
      "end_seconds": 372.45,
      "duration_seconds": 11.81,
      "text": "That's the examination finished. Right, here's what I'm thinking. This is probably a quinsy, a peritonsillar abscess. I can't rule out severe tonsillitis yet."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.16,
      "end_seconds": 376.19,
      "duration_seconds": 2.03,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.37,
      "end_seconds": 405.17,
      "duration_seconds": 27.8,
      "text": "I understand the worry. At the moment I'd say it's a quinsy, a peritonsillar abscess, and we'll know more once the blood tests is back. I'm sending you for blood tests because of abscess. The result will help us decide whether anything more is needed. I'm sending you for an urgent ENT drainage because of peritonsillar abscess. Let's use benzylpenicillin, 1.2 grams, now, single dose. That's for peritonsillar abscess."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.01,
      "end_seconds": 424.09,
      "duration_seconds": 18.08,
      "text": "You need to be seen by ENT today to drain it. I think the ENT team should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.91,
      "end_seconds": 427.17,
      "duration_seconds": 2.26,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.97,
      "end_seconds": 431.31,
      "duration_seconds": 2.34,
      "text": "See me again straight away."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.93,
      "end_seconds": 435.22,
      "duration_seconds": 2.29,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.63,
      "end_seconds": 440.18,
      "duration_seconds": 3.55,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 441.49,
      "end_seconds": 444.76,
      "duration_seconds": 3.27,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}