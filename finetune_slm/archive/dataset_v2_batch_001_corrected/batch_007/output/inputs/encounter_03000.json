{
  "schema_version": "1.0",
  "encounter_id": "03000",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 3.84,
      "duration_seconds": 2.64,
      "text": "So, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.99,
      "end_seconds": 10.52,
      "duration_seconds": 5.53,
      "text": "Okay, so good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.88,
      "end_seconds": 14.32,
      "duration_seconds": 2.44,
      "text": "right, what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 15.7,
      "end_seconds": 21.44,
      "duration_seconds": 5.74,
      "text": "She's been having bright red blood on the paper, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.01,
      "end_seconds": 36.41,
      "duration_seconds": 13.4,
      "text": "Oh, and itching. That's been about the same, five days. And there's a lump around the back passage as well, five days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.98,
      "end_seconds": 39.15,
      "duration_seconds": 1.17,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.89,
      "end_seconds": 44.55,
      "duration_seconds": 3.66,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.49,
      "end_seconds": 52.1,
      "duration_seconds": 3.61,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.76,
      "end_seconds": 59.8,
      "duration_seconds": 4.04,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.6,
      "end_seconds": 76.08,
      "duration_seconds": 2.48,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.96,
      "end_seconds": 89.34,
      "duration_seconds": 12.38,
      "text": "I've had eczema for five years now. I told my wife I'd come today. I kept putting it it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.79,
      "end_seconds": 92.43,
      "duration_seconds": 1.64,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.39,
      "end_seconds": 98.69,
      "duration_seconds": 5.3,
      "text": "Migraines, for two years. Depression, for about a year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.16,
      "end_seconds": 101.39,
      "duration_seconds": 1.23,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.97,
      "end_seconds": 112.51,
      "duration_seconds": 10.54,
      "text": "okay, I can see migraines in your file as well before we go further, any allergies? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.4,
      "end_seconds": 116.54,
      "duration_seconds": 2.14,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.13,
      "end_seconds": 119.88,
      "duration_seconds": 2.75,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.7,
      "end_seconds": 126.19,
      "duration_seconds": 5.49,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.02,
      "end_seconds": 131.8,
      "duration_seconds": 3.78,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.7,
      "end_seconds": 137.87,
      "duration_seconds": 4.17,
      "text": "Hydrocortisone cream, when needed for the eczema"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.26,
      "end_seconds": 144.5,
      "duration_seconds": 1.24,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.44,
      "end_seconds": 153.84,
      "duration_seconds": 7.4,
      "text": "about about a year hmm, I take propranolol, 40 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 155.02,
      "end_seconds": 163.44,
      "duration_seconds": 8.42,
      "text": "Right, um, that's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.53,
      "end_seconds": 170.92,
      "duration_seconds": 6.39,
      "text": "Yeah, it's fluoxetine, 20 milligrams, every morning for my mood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.9,
      "end_seconds": 175.58,
      "duration_seconds": 2.68,
      "text": "did you notice any tummy pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.35,
      "end_seconds": 179.43,
      "duration_seconds": 2.08,
      "text": "No, no tummy pain."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.11,
      "end_seconds": 185.43,
      "duration_seconds": 5.32,
      "text": "Have you had any black stools, weight loss or change in bowel habit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.61,
      "end_seconds": 194.84,
      "duration_seconds": 8.23,
      "text": "No black stools, weight loss or change in bowel habit, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.37,
      "end_seconds": 199.19,
      "duration_seconds": 3.82,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.76,
      "end_seconds": 203.63,
      "duration_seconds": 3.87,
      "text": "Mm, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.2,
      "end_seconds": 219.75,
      "duration_seconds": 2.55,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.99,
      "end_seconds": 230.47,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.96,
      "end_seconds": 253.13,
      "duration_seconds": 7.17,
      "text": "okay: pulse 78, temperature is 36.8 degrees, saturation 98 percent and blood pressure 126 over 78."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.39,
      "end_seconds": 283.13,
      "duration_seconds": 20.74,
      "text": "I think a blood count makes sense here, for rectal bleeding. I'll start you on lactulose, 15 ml, twice a day, four weeks. You take it by mouth. That's for constipation. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.95,
      "end_seconds": 285.84,
      "duration_seconds": 1.89,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.42,
      "end_seconds": 302.03,
      "duration_seconds": 15.61,
      "text": "Eat more fibre and drink water. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like to see you again in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.54,
      "end_seconds": 307.45,
      "duration_seconds": 4.91,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.9,
      "end_seconds": 310.34,
      "duration_seconds": 1.44,
      "text": "Take care now."
    }
  ]
}