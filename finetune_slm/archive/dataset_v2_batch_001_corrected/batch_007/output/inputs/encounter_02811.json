{
  "schema_version": "1.0",
  "encounter_id": "02811",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 5.26,
      "duration_seconds": 4.6,
      "text": "Hi, sit anywhere you like. What's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.87,
      "end_seconds": 16.99,
      "duration_seconds": 11.12,
      "text": "Yeah, it's a blocked nose for months. I don't know what's causing it. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.34,
      "end_seconds": 21.37,
      "duration_seconds": 3.03,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.88,
      "end_seconds": 33.32,
      "duration_seconds": 10.44,
      "text": "It's been about a week now. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.75,
      "end_seconds": 37.19,
      "duration_seconds": 2.44,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.54,
      "end_seconds": 40.39,
      "duration_seconds": 1.85,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.98,
      "end_seconds": 41.68,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.67,
      "end_seconds": 50.74,
      "duration_seconds": 7.07,
      "text": "Let me think, I've also had a postnasal drip, for five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.28,
      "end_seconds": 54.68,
      "duration_seconds": 3.4,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.32,
      "end_seconds": 58.6,
      "duration_seconds": 3.28,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.05,
      "end_seconds": 63.98,
      "duration_seconds": 3.93,
      "text": "Okay, have you been losing your sense of smell?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.44,
      "end_seconds": 69.06,
      "duration_seconds": 3.62,
      "text": "Ah, yeah. One week, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.65,
      "end_seconds": 78.04,
      "duration_seconds": 8.39,
      "text": "Okay, go on. Have you had a blocked nose for months before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.62,
      "end_seconds": 90.46,
      "duration_seconds": 10.84,
      "text": "Oh, yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.13,
      "end_seconds": 93.21,
      "duration_seconds": 2.08,
      "text": "And nosebleeds, any of that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.54,
      "end_seconds": 96.15,
      "duration_seconds": 1.61,
      "text": "Definitely no nosebleeds."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.84,
      "end_seconds": 100.69,
      "duration_seconds": 2.85,
      "text": "Any vision changes, facial swelling or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.02,
      "end_seconds": 107.95,
      "duration_seconds": 5.93,
      "text": "I haven't had vision changes, facial swelling or fever, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.02,
      "end_seconds": 113.84,
      "duration_seconds": 3.82,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.48,
      "end_seconds": 117.03,
      "duration_seconds": 1.55,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.06,
      "end_seconds": 120.41,
      "duration_seconds": 2.35,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.93,
      "end_seconds": 123.18,
      "duration_seconds": 1.25,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.48,
      "end_seconds": 128.02,
      "duration_seconds": 3.54,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.55,
      "end_seconds": 131.48,
      "duration_seconds": 2.93,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.4,
      "end_seconds": 144.14,
      "duration_seconds": 3.74,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.14,
      "end_seconds": 150.08,
      "duration_seconds": 4.94,
      "text": "Seretide inhaler. I take it twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.17,
      "end_seconds": 157.22,
      "duration_seconds": 5.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.56,
      "end_seconds": 162.26,
      "duration_seconds": 3.7,
      "text": "Actually, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.92,
      "end_seconds": 176.94,
      "duration_seconds": 2.02,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.7,
      "end_seconds": 181.75,
      "duration_seconds": 4.05,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.39,
      "end_seconds": 185.3,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.3,
      "end_seconds": 192.06,
      "duration_seconds": 4.76,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.0,
      "end_seconds": 195.64,
      "duration_seconds": 1.64,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.39,
      "end_seconds": 202.26,
      "duration_seconds": 4.87,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.93,
      "end_seconds": 218.8,
      "duration_seconds": 2.87,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.05,
      "end_seconds": 233.05,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.57,
      "end_seconds": 258.35,
      "duration_seconds": 7.78,
      "text": "Okay: blood pressure 115 over 78, SpO2 98 percent on room air, temp 36.9 degrees. And pulse 70."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.08,
      "end_seconds": 266.2,
      "duration_seconds": 5.12,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.75,
      "end_seconds": 270.75,
      "duration_seconds": 3.0,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.62,
      "end_seconds": 286.27,
      "duration_seconds": 3.65,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.14,
      "end_seconds": 288.12,
      "duration_seconds": 0.98,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.19,
      "end_seconds": 301.51,
      "duration_seconds": 11.32,
      "text": "Good, you can sit up again. We should do a nasal endoscopy for nasal obstruction. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 302.4,
      "end_seconds": 305.24,
      "duration_seconds": 2.84,
      "text": "The earliest is Wednesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.8,
      "end_seconds": 316.23,
      "duration_seconds": 10.43,
      "text": "We'll begin with mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That should help with nasal polyps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.79,
      "end_seconds": 323.51,
      "duration_seconds": 5.72,
      "text": "Hmm, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.69,
      "end_seconds": 342.33,
      "duration_seconds": 17.64,
      "text": "Rinse with saline and use the spray daily. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. I'd like you back in eight weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.43,
      "end_seconds": 345.13,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.33,
      "end_seconds": 349.08,
      "duration_seconds": 2.75,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.13,
      "end_seconds": 355.71,
      "duration_seconds": 2.58,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.45,
      "end_seconds": 358.89,
      "duration_seconds": 1.44,
      "text": "See you soon."
    }
  ]
}