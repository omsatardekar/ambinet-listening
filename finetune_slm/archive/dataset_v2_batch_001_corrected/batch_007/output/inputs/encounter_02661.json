{
  "schema_version": "1.0",
  "encounter_id": "02661",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 4.46,
      "duration_seconds": 3.89,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.26,
      "end_seconds": 9.03,
      "duration_seconds": 3.77,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.02,
      "end_seconds": 18.52,
      "duration_seconds": 7.5,
      "text": "Well, uh, so the thing is, I've got a blocked nose for months."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.52,
      "end_seconds": 23.86,
      "duration_seconds": 4.34,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.78,
      "end_seconds": 31.64,
      "duration_seconds": 3.86,
      "text": "Yeah, I'm on Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 50.32,
      "duration_seconds": 2.05,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.67,
      "end_seconds": 60.01,
      "duration_seconds": 4.34,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.83,
      "end_seconds": 64.36,
      "duration_seconds": 3.53,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.11,
      "end_seconds": 66.8,
      "duration_seconds": 1.69,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.18,
      "end_seconds": 71.36,
      "duration_seconds": 4.18,
      "text": "Mm-hmm. Have you been losing your sense of smell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.03,
      "end_seconds": 80.81,
      "duration_seconds": 8.78,
      "text": "Yes, I have. As for losing my sense of smell, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.97,
      "end_seconds": 84.41,
      "duration_seconds": 2.44,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.01,
      "end_seconds": 86.66,
      "duration_seconds": 1.65,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.54,
      "end_seconds": 91.19,
      "duration_seconds": 3.65,
      "text": "And what about facial swelling, nosebleeds or vision changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.41,
      "end_seconds": 95.0,
      "duration_seconds": 2.59,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.24,
      "end_seconds": 98.51,
      "duration_seconds": 2.27,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.2,
      "end_seconds": 101.15,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.04,
      "end_seconds": 105.49,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.4,
      "end_seconds": 109.26,
      "duration_seconds": 2.86,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.34,
      "end_seconds": 121.67,
      "duration_seconds": 2.33,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.43,
      "end_seconds": 124.92,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.87,
      "end_seconds": 130.34,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.52,
      "end_seconds": 135.69,
      "duration_seconds": 4.17,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.75,
      "end_seconds": 138.1,
      "duration_seconds": 1.35,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.9,
      "end_seconds": 142.74,
      "duration_seconds": 2.84,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.9,
      "end_seconds": 146.65,
      "duration_seconds": 2.75,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.8,
      "end_seconds": 150.49,
      "duration_seconds": 2.69,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.23,
      "end_seconds": 153.56,
      "duration_seconds": 1.33,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.15,
      "end_seconds": 158.77,
      "duration_seconds": 4.62,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.12,
      "end_seconds": 166.31,
      "duration_seconds": 6.19,
      "text": "What about your medical history? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.41,
      "end_seconds": 181.25,
      "duration_seconds": 13.84,
      "text": "I've had asthma, yes. I took the morning off to come in today. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.04,
      "end_seconds": 186.6,
      "duration_seconds": 4.56,
      "text": "Hm, okay. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.07,
      "end_seconds": 196.45,
      "duration_seconds": 2.38,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.55,
      "end_seconds": 216.45,
      "duration_seconds": 5.9,
      "text": "Okay: saturation 97 percent, respiratory rate 14. And pressure 114 over 80, pulse 80."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.51,
      "end_seconds": 218.99,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.72,
      "end_seconds": 224.24,
      "duration_seconds": 3.52,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.01,
      "end_seconds": 231.3,
      "duration_seconds": 4.29,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.56,
      "end_seconds": 233.68,
      "duration_seconds": 1.12,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.68,
      "end_seconds": 236.92,
      "duration_seconds": 2.24,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.46,
      "end_seconds": 255.98,
      "duration_seconds": 3.52,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.39,
      "end_seconds": 260.01,
      "duration_seconds": 1.62,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.35,
      "end_seconds": 303.55,
      "duration_seconds": 26.2,
      "text": "So, based on the history and the examination, I'd lean towards nasal polyps. We should do a nasal endoscopy for nasal obstruction. The treatment will be mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That's for nasal polyps. Rinse with saline and use the spray daily."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.07,
      "end_seconds": 317.1,
      "duration_seconds": 13.03,
      "text": "Mm-hmm. I'd like you to see the ENT clinic as well, and I'll write the referral. Come back in eight weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.45,
      "end_seconds": 320.24,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.95,
      "end_seconds": 323.34,
      "duration_seconds": 2.39,
      "text": "Alright, have a good day."
    }
  ]
}