{
  "schema_version": "1.0",
  "encounter_id": "02794",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.88,
      "duration_seconds": 3.87,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 10.37,
      "duration_seconds": 4.13,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 15.52,
      "duration_seconds": 4.36,
      "text": "It's bright red blood on the paper, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.42,
      "end_seconds": 17.63,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.86,
      "end_seconds": 22.89,
      "duration_seconds": 4.03,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.39,
      "end_seconds": 26.76,
      "duration_seconds": 3.37,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.52,
      "end_seconds": 42.61,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.73,
      "end_seconds": 67.85,
      "duration_seconds": 11.12,
      "text": "Okay: blood pressure 116 over 70, oxygen saturation is 98 percent, pulse is 83 beats a minute, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.22,
      "end_seconds": 72.79,
      "duration_seconds": 2.57,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.91,
      "end_seconds": 74.94,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.97,
      "end_seconds": 78.41,
      "duration_seconds": 2.44,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.61,
      "end_seconds": 95.5,
      "duration_seconds": 8.89,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.28,
      "end_seconds": 98.77,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.33,
      "end_seconds": 105.08,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.74,
      "end_seconds": 125.96,
      "duration_seconds": 2.22,
      "text": "Any change in bowel habit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.19,
      "end_seconds": 132.96,
      "duration_seconds": 5.77,
      "text": "Uh, not that I've noticed, no change in bowel habit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.9,
      "end_seconds": 139.08,
      "duration_seconds": 4.18,
      "text": "Any black stools, weight loss or tummy pain at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.59,
      "end_seconds": 145.76,
      "duration_seconds": 6.17,
      "text": "So, I haven't had black stools, weight loss or tummy pain, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.36,
      "end_seconds": 149.09,
      "duration_seconds": 2.73,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.89,
      "end_seconds": 152.23,
      "duration_seconds": 2.34,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.11,
      "end_seconds": 157.98,
      "duration_seconds": 4.87,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.79,
      "end_seconds": 173.14,
      "duration_seconds": 10.35,
      "text": "I do a yoga class on Thursdays. My partner and our baby. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.03,
      "end_seconds": 193.2,
      "duration_seconds": 4.17,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.22,
      "end_seconds": 197.3,
      "duration_seconds": 3.08,
      "text": "Febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.93,
      "end_seconds": 212.14,
      "duration_seconds": 3.21,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.98,
      "end_seconds": 224.63,
      "duration_seconds": 8.65,
      "text": "Yes, I had part of my thyroid removed, years back. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.25,
      "end_seconds": 230.79,
      "duration_seconds": 4.54,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.28,
      "end_seconds": 235.62,
      "duration_seconds": 3.34,
      "text": "I have gout, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.67,
      "end_seconds": 243.76,
      "duration_seconds": 6.09,
      "text": "I see, go ahead. Alright, gout, that matches what I have here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.43,
      "end_seconds": 260.23,
      "duration_seconds": 2.8,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.42,
      "end_seconds": 270.82,
      "duration_seconds": 9.4,
      "text": "I had a reaction to amoxicillin when I was younger, a rash all over, and I've avoided it since."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.18,
      "end_seconds": 279.52,
      "duration_seconds": 7.34,
      "text": "So, based on the history and the examination, I think we're dealing with haemorrhoids at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.11,
      "end_seconds": 282.14,
      "duration_seconds": 2.03,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.23,
      "end_seconds": 309.19,
      "duration_seconds": 25.96,
      "text": "Nothing I've seen today points to an emergency. It looks like haemorrhoids, but I'd like to confirm. I think a blood count makes sense here, for rectal bleeding. I'll start you on a haemorrhoid cream, 1 application, twice a day, one week. That should help with haemorrhoids. Eat more fibre and drink water."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.44,
      "end_seconds": 313.76,
      "duration_seconds": 4.32,
      "text": "I see, go ahead. Come back in four weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.87,
      "end_seconds": 316.89,
      "duration_seconds": 2.02,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.91,
      "end_seconds": 323.07,
      "duration_seconds": 5.16,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.6,
      "end_seconds": 326.07,
      "duration_seconds": 1.47,
      "text": "That's clear, thanks."
    }
  ]
}