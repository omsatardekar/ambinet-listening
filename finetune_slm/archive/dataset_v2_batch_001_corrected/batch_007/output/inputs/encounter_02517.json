{
  "schema_version": "1.0",
  "encounter_id": "02517",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 3.73,
      "duration_seconds": 2.54,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.7,
      "end_seconds": 9.81,
      "duration_seconds": 5.11,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.48,
      "end_seconds": 21.59,
      "duration_seconds": 10.11,
      "text": "Mainly I've been waking unrefreshed. That's why I came. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.34,
      "end_seconds": 25.97,
      "duration_seconds": 3.63,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.81,
      "end_seconds": 30.54,
      "duration_seconds": 3.73,
      "text": "I, I take metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.35,
      "end_seconds": 34.48,
      "duration_seconds": 2.13,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.09,
      "end_seconds": 43.52,
      "duration_seconds": 7.43,
      "text": "It's 50 milligrams. I take apixaban, 5 milligrams, twice a day. Alendronate I don't take anymore."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.04,
      "end_seconds": 47.83,
      "duration_seconds": 2.79,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.33,
      "end_seconds": 50.24,
      "duration_seconds": 1.91,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.09,
      "end_seconds": 54.31,
      "duration_seconds": 3.22,
      "text": "Okay, how much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.85,
      "end_seconds": 58.72,
      "duration_seconds": 2.87,
      "text": "It, It feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.51,
      "end_seconds": 66.67,
      "duration_seconds": 2.16,
      "text": "have you had tender spots?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.38,
      "end_seconds": 73.85,
      "duration_seconds": 5.47,
      "text": "Yeah, that too. With tender spots, it feels severe to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.12,
      "end_seconds": 75.1,
      "duration_seconds": 0.98,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.92,
      "end_seconds": 84.74,
      "duration_seconds": 4.82,
      "text": "I had aching all over before. That's settled now, though."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.16,
      "end_seconds": 92.35,
      "duration_seconds": 4.19,
      "text": "Any rash, weight loss, joint swelling or fever at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.17,
      "end_seconds": 100.44,
      "duration_seconds": 7.27,
      "text": "sorry, what was I saying, no, no rash, weight loss, joint swelling or fever"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.58,
      "end_seconds": 107.86,
      "duration_seconds": 3.28,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.8,
      "end_seconds": 110.24,
      "duration_seconds": 1.44,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.56,
      "end_seconds": 126.5,
      "duration_seconds": 0.94,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.08,
      "end_seconds": 130.71,
      "duration_seconds": 3.63,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.46,
      "end_seconds": 134.74,
      "duration_seconds": 2.28,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.52,
      "end_seconds": 141.88,
      "duration_seconds": 5.36,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.64,
      "end_seconds": 144.39,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.81,
      "end_seconds": 149.37,
      "duration_seconds": 3.56,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.97,
      "end_seconds": 155.22,
      "duration_seconds": 4.25,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.47,
      "end_seconds": 169.13,
      "duration_seconds": 12.66,
      "text": "Cat fur. I come out in... well, wheezing. Yes, amoxicillin. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.74,
      "end_seconds": 172.43,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.33,
      "end_seconds": 178.32,
      "duration_seconds": 2.99,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.22,
      "end_seconds": 198.47,
      "duration_seconds": 4.25,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.29,
      "end_seconds": 208.46,
      "duration_seconds": 8.17,
      "text": "Ah, I've had thin bones, yes. Erm, I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.71,
      "end_seconds": 210.56,
      "duration_seconds": 0.85,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.43,
      "end_seconds": 219.03,
      "duration_seconds": 6.6,
      "text": "Well, you know, I've had an irregular heartbeat for about ten years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.61,
      "end_seconds": 221.62,
      "duration_seconds": 2.01,
      "text": "I see, go ahead"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.52,
      "end_seconds": 237.78,
      "duration_seconds": 14.26,
      "text": "Ah, you know, I've had heart disease, yes. I've been reading about it online and it worried me. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.07,
      "end_seconds": 244.87,
      "duration_seconds": 5.8,
      "text": "Alright, thin bones and heart disease, that matches what I have here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.97,
      "end_seconds": 260.93,
      "duration_seconds": 3.96,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.79,
      "end_seconds": 265.07,
      "duration_seconds": 3.28,
      "text": "Well, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.87,
      "end_seconds": 270.59,
      "duration_seconds": 4.72,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.01,
      "end_seconds": 279.18,
      "duration_seconds": 2.17,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.63,
      "end_seconds": 298.26,
      "duration_seconds": 5.63,
      "text": "okay: blood pressure 115 over 69, heart rate 78, saturation 97 percent"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.34,
      "end_seconds": 303.78,
      "duration_seconds": 4.44,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.96,
      "end_seconds": 306.47,
      "duration_seconds": 1.51,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.2,
      "end_seconds": 311.07,
      "duration_seconds": 2.87,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.61,
      "end_seconds": 324.79,
      "duration_seconds": 5.18,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.67,
      "end_seconds": 348.32,
      "duration_seconds": 18.65,
      "text": "so, good, you can sit up again. Putting it all together, my working impression is fibromyalgia. I wanna be honest that this is an impression, not a final answer. It could also be polymyalgia, so we'll keep that open"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.2,
      "end_seconds": 353.03,
      "duration_seconds": 2.83,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.81,
      "end_seconds": 373.18,
      "duration_seconds": 18.37,
      "text": "I understand the worry. At the moment I'd say it's fibromyalgia, and we'll know more once the blood tests is back. We should do blood tests for widespread pain. You'll be taking amitriptyline, 10 milligrams, at night, long term. It's for pain and sleep."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.87,
      "end_seconds": 382.85,
      "duration_seconds": 3.98,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.53,
      "end_seconds": 395.11,
      "duration_seconds": 11.58,
      "text": "Gentle graded exercise such as swimming helps more than rest. I think the pain clinic should see you too. See me again in six weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.24,
      "end_seconds": 396.94,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.86,
      "end_seconds": 401.22,
      "duration_seconds": 2.36,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.13,
      "end_seconds": 407.59,
      "duration_seconds": 4.46,
      "text": "Let me think, um, thank you, doctor, goodbye."
    }
  ]
}