{
  "schema_version": "1.0",
  "encounter_id": "02913",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 7.02,
      "duration_seconds": 6.0,
      "text": "Welcome. Make yourself comfortable. Right, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.51,
      "end_seconds": 23.27,
      "duration_seconds": 10.76,
      "text": "I wanted to get my heart suddenly racing looked at. Sorry, you know, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.31,
      "end_seconds": 30.2,
      "duration_seconds": 1.89,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.9,
      "end_seconds": 35.69,
      "duration_seconds": 3.79,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.35,
      "end_seconds": 40.55,
      "duration_seconds": 3.2,
      "text": "Any a pounding in your neck as well?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.65,
      "end_seconds": 46.4,
      "duration_seconds": 3.75,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.32,
      "end_seconds": 51.77,
      "duration_seconds": 4.45,
      "text": "Right, have you been feeling lightheaded during an episode?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.47,
      "end_seconds": 55.21,
      "duration_seconds": 1.74,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.77,
      "end_seconds": 59.56,
      "duration_seconds": 2.79,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.47,
      "end_seconds": 66.67,
      "duration_seconds": 3.2,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.76,
      "end_seconds": 75.02,
      "duration_seconds": 6.26,
      "text": "Have you had your heart suddenly racing before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.74,
      "end_seconds": 81.9,
      "duration_seconds": 5.16,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.48,
      "end_seconds": 100.18,
      "duration_seconds": 2.7,
      "text": "Any breathlessness or fainting at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.05,
      "end_seconds": 105.11,
      "duration_seconds": 3.06,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.55,
      "end_seconds": 113.39,
      "duration_seconds": 4.84,
      "text": "A few quick ones: chest pain or family history of sudden death?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.7,
      "end_seconds": 117.52,
      "duration_seconds": 2.82,
      "text": "Erm, none of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.13,
      "end_seconds": 120.41,
      "duration_seconds": 2.28,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.41,
      "end_seconds": 123.01,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.35,
      "end_seconds": 136.59,
      "duration_seconds": 3.24,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.64,
      "end_seconds": 141.16,
      "duration_seconds": 3.52,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.93,
      "end_seconds": 145.35,
      "duration_seconds": 2.42,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.0,
      "end_seconds": 151.01,
      "duration_seconds": 4.01,
      "text": "I've had depression for five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.59,
      "end_seconds": 152.29,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.93,
      "end_seconds": 159.1,
      "duration_seconds": 5.17,
      "text": "I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.44,
      "end_seconds": 162.45,
      "duration_seconds": 2.01,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 168.89,
      "duration_seconds": 5.72,
      "text": "Sertraline. I take it 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.7,
      "end_seconds": 174.86,
      "duration_seconds": 4.16,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.4,
      "end_seconds": 179.65,
      "duration_seconds": 3.25,
      "text": "Erm, no, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.33,
      "end_seconds": 182.55,
      "duration_seconds": 2.22,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.25,
      "end_seconds": 195.13,
      "duration_seconds": 10.88,
      "text": "Um, I had an operation for a hernia last spring. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.95,
      "end_seconds": 198.43,
      "duration_seconds": 2.48,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.46,
      "end_seconds": 212.9,
      "duration_seconds": 13.44,
      "text": "I'm a hairdresser, on my feet all day. I walk the dog every morning. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 233.13,
      "duration_seconds": 2.97,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.8,
      "end_seconds": 248.27,
      "duration_seconds": 2.47,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.16,
      "end_seconds": 278.65,
      "duration_seconds": 10.49,
      "text": "Okay: weight 70 kilos, SpO2 98 percent on room air, heart rate 83. And height 159 centimetres, blood pressure 118 over 74."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.71,
      "end_seconds": 282.15,
      "duration_seconds": 2.44,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.2,
      "end_seconds": 286.87,
      "duration_seconds": 2.67,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.57,
      "end_seconds": 294.03,
      "duration_seconds": 5.46,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.1,
      "end_seconds": 297.29,
      "duration_seconds": 2.19,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.41,
      "end_seconds": 312.09,
      "duration_seconds": 3.68,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.98,
      "end_seconds": 352.87,
      "duration_seconds": 35.89,
      "text": "Thank you, you can get dressed. Having listened and examined, I can't pin this down yet. We're looking at episodes of supraventricular tachycardia or atrial fibrillation. I'd like to arrange an ECG for palpitations. I think a thyroid test makes sense here, for palpitations. Try blowing hard against a closed mouth and nose when it starts. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.16,
      "end_seconds": 355.76,
      "duration_seconds": 1.6,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.54,
      "end_seconds": 365.61,
      "duration_seconds": 8.07,
      "text": "I'd like to see you again after the monitor. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.83,
      "end_seconds": 370.72,
      "duration_seconds": 3.89,
      "text": "Well, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.5,
      "end_seconds": 373.78,
      "duration_seconds": 1.28,
      "text": "All the best."
    }
  ]
}