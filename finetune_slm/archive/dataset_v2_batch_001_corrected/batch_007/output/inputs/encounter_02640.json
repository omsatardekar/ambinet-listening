{
  "schema_version": "1.0",
  "encounter_id": "02640",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.21,
      "end_seconds": 6.29,
      "duration_seconds": 5.08,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.51,
      "end_seconds": 10.93,
      "duration_seconds": 3.42,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.6,
      "end_seconds": 18.85,
      "duration_seconds": 4.25,
      "text": "Let me think, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.15,
      "end_seconds": 23.89,
      "duration_seconds": 3.74,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.57,
      "end_seconds": 36.94,
      "duration_seconds": 7.37,
      "text": "It's stiff aching shoulders and hips. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.93,
      "end_seconds": 47.9,
      "duration_seconds": 8.97,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.08,
      "end_seconds": 54.74,
      "duration_seconds": 5.66,
      "text": "It just comes and goes. I notice it more with mornings."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.6,
      "end_seconds": 59.39,
      "duration_seconds": 3.79,
      "text": "What about a mild temperature, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 68.48,
      "duration_seconds": 8.1,
      "text": "Yeah. Four weeks, I'd say. About mild temperature, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.85,
      "end_seconds": 73.23,
      "duration_seconds": 3.38,
      "text": "Have you been feeling tired and low?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.95,
      "end_seconds": 78.48,
      "duration_seconds": 3.53,
      "text": "Yes, about the same, two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.13,
      "end_seconds": 86.44,
      "duration_seconds": 6.31,
      "text": "Have you had stiff aching shoulders and hips before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.25,
      "end_seconds": 92.39,
      "duration_seconds": 5.14,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 93.91,
      "end_seconds": 110.3,
      "duration_seconds": 16.39,
      "text": "Doctor, I've got the readings for you. Weight 74 kilos, temperature is 36.7 degrees, BMI works out to 28.5. Height 161 centimetres, pulse is 73 beats a minute, saturation 97 percent, blood pressure 117 over 73."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.57,
      "end_seconds": 112.27,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.35,
      "end_seconds": 116.94,
      "duration_seconds": 3.59,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.77,
      "end_seconds": 121.06,
      "duration_seconds": 2.29,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.2,
      "end_seconds": 145.95,
      "duration_seconds": 6.75,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.32,
      "end_seconds": 150.28,
      "duration_seconds": 1.96,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.93,
      "end_seconds": 165.11,
      "duration_seconds": 2.18,
      "text": "Has there been any headache?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.76,
      "end_seconds": 167.45,
      "duration_seconds": 1.69,
      "text": "Nope, no headache."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.97,
      "end_seconds": 173.73,
      "duration_seconds": 4.76,
      "text": "Actually, doctor, I did notice headache. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.13,
      "end_seconds": 181.93,
      "duration_seconds": 6.8,
      "text": "No, uh, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.91,
      "end_seconds": 193.91,
      "duration_seconds": 11.0,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you had any weight loss, visual changes or jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.8,
      "end_seconds": 198.26,
      "duration_seconds": 2.46,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.69,
      "end_seconds": 203.1,
      "duration_seconds": 3.41,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.74,
      "end_seconds": 206.24,
      "duration_seconds": 1.5,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.73,
      "end_seconds": 210.19,
      "duration_seconds": 2.46,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.04,
      "end_seconds": 215.29,
      "duration_seconds": 3.25,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.01,
      "end_seconds": 229.05,
      "duration_seconds": 2.04,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.39,
      "end_seconds": 233.96,
      "duration_seconds": 3.57,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.89,
      "end_seconds": 236.09,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.6,
      "end_seconds": 239.6,
      "duration_seconds": 3.0,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.23,
      "end_seconds": 245.95,
      "duration_seconds": 4.72,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.92,
      "end_seconds": 250.32,
      "duration_seconds": 3.4,
      "text": "Asthma, for five years. Yes, acid reflux."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.05,
      "end_seconds": 260.01,
      "duration_seconds": 6.96,
      "text": "Yes, asthma and acid reflux are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.74,
      "end_seconds": 280.86,
      "duration_seconds": 3.12,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.88,
      "end_seconds": 285.99,
      "duration_seconds": 4.11,
      "text": "I'm on lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.72,
      "end_seconds": 318.82,
      "duration_seconds": 31.1,
      "text": "Putting it all together, I'd lean towards polymyalgia rheumatica. I want to be honest that this is an impression, not a final answer. We shouldn't forget rheumatoid arthritis. I'm going to order blood tests, for proximal stiffness. I'd like you to take prednisolone, 15 milligrams, once a day, reducing course. It's for polymyalgia rheumatica. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.37,
      "end_seconds": 327.65,
      "duration_seconds": 4.28,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.63,
      "end_seconds": 335.71,
      "duration_seconds": 7.08,
      "text": "Report any headache or jaw pain immediately. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 336.31,
      "end_seconds": 340.37,
      "duration_seconds": 4.06,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.5,
      "end_seconds": 345.86,
      "duration_seconds": 1.36,
      "text": "See you soon."
    }
  ]
}