{
  "schema_version": "1.0",
  "encounter_id": "02774",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 7.06,
      "duration_seconds": 6.1,
      "text": "Doctor? Hello, you know, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.32,
      "end_seconds": 13.02,
      "duration_seconds": 4.7,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.41,
      "end_seconds": 19.93,
      "duration_seconds": 5.52,
      "text": "Well, um, I've been having a blister on my heel."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.47,
      "end_seconds": 24.3,
      "duration_seconds": 3.83,
      "text": "Okay, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.07,
      "end_seconds": 37.1,
      "duration_seconds": 12.03,
      "text": "For about a month, I'd say. My neighbour said I should get it looked at. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.0,
      "end_seconds": 39.99,
      "duration_seconds": 1.99,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.26,
      "end_seconds": 44.19,
      "duration_seconds": 2.93,
      "text": "It's worse with new shoes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.32,
      "end_seconds": 47.91,
      "duration_seconds": 2.59,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.58,
      "end_seconds": 64.92,
      "duration_seconds": 15.34,
      "text": "Sorry, you know, what was I saying, when it starts I tend to get a little soreness as well. About little soreness, about a five out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.97,
      "end_seconds": 68.9,
      "duration_seconds": 2.93,
      "text": "Have you noticed pus, diabetes or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.98,
      "end_seconds": 73.69,
      "duration_seconds": 2.71,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.06,
      "end_seconds": 76.7,
      "duration_seconds": 1.64,
      "text": "Nothing like redness spreading?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.75,
      "end_seconds": 81.34,
      "duration_seconds": 3.59,
      "text": "No, I haven't had any redness spreading."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.01,
      "end_seconds": 86.15,
      "duration_seconds": 3.14,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.81,
      "end_seconds": 92.3,
      "duration_seconds": 4.49,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.91,
      "end_seconds": 110.48,
      "duration_seconds": 2.57,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.88,
      "end_seconds": 115.71,
      "duration_seconds": 3.83,
      "text": "Allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.44,
      "end_seconds": 120.53,
      "duration_seconds": 4.09,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.55,
      "end_seconds": 124.21,
      "duration_seconds": 1.66,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.12,
      "end_seconds": 129.1,
      "duration_seconds": 3.98,
      "text": "Right, right. Okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.99,
      "end_seconds": 133.82,
      "duration_seconds": 3.83,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.56,
      "end_seconds": 137.02,
      "duration_seconds": 2.46,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.91,
      "end_seconds": 142.54,
      "duration_seconds": 4.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.95,
      "end_seconds": 153.54,
      "duration_seconds": 2.59,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.26,
      "end_seconds": 158.54,
      "duration_seconds": 4.28,
      "text": "Oh, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.39,
      "end_seconds": 164.03,
      "duration_seconds": 3.64,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.98,
      "end_seconds": 173.62,
      "duration_seconds": 2.64,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.87,
      "end_seconds": 197.7,
      "duration_seconds": 8.83,
      "text": "Okay: blood pressure 113 over 77, pulse 78, oxygen saturation is 99 percent, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.05,
      "end_seconds": 201.16,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.12,
      "end_seconds": 205.62,
      "duration_seconds": 2.5,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.37,
      "end_seconds": 209.89,
      "duration_seconds": 2.52,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 212.67,
      "duration_seconds": 1.26,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.36,
      "end_seconds": 229.93,
      "duration_seconds": 6.57,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.94,
      "end_seconds": 236.51,
      "duration_seconds": 1.57,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.35,
      "end_seconds": 255.85,
      "duration_seconds": 10.5,
      "text": "Putting it all together, this looks most like a simple friction blister. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.24,
      "end_seconds": 260.37,
      "duration_seconds": 3.13,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.75,
      "end_seconds": 279.33,
      "duration_seconds": 17.58,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple friction blister. Leave it intact, cover it with a padded plaster and change the shoes. Let's plan a check if it looks infected."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 281.3,
      "end_seconds": 284.79,
      "duration_seconds": 3.49,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.79,
      "end_seconds": 290.62,
      "duration_seconds": 3.83,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 295.51,
      "duration_seconds": 2.89,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.87,
      "end_seconds": 300.88,
      "duration_seconds": 4.01,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}