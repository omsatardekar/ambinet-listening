{
  "schema_version": "1.0",
  "encounter_id": "02549",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.1,
      "duration_seconds": 3.36,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.27,
      "end_seconds": 11.57,
      "duration_seconds": 4.3,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.17,
      "end_seconds": 22.28,
      "duration_seconds": 9.11,
      "text": "It's being thirsty. I thought I'd wait, but it hasn't gone. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.32,
      "end_seconds": 26.72,
      "duration_seconds": 2.4,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.07,
      "end_seconds": 29.17,
      "duration_seconds": 1.1,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.68,
      "end_seconds": 34.12,
      "duration_seconds": 3.44,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.16,
      "end_seconds": 47.67,
      "duration_seconds": 8.51,
      "text": "Ever since... since Friday, really. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.9,
      "end_seconds": 51.61,
      "duration_seconds": 2.71,
      "text": "Have you been passing kidney stones?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.32,
      "end_seconds": 57.1,
      "duration_seconds": 3.78,
      "text": "Right, yes, about the same, one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.13,
      "end_seconds": 61.07,
      "duration_seconds": 2.94,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.76,
      "end_seconds": 63.41,
      "duration_seconds": 1.65,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.34,
      "end_seconds": 86.46,
      "duration_seconds": 4.12,
      "text": "A few quick ones: weight loss, fractures or low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.46,
      "end_seconds": 90.09,
      "duration_seconds": 2.63,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.66,
      "end_seconds": 93.79,
      "duration_seconds": 2.13,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.74,
      "end_seconds": 97.75,
      "duration_seconds": 2.01,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.84,
      "end_seconds": 115.63,
      "duration_seconds": 3.79,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.46,
      "end_seconds": 120.69,
      "duration_seconds": 3.23,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.13,
      "end_seconds": 140.16,
      "duration_seconds": 5.03,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.06,
      "end_seconds": 145.73,
      "duration_seconds": 3.67,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.28,
      "end_seconds": 149.69,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.4,
      "end_seconds": 165.01,
      "duration_seconds": 14.61,
      "text": "I have about eight cigarettes in a day. I'll have a glass of wine with dinner. No, I share a house with my brother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.06,
      "end_seconds": 168.69,
      "duration_seconds": 2.63,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.83,
      "end_seconds": 184.23,
      "duration_seconds": 2.4,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.43,
      "end_seconds": 211.17,
      "duration_seconds": 9.74,
      "text": "Okay: temp 36.9 degrees, height 180 centimetres, saturation 98 percent, weight 84 kilos, blood pressure 112 over 80, heart rate 69."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.11,
      "end_seconds": 217.05,
      "duration_seconds": 2.94,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.76,
      "end_seconds": 220.14,
      "duration_seconds": 1.38,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.02,
      "end_seconds": 223.24,
      "duration_seconds": 1.22,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.36,
      "end_seconds": 243.37,
      "duration_seconds": 5.01,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.9,
      "end_seconds": 257.64,
      "duration_seconds": 9.74,
      "text": "All finished, thank you. So where does that leave us? This is probably possible raised calcium from an overactive parathyroid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.14,
      "end_seconds": 262.54,
      "duration_seconds": 3.4,
      "text": "Uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.18,
      "end_seconds": 276.95,
      "duration_seconds": 12.77,
      "text": "I understand the worry. At the moment I'd say it's possible raised calcium from an overactive parathyroid, and we'll know more once the a calcium and parathyroid hormone test is back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.17,
      "end_seconds": 300.67,
      "duration_seconds": 15.5,
      "text": "I'll request a calcium and parathyroid hormone test, it'll help with kidney stones. Drink plenty of water and avoid calcium supplements until the results. Let's get you seen by the endocrine clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.32,
      "end_seconds": 302.02,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 305.61,
      "duration_seconds": 2.41,
      "text": "See me again after the results."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.98,
      "end_seconds": 307.68,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.2,
      "end_seconds": 312.88,
      "duration_seconds": 3.68,
      "text": "So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.32,
      "end_seconds": 316.44,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}