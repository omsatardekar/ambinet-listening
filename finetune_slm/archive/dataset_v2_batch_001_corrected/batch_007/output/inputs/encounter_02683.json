  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.18,
      "duration_seconds": 3.33,
      "text": "hello, doctor i think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.17,
      "end_seconds": 10.18,
      "duration_seconds": 4.01,
      "text": "yes, have a a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.69,
      "end_seconds": 17.87,
      "duration_seconds": 6.18,
      "text": "Doctor I'll sit in if that's okay I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.73,
      "end_seconds": 23.96,
      "duration_seconds": 4.23,
      "text": "of course, please stay. It's helpful to have you here"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.05,
      "end_seconds": 28.04,
      "duration_seconds": 2.99,
      "text": "we came because of difficulty concentrating"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.62,
      "end_seconds": 32.59,
      "duration_seconds": 2.97,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.57,
      "end_seconds": 37.95,
      "duration_seconds": 3.38,
      "text": "it's been like this since Monday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.62,
      "end_seconds": 42.9,
      "duration_seconds": 4.28,
      "text": "is it it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.77,
      "end_seconds": 48.27,
      "duration_seconds": 4.5,
      "text": "Mm I'd give it a a seven out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.96,
      "end_seconds": 51.21,
      "duration_seconds": 2.25,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.07,
      "end_seconds": 56.78,
      "duration_seconds": 3.71,
      "text": "I mean it usually comes with restlessness"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.28,
      "end_seconds": 60.27,
      "duration_seconds": 1.99,
      "text": "have you been losing things?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.93,
      "end_seconds": 64.46,
      "duration_seconds": 3.53,
      "text": "yeah, I've had that since this morning"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.81,
      "end_seconds": 70.97,
      "duration_seconds": 5.16,
      "text": "Have you had difficulty concentrating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.02,
      "end_seconds": 79.62,
      "duration_seconds": 7.6,
      "text": "Yes something like this happened a couple of years ago and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.28,
      "end_seconds": 93.23,
      "duration_seconds": 5.95,
      "text": "Any low mood, head injury, drug use or thoughts of self-harm at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.73,
      "end_seconds": 101.21,
      "duration_seconds": 6.48,
      "text": "No low mood head injury drug use or thoughts of self-harm none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.8,
      "end_seconds": 106.2,
      "duration_seconds": 3.4,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.34,
      "end_seconds": 109.31,
      "duration_seconds": 1.97,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.12,
      "end_seconds": 115.5,
      "duration_seconds": 4.38,
      "text": "alright do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 122.05,
      "duration_seconds": 5.28,
      "text": "Paracetamol, 650 milligrams, when needed. I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.36,
      "end_seconds": 126.44,
      "duration_seconds": 3.08,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.03,
      "end_seconds": 130.19,
      "duration_seconds": 2.16,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.95,
      "end_seconds": 133.4,
      "duration_seconds": 2.45,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.27,
      "end_seconds": 138.53,
      "duration_seconds": 4.26,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.62,
      "end_seconds": 143.57,
      "duration_seconds": 2.95,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.64,
      "end_seconds": 149.16,
      "duration_seconds": 3.52,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.15,
      "end_seconds": 153.66,
      "duration_seconds": 2.51,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.23,
      "end_seconds": 161.5,
      "duration_seconds": 6.27,
      "text": "yes, I had two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.55,
      "end_seconds": 165.91,
      "duration_seconds": 3.36,
      "text": "okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.49,
      "end_seconds": 170.3,
      "duration_seconds": 2.81,
      "text": "my mother had a a stroke"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.16,
      "end_seconds": 173.76,
      "duration_seconds": 2.6,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.61,
      "end_seconds": 185.42,
      "duration_seconds": 9.81,
      "text": "I have arthritis in my knees, for nearly five years i have eczema, for two years i have heart disease"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.16,
      "end_seconds": 199.75,
      "duration_seconds": 12.59,
      "text": "I follow yes, arthritis in your knees is known to us, good to have that clear has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.7,
      "end_seconds": 202.94,
      "duration_seconds": 2.24,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.98,
      "end_seconds": 217.38,
      "duration_seconds": 2.4,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.1,
      "end_seconds": 229.49,
      "duration_seconds": 2.39,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.01,
      "end_seconds": 256.24,
      "duration_seconds": 15.23,
      "text": "Okay: saturation 97 percent, temperature 36.7, weight 56 kilos. And respiratory rate 15, pulse is 80 beats a minute, pressure 128 over 73, height 162 centimetres, BMI works out to 21.3."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.39,
      "end_seconds": 259.46,
      "duration_seconds": 2.07,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 263.98,
      "duration_seconds": 3.87,
      "text": "don't worry we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.59,
      "end_seconds": 271.28,
      "duration_seconds": 4.69,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.21,
      "end_seconds": 274.7,
      "duration_seconds": 1.49,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 278.52,
      "duration_seconds": 2.47,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.57,
      "end_seconds": 294.88,
      "duration_seconds": 5.31,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.46,
      "end_seconds": 308.32,
      "duration_seconds": 10.86,
      "text": "Good, you can sit up again. So where does that leave us? The most likely explanation is possible adult attention deficit disorder."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.67,
      "end_seconds": 312.91,
      "duration_seconds": 3.24,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.93,
      "end_seconds": 323.5,
      "duration_seconds": 8.57,
      "text": "nothing I've seen today points to an emergency it looks like possible adult attention deficit disorder, but I'd like to confirm"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.18,
      "end_seconds": 334.7,
      "duration_seconds": 3.52,
      "text": "I'm going to order a questionnaire for attention problems."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.31,
      "end_seconds": 338.15,
      "duration_seconds": 2.84,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.77,
      "end_seconds": 352.23,
      "duration_seconds": 13.46,
      "text": "I'm sending you for a thyroid test because of poor concentration use lists and reminders while we arrange the specialist assessment we'll refer you to the adult ADHD service"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.25,
      "end_seconds": 353.95,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.85,
      "end_seconds": 358.56,
      "duration_seconds": 3.71,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.84,
      "end_seconds": 361.87,
      "duration_seconds": 2.03,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}