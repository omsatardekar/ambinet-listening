{
  "schema_version": "1.0",
  "encounter_id": "02671",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 2.82,
      "duration_seconds": 2.31,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.99,
      "end_seconds": 9.37,
      "duration_seconds": 5.38,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.36,
      "end_seconds": 11.57,
      "duration_seconds": 1.21,
      "text": "was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.13,
      "end_seconds": 18.32,
      "duration_seconds": 5.19,
      "text": "not great, I ended up a few streets away"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.87,
      "end_seconds": 22.51,
      "duration_seconds": 2.64,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.43,
      "end_seconds": 29.68,
      "duration_seconds": 5.25,
      "text": "I've been dealing with a chesty cough for a week"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.34,
      "end_seconds": 32.23,
      "duration_seconds": 1.89,
      "text": "Okay, since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.37,
      "end_seconds": 35.93,
      "duration_seconds": 2.56,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.61,
      "end_seconds": 42.51,
      "duration_seconds": 5.9,
      "text": "okay, give me more detail on it, whatever comes to to mind"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.54,
      "end_seconds": 66.6,
      "duration_seconds": 22.06,
      "text": "it settles a little with honey it feels mild to me oh, and a sore throat earlier that's been about the same, about four days with sore throat earlier, maybe a six out of ten on a bad day"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.49,
      "end_seconds": 70.7,
      "duration_seconds": 3.21,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.94,
      "end_seconds": 81.23,
      "duration_seconds": 7.29,
      "text": "Carvedilol i take it 6.25 milligrams, maybe, twice a day for my heart"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.13,
      "end_seconds": 85.43,
      "duration_seconds": 3.3,
      "text": "Is the the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.91,
      "end_seconds": 96.15,
      "duration_seconds": 7.24,
      "text": "No, it's at home. I'm on allopurinol, 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.32,
      "end_seconds": 101.63,
      "duration_seconds": 4.31,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.19,
      "end_seconds": 103.65,
      "duration_seconds": 1.46,
      "text": "Erythromycin, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.34,
      "end_seconds": 109.24,
      "duration_seconds": 3.9,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.52,
      "end_seconds": 118.73,
      "duration_seconds": 8.21,
      "text": "Yes, heart failure. It's the not knowing that gets to me. Gout, for about a year."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.46,
      "end_seconds": 128.81,
      "duration_seconds": 9.35,
      "text": "Yes, heart failure and gout are known to us, good to have that clear. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.83,
      "end_seconds": 133.48,
      "duration_seconds": 2.65,
      "text": "my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.81,
      "end_seconds": 139.39,
      "duration_seconds": 4.58,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.22,
      "end_seconds": 154.78,
      "duration_seconds": 13.56,
      "text": "I've never touched a cigarette. I look after my grandchildren most days. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.15,
      "end_seconds": 163.02,
      "duration_seconds": 3.87,
      "text": "have you had any breathlessness or coughing up blood?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.91,
      "end_seconds": 168.29,
      "duration_seconds": 3.38,
      "text": "no, no breathlessness or coughing up blood"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.23,
      "end_seconds": 174.54,
      "duration_seconds": 4.31,
      "text": "So, a few quick ones: chest pain or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.05,
      "end_seconds": 178.87,
      "duration_seconds": 3.82,
      "text": "I haven't had chest pain or fever, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.19,
      "end_seconds": 182.13,
      "duration_seconds": 1.94,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.15,
      "end_seconds": 188.1,
      "duration_seconds": 0.95,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.63,
      "end_seconds": 192.88,
      "duration_seconds": 4.25,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.73,
      "end_seconds": 197.44,
      "duration_seconds": 2.71,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.84,
      "end_seconds": 203.62,
      "duration_seconds": 4.78,
      "text": "Right, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.62,
      "end_seconds": 206.99,
      "duration_seconds": 2.37,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.47,
      "end_seconds": 229.23,
      "duration_seconds": 3.76,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.42,
      "end_seconds": 235.31,
      "duration_seconds": 1.89,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.94,
      "end_seconds": 253.29,
      "duration_seconds": 5.35,
      "text": "so where does that leave us? This looks most like acute viral bronchitis"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.01,
      "end_seconds": 256.45,
      "duration_seconds": 2.44,
      "text": "Oh, will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.72,
      "end_seconds": 290.76,
      "duration_seconds": 33.04,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if you get a fever or breathlessness"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.96,
      "end_seconds": 294.87,
      "duration_seconds": 2.91,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.83,
      "end_seconds": 300.96,
      "duration_seconds": 4.13,
      "text": "We'll catch up if not better in three weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 302.14,
      "end_seconds": 305.61,
      "duration_seconds": 3.47,
      "text": "come by reception afterwards and I'll fix the appointment"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.57,
      "end_seconds": 314.08,
      "duration_seconds": 7.51,
      "text": "Okay, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.7,
      "end_seconds": 321.17,
      "duration_seconds": 6.47,
      "text": "So, I come back if not better in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.04,
      "end_seconds": 326.15,
      "duration_seconds": 4.11,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.93,
      "end_seconds": 331.39,
      "duration_seconds": 3.46,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.44,
      "end_seconds": 334.09,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
}