{
  "schema_version": "1.0",
  "encounter_id": "02571",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.12,
      "duration_seconds": 3.27,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 10.35,
      "duration_seconds": 5.0,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.31,
      "end_seconds": 16.31,
      "duration_seconds": 5.0,
      "text": "Oh, uh, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.09,
      "end_seconds": 21.7,
      "duration_seconds": 3.61,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.77,
      "end_seconds": 29.29,
      "duration_seconds": 6.52,
      "text": "Actually, I wanted to get bright red blood on the paper looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.81,
      "end_seconds": 33.57,
      "duration_seconds": 2.76,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.51,
      "end_seconds": 37.28,
      "duration_seconds": 2.77,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.35,
      "end_seconds": 43.2,
      "duration_seconds": 3.85,
      "text": "It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.08,
      "end_seconds": 48.63,
      "duration_seconds": 4.55,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.72,
      "end_seconds": 70.84,
      "duration_seconds": 20.12,
      "text": "Um, I suppose so, yes. As for itching, I honestly can't say when that began. It might have been last month or the month before. As for itching, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.49,
      "end_seconds": 76.38,
      "duration_seconds": 3.89,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.13,
      "end_seconds": 90.02,
      "duration_seconds": 11.89,
      "text": "I swim twice a week. I'm a hairdresser, on my feet all day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 104.14,
      "duration_seconds": 3.18,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.61,
      "end_seconds": 111.99,
      "duration_seconds": 6.38,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.61,
      "end_seconds": 116.51,
      "duration_seconds": 3.9,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 118.11,
      "end_seconds": 126.08,
      "duration_seconds": 7.97,
      "text": "He is on pantoprazole, before breakfast for my acidity, I give it to him."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.01,
      "end_seconds": 130.02,
      "duration_seconds": 2.01,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 131.66,
      "end_seconds": 132.81,
      "duration_seconds": 1.15,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.18,
      "end_seconds": 138.22,
      "duration_seconds": 5.04,
      "text": "Yes, carry on. Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.6,
      "end_seconds": 151.59,
      "duration_seconds": 11.99,
      "text": "I've had acid reflux for nearly five years now. I'm not great at remembering details, uh, so bear with me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.75,
      "end_seconds": 163.87,
      "duration_seconds": 4.12,
      "text": "Have you had change in bowel habit, by any chance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.42,
      "end_seconds": 169.06,
      "duration_seconds": 3.64,
      "text": "Nope, no change in bowel habit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.03,
      "end_seconds": 175.39,
      "duration_seconds": 4.36,
      "text": "Did you get tummy pain, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.3,
      "end_seconds": 185.69,
      "duration_seconds": 9.39,
      "text": "Okay, uh, so no tummy pain, weight loss or black stools, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.62,
      "end_seconds": 189.56,
      "duration_seconds": 1.94,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.18,
      "end_seconds": 192.77,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.4,
      "end_seconds": 209.4,
      "duration_seconds": 3.0,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.21,
      "end_seconds": 222.65,
      "duration_seconds": 2.44,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.91,
      "end_seconds": 243.77,
      "duration_seconds": 8.86,
      "text": "Okay: oxygen saturation is 98 percent, blood pressure 114 over 73. And height 151 centimetres, weight 98 kilos, heart rate 67."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.99,
      "end_seconds": 247.1,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.81,
      "end_seconds": 250.81,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.65,
      "end_seconds": 273.38,
      "duration_seconds": 7.73,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.2,
      "end_seconds": 307.31,
      "duration_seconds": 28.11,
      "text": "Good, you can sit up again. Taking everything into account, it's hard to say. Haemorrhoids is one possibility and an anal fissure another, and I'd rather not commit yet. I'm sending you for a blood count because of rectal bleeding. Please come and see me in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.99,
      "end_seconds": 311.54,
      "duration_seconds": 3.55,
      "text": "I think I understand everything. Thanks."
    }
  ]
}