{
  "schema_version": "1.0",
  "encounter_id": "02875",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.82,
      "duration_seconds": 5.74,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.58,
      "duration_seconds": 4.09,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 15.57,
      "duration_seconds": 2.39,
      "text": "It's a postnasal drip, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.2,
      "end_seconds": 21.04,
      "duration_seconds": 3.84,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 26.34,
      "duration_seconds": 3.98,
      "text": "Since last night, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.71,
      "end_seconds": 30.87,
      "duration_seconds": 3.16,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.65,
      "end_seconds": 37.3,
      "duration_seconds": 4.65,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.5,
      "end_seconds": 42.03,
      "duration_seconds": 3.53,
      "text": "So, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.99,
      "end_seconds": 49.58,
      "duration_seconds": 6.59,
      "text": "A dull pressure over my face goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.6,
      "end_seconds": 55.18,
      "duration_seconds": 4.58,
      "text": "What about a blocked nose for months, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.09,
      "end_seconds": 64.63,
      "duration_seconds": 8.54,
      "text": "Ah, um, yes, since last weekend. As for blocked nose for months, mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.81,
      "end_seconds": 79.71,
      "duration_seconds": 1.9,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.7,
      "end_seconds": 84.58,
      "duration_seconds": 3.88,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.57,
      "end_seconds": 87.9,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.65,
      "end_seconds": 93.21,
      "duration_seconds": 3.56,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.04,
      "end_seconds": 96.85,
      "duration_seconds": 1.81,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.44,
      "end_seconds": 101.78,
      "duration_seconds": 4.34,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.65,
      "end_seconds": 105.86,
      "duration_seconds": 2.21,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.69,
      "end_seconds": 115.51,
      "duration_seconds": 3.82,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.95,
      "end_seconds": 121.7,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.66,
      "end_seconds": 126.34,
      "duration_seconds": 2.68,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.11,
      "end_seconds": 138.64,
      "duration_seconds": 3.53,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.34,
      "end_seconds": 144.28,
      "duration_seconds": 3.94,
      "text": "I, I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.85,
      "end_seconds": 150.17,
      "duration_seconds": 4.32,
      "text": "Mm-hmm. Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.22,
      "end_seconds": 160.31,
      "duration_seconds": 3.09,
      "text": "Alright, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.88,
      "end_seconds": 163.39,
      "duration_seconds": 1.51,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.27,
      "end_seconds": 168.25,
      "duration_seconds": 2.98,
      "text": "Any vision changes, fever or nosebleeds?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.91,
      "end_seconds": 172.73,
      "duration_seconds": 3.82,
      "text": "No, um, none that I've noticed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.6,
      "end_seconds": 175.07,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.17,
      "end_seconds": 178.3,
      "duration_seconds": 2.13,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.92,
      "end_seconds": 182.94,
      "duration_seconds": 4.02,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.3,
      "end_seconds": 186.05,
      "duration_seconds": 1.75,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.25,
      "end_seconds": 191.09,
      "duration_seconds": 3.84,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.96,
      "end_seconds": 207.24,
      "duration_seconds": 2.28,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.17,
      "end_seconds": 223.95,
      "duration_seconds": 6.78,
      "text": "Okay: respiratory rate 16, blood pressure 122 over 74, temp 36.6 degrees, pulse 65."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.58,
      "end_seconds": 229.28,
      "duration_seconds": 1.7,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.92,
      "end_seconds": 232.73,
      "duration_seconds": 2.81,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.4,
      "end_seconds": 237.46,
      "duration_seconds": 2.06,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.32,
      "end_seconds": 240.04,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.49,
      "end_seconds": 257.97,
      "duration_seconds": 3.48,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.62,
      "end_seconds": 259.56,
      "duration_seconds": 0.94,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.67,
      "end_seconds": 282.14,
      "duration_seconds": 18.47,
      "text": "Okay, that's enough for me. We should do a nasal endoscopy for nasal obstruction. I'm prescribing mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That's for nasal polyps. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.03,
      "end_seconds": 286.79,
      "duration_seconds": 3.76,
      "text": "Ah, should I take that with food?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.41,
      "end_seconds": 301.05,
      "duration_seconds": 13.64,
      "text": "Rinse with saline and use the spray daily. Please don't wait if the symptoms get worse. That's when to be seen urgently. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.19,
      "end_seconds": 305.63,
      "duration_seconds": 3.44,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}