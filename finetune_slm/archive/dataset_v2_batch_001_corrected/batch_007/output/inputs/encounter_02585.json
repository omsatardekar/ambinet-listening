{
  "schema_version": "1.0",
  "encounter_id": "02585",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.14,
      "duration_seconds": 3.3,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 9.07,
      "duration_seconds": 4.06,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.03,
      "end_seconds": 14.95,
      "duration_seconds": 4.92,
      "text": "Um, so... mood swings. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.51,
      "end_seconds": 19.74,
      "duration_seconds": 3.23,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.35,
      "end_seconds": 28.36,
      "duration_seconds": 5.01,
      "text": "Right, it's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.29,
      "end_seconds": 33.24,
      "duration_seconds": 2.95,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.08,
      "end_seconds": 43.49,
      "duration_seconds": 8.41,
      "text": "About a five out of ten. Oh, and hot flushes. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.78,
      "end_seconds": 50.6,
      "duration_seconds": 2.82,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.45,
      "end_seconds": 66.44,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.91,
      "end_seconds": 88.43,
      "duration_seconds": 8.52,
      "text": "Okay: blood pressure 119 over 78, oxygen saturation is 99 percent, temp 36.6 degrees, pulse 70."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.13,
      "end_seconds": 90.65,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.91,
      "end_seconds": 94.5,
      "duration_seconds": 2.59,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.96,
      "end_seconds": 100.96,
      "duration_seconds": 4.0,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.82,
      "end_seconds": 104.19,
      "duration_seconds": 1.37,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.03,
      "end_seconds": 117.55,
      "duration_seconds": 4.52,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 122.02,
      "duration_seconds": 1.68,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.06,
      "end_seconds": 144.29,
      "duration_seconds": 8.23,
      "text": "Let me check a few things. Any bleeding after sex, weight loss, very heavy bleeding or pelvic pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.99,
      "end_seconds": 148.29,
      "duration_seconds": 3.3,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.3,
      "end_seconds": 152.66,
      "duration_seconds": 3.36,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.6,
      "end_seconds": 155.03,
      "duration_seconds": 1.43,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.86,
      "end_seconds": 158.03,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.74,
      "end_seconds": 163.84,
      "duration_seconds": 2.1,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 167.72,
      "duration_seconds": 2.76,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.24,
      "end_seconds": 172.93,
      "duration_seconds": 4.69,
      "text": "Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.46,
      "end_seconds": 177.8,
      "duration_seconds": 3.34,
      "text": "Right, how long have you been on it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.18,
      "end_seconds": 184.84,
      "duration_seconds": 5.66,
      "text": "For two years. Metformin, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.62,
      "end_seconds": 191.63,
      "duration_seconds": 5.01,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.64,
      "end_seconds": 197.56,
      "duration_seconds": 4.92,
      "text": "I'm allergic to amoxicillin, I get a rash all over."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.51,
      "end_seconds": 210.62,
      "duration_seconds": 3.11,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.77,
      "end_seconds": 228.13,
      "duration_seconds": 16.36,
      "text": "I used to drink heavily but I stopped four years ago. My partner and our baby. I hardly move around during the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.58,
      "end_seconds": 232.91,
      "duration_seconds": 3.33,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.25,
      "end_seconds": 240.48,
      "duration_seconds": 6.23,
      "text": "I've got an underactive thyroid. I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.18,
      "end_seconds": 252.0,
      "duration_seconds": 10.82,
      "text": "Right, right. Taking everything into account, it's hard to say. Perimenopause is one possibility and a thyroid problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.82,
      "end_seconds": 264.46,
      "duration_seconds": 3.64,
      "text": "We should do a thyroid test for hot flushes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.41,
      "end_seconds": 267.62,
      "duration_seconds": 1.21,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.43,
      "end_seconds": 282.65,
      "duration_seconds": 13.22,
      "text": "A blood count is what I'd like next, for irregular periods. What I'm giving you is estradiol gel, 1 pump, once a day, long term. That's for menopausal symptoms."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.71,
      "end_seconds": 288.41,
      "duration_seconds": 3.7,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.53,
      "end_seconds": 309.02,
      "duration_seconds": 19.49,
      "text": "Regular exercise, light layers and avoiding triggers can help. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.89,
      "end_seconds": 313.56,
      "duration_seconds": 3.67,
      "text": "Erm, I know what to watch for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.01,
      "end_seconds": 321.48,
      "duration_seconds": 6.47,
      "text": "Come back in three months. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.17,
      "end_seconds": 327.05,
      "duration_seconds": 3.88,
      "text": "Yeah, good, thanks, I'll see you then."
    }
  ]
}