{
  "schema_version": "1.0",
  "encounter_id": "02690",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 3.96,
      "duration_seconds": 2.81,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 9.83,
      "end_seconds": 14.8,
      "duration_seconds": 4.97,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.36,
      "end_seconds": 23.49,
      "duration_seconds": 7.13,
      "text": "Of course, please stay. It's helpful to have you here. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.85,
      "end_seconds": 31.07,
      "duration_seconds": 4.22,
      "text": "Um, so... restlessness. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.74,
      "end_seconds": 35.19,
      "duration_seconds": 3.45,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.99,
      "end_seconds": 39.22,
      "duration_seconds": 2.23,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.5,
      "end_seconds": 43.54,
      "duration_seconds": 3.04,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.32,
      "end_seconds": 48.93,
      "duration_seconds": 1.61,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.35,
      "end_seconds": 55.69,
      "duration_seconds": 6.34,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 55.79,
      "end_seconds": 61.6,
      "duration_seconds": 5.81,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.15,
      "end_seconds": 81.54,
      "duration_seconds": 15.39,
      "text": "Yeah, I was getting to that! As for difficulty concentrating, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.61,
      "end_seconds": 86.01,
      "duration_seconds": 2.4,
      "text": "Have you been losing things?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.46,
      "end_seconds": 88.56,
      "duration_seconds": 1.1,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.76,
      "end_seconds": 93.42,
      "duration_seconds": 3.66,
      "text": "Have you had drug use, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.34,
      "end_seconds": 96.67,
      "duration_seconds": 2.33,
      "text": "No drug use, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.36,
      "end_seconds": 102.86,
      "duration_seconds": 4.5,
      "text": "Any thoughts of self-harm, head injury or low mood at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.61,
      "end_seconds": 107.67,
      "duration_seconds": 3.06,
      "text": "Yeah, nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.99,
      "end_seconds": 111.46,
      "duration_seconds": 2.47,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.47,
      "end_seconds": 113.59,
      "duration_seconds": 1.12,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.84,
      "end_seconds": 117.42,
      "duration_seconds": 2.58,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.06,
      "end_seconds": 118.99,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.36,
      "end_seconds": 124.5,
      "duration_seconds": 4.14,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.78,
      "end_seconds": 130.28,
      "duration_seconds": 4.5,
      "text": "oh, um, my father had bowel cancer"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.67,
      "end_seconds": 133.41,
      "duration_seconds": 1.74,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.96,
      "end_seconds": 137.8,
      "duration_seconds": 3.84,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.38,
      "end_seconds": 140.81,
      "duration_seconds": 1.43,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.76,
      "end_seconds": 145.61,
      "duration_seconds": 2.85,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.46,
      "end_seconds": 149.34,
      "duration_seconds": 1.88,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.37,
      "end_seconds": 156.65,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.31,
      "end_seconds": 161.16,
      "duration_seconds": 2.85,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.37,
      "end_seconds": 166.03,
      "duration_seconds": 3.66,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.03,
      "end_seconds": 179.81,
      "duration_seconds": 3.78,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.79,
      "end_seconds": 183.71,
      "duration_seconds": 2.92,
      "text": "High blood pressure, for five years"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.89,
      "end_seconds": 189.27,
      "duration_seconds": 1.38,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.1,
      "end_seconds": 206.78,
      "duration_seconds": 15.68,
      "text": "I've had heart disease for nearly five years now. My neighbour said I should get it looked at. Yes, heart failure. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.1,
      "end_seconds": 216.7,
      "duration_seconds": 8.6,
      "text": "Sure. Yes, heart disease is known to us, good to have that clear. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.95,
      "end_seconds": 222.39,
      "duration_seconds": 4.44,
      "text": "I, I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.64,
      "end_seconds": 231.4,
      "duration_seconds": 7.76,
      "text": "Ah, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.39,
      "end_seconds": 235.86,
      "duration_seconds": 3.47,
      "text": "So, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.49,
      "end_seconds": 254.12,
      "duration_seconds": 12.63,
      "text": "For my heart, I believe. My son sets them out for me, I just take what I'm given. I'm on furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 256.0,
      "end_seconds": 263.52,
      "duration_seconds": 7.52,
      "text": "it's meant to be every morning, though I don't see she take it every time"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.3,
      "end_seconds": 267.15,
      "duration_seconds": 2.85,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.59,
      "end_seconds": 275.87,
      "duration_seconds": 3.28,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.57,
      "end_seconds": 281.52,
      "duration_seconds": 4.95,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.01,
      "end_seconds": 292.76,
      "duration_seconds": 9.75,
      "text": "I think I reacted to some antibiotic once, you know, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 295.67,
      "end_seconds": 305.09,
      "duration_seconds": 9.42,
      "text": "Here are the numbers, doctor. Pressure 111 over 77, SpO2 97 percent on room air. Respiratory rate 14, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.03,
      "end_seconds": 307.73,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.69,
      "end_seconds": 314.62,
      "duration_seconds": 4.93,
      "text": "right, I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.52,
      "end_seconds": 318.61,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.04,
      "end_seconds": 340.48,
      "duration_seconds": 5.44,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.94,
      "end_seconds": 352.91,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.29,
      "end_seconds": 379.97,
      "duration_seconds": 24.68,
      "text": "That's all I needed to check. Putting it all together, this looks most like possible adult attention deficit disorder. I want to be honest that this is an impression, not a final answer. Thyroid problems is also on my list. Stop me if I've got anything wrong. You've had restlessness for six months, moderate, and no head injury or thoughts of self-harm."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 380.79,
      "end_seconds": 382.32,
      "duration_seconds": 1.53,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.98,
      "end_seconds": 402.6,
      "duration_seconds": 18.62,
      "text": "A thyroid test is what I'd like next, for poor concentration i'll request a questionnaire, it'll help with attention problems use lists and reminders while we arrange the specialist assessment i'll also refer you to the adult ADHD service"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.48,
      "end_seconds": 405.18,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.97,
      "end_seconds": 419.49,
      "duration_seconds": 12.52,
      "text": "keep an eye out, and if the symptoms get worse, call us the same day or go to emergency please come and see me after the assessment"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 420.91,
      "end_seconds": 425.11,
      "duration_seconds": 4.2,
      "text": "Hmm, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.11,
      "end_seconds": 430.19,
      "duration_seconds": 4.08,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 431.97,
      "end_seconds": 435.6,
      "duration_seconds": 3.63,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}