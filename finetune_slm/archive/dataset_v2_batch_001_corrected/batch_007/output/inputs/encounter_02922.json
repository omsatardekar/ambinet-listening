    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.7,
      "end_seconds": 21.85,
      "duration_seconds": 9.15,
      "text": "So the thing is, um, I've got itchy blisters. I've been putting this off for weeks."
