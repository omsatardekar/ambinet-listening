    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.08,
      "end_seconds": 99.34,
      "duration_seconds": 4.26,
      "text": "and what about eye problems, new medicine or fever?"
