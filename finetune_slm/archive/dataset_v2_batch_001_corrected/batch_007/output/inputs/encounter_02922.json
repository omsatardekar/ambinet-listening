    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.34,
      "end_seconds": 319.58,
      "duration_seconds": 2.24,
      "text": "okay, that's enough for me"
