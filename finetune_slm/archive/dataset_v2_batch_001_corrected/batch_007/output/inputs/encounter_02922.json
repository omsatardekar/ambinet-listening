      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.17,
      "end_seconds": 177.35,
      "duration_seconds": 4.18,
      "text": "I don't think I have any, no."
