    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.2,
      "end_seconds": 125.24,
      "duration_seconds": 3.04,
      "text": "Alright, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.24,
      "end_seconds": 130.08,
      "duration_seconds": 2.84,
      "text": "Bowels are regular, nothing odd."
