      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.64,
      "end_seconds": 339.4,
      "duration_seconds": 9.76,
      "text": "Let me tell you where I've got to. This looks most like bullous pemphigoid. A A drug reaction is also on my list."
    },
