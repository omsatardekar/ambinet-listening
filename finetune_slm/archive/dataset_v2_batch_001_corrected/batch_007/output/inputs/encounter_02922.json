      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.34,
      "end_seconds": 275.68,
      "duration_seconds": 2.34,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.74,
      "end_seconds": 282.74,
      "duration_seconds": 6.0,
      "text": "yes, um, I had a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.22,
      "end_seconds": 288.85,
      "duration_seconds": 3.63,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
