    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.82,
      "end_seconds": 25.36,
      "duration_seconds": 2.54,
      "text": "let's start with the basic checks"
