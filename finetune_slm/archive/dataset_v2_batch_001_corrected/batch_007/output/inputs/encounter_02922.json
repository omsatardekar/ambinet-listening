      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.57,
      "end_seconds": 210.42,
      "duration_seconds": 6.85,
      "text": "about six months. Aspirin, 75 milligrams, once a day for my heart"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.24,
      "end_seconds": 213.02,
      "duration_seconds": 1.78,
      "text": "and for how long?"
