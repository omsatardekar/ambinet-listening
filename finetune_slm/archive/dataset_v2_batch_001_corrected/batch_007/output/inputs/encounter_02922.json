      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 218.21,
      "duration_seconds": 4.28,
      "text": "Six months now. Telmisartan I don't take anymore"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.2,
      "end_seconds": 222.62,
      "duration_seconds": 2.42,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.32,
      "end_seconds": 233.82,
      "duration_seconds": 9.5,
      "text": "Mm, I've had high blood pressure, yes. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.09,
      "end_seconds": 236.66,
      "duration_seconds": 1.57,
      "text": "okay, what else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.37,
      "end_seconds": 256.06,
      "duration_seconds": 17.69,
      "text": "oh, I've had thin bones, yes. My neighbour said I should get it looked at. Work has been very busy so I kept ignoring it. I've, I've got heart disease"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.96,
      "end_seconds": 262.31,
      "duration_seconds": 4.35,
      "text": "alright, high blood pressure, that matches what I have here"
