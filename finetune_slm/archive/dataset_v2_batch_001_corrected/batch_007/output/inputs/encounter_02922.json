    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.74,
      "end_seconds": 108.37,
      "duration_seconds": 2.63,
      "text": "did you notice any mouth sores?"
    },
    {
      "segment_id": "SEG0013",
