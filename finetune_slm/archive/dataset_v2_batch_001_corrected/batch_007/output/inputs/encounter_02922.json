    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.03,
      "end_seconds": 197.97,
      "duration_seconds": 13.94,
      "text": "I mean, uh, I take lisinopril, 10 milligrams, once a day for my pressure. Uh, I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.07,
      "end_seconds": 201.91,
      "duration_seconds": 2.84,
      "text": "how long has that been going on?"
