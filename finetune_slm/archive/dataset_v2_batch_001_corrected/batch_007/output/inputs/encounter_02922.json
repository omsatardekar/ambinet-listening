      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.4,
      "end_seconds": 296.31,
      "duration_seconds": 2.91,
      "text": "right, I'm just checking this side"
