    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.89,
      "end_seconds": 132.1,
      "duration_seconds": 1.21,
      "text": "do you smoke?"
