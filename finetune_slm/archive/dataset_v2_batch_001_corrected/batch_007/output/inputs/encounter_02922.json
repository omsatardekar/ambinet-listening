      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.46,
      "end_seconds": 312.71,
      "duration_seconds": 6.25,
      "text": "there are firm, tense blisters on a red base on the arms and and legs"
