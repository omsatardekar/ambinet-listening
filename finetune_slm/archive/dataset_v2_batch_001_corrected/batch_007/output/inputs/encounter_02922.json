    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.62,
      "end_seconds": 120.35,
      "duration_seconds": 1.73,
      "text": "Nothing like that."
