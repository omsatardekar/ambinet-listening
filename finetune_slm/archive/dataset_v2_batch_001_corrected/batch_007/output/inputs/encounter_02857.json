    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.97,
      "end_seconds": 220.95,
      "duration_seconds": 4.98,
      "text": "Okay, I can see eczema in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 222.33,
      "end_seconds": 233.64,
      "duration_seconds": 11.31,
      "text": "here are the numbers, doctor pressure 128 over 68, respiratory rate 16, temp 36.5 degrees, saturation 99 percent, pulse is 71 beats a minute"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.01,
      "end_seconds": 235.71,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.35,
      "end_seconds": 243.06,
      "duration_seconds": 4.71,
      "text": "I'd like to check you over now if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.64,
      "end_seconds": 246.07,
      "duration_seconds": 1.43,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.36,
      "end_seconds": 268.87,
      "duration_seconds": 5.51,
      "text": "the inside of the nose is pale and boggy with clear mucus"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.55,
      "end_seconds": 301.78,
      "duration_seconds": 29.23,
      "text": "okay, all finished, thank you. So where does that leave us? The most likely explanation is seasonal allergic rhinitis. For this, fluticasone nasal spray, 50 micrograms, once a day, the season. That That should help with hay fever. Shower after being outdoors and keep windows shut when pollen is high. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.72,
      "end_seconds": 312.23,
      "duration_seconds": 9.51,
      "text": "Please come and see me if not better in a month. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.29,
      "end_seconds": 318.07,
      "duration_seconds": 3.78,
      "text": "Good, thanks, I'll see you then."
    }
