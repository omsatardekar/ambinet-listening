      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.26,
      "end_seconds": 125.02,
      "duration_seconds": 3.76,
      "text": "oh, my grandfather had a stroke"
