      "role": "PATIENT",
      "start_seconds": 27.28,
      "end_seconds": 34.22,
      "duration_seconds": 6.94,
      "text": "I'd say three weeks actually, no, closer to about two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.92,
      "end_seconds": 39.25,
      "duration_seconds": 4.33,
      "text": "Okay give me more detail on it whatever comes to mind."
    },
