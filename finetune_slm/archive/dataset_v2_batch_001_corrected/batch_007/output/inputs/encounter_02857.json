    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.81,
      "end_seconds": 148.06,
      "duration_seconds": 4.25,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.78,
      "end_seconds": 162.12,
      "duration_seconds": 13.34,
      "text": "I drink a lot of tea and snack through the day. My partner and our baby. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.97,
      "end_seconds": 179.29,
      "duration_seconds": 4.32,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.7,
      "end_seconds": 185.37,
      "duration_seconds": 4.67,
      "text": "Let me think, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.32,
      "end_seconds": 189.46,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
