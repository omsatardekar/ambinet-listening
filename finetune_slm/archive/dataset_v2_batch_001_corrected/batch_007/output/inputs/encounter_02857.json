    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.77,
      "end_seconds": 105.53,
      "duration_seconds": 2.76,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.31,
      "end_seconds": 120.1,
      "duration_seconds": 2.79,
      "text": "are there any illnesses in your family?"
