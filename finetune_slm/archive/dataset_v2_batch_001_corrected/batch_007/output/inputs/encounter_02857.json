      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.87,
      "end_seconds": 194.17,
      "duration_seconds": 3.3,
      "text": "I'm on hydrocortisone cream, when needed"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.8,
      "end_seconds": 197.75,
      "duration_seconds": 2.95,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.24,
      "end_seconds": 201.2,
      "duration_seconds": 1.96,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.07,
      "end_seconds": 205.65,
      "duration_seconds": 3.58,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.4,
      "end_seconds": 214.37,
      "duration_seconds": 3.97,
      "text": "I have eczema, for about ten years"
