      "role": "PATIENT",
      "start_seconds": 41.34,
      "end_seconds": 50.93,
      "duration_seconds": 9.59,
      "text": "Maybe a three out of ten on a bad day. Antihistamine helps a bit. Honestly on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.78,
      "end_seconds": 55.33,
      "duration_seconds": 2.55,
