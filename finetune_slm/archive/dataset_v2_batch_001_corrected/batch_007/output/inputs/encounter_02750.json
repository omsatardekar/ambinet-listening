{
  "schema_version": "1.0",
  "encounter_id": "02750",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 6.67,
      "duration_seconds": 5.89,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.75,
      "end_seconds": 12.1,
      "duration_seconds": 4.35,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.56,
      "end_seconds": 22.49,
      "duration_seconds": 4.93,
      "text": "I wanted to get weakness climbing up my legs looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.9,
      "end_seconds": 29.54,
      "duration_seconds": 3.64,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.7,
      "end_seconds": 35.03,
      "duration_seconds": 2.33,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.76,
      "end_seconds": 38.91,
      "duration_seconds": 3.15,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.76,
      "end_seconds": 44.25,
      "duration_seconds": 3.49,
      "text": "pretty moderate, if I'm being honest"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.92,
      "end_seconds": 47.83,
      "duration_seconds": 2.91,
      "text": "Okay, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.61,
      "end_seconds": 52.2,
      "duration_seconds": 3.59,
      "text": "It usually comes with a recent stomach bug."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.47,
      "end_seconds": 55.73,
      "duration_seconds": 2.26,
      "text": "any sign of bladder problems?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.84,
      "end_seconds": 59.06,
      "duration_seconds": 2.22,
      "text": "No bladder problems, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.32,
      "end_seconds": 63.98,
      "duration_seconds": 4.66,
      "text": "Yes, carry on. Any back pain or fever at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.76,
      "end_seconds": 68.67,
      "duration_seconds": 3.91,
      "text": "no back pain or fever, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.73,
      "end_seconds": 71.9,
      "duration_seconds": 2.17,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.78,
      "end_seconds": 74.58,
      "duration_seconds": 1.8,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 95.5,
      "duration_seconds": 4.27,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.42,
      "end_seconds": 98.83,
      "duration_seconds": 2.41,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.1,
      "end_seconds": 114.29,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.91,
      "end_seconds": 119.82,
      "duration_seconds": 3.91,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.6,
      "end_seconds": 123.54,
      "duration_seconds": 1.94,
      "text": "okay, do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.17,
      "end_seconds": 129.41,
      "duration_seconds": 4.24,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.81,
      "end_seconds": 132.45,
      "duration_seconds": 1.64,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.35,
      "end_seconds": 136.51,
      "duration_seconds": 3.16,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.69,
      "end_seconds": 144.66,
      "duration_seconds": 1.97,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.87,
      "end_seconds": 149.76,
      "duration_seconds": 3.89,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.98,
      "end_seconds": 153.67,
      "duration_seconds": 2.69,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.45,
      "end_seconds": 158.75,
      "duration_seconds": 3.3,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.64,
      "end_seconds": 172.31,
      "duration_seconds": 4.67,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.32,
      "end_seconds": 177.51,
      "duration_seconds": 3.19,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.01,
      "end_seconds": 191.78,
      "duration_seconds": 8.77,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear. Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.29,
      "end_seconds": 195.0,
      "duration_seconds": 2.71,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.56,
      "end_seconds": 200.33,
      "duration_seconds": 3.77,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.31,
      "end_seconds": 215.93,
      "duration_seconds": 2.62,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.86,
      "end_seconds": 240.32,
      "duration_seconds": 8.46,
      "text": "Okay: temp 36.7 degrees, pulse is 73 beats a minute, saturation 97 percent, blood pressure 118 over 68."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.64,
      "end_seconds": 243.01,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.71,
      "end_seconds": 246.11,
      "duration_seconds": 2.4,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.86,
      "end_seconds": 251.39,
      "duration_seconds": 2.53,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.3,
      "end_seconds": 254.73,
      "duration_seconds": 1.43,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.76,
      "end_seconds": 269.98,
      "duration_seconds": 5.22,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.46,
      "end_seconds": 278.75,
      "duration_seconds": 6.29,
      "text": "You can relax now. So where does that leave us? This is probably possible Guillain-Barre syndrome."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.17,
      "end_seconds": 295.86,
      "duration_seconds": 3.69,
      "text": "We should do a breathing test for possible GBS."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.71,
      "end_seconds": 299.63,
      "duration_seconds": 2.92,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.02,
      "end_seconds": 305.36,
      "duration_seconds": 4.34,
      "text": "We should do a lumbar puncture for possible GBS."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.23,
      "end_seconds": 308.8,
      "duration_seconds": 2.57,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.09,
      "end_seconds": 314.58,
      "duration_seconds": 4.49,
      "text": "you must be admitted today for monitoring of your breathing"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.09,
      "end_seconds": 323.67,
      "duration_seconds": 8.58,
      "text": "Right, right. I'm going to send a referral to the neurology team. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.59,
      "end_seconds": 326.84,
      "duration_seconds": 2.25,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.99,
      "end_seconds": 329.36,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}