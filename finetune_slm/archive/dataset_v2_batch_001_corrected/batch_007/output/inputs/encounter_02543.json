{
  "schema_version": "1.0",
  "encounter_id": "02543",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 7.94,
      "duration_seconds": 6.83,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.74,
      "end_seconds": 13.63,
      "duration_seconds": 3.89,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.66,
      "end_seconds": 23.26,
      "duration_seconds": 8.6,
      "text": "Mainly fainting on exertion. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.24,
      "end_seconds": 29.41,
      "duration_seconds": 4.17,
      "text": "Okay, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.04,
      "end_seconds": 34.12,
      "duration_seconds": 3.08,
      "text": "I've had it for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 38.92,
      "duration_seconds": 4.33,
      "text": "I follow. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.88,
      "end_seconds": 44.69,
      "duration_seconds": 3.81,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.12,
      "end_seconds": 51.16,
      "duration_seconds": 5.04,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 55.57,
      "duration_seconds": 3.25,
      "text": "It's, It's a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.21,
      "end_seconds": 60.93,
      "duration_seconds": 3.72,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.68,
      "end_seconds": 70.75,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.03,
      "end_seconds": 97.03,
      "duration_seconds": 6.0,
      "text": "Okay: heart rate 90, BP is 123 over 85, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.65,
      "end_seconds": 99.64,
      "duration_seconds": 1.99,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.59,
      "end_seconds": 104.51,
      "duration_seconds": 3.92,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.81,
      "end_seconds": 109.65,
      "duration_seconds": 2.84,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.98,
      "end_seconds": 112.94,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.36,
      "end_seconds": 127.11,
      "duration_seconds": 5.75,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.1,
      "end_seconds": 131.82,
      "duration_seconds": 1.72,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.77,
      "end_seconds": 146.36,
      "duration_seconds": 2.59,
      "text": "Did you notice any leg pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.39,
      "end_seconds": 149.31,
      "duration_seconds": 1.92,
      "text": "Definitely no leg pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.83,
      "end_seconds": 151.65,
      "duration_seconds": 1.82,
      "text": "Any fever or cough?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 154.8,
      "duration_seconds": 2.63,
      "text": "No, no fever or cough."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 159.3,
      "duration_seconds": 2.87,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.53,
      "end_seconds": 161.63,
      "duration_seconds": 1.1,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.06,
      "end_seconds": 165.86,
      "duration_seconds": 2.8,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 168.54,
      "duration_seconds": 2.02,
      "text": "Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.46,
      "end_seconds": 175.24,
      "duration_seconds": 5.78,
      "text": "Yes, an enlarged prostate is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.91,
      "end_seconds": 195.53,
      "duration_seconds": 3.62,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.39,
      "end_seconds": 201.72,
      "duration_seconds": 4.33,
      "text": "Tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.55,
      "end_seconds": 218.02,
      "duration_seconds": 2.47,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.79,
      "end_seconds": 222.99,
      "duration_seconds": 3.2,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.93,
      "end_seconds": 226.39,
      "duration_seconds": 2.46,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.21,
      "end_seconds": 231.15,
      "duration_seconds": 3.94,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.1,
      "end_seconds": 233.48,
      "duration_seconds": 1.38,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.17,
      "end_seconds": 241.57,
      "duration_seconds": 4.4,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.0,
      "end_seconds": 254.9,
      "duration_seconds": 2.9,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.23,
      "end_seconds": 261.74,
      "duration_seconds": 5.51,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.44,
      "end_seconds": 273.31,
      "duration_seconds": 9.87,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be possible pulmonary hypertension, or it might be a heart valve problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.85,
      "end_seconds": 276.42,
      "duration_seconds": 1.57,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.91,
      "end_seconds": 295.66,
      "duration_seconds": 17.75,
      "text": "Nothing I've seen today points to an emergency. It looks like possible pulmonary hypertension, but I'd like to confirm. Let's book an ECG to look into syncope. No exertion for now, I am arranging urgent specialist tests. We'll refer you to the pulmonary hypertension service."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.17,
      "end_seconds": 301.84,
      "duration_seconds": 1.67,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.56,
      "end_seconds": 309.34,
      "duration_seconds": 6.78,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.37,
      "end_seconds": 312.92,
      "duration_seconds": 1.55,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.31,
      "end_seconds": 318.11,
      "duration_seconds": 3.8,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.64,
      "end_seconds": 321.1,
      "duration_seconds": 2.46,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.7,
      "end_seconds": 323.94,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}