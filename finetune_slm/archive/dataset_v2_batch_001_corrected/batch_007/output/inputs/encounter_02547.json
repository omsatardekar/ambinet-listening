{
  "schema_version": "1.0",
  "encounter_id": "02547",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.12,
      "duration_seconds": 2.83,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 9.65,
      "duration_seconds": 3.53,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.72,
      "end_seconds": 14.65,
      "duration_seconds": 3.93,
      "text": "Well, I've been having fainting on exertion."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.11,
      "end_seconds": 25.51,
      "duration_seconds": 6.4,
      "text": "Can you tell me when it first started? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.85,
      "end_seconds": 28.72,
      "duration_seconds": 1.87,
      "text": "probably three days. Yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.46,
      "end_seconds": 33.48,
      "duration_seconds": 3.02,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.29,
      "end_seconds": 38.94,
      "duration_seconds": 3.65,
      "text": "right, uh, I'd call it moderate"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.61,
      "end_seconds": 42.88,
      "duration_seconds": 2.27,
      "text": "any swollen ankles as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.93,
      "end_seconds": 51.39,
      "duration_seconds": 6.46,
      "text": "Mm, you know, yes. I've also had chest tightness, for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 59.3,
      "duration_seconds": 6.39,
      "text": "Have you had fainting on exertion before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.4,
      "end_seconds": 67.13,
      "duration_seconds": 5.73,
      "text": "I had a similar thing about six months ago it went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.85,
      "end_seconds": 75.19,
      "duration_seconds": 6.34,
      "text": "Let me check a a few things. Any cough, fever or leg pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.03,
      "end_seconds": 78.87,
      "duration_seconds": 2.84,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.62,
      "end_seconds": 82.6,
      "duration_seconds": 2.98,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.88,
      "end_seconds": 86.12,
      "duration_seconds": 2.24,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.22,
      "end_seconds": 89.83,
      "duration_seconds": 2.61,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.91,
      "end_seconds": 92.92,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.57,
      "end_seconds": 107.27,
      "duration_seconds": 2.7,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.64,
      "end_seconds": 111.48,
      "duration_seconds": 2.84,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.98,
      "end_seconds": 119.97,
      "duration_seconds": 4.99,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.64,
      "end_seconds": 125.03,
      "duration_seconds": 3.39,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.25,
      "end_seconds": 137.11,
      "duration_seconds": 0.86,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.52,
      "end_seconds": 142.21,
      "duration_seconds": 3.69,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.47,
      "end_seconds": 147.72,
      "duration_seconds": 1.25,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.65,
      "end_seconds": 154.73,
      "duration_seconds": 6.08,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.47,
      "end_seconds": 157.29,
      "duration_seconds": 1.82,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.48,
      "end_seconds": 162.95,
      "duration_seconds": 4.47,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.92,
      "end_seconds": 168.26,
      "duration_seconds": 3.34,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.97,
      "end_seconds": 177.47,
      "duration_seconds": 3.5,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.69,
      "end_seconds": 180.88,
      "duration_seconds": 2.19,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.55,
      "end_seconds": 186.65,
      "duration_seconds": 4.1,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.44,
      "end_seconds": 201.45,
      "duration_seconds": 4.01,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.3,
      "end_seconds": 204.85,
      "duration_seconds": 1.55,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.0,
      "end_seconds": 209.17,
      "duration_seconds": 3.17,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.57,
      "end_seconds": 213.35,
      "duration_seconds": 2.78,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.89,
      "end_seconds": 218.31,
      "duration_seconds": 3.42,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.64,
      "end_seconds": 229.25,
      "duration_seconds": 2.61,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.89,
      "end_seconds": 263.69,
      "duration_seconds": 12.8,
      "text": "okay: BMI works out to 21.6, temp 37.3 degrees, heart rate 104, weight 66 kilos, saturation 92 percent, blood pressure 142 over 89, height 175 centimetres"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.96,
      "end_seconds": 270.15,
      "duration_seconds": 5.19,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.26,
      "end_seconds": 273.07,
      "duration_seconds": 1.81,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.74,
      "end_seconds": 291.75,
      "duration_seconds": 5.01,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.68,
      "end_seconds": 293.78,
      "duration_seconds": 1.1,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.16,
      "end_seconds": 311.64,
      "duration_seconds": 13.48,
      "text": "so, good, you can sit up again taking everything into account, it points towards possible pulmonary hypertension that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.71,
      "end_seconds": 318.79,
      "duration_seconds": 3.08,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.87,
      "end_seconds": 338.08,
      "duration_seconds": 17.21,
      "text": "Nothing I've seen today points to an emergency. It looks like possible pulmonary hypertension, but I'd like to confirm. Stop me if I've got anything wrong. You've had fainting on exertion for three days, moderate, and no cough or leg pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.32,
      "end_seconds": 340.88,
      "duration_seconds": 1.56,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.74,
      "end_seconds": 345.64,
      "duration_seconds": 3.9,
      "text": "Blood tests is what I'd like next, for breathlessness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 347.39,
      "end_seconds": 350.74,
      "duration_seconds": 3.35,
      "text": "I can book that for Thursday at 2 pm."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.45,
      "end_seconds": 353.38,
      "duration_seconds": 0.93,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.16,
      "end_seconds": 365.46,
      "duration_seconds": 11.3,
      "text": "no exertion for now, I am arranging urgent specialist tests let's get you seen by the pulmonary hypertension service, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.23,
      "end_seconds": 369.55,
      "duration_seconds": 3.32,
      "text": "Sure, um, where do I go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.63,
      "end_seconds": 378.78,
      "duration_seconds": 8.15,
      "text": "We'll catch up in one week. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.22,
      "end_seconds": 386.31,
      "duration_seconds": 6.09,
      "text": "So, I come back in one week. Is that that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.09,
      "end_seconds": 392.64,
      "duration_seconds": 4.55,
      "text": "yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.35,
      "end_seconds": 396.11,
      "duration_seconds": 1.76,
      "text": "That's clear, thanks."
    }
  ]
}