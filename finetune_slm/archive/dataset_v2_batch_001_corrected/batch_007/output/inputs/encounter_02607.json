{
  "schema_version": "1.0",
  "encounter_id": "02607",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.28,
      "duration_seconds": 4.4,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.92,
      "end_seconds": 9.62,
      "duration_seconds": 3.7,
      "text": "yes, have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 19.75,
      "duration_seconds": 8.04,
      "text": "Doctor, it's a growing red ring on my thigh. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.13,
      "end_seconds": 24.75,
      "duration_seconds": 3.62,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.64,
      "end_seconds": 35.71,
      "duration_seconds": 10.07,
      "text": "I've had it for three days. There's tiredness as well. Erm, and a mild headache as well, since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.57,
      "end_seconds": 39.25,
      "duration_seconds": 2.68,
      "text": "so, how frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.98,
      "end_seconds": 44.96,
      "duration_seconds": 3.98,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.82,
      "end_seconds": 54.69,
      "duration_seconds": 7.87,
      "text": "Have you had a growing red ring on your thigh before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.99,
      "end_seconds": 63.51,
      "duration_seconds": 7.52,
      "text": "I, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.92,
      "end_seconds": 69.82,
      "duration_seconds": 4.9,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.87,
      "end_seconds": 75.11,
      "duration_seconds": 4.24,
      "text": "Yeah, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.36,
      "end_seconds": 87.32,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.57,
      "end_seconds": 94.8,
      "duration_seconds": 6.23,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.59,
      "end_seconds": 99.02,
      "duration_seconds": 2.43,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.75,
      "end_seconds": 103.52,
      "duration_seconds": 2.77,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.45,
      "end_seconds": 107.53,
      "duration_seconds": 3.08,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.97,
      "end_seconds": 112.05,
      "duration_seconds": 3.08,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.91,
      "end_seconds": 117.21,
      "duration_seconds": 4.3,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.8,
      "end_seconds": 131.07,
      "duration_seconds": 8.27,
      "text": "Aspirin, 75 milligrams, once a day. I'm on furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.34,
      "end_seconds": 139.62,
      "duration_seconds": 7.28,
      "text": "Any allergies to tablets, food or anything in the environment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.49,
      "end_seconds": 144.93,
      "duration_seconds": 3.44,
      "text": "uh, I've never had an allergy"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.99,
      "end_seconds": 161.34,
      "duration_seconds": 3.35,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.27,
      "end_seconds": 167.67,
      "duration_seconds": 5.4,
      "text": "okay, so just a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.19,
      "end_seconds": 171.38,
      "duration_seconds": 3.19,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.08,
      "end_seconds": 189.01,
      "duration_seconds": 15.93,
      "text": "I've had heart disease for nearly five years now. Let me think, yes, heart failure. I've been putting this off for weeks. I just wanna get back to normal, really."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.58,
      "end_seconds": 202.98,
      "duration_seconds": 2.4,
      "text": "Any joint swelling or facial weakness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.96,
      "end_seconds": 209.71,
      "duration_seconds": 5.75,
      "text": "Erm, no joint swelling or facial weakness, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.01,
      "end_seconds": 213.12,
      "duration_seconds": 3.11,
      "text": "Ah. Any stiff neck or palpitations at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.65,
      "end_seconds": 216.72,
      "duration_seconds": 3.07,
      "text": "Hmm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.6,
      "end_seconds": 220.06,
      "duration_seconds": 2.46,
      "text": "Right, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.89,
      "end_seconds": 222.61,
      "duration_seconds": 1.72,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.9,
      "end_seconds": 229.42,
      "duration_seconds": 4.52,
      "text": "Right, let's have a a proper look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.05,
      "end_seconds": 232.49,
      "duration_seconds": 1.44,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.7,
      "end_seconds": 253.19,
      "duration_seconds": 6.49,
      "text": "there is an expanding ring-shaped red patch, about eight centimetres across, on the thigh"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.14,
      "end_seconds": 266.06,
      "duration_seconds": 8.92,
      "text": "that's the examination finished okay, so my impression is this: I think we're dealing with early Lyme disease at this stage"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.99,
      "end_seconds": 269.66,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.77,
      "end_seconds": 285.21,
      "duration_seconds": 14.44,
      "text": "I understand the worry. At the moment I'd say it's early Lyme disease, and we'll watch how it goes. Take the doxycycline with food and avoid strong sun. Come back in three weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.54,
      "end_seconds": 288.7,
      "duration_seconds": 2.16,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.41,
      "end_seconds": 294.93,
      "duration_seconds": 4.52,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.05,
      "end_seconds": 302.01,
      "duration_seconds": 5.96,
      "text": "So, I come back in three weeks. Is that that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.25,
      "end_seconds": 309.4,
      "duration_seconds": 6.15,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.81,
      "end_seconds": 314.84,
      "duration_seconds": 4.03,
      "text": "Actually, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.79,
      "end_seconds": 317.78,
      "duration_seconds": 1.99,
      "text": "Alright, take care now."
    }
  ]
}