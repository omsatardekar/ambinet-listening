  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.04,
      "end_seconds": 3.21,
      "duration_seconds": 2.17,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.32,
      "end_seconds": 7.34,
      "duration_seconds": 3.02,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.18,
      "end_seconds": 12.69,
      "duration_seconds": 4.51,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.28,
      "end_seconds": 19.21,
      "duration_seconds": 5.93,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.54,
      "end_seconds": 22.21,
      "duration_seconds": 1.67,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.4,
      "end_seconds": 31.48,
      "duration_seconds": 8.08,
      "text": "Mainly it stopping just as suddenly. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.37,
      "end_seconds": 35.36,
      "duration_seconds": 2.99,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.43,
      "end_seconds": 43.61,
      "duration_seconds": 2.18,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.94,
      "end_seconds": 66.55,
      "duration_seconds": 9.61,
      "text": "Okay: respiratory rate 16, pressure 112 over 77, temperature is 36.5 degrees, heart rate 82, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.5,
      "end_seconds": 69.83,
      "duration_seconds": 2.33,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.91,
      "end_seconds": 78.31,
      "duration_seconds": 7.4,
      "text": "Don't worry, we'll discuss it in a second. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.51,
      "end_seconds": 95.26,
      "duration_seconds": 15.75,
      "text": "About... well, two months. And I've been feeling lightheaded during an episode as well. About feeling lightheaded during an episode, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.5,
      "end_seconds": 118.56,
      "duration_seconds": 6.06,
      "text": "Any chest pain, fainting, family history of sudden death or breathlessness at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.2,
      "end_seconds": 123.26,
      "duration_seconds": 4.06,
      "text": "Uh, no, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.01,
      "end_seconds": 128.02,
      "duration_seconds": 3.01,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.49,
      "end_seconds": 132.03,
      "duration_seconds": 2.54,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.17,
      "end_seconds": 148.62,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.15,
      "end_seconds": 154.35,
      "duration_seconds": 4.2,
      "text": "Hmm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.21,
      "end_seconds": 159.32,
      "duration_seconds": 3.11,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.28,
      "end_seconds": 171.46,
      "duration_seconds": 11.18,
      "text": "I look after my grandchildren most days. I drink a lot of tea and snack through the day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.09,
      "end_seconds": 175.76,
      "duration_seconds": 3.67,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.37,
      "end_seconds": 181.38,
      "duration_seconds": 4.01,
      "text": "I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.86,
      "end_seconds": 186.29,
      "duration_seconds": 3.43,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.47,
      "end_seconds": 188.82,
      "duration_seconds": 1.35,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.57,
      "end_seconds": 193.34,
      "duration_seconds": 3.77,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.69,
      "end_seconds": 197.37,
      "duration_seconds": 2.68,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.37,
      "end_seconds": 204.43,
      "duration_seconds": 5.06,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.95,
      "end_seconds": 212.33,
      "duration_seconds": 6.38,
      "text": "Oh, it's valsartan, 80 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.28,
      "end_seconds": 218.76,
      "duration_seconds": 3.48,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.66,
      "end_seconds": 223.73,
      "duration_seconds": 3.07,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.19,
      "end_seconds": 242.5,
      "duration_seconds": 3.31,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.42,
      "end_seconds": 249.53,
      "duration_seconds": 2.11,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.74,
      "end_seconds": 292.39,
      "duration_seconds": 29.65,
      "text": "I'll request a thyroid test, it'll help with palpitations. I think a 7-day heart monitor makes sense here, for paroxysmal palpitations. I'd rather check than guess, and this is the quickest way to know more. I'll request an ECG, it'll help with palpitations. Try blowing hard against a closed mouth and nose when it starts. I'd like you to see the cardiology clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.92,
      "end_seconds": 300.98,
      "duration_seconds": 3.06,
      "text": "So, sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.31,
      "end_seconds": 309.1,
      "duration_seconds": 6.79,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.54,
      "end_seconds": 312.14,
      "duration_seconds": 1.6,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.7,
      "end_seconds": 320.86,
      "duration_seconds": 7.16,
      "text": "We'll catch up after the monitor. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.19,
      "end_seconds": 325.28,
      "duration_seconds": 3.09,
      "text": "I think I understand everything. Thanks."
    }
  ]
}