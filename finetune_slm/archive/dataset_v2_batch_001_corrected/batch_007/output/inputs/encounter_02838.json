{
  "schema_version": "1.0",
  "encounter_id": "02838",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 6.76,
      "duration_seconds": 5.53,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.59,
      "end_seconds": 13.19,
      "duration_seconds": 4.6,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.01,
      "end_seconds": 18.63,
      "duration_seconds": 3.62,
      "text": "So, I've been passing kidney stones, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 20.63,
      "end_seconds": 30.09,
      "duration_seconds": 9.46,
      "text": "Okay, so the vitals from earlier. Blood pressure 124 over 80, temperature is 36.4 degrees, heart rate 83, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.77,
      "end_seconds": 40.51,
      "duration_seconds": 4.74,
      "text": "Okay, thanks. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.66,
      "end_seconds": 56.51,
      "duration_seconds": 14.85,
      "text": "actually, honestly I can't say exactly when it it started it might have been last month or the month before, I really can't pin it down"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.17,
      "end_seconds": 62.71,
      "duration_seconds": 3.54,
      "text": "so, how much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.02,
      "end_seconds": 64.92,
      "duration_seconds": 0.9,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.38,
      "end_seconds": 71.28,
      "duration_seconds": 5.9,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 71.38,
      "end_seconds": 77.96,
      "duration_seconds": 6.58,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.48,
      "end_seconds": 80.78,
      "duration_seconds": 2.3,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.34,
      "end_seconds": 83.55,
      "duration_seconds": 2.21,
      "text": "I've also had constipation."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.5,
      "end_seconds": 89.03,
      "duration_seconds": 3.53,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.29,
      "end_seconds": 94.21,
      "duration_seconds": 3.92,
      "text": "I'd give it a seven, out of ten"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 100.24,
      "duration_seconds": 5.06,
      "text": "Have you been passing kidney stones at any time before this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.14,
      "end_seconds": 106.64,
      "duration_seconds": 5.5,
      "text": "a bit, about six months ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 107.69,
      "end_seconds": 110.07,
      "duration_seconds": 2.38,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.67,
      "end_seconds": 116.75,
      "duration_seconds": 5.08,
      "text": "Did you get fractures, weight loss, low mood or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.08,
      "end_seconds": 131.1,
      "duration_seconds": 13.02,
      "text": "no, no fractures, no weight loss, no low mood i did have aching bones at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.47,
      "end_seconds": 136.74,
      "duration_seconds": 4.27,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.05,
      "end_seconds": 140.2,
      "duration_seconds": 2.15,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.69,
      "end_seconds": 143.66,
      "duration_seconds": 1.97,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.74,
      "end_seconds": 151.96,
      "duration_seconds": 4.22,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.84,
      "end_seconds": 160.37,
      "duration_seconds": 2.53,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.66,
      "end_seconds": 165.72,
      "duration_seconds": 4.06,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.39,
      "end_seconds": 171.03,
      "duration_seconds": 4.64,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.06,
      "end_seconds": 174.15,
      "duration_seconds": 2.09,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.9,
      "end_seconds": 177.02,
      "duration_seconds": 2.12,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.75,
      "end_seconds": 187.48,
      "duration_seconds": 9.73,
      "text": "Yes, I had an operation for a hernia, last spring. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.76,
      "end_seconds": 190.86,
      "duration_seconds": 2.1,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.87,
      "end_seconds": 194.69,
      "duration_seconds": 2.82,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.78,
      "end_seconds": 196.48,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.24,
      "end_seconds": 200.46,
      "duration_seconds": 2.22,
      "text": "I've got low haemoglobin."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.28,
      "end_seconds": 201.98,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.89,
      "end_seconds": 205.51,
      "duration_seconds": 1.62,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.81,
      "end_seconds": 209.85,
      "duration_seconds": 3.04,
      "text": "Right, and and anything else to add?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.76,
      "end_seconds": 217.26,
      "duration_seconds": 6.5,
      "text": "I've had gout for nearly five years now i've had an underactive thyroid, yes"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.45,
      "end_seconds": 227.57,
      "duration_seconds": 9.12,
      "text": "okay, I can see an underactive thyroid in your file as well. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.54,
      "end_seconds": 242.26,
      "duration_seconds": 13.72,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.53,
      "end_seconds": 257.34,
      "duration_seconds": 4.81,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 261.12,
      "end_seconds": 283.72,
      "duration_seconds": 22.6,
      "text": "It's alendronate, 70 milligrams, once a week. Iron tablets. I take it once a day. It's spironolactone, 25 milligrams, once a day for my heart. I wasn't sure whether to come in at all, to be honest. Allopurinol. I take it 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 285.49,
      "end_seconds": 290.77,
      "duration_seconds": 5.28,
      "text": "doctor, our chart from the the last visit lists it as 50 milligrams"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.61,
      "end_seconds": 297.52,
      "duration_seconds": 5.91,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.02,
      "end_seconds": 302.18,
      "duration_seconds": 4.16,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.87,
      "end_seconds": 313.28,
      "duration_seconds": 10.41,
      "text": "Going by what you've described, I'd lean towards possible raised calcium from an overactive parathyroid. I'd also keep vitamin D excess in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.34,
      "end_seconds": 325.25,
      "duration_seconds": 4.91,
      "text": "I'm going to order a kidney ultrasound, for kidney stones"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 326.43,
      "end_seconds": 331.83,
      "duration_seconds": 5.4,
      "text": "We have a slot Friday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.49,
      "end_seconds": 358.8,
      "duration_seconds": 25.31,
      "text": "we should do a calcium and parathyroid hormone test for kidney stones. Drink plenty of water and avoid calcium supplements until the results. I'll also refer you to the endocrine clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.96,
      "end_seconds": 361.56,
      "duration_seconds": 1.6,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.43,
      "end_seconds": 370.28,
      "duration_seconds": 7.85,
      "text": "Please come and see me after the results. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.09,
      "end_seconds": 376.07,
      "duration_seconds": 4.98,
      "text": "Let me think, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.34,
      "end_seconds": 378.8,
      "duration_seconds": 1.46,
      "text": "take care now"
    }
  ]
}