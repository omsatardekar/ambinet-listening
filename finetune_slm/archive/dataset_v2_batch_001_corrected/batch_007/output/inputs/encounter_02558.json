{
  "schema_version": "1.0",
  "encounter_id": "02558",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.19,
      "end_seconds": 7.67,
      "duration_seconds": 6.48,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.55,
      "end_seconds": 18.53,
      "duration_seconds": 4.98,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.64,
      "end_seconds": 22.03,
      "duration_seconds": 2.39,
      "text": "It's difficulty concentrating, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 23.67,
      "end_seconds": 34.08,
      "duration_seconds": 10.41,
      "text": "Here are the numbers, doctor. BP is 110 over 69, pulse 75, temperature 36.4, oxygen saturation is 97 percent, respiratory rate 16."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 35.55,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.5,
      "end_seconds": 57.21,
      "duration_seconds": 3.71,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.94,
      "end_seconds": 68.57,
      "duration_seconds": 9.63,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.22,
      "end_seconds": 74.4,
      "duration_seconds": 3.18,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.22,
      "end_seconds": 80.15,
      "duration_seconds": 4.93,
      "text": "Actually, um, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.38,
      "end_seconds": 81.17,
      "duration_seconds": 0.79,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.42,
      "end_seconds": 86.24,
      "duration_seconds": 3.82,
      "text": "I've also had restlessness. About restlessness, severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.11,
      "end_seconds": 89.55,
      "duration_seconds": 2.44,
      "text": "Have you been losing things?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.81,
      "end_seconds": 93.08,
      "duration_seconds": 2.27,
      "text": "Yes, for three days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.73,
      "end_seconds": 99.02,
      "duration_seconds": 5.29,
      "text": "Have you had difficulty concentrating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.71,
      "end_seconds": 105.81,
      "duration_seconds": 6.1,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.19,
      "end_seconds": 113.26,
      "duration_seconds": 3.07,
      "text": "Has there been any thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.41,
      "end_seconds": 117.87,
      "duration_seconds": 3.46,
      "text": "Not at all, no thoughts of self-harm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.81,
      "end_seconds": 122.24,
      "duration_seconds": 3.43,
      "text": "Any head injury, drug use or low mood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.17,
      "end_seconds": 129.58,
      "duration_seconds": 5.41,
      "text": "I haven't had head injury, drug use or low mood, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.11,
      "end_seconds": 134.03,
      "duration_seconds": 2.92,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.93,
      "end_seconds": 138.08,
      "duration_seconds": 2.15,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.39,
      "end_seconds": 140.59,
      "duration_seconds": 1.2,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.39,
      "end_seconds": 145.1,
      "duration_seconds": 3.71,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.98,
      "end_seconds": 148.25,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.58,
      "end_seconds": 153.79,
      "duration_seconds": 4.21,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.55,
      "end_seconds": 157.06,
      "duration_seconds": 2.51,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.07,
      "end_seconds": 161.78,
      "duration_seconds": 2.71,
      "text": "I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.35,
      "end_seconds": 165.24,
      "duration_seconds": 1.89,
      "text": "Right, is that everything?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.75,
      "end_seconds": 168.82,
      "duration_seconds": 2.07,
      "text": "Eczema, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.38,
      "end_seconds": 171.88,
      "duration_seconds": 1.5,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.89,
      "end_seconds": 179.17,
      "duration_seconds": 3.28,
      "text": "I've had asthma for five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 182.57,
      "duration_seconds": 1.34,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.83,
      "end_seconds": 193.67,
      "duration_seconds": 9.84,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.52,
      "end_seconds": 201.79,
      "duration_seconds": 6.27,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 202.98,
      "end_seconds": 208.26,
      "duration_seconds": 5.28,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.28,
      "end_seconds": 215.19,
      "duration_seconds": 4.91,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.79,
      "end_seconds": 222.97,
      "duration_seconds": 5.18,
      "text": "No, I left it at home. Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.01,
      "end_seconds": 227.05,
      "duration_seconds": 2.04,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.5,
      "end_seconds": 234.35,
      "duration_seconds": 5.85,
      "text": "So, just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.54,
      "end_seconds": 240.17,
      "duration_seconds": 3.63,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.68,
      "end_seconds": 243.07,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.01,
      "end_seconds": 260.88,
      "duration_seconds": 4.87,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.9,
      "end_seconds": 264.5,
      "duration_seconds": 1.6,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.73,
      "end_seconds": 281.6,
      "duration_seconds": 3.87,
      "text": "I'm going to order a questionnaire, for attention problems."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.01,
      "end_seconds": 284.45,
      "duration_seconds": 1.44,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.59,
      "end_seconds": 319.23,
      "duration_seconds": 33.64,
      "text": "I'm going to order a thyroid test, for poor concentration. Use lists and reminders while we arrange the specialist assessment. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back after the assessment. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.8,
      "end_seconds": 322.25,
      "duration_seconds": 2.45,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.17,
      "end_seconds": 325.8,
      "duration_seconds": 1.63,
      "text": "Have a good day."
    }
  ]
}