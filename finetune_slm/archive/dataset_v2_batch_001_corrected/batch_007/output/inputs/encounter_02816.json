{
  "schema_version": "1.0",
  "encounter_id": "02816",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 8.56,
      "duration_seconds": 7.95,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.16,
      "end_seconds": 13.62,
      "duration_seconds": 3.46,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.39,
      "end_seconds": 25.94,
      "duration_seconds": 11.55,
      "text": "Thank you for fitting us in, doctor. It's been passing kidney stones, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.53,
      "end_seconds": 31.02,
      "duration_seconds": 3.49,
      "text": "So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.54,
      "end_seconds": 36.57,
      "duration_seconds": 4.03,
      "text": "About three days, um, give or take."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.65,
      "end_seconds": 42.25,
      "duration_seconds": 3.6,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.21,
      "end_seconds": 49.21,
      "duration_seconds": 5.0,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.71,
      "end_seconds": 52.92,
      "duration_seconds": 2.21,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.82,
      "end_seconds": 61.44,
      "duration_seconds": 7.62,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 61.54,
      "end_seconds": 69.54,
      "duration_seconds": 8.0,
      "text": "Sorry, what was I saying, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.04,
      "end_seconds": 74.13,
      "duration_seconds": 3.09,
      "text": "Yeah, I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.74,
      "end_seconds": 80.05,
      "duration_seconds": 2.31,
      "text": "Any being thirsty as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.16,
      "end_seconds": 82.75,
      "duration_seconds": 1.59,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.1,
      "end_seconds": 87.01,
      "duration_seconds": 2.91,
      "text": "Have you noticed low mood or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.56,
      "end_seconds": 98.98,
      "duration_seconds": 10.42,
      "text": "No, no low mood, no fever. I did have constipation at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 104.44,
      "duration_seconds": 3.54,
      "text": "A few quick ones: fractures or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.29,
      "end_seconds": 108.76,
      "duration_seconds": 2.47,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.07,
      "end_seconds": 113.16,
      "duration_seconds": 3.09,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.59,
      "end_seconds": 116.41,
      "duration_seconds": 1.82,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.02,
      "end_seconds": 119.84,
      "duration_seconds": 2.82,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.88,
      "end_seconds": 129.75,
      "duration_seconds": 7.87,
      "text": "High cholesterol, for nearly five years. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.51,
      "end_seconds": 132.21,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 138.08,
      "duration_seconds": 1.7,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.85,
      "end_seconds": 146.92,
      "duration_seconds": 8.07,
      "text": "Okay, I can see high cholesterol in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.81,
      "end_seconds": 149.91,
      "duration_seconds": 1.1,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.74,
      "end_seconds": 153.67,
      "duration_seconds": 1.93,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.29,
      "end_seconds": 159.45,
      "duration_seconds": 5.16,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 162.96,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.62,
      "end_seconds": 168.07,
      "duration_seconds": 4.45,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.42,
      "end_seconds": 174.09,
      "duration_seconds": 1.67,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.03,
      "end_seconds": 180.11,
      "duration_seconds": 4.08,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.73,
      "end_seconds": 183.46,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.02,
      "end_seconds": 188.21,
      "duration_seconds": 3.19,
      "text": "Simvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.17,
      "end_seconds": 193.39,
      "duration_seconds": 4.22,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.02,
      "end_seconds": 198.05,
      "duration_seconds": 3.03,
      "text": "Oh, no, it's at home."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.34,
      "end_seconds": 217.3,
      "duration_seconds": 3.96,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.92,
      "end_seconds": 231.44,
      "duration_seconds": 12.52,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 235.75,
      "end_seconds": 241.98,
      "duration_seconds": 6.23,
      "text": "Okay, so the vitals from earlier. Blood pressure 117 over 69, pulse 67, temperature 36.6."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.45,
      "end_seconds": 244.5,
      "duration_seconds": 1.05,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.11,
      "end_seconds": 249.76,
      "duration_seconds": 3.65,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.39,
      "end_seconds": 255.05,
      "duration_seconds": 1.66,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.6,
      "end_seconds": 259.48,
      "duration_seconds": 2.88,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.77,
      "end_seconds": 283.12,
      "duration_seconds": 5.35,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.37,
      "end_seconds": 303.02,
      "duration_seconds": 17.65,
      "text": "That's all I needed to check. So where does that leave us? It points towards possible raised calcium from an overactive parathyroid. The reason I say that is that your story and my examination fit together. Another possibility is vitamin D excess."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.09,
      "end_seconds": 325.68,
      "duration_seconds": 14.59,
      "text": "Drink plenty of water and avoid calcium supplements until the results. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.56,
      "end_seconds": 330.59,
      "duration_seconds": 4.03,
      "text": "Should I have a kidney ultrasound as well?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.35,
      "end_seconds": 340.54,
      "duration_seconds": 9.19,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 342.05,
      "end_seconds": 345.76,
      "duration_seconds": 3.71,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}