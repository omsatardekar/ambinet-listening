  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 3.08,
      "duration_seconds": 2.47,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.62,
      "end_seconds": 4.66,
      "duration_seconds": 1.04,
      "text": "hello, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.61,
      "end_seconds": 9.26,
      "duration_seconds": 2.65,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 16.42,
      "duration_seconds": 5.26,
      "text": "Yeah, it's being very confused. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.12,
      "end_seconds": 20.88,
      "duration_seconds": 2.76,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.01,
      "end_seconds": 25.06,
      "duration_seconds": 3.05,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.53,
      "end_seconds": 29.26,
      "duration_seconds": 2.73,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.22,
      "end_seconds": 32.93,
      "duration_seconds": 2.71,
      "text": "It feels severe to to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.41,
      "end_seconds": 38.42,
      "duration_seconds": 4.01,
      "text": "Did you get fever, chest pain or fall?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.62,
      "end_seconds": 43.06,
      "duration_seconds": 3.44,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.64,
      "end_seconds": 47.61,
      "duration_seconds": 3.97,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.42,
      "end_seconds": 52.9,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.82,
      "end_seconds": 55.86,
      "duration_seconds": 2.04,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.71,
      "end_seconds": 60.8,
      "duration_seconds": 4.09,
      "text": "actually, uh, no, that's all fine"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.0,
      "end_seconds": 80.96,
      "duration_seconds": 3.96,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.91,
      "end_seconds": 87.05,
      "duration_seconds": 5.14,
      "text": "hmm, um, no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.89,
      "end_seconds": 94.68,
      "duration_seconds": 2.79,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.86,
      "end_seconds": 103.58,
      "duration_seconds": 7.72,
      "text": "An enlarged prostate, for about ten years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.5,
      "end_seconds": 115.4,
      "duration_seconds": 10.9,
      "text": "right, so an enlarged prostate is already on your record. We'll keep that in mind today. Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.47,
      "end_seconds": 121.22,
      "duration_seconds": 3.75,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.76,
      "end_seconds": 126.29,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 135.69,
      "duration_seconds": 3.78,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.86,
      "end_seconds": 150.4,
      "duration_seconds": 2.54,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.34,
      "end_seconds": 155.55,
      "duration_seconds": 4.21,
      "text": "I take tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.78,
      "end_seconds": 156.7,
      "duration_seconds": 0.92,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.79,
      "end_seconds": 178.74,
      "duration_seconds": 3.95,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.03,
      "end_seconds": 194.05,
      "duration_seconds": 3.02,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.42,
      "end_seconds": 225.11,
      "duration_seconds": 9.69,
      "text": "Okay: temperature is 37.0 degrees, blood pressure 101 over 58. And SpO2 96 percent on room air, pulse is 108 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.28,
      "end_seconds": 229.57,
      "duration_seconds": 3.29,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.24,
      "end_seconds": 233.31,
      "duration_seconds": 2.07,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.0,
      "end_seconds": 254.53,
      "duration_seconds": 5.53,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.43,
      "end_seconds": 260.65,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.73,
      "end_seconds": 283.8,
      "duration_seconds": 14.07,
      "text": "Having listened and examined, I think we're dealing with a high calcium emergency at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.44,
      "end_seconds": 289.38,
      "duration_seconds": 3.94,
      "text": "Is it it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.41,
      "end_seconds": 304.15,
      "duration_seconds": 13.74,
      "text": "I understand the worry. At the moment I'd say it's a high calcium emergency, and we'll know more once the the an ECG is back. We should do an ECG for hypercalcaemia."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.57,
      "end_seconds": 307.14,
      "duration_seconds": 1.57,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.72,
      "end_seconds": 318.62,
      "duration_seconds": 10.9,
      "text": "Let's book urgent blood tests to look into confusion and polyuria. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.22,
      "end_seconds": 321.33,
      "duration_seconds": 2.11,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.02,
      "end_seconds": 352.47,
      "duration_seconds": 30.45,
      "text": "what I'm giving you is sodium chloride 0.9%, 1 litre, over one hour, single dose. It's for dehydration. You need hospital fluids and treatment now. I'm going to send a referral to the emergency team. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Come back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.05,
      "end_seconds": 356.63,
      "duration_seconds": 3.58,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}