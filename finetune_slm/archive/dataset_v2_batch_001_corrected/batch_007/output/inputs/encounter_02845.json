    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.08,
      "end_seconds": 23.94,
      "duration_seconds": 4.86,
      "text": "is it there all the time or does it come and go?"
