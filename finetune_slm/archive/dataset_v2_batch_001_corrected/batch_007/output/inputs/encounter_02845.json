    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.04,
      "end_seconds": 239.88,
      "duration_seconds": 3.84,
      "text": "I do a yoga class on Thursdays."
