    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.56,
      "end_seconds": 28.25,
      "duration_seconds": 2.69,
      "text": "I'd say every other day."
