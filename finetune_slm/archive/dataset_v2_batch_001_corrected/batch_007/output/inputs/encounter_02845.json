    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.56,
      "end_seconds": 31.9,
      "duration_seconds": 2.34,
      "text": "Is there anything else with it?"
