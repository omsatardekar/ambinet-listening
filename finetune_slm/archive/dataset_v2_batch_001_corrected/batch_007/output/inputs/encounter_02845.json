      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.57,
      "end_seconds": 160.89,
      "duration_seconds": 3.32,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.52,
      "end_seconds": 168.06,
      "duration_seconds": 6.54,
      "text": "Erm, I'd been on atorvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.15,
      "end_seconds": 182.96,
      "duration_seconds": 2.81,
      "text": "do you have any long-term conditions?"
