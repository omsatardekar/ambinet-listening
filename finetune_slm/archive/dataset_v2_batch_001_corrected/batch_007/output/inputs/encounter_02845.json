    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.82,
      "end_seconds": 215.11,
      "duration_seconds": 5.29,
      "text": "I drink a lot of tea and snack through the day."
