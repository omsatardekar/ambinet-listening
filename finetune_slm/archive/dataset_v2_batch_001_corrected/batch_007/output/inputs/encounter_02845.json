    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.84,
      "end_seconds": 230.34,
      "duration_seconds": 4.5,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.71,
      "end_seconds": 234.94,
      "duration_seconds": 3.23,
      "text": "So, anything you do to stay fit?"
