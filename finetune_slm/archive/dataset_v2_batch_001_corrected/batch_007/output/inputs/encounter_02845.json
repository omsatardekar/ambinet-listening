    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 53.29,
      "duration_seconds": 3.0,
      "text": "Yes, about the same, two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.37,
      "end_seconds": 57.39,
      "duration_seconds": 3.02,
      "text": "I'll just record a few vital signs."
