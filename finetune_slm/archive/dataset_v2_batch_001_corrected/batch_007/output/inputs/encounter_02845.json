    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.17,
      "end_seconds": 99.25,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
