    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.38,
      "end_seconds": 110.5,
      "duration_seconds": 3.12,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.57,
      "end_seconds": 120.09,
      "duration_seconds": 5.52,
      "text": "So, that's all I needed to check. Any fainting, breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.44,
      "end_seconds": 127.2,
      "duration_seconds": 5.76,
      "text": "no fainting, breathlessness or chest pain, none of it it"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.76,
      "end_seconds": 132.17,
      "duration_seconds": 4.41,
      "text": "I see, go ahead. How about family history of sudden death?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.75,
      "end_seconds": 138.31,
      "duration_seconds": 4.56,
      "text": "I haven't noticed any family history of sudden death"
