      "start_seconds": 0.51,
      "end_seconds": 3.86,
      "duration_seconds": 3.35,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.64,
      "end_seconds": 12.21,
      "duration_seconds": 4.57,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.63,
      "end_seconds": 18.32,
      "duration_seconds": 4.69,
      "text": "I wanted to get my heart suddenly racing looked at"
