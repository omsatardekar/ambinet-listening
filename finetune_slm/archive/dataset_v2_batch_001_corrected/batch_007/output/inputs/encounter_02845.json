      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.55,
      "end_seconds": 150.25,
      "duration_seconds": 2.7,
      "text": "Nothing unusual, you know, no."
