      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.45,
      "end_seconds": 224.31,
      "duration_seconds": 3.86,
      "text": "So, do you work outside the the home?"
