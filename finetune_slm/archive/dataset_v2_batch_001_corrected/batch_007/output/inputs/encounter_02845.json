    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.85,
      "end_seconds": 244.36,
      "duration_seconds": 2.51,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.24,
      "end_seconds": 253.19,
      "duration_seconds": 6.95,
      "text": "Sorry, what was I saying, yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.9,
      "end_seconds": 262.46,
      "duration_seconds": 8.56,
      "text": "Right, here's what I'm thinking. This looks most like episodes of supraventricular tachycardia. I can't rule out atrial fibrillation yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.11,
      "end_seconds": 289.59,
      "duration_seconds": 13.48,
      "text": "I'm sending you for a 7-day heart monitor because of paroxysmal palpitations. Try blowing hard against a closed mouth and nose when it starts. Do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.45,
      "end_seconds": 293.2,
      "duration_seconds": 1.75,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.98,
      "end_seconds": 298.12,
      "duration_seconds": 4.14,
      "text": "I'd like to see you again after the monitor"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.39,
      "end_seconds": 302.54,
      "duration_seconds": 3.15,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.12,
      "end_seconds": 308.46,
      "duration_seconds": 5.34,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
