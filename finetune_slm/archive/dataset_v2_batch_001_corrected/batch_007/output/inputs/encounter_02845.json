      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.29,
      "end_seconds": 43.11,
      "duration_seconds": 9.82,
      "text": "It usually comes with it stopping just as suddenly. The it stopping just as suddenly? That's been for about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.74,
      "end_seconds": 48.48,
      "duration_seconds": 3.74,
      "text": "have you been feeling lightheaded during an episode?"
