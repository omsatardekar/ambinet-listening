      "role": "DOCTOR",
      "start_seconds": 63.64,
      "end_seconds": 66.55,
      "duration_seconds": 2.91,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.78,
      "end_seconds": 84.4,
      "duration_seconds": 4.62,
      "text": "Okay: temperature 36.4, pressure 123 over 74, pulse 82."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.28,
      "end_seconds": 86.87,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
