    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.57,
      "end_seconds": 186.41,
      "duration_seconds": 1.84,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.3,
      "end_seconds": 189.0,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.37,
      "end_seconds": 208.57,
      "duration_seconds": 2.2,
      "text": "Tell me about your eating."
