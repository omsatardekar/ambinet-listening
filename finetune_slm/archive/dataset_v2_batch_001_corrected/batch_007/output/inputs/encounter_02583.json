{
  "schema_version": "1.0",
  "encounter_id": "02583",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 6.58,
      "duration_seconds": 5.26,
      "text": "right then, come on in tell me what's brought you in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.11,
      "end_seconds": 15.81,
      "duration_seconds": 8.7,
      "text": "So the thing is, I've got hot flushes. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.1,
      "end_seconds": 20.46,
      "duration_seconds": 3.36,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.78,
      "end_seconds": 24.5,
      "duration_seconds": 2.72,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.93,
      "end_seconds": 30.6,
      "duration_seconds": 4.67,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.28,
      "end_seconds": 36.96,
      "duration_seconds": 4.68,
      "text": "honestly, once or twice a day i'd say mild"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.81,
      "end_seconds": 40.7,
      "duration_seconds": 2.89,
      "text": "Has there been poor sleep too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.55,
      "end_seconds": 47.79,
      "duration_seconds": 5.24,
      "text": "Yeah, that too. I've also had mood swings, for two days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.4,
      "end_seconds": 53.31,
      "duration_seconds": 4.91,
      "text": "Have you had hot flushes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.59,
      "end_seconds": 63.53,
      "duration_seconds": 8.94,
      "text": "Yes, uh, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.62,
      "end_seconds": 84.81,
      "duration_seconds": 6.19,
      "text": "have you noticed weight loss, pelvic pain, bleeding after sex or very heavy bleeding?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.92,
      "end_seconds": 87.84,
      "duration_seconds": 1.92,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.37,
      "end_seconds": 93.14,
      "duration_seconds": 4.77,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.57,
      "end_seconds": 96.07,
      "duration_seconds": 1.5,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.58,
      "end_seconds": 100.29,
      "duration_seconds": 3.71,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.62,
      "end_seconds": 105.23,
      "duration_seconds": 3.61,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.53,
      "end_seconds": 107.88,
      "duration_seconds": 1.35,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.46,
      "end_seconds": 111.15,
      "duration_seconds": 1.69,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.31,
      "end_seconds": 113.64,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.82,
      "end_seconds": 117.74,
      "duration_seconds": 2.92,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.85,
      "end_seconds": 121.93,
      "duration_seconds": 3.08,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.82,
      "end_seconds": 126.06,
      "duration_seconds": 3.24,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.95,
      "end_seconds": 129.89,
      "duration_seconds": 2.94,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.66,
      "end_seconds": 133.99,
      "duration_seconds": 3.33,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.71,
      "end_seconds": 138.1,
      "duration_seconds": 2.39,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.55,
      "end_seconds": 144.79,
      "duration_seconds": 1.24,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.82,
      "end_seconds": 147.91,
      "duration_seconds": 2.09,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.73,
      "end_seconds": 159.48,
      "duration_seconds": 9.75,
      "text": "Arthritis in my knees, for two years. It's a relief to finally sit down and talk about it. Yes, eczema."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.68,
      "end_seconds": 161.38,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.16,
      "end_seconds": 166.55,
      "duration_seconds": 4.39,
      "text": "I have an underactive thyroid, for nearly five years"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.21,
      "end_seconds": 177.31,
      "duration_seconds": 9.1,
      "text": "Understood. Right, so arthritis in your knees and an underactive thyroid are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.29,
      "end_seconds": 196.17,
      "duration_seconds": 3.88,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.67,
      "end_seconds": 207.14,
      "duration_seconds": 5.47,
      "text": "My father has Parkinson's disease. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.67,
      "end_seconds": 212.09,
      "duration_seconds": 3.42,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.07,
      "end_seconds": 217.03,
      "duration_seconds": 2.96,
      "text": "it's paracetamol, 650 milligrams, when needed"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 219.03,
      "end_seconds": 223.95,
      "duration_seconds": 4.92,
      "text": "Doctor, our chart from the last visit lists it as 1300 milligrams."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.33,
      "end_seconds": 229.2,
      "duration_seconds": 3.87,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.55,
      "end_seconds": 237.83,
      "duration_seconds": 7.28,
      "text": "Not with me. I'll bring it next time. It's hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.46,
      "end_seconds": 240.96,
      "duration_seconds": 2.5,
      "text": "So, when did you start it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.85,
      "end_seconds": 244.79,
      "duration_seconds": 1.94,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 245.54,
      "end_seconds": 255.44,
      "duration_seconds": 9.9,
      "text": "Doctor, I've got the readings for you. Temp 36.6 degrees, pulse is 80 beats a minute. Pressure 108 over 75, respiratory rate 17."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.34,
      "end_seconds": 258.26,
      "duration_seconds": 1.92,
      "text": "right, good, thank you"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.51,
      "end_seconds": 262.8,
      "duration_seconds": 3.29,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.46,
      "end_seconds": 265.16,
      "duration_seconds": 1.7,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.84,
      "end_seconds": 268.62,
      "duration_seconds": 1.78,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.69,
      "end_seconds": 284.88,
      "duration_seconds": 4.19,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.21,
      "end_seconds": 297.57,
      "duration_seconds": 8.36,
      "text": "that's the examination finished. Taking everything into account, my working impression is perimenopause. A thyroid problem is also on my list"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.11,
      "end_seconds": 300.88,
      "duration_seconds": 2.77,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.36,
      "end_seconds": 310.03,
      "duration_seconds": 7.67,
      "text": "Nothing I've seen today points to to an emergency. It looks like perimenopause, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.53,
      "end_seconds": 348.68,
      "duration_seconds": 20.15,
      "text": "Let's get a thyroid test, for hot flushes. A blood count is what I'd like next, for irregular periods. I'm gonna put you on estradiol gel, 1 pump, once a day, long term. That's for menopausal symptoms. Regular exercise, light layers and avoiding triggers can help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.18,
      "end_seconds": 359.22,
      "duration_seconds": 10.04,
      "text": "Hm, okay. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.96,
      "end_seconds": 364.52,
      "duration_seconds": 1.56,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.33,
      "end_seconds": 370.61,
      "duration_seconds": 5.28,
      "text": "See me again in three months. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.19,
      "end_seconds": 374.93,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks."
    }
  ]
}