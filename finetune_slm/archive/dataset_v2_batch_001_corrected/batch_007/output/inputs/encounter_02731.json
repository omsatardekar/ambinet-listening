{
  "schema_version": "1.0",
  "encounter_id": "02731",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.42,
      "duration_seconds": 3.64,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.08,
      "end_seconds": 10.65,
      "duration_seconds": 4.57,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.75,
      "end_seconds": 16.08,
      "duration_seconds": 4.33,
      "text": "It's bright red blood on the paper, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.79,
      "end_seconds": 21.14,
      "duration_seconds": 3.35,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.85,
      "end_seconds": 31.8,
      "duration_seconds": 9.95,
      "text": "Well, I'd say ten days. Actually, no, closer to five days. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.49,
      "end_seconds": 36.11,
      "duration_seconds": 3.62,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.66,
      "end_seconds": 41.78,
      "duration_seconds": 4.12,
      "text": "Atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.69,
      "end_seconds": 47.08,
      "duration_seconds": 4.39,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.25,
      "end_seconds": 51.86,
      "duration_seconds": 3.61,
      "text": "Um, yes, I'm allergic to wheat."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.15,
      "end_seconds": 55.57,
      "duration_seconds": 2.42,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.96,
      "end_seconds": 60.87,
      "duration_seconds": 3.91,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.14,
      "end_seconds": 63.54,
      "duration_seconds": 1.4,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.43,
      "end_seconds": 67.6,
      "duration_seconds": 3.17,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.9,
      "end_seconds": 72.88,
      "duration_seconds": 3.98,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.1,
      "end_seconds": 84.69,
      "duration_seconds": 10.59,
      "text": "Yeah, I've got high cholesterol. I thought it would sort itself out, but it hasn't. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.49,
      "end_seconds": 89.32,
      "duration_seconds": 3.83,
      "text": "Alright, high cholesterol, that matches what I have here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.73,
      "end_seconds": 108.99,
      "duration_seconds": 5.26,
      "text": "Have you had any tummy pain, black stools or change in bowel habit?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.06,
      "end_seconds": 117.34,
      "duration_seconds": 6.28,
      "text": "No tummy pain, black stools or change in bowel habit, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.01,
      "end_seconds": 120.51,
      "duration_seconds": 2.5,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.07,
      "end_seconds": 122.49,
      "duration_seconds": 1.42,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.23,
      "end_seconds": 143.69,
      "duration_seconds": 2.46,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.0,
      "end_seconds": 153.46,
      "duration_seconds": 2.46,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.93,
      "end_seconds": 178.31,
      "duration_seconds": 6.38,
      "text": "Okay: oxygen saturation is 98 percent, respiratory rate 14, pressure 112 over 69, pulse 71."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.87,
      "end_seconds": 182.06,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.88,
      "end_seconds": 186.77,
      "duration_seconds": 2.89,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.55,
      "end_seconds": 192.66,
      "duration_seconds": 4.11,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.58,
      "end_seconds": 196.66,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.05,
      "end_seconds": 223.85,
      "duration_seconds": 8.8,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.81,
      "end_seconds": 229.17,
      "duration_seconds": 2.36,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.84,
      "end_seconds": 244.61,
      "duration_seconds": 7.77,
      "text": "So, based on the history and the examination, I think we're dealing with haemorrhoids at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.94,
      "end_seconds": 247.97,
      "duration_seconds": 2.03,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.89,
      "end_seconds": 261.0,
      "duration_seconds": 7.11,
      "text": "Nothing I've seen today points to an emergency. It looks like haemorrhoids, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.1,
      "end_seconds": 282.88,
      "duration_seconds": 4.78,
      "text": "I'm sending you for a blood count because of rectal bleeding."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.28,
      "end_seconds": 287.3,
      "duration_seconds": 3.02,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.01,
      "end_seconds": 292.38,
      "duration_seconds": 3.37,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.22,
      "end_seconds": 295.36,
      "duration_seconds": 2.14,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.98,
      "end_seconds": 303.53,
      "duration_seconds": 2.55,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.33,
      "end_seconds": 308.58,
      "duration_seconds": 3.25,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.23,
      "end_seconds": 310.57,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}