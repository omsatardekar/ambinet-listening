{
  "schema_version": "1.0",
  "encounter_id": "02771",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 4.87,
      "duration_seconds": 3.84,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 9.89,
      "duration_seconds": 4.41,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.95,
      "end_seconds": 18.04,
      "duration_seconds": 6.09,
      "text": "Sorry, what was I saying, I'm here because of dizziness on standing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.11,
      "end_seconds": 28.01,
      "duration_seconds": 7.9,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.65,
      "end_seconds": 41.79,
      "duration_seconds": 9.14,
      "text": "I notice it more with standing. Severe, really. I've also had a widespread sunburn-like rash, for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.17,
      "end_seconds": 51.69,
      "duration_seconds": 4.52,
      "text": "Right, what about a sudden high fever, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.05,
      "end_seconds": 55.78,
      "duration_seconds": 2.73,
      "text": "Yeah, um, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.77,
      "end_seconds": 57.96,
      "duration_seconds": 1.19,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.81,
      "end_seconds": 62.96,
      "duration_seconds": 4.15,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.92,
      "end_seconds": 66.37,
      "duration_seconds": 2.45,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.45,
      "end_seconds": 72.17,
      "duration_seconds": 3.72,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 79.53,
      "duration_seconds": 2.85,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.07,
      "end_seconds": 83.79,
      "duration_seconds": 2.72,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.59,
      "end_seconds": 102.14,
      "duration_seconds": 3.55,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.0,
      "end_seconds": 111.87,
      "duration_seconds": 8.87,
      "text": "I had a reaction to trimethoprim when I was younger, itching, and I've avoided it since."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.89,
      "end_seconds": 116.52,
      "duration_seconds": 3.63,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.57,
      "end_seconds": 121.85,
      "duration_seconds": 3.28,
      "text": "I've got acid reflux. I've got asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.86,
      "end_seconds": 131.12,
      "duration_seconds": 5.26,
      "text": "Yes, acid reflux is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.03,
      "end_seconds": 143.28,
      "duration_seconds": 2.25,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.2,
      "end_seconds": 150.55,
      "duration_seconds": 5.35,
      "text": "I'm on Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.97,
      "end_seconds": 160.12,
      "duration_seconds": 3.15,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.67,
      "end_seconds": 165.11,
      "duration_seconds": 4.44,
      "text": "About nearly five years. It's a tampon, in use."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.22,
      "end_seconds": 168.28,
      "duration_seconds": 2.06,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.46,
      "end_seconds": 171.51,
      "duration_seconds": 2.05,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.52,
      "end_seconds": 175.67,
      "duration_seconds": 2.15,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.18,
      "end_seconds": 180.67,
      "duration_seconds": 4.49,
      "text": "Just my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.61,
      "end_seconds": 192.88,
      "duration_seconds": 3.27,
      "text": "Any sore throat, stiff neck or cough?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.05,
      "end_seconds": 198.43,
      "duration_seconds": 4.38,
      "text": "No, no sore throat, stiff neck or cough."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.97,
      "end_seconds": 204.89,
      "duration_seconds": 4.92,
      "text": "Alright, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.08,
      "end_seconds": 211.11,
      "duration_seconds": 5.03,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 215.49,
      "duration_seconds": 2.92,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.2,
      "end_seconds": 219.02,
      "duration_seconds": 1.82,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.4,
      "end_seconds": 223.48,
      "duration_seconds": 3.08,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.21,
      "end_seconds": 239.17,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.47,
      "end_seconds": 265.49,
      "duration_seconds": 8.02,
      "text": "Okay: saturation 96 percent, heart rate 94, temperature 36.5, BP is 100 over 56, respiratory rate 20."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.6,
      "end_seconds": 270.19,
      "duration_seconds": 3.59,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.94,
      "end_seconds": 272.96,
      "duration_seconds": 1.02,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.77,
      "end_seconds": 275.09,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.38,
      "end_seconds": 297.0,
      "duration_seconds": 8.62,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.71,
      "end_seconds": 311.81,
      "duration_seconds": 11.1,
      "text": "You can relax now. Let me tell you where I've got to. This is probably possible toxic shock syndrome. A viral illness is also on my list."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.8,
      "end_seconds": 315.89,
      "duration_seconds": 2.09,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.92,
      "end_seconds": 342.02,
      "duration_seconds": 24.1,
      "text": "It's reasonable to be concerned, but right now possible toxic shock syndrome is my leading thought, not anything worse. Let's get a vaginal swab, for possible toxic shock. I'm going to order blood cultures, for possible toxic shock. I'm prescribing flucloxacillin, 2 grams, now, single dose. That's for possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.89,
      "end_seconds": 345.49,
      "duration_seconds": 1.6,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.11,
      "end_seconds": 355.59,
      "duration_seconds": 8.48,
      "text": "Remove any tampon, you are going to hospital now. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.56,
      "end_seconds": 358.2,
      "duration_seconds": 1.64,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.58,
      "end_seconds": 370.79,
      "duration_seconds": 11.21,
      "text": "Book a review straight away. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.15,
      "end_seconds": 381.11,
      "duration_seconds": 8.96,
      "text": "So, um, I take the flucloxacillin, 2 grams, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.31,
      "end_seconds": 385.95,
      "duration_seconds": 3.64,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.93,
      "end_seconds": 391.18,
      "duration_seconds": 3.25,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.3,
      "end_seconds": 393.66,
      "duration_seconds": 1.36,
      "text": "See you soon."
    }
  ]
}