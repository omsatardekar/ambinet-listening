{
  "schema_version": "1.0",
  "encounter_id": "02834",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 7.71,
      "duration_seconds": 6.9,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.24,
      "end_seconds": 13.5,
      "duration_seconds": 4.26,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.35,
      "end_seconds": 21.35,
      "duration_seconds": 7.0,
      "text": "doctor, I've come along because I know the history, if it helps"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.01,
      "end_seconds": 24.53,
      "duration_seconds": 2.52,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.23,
      "end_seconds": 31.63,
      "duration_seconds": 5.4,
      "text": "Doctor, it's itchy blisters. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.2,
      "end_seconds": 34.62,
      "duration_seconds": 2.42,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.46,
      "end_seconds": 45.94,
      "duration_seconds": 10.48,
      "text": "I'd say once or twice a day. I've, I've also had raw areas where blisters burst, for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.9,
      "end_seconds": 51.85,
      "duration_seconds": 3.95,
      "text": "Has there been an itchy rash first too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.04,
      "end_seconds": 54.32,
      "duration_seconds": 1.28,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.32,
      "end_seconds": 61.48,
      "duration_seconds": 6.16,
      "text": "So, have you had itchy blisters before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.03,
      "end_seconds": 67.89,
      "duration_seconds": 4.86,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.75,
      "end_seconds": 82.69,
      "duration_seconds": 3.94,
      "text": "have you noticed fever, mouth sores or eye problems?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.57,
      "end_seconds": 89.28,
      "duration_seconds": 4.71,
      "text": "I mean, no, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.76,
      "end_seconds": 93.02,
      "duration_seconds": 3.26,
      "text": "Yes, carry on. Nothing like new medicine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.35,
      "end_seconds": 96.73,
      "duration_seconds": 2.38,
      "text": "no no new medicine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.53,
      "end_seconds": 101.06,
      "duration_seconds": 2.53,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.15,
      "end_seconds": 105.69,
      "duration_seconds": 3.54,
      "text": "um, no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.37,
      "end_seconds": 110.67,
      "duration_seconds": 4.3,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.36,
      "end_seconds": 113.95,
      "duration_seconds": 1.59,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.19,
      "end_seconds": 120.65,
      "duration_seconds": 5.46,
      "text": "okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.47,
      "end_seconds": 135.88,
      "duration_seconds": 14.41,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.31,
      "end_seconds": 139.86,
      "duration_seconds": 2.55,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.46,
      "end_seconds": 154.32,
      "duration_seconds": 12.86,
      "text": "Let me think, I have high blood pressure, for nearly five years. I have migraines. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.27,
      "end_seconds": 162.43,
      "duration_seconds": 2.16,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.78,
      "end_seconds": 167.9,
      "duration_seconds": 4.12,
      "text": "Sumatriptan. I take it 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.57,
      "end_seconds": 179.23,
      "duration_seconds": 10.66,
      "text": "Um, doctor, I think the last prescription for the sumatriptan was 100 milligrams. We changed it at the the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.35,
      "end_seconds": 184.44,
      "duration_seconds": 4.09,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.83,
      "end_seconds": 190.05,
      "duration_seconds": 4.22,
      "text": "No, you know, I left it at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.88,
      "end_seconds": 196.12,
      "duration_seconds": 5.24,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.59,
      "end_seconds": 208.92,
      "duration_seconds": 11.33,
      "text": "My husband and I live above the shop. I work in accounts at a hospital. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.26,
      "end_seconds": 223.86,
      "duration_seconds": 3.6,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.13,
      "end_seconds": 239.68,
      "duration_seconds": 2.55,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 255.81,
      "duration_seconds": 6.06,
      "text": "Okay: respiratory rate 14, pulse 84. And temperature 36.6, pressure 111 over 71."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.86,
      "end_seconds": 259.29,
      "duration_seconds": 2.43,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.79,
      "end_seconds": 262.86,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.88,
      "end_seconds": 283.47,
      "duration_seconds": 6.59,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.05,
      "end_seconds": 298.09,
      "duration_seconds": 12.04,
      "text": "that's all I needed to check okay, thinking it through, this looks most like bullous pemphigoid i'd also keep a drug reaction in mind"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.74,
      "end_seconds": 301.7,
      "duration_seconds": 1.96,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.41,
      "end_seconds": 318.58,
      "duration_seconds": 15.17,
      "text": "I understand the worry. At the moment I'd say it's bullous pemphigoid, and we'll watch how it goes. Stop me if I've got anything wrong. You've had itchy blisters, and no mouth sores or new medicine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.52,
      "end_seconds": 321.34,
      "duration_seconds": 1.82,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.8,
      "end_seconds": 345.47,
      "duration_seconds": 8.67,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.43,
      "end_seconds": 348.59,
      "duration_seconds": 2.16,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.51,
      "end_seconds": 357.68,
      "duration_seconds": 7.17,
      "text": "For now, no new medicines or tests are needed. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.95,
      "end_seconds": 362.18,
      "duration_seconds": 3.23,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.89,
      "end_seconds": 369.83,
      "duration_seconds": 1.94,
      "text": "Have a good day."
    }
  ]
}