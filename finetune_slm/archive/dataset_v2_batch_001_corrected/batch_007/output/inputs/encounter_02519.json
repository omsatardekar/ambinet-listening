{
  "schema_version": "1.0",
  "encounter_id": "02519",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 5.16,
      "duration_seconds": 3.99,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 11.18,
      "duration_seconds": 4.94,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 20.47,
      "duration_seconds": 8.34,
      "text": "Yeah, it's severe pain in my left side going to the groin. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.16,
      "end_seconds": 28.42,
      "duration_seconds": 2.26,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 35.74,
      "duration_seconds": 5.57,
      "text": "Hydrochlorothiazide. I take it 12.5 milligrams, every morning for my pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.45,
      "end_seconds": 58.08,
      "duration_seconds": 6.63,
      "text": "How long has it been like this? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.72,
      "end_seconds": 62.5,
      "duration_seconds": 2.78,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.91,
      "end_seconds": 66.22,
      "duration_seconds": 2.31,
      "text": "Right, does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.74,
      "end_seconds": 69.61,
      "duration_seconds": 2.87,
      "text": "I get some relief from heat."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.66,
      "end_seconds": 92.14,
      "duration_seconds": 4.48,
      "text": "Any fever, vomiting or passing no urine at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.17,
      "end_seconds": 99.06,
      "duration_seconds": 4.89,
      "text": "I haven't had fever, vomiting or passing no urine, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.83,
      "end_seconds": 102.34,
      "duration_seconds": 2.51,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.19,
      "end_seconds": 104.23,
      "duration_seconds": 1.04,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.25,
      "end_seconds": 109.79,
      "duration_seconds": 3.54,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.52,
      "end_seconds": 113.77,
      "duration_seconds": 3.25,
      "text": "Yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.22,
      "end_seconds": 129.32,
      "duration_seconds": 3.1,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.29,
      "end_seconds": 139.14,
      "duration_seconds": 8.85,
      "text": "I've had high blood pressure for five years now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.53,
      "end_seconds": 157.93,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.69,
      "end_seconds": 160.31,
      "duration_seconds": 1.62,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.03,
      "end_seconds": 162.2,
      "duration_seconds": 1.17,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.49,
      "end_seconds": 166.79,
      "duration_seconds": 3.3,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.65,
      "end_seconds": 171.64,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.17,
      "end_seconds": 175.44,
      "duration_seconds": 3.27,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.35,
      "end_seconds": 178.63,
      "duration_seconds": 2.28,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.93,
      "end_seconds": 184.94,
      "duration_seconds": 5.01,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 189.5,
      "duration_seconds": 2.47,
      "text": "Alright, do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.53,
      "end_seconds": 194.43,
      "duration_seconds": 3.9,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.83,
      "end_seconds": 199.37,
      "duration_seconds": 3.54,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.76,
      "end_seconds": 214.68,
      "duration_seconds": 2.92,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.59,
      "end_seconds": 243.9,
      "duration_seconds": 7.31,
      "text": "Okay: pulse 71, respiratory rate 16, temp 36.5 degrees. And BP is 110 over 69."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.7,
      "end_seconds": 250.31,
      "duration_seconds": 3.61,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.08,
      "end_seconds": 253.02,
      "duration_seconds": 0.94,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 256.12,
      "duration_seconds": 1.31,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.19,
      "end_seconds": 277.09,
      "duration_seconds": 6.9,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.87,
      "end_seconds": 306.66,
      "duration_seconds": 25.79,
      "text": "You can sit up now. Having listened and examined, this looks most like kidney stone colic. I'd like to arrange kidney function tests for renal colic. I'm going to put you on diclofenac, 75 milligrams, once now, single dose. That should help with renal colic. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.13,
      "end_seconds": 309.61,
      "duration_seconds": 1.48,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.19,
      "end_seconds": 320.63,
      "duration_seconds": 9.44,
      "text": "Drink plenty of water and strain the urine to catch the stone. The urology clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.18,
      "end_seconds": 323.7,
      "duration_seconds": 1.52,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.5,
      "end_seconds": 346.27,
      "duration_seconds": 20.77,
      "text": "A urine dipstick is something we might do if this doesn't improve in a month. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. We'll catch up in one week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.97,
      "end_seconds": 350.45,
      "duration_seconds": 3.48,
      "text": "Great, thank you for your help."
    }
  ]
}