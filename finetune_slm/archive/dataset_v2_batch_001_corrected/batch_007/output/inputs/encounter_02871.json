{
  "schema_version": "1.0",
  "encounter_id": "02871",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.45,
      "duration_seconds": 3.25,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.95,
      "end_seconds": 11.38,
      "duration_seconds": 5.43,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.52,
      "end_seconds": 18.03,
      "duration_seconds": 5.51,
      "text": "I've been passing kidney stones, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.57,
      "end_seconds": 23.72,
      "duration_seconds": 4.15,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.1,
      "end_seconds": 29.08,
      "duration_seconds": 3.98,
      "text": "I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.74,
      "end_seconds": 32.99,
      "duration_seconds": 3.25,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.6,
      "end_seconds": 36.54,
      "duration_seconds": 1.94,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.13,
      "end_seconds": 41.56,
      "duration_seconds": 4.43,
      "text": "Okay, go on. Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.42,
      "end_seconds": 45.26,
      "duration_seconds": 2.84,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.85,
      "end_seconds": 61.63,
      "duration_seconds": 2.78,
      "text": "Right, has there been any fractures?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.21,
      "end_seconds": 67.6,
      "duration_seconds": 4.39,
      "text": "No, you know, I haven't had any fractures."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.78,
      "end_seconds": 72.18,
      "duration_seconds": 3.4,
      "text": "Did you get low mood or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.82,
      "end_seconds": 76.95,
      "duration_seconds": 3.13,
      "text": "Erm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 82.13,
      "duration_seconds": 4.13,
      "text": "So, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.53,
      "end_seconds": 85.0,
      "duration_seconds": 1.47,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.6,
      "end_seconds": 87.18,
      "duration_seconds": 1.58,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.34,
      "end_seconds": 92.03,
      "duration_seconds": 3.69,
      "text": "Uh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 96.93,
      "duration_seconds": 3.19,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.57,
      "end_seconds": 102.57,
      "duration_seconds": 4.0,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.58,
      "end_seconds": 106.81,
      "duration_seconds": 2.23,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.07,
      "end_seconds": 113.52,
      "duration_seconds": 5.45,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.45,
      "end_seconds": 118.02,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 122.68,
      "duration_seconds": 2.69,
      "text": "I, I have heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.22,
      "end_seconds": 143.15,
      "duration_seconds": 6.93,
      "text": "Before we go further, any allergies? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.4,
      "end_seconds": 148.68,
      "duration_seconds": 4.28,
      "text": "I'm allergic to cat fur, I get wheezing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.28,
      "end_seconds": 169.04,
      "duration_seconds": 2.76,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.75,
      "end_seconds": 178.06,
      "duration_seconds": 2.31,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.2,
      "end_seconds": 201.05,
      "duration_seconds": 10.85,
      "text": "Okay: temp 36.7 degrees, height 154 centimetres, weight 65 kilos, heart rate 72, respiratory rate 17, pressure 108 over 80, saturation 98 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 206.06,
      "duration_seconds": 3.68,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.55,
      "end_seconds": 222.47,
      "duration_seconds": 0.92,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.42,
      "end_seconds": 225.8,
      "duration_seconds": 1.38,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.7,
      "end_seconds": 250.42,
      "duration_seconds": 5.72,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.24,
      "end_seconds": 252.18,
      "duration_seconds": 0.94,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.55,
      "end_seconds": 285.28,
      "duration_seconds": 30.73,
      "text": "Good, you can sit up again. Okay, thinking it through, I'd lean towards possible raised calcium from an overactive parathyroid. The reason I say that is that your story and my examination fit together. I'm sending you for a bone density scan because of possible hyperparathyroidism. I'd rather check than guess, and this is the quickest way to know more. Drink plenty of water and avoid calcium supplements until the results. We'll catch up after the results."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.25,
      "end_seconds": 291.64,
      "duration_seconds": 5.39,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.29,
      "end_seconds": 296.26,
      "duration_seconds": 3.97,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.07,
      "end_seconds": 302.35,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}