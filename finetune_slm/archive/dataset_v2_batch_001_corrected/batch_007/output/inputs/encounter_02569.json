{
  "schema_version": "1.0",
  "encounter_id": "02569",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.69,
      "duration_seconds": 4.05,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.01,
      "end_seconds": 13.56,
      "duration_seconds": 3.55,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.27,
      "end_seconds": 18.35,
      "duration_seconds": 3.08,
      "text": "I'm here because of itchy blisters."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 22.48,
      "duration_seconds": 2.7,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.38,
      "end_seconds": 32.47,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.87,
      "end_seconds": 58.64,
      "duration_seconds": 9.77,
      "text": "Okay: BP is 126 over 70, temperature is 36.7 degrees. And pulse 65, SpO2 97 percent on room air, respiratory rate 17."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.11,
      "end_seconds": 61.59,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.69,
      "end_seconds": 67.15,
      "duration_seconds": 3.46,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.13,
      "end_seconds": 88.55,
      "duration_seconds": 4.42,
      "text": "Did it come on recently? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.17,
      "end_seconds": 100.11,
      "duration_seconds": 9.94,
      "text": "It's been six months, I'm fairly sure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.38,
      "end_seconds": 103.27,
      "duration_seconds": 2.89,
      "text": "Mm, okay. How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.05,
      "end_seconds": 106.02,
      "duration_seconds": 1.97,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.94,
      "end_seconds": 124.0,
      "duration_seconds": 4.06,
      "text": "Did you get fever, eye problems or mouth sores?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.75,
      "end_seconds": 127.93,
      "duration_seconds": 3.18,
      "text": "Yeah, no, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 132.62,
      "duration_seconds": 2.82,
      "text": "Has there been any new medicine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.14,
      "end_seconds": 137.52,
      "duration_seconds": 4.38,
      "text": "Let me think, not at all, no new medicine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.27,
      "end_seconds": 142.58,
      "duration_seconds": 3.31,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.39,
      "end_seconds": 147.07,
      "duration_seconds": 2.68,
      "text": "Well, I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.08,
      "end_seconds": 152.62,
      "duration_seconds": 3.54,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.42,
      "end_seconds": 156.16,
      "duration_seconds": 2.74,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.18,
      "end_seconds": 159.38,
      "duration_seconds": 2.2,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.79,
      "end_seconds": 169.54,
      "duration_seconds": 4.75,
      "text": "Amlodipine. I take it 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.54,
      "end_seconds": 173.73,
      "duration_seconds": 3.19,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.59,
      "end_seconds": 177.12,
      "duration_seconds": 2.53,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.76,
      "end_seconds": 178.56,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.84,
      "end_seconds": 189.25,
      "duration_seconds": 1.41,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.05,
      "end_seconds": 192.97,
      "duration_seconds": 1.92,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.67,
      "end_seconds": 210.73,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.27,
      "end_seconds": 217.42,
      "duration_seconds": 5.15,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.15,
      "end_seconds": 220.41,
      "duration_seconds": 2.26,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.61,
      "end_seconds": 225.6,
      "duration_seconds": 3.99,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.31,
      "end_seconds": 228.86,
      "duration_seconds": 2.55,
      "text": "So, do you do any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.37,
      "end_seconds": 231.76,
      "duration_seconds": 2.39,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.05,
      "end_seconds": 237.49,
      "duration_seconds": 3.44,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.2,
      "end_seconds": 242.31,
      "duration_seconds": 3.11,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.59,
      "end_seconds": 260.3,
      "duration_seconds": 5.71,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.65,
      "end_seconds": 269.47,
      "duration_seconds": 6.82,
      "text": "You can sit up now. Okay, so my impression is this: This is probably bullous pemphigoid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.38,
      "end_seconds": 277.67,
      "duration_seconds": 3.29,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.74,
      "end_seconds": 301.05,
      "duration_seconds": 18.31,
      "text": "Nothing I've seen today points to an emergency. It looks like bullous pemphigoid. Do not burst the blisters and keep the raw areas dressed. Let's review you in two weeks. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.78,
      "end_seconds": 307.06,
      "duration_seconds": 5.28,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.25,
      "end_seconds": 313.66,
      "duration_seconds": 5.41,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.76,
      "end_seconds": 318.9,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.11,
      "end_seconds": 324.46,
      "duration_seconds": 1.35,
      "text": "Look after yourself."
    }
  ]
}