{
  "schema_version": "1.0",
  "encounter_id": "02702",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 3.91,
      "duration_seconds": 3.09,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.35,
      "end_seconds": 8.1,
      "duration_seconds": 2.75,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.83,
      "end_seconds": 12.47,
      "duration_seconds": 2.64,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 21.26,
      "duration_seconds": 6.89,
      "text": "Doctor, it's a blister on my heel. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.64,
      "end_seconds": 25.92,
      "duration_seconds": 3.28,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.4,
      "end_seconds": 30.03,
      "duration_seconds": 2.63,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.54,
      "end_seconds": 33.0,
      "duration_seconds": 2.46,
      "text": "Right, right. Does anything help it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.99,
      "end_seconds": 36.33,
      "duration_seconds": 2.34,
      "text": "A plaster helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.41,
      "end_seconds": 41.92,
      "duration_seconds": 4.51,
      "text": "What about a little soreness, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.16,
      "end_seconds": 44.7,
      "duration_seconds": 1.54,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.2,
      "end_seconds": 48.61,
      "duration_seconds": 2.41,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.2,
      "end_seconds": 53.73,
      "duration_seconds": 3.53,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.53,
      "end_seconds": 57.72,
      "duration_seconds": 3.19,
      "text": "Have you noticed pus, fever or diabetes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.61,
      "end_seconds": 62.86,
      "duration_seconds": 3.25,
      "text": "No, no pus, fever or diabetes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.01,
      "end_seconds": 66.92,
      "duration_seconds": 2.91,
      "text": "And redness spreading, any of that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.66,
      "end_seconds": 69.84,
      "duration_seconds": 2.18,
      "text": "No. No redness spreading."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.81,
      "end_seconds": 75.72,
      "duration_seconds": 3.91,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.52,
      "end_seconds": 78.49,
      "duration_seconds": 1.97,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.25,
      "end_seconds": 83.14,
      "duration_seconds": 2.89,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.05,
      "end_seconds": 89.31,
      "duration_seconds": 4.26,
      "text": "Gout, for two years. I've got high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.08,
      "end_seconds": 96.35,
      "duration_seconds": 6.27,
      "text": "Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.07,
      "end_seconds": 106.61,
      "duration_seconds": 2.54,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.42,
      "end_seconds": 111.89,
      "duration_seconds": 3.47,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.22,
      "end_seconds": 123.08,
      "duration_seconds": 3.86,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.69,
      "end_seconds": 129.92,
      "duration_seconds": 4.23,
      "text": "Febuxostat. I take it 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.27,
      "end_seconds": 131.27,
      "duration_seconds": 1.0,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.54,
      "end_seconds": 141.5,
      "duration_seconds": 5.96,
      "text": "Rosuvastatin. I take it 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.74,
      "end_seconds": 146.23,
      "duration_seconds": 3.49,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.06,
      "end_seconds": 150.14,
      "duration_seconds": 2.08,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.95,
      "end_seconds": 154.85,
      "duration_seconds": 2.9,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.43,
      "end_seconds": 159.04,
      "duration_seconds": 3.61,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.69,
      "end_seconds": 163.26,
      "duration_seconds": 2.57,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.45,
      "end_seconds": 177.69,
      "duration_seconds": 13.24,
      "text": "I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.52,
      "end_seconds": 182.71,
      "duration_seconds": 3.19,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.1,
      "end_seconds": 193.16,
      "duration_seconds": 2.06,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.65,
      "end_seconds": 220.96,
      "duration_seconds": 8.31,
      "text": "Okay: saturation 97 percent, temperature is 37.0 degrees, pulse 81. And blood pressure 117 over 69."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.2,
      "end_seconds": 223.55,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.76,
      "end_seconds": 227.01,
      "duration_seconds": 2.25,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.17,
      "end_seconds": 233.48,
      "duration_seconds": 4.31,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.42,
      "end_seconds": 237.77,
      "duration_seconds": 2.35,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.44,
      "end_seconds": 260.82,
      "duration_seconds": 6.38,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.05,
      "end_seconds": 263.17,
      "duration_seconds": 1.12,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.93,
      "end_seconds": 274.94,
      "duration_seconds": 7.01,
      "text": "Good, you can sit up again. Taking everything into account, this is probably a simple friction blister."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.2,
      "end_seconds": 316.61,
      "duration_seconds": 32.41,
      "text": "Leave it intact, cover it with a padded plaster and change the shoes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if the area becomes red, hot or pus-filled. If that happens, go to emergency. Book a review if it looks infected. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.15,
      "end_seconds": 320.49,
      "duration_seconds": 3.34,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}