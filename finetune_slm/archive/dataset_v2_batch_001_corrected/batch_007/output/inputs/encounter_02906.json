  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 6.51,
      "duration_seconds": 5.5,
      "text": "Right, thanks for waiting, come in. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.42,
      "end_seconds": 10.99,
      "duration_seconds": 3.57,
      "text": "I've been dealing with fainting on exertion."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.27,
      "end_seconds": 16.1,
      "duration_seconds": 3.83,
      "text": "so, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.05,
      "end_seconds": 21.87,
      "duration_seconds": 3.82,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.0,
      "end_seconds": 33.11,
      "duration_seconds": 10.11,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.53,
      "end_seconds": 40.37,
      "duration_seconds": 5.84,
      "text": "Erm, yes, exertion. That That makes it worse. Moderate, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.75,
      "end_seconds": 51.18,
      "duration_seconds": 3.43,
      "text": "have you had any leg pain or fever?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.96,
      "end_seconds": 55.48,
      "duration_seconds": 2.52,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.11,
      "end_seconds": 59.18,
      "duration_seconds": 2.07,
      "text": "and cough, any of that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.82,
      "end_seconds": 62.4,
      "duration_seconds": 1.58,
      "text": "nope, no cough"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.08,
      "end_seconds": 66.83,
      "duration_seconds": 2.75,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.4,
      "end_seconds": 72.37,
      "duration_seconds": 3.97,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.32,
      "end_seconds": 77.06,
      "duration_seconds": 2.74,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.55,
      "end_seconds": 79.51,
      "duration_seconds": 0.96,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.33,
      "end_seconds": 82.8,
      "duration_seconds": 2.47,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.81,
      "end_seconds": 87.28,
      "duration_seconds": 3.47,
      "text": "No, uh, nothing at the moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.15,
      "end_seconds": 100.93,
      "duration_seconds": 4.78,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.48,
      "end_seconds": 113.41,
      "duration_seconds": 10.93,
      "text": "I'm vegetarian and have been for years. Yes, I work in a bakery, early starts. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.87,
      "end_seconds": 118.84,
      "duration_seconds": 3.97,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.76,
      "end_seconds": 125.18,
      "duration_seconds": 3.42,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.95,
      "end_seconds": 133.88,
      "duration_seconds": 7.93,
      "text": "Any medical conditions, anything you've been treated for? I ask cos it helps me narrow things down."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.56,
      "end_seconds": 138.59,
      "duration_seconds": 3.03,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.7,
      "end_seconds": 142.69,
      "duration_seconds": 2.99,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.37,
      "end_seconds": 146.4,
      "duration_seconds": 2.03,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 153.82,
      "duration_seconds": 1.99,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.12,
      "end_seconds": 158.52,
      "duration_seconds": 3.4,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.15,
      "end_seconds": 162.02,
      "duration_seconds": 2.87,
      "text": "Let's start with the the basic checks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.59,
      "end_seconds": 174.95,
      "duration_seconds": 2.36,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.24,
      "end_seconds": 204.37,
      "duration_seconds": 11.13,
      "text": "Okay: BP is 118 over 72, temperature 36.9. And heart rate 93, height 176 centimetres, weight 92 kilos, SpO2 89 percent on room air."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.87,
      "end_seconds": 209.08,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.17,
      "end_seconds": 218.69,
      "duration_seconds": 1.52,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.32,
      "end_seconds": 222.48,
      "duration_seconds": 2.16,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.95,
      "end_seconds": 245.53,
      "duration_seconds": 5.58,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.97,
      "end_seconds": 248.06,
      "duration_seconds": 1.09,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.22,
      "end_seconds": 256.14,
      "duration_seconds": 2.92,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.53,
      "end_seconds": 273.24,
      "duration_seconds": 4.71,
      "text": "Right, here's what I'm thinking. It points towards possible pulmonary hypertension."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.61,
      "end_seconds": 279.53,
      "duration_seconds": 4.92,
      "text": "um, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.16,
      "end_seconds": 316.57,
      "duration_seconds": 35.41,
      "text": "it's reasonable to be concerned, but right now possible pulmonary hypertension is my leading thought, not anything worse i'll request an ECG, it'll help with syncope i'll request an echocardiogram, it'll help with exertional syncope no exertion for now, I am arranging urgent specialist tests make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.39,
      "end_seconds": 324.06,
      "duration_seconds": 6.67,
      "text": "Book a review in one week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.88,
      "end_seconds": 329.41,
      "duration_seconds": 3.53,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.26,
      "end_seconds": 331.52,
      "duration_seconds": 1.26,
      "text": "Look after yourself."
    }
  ]
