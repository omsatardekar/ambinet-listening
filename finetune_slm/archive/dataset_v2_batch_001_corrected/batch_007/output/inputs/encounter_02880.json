      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.44,
      "end_seconds": 87.13,
      "duration_seconds": 7.69,
      "text": "have you had a new headache at the temple before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.76,
      "end_seconds": 95.23,
      "duration_seconds": 7.47,
      "text": "actually, a bit, a couple of years ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0010",
