{
  "schema_version": "1.0",
  "encounter_id": "02694",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 6.66,
      "duration_seconds": 5.96,
      "text": "Hello, take a seat, I'll be with you in a second. What's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.45,
      "end_seconds": 16.68,
      "duration_seconds": 9.23,
      "text": "Mainly breathlessness building over weeks. There's a a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.02,
      "end_seconds": 21.06,
      "duration_seconds": 3.04,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.14,
      "end_seconds": 24.17,
      "duration_seconds": 2.03,
      "text": "No, um, none."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.95,
      "end_seconds": 39.26,
      "duration_seconds": 3.31,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.2,
      "end_seconds": 47.14,
      "duration_seconds": 5.94,
      "text": "About... well, two months. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.26,
      "end_seconds": 51.27,
      "duration_seconds": 3.01,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.91,
      "end_seconds": 55.21,
      "duration_seconds": 3.3,
      "text": "I mean, I'd call it it severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.71,
      "end_seconds": 58.52,
      "duration_seconds": 2.81,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.12,
      "end_seconds": 66.06,
      "duration_seconds": 5.94,
      "text": "A dry cough goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.36,
      "end_seconds": 71.29,
      "duration_seconds": 2.93,
      "text": "Have you had any leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.46,
      "end_seconds": 76.39,
      "duration_seconds": 3.93,
      "text": "Not that that I've noticed, no leg swelling."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.65,
      "end_seconds": 81.6,
      "duration_seconds": 3.95,
      "text": "Have you noticed fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.61,
      "end_seconds": 91.0,
      "duration_seconds": 3.39,
      "text": "Oh, no, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.4,
      "end_seconds": 94.47,
      "duration_seconds": 2.07,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.26,
      "end_seconds": 97.84,
      "duration_seconds": 1.58,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.82,
      "end_seconds": 103.78,
      "duration_seconds": 3.96,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.3,
      "end_seconds": 109.33,
      "duration_seconds": 4.03,
      "text": "I, I have thin bones, for five years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.85,
      "end_seconds": 119.93,
      "duration_seconds": 9.08,
      "text": "Yes, thin bones is known to us, good to have that clear. Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.47,
      "end_seconds": 124.41,
      "duration_seconds": 3.94,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.0,
      "end_seconds": 129.37,
      "duration_seconds": 3.37,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.99,
      "end_seconds": 133.08,
      "duration_seconds": 3.09,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.41,
      "end_seconds": 155.28,
      "duration_seconds": 4.87,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.06,
      "end_seconds": 159.11,
      "duration_seconds": 3.05,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.59,
      "end_seconds": 179.62,
      "duration_seconds": 5.03,
      "text": "can I check a a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.45,
      "end_seconds": 192.85,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.22,
      "end_seconds": 217.55,
      "duration_seconds": 9.33,
      "text": "okay: pressure 132 over 80, oxygen saturation is 92 percent, heart rate 94. And respiratory rate 25, temperature 36.7."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.07,
      "end_seconds": 221.2,
      "duration_seconds": 2.13,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.01,
      "end_seconds": 225.5,
      "duration_seconds": 3.49,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.19,
      "end_seconds": 233.07,
      "duration_seconds": 4.88,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.65,
      "end_seconds": 239.26,
      "duration_seconds": 1.61,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.23,
      "end_seconds": 242.84,
      "duration_seconds": 2.61,
      "text": "Alright, tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.85,
      "end_seconds": 265.5,
      "duration_seconds": 5.65,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.99,
      "end_seconds": 272.49,
      "duration_seconds": 2.5,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.28,
      "end_seconds": 294.79,
      "duration_seconds": 7.51,
      "text": "Let me tell you where I've got to. This is probably a a pleural effusion needing a cause."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.15,
      "end_seconds": 299.57,
      "duration_seconds": 1.42,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.07,
      "end_seconds": 316.0,
      "duration_seconds": 15.93,
      "text": "I understand the worry. At the moment I'd say it's a pleural effusion needing a cause, and we'll know more once the a chest X-ray is back. I'm sending you for a chest X-ray because of breathlessness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.87,
      "end_seconds": 320.49,
      "duration_seconds": 2.62,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.44,
      "end_seconds": 352.55,
      "duration_seconds": 31.11,
      "text": "I'm sending you for a CT scan of the chest because of pleural effusion. I am arranging an urgent chest clinic review. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'm going to send a referral to the chest clinic. I'm not ordering a pleural fluid sample today. If things carry on in two weeks, we'll consider it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.09,
      "end_seconds": 361.69,
      "duration_seconds": 5.6,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.43,
      "end_seconds": 364.59,
      "duration_seconds": 2.16,
      "text": "I, I'll remember that"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.15,
      "end_seconds": 371.51,
      "duration_seconds": 6.36,
      "text": "let's plan a check after the scan that's all from me any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.38,
      "end_seconds": 375.35,
      "duration_seconds": 2.97,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}