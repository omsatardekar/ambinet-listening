      "role": "PATIENT",
      "start_seconds": 65.17,
      "end_seconds": 69.25,
      "duration_seconds": 4.08,
      "text": "I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.6,
      "end_seconds": 74.53,
      "duration_seconds": 3.93,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.67,
      "end_seconds": 77.92,
      "duration_seconds": 2.25,
      "text": "My grandmother had dementia."
