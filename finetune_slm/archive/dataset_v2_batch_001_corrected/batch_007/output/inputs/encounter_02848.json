    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.06,
      "end_seconds": 93.46,
      "duration_seconds": 3.4,
      "text": "any medical conditions, anything you've been treated for?"
    },
