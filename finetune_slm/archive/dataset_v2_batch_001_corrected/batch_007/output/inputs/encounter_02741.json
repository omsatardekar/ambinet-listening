{
  "schema_version": "1.0",
  "encounter_id": "02741",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 7.82,
      "duration_seconds": 6.77,
      "text": "Come in, have a seat by the desk. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.23,
      "end_seconds": 25.78,
      "duration_seconds": 11.55,
      "text": "Honestly, it's a rolled ankle, and my family pushed me to come. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.46,
      "end_seconds": 33.0,
      "duration_seconds": 5.54,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.5,
      "end_seconds": 42.27,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.9,
      "end_seconds": 64.49,
      "duration_seconds": 8.59,
      "text": "Okay: pressure 128 over 71, saturation 97 percent, temperature is 36.8 degrees. And respiratory rate 15, heart rate 73."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.4,
      "end_seconds": 67.93,
      "duration_seconds": 1.53,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.47,
      "end_seconds": 75.12,
      "duration_seconds": 5.65,
      "text": "That's fine, I'll explain it soon. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.74,
      "end_seconds": 90.83,
      "duration_seconds": 15.09,
      "text": "Erm, it's been like this since last Tuesday. Uh, I've had some swelling too, for five days. Oh, and bruising. Had that since Monday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.64,
      "end_seconds": 112.29,
      "duration_seconds": 6.65,
      "text": "Have you had any pain in the shin, numbness, pain in the foot or pop?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.1,
      "end_seconds": 122.39,
      "duration_seconds": 9.29,
      "text": "No, you know, no pain in the shin, numbness, pain in the foot or pop."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.91,
      "end_seconds": 132.1,
      "duration_seconds": 5.19,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.36,
      "end_seconds": 136.92,
      "duration_seconds": 3.56,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.82,
      "end_seconds": 141.12,
      "duration_seconds": 2.3,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.74,
      "end_seconds": 145.09,
      "duration_seconds": 2.35,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.42,
      "end_seconds": 165.34,
      "duration_seconds": 2.92,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.2,
      "end_seconds": 174.72,
      "duration_seconds": 7.52,
      "text": "Um, I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 183.03,
      "duration_seconds": 3.84,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.87,
      "end_seconds": 188.66,
      "duration_seconds": 4.79,
      "text": "Rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.01,
      "end_seconds": 192.22,
      "duration_seconds": 2.21,
      "text": "So, and for how long?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.84,
      "end_seconds": 195.28,
      "duration_seconds": 2.44,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.71,
      "end_seconds": 196.41,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.28,
      "end_seconds": 204.39,
      "duration_seconds": 7.11,
      "text": "Let me think, I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.03,
      "end_seconds": 209.66,
      "duration_seconds": 4.63,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.38,
      "end_seconds": 232.06,
      "duration_seconds": 18.68,
      "text": "I have about eight cigarettes in a day. I'll have a glass of wine with dinner. I live with my elderly mother. I work in accounts at a hospital. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.51,
      "end_seconds": 236.79,
      "duration_seconds": 3.28,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.77,
      "end_seconds": 243.04,
      "duration_seconds": 4.27,
      "text": "Okay, so no, not that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.63,
      "end_seconds": 247.03,
      "duration_seconds": 3.4,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.77,
      "end_seconds": 250.91,
      "duration_seconds": 3.14,
      "text": "Mm, my son has asthma."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.93,
      "end_seconds": 256.85,
      "duration_seconds": 3.92,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.53,
      "end_seconds": 264.13,
      "duration_seconds": 5.6,
      "text": "High cholesterol, for nearly five years. I've got heart disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.17,
      "end_seconds": 269.15,
      "duration_seconds": 0.98,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.32,
      "end_seconds": 272.88,
      "duration_seconds": 2.56,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.89,
      "end_seconds": 285.41,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.66,
      "end_seconds": 288.46,
      "duration_seconds": 1.8,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.16,
      "end_seconds": 310.87,
      "duration_seconds": 8.71,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.92,
      "end_seconds": 312.95,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.15,
      "end_seconds": 333.47,
      "duration_seconds": 18.32,
      "text": "That's all I needed to check. Taking everything into account, this is probably a mild ankle sprain. That's my thinking for now, and it may change as we learn more. Rest, ice, compression and elevation, then gradual strengthening."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.0,
      "end_seconds": 346.06,
      "duration_seconds": 12.06,
      "text": "Understood. If the symptoms get worse, that's the point to come in urgently. Let's plan a check if not better in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.71,
      "end_seconds": 350.41,
      "duration_seconds": 3.7,
      "text": "Great, thank you for your help."
    }
  ]
}