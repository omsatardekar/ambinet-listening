{
  "schema_version": "1.0",
  "encounter_id": "02507",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 7.64,
      "duration_seconds": 6.74,
      "text": "Doctor, you know, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.02,
      "end_seconds": 13.01,
      "duration_seconds": 3.99,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.69,
      "end_seconds": 18.55,
      "duration_seconds": 4.86,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.6,
      "end_seconds": 23.4,
      "duration_seconds": 3.8,
      "text": "It's a blocked nose for months, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.32,
      "end_seconds": 27.45,
      "duration_seconds": 3.13,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.57,
      "end_seconds": 31.76,
      "duration_seconds": 3.19,
      "text": "It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.05,
      "end_seconds": 36.66,
      "duration_seconds": 3.61,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.25,
      "end_seconds": 43.79,
      "duration_seconds": 6.54,
      "text": "about a five out of ten. There's a postnasal drip as well"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.07,
      "end_seconds": 48.98,
      "duration_seconds": 3.91,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.85,
      "end_seconds": 58.28,
      "duration_seconds": 7.43,
      "text": "it feels severe to me i'd been losing my sense of smell, but that went away"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.38,
      "end_seconds": 68.11,
      "duration_seconds": 6.73,
      "text": "have you had a blocked nose for months before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.65,
      "end_seconds": 75.26,
      "duration_seconds": 6.61,
      "text": "a bit, about six months ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.52,
      "end_seconds": 91.63,
      "duration_seconds": 2.11,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.53,
      "end_seconds": 105.65,
      "duration_seconds": 2.12,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.14,
      "end_seconds": 132.11,
      "duration_seconds": 7.97,
      "text": "okay: pulse 65, respiratory rate 16, oxygen saturation is 98 percent and BP is 109 over 81."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.91,
      "end_seconds": 138.51,
      "duration_seconds": 3.6,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.08,
      "end_seconds": 140.08,
      "duration_seconds": 1.0,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.0,
      "end_seconds": 143.41,
      "duration_seconds": 2.41,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.85,
      "end_seconds": 158.38,
      "duration_seconds": 3.53,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.71,
      "end_seconds": 166.79,
      "duration_seconds": 6.08,
      "text": "Good, you can sit up again. Did you get nosebleeds, vision changes or facial swelling?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.85,
      "end_seconds": 173.72,
      "duration_seconds": 4.87,
      "text": "I haven't had nosebleeds, vision changes or facial swelling, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.87,
      "end_seconds": 176.87,
      "duration_seconds": 2.0,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.39,
      "end_seconds": 179.0,
      "duration_seconds": 1.61,
      "text": "nope, no fever"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.81,
      "end_seconds": 181.79,
      "duration_seconds": 1.98,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.78,
      "end_seconds": 183.8,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.58,
      "end_seconds": 187.91,
      "duration_seconds": 3.33,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.28,
      "end_seconds": 198.7,
      "duration_seconds": 9.42,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.49,
      "end_seconds": 209.96,
      "duration_seconds": 2.47,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.63,
      "end_seconds": 216.3,
      "duration_seconds": 4.67,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.87,
      "end_seconds": 235.57,
      "duration_seconds": 3.7,
      "text": "Which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 237.28,
      "end_seconds": 240.15,
      "duration_seconds": 2.87,
      "text": "it's Asthalin inhaler, when needed, doctor"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.0,
      "end_seconds": 243.48,
      "duration_seconds": 2.48,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 244.77,
      "end_seconds": 258.99,
      "duration_seconds": 14.22,
      "text": "About about a year. He is on tamsulosin, 0.4 milligrams, at night, I give it to him. It's aspirin, once a day for my heart, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.78,
      "end_seconds": 262.82,
      "duration_seconds": 2.04,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 264.28,
      "end_seconds": 269.33,
      "duration_seconds": 5.05,
      "text": "75 milligrams it's saline spray, three times a day, doctor"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.0,
      "end_seconds": 272.29,
      "duration_seconds": 1.29,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.0,
      "end_seconds": 276.72,
      "duration_seconds": 3.72,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.87,
      "end_seconds": 280.18,
      "duration_seconds": 2.31,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.45,
      "end_seconds": 285.8,
      "duration_seconds": 4.35,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.62,
      "end_seconds": 290.47,
      "duration_seconds": 2.85,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.57,
      "end_seconds": 294.79,
      "duration_seconds": 3.22,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.88,
      "end_seconds": 299.6,
      "duration_seconds": 2.72,
      "text": "so, what about your medical history?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.3,
      "end_seconds": 306.96,
      "duration_seconds": 5.66,
      "text": "Asthma, for about a year i've had an enlarged prostate, yes"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.92,
      "end_seconds": 309.66,
      "duration_seconds": 0.74,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.42,
      "end_seconds": 313.4,
      "duration_seconds": 1.98,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.62,
      "end_seconds": 318.21,
      "duration_seconds": 3.59,
      "text": "I follow. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.89,
      "end_seconds": 323.09,
      "duration_seconds": 3.2,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.34,
      "end_seconds": 331.66,
      "duration_seconds": 7.32,
      "text": "Putting it all together, this looks most like nasal polyps. Chronic sinusitis is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.0,
      "end_seconds": 335.69,
      "duration_seconds": 2.69,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.87,
      "end_seconds": 349.92,
      "duration_seconds": 13.05,
      "text": "I can't promise yet, but most people with nasal polyps do well once it's treated properly. A nasal endoscopy is what I'd like next, for nasal obstruction"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.08,
      "end_seconds": 352.44,
      "duration_seconds": 1.36,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.73,
      "end_seconds": 373.61,
      "duration_seconds": 19.88,
      "text": "for this, mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for nasal polyps. Rinse with saline and use the spray daily. I think the ENT clinic should see you too. Come back in eight weeks"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.43,
      "end_seconds": 377.34,
      "duration_seconds": 1.91,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.39,
      "end_seconds": 382.14,
      "duration_seconds": 2.75,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.01,
      "end_seconds": 386.11,
      "duration_seconds": 3.1,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}