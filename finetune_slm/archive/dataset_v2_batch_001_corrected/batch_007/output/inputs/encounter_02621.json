{
  "schema_version": "1.0",
  "encounter_id": "02621",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.03,
      "end_seconds": 3.55,
      "duration_seconds": 2.52,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.09,
      "end_seconds": 6.05,
      "duration_seconds": 0.96,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 9.56,
      "duration_seconds": 2.89,
      "text": "Okay, what's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.15,
      "end_seconds": 17.92,
      "duration_seconds": 6.77,
      "text": "It's a rolled ankle. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.59,
      "end_seconds": 22.35,
      "duration_seconds": 2.76,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.36,
      "end_seconds": 29.61,
      "duration_seconds": 2.25,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.52,
      "end_seconds": 34.84,
      "duration_seconds": 3.32,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.04,
      "end_seconds": 43.59,
      "duration_seconds": 7.55,
      "text": "Right, uh, it usually comes with bruising. The bruising? That's been for three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.48,
      "end_seconds": 48.08,
      "duration_seconds": 3.6,
      "text": "Any pain in the foot or pop at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.81,
      "end_seconds": 55.22,
      "duration_seconds": 5.41,
      "text": "I haven't had pain in the foot or pop, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.57,
      "end_seconds": 59.02,
      "duration_seconds": 2.45,
      "text": "And numbness, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.58,
      "end_seconds": 65.2,
      "duration_seconds": 2.62,
      "text": "Nope, you know, no numbness."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.21,
      "end_seconds": 68.36,
      "duration_seconds": 2.15,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.37,
      "end_seconds": 72.37,
      "duration_seconds": 3.0,
      "text": "So, no, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.73,
      "end_seconds": 75.82,
      "duration_seconds": 2.09,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.33,
      "end_seconds": 78.88,
      "duration_seconds": 2.55,
      "text": "Erm, no, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.98,
      "end_seconds": 83.68,
      "duration_seconds": 3.7,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.7,
      "end_seconds": 88.64,
      "duration_seconds": 3.94,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.89,
      "end_seconds": 92.85,
      "duration_seconds": 2.96,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.4,
      "end_seconds": 98.05,
      "duration_seconds": 4.65,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 100.87,
      "duration_seconds": 1.79,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.8,
      "end_seconds": 105.37,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.31,
      "end_seconds": 125.16,
      "duration_seconds": 2.85,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.66,
      "end_seconds": 144.66,
      "duration_seconds": 15.0,
      "text": "An irregular heartbeat, for nearly five years. I'd rather know what's going on than keep guessing. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.17,
      "end_seconds": 150.98,
      "duration_seconds": 5.81,
      "text": "Okay, yes, an irregular heartbeat is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.14,
      "end_seconds": 168.17,
      "duration_seconds": 2.03,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.11,
      "end_seconds": 173.86,
      "duration_seconds": 4.75,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.6,
      "end_seconds": 179.69,
      "duration_seconds": 4.09,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.54,
      "end_seconds": 184.85,
      "duration_seconds": 3.31,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 190.27,
      "duration_seconds": 4.25,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.33,
      "end_seconds": 204.66,
      "duration_seconds": 2.33,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.07,
      "end_seconds": 223.11,
      "duration_seconds": 6.04,
      "text": "Okay: oxygen saturation is 98 percent, BP is 112 over 80, heart rate 71."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.98,
      "end_seconds": 226.46,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.82,
      "end_seconds": 230.19,
      "duration_seconds": 2.37,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.72,
      "end_seconds": 235.44,
      "duration_seconds": 3.72,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.23,
      "end_seconds": 239.26,
      "duration_seconds": 2.03,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.72,
      "end_seconds": 264.52,
      "duration_seconds": 7.8,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.79,
      "end_seconds": 271.59,
      "duration_seconds": 1.8,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.34,
      "end_seconds": 301.57,
      "duration_seconds": 18.23,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'd like to see you again if not better in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.02,
      "end_seconds": 305.4,
      "duration_seconds": 2.38,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.72,
      "end_seconds": 308.1,
      "duration_seconds": 1.38,
      "text": "Take care now."
    }
  ]
}