{
  "schema_version": "1.0",
  "encounter_id": "02782",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 4.89,
      "duration_seconds": 4.02,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 11.33,
      "duration_seconds": 5.06,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.95,
      "end_seconds": 15.27,
      "duration_seconds": 3.32,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.14,
      "end_seconds": 20.14,
      "duration_seconds": 3.0,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.92,
      "end_seconds": 29.09,
      "duration_seconds": 7.17,
      "text": "Yeah, it's a widespread rash with fever. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.9,
      "end_seconds": 34.17,
      "duration_seconds": 3.27,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.87,
      "end_seconds": 37.96,
      "duration_seconds": 3.09,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.58,
      "end_seconds": 40.63,
      "duration_seconds": 2.05,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.09,
      "end_seconds": 45.79,
      "duration_seconds": 3.7,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.98,
      "end_seconds": 49.16,
      "duration_seconds": 2.18,
      "text": "Any swollen face as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.33,
      "end_seconds": 65.13,
      "duration_seconds": 14.8,
      "text": "Yeah, that too. As for swollen face, about a eight out of ten. I did have a recent new medicine at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.18,
      "end_seconds": 76.99,
      "duration_seconds": 3.81,
      "text": "And what about blisters, breathing difficulty or mouth sores?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.01,
      "end_seconds": 82.11,
      "duration_seconds": 3.1,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.67,
      "end_seconds": 86.05,
      "duration_seconds": 3.38,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.79,
      "end_seconds": 88.59,
      "duration_seconds": 1.8,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.35,
      "end_seconds": 106.56,
      "duration_seconds": 3.21,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.73,
      "end_seconds": 124.62,
      "duration_seconds": 16.89,
      "text": "Foracort inhaler, twice a day for my asthma. I'm on escitalopram, 10 milligrams, once a day for the anxiety. Allopurinol. I take it 300 milligrams, started four weeks ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.93,
      "end_seconds": 127.55,
      "duration_seconds": 1.62,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.13,
      "end_seconds": 131.88,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.7,
      "end_seconds": 135.82,
      "duration_seconds": 2.12,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.61,
      "end_seconds": 140.0,
      "duration_seconds": 2.39,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.72,
      "end_seconds": 146.72,
      "duration_seconds": 5.0,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.66,
      "end_seconds": 162.38,
      "duration_seconds": 13.72,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.34,
      "end_seconds": 186.0,
      "duration_seconds": 4.66,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.69,
      "end_seconds": 191.19,
      "duration_seconds": 3.5,
      "text": "I have asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.12,
      "end_seconds": 194.35,
      "duration_seconds": 1.23,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.07,
      "end_seconds": 205.73,
      "duration_seconds": 10.66,
      "text": "Yes, anxiety. A neighbour of mine said I should see someone about it. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.65,
      "end_seconds": 213.22,
      "duration_seconds": 6.57,
      "text": "Alright, asthma, that matches what I have here. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.17,
      "end_seconds": 221.12,
      "duration_seconds": 6.95,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.13,
      "end_seconds": 224.86,
      "duration_seconds": 2.73,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.79,
      "end_seconds": 228.77,
      "duration_seconds": 2.98,
      "text": "Ah, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.11,
      "end_seconds": 234.1,
      "duration_seconds": 3.99,
      "text": "Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.79,
      "end_seconds": 250.17,
      "duration_seconds": 2.38,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.91,
      "end_seconds": 279.74,
      "duration_seconds": 8.83,
      "text": "Okay: temperature is 38.5 degrees, pulse 104, blood pressure 109 over 69, SpO2 95 percent on room air."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.97,
      "end_seconds": 285.0,
      "duration_seconds": 4.03,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.93,
      "end_seconds": 287.66,
      "duration_seconds": 1.73,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.57,
      "end_seconds": 291.33,
      "duration_seconds": 1.76,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.32,
      "end_seconds": 308.28,
      "duration_seconds": 6.96,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.86,
      "end_seconds": 324.73,
      "duration_seconds": 10.87,
      "text": "Thank you, you can get dressed. Okay, thinking it through, this is probably a severe drug reaction. A viral rash is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.79,
      "end_seconds": 327.79,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.75,
      "end_seconds": 361.62,
      "duration_seconds": 31.87,
      "text": "I understand the worry. At the moment I'd say it's a severe drug reaction, and we'll know more once the urgent blood tests is back. I want urgent blood tests done, that's for severe drug reaction. That will help us see what's going on underneath and decide the next step. You'll be taking prednisolone, 40 milligrams, once a day, until review. That should help with severe drug reaction. Stop the allopurinol now and you need admission."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.64,
      "end_seconds": 374.67,
      "duration_seconds": 12.03,
      "text": "A short walk every day, even twenty minutes, will help more than you'd think. The dermatology team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.87,
      "end_seconds": 376.57,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.61,
      "end_seconds": 382.51,
      "duration_seconds": 4.9,
      "text": "We'll catch up straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.21,
      "end_seconds": 387.87,
      "duration_seconds": 3.66,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}