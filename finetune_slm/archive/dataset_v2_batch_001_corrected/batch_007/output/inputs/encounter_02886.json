{
  "schema_version": "1.0",
  "encounter_id": "02886",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.68,
      "duration_seconds": 4.98,
      "text": "Morning, um, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 10.3,
      "duration_seconds": 3.71,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.4,
      "end_seconds": 26.44,
      "duration_seconds": 13.04,
      "text": "Right, so the thing is, I've got itchy blisters. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.12,
      "end_seconds": 32.94,
      "duration_seconds": 5.82,
      "text": "How long has this been bothering you? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.71,
      "end_seconds": 41.72,
      "duration_seconds": 3.01,
      "text": "It's been two months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.08,
      "end_seconds": 45.71,
      "duration_seconds": 3.63,
      "text": "Yes, carry on. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.01,
      "end_seconds": 62.25,
      "duration_seconds": 15.24,
      "text": "It usually comes with an itchy rash first. Oh, uh, and raw areas where blisters burst. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.59,
      "end_seconds": 68.61,
      "duration_seconds": 5.02,
      "text": "Have you had itchy blisters before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.52,
      "end_seconds": 79.44,
      "duration_seconds": 9.92,
      "text": "I mean, uh, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.11,
      "end_seconds": 82.37,
      "duration_seconds": 2.26,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.33,
      "end_seconds": 91.69,
      "duration_seconds": 2.36,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.6,
      "end_seconds": 114.15,
      "duration_seconds": 11.55,
      "text": "Okay: pulse is 79 beats a minute, respiratory rate 18, SpO2 98 percent on room air, temperature 36.5, pressure 109 over 80."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.86,
      "end_seconds": 120.68,
      "duration_seconds": 3.82,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.5,
      "end_seconds": 124.8,
      "duration_seconds": 2.3,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.18,
      "end_seconds": 140.8,
      "duration_seconds": 6.62,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.77,
      "end_seconds": 145.36,
      "duration_seconds": 1.59,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.56,
      "end_seconds": 158.98,
      "duration_seconds": 1.42,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.5,
      "end_seconds": 164.35,
      "duration_seconds": 3.85,
      "text": "Ah, not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.29,
      "end_seconds": 170.68,
      "duration_seconds": 4.39,
      "text": "Did you get eye problems, mouth sores or new medicine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.59,
      "end_seconds": 176.22,
      "duration_seconds": 4.63,
      "text": "Okay, uh, so none of those, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.77,
      "end_seconds": 180.29,
      "duration_seconds": 2.52,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.38,
      "end_seconds": 182.97,
      "duration_seconds": 1.59,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.19,
      "end_seconds": 188.95,
      "duration_seconds": 4.76,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.93,
      "end_seconds": 197.07,
      "duration_seconds": 3.14,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.89,
      "end_seconds": 200.9,
      "duration_seconds": 2.01,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.57,
      "end_seconds": 204.28,
      "duration_seconds": 2.71,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.07,
      "end_seconds": 211.91,
      "duration_seconds": 6.84,
      "text": "Understood. Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.12,
      "end_seconds": 232.02,
      "duration_seconds": 3.9,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.29,
      "end_seconds": 238.51,
      "duration_seconds": 5.22,
      "text": "Uh, I'm on amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.81,
      "end_seconds": 241.13,
      "duration_seconds": 1.32,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.55,
      "end_seconds": 252.47,
      "duration_seconds": 9.92,
      "text": "For two years. I mean, um, I had ramipril at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.5,
      "end_seconds": 266.63,
      "duration_seconds": 3.13,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.01,
      "end_seconds": 271.04,
      "duration_seconds": 3.03,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.87,
      "end_seconds": 273.47,
      "duration_seconds": 1.6,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.07,
      "end_seconds": 278.03,
      "duration_seconds": 3.96,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.66,
      "end_seconds": 284.36,
      "duration_seconds": 2.7,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.03,
      "end_seconds": 289.87,
      "duration_seconds": 4.84,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.43,
      "end_seconds": 299.37,
      "duration_seconds": 8.94,
      "text": "Putting it all together, it's hard to say. Bullous pemphigoid is one possibility and pemphigus another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.72,
      "end_seconds": 303.92,
      "duration_seconds": 3.2,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.21,
      "end_seconds": 317.32,
      "duration_seconds": 12.11,
      "text": "I understand the worry. At the moment I'd say it's bullous pemphigoid, and we'll watch how it goes. So, today I'm not changing anything. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.87,
      "end_seconds": 323.75,
      "duration_seconds": 4.88,
      "text": "Actually, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.96,
      "end_seconds": 326.14,
      "duration_seconds": 1.18,
      "text": "Take care now."
    }
  ]
}