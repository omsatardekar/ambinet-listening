    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.97,
      "end_seconds": 61.97,
      "duration_seconds": 3.0,
      "text": "right, keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.34,
      "end_seconds": 87.21,
      "duration_seconds": 8.87,
      "text": "Okay: blood pressure 99 over 56, temperature is 37.1 degrees. And pulse 111, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.63,
      "end_seconds": 90.04,
      "duration_seconds": 1.41,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.39,
      "end_seconds": 94.06,
      "duration_seconds": 2.67,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.58,
      "end_seconds": 99.86,
      "duration_seconds": 4.28,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 104.47,
      "duration_seconds": 2.97,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.8,
      "end_seconds": 126.09,
      "duration_seconds": 5.29,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.68,
      "end_seconds": 134.63,
      "duration_seconds": 2.95,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.9,
      "end_seconds": 147.22,
      "duration_seconds": 1.32,
      "text": "alright any fall?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.46,
      "end_seconds": 150.14,
      "duration_seconds": 1.68,
      "text": "definitely no fall"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.7,
      "end_seconds": 153.83,
      "duration_seconds": 3.13,
      "text": "a few quick ones: fever or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.88,
      "end_seconds": 158.38,
      "duration_seconds": 2.5,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.5,
      "end_seconds": 161.76,
      "duration_seconds": 2.26,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.75,
      "end_seconds": 165.61,
      "duration_seconds": 2.86,
      "text": "Um, no, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.14,
      "end_seconds": 169.0,
      "duration_seconds": 1.86,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.3,
      "end_seconds": 171.23,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.96,
      "end_seconds": 174.91,
      "duration_seconds": 1.95,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.13,
      "end_seconds": 180.77,
      "duration_seconds": 4.64,
      "text": "I've got an underactive thyroid. Yes an enlarged prostate."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.59,
      "end_seconds": 185.81,
      "duration_seconds": 4.22,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.28,
      "end_seconds": 196.28,
      "duration_seconds": 9.0,
      "text": "Eltroxin, 100 micrograms, every morning. I take tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.18,
      "end_seconds": 211.53,
      "duration_seconds": 1.35,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.23,
      "end_seconds": 213.21,
      "duration_seconds": 0.98,
      "text": "no never"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.39,
      "end_seconds": 218.95,
      "duration_seconds": 4.56,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.18,
      "end_seconds": 225.83,
      "duration_seconds": 5.65,
      "text": "Nickel. I come out in... well a rash on my skin."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.15,
      "end_seconds": 229.94,
      "duration_seconds": 2.79,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.76,
      "end_seconds": 241.37,
      "duration_seconds": 10.61,
      "text": "Lots of rice, lentils and some fruit. I do a yoga class on Thursdays. I live with my elderly mother"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.68,
      "end_seconds": 266.29,
      "duration_seconds": 11.61,
      "text": "We should do urgent blood tests for confusion and polyuria. For this sodium chloride 0.9% 1 litre over one hour single dose. That That should help with dehydration."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.01,
      "end_seconds": 272.87,
      "duration_seconds": 4.86,
      "text": "actually, um, should I take that with food?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.08,
      "end_seconds": 297.74,
      "duration_seconds": 23.66,
      "text": "you need hospital fluids and treatment now. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. If it hasn't settled next month, we'd think about an ECG, but not now. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.33,
      "end_seconds": 301.76,
      "duration_seconds": 2.43,
      "text": "Thank you, doctor, goodbye."
    }
  ]
