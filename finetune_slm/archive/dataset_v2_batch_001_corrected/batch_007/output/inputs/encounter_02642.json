      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 14.3,
      "duration_seconds": 5.54,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.12,
      "end_seconds": 23.45,
      "duration_seconds": 7.33,
      "text": "Yeah it's severe thirst and passing lots of urine. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.38,
      "end_seconds": 27.78,
      "duration_seconds": 3.4,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.81,
      "end_seconds": 32.1,
      "duration_seconds": 2.29,
      "text": "it's been two weeks now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.16,
      "end_seconds": 47.62,
      "duration_seconds": 2.46,
      "text": "Let me quickly check your readings."
