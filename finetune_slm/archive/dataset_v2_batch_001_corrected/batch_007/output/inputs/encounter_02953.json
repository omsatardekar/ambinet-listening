{
  "schema_version": "1.0",
  "encounter_id": "02953",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 6.41,
      "duration_seconds": 5.09,
      "text": "Hmm, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 12.07,
      "duration_seconds": 4.73,
      "text": "Alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.83,
      "end_seconds": 17.61,
      "duration_seconds": 3.78,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.4,
      "end_seconds": 23.01,
      "duration_seconds": 3.61,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.28,
      "end_seconds": 27.48,
      "duration_seconds": 3.2,
      "text": "She's been having difficulty concentrating, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.4,
      "end_seconds": 30.97,
      "duration_seconds": 1.57,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.51,
      "end_seconds": 36.73,
      "duration_seconds": 5.22,
      "text": "Sorry, what was I saying, I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 38.8,
      "end_seconds": 42.35,
      "duration_seconds": 3.55,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.64,
      "end_seconds": 48.04,
      "duration_seconds": 4.4,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.25,
      "end_seconds": 52.5,
      "duration_seconds": 3.25,
      "text": "Okay, so yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.43,
      "end_seconds": 56.78,
      "duration_seconds": 3.35,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.86,
      "end_seconds": 67.43,
      "duration_seconds": 9.57,
      "text": "Restlessness goes along with it, most of the time. Oh, the restlessness? That's been for one week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.3,
      "end_seconds": 72.19,
      "duration_seconds": 2.89,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.92,
      "end_seconds": 78.39,
      "duration_seconds": 5.47,
      "text": "Moderate, I'd say. I'd been losing things, but that went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.48,
      "end_seconds": 82.31,
      "duration_seconds": 2.83,
      "text": "So, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.8,
      "end_seconds": 87.56,
      "duration_seconds": 3.76,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.8,
      "end_seconds": 90.86,
      "duration_seconds": 2.06,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.39,
      "end_seconds": 100.29,
      "duration_seconds": 3.9,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.68,
      "end_seconds": 102.63,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.7,
      "end_seconds": 108.4,
      "duration_seconds": 3.7,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.99,
      "end_seconds": 110.56,
      "duration_seconds": 1.57,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.82,
      "end_seconds": 115.2,
      "duration_seconds": 3.38,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.06,
      "end_seconds": 118.74,
      "duration_seconds": 1.68,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.95,
      "end_seconds": 124.02,
      "duration_seconds": 4.07,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.67,
      "end_seconds": 128.41,
      "duration_seconds": 3.74,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.15,
      "end_seconds": 133.41,
      "duration_seconds": 3.26,
      "text": "Erm, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.92,
      "end_seconds": 139.62,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.37,
      "end_seconds": 142.53,
      "duration_seconds": 2.16,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.84,
      "end_seconds": 149.1,
      "duration_seconds": 5.26,
      "text": "Sure. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.06,
      "end_seconds": 153.15,
      "duration_seconds": 3.09,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.19,
      "end_seconds": 172.55,
      "duration_seconds": 4.36,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.19,
      "end_seconds": 179.41,
      "duration_seconds": 6.22,
      "text": "My sister had breast cancer. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 195.2,
      "duration_seconds": 3.62,
      "text": "Alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 195.8,
      "end_seconds": 209.89,
      "duration_seconds": 14.09,
      "text": "She is on clopidogrel, 75 milligrams, once a day for the stent, I give it to her. She takes febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.03,
      "end_seconds": 216.42,
      "duration_seconds": 5.39,
      "text": "Ah, I used to take allopurinol, but I stopped it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.31,
      "end_seconds": 220.3,
      "duration_seconds": 2.99,
      "text": "Has there been any thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.09,
      "end_seconds": 224.72,
      "duration_seconds": 3.63,
      "text": "No, you know, no thoughts of self-harm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.53,
      "end_seconds": 231.19,
      "duration_seconds": 5.66,
      "text": "Let me check a few things. Any low mood, head injury or drug use?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.63,
      "end_seconds": 234.84,
      "duration_seconds": 2.21,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.73,
      "end_seconds": 242.51,
      "duration_seconds": 2.78,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.41,
      "end_seconds": 246.36,
      "duration_seconds": 2.95,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.52,
      "end_seconds": 250.66,
      "duration_seconds": 3.14,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.8,
      "end_seconds": 255.39,
      "duration_seconds": 3.59,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.52,
      "end_seconds": 269.48,
      "duration_seconds": 2.96,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 279.64,
      "duration_seconds": 2.59,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.84,
      "end_seconds": 301.07,
      "duration_seconds": 10.23,
      "text": "Okay: respiratory rate 16, heart rate 85, SpO2 97 percent on room air, temp 36.5 degrees, blood pressure 126 over 74."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.95,
      "end_seconds": 306.6,
      "duration_seconds": 3.65,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.32,
      "end_seconds": 309.58,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.35,
      "end_seconds": 324.19,
      "duration_seconds": 4.84,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.9,
      "end_seconds": 337.65,
      "duration_seconds": 10.75,
      "text": "Thank you, you can get dressed. Having listened and examined, my working impression is possible adult attention deficit disorder. Thyroid problems is also on my list."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.43,
      "end_seconds": 339.83,
      "duration_seconds": 1.4,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.17,
      "end_seconds": 360.55,
      "duration_seconds": 19.38,
      "text": "It's reasonable to be concerned, but right now possible adult attention deficit disorder is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had difficulty concentrating, and no low mood or thoughts of self-harm."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.22,
      "end_seconds": 362.99,
      "duration_seconds": 1.77,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.56,
      "end_seconds": 373.7,
      "duration_seconds": 9.14,
      "text": "We should do a thyroid test for poor concentration. A questionnaire is what I'd like next, for attention problems."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.16,
      "end_seconds": 377.28,
      "duration_seconds": 2.12,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.82,
      "end_seconds": 385.08,
      "duration_seconds": 6.26,
      "text": "Use lists and reminders while we arrange the specialist assessment. Book a review after the assessment."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.84,
      "end_seconds": 389.52,
      "duration_seconds": 2.68,
      "text": "Oh, I can manage that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.1,
      "end_seconds": 393.51,
      "duration_seconds": 2.41,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.87,
      "end_seconds": 398.69,
      "duration_seconds": 3.82,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.94,
      "end_seconds": 401.24,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}