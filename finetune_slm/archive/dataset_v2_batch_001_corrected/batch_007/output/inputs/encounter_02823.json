{
  "schema_version": "1.0",
  "encounter_id": "02823",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 8.35,
      "duration_seconds": 7.05,
      "text": "Let me think, you know, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.58,
      "end_seconds": 13.92,
      "duration_seconds": 4.34,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.37,
      "end_seconds": 23.14,
      "duration_seconds": 7.77,
      "text": "Uh, uh, doctor, it's difficulty concentrating. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.29,
      "end_seconds": 26.61,
      "duration_seconds": 2.32,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.07,
      "end_seconds": 33.56,
      "duration_seconds": 5.49,
      "text": "Furosemide. I take it 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 38.75,
      "duration_seconds": 3.9,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.8,
      "end_seconds": 51.21,
      "duration_seconds": 10.41,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.03,
      "end_seconds": 56.07,
      "duration_seconds": 4.04,
      "text": "So, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.6,
      "end_seconds": 67.59,
      "duration_seconds": 10.99,
      "text": "I mean, I'd give it a eight, out of ten. I mean, um, and I've been losing things as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.62,
      "end_seconds": 75.88,
      "duration_seconds": 6.26,
      "text": "So, have you had difficulty concentrating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.0,
      "end_seconds": 82.33,
      "duration_seconds": 5.33,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.16,
      "end_seconds": 88.82,
      "duration_seconds": 3.66,
      "text": "Did you get head injury or low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.85,
      "end_seconds": 94.63,
      "duration_seconds": 4.78,
      "text": "So, no, no head injury or low mood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.48,
      "end_seconds": 99.98,
      "duration_seconds": 4.5,
      "text": "A few quick ones: drug use or thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 105.82,
      "duration_seconds": 4.53,
      "text": "No, no drug use or thoughts of self-harm."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.65,
      "end_seconds": 113.33,
      "duration_seconds": 3.68,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.72,
      "end_seconds": 117.61,
      "duration_seconds": 2.89,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.08,
      "end_seconds": 123.6,
      "duration_seconds": 4.52,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.63,
      "end_seconds": 127.51,
      "duration_seconds": 2.88,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.29,
      "end_seconds": 144.39,
      "duration_seconds": 4.1,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.0,
      "end_seconds": 155.84,
      "duration_seconds": 10.84,
      "text": "I do a yoga class on Thursdays. My partner and our baby. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.05,
      "end_seconds": 160.37,
      "duration_seconds": 3.32,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.06,
      "end_seconds": 168.65,
      "duration_seconds": 6.59,
      "text": "Erm, I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.29,
      "end_seconds": 190.24,
      "duration_seconds": 3.95,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.29,
      "end_seconds": 196.73,
      "duration_seconds": 4.44,
      "text": "I've had heart failure for about a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.66,
      "end_seconds": 209.18,
      "duration_seconds": 10.52,
      "text": "Yes, heart failure is known to us, good to have that clear. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.85,
      "end_seconds": 214.04,
      "duration_seconds": 3.19,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.6,
      "end_seconds": 217.83,
      "duration_seconds": 3.23,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.48,
      "end_seconds": 230.62,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.8,
      "end_seconds": 251.16,
      "duration_seconds": 7.36,
      "text": "Okay: pulse 76, SpO2 97 percent on room air, temperature 36.6, BP is 128 over 69."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.58,
      "end_seconds": 254.1,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.39,
      "end_seconds": 262.91,
      "duration_seconds": 3.52,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.08,
      "end_seconds": 268.32,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.27,
      "end_seconds": 272.07,
      "duration_seconds": 1.8,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.44,
      "end_seconds": 285.47,
      "duration_seconds": 5.03,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.16,
      "end_seconds": 292.02,
      "duration_seconds": 1.86,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.27,
      "end_seconds": 315.51,
      "duration_seconds": 7.24,
      "text": "Just to be sure I understood. You've had difficulty concentrating, and no thoughts of self-harm or head injury."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.85,
      "end_seconds": 321.76,
      "duration_seconds": 2.91,
      "text": "Yes, uh, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.71,
      "end_seconds": 327.4,
      "duration_seconds": 4.69,
      "text": "I think a questionnaire makes sense here, for attention problems."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.36,
      "end_seconds": 331.6,
      "duration_seconds": 2.24,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.11,
      "end_seconds": 354.87,
      "duration_seconds": 22.76,
      "text": "I'm sending you for a thyroid test because of poor concentration. Use lists and reminders while we arrange the specialist assessment. Let's get you seen by the adult ADHD service, I'll arrange the letter. Let's review you after the assessment. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.06,
      "end_seconds": 362.18,
      "duration_seconds": 6.12,
      "text": "So, uh, I come back after the assessment. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.68,
      "end_seconds": 367.52,
      "duration_seconds": 3.84,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.57,
      "end_seconds": 370.65,
      "duration_seconds": 2.08,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.73,
      "end_seconds": 372.97,
      "duration_seconds": 1.24,
      "text": "Goodbye for now."
    }
  ]
