{
  "schema_version": "1.0",
  "encounter_id": "02987",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.2,
      "duration_seconds": 2.97,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.48,
      "duration_seconds": 4.48,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.49,
      "end_seconds": 26.47,
      "duration_seconds": 14.98,
      "text": "Well, I've been having bright red blood on the paper. I just want to get back to normal, really. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.44,
      "end_seconds": 30.74,
      "duration_seconds": 3.3,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.07,
      "end_seconds": 35.81,
      "duration_seconds": 3.74,
      "text": "Mirtazapine. I take it 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.5,
      "end_seconds": 41.18,
      "duration_seconds": 3.68,
      "text": "So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.54,
      "end_seconds": 46.04,
      "duration_seconds": 3.5,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.6,
      "end_seconds": 52.93,
      "duration_seconds": 5.33,
      "text": "What about a lump around the back passage, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.09,
      "end_seconds": 67.76,
      "duration_seconds": 13.67,
      "text": "Yes, for about two weeks. And, And there's itching as well, about a week now. As for itching, honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.83,
      "end_seconds": 72.69,
      "duration_seconds": 3.86,
      "text": "Any tummy pain or black stools at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.14,
      "end_seconds": 77.03,
      "duration_seconds": 2.89,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.25,
      "end_seconds": 82.36,
      "duration_seconds": 5.11,
      "text": "I follow. Did you get change in bowel habit or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.26,
      "end_seconds": 90.33,
      "duration_seconds": 7.07,
      "text": "Let me think, I haven't had change in bowel habit or weight loss, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.24,
      "end_seconds": 96.46,
      "duration_seconds": 5.22,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.04,
      "end_seconds": 100.12,
      "duration_seconds": 2.08,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.17,
      "end_seconds": 104.78,
      "duration_seconds": 3.61,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.29,
      "end_seconds": 107.42,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.94,
      "end_seconds": 118.45,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.25,
      "end_seconds": 123.29,
      "duration_seconds": 3.04,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.55,
      "end_seconds": 138.69,
      "duration_seconds": 3.14,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.4,
      "end_seconds": 143.41,
      "duration_seconds": 2.01,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.16,
      "end_seconds": 147.15,
      "duration_seconds": 2.99,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.16,
      "end_seconds": 150.24,
      "duration_seconds": 2.08,
      "text": "Depression, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.1,
      "end_seconds": 164.25,
      "duration_seconds": 12.15,
      "text": "Mm-hmm. Right, so depression is already on your record. We'll keep that in mind today. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.77,
      "end_seconds": 177.79,
      "duration_seconds": 12.02,
      "text": "I'm a hairdresser, on my feet all day. I walk the dog every morning. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.59,
      "end_seconds": 194.97,
      "duration_seconds": 7.38,
      "text": "Let me ask about allergies, anything at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.45,
      "end_seconds": 199.86,
      "duration_seconds": 3.41,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.24,
      "end_seconds": 205.18,
      "duration_seconds": 3.94,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.94,
      "end_seconds": 221.39,
      "duration_seconds": 2.45,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.59,
      "end_seconds": 243.6,
      "duration_seconds": 7.01,
      "text": "Okay: pulse 79, BP is 118 over 79. And temp 36.8 degrees, saturation 97 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.3,
      "end_seconds": 245.8,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.7,
      "end_seconds": 248.94,
      "duration_seconds": 2.24,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.7,
      "end_seconds": 254.24,
      "duration_seconds": 3.54,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.37,
      "end_seconds": 259.33,
      "duration_seconds": 0.96,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.87,
      "end_seconds": 263.61,
      "duration_seconds": 2.74,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.11,
      "end_seconds": 289.6,
      "duration_seconds": 8.49,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.03,
      "end_seconds": 292.09,
      "duration_seconds": 1.06,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.79,
      "end_seconds": 305.71,
      "duration_seconds": 9.92,
      "text": "That's the examination finished. Taking everything into account, I can't pin this down yet. We're looking at haemorrhoids or an anal fissure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.25,
      "end_seconds": 309.38,
      "duration_seconds": 2.13,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.42,
      "end_seconds": 340.28,
      "duration_seconds": 28.86,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a blood count is back. We should do a blood count for rectal bleeding. I'm prescribing a haemorrhoid cream, 1 application, twice a day, one week. It's for haemorrhoids. Eat more fibre and drink water. Let's plan a check in four weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.36,
      "end_seconds": 347.31,
      "duration_seconds": 4.95,
      "text": "Um, okay, that makes sense. Thanks for explaining."
    }
  ]
}