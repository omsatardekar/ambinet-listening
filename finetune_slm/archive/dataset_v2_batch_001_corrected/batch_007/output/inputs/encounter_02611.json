{
  "schema_version": "1.0",
  "encounter_id": "02611",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 3.97,
      "duration_seconds": 2.97,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.55,
      "end_seconds": 9.58,
      "duration_seconds": 4.03,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.44,
      "end_seconds": 15.37,
      "duration_seconds": 4.93,
      "text": "I've been dealing with stiff aching shoulders and hips."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.14,
      "end_seconds": 22.42,
      "duration_seconds": 6.28,
      "text": "How long has this been bothering you? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.6,
      "end_seconds": 32.57,
      "duration_seconds": 8.97,
      "text": "Since this morning, that's when it began. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.07,
      "end_seconds": 42.74,
      "duration_seconds": 9.67,
      "text": "Yes. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.89,
      "end_seconds": 52.61,
      "duration_seconds": 8.72,
      "text": "Only moving about, and it's not much. Severe, I'd say. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.36,
      "end_seconds": 68.24,
      "duration_seconds": 6.88,
      "text": "Let me check a few things. Any jaw pain on chewing, headache or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.48,
      "end_seconds": 75.47,
      "duration_seconds": 5.99,
      "text": "I haven't had jaw pain on chewing, headache or weight loss, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.06,
      "end_seconds": 78.52,
      "duration_seconds": 2.46,
      "text": "Mm-hmm. Nothing like visual changes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.1,
      "end_seconds": 80.91,
      "duration_seconds": 1.81,
      "text": "Definitely no visual changes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.94,
      "end_seconds": 86.05,
      "duration_seconds": 3.11,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.93,
      "end_seconds": 88.84,
      "duration_seconds": 1.91,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 91.82,
      "duration_seconds": 2.42,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.0,
      "end_seconds": 95.8,
      "duration_seconds": 2.8,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.77,
      "end_seconds": 100.98,
      "duration_seconds": 3.21,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.95,
      "end_seconds": 104.58,
      "duration_seconds": 2.63,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.21,
      "end_seconds": 124.95,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.62,
      "end_seconds": 127.35,
      "duration_seconds": 1.73,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.12,
      "end_seconds": 132.69,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.57,
      "end_seconds": 138.02,
      "duration_seconds": 3.45,
      "text": "I have COPD, for nearly five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.34,
      "end_seconds": 142.03,
      "duration_seconds": 2.69,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.65,
      "end_seconds": 144.76,
      "duration_seconds": 2.11,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.21,
      "end_seconds": 163.62,
      "duration_seconds": 1.41,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.58,
      "end_seconds": 170.29,
      "duration_seconds": 5.71,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.41,
      "end_seconds": 173.04,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.94,
      "end_seconds": 177.54,
      "duration_seconds": 2.6,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.3,
      "end_seconds": 181.39,
      "duration_seconds": 2.09,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.33,
      "end_seconds": 186.55,
      "duration_seconds": 4.22,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.43,
      "end_seconds": 190.79,
      "duration_seconds": 3.36,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.6,
      "end_seconds": 201.57,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.25,
      "end_seconds": 226.09,
      "duration_seconds": 12.84,
      "text": "Okay: SpO2 98 percent on room air, height 153 centimetres, BMI works out to 27.3. And BP is 125 over 69, weight 64 kilos, heart rate 72."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.44,
      "end_seconds": 232.3,
      "duration_seconds": 4.86,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.21,
      "end_seconds": 234.52,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.97,
      "end_seconds": 258.84,
      "duration_seconds": 7.87,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.13,
      "end_seconds": 266.0,
      "duration_seconds": 1.87,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.99,
      "end_seconds": 281.88,
      "duration_seconds": 3.89,
      "text": "Having listened and examined, I'd lean towards polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.74,
      "end_seconds": 285.83,
      "duration_seconds": 2.09,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.57,
      "end_seconds": 302.53,
      "duration_seconds": 14.96,
      "text": "I understand the worry. At the moment I'd say it's polymyalgia rheumatica, and we'll watch how it goes. Today I'm not changing anything. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.75,
      "end_seconds": 306.83,
      "duration_seconds": 3.08,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.29,
      "end_seconds": 309.46,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}