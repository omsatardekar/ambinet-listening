{
  "schema_version": "1.0",
  "encounter_id": "02898",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.08,
      "end_seconds": 4.28,
      "duration_seconds": 3.2,
      "text": "Okay, good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.92,
      "end_seconds": 8.01,
      "duration_seconds": 1.09,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.87,
      "end_seconds": 11.15,
      "duration_seconds": 1.28,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.93,
      "end_seconds": 25.23,
      "duration_seconds": 13.3,
      "text": "Mainly weakness climbing up my legs. There's a couple of other things, but that's the main one. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.18,
      "end_seconds": 28.08,
      "duration_seconds": 1.9,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.49,
      "end_seconds": 35.16,
      "duration_seconds": 3.67,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.7,
      "end_seconds": 39.28,
      "duration_seconds": 2.58,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.01,
      "end_seconds": 51.57,
      "duration_seconds": 10.56,
      "text": "it usually comes with tingling in my feet okay, so with tingling in my feet, it feels mild to me"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.1,
      "end_seconds": 64.01,
      "duration_seconds": 2.91,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 73.92,
      "duration_seconds": 2.51,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.38,
      "end_seconds": 91.9,
      "duration_seconds": 8.52,
      "text": "okay: pressure 110 over 77, pulse is 68 beats a minute, temperature is 36.8 degrees and saturation 99 percent"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.45,
      "end_seconds": 97.9,
      "duration_seconds": 1.45,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.78,
      "end_seconds": 102.48,
      "duration_seconds": 2.7,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.34,
      "end_seconds": 110.82,
      "duration_seconds": 5.48,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.18,
      "end_seconds": 113.6,
      "duration_seconds": 1.42,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.51,
      "end_seconds": 116.71,
      "duration_seconds": 2.2,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.54,
      "end_seconds": 136.19,
      "duration_seconds": 5.65,
      "text": "your ankle reflexes are absent and the strength in both legs is reduced"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.9,
      "end_seconds": 142.42,
      "duration_seconds": 2.52,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.2,
      "end_seconds": 164.58,
      "duration_seconds": 4.38,
      "text": "have you had any bladder problems, back pain or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.19,
      "end_seconds": 170.97,
      "duration_seconds": 4.78,
      "text": "actually, no, no bladder problems, back pain or fever"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.66,
      "end_seconds": 175.46,
      "duration_seconds": 3.8,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.22,
      "end_seconds": 179.52,
      "duration_seconds": 2.3,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.03,
      "end_seconds": 182.49,
      "duration_seconds": 2.46,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.7,
      "end_seconds": 185.25,
      "duration_seconds": 1.55,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.99,
      "end_seconds": 204.37,
      "duration_seconds": 2.38,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.92,
      "end_seconds": 209.68,
      "duration_seconds": 4.76,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.45,
      "end_seconds": 215.02,
      "duration_seconds": 4.57,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.88,
      "end_seconds": 218.68,
      "duration_seconds": 2.8,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.48,
      "end_seconds": 221.72,
      "duration_seconds": 2.24,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.99,
      "end_seconds": 225.33,
      "duration_seconds": 2.34,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.09,
      "end_seconds": 230.46,
      "duration_seconds": 3.37,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.1,
      "end_seconds": 236.23,
      "duration_seconds": 4.13,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.47,
      "end_seconds": 252.75,
      "duration_seconds": 5.28,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.07,
      "end_seconds": 264.24,
      "duration_seconds": 10.17,
      "text": "yes, amoxicillin. I've no idea what the reaction was, only that that I'm not supposed to have it"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.09,
      "end_seconds": 268.29,
      "duration_seconds": 2.2,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.27,
      "end_seconds": 273.04,
      "duration_seconds": 3.77,
      "text": "Actually, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.68,
      "end_seconds": 280.78,
      "duration_seconds": 6.1,
      "text": "Putting it all together, I think we're dealing with possible Guillain-Barre syndrome at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.42,
      "end_seconds": 285.73,
      "duration_seconds": 4.31,
      "text": "I mean, is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.52,
      "end_seconds": 308.16,
      "duration_seconds": 21.64,
      "text": "I understand the worry. At the moment I'd say it's possible Guillain-Barre syndrome, and we'll know more once the a lumbar puncture is back. I think a lumbar puncture makes sense here, for possible GBS. You must be admitted today for monitoring of your breathing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.4,
      "end_seconds": 315.54,
      "duration_seconds": 7.14,
      "text": "Mm, okay. Let's get you seen by the neurology team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.58,
      "end_seconds": 322.66,
      "duration_seconds": 4.08,
      "text": "Let me think, sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.3,
      "end_seconds": 335.3,
      "duration_seconds": 12.0,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.07,
      "end_seconds": 339.11,
      "duration_seconds": 2.04,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.87,
      "end_seconds": 342.73,
      "duration_seconds": 1.86,
      "text": "have a good day"
    }
  ]
}