{
  "schema_version": "1.0",
  "encounter_id": "02891",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 4.74,
      "duration_seconds": 3.41,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.91,
      "duration_seconds": 4.56,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 16.2,
      "duration_seconds": 4.15,
      "text": "Well, I've been having breathlessness building over weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.67,
      "end_seconds": 22.04,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.01,
      "end_seconds": 25.85,
      "duration_seconds": 1.84,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.66,
      "end_seconds": 32.24,
      "duration_seconds": 5.58,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.83,
      "end_seconds": 36.27,
      "duration_seconds": 3.44,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.51,
      "end_seconds": 40.09,
      "duration_seconds": 2.58,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.26,
      "end_seconds": 50.51,
      "duration_seconds": 9.25,
      "text": "A dry cough goes along with it, most of the time. The dry cough? That's been for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.62,
      "end_seconds": 53.6,
      "duration_seconds": 1.98,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.56,
      "end_seconds": 59.44,
      "duration_seconds": 3.88,
      "text": "it's a couple of times a week"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.92,
      "end_seconds": 74.28,
      "duration_seconds": 3.36,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.88,
      "end_seconds": 79.88,
      "duration_seconds": 4.0,
      "text": "Yes, trimethoprim, it gives me a rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.17,
      "end_seconds": 83.19,
      "duration_seconds": 2.02,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.24,
      "end_seconds": 88.23,
      "duration_seconds": 3.99,
      "text": "Yes, heart disease. Heart failure, for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.14,
      "end_seconds": 98.64,
      "duration_seconds": 9.5,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.47,
      "end_seconds": 104.3,
      "duration_seconds": 3.83,
      "text": "I had a varicose vein procedure last year"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.64,
      "end_seconds": 109.24,
      "duration_seconds": 3.6,
      "text": "right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.41,
      "end_seconds": 114.84,
      "duration_seconds": 4.43,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.34,
      "end_seconds": 117.87,
      "duration_seconds": 2.53,
      "text": "so, do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.95,
      "end_seconds": 122.26,
      "duration_seconds": 2.31,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.48,
      "end_seconds": 125.45,
      "duration_seconds": 1.97,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 132.95,
      "duration_seconds": 5.56,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.17,
      "end_seconds": 137.52,
      "duration_seconds": 3.35,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.25,
      "end_seconds": 150.98,
      "duration_seconds": 11.73,
      "text": "Metoprolol. I take it 50 milligrams, twice a day for my heart. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.54,
      "end_seconds": 156.26,
      "duration_seconds": 4.72,
      "text": "Okay, go on. Any fever, coughing up blood or night sweats?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.48,
      "end_seconds": 162.96,
      "duration_seconds": 2.48,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.09,
      "end_seconds": 166.74,
      "duration_seconds": 2.65,
      "text": "Have you had any leg swelling?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.98,
      "end_seconds": 171.93,
      "duration_seconds": 3.95,
      "text": "not that I've noticed, no leg swelling"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.28,
      "end_seconds": 175.53,
      "duration_seconds": 3.25,
      "text": "I follow any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.91,
      "end_seconds": 177.91,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.76,
      "end_seconds": 185.54,
      "duration_seconds": 2.78,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.98,
      "end_seconds": 188.78,
      "duration_seconds": 1.8,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.83,
      "end_seconds": 209.29,
      "duration_seconds": 2.46,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.24,
      "end_seconds": 224.64,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 250.62,
      "duration_seconds": 9.02,
      "text": "Okay: heart rate 102, respiratory rate 20. And temperature 36.9, oxygen saturation is 94 percent, pressure 134 over 82."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 255.13,
      "duration_seconds": 2.14,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.72,
      "end_seconds": 269.12,
      "duration_seconds": 1.4,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.72,
      "end_seconds": 271.96,
      "duration_seconds": 1.24,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.1,
      "end_seconds": 294.37,
      "duration_seconds": 5.27,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.18,
      "end_seconds": 333.12,
      "duration_seconds": 33.94,
      "text": "Thank you, you can get dressed. So where does that leave us? It points towards a pleural effusion needing a cause. I want to be honest that this is an impression, not a final answer. We shouldn't forget a tumour. Let's book a chest X-ray to look into breathlessness. I want a CT scan of the chest done, that's for pleural effusion. I am arranging an urgent chest clinic review."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.77,
      "end_seconds": 364.21,
      "duration_seconds": 30.44,
      "text": "Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. The chest clinic would be the right next step, I'll refer you. If it hasn't settled in two weeks, we'd think about a pleural fluid sample, but not now. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again after the scan. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.39,
      "end_seconds": 369.65,
      "duration_seconds": 4.26,
      "text": "no, uh, that's all thanks a lot"
    }
  ]
}