{
  "schema_version": "1.0",
  "encounter_id": "02825",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 7.24,
      "duration_seconds": 5.97,
      "text": "Hello, come in. Mind the step. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.88,
      "end_seconds": 14.87,
      "duration_seconds": 6.99,
      "text": "It's weakness climbing up my legs. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.41,
      "end_seconds": 17.81,
      "duration_seconds": 2.4,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.72,
      "end_seconds": 38.97,
      "duration_seconds": 19.25,
      "text": "it's been going on for two weeks i've had a recent stomach bug too, for four weeks as for recent stomach bug, it's severe, honestly i've also had difficulty walking about difficulty walking, I'd say mild"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.41,
      "end_seconds": 45.48,
      "duration_seconds": 2.07,
      "text": "tell me your medicines please"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.63,
      "end_seconds": 64.07,
      "duration_seconds": 17.44,
      "text": "Spironolactone 25 milligrams once a day it's sumatriptan 50 milligrams when needed for my migraines it's a relief to finally sit down and talk about it i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.34,
      "end_seconds": 85.73,
      "duration_seconds": 4.39,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.77,
      "end_seconds": 94.84,
      "duration_seconds": 8.07,
      "text": "Heart failure for about ten years i've had migraines yes i've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.62,
      "end_seconds": 99.79,
      "duration_seconds": 3.17,
      "text": "right, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.86,
      "end_seconds": 104.59,
      "duration_seconds": 3.73,
      "text": "just a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.17,
      "end_seconds": 107.27,
      "duration_seconds": 2.1,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.81,
      "end_seconds": 112.08,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.61,
      "end_seconds": 118.01,
      "duration_seconds": 1.4,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.9,
      "end_seconds": 122.61,
      "duration_seconds": 3.71,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.29,
      "end_seconds": 126.92,
      "duration_seconds": 2.63,
      "text": "so, tell me about your eating"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.38,
      "end_seconds": 134.02,
      "duration_seconds": 5.64,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 149.38,
      "duration_seconds": 2.51,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.27,
      "end_seconds": 155.95,
      "duration_seconds": 4.68,
      "text": "Kiwi. I come out in... well an itchy mouth."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.9,
      "end_seconds": 161.61,
      "duration_seconds": 3.71,
      "text": "Have you noticed back pain, fever or bladder problems?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.14,
      "end_seconds": 166.01,
      "duration_seconds": 2.87,
      "text": "no, I'd have said so so"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.16,
      "end_seconds": 169.98,
      "duration_seconds": 2.82,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.25,
      "end_seconds": 173.16,
      "duration_seconds": 1.91,
      "text": "nothing like that that"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.46,
      "end_seconds": 177.29,
      "duration_seconds": 2.83,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.72,
      "end_seconds": 185.42,
      "duration_seconds": 2.7,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 187.13,
      "end_seconds": 195.65,
      "duration_seconds": 8.52,
      "text": "here are the the numbers doctor. Temp 36.6 degrees heart rate 78. SpO2 98 percent on room air pressure 111 over 70."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.06,
      "end_seconds": 198.0,
      "duration_seconds": 0.94,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.35,
      "end_seconds": 203.7,
      "duration_seconds": 4.35,
      "text": "let me look at the the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.7,
      "end_seconds": 205.88,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.99,
      "end_seconds": 223.55,
      "duration_seconds": 5.56,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.22,
      "end_seconds": 229.52,
      "duration_seconds": 2.3,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.27,
      "end_seconds": 258.88,
      "duration_seconds": 13.61,
      "text": "let me tell you where I've got to i think we're dealing with possible Guillain-Barre syndrome at this stage it could also be a spinal cord problem so we'll keep that open"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.42,
      "end_seconds": 262.42,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.0,
      "end_seconds": 294.8,
      "duration_seconds": 30.8,
      "text": "nothing I've seen today points to an emergency it looks like possible Guillain-Barre syndrome but I'd like to confirm we should do an urgent admission for ascending weakness you must be admitted today for monitoring of your breathing i'd like you to see the neurology team as well and I'll write the referral keep an eye out and if the symptoms get worse call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.33,
      "end_seconds": 299.89,
      "duration_seconds": 3.56,
      "text": "I know what to to watch for"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.58,
      "end_seconds": 308.77,
      "duration_seconds": 7.19,
      "text": "I'll want another look straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.7,
      "end_seconds": 314.34,
      "duration_seconds": 4.64,
      "text": "okay, that that makes sense. Thanks for explaining"
    }
  ]
}