{
  "schema_version": "1.0",
  "encounter_id": "02952",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 4.35,
      "duration_seconds": 3.07,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.94,
      "end_seconds": 9.75,
      "duration_seconds": 4.81,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.47,
      "end_seconds": 14.28,
      "duration_seconds": 2.81,
      "text": "It's a sudden high fever, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.29,
      "end_seconds": 18.16,
      "duration_seconds": 2.87,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.56,
      "end_seconds": 21.41,
      "duration_seconds": 1.85,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.27,
      "end_seconds": 24.29,
      "duration_seconds": 2.02,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.81,
      "end_seconds": 34.83,
      "duration_seconds": 10.02,
      "text": "I'd say a couple of times a week. Oh, and vomiting and diarrhoea. That's been about the same, about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.8,
      "end_seconds": 42.79,
      "duration_seconds": 5.99,
      "text": "Tell me your medicines, please. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.87,
      "end_seconds": 47.27,
      "duration_seconds": 2.4,
      "text": "It's a tampon, in use."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.96,
      "end_seconds": 51.94,
      "duration_seconds": 2.98,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.93,
      "end_seconds": 56.17,
      "duration_seconds": 2.24,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.82,
      "end_seconds": 61.12,
      "duration_seconds": 3.3,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.85,
      "end_seconds": 67.11,
      "duration_seconds": 5.26,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.48,
      "end_seconds": 71.99,
      "duration_seconds": 3.51,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.21,
      "end_seconds": 76.67,
      "duration_seconds": 3.46,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.78,
      "end_seconds": 88.21,
      "duration_seconds": 3.43,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.74,
      "end_seconds": 101.88,
      "duration_seconds": 12.14,
      "text": "I look after my grandchildren most days. My husband and I live above the shop. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.99,
      "end_seconds": 119.35,
      "duration_seconds": 4.36,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.51,
      "end_seconds": 128.09,
      "duration_seconds": 3.58,
      "text": "Yes, trimethoprim, it gives me itching."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.13,
      "end_seconds": 143.68,
      "duration_seconds": 4.55,
      "text": "Let me check a few things. Any cough or stiff neck?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.68,
      "end_seconds": 147.17,
      "duration_seconds": 2.49,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.8,
      "end_seconds": 150.78,
      "duration_seconds": 1.98,
      "text": "Right, any sore throat?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.06,
      "end_seconds": 154.2,
      "duration_seconds": 2.14,
      "text": "Nope, no sore throat."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.01,
      "end_seconds": 162.17,
      "duration_seconds": 2.16,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.0,
      "end_seconds": 165.71,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.32,
      "end_seconds": 184.62,
      "duration_seconds": 3.3,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.67,
      "end_seconds": 198.74,
      "duration_seconds": 3.07,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.92,
      "end_seconds": 230.13,
      "duration_seconds": 11.21,
      "text": "Okay: oxygen saturation is 96 percent, temp 36.8 degrees, respiratory rate 16. And heart rate 107, BP is 96 over 66."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.79,
      "end_seconds": 232.19,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.71,
      "end_seconds": 235.76,
      "duration_seconds": 2.05,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.29,
      "end_seconds": 241.56,
      "duration_seconds": 4.27,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.16,
      "end_seconds": 244.68,
      "duration_seconds": 1.52,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.75,
      "end_seconds": 247.0,
      "duration_seconds": 1.25,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.68,
      "end_seconds": 271.45,
      "duration_seconds": 9.77,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.07,
      "end_seconds": 283.54,
      "duration_seconds": 6.47,
      "text": "Please sit back down. Taking everything into account, I'd lean towards possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.05,
      "end_seconds": 288.25,
      "duration_seconds": 3.2,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.42,
      "end_seconds": 311.11,
      "duration_seconds": 21.69,
      "text": "I understand the worry. At the moment I'd say it's possible toxic shock syndrome, and we'll know more once the a vaginal swab is back. I'm sending you for a vaginal swab because of possible toxic shock. I'm sending you for blood cultures because of possible toxic shock."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.17,
      "end_seconds": 313.37,
      "duration_seconds": 1.2,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.41,
      "end_seconds": 328.49,
      "duration_seconds": 14.08,
      "text": "I'd like you to take flucloxacillin, 2 grams, now, single dose. That's for possible toxic shock syndrome. Remove any tampon, you are going to hospital now. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.44,
      "end_seconds": 333.4,
      "duration_seconds": 3.96,
      "text": "Um, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.98,
      "end_seconds": 341.62,
      "duration_seconds": 3.64,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.93,
      "end_seconds": 346.48,
      "duration_seconds": 3.55,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.38,
      "end_seconds": 349.72,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}