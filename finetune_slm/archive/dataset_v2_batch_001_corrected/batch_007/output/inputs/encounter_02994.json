{
  "schema_version": "1.0",
  "encounter_id": "02994",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.79,
      "duration_seconds": 3.41,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.78,
      "end_seconds": 10.59,
      "duration_seconds": 4.81,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.12,
      "end_seconds": 25.78,
      "duration_seconds": 14.66,
      "text": "Well, uh, I've been having tiredness. I wasn't sure whether to come in at all, to be honest. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.91,
      "end_seconds": 30.72,
      "duration_seconds": 3.81,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.34,
      "end_seconds": 38.24,
      "duration_seconds": 5.9,
      "text": "About four days, I think... sorry, three days, I got that wrong"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.0,
      "end_seconds": 42.05,
      "duration_seconds": 3.05,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 51.2,
      "duration_seconds": 2.93,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.57,
      "end_seconds": 74.23,
      "duration_seconds": 11.66,
      "text": "okay: pressure 117 over 75, BMI works out to 25.2, height 176 centimetres, heart rate 67, weight 78 kilos, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.84,
      "end_seconds": 78.3,
      "duration_seconds": 2.46,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.49,
      "end_seconds": 81.73,
      "duration_seconds": 2.24,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.17,
      "end_seconds": 103.73,
      "duration_seconds": 6.56,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.7,
      "end_seconds": 123.09,
      "duration_seconds": 1.39,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.83,
      "end_seconds": 131.73,
      "duration_seconds": 4.9,
      "text": "that's all I needed to check how about stiff neck?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.24,
      "end_seconds": 134.2,
      "duration_seconds": 1.96,
      "text": "No, no stiff neck."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.92,
      "end_seconds": 139.37,
      "duration_seconds": 3.45,
      "text": "Any facial weakness, joint swelling or palpitations?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.99,
      "end_seconds": 144.64,
      "duration_seconds": 3.65,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.61,
      "end_seconds": 152.52,
      "duration_seconds": 1.91,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.31,
      "end_seconds": 154.94,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.3,
      "end_seconds": 159.84,
      "duration_seconds": 3.54,
      "text": "Which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.08,
      "end_seconds": 166.72,
      "duration_seconds": 5.64,
      "text": "Well, you know, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.23,
      "end_seconds": 171.33,
      "duration_seconds": 3.1,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.16,
      "end_seconds": 178.07,
      "duration_seconds": 4.91,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.66,
      "end_seconds": 181.39,
      "duration_seconds": 1.73,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.48,
      "end_seconds": 185.19,
      "duration_seconds": 2.71,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.87,
      "end_seconds": 205.65,
      "duration_seconds": 2.78,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.34,
      "end_seconds": 208.3,
      "duration_seconds": 1.96,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.5,
      "end_seconds": 216.65,
      "duration_seconds": 5.15,
      "text": "Okay, I can see an irregular heartbeat in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.77,
      "end_seconds": 240.79,
      "duration_seconds": 12.02,
      "text": "So where does that leave us? It fits best with early Lyme disease. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.87,
      "end_seconds": 246.64,
      "duration_seconds": 3.77,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.1,
      "end_seconds": 255.77,
      "duration_seconds": 7.67,
      "text": "I understand the worry. At the moment I'd say it's early Lyme disease, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.19,
      "end_seconds": 279.39,
      "duration_seconds": 12.2,
      "text": "Let's use doxycycline, 100 milligrams, twice a day, twenty-one days. It's for early Lyme disease. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.16,
      "end_seconds": 285.86,
      "duration_seconds": 4.7,
      "text": "Hmm, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.68,
      "end_seconds": 307.08,
      "duration_seconds": 20.4,
      "text": "Take the the doxycycline with food and avoid strong sun. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review in three weeks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.43,
      "end_seconds": 312.16,
      "duration_seconds": 3.73,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.71,
      "end_seconds": 316.52,
      "duration_seconds": 3.81,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.52,
      "end_seconds": 320.62,
      "duration_seconds": 2.1,
      "text": "Alright, thanks, take care."
    }
  ]
}