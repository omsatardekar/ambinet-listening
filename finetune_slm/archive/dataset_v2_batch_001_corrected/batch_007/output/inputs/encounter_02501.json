{
  "schema_version": "1.0",
  "encounter_id": "02501",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 8.85,
      "duration_seconds": 8.09,
      "text": "Doctor, uh, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.46,
      "end_seconds": 14.14,
      "duration_seconds": 3.68,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.29,
      "end_seconds": 22.63,
      "duration_seconds": 7.34,
      "text": "Um, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.79,
      "end_seconds": 30.82,
      "duration_seconds": 7.03,
      "text": "It's a rolled ankle. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.84,
      "end_seconds": 34.47,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.12,
      "end_seconds": 54.41,
      "duration_seconds": 18.29,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety. Febuxostat. I take it 80 milligrams, once a day for the gout. It's, It's rosuvastatin, 10 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.23,
      "end_seconds": 58.45,
      "duration_seconds": 3.22,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.43,
      "end_seconds": 76.78,
      "duration_seconds": 16.35,
      "text": "Let me think, not with me. I'll bring it next time. It's ibuprofen gel, three times a day. I'm hoping you can tell me something definite. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.05,
      "end_seconds": 81.58,
      "duration_seconds": 3.53,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.58,
      "end_seconds": 88.42,
      "duration_seconds": 4.84,
      "text": "I'd say about a month, uh, maybe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 88.95,
      "end_seconds": 94.79,
      "duration_seconds": 5.84,
      "text": "It was closer to about two months, uh, doctor."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 100.67,
      "duration_seconds": 4.65,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.14,
      "end_seconds": 104.54,
      "duration_seconds": 2.4,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.38,
      "end_seconds": 107.01,
      "duration_seconds": 1.63,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.54,
      "end_seconds": 111.93,
      "duration_seconds": 3.39,
      "text": "Ice and rest helps a bit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 116.04,
      "duration_seconds": 2.57,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.02,
      "end_seconds": 125.46,
      "duration_seconds": 8.44,
      "text": "I mean, it usually comes with some swelling. I've also had bruising, for two months."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.72,
      "end_seconds": 146.15,
      "duration_seconds": 4.43,
      "text": "Have you noticed pain in the shin or pop?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.22,
      "end_seconds": 150.76,
      "duration_seconds": 2.54,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.4,
      "end_seconds": 156.84,
      "duration_seconds": 4.44,
      "text": "A few quick ones: numbness or pain in the foot?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.72,
      "end_seconds": 161.65,
      "duration_seconds": 3.93,
      "text": "I mean, nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.96,
      "end_seconds": 165.66,
      "duration_seconds": 3.7,
      "text": "Ah. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.43,
      "end_seconds": 170.73,
      "duration_seconds": 3.3,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.4,
      "end_seconds": 175.84,
      "duration_seconds": 3.44,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.58,
      "end_seconds": 179.19,
      "duration_seconds": 1.61,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.66,
      "end_seconds": 192.37,
      "duration_seconds": 3.71,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.9,
      "end_seconds": 201.77,
      "duration_seconds": 7.87,
      "text": "I have anxiety, for nearly five years. Yes, gout. I've got high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.12,
      "end_seconds": 212.2,
      "duration_seconds": 9.08,
      "text": "Ah. Alright, anxiety and gout, that matches what I have here. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.15,
      "end_seconds": 217.42,
      "duration_seconds": 4.27,
      "text": "No, you know, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.9,
      "end_seconds": 222.61,
      "duration_seconds": 3.71,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.3,
      "end_seconds": 226.76,
      "duration_seconds": 3.46,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.62,
      "end_seconds": 229.45,
      "duration_seconds": 1.83,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.84,
      "end_seconds": 235.17,
      "duration_seconds": 4.33,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.88,
      "end_seconds": 238.29,
      "duration_seconds": 1.41,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.33,
      "end_seconds": 243.41,
      "duration_seconds": 4.08,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.22,
      "end_seconds": 262.77,
      "duration_seconds": 3.55,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.45,
      "end_seconds": 277.19,
      "duration_seconds": 2.74,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.36,
      "end_seconds": 302.69,
      "duration_seconds": 5.33,
      "text": "Okay: respiratory rate 14, pressure 115 over 74, heart rate 66."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.02,
      "end_seconds": 306.7,
      "duration_seconds": 2.68,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.02,
      "end_seconds": 311.47,
      "duration_seconds": 3.45,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.15,
      "end_seconds": 327.97,
      "duration_seconds": 7.82,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.63,
      "end_seconds": 353.87,
      "duration_seconds": 22.24,
      "text": "You can sit up now. So where does that leave us? I think we're dealing with a mild ankle sprain at this stage. Rest, ice, compression and elevation, then gradual strengthening. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.23,
      "end_seconds": 359.67,
      "duration_seconds": 4.44,
      "text": "Okay, um, I'll look out for that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.61,
      "end_seconds": 368.47,
      "duration_seconds": 7.86,
      "text": "I'd like you back if not better in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.96,
      "end_seconds": 373.04,
      "duration_seconds": 3.08,
      "text": "Actually, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.22,
      "end_seconds": 376.01,
      "duration_seconds": 1.79,
      "text": "Okay, look after yourself."
    }
  ]
}