{
  "schema_version": "1.0",
  "encounter_id": "02595",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 6.76,
      "duration_seconds": 5.85,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.15,
      "end_seconds": 13.48,
      "duration_seconds": 5.33,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.44,
      "end_seconds": 17.48,
      "duration_seconds": 3.04,
      "text": "I've been dealing with difficulty concentrating."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.74,
      "end_seconds": 22.04,
      "duration_seconds": 3.3,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.57,
      "end_seconds": 28.71,
      "duration_seconds": 6.14,
      "text": "Around about a week... no wait, it's more like four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.87,
      "end_seconds": 33.05,
      "duration_seconds": 3.18,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.26,
      "end_seconds": 49.81,
      "duration_seconds": 15.55,
      "text": "I'd give it a three, out of ten. And I've been losing things as well, for one week. There's restlessness as well. With restlessness, severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.37,
      "end_seconds": 56.94,
      "duration_seconds": 5.57,
      "text": "Have you noticed drug use, head injury, low mood or thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.48,
      "end_seconds": 64.16,
      "duration_seconds": 6.68,
      "text": "No drug use, head injury, low mood or thoughts of self-harm, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.52,
      "end_seconds": 71.48,
      "duration_seconds": 2.96,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.09,
      "end_seconds": 73.81,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.87,
      "end_seconds": 79.23,
      "duration_seconds": 3.36,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.06,
      "end_seconds": 83.34,
      "duration_seconds": 2.28,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.9,
      "end_seconds": 89.35,
      "duration_seconds": 4.45,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.82,
      "end_seconds": 95.2,
      "duration_seconds": 4.38,
      "text": "I'm allergic to naproxen, I get stomach pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.56,
      "end_seconds": 99.9,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.63,
      "end_seconds": 102.74,
      "duration_seconds": 1.11,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.61,
      "end_seconds": 123.83,
      "duration_seconds": 2.22,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.74,
      "end_seconds": 127.15,
      "duration_seconds": 2.41,
      "text": "I'm on Thyronorm, every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.16,
      "end_seconds": 130.15,
      "duration_seconds": 1.99,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.96,
      "end_seconds": 136.07,
      "duration_seconds": 5.11,
      "text": "50 micrograms, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.87,
      "end_seconds": 143.34,
      "duration_seconds": 5.47,
      "text": "So, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.07,
      "end_seconds": 158.9,
      "duration_seconds": 13.83,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. I'm a hairdresser, on my feet all day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 160.85,
      "end_seconds": 169.31,
      "duration_seconds": 8.46,
      "text": "Okay, so the vitals from earlier. Pulse 81, pressure 116 over 78, respiratory rate 17, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.85,
      "end_seconds": 171.78,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.4,
      "end_seconds": 175.36,
      "duration_seconds": 1.96,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.19,
      "end_seconds": 192.66,
      "duration_seconds": 1.47,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.66,
      "end_seconds": 197.31,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.01,
      "end_seconds": 211.61,
      "duration_seconds": 5.6,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.13,
      "end_seconds": 213.61,
      "duration_seconds": 1.48,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.13,
      "end_seconds": 233.03,
      "duration_seconds": 16.9,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, this looks most like possible adult attention deficit disorder. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.25,
      "end_seconds": 235.7,
      "duration_seconds": 1.45,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.45,
      "end_seconds": 264.29,
      "duration_seconds": 22.84,
      "text": "I understand the worry. At the moment I'd say it's possible adult attention deficit disorder, and we'll know more once the a thyroid test is back. Stop me if I've got anything wrong. You've had difficulty concentrating for four weeks, and no head injury or low mood."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.99,
      "end_seconds": 267.5,
      "duration_seconds": 1.51,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 286.71,
      "duration_seconds": 8.78,
      "text": "I want a thyroid test done, that's for poor concentration. Use lists and reminders while we arrange the specialist assessment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.46,
      "end_seconds": 293.82,
      "duration_seconds": 3.36,
      "text": "Can you send me for a questionnaire?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.66,
      "end_seconds": 305.1,
      "duration_seconds": 9.44,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Let's review you after the assessment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.43,
      "end_seconds": 308.69,
      "duration_seconds": 2.26,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.88,
      "end_seconds": 312.35,
      "duration_seconds": 2.47,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.87,
      "end_seconds": 315.03,
      "duration_seconds": 2.16,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}