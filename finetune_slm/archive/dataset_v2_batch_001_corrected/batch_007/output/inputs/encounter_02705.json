      "role": "DOCTOR",
      "start_seconds": 11.29,
      "end_seconds": 13.17,
      "duration_seconds": 1.88,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.72,
      "end_seconds": 19.09,
      "duration_seconds": 5.37,
      "text": "it's severe tummy pain out of proportion to the examination mostly"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.7,
      "end_seconds": 22.29,
      "duration_seconds": 1.59,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.08,
      "end_seconds": 28.26,
      "duration_seconds": 5.18,
      "text": "I'd say two weeks. Actually, no, closer to to three weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.17,
      "end_seconds": 32.18,
      "duration_seconds": 3.01,
      "text": "how strong would you say it is?"
