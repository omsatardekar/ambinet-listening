{
  "schema_version": "1.0",
  "encounter_id": "02780",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.73,
      "duration_seconds": 4.05,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 11.63,
      "duration_seconds": 5.31,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.97,
      "end_seconds": 25.23,
      "duration_seconds": 8.26,
      "text": "Doctor, it's vomiting. It's getting on my nerves now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 31.41,
      "duration_seconds": 4.16,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.27,
      "end_seconds": 39.01,
      "duration_seconds": 6.74,
      "text": "Uh, around one week... no wait, it's more like four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.42,
      "end_seconds": 45.75,
      "duration_seconds": 5.33,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.6,
      "end_seconds": 61.96,
      "duration_seconds": 14.36,
      "text": "I'd say on and off. Maybe a three out of ten on a bad day. I've also had severe tummy pain out of proportion to the examination."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.8,
      "end_seconds": 79.49,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.47,
      "end_seconds": 83.69,
      "duration_seconds": 2.22,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.71,
      "end_seconds": 99.0,
      "duration_seconds": 10.29,
      "text": "yes, an irregular heartbeat is known to us, good to have that clear has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.82,
      "end_seconds": 104.28,
      "duration_seconds": 3.46,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.95,
      "end_seconds": 109.18,
      "duration_seconds": 3.23,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.78,
      "end_seconds": 115.85,
      "duration_seconds": 5.07,
      "text": "Warfarin. I take it in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.2,
      "end_seconds": 119.21,
      "duration_seconds": 2.01,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 125.66,
      "duration_seconds": 5.67,
      "text": "3 milligrams. I'm on a blood thinner, 5 milligrams, stopped last month."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.68,
      "end_seconds": 128.9,
      "duration_seconds": 2.22,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.23,
      "end_seconds": 134.09,
      "duration_seconds": 3.86,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.44,
      "end_seconds": 136.92,
      "duration_seconds": 1.48,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.81,
      "end_seconds": 143.26,
      "duration_seconds": 4.45,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.62,
      "end_seconds": 155.77,
      "duration_seconds": 2.15,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.71,
      "end_seconds": 164.34,
      "duration_seconds": 7.63,
      "text": "Yes, uh, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.52,
      "end_seconds": 169.29,
      "duration_seconds": 3.77,
      "text": "Any hernia, fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.22,
      "end_seconds": 173.73,
      "duration_seconds": 2.51,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.75,
      "end_seconds": 178.68,
      "duration_seconds": 3.93,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.26,
      "end_seconds": 180.33,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.6,
      "end_seconds": 184.51,
      "duration_seconds": 2.91,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.91,
      "end_seconds": 187.36,
      "duration_seconds": 1.45,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.34,
      "end_seconds": 192.71,
      "duration_seconds": 3.37,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.55,
      "end_seconds": 206.21,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.5,
      "end_seconds": 231.58,
      "duration_seconds": 7.08,
      "text": "Okay: pulse 123, temperature 37.1, BP is 126 over 84, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.08,
      "end_seconds": 234.66,
      "duration_seconds": 1.58,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.57,
      "end_seconds": 239.22,
      "duration_seconds": 2.65,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.1,
      "end_seconds": 243.51,
      "duration_seconds": 2.41,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.1,
      "end_seconds": 255.05,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.14,
      "end_seconds": 257.97,
      "duration_seconds": 1.83,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.42,
      "end_seconds": 276.95,
      "duration_seconds": 9.53,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.32,
      "end_seconds": 288.8,
      "duration_seconds": 8.48,
      "text": "So, good, you can sit up again. Having listened and examined, it points towards possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.14,
      "end_seconds": 326.31,
      "duration_seconds": 22.17,
      "text": "Let's get urgent blood tests, for severe abdominal pain. That will help us see what's going on underneath and decide the next step. This is an emergency, you are going to hospital now. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.82,
      "end_seconds": 340.69,
      "duration_seconds": 13.87,
      "text": "Ah. If the symptoms get worse, that's the point to come in urgently. Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.2,
      "end_seconds": 346.38,
      "duration_seconds": 4.18,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}