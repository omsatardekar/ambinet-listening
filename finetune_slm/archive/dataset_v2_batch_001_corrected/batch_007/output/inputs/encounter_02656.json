{
  "schema_version": "1.0",
  "encounter_id": "02656",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 3.42,
      "duration_seconds": 2.81,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.8,
      "end_seconds": 9.27,
      "duration_seconds": 4.47,
      "text": "Okay, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.27,
      "end_seconds": 17.51,
      "duration_seconds": 6.24,
      "text": "it's restlessness. I thought I'd wait, um, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.96,
      "end_seconds": 24.36,
      "duration_seconds": 5.4,
      "text": "Did it come on recently? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.87,
      "end_seconds": 28.95,
      "duration_seconds": 4.08,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.36,
      "end_seconds": 33.83,
      "duration_seconds": 4.47,
      "text": "ah alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.27,
      "end_seconds": 40.89,
      "duration_seconds": 5.62,
      "text": "It's severe, honestly. I've also had impatience, for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.16,
      "end_seconds": 45.01,
      "duration_seconds": 2.85,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.21,
      "end_seconds": 51.35,
      "duration_seconds": 5.14,
      "text": "maybe a seven out of ten on a bad day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.38,
      "end_seconds": 62.78,
      "duration_seconds": 5.4,
      "text": "Did you get low mood, thoughts of self-harm or drug use?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.44,
      "end_seconds": 70.07,
      "duration_seconds": 5.63,
      "text": "I haven't had low mood, thoughts of self-harm or drug use, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.98,
      "end_seconds": 74.69,
      "duration_seconds": 2.71,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.14,
      "end_seconds": 79.39,
      "duration_seconds": 3.25,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.76,
      "end_seconds": 82.96,
      "duration_seconds": 2.2,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.07,
      "end_seconds": 87.37,
      "duration_seconds": 3.3,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 90.53,
      "duration_seconds": 1.28,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.86,
      "end_seconds": 95.98,
      "duration_seconds": 4.12,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.25,
      "end_seconds": 100.15,
      "duration_seconds": 2.9,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.14,
      "end_seconds": 102.61,
      "duration_seconds": 1.47,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.14,
      "end_seconds": 123.13,
      "duration_seconds": 3.99,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.06,
      "end_seconds": 128.07,
      "duration_seconds": 4.01,
      "text": "Uh, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 140.18,
      "duration_seconds": 3.31,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.04,
      "end_seconds": 143.56,
      "duration_seconds": 2.52,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.57,
      "end_seconds": 147.44,
      "duration_seconds": 2.87,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.96,
      "end_seconds": 151.48,
      "duration_seconds": 3.52,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.88,
      "end_seconds": 154.99,
      "duration_seconds": 2.11,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.86,
      "end_seconds": 171.5,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.39,
      "end_seconds": 201.34,
      "duration_seconds": 7.95,
      "text": "Okay: temp 37.0 degrees, saturation 99 percent, BP is 124 over 71. And heart rate 65."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.04,
      "end_seconds": 203.42,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.07,
      "end_seconds": 208.32,
      "duration_seconds": 3.25,
      "text": "Right, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.46,
      "end_seconds": 214.37,
      "duration_seconds": 3.91,
      "text": "right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.21,
      "end_seconds": 217.65,
      "duration_seconds": 1.44,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.9,
      "end_seconds": 220.57,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.17,
      "end_seconds": 238.01,
      "duration_seconds": 4.84,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.86,
      "end_seconds": 242.5,
      "duration_seconds": 1.64,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.19,
      "end_seconds": 262.39,
      "duration_seconds": 5.2,
      "text": "Having listened and examined, it it points towards possible adult attention deficit disorder."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.23,
      "end_seconds": 295.1,
      "duration_seconds": 14.87,
      "text": "I'll request a questionnaire, it'll help with attention problems. Use lists and reminders while we arrange the specialist assessment. Let's get you seen by the adult ADHD service, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.04,
      "end_seconds": 297.74,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.51,
      "end_seconds": 311.45,
      "duration_seconds": 12.94,
      "text": "If it hasn't settled next month, we'd think about a thyroid test, but not now. Let's review you after the assessment. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.03,
      "end_seconds": 315.25,
      "duration_seconds": 2.22,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.79,
      "end_seconds": 318.01,
      "duration_seconds": 1.22,
      "text": "All the best."
    }
  ]
}