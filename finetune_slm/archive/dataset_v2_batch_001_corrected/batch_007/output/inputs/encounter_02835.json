{
  "schema_version": "1.0",
  "encounter_id": "02835",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.97,
      "duration_seconds": 3.87,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 11.44,
      "duration_seconds": 5.02,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.87,
      "end_seconds": 20.66,
      "duration_seconds": 7.79,
      "text": "Yeah, um, it's bright red blood on the paper. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.2,
      "end_seconds": 24.55,
      "duration_seconds": 2.35,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.31,
      "end_seconds": 30.28,
      "duration_seconds": 4.97,
      "text": "I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.87,
      "end_seconds": 31.79,
      "duration_seconds": 0.92,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.14,
      "end_seconds": 41.24,
      "duration_seconds": 8.1,
      "text": "I take something called carv... carvedilol, 6.25 milligrams, maybe, twice a day for my heart."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.85,
      "end_seconds": 47.1,
      "duration_seconds": 4.25,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.87,
      "end_seconds": 58.25,
      "duration_seconds": 9.38,
      "text": "Well, not with me. I'll bring it next time. I'd been on furosemide, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.04,
      "end_seconds": 63.52,
      "duration_seconds": 3.48,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.31,
      "end_seconds": 84.73,
      "duration_seconds": 16.42,
      "text": "It's been three days, I'm fairly sure. I've, I've also had a lump around the back passage, since this morning. Oh, you know, there was itching, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.65,
      "end_seconds": 98.15,
      "duration_seconds": 5.5,
      "text": "Alright, any tummy pain, weight loss or change in bowel habit at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.1,
      "end_seconds": 105.66,
      "duration_seconds": 6.56,
      "text": "No tummy pain, weight loss or change in bowel habit, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.93,
      "end_seconds": 109.08,
      "duration_seconds": 3.15,
      "text": "Ah. And black stools, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 112.27,
      "duration_seconds": 1.94,
      "text": "Nope, no black stools."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.31,
      "end_seconds": 115.69,
      "duration_seconds": 2.38,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.63,
      "end_seconds": 117.71,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.55,
      "end_seconds": 124.97,
      "duration_seconds": 4.42,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.59,
      "end_seconds": 132.12,
      "duration_seconds": 3.53,
      "text": "So, yes, naproxen. I get stomach pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.62,
      "end_seconds": 151.8,
      "duration_seconds": 4.18,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.36,
      "end_seconds": 155.87,
      "duration_seconds": 2.51,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.72,
      "end_seconds": 157.53,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.49,
      "end_seconds": 162.0,
      "duration_seconds": 3.51,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.89,
      "end_seconds": 167.1,
      "duration_seconds": 1.21,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.0,
      "end_seconds": 170.71,
      "duration_seconds": 2.71,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.61,
      "end_seconds": 174.77,
      "duration_seconds": 3.16,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.97,
      "end_seconds": 182.81,
      "duration_seconds": 3.84,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.14,
      "end_seconds": 186.25,
      "duration_seconds": 2.11,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.92,
      "end_seconds": 190.73,
      "duration_seconds": 2.81,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.41,
      "end_seconds": 200.38,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.03,
      "end_seconds": 204.58,
      "duration_seconds": 3.55,
      "text": "I have eczema, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.24,
      "end_seconds": 207.18,
      "duration_seconds": 0.94,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.07,
      "end_seconds": 210.73,
      "duration_seconds": 1.66,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.08,
      "end_seconds": 221.57,
      "duration_seconds": 9.49,
      "text": "Yes. Yes, heart failure is known to us, good to have that clear. Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.19,
      "end_seconds": 235.67,
      "duration_seconds": 2.48,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.71,
      "end_seconds": 252.34,
      "duration_seconds": 7.63,
      "text": "Okay: oxygen saturation is 99 percent, heart rate 74, blood pressure 120 over 73, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 254.36,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.71,
      "end_seconds": 258.88,
      "duration_seconds": 3.17,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.2,
      "end_seconds": 263.42,
      "duration_seconds": 2.22,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.77,
      "end_seconds": 267.12,
      "duration_seconds": 2.35,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.75,
      "end_seconds": 289.27,
      "duration_seconds": 7.52,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.27,
      "end_seconds": 305.33,
      "duration_seconds": 13.06,
      "text": "Please sit back down. So, based on the history and the examination, I'd lean towards haemorrhoids. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.51,
      "end_seconds": 310.38,
      "duration_seconds": 3.87,
      "text": "Erm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.59,
      "end_seconds": 327.4,
      "duration_seconds": 15.81,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a blood count is back. I think a blood count makes sense here, for rectal bleeding."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 328.19,
      "end_seconds": 330.49,
      "duration_seconds": 2.3,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.14,
      "end_seconds": 355.62,
      "duration_seconds": 23.48,
      "text": "The treatment will be lactulose, 15 ml, twice a day, four weeks. It's for constipation. It's a commonly used medicine and most people tolerate it well. Eat more fibre and drink water. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.39,
      "end_seconds": 359.23,
      "duration_seconds": 1.84,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.32,
      "end_seconds": 363.01,
      "duration_seconds": 2.69,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.5,
      "end_seconds": 367.92,
      "duration_seconds": 3.42,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}