{
  "schema_version": "1.0",
  "encounter_id": "02645",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 7.59,
      "duration_seconds": 6.66,
      "text": "Hmm, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.52,
      "end_seconds": 15.03,
      "duration_seconds": 5.51,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.64,
      "end_seconds": 29.14,
      "duration_seconds": 13.5,
      "text": "Sorry, what was I saying, honestly, it's severe tummy pain out of proportion to the examination, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.11,
      "end_seconds": 33.34,
      "duration_seconds": 2.23,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.97,
      "end_seconds": 43.73,
      "duration_seconds": 8.76,
      "text": "About... well, two weeks. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.34,
      "end_seconds": 52.33,
      "duration_seconds": 7.99,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.98,
      "end_seconds": 60.03,
      "duration_seconds": 7.05,
      "text": "It happens on and off. A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.98,
      "end_seconds": 64.85,
      "duration_seconds": 2.87,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.84,
      "end_seconds": 72.55,
      "duration_seconds": 5.71,
      "text": "Bloody diarrhoea goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.54,
      "end_seconds": 77.08,
      "duration_seconds": 3.54,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.97,
      "end_seconds": 86.33,
      "duration_seconds": 8.36,
      "text": "Mild, really. Sorry, what was I saying, I've also been feeling very unwell, since last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.23,
      "end_seconds": 96.62,
      "duration_seconds": 8.39,
      "text": "Have you had severe tummy pain out of proportion to the examination before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.45,
      "end_seconds": 105.16,
      "duration_seconds": 7.71,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.43,
      "end_seconds": 115.25,
      "duration_seconds": 5.82,
      "text": "Let me check a few things. Any chest pain, fever or hernia?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.05,
      "end_seconds": 118.59,
      "duration_seconds": 2.54,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.89,
      "end_seconds": 121.39,
      "duration_seconds": 2.5,
      "text": "Yes. Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.68,
      "end_seconds": 124.33,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.93,
      "end_seconds": 129.59,
      "duration_seconds": 3.66,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.95,
      "end_seconds": 144.21,
      "duration_seconds": 13.26,
      "text": "I'm on apixaban, 5 milligrams, twice a day for the heart rhythm. I'm on aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.75,
      "end_seconds": 147.93,
      "duration_seconds": 2.18,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.6,
      "end_seconds": 151.57,
      "duration_seconds": 1.97,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.4,
      "end_seconds": 157.75,
      "duration_seconds": 4.35,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.85,
      "end_seconds": 163.59,
      "duration_seconds": 4.74,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 168.49,
      "duration_seconds": 4.29,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.57,
      "end_seconds": 181.38,
      "duration_seconds": 10.81,
      "text": "I only drink at family occasions. My partner and our baby. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.79,
      "end_seconds": 192.77,
      "duration_seconds": 2.98,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.65,
      "end_seconds": 201.06,
      "duration_seconds": 6.41,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.79,
      "end_seconds": 205.74,
      "duration_seconds": 3.95,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.42,
      "end_seconds": 208.87,
      "duration_seconds": 2.45,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.42,
      "end_seconds": 210.83,
      "duration_seconds": 1.41,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.35,
      "end_seconds": 213.38,
      "duration_seconds": 2.03,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.23,
      "end_seconds": 229.24,
      "duration_seconds": 4.01,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.72,
      "end_seconds": 240.17,
      "duration_seconds": 2.45,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.55,
      "end_seconds": 262.73,
      "duration_seconds": 6.18,
      "text": "Okay: temperature is 36.7 degrees, heart rate 124, BP is 133 over 85."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.27,
      "end_seconds": 267.25,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.12,
      "end_seconds": 272.22,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.01,
      "end_seconds": 291.87,
      "duration_seconds": 9.86,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.16,
      "end_seconds": 298.04,
      "duration_seconds": 2.88,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.99,
      "end_seconds": 337.53,
      "duration_seconds": 26.54,
      "text": "I'd like to arrange an urgent CT angiogram for possible bowel ischaemia. It's a routine test and it'll give us a much clearer picture. I want urgent blood tests done, that's for severe abdominal pain. This is an emergency, you are going to hospital now. I'll also refer you to the surgical team. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.66,
      "end_seconds": 340.92,
      "duration_seconds": 2.26,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.79,
      "end_seconds": 345.47,
      "duration_seconds": 2.68,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.98,
      "end_seconds": 349.92,
      "duration_seconds": 3.94,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}