  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.74,
      "duration_seconds": 3.86,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.39,
      "end_seconds": 9.63,
      "duration_seconds": 4.24,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 17.15,
      "duration_seconds": 5.48,
      "text": "So the thing is, I've got my heart suddenly racing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 21.78,
      "duration_seconds": 3.89,
      "text": "What's the timeline, when did it it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.64,
      "end_seconds": 25.7,
      "duration_seconds": 3.06,
      "text": "it's been about a week now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.6,
      "end_seconds": 29.93,
      "duration_seconds": 3.33,
      "text": "any it stopping just as suddenly as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.69,
      "end_seconds": 48.67,
      "duration_seconds": 14.98,
      "text": "Yeah. Five days, uh, I'd say. I've also been feeling lightheaded during an episode, for three weeks. About feeling lightheaded during an episode, I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.15,
      "end_seconds": 68.78,
      "duration_seconds": 7.63,
      "text": "Alright, have you had any family history of sudden death, fainting, chest pain or breathlessness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.98,
      "end_seconds": 80.48,
      "duration_seconds": 6.5,
      "text": "no, no family history of sudden death, fainting, chest pain or breathlessness"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.25,
      "end_seconds": 84.23,
      "duration_seconds": 1.98,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.89,
      "end_seconds": 87.98,
      "duration_seconds": 2.09,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.62,
      "end_seconds": 91.56,
      "duration_seconds": 1.94,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.52,
      "end_seconds": 96.19,
      "duration_seconds": 3.67,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.1,
      "end_seconds": 99.47,
      "duration_seconds": 2.37,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.52,
      "end_seconds": 103.99,
      "duration_seconds": 3.47,
      "text": "just a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.67,
      "end_seconds": 122.31,
      "duration_seconds": 3.64,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.14,
      "end_seconds": 126.03,
      "duration_seconds": 2.89,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.9,
      "end_seconds": 131.13,
      "duration_seconds": 3.23,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.77,
      "end_seconds": 133.39,
      "duration_seconds": 1.62,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.24,
      "end_seconds": 136.59,
      "duration_seconds": 1.35,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.15,
      "end_seconds": 142.78,
      "duration_seconds": 4.63,
      "text": "I've had thin bones for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.45,
      "end_seconds": 145.42,
      "duration_seconds": 1.97,
      "text": "Right, any other things?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.99,
      "end_seconds": 154.36,
      "duration_seconds": 7.37,
      "text": "Okay, I can see acid reflux in your file as well. Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.95,
      "end_seconds": 159.9,
      "duration_seconds": 3.95,
      "text": "I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.66,
      "end_seconds": 163.01,
      "duration_seconds": 2.35,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.07,
      "end_seconds": 166.19,
      "duration_seconds": 2.12,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.52,
      "end_seconds": 168.57,
      "duration_seconds": 2.05,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.46,
      "end_seconds": 178.84,
      "duration_seconds": 8.38,
      "text": "I'm on alendronate, 70 milligrams, once a week. I used to take pantoprazole, but I stopped it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.42,
      "end_seconds": 189.18,
      "duration_seconds": 5.76,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.33,
      "end_seconds": 207.37,
      "duration_seconds": 17.04,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. No, I share a house with my brother. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.11,
      "end_seconds": 214.48,
      "duration_seconds": 2.37,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.79,
      "end_seconds": 226.69,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.9,
      "end_seconds": 256.06,
      "duration_seconds": 11.16,
      "text": "Okay: SpO2 97 percent on room air, temp 36.4 degrees. And pulse 82, weight 81 kilos, height 153 centimetres, blood pressure 113 over 69."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.32,
      "end_seconds": 258.7,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.94,
      "end_seconds": 263.85,
      "duration_seconds": 3.91,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.86,
      "end_seconds": 268.74,
      "duration_seconds": 3.88,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.23,
      "end_seconds": 272.2,
      "duration_seconds": 1.97,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.76,
      "end_seconds": 287.27,
      "duration_seconds": 3.51,
      "text": "your heart sounds and rhythm are normal today"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.36,
      "end_seconds": 294.14,
      "duration_seconds": 2.78,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.42,
      "end_seconds": 311.47,
      "duration_seconds": 8.05,
      "text": "try blowing hard against a closed mouth and nose when it starts anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.39,
      "end_seconds": 315.62,
      "duration_seconds": 3.23,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.29,
      "end_seconds": 318.75,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
