{
  "schema_version": "1.0",
  "encounter_id": "02684",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 6.14,
      "duration_seconds": 5.61,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.13,
      "end_seconds": 11.03,
      "duration_seconds": 3.9,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.76,
      "end_seconds": 28.22,
      "duration_seconds": 14.46,
      "text": "I wanted to get a chesty cough for a week looked at i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.24,
      "end_seconds": 33.67,
      "duration_seconds": 3.43,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.78,
      "end_seconds": 38.08,
      "duration_seconds": 3.3,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.85,
      "end_seconds": 42.21,
      "duration_seconds": 2.36,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.97,
      "end_seconds": 50.8,
      "duration_seconds": 3.83,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.38,
      "end_seconds": 54.16,
      "duration_seconds": 2.78,
      "text": "has there been slight aching too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.58,
      "end_seconds": 64.42,
      "duration_seconds": 8.84,
      "text": "Yes, um, since Friday. And there's a sore throat earlier as well, two weeks now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.93,
      "end_seconds": 69.75,
      "duration_seconds": 3.82,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.92,
      "end_seconds": 74.13,
      "duration_seconds": 3.21,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 76.48,
      "duration_seconds": 1.75,
      "text": "okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.51,
      "end_seconds": 83.17,
      "duration_seconds": 1.66,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.68,
      "end_seconds": 86.55,
      "duration_seconds": 1.87,
      "text": "so, how about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.96,
      "end_seconds": 92.59,
      "duration_seconds": 3.63,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.52,
      "end_seconds": 98.74,
      "duration_seconds": 2.22,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.51,
      "end_seconds": 104.13,
      "duration_seconds": 4.62,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.16,
      "end_seconds": 110.4,
      "duration_seconds": 1.24,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.01,
      "end_seconds": 116.38,
      "duration_seconds": 4.37,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.84,
      "end_seconds": 120.22,
      "duration_seconds": 2.38,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.08,
      "end_seconds": 126.28,
      "duration_seconds": 4.2,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.17,
      "end_seconds": 141.26,
      "duration_seconds": 3.09,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.15,
      "end_seconds": 144.53,
      "duration_seconds": 1.38,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.62,
      "end_seconds": 155.58,
      "duration_seconds": 8.96,
      "text": "Okay, I can see anxiety in your file as well. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.22,
      "end_seconds": 158.93,
      "duration_seconds": 1.71,
      "text": "Wheat, I'd say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.46,
      "end_seconds": 164.2,
      "duration_seconds": 3.74,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.1,
      "end_seconds": 172.63,
      "duration_seconds": 6.53,
      "text": "uh, it's escitalopram, 10 milligrams, once a day for the anxiety"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.98,
      "end_seconds": 179.3,
      "duration_seconds": 2.32,
      "text": "nothing like coughing up blood?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.89,
      "end_seconds": 182.52,
      "duration_seconds": 2.63,
      "text": "No. No coughing up blood."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 189.33,
      "duration_seconds": 5.62,
      "text": "Let me check a few things. Any fever, breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.28,
      "end_seconds": 196.25,
      "duration_seconds": 4.97,
      "text": "Ah, no fever, breathlessness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 200.17,
      "duration_seconds": 2.35,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.03,
      "end_seconds": 204.25,
      "duration_seconds": 3.22,
      "text": "No, you know, that's all fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.12,
      "end_seconds": 209.42,
      "duration_seconds": 3.3,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.91,
      "end_seconds": 219.15,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.98,
      "end_seconds": 246.37,
      "duration_seconds": 9.39,
      "text": "Okay: temp 36.8 degrees, blood pressure 111 over 80. And SpO2 98 percent on room air, pulse 76, respiratory rate 15."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.28,
      "end_seconds": 252.67,
      "duration_seconds": 4.39,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.58,
      "end_seconds": 256.43,
      "duration_seconds": 2.85,
      "text": "Okay, raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.84,
      "end_seconds": 274.76,
      "duration_seconds": 3.92,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.17,
      "end_seconds": 279.91,
      "duration_seconds": 2.74,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.3,
      "end_seconds": 305.21,
      "duration_seconds": 10.91,
      "text": "right, here's what I'm thinking. This is probably acute viral bronchitis. The reason I say that is that your story and my examination fit together"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.78,
      "end_seconds": 312.01,
      "duration_seconds": 3.23,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.2,
      "end_seconds": 321.61,
      "duration_seconds": 8.41,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.16,
      "end_seconds": 355.16,
      "duration_seconds": 26.0,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Keep an eye out, and if you get a fever or breathlessness, call us the same day or go to emergency. I'll want another look if not better in three weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.31,
      "end_seconds": 359.25,
      "duration_seconds": 2.94,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.82,
      "end_seconds": 361.06,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}