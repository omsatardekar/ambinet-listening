{
  "schema_version": "1.0",
  "encounter_id": "02579",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 6.06,
      "duration_seconds": 5.48,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 12.8,
      "duration_seconds": 5.19,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.8,
      "end_seconds": 23.2,
      "duration_seconds": 9.4,
      "text": "Mainly severe thirst and passing lots of urine. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.15,
      "end_seconds": 26.32,
      "duration_seconds": 1.17,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.16,
      "end_seconds": 34.1,
      "duration_seconds": 6.94,
      "text": "For ten days, I'd say. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 38.78,
      "duration_seconds": 4.19,
      "text": "Mm-hmm. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.57,
      "end_seconds": 46.63,
      "duration_seconds": 6.06,
      "text": "Moderate, really. Oh, and being very confused. Had that since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.21,
      "end_seconds": 51.15,
      "duration_seconds": 2.94,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.22,
      "end_seconds": 60.6,
      "duration_seconds": 8.38,
      "text": "a seven out of ten, I suppose oh, and vomiting that's been about the same, five days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.01,
      "end_seconds": 67.85,
      "duration_seconds": 2.84,
      "text": "Alright, how often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.91,
      "end_seconds": 72.77,
      "duration_seconds": 3.86,
      "text": "it it sort of comes and goes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.42,
      "end_seconds": 85.85,
      "duration_seconds": 8.43,
      "text": "Have you had severe thirst and passing lots of urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.82,
      "end_seconds": 93.8,
      "duration_seconds": 6.98,
      "text": "I had a similar thing a couple of years ago it went away"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.86,
      "end_seconds": 107.81,
      "duration_seconds": 3.95,
      "text": "Alright, and what about fall, fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.37,
      "end_seconds": 112.7,
      "duration_seconds": 4.33,
      "text": "I haven't had fall, fever or chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.57,
      "end_seconds": 117.54,
      "duration_seconds": 2.97,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.56,
      "end_seconds": 120.77,
      "duration_seconds": 2.21,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.34,
      "end_seconds": 124.68,
      "duration_seconds": 3.34,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.37,
      "end_seconds": 127.87,
      "duration_seconds": 1.5,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.41,
      "end_seconds": 133.04,
      "duration_seconds": 4.63,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.81,
      "end_seconds": 135.29,
      "duration_seconds": 1.48,
      "text": "Nickel, I'd say."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.44,
      "end_seconds": 149.3,
      "duration_seconds": 2.86,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.05,
      "end_seconds": 154.08,
      "duration_seconds": 4.03,
      "text": "I've had acid reflux for two years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.73,
      "end_seconds": 162.47,
      "duration_seconds": 6.74,
      "text": "Mm-hmm. Right, so acid reflux is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.52,
      "end_seconds": 182.34,
      "duration_seconds": 1.82,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.97,
      "end_seconds": 189.23,
      "duration_seconds": 3.26,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.27,
      "end_seconds": 192.54,
      "duration_seconds": 1.27,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.23,
      "end_seconds": 197.05,
      "duration_seconds": 2.82,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.68,
      "end_seconds": 200.67,
      "duration_seconds": 2.99,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.16,
      "end_seconds": 210.42,
      "duration_seconds": 5.26,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.45,
      "end_seconds": 214.3,
      "duration_seconds": 1.85,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.45,
      "end_seconds": 218.96,
      "duration_seconds": 3.51,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.67,
      "end_seconds": 222.75,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.87,
      "end_seconds": 227.91,
      "duration_seconds": 4.04,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.48,
      "end_seconds": 231.62,
      "duration_seconds": 3.14,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.89,
      "end_seconds": 235.83,
      "duration_seconds": 2.94,
      "text": "Lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.73,
      "end_seconds": 238.35,
      "duration_seconds": 1.62,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.1,
      "end_seconds": 240.98,
      "duration_seconds": 1.88,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 241.53,
      "end_seconds": 252.1,
      "duration_seconds": 10.57,
      "text": "doctor, I've got the readings for you. Weight 52 kilos, heart rate 108, height 179 centimetres, blood pressure 98 over 56, BMI works out to 16.2."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.87,
      "end_seconds": 255.19,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.56,
      "end_seconds": 260.63,
      "duration_seconds": 3.07,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.63,
      "end_seconds": 265.03,
      "duration_seconds": 2.4,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 290.11,
      "duration_seconds": 6.21,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.69,
      "end_seconds": 306.53,
      "duration_seconds": 10.84,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. I'd lean towards a high calcium emergency. We shouldn't forget a a kidney failure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.46,
      "end_seconds": 310.78,
      "duration_seconds": 2.32,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.34,
      "end_seconds": 325.54,
      "duration_seconds": 14.2,
      "text": "I can't promise yet, but most people with a a high calcium emergency do well once it's treated properly. I'm sending you for urgent blood tests because of confusion and polyuria."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.55,
      "end_seconds": 327.96,
      "duration_seconds": 1.41,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.74,
      "end_seconds": 360.52,
      "duration_seconds": 31.78,
      "text": "let's get an ECG, for hypercalcaemia. I'll start you on sodium chloride 0.9%, 1 litre, over one hour, single dose. That should help with dehydration. You need hospital fluids and treatment now. I'd like you to see the emergency team as well, and I'll write the referral. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Please come and see me straight away"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.33,
      "end_seconds": 364.94,
      "duration_seconds": 2.61,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.45,
      "end_seconds": 367.86,
      "duration_seconds": 2.41,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.74,
      "end_seconds": 370.16,
      "duration_seconds": 1.42,
      "text": "Look after yourself."
    }
  ]
}