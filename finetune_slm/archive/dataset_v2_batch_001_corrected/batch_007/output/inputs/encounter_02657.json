{
  "schema_version": "1.0",
  "encounter_id": "02657",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 3.41,
      "duration_seconds": 2.69,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.66,
      "end_seconds": 5.58,
      "duration_seconds": 0.92,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.41,
      "end_seconds": 10.41,
      "duration_seconds": 3.0,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.17,
      "end_seconds": 15.6,
      "duration_seconds": 4.43,
      "text": "I wanted to get fainting on exertion looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.22,
      "end_seconds": 20.06,
      "duration_seconds": 2.84,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.81,
      "end_seconds": 25.36,
      "duration_seconds": 2.55,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.91,
      "end_seconds": 38.85,
      "duration_seconds": 4.94,
      "text": "Since when exactly? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 43.09,
      "duration_seconds": 2.38,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.91,
      "end_seconds": 54.51,
      "duration_seconds": 9.6,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.93,
      "end_seconds": 64.31,
      "duration_seconds": 8.38,
      "text": "I'd give it a seven, out of ten. It's worse with exertion. It happens every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.27,
      "end_seconds": 69.28,
      "duration_seconds": 3.01,
      "text": "Okay, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.47,
      "end_seconds": 81.71,
      "duration_seconds": 11.24,
      "text": "Being very breathless goes along with it, most of the time. The being very breathless? That's been for four weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.39,
      "end_seconds": 86.24,
      "duration_seconds": 3.85,
      "text": "A few quick ones: fever, cough or leg pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.41,
      "end_seconds": 90.26,
      "duration_seconds": 2.85,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.27,
      "end_seconds": 95.92,
      "duration_seconds": 3.65,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.92,
      "end_seconds": 97.86,
      "duration_seconds": 0.94,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.99,
      "end_seconds": 115.46,
      "duration_seconds": 4.47,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.5,
      "end_seconds": 119.31,
      "duration_seconds": 2.81,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.17,
      "end_seconds": 131.09,
      "duration_seconds": 2.92,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.23,
      "end_seconds": 148.88,
      "duration_seconds": 16.65,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. Lots of rice, lentils and some fruit. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.01,
      "end_seconds": 152.42,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.65,
      "end_seconds": 162.8,
      "duration_seconds": 9.15,
      "text": "Yes, tramadol. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 166.19,
      "duration_seconds": 2.85,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.82,
      "end_seconds": 176.55,
      "duration_seconds": 2.73,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.32,
      "end_seconds": 206.71,
      "duration_seconds": 10.39,
      "text": "Okay: respiratory rate 25, oxygen saturation is 90 percent, blood pressure 124 over 90, pulse is 88 beats a minute, temperature 37.3."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.45,
      "end_seconds": 209.53,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.99,
      "end_seconds": 213.89,
      "duration_seconds": 2.9,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 219.95,
      "duration_seconds": 3.09,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.32,
      "end_seconds": 223.27,
      "duration_seconds": 1.95,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.32,
      "end_seconds": 246.39,
      "duration_seconds": 5.07,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.0,
      "end_seconds": 250.78,
      "duration_seconds": 1.78,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.52,
      "end_seconds": 272.34,
      "duration_seconds": 12.82,
      "text": "Having listened and examined, I don't have a clear answer today: possible pulmonary hypertension is possible, and so is a heart valve problem. I'm sending you for blood tests because of breathlessness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.56,
      "end_seconds": 279.23,
      "duration_seconds": 1.67,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.02,
      "end_seconds": 302.35,
      "duration_seconds": 19.33,
      "text": "No exertion for now, I am arranging urgent specialist tests. We'll refer you to the pulmonary hypertension service. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in one week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.33,
      "end_seconds": 306.37,
      "duration_seconds": 2.04,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.07,
      "end_seconds": 313.56,
      "duration_seconds": 5.49,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.5,
      "end_seconds": 317.5,
      "duration_seconds": 2.0,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.92,
      "end_seconds": 321.0,
      "duration_seconds": 2.08,
      "text": "Okay, have a good day."
    }
  ]
}