{
  "schema_version": "1.0",
  "encounter_id": "02567",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 3.89,
      "duration_seconds": 3.25,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.05,
      "end_seconds": 9.2,
      "duration_seconds": 4.15,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.93,
      "end_seconds": 17.36,
      "duration_seconds": 6.43,
      "text": "Doctor, uh, it's a rolled ankle. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 21.81,
      "duration_seconds": 2.91,
      "text": "Is it it accompanied by anything?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.13,
      "end_seconds": 30.29,
      "duration_seconds": 7.16,
      "text": "actually, it usually comes with bruising. The bruising? That's been for two days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.93,
      "end_seconds": 33.59,
      "duration_seconds": 2.66,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 48.0,
      "duration_seconds": 2.99,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.2,
      "end_seconds": 68.51,
      "duration_seconds": 8.31,
      "text": "Okay: saturation 98 percent, BP is 115 over 72, pulse 64. And temperature is 36.9 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.25,
      "end_seconds": 71.68,
      "duration_seconds": 2.43,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.82,
      "end_seconds": 74.96,
      "duration_seconds": 2.14,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.33,
      "end_seconds": 80.97,
      "duration_seconds": 3.64,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.84,
      "end_seconds": 83.88,
      "duration_seconds": 2.04,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.82,
      "end_seconds": 108.37,
      "duration_seconds": 7.55,
      "text": "there is mild swelling over the outer ankle but no bony tenderness and you can take four steps"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.82,
      "end_seconds": 114.96,
      "duration_seconds": 2.14,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.73,
      "end_seconds": 134.64,
      "duration_seconds": 4.91,
      "text": "Have you had any pop, pain in the foot or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.67,
      "end_seconds": 138.02,
      "duration_seconds": 2.35,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.81,
      "end_seconds": 141.44,
      "duration_seconds": 2.63,
      "text": "how about pain in the shin?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.59,
      "end_seconds": 145.74,
      "duration_seconds": 3.15,
      "text": "Nope, no pain in the shin."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.01,
      "end_seconds": 151.21,
      "duration_seconds": 2.2,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.65,
      "end_seconds": 153.68,
      "duration_seconds": 1.03,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.28,
      "end_seconds": 156.66,
      "duration_seconds": 1.38,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.4,
      "end_seconds": 161.44,
      "duration_seconds": 3.04,
      "text": "Um, no weakness or anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.47,
      "end_seconds": 168.23,
      "duration_seconds": 4.76,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.86,
      "end_seconds": 172.89,
      "duration_seconds": 3.03,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.77,
      "end_seconds": 177.21,
      "duration_seconds": 2.44,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.65,
      "end_seconds": 184.4,
      "duration_seconds": 5.75,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.61,
      "end_seconds": 187.55,
      "duration_seconds": 1.94,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.2,
      "end_seconds": 192.61,
      "duration_seconds": 4.41,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.99,
      "end_seconds": 198.98,
      "duration_seconds": 1.99,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.43,
      "end_seconds": 203.42,
      "duration_seconds": 2.99,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.7,
      "end_seconds": 223.79,
      "duration_seconds": 3.09,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.36,
      "end_seconds": 240.38,
      "duration_seconds": 13.02,
      "text": "I have arthritis in my knees, for nearly five years work has been very busy so I kept ignoring it i've got heart disease"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.86,
      "end_seconds": 257.06,
      "duration_seconds": 4.2,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.09,
      "end_seconds": 265.44,
      "duration_seconds": 6.35,
      "text": "Erm, it's naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.78,
      "end_seconds": 271.69,
      "duration_seconds": 2.91,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.31,
      "end_seconds": 282.13,
      "duration_seconds": 9.82,
      "text": "Nearly five years now. Hmm, I'm on aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.92,
      "end_seconds": 287.24,
      "duration_seconds": 3.32,
      "text": "how long has that that been going on?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.0,
      "end_seconds": 290.55,
      "duration_seconds": 1.55,
      "text": "for six months"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.19,
      "end_seconds": 294.95,
      "duration_seconds": 3.76,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.58,
      "end_seconds": 298.89,
      "duration_seconds": 2.31,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.95,
      "end_seconds": 306.49,
      "duration_seconds": 5.54,
      "text": "Okay, so my impression is this: This is probably a mild ankle sprain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.99,
      "end_seconds": 309.7,
      "duration_seconds": 2.71,
      "text": "right, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.75,
      "end_seconds": 332.07,
      "duration_seconds": 20.32,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild ankle sprain. Rest, ice, compression and elevation, then gradual strengthening. I'd like you back if not better in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.69,
      "end_seconds": 337.51,
      "duration_seconds": 3.82,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.47,
      "end_seconds": 343.75,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}