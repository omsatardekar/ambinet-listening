{
  "schema_version": "1.0",
  "encounter_id": "02972",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.89,
      "duration_seconds": 3.89,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 10.42,
      "duration_seconds": 3.62,
      "text": "yes, have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.92,
      "end_seconds": 17.86,
      "duration_seconds": 3.94,
      "text": "I wanted to get swollen glands looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 21.95,
      "duration_seconds": 3.05,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.46,
      "end_seconds": 27.33,
      "duration_seconds": 1.87,
      "text": "probably three days. Yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.81,
      "end_seconds": 32.53,
      "duration_seconds": 4.72,
      "text": "Hm, okay. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.69,
      "end_seconds": 37.27,
      "duration_seconds": 1.58,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.62,
      "end_seconds": 41.95,
      "duration_seconds": 3.33,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.73,
      "end_seconds": 56.02,
      "duration_seconds": 12.29,
      "text": "when it starts I tend to get a widespread rash with fever as well as for widespread rash with fever, it happens every other day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.12,
      "end_seconds": 63.39,
      "duration_seconds": 6.27,
      "text": "alright have you had swollen glands before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.05,
      "end_seconds": 70.09,
      "duration_seconds": 6.04,
      "text": "a bit about six months ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.62,
      "end_seconds": 74.06,
      "duration_seconds": 2.44,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.46,
      "end_seconds": 86.05,
      "duration_seconds": 10.59,
      "text": "I take lisinopril, 10 milligrams, once a day for my pressure i'm on allopurinol, 300 milligrams, started four weeks ago"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.12,
      "end_seconds": 92.69,
      "duration_seconds": 2.57,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.56,
      "end_seconds": 96.48,
      "duration_seconds": 1.92,
      "text": "About about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 101.72,
      "duration_seconds": 4.3,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.4,
      "end_seconds": 108.41,
      "duration_seconds": 5.01,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.12,
      "end_seconds": 114.38,
      "duration_seconds": 4.26,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.89,
      "end_seconds": 120.45,
      "duration_seconds": 4.56,
      "text": "I'm, I'm allergic to wheat, I get bloating"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.6,
      "end_seconds": 124.16,
      "duration_seconds": 2.56,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.36,
      "end_seconds": 134.03,
      "duration_seconds": 4.67,
      "text": "I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 143.89,
      "duration_seconds": 2.55,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.36,
      "end_seconds": 148.65,
      "duration_seconds": 3.29,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.6,
      "end_seconds": 150.88,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.54,
      "end_seconds": 156.31,
      "duration_seconds": 3.77,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.21,
      "end_seconds": 161.15,
      "duration_seconds": 2.94,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.86,
      "end_seconds": 164.55,
      "duration_seconds": 2.69,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.01,
      "end_seconds": 171.06,
      "duration_seconds": 5.05,
      "text": "Okay, have you had any breathing difficulty, mouth sores or blisters?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.0,
      "end_seconds": 176.27,
      "duration_seconds": 3.27,
      "text": "No none that that I've noticed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.47,
      "end_seconds": 179.63,
      "duration_seconds": 2.16,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.16,
      "end_seconds": 182.23,
      "duration_seconds": 2.07,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.82,
      "end_seconds": 185.03,
      "duration_seconds": 2.21,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.56,
      "end_seconds": 188.0,
      "duration_seconds": 1.44,
      "text": "no nothing there"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.9,
      "end_seconds": 193.82,
      "duration_seconds": 2.92,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.32,
      "end_seconds": 209.98,
      "duration_seconds": 2.66,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.48,
      "end_seconds": 230.12,
      "duration_seconds": 6.64,
      "text": "Okay: pressure 125 over 68, temp 38.9 degrees. And pulse 101, respiratory rate 22."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.08,
      "end_seconds": 235.11,
      "duration_seconds": 2.03,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.68,
      "end_seconds": 243.79,
      "duration_seconds": 1.11,
      "text": "of course"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.81,
      "end_seconds": 246.17,
      "duration_seconds": 1.36,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.38,
      "end_seconds": 262.6,
      "duration_seconds": 7.22,
      "text": "There is a widespread red rash facial swelling and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.47,
      "end_seconds": 269.95,
      "duration_seconds": 2.48,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.12,
      "end_seconds": 290.52,
      "duration_seconds": 9.4,
      "text": "Let me tell you where I've got to. This looks most like a severe drug reaction. We shouldn't forget a viral rash."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.09,
      "end_seconds": 293.87,
      "duration_seconds": 2.78,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.35,
      "end_seconds": 309.08,
      "duration_seconds": 13.73,
      "text": "I understand the worry. At the moment I'd say it's a severe drug reaction, and we'll know more once the urgent blood tests is back. We should do urgent blood tests for severe drug reaction."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 310.52,
      "end_seconds": 314.99,
      "duration_seconds": 4.47,
      "text": "we have a slot Thursday at 3:30 pm, if that works"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.1,
      "end_seconds": 339.97,
      "duration_seconds": 19.87,
      "text": "let's use prednisolone 40 milligrams once a day until review you take it by mouth it's for severe drug reaction stop the allopurinol now and you need admission i'll want another look straight away is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.26,
      "end_seconds": 344.4,
      "duration_seconds": 3.14,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.17,
      "end_seconds": 347.41,
      "duration_seconds": 1.24,
      "text": "see you soon"
    }
  ]
}