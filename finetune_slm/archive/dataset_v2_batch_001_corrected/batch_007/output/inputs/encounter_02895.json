{
  "schema_version": "1.0",
  "encounter_id": "02895",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.2,
      "duration_seconds": 2.82,
      "text": "Good afternoon, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.63,
      "end_seconds": 9.48,
      "duration_seconds": 3.85,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 18.33,
      "duration_seconds": 6.82,
      "text": "Um, so... a growing red ring on my thigh. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.6,
      "end_seconds": 22.93,
      "duration_seconds": 3.33,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.49,
      "end_seconds": 27.58,
      "duration_seconds": 3.09,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.62,
      "end_seconds": 32.45,
      "duration_seconds": 3.83,
      "text": "A A few quick ones: joint swelling or palpitations?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.49,
      "end_seconds": 35.87,
      "duration_seconds": 2.38,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.59,
      "end_seconds": 40.72,
      "duration_seconds": 3.13,
      "text": "any facial weakness or stiff neck at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.3,
      "end_seconds": 47.12,
      "duration_seconds": 4.82,
      "text": "No facial weakness or stiff neck, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.63,
      "end_seconds": 52.23,
      "duration_seconds": 3.6,
      "text": "Alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.69,
      "end_seconds": 55.24,
      "duration_seconds": 1.55,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.05,
      "end_seconds": 69.22,
      "duration_seconds": 4.17,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.07,
      "end_seconds": 76.9,
      "duration_seconds": 6.83,
      "text": "I take naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 81.32,
      "duration_seconds": 3.28,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.22,
      "end_seconds": 86.16,
      "duration_seconds": 3.94,
      "text": "Hmm, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.0,
      "end_seconds": 89.41,
      "duration_seconds": 2.41,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.8,
      "end_seconds": 95.61,
      "duration_seconds": 4.81,
      "text": "I've had arthritis in my knees for five years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.65,
      "end_seconds": 106.77,
      "duration_seconds": 2.12,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.28,
      "end_seconds": 110.85,
      "duration_seconds": 3.57,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.8,
      "end_seconds": 117.06,
      "duration_seconds": 1.26,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.71,
      "end_seconds": 122.51,
      "duration_seconds": 3.8,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.72,
      "end_seconds": 125.73,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.65,
      "end_seconds": 131.54,
      "duration_seconds": 3.89,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.11,
      "end_seconds": 135.07,
      "duration_seconds": 2.96,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 140.01,
      "duration_seconds": 3.63,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.53,
      "end_seconds": 142.67,
      "duration_seconds": 2.14,
      "text": "Okay, have you retired yet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 148.4,
      "duration_seconds": 4.18,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.45,
      "end_seconds": 153.28,
      "duration_seconds": 2.83,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.34,
      "end_seconds": 169.86,
      "duration_seconds": 3.52,
      "text": "Okay, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.23,
      "end_seconds": 197.7,
      "duration_seconds": 7.47,
      "text": "okay: saturation 97 percent, pulse is 83 beats a minute, blood pressure 117 over 72."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.08,
      "end_seconds": 200.47,
      "duration_seconds": 1.39,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.52,
      "end_seconds": 204.19,
      "duration_seconds": 2.67,
      "text": "Alright, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.31,
      "end_seconds": 207.31,
      "duration_seconds": 2.0,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.1,
      "end_seconds": 218.76,
      "duration_seconds": 1.66,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.57,
      "end_seconds": 220.86,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.64,
      "end_seconds": 245.53,
      "duration_seconds": 5.89,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.92,
      "end_seconds": 250.34,
      "duration_seconds": 2.42,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.07,
      "end_seconds": 266.05,
      "duration_seconds": 5.98,
      "text": "Let me tell you where I've got to. It points towards early Lyme disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.14,
      "end_seconds": 271.8,
      "duration_seconds": 4.66,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.06,
      "end_seconds": 306.08,
      "duration_seconds": 33.02,
      "text": "Nothing I've seen today points to an emergency. It looks like early Lyme disease. I'm prescribing doxycycline, 100 milligrams, twice a day, twenty-one days. It's for early Lyme disease. Take the doxycycline with food and avoid strong sun. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.98,
      "end_seconds": 309.21,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.07,
      "end_seconds": 312.29,
      "duration_seconds": 1.22,
      "text": "All the best."
    }
  ]
}