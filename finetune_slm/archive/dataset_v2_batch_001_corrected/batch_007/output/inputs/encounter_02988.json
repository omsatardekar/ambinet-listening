{
  "schema_version": "1.0",
  "encounter_id": "02988",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.16,
      "end_seconds": 3.06,
      "duration_seconds": 1.9,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.27,
      "end_seconds": 5.42,
      "duration_seconds": 1.15,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.79,
      "end_seconds": 12.4,
      "duration_seconds": 2.61,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.01,
      "end_seconds": 19.35,
      "duration_seconds": 5.34,
      "text": "Honestly, it's aching bones, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.57,
      "end_seconds": 22.67,
      "duration_seconds": 2.1,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.7,
      "end_seconds": 27.07,
      "duration_seconds": 2.37,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.16,
      "end_seconds": 31.47,
      "duration_seconds": 3.31,
      "text": "Okay, how often do you get it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.17,
      "end_seconds": 35.03,
      "duration_seconds": 2.86,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.6,
      "end_seconds": 42.26,
      "duration_seconds": 3.66,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.88,
      "end_seconds": 47.4,
      "duration_seconds": 4.52,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.63,
      "end_seconds": 48.33,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.55,
      "end_seconds": 55.17,
      "duration_seconds": 5.62,
      "text": "There's constipation as well. As for constipation, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.7,
      "end_seconds": 60.66,
      "duration_seconds": 3.96,
      "text": "Okay, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.4,
      "end_seconds": 69.52,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.03,
      "end_seconds": 94.35,
      "duration_seconds": 10.32,
      "text": "Okay: height 159 centimetres, weight 57 kilos, pulse is 81 beats a minute, saturation 98 percent, temp 36.5 degrees, pressure 115 over 82."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.67,
      "end_seconds": 97.2,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.41,
      "end_seconds": 102.23,
      "duration_seconds": 3.82,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.53,
      "end_seconds": 118.15,
      "duration_seconds": 2.62,
      "text": "Any fractures or fever at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.79,
      "end_seconds": 122.11,
      "duration_seconds": 3.32,
      "text": "No fractures or fever, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.52,
      "end_seconds": 126.85,
      "duration_seconds": 4.33,
      "text": "Ah. Okay, and what about weight loss or low mood?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.5,
      "end_seconds": 129.72,
      "duration_seconds": 2.22,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.71,
      "end_seconds": 133.97,
      "duration_seconds": 2.26,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.43,
      "end_seconds": 137.53,
      "duration_seconds": 2.1,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.2,
      "end_seconds": 143.45,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.97,
      "end_seconds": 146.08,
      "duration_seconds": 1.11,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.97,
      "end_seconds": 164.37,
      "duration_seconds": 2.4,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.09,
      "end_seconds": 170.01,
      "duration_seconds": 3.92,
      "text": "Telmisartan. I take it once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.52,
      "end_seconds": 172.57,
      "duration_seconds": 2.05,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.66,
      "end_seconds": 174.72,
      "duration_seconds": 1.06,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.77,
      "end_seconds": 183.68,
      "duration_seconds": 7.91,
      "text": "Right, anything in your past medical history I should know? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.46,
      "end_seconds": 187.86,
      "duration_seconds": 3.4,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.14,
      "end_seconds": 196.67,
      "duration_seconds": 3.53,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.94,
      "end_seconds": 201.27,
      "duration_seconds": 3.33,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.27,
      "end_seconds": 207.33,
      "duration_seconds": 4.06,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.04,
      "end_seconds": 222.83,
      "duration_seconds": 13.79,
      "text": "I gave up cigarettes last spring. I only drink at family occasions. I live with my elderly mother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.54,
      "end_seconds": 237.07,
      "duration_seconds": 8.53,
      "text": "Okay, so my impression from what you've said is this: My working impression is possible raised calcium from an overactive parathyroid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.84,
      "end_seconds": 242.11,
      "duration_seconds": 3.27,
      "text": "Right, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.69,
      "end_seconds": 268.08,
      "duration_seconds": 19.39,
      "text": "I can't promise yet, but most people with possible raised calcium from an overactive parathyroid do well once it's treated properly. Let me repeat that back to make sure. You've had aching bones for about a week, and no fever or low mood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.69,
      "end_seconds": 271.25,
      "duration_seconds": 1.56,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.03,
      "end_seconds": 296.11,
      "duration_seconds": 12.08,
      "text": "I'm going to order a kidney ultrasound, for kidney stones. I'll want another look after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.59,
      "end_seconds": 301.22,
      "duration_seconds": 3.63,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}