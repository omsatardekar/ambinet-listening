{
  "schema_version": "1.0",
  "encounter_id": "02710",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.04,
      "end_seconds": 6.31,
      "duration_seconds": 5.27,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 11.62,
      "duration_seconds": 4.28,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.58,
      "end_seconds": 16.55,
      "duration_seconds": 3.97,
      "text": "It's a widespread rash with fever, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 17.88,
      "end_seconds": 31.75,
      "duration_seconds": 13.87,
      "text": "Here are the numbers, doctor. SpO2 96 percent on room air, height 156 centimetres, weight 64 kilos, pulse 90, BMI works out to 26.3, BP is 106 over 75, temperature 38.4."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 33.89,
      "duration_seconds": 1.06,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.83,
      "end_seconds": 45.75,
      "duration_seconds": 2.92,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.47,
      "end_seconds": 50.02,
      "duration_seconds": 3.55,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.41,
      "end_seconds": 53.78,
      "duration_seconds": 2.37,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.3,
      "end_seconds": 55.35,
      "duration_seconds": 1.05,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.99,
      "end_seconds": 60.52,
      "duration_seconds": 4.53,
      "text": "What about a recent new medicine, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.51,
      "end_seconds": 68.22,
      "duration_seconds": 6.71,
      "text": "Yes, actually. With recent new medicine, about a five out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.85,
      "end_seconds": 74.65,
      "duration_seconds": 4.8,
      "text": "A few quick ones: blisters, breathing difficulty or mouth sores?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.61,
      "end_seconds": 83.67,
      "duration_seconds": 4.06,
      "text": "No, no blisters, breathing difficulty or mouth sores."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.6,
      "end_seconds": 87.91,
      "duration_seconds": 2.31,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.74,
      "end_seconds": 94.41,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.23,
      "end_seconds": 100.33,
      "duration_seconds": 4.1,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.42,
      "end_seconds": 103.54,
      "duration_seconds": 2.12,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.27,
      "end_seconds": 109.13,
      "duration_seconds": 3.86,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.73,
      "end_seconds": 116.61,
      "duration_seconds": 2.88,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.84,
      "end_seconds": 137.77,
      "duration_seconds": 3.93,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.92,
      "end_seconds": 141.08,
      "duration_seconds": 2.16,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.42,
      "end_seconds": 146.48,
      "duration_seconds": 4.06,
      "text": "Okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.33,
      "end_seconds": 149.89,
      "duration_seconds": 2.56,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.24,
      "end_seconds": 164.04,
      "duration_seconds": 1.8,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.14,
      "end_seconds": 171.28,
      "duration_seconds": 6.14,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.32,
      "end_seconds": 175.42,
      "duration_seconds": 2.1,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.75,
      "end_seconds": 180.4,
      "duration_seconds": 3.65,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.94,
      "end_seconds": 183.73,
      "duration_seconds": 2.79,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.66,
      "end_seconds": 187.89,
      "duration_seconds": 3.23,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.15,
      "end_seconds": 192.97,
      "duration_seconds": 3.82,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.77,
      "end_seconds": 199.66,
      "duration_seconds": 4.89,
      "text": "I take omeprazole, once a day for the reflux."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.43,
      "end_seconds": 202.56,
      "duration_seconds": 2.13,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.39,
      "end_seconds": 207.52,
      "duration_seconds": 1.13,
      "text": "20 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.2,
      "end_seconds": 213.57,
      "duration_seconds": 2.37,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.67,
      "end_seconds": 219.14,
      "duration_seconds": 3.47,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.1,
      "end_seconds": 225.34,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.17,
      "end_seconds": 228.27,
      "duration_seconds": 1.1,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.14,
      "end_seconds": 232.23,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.8,
      "end_seconds": 254.25,
      "duration_seconds": 6.45,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.29,
      "end_seconds": 270.33,
      "duration_seconds": 11.04,
      "text": "Please sit back down. Let me tell you where I've got to. This looks most like a severe drug reaction. Another possibility is a viral rash."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.06,
      "end_seconds": 273.64,
      "duration_seconds": 1.58,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.53,
      "end_seconds": 287.88,
      "duration_seconds": 12.35,
      "text": "I can't promise yet, but most people with a severe drug reaction do well once it's treated properly. Let's book urgent blood tests to look into severe drug reaction."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.58,
      "end_seconds": 289.83,
      "duration_seconds": 1.25,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.81,
      "end_seconds": 308.3,
      "duration_seconds": 17.49,
      "text": "What I'm giving you is prednisolone, 40 milligrams, once a day, until review. That should help with severe drug reaction. Stop the allopurinol now and you need admission. Let's review you straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.32,
      "end_seconds": 311.29,
      "duration_seconds": 1.97,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.16,
      "end_seconds": 314.96,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}