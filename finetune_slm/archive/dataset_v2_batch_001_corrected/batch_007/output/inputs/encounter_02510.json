  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.62,
      "duration_seconds": 3.11,
      "text": "hello, doctor may I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.54,
      "end_seconds": 8.73,
      "duration_seconds": 4.19,
      "text": "of course, leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.47,
      "end_seconds": 15.36,
      "duration_seconds": 4.89,
      "text": "Mainly I've been passing kidney stones. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.14,
      "end_seconds": 20.59,
      "duration_seconds": 3.45,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.53,
      "end_seconds": 24.92,
      "duration_seconds": 2.39,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.71,
      "end_seconds": 30.56,
      "duration_seconds": 3.85,
      "text": "right is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.14,
      "end_seconds": 33.56,
      "duration_seconds": 1.42,
      "text": "Severe I'd say"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.83,
      "end_seconds": 40.2,
      "duration_seconds": 2.37,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.34,
      "end_seconds": 51.34,
      "duration_seconds": 10.0,
      "text": "when it starts I tend to get being thirsty as well the being thirsty? That's been for six months"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.2,
      "end_seconds": 56.32,
      "duration_seconds": 4.12,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.23,
      "end_seconds": 58.77,
      "duration_seconds": 1.54,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.49,
      "end_seconds": 63.99,
      "duration_seconds": 4.5,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.37,
      "end_seconds": 69.75,
      "duration_seconds": 4.38,
      "text": "I'm on aspirin 75 milligrams once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.37,
      "end_seconds": 72.14,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 77.74,
      "duration_seconds": 3.55,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.98,
      "end_seconds": 81.33,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.14,
      "end_seconds": 86.44,
      "duration_seconds": 4.3,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 89.77,
      "duration_seconds": 2.78,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.94,
      "end_seconds": 94.26,
      "duration_seconds": 3.32,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.3,
      "end_seconds": 107.74,
      "duration_seconds": 4.44,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.75,
      "end_seconds": 112.33,
      "duration_seconds": 2.58,
      "text": "I've had heart disease, yes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.69,
      "end_seconds": 117.73,
      "duration_seconds": 4.04,
      "text": "yes, carry on have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.2,
      "end_seconds": 126.64,
      "duration_seconds": 3.44,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.96,
      "end_seconds": 131.47,
      "duration_seconds": 3.51,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.03,
      "end_seconds": 134.48,
      "duration_seconds": 2.45,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.25,
      "end_seconds": 137.81,
      "duration_seconds": 1.56,
      "text": "Alright nothing like fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.66,
      "end_seconds": 141.21,
      "duration_seconds": 1.55,
      "text": "No fever thankfully."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.86,
      "end_seconds": 146.34,
      "duration_seconds": 3.48,
      "text": "Did you get low mood or weight loss?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.74,
      "end_seconds": 150.23,
      "duration_seconds": 2.49,
      "text": "no nothing to report there"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.24,
      "end_seconds": 154.5,
      "duration_seconds": 2.26,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.04,
      "end_seconds": 156.87,
      "duration_seconds": 1.83,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 162.28,
      "duration_seconds": 4.25,
      "text": "alright, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.33,
      "end_seconds": 165.86,
      "duration_seconds": 2.53,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.2,
      "end_seconds": 180.63,
      "duration_seconds": 3.43,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.61,
      "end_seconds": 191.17,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.55,
      "end_seconds": 220.18,
      "duration_seconds": 11.63,
      "text": "Okay: temp 36.8 degrees, pulse is 73 beats a minute. And respiratory rate 18, SpO2 98 percent on room air, BP is 126 over 79."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.1,
      "end_seconds": 225.86,
      "duration_seconds": 3.76,
      "text": "let me look at the area I'll be gentle"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.55,
      "end_seconds": 236.16,
      "duration_seconds": 1.61,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.1,
      "end_seconds": 239.47,
      "duration_seconds": 1.37,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.33,
      "end_seconds": 253.31,
      "duration_seconds": 4.98,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.71,
      "end_seconds": 258.54,
      "duration_seconds": 1.83,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 272.29,
      "duration_seconds": 6.53,
      "text": "Okay, thinking it through, it fits best with possible raised calcium from an overactive parathyroid."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.35,
      "end_seconds": 278.12,
      "duration_seconds": 3.77,
      "text": "Is there something to to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.66,
      "end_seconds": 293.06,
      "duration_seconds": 14.4,
      "text": "I can't promise yet but most people with possible raised calcium from an overactive parathyroid do well once it's treated properly let's book a calcium and parathyroid hormone test to look into kidney stones"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.18,
      "end_seconds": 296.49,
      "duration_seconds": 2.31,
      "text": "The earliest is Tuesday, 10 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.7,
      "end_seconds": 300.2,
      "duration_seconds": 2.5,
      "text": "Tuesday that works for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.06,
      "end_seconds": 307.3,
      "duration_seconds": 5.24,
      "text": "Drink plenty of water and avoid calcium supplements until the results."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.71,
      "end_seconds": 328.76,
      "duration_seconds": 21.05,
      "text": "ah try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit come back or go to emergency straight away if the symptoms get worse i'd like to see you again after the results okay, that's all from me any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.91,
      "end_seconds": 333.25,
      "duration_seconds": 3.34,
      "text": "thank you, um, that's helpful"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.2,
      "end_seconds": 337.0,
      "duration_seconds": 1.8,
      "text": "right, take care now"
    }
  ]
