{
  "schema_version": "1.0",
  "encounter_id": "02528",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 5.7,
      "duration_seconds": 4.51,
      "text": "Right then, come on in. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.61,
      "end_seconds": 19.18,
      "duration_seconds": 11.57,
      "text": "yeah, it's a dry cough, mostly it's the not knowing that gets to me i'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 20.42,
      "end_seconds": 30.65,
      "duration_seconds": 10.23,
      "text": "Here are the numbers, doctor. Heart rate 90, oxygen saturation is 92 percent, respiratory rate 23, pressure 128 over 79, temperature is 37.3 degrees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.99,
      "end_seconds": 35.33,
      "duration_seconds": 3.34,
      "text": "thanks how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.15,
      "end_seconds": 41.09,
      "duration_seconds": 3.94,
      "text": "I've, I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.86,
      "end_seconds": 45.47,
      "duration_seconds": 2.61,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.5,
      "end_seconds": 51.56,
      "duration_seconds": 5.06,
      "text": "I'd give it a seven, um, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.22,
      "end_seconds": 55.57,
      "duration_seconds": 2.35,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.14,
      "end_seconds": 93.97,
      "duration_seconds": 37.83,
      "text": "Sorry, what was I saying, when it starts I tend to get weight loss as well. And there's a dull ache on one side of the chest as well, about a month now. Oh, as for dull ache on one side of the chest, it's all the time. And, And there's breathlessness building over weeks as well, five days now. Well, with breathlessness building over weeks, about a six out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.5,
      "end_seconds": 100.37,
      "duration_seconds": 4.87,
      "text": "So, have you had any leg swelling or night sweats?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.17,
      "end_seconds": 106.77,
      "duration_seconds": 4.6,
      "text": "I haven't had leg swelling or night sweats, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.35,
      "end_seconds": 110.86,
      "duration_seconds": 3.51,
      "text": "did you get fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.83,
      "end_seconds": 115.81,
      "duration_seconds": 2.98,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.3,
      "end_seconds": 119.29,
      "duration_seconds": 1.99,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.19,
      "end_seconds": 125.73,
      "duration_seconds": 1.54,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.24,
      "end_seconds": 134.44,
      "duration_seconds": 4.2,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.51,
      "end_seconds": 150.0,
      "duration_seconds": 14.49,
      "text": "I've had acid reflux for nearly five years now. I have epilepsy, for about ten years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.07,
      "end_seconds": 161.5,
      "duration_seconds": 9.43,
      "text": "I follow. Right, so acid reflux and epilepsy are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.75,
      "end_seconds": 178.94,
      "duration_seconds": 3.19,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.97,
      "end_seconds": 187.84,
      "duration_seconds": 3.87,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.39,
      "end_seconds": 209.25,
      "duration_seconds": 3.86,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.67,
      "end_seconds": 213.25,
      "duration_seconds": 2.58,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.52,
      "end_seconds": 216.87,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.72,
      "end_seconds": 230.28,
      "duration_seconds": 11.56,
      "text": "Pantoprazole i take it 40 milligrams, before breakfast for my acidity so, it's lamotrigine, 100 milligrams, twice a day for the fits"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 231.95,
      "end_seconds": 236.41,
      "duration_seconds": 4.46,
      "text": "Doctor, our chart from the last visit lists it as 200 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.73,
      "end_seconds": 241.98,
      "duration_seconds": 4.25,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.08,
      "end_seconds": 246.95,
      "duration_seconds": 3.87,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.82,
      "end_seconds": 251.31,
      "duration_seconds": 3.49,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.84,
      "end_seconds": 262.99,
      "duration_seconds": 11.15,
      "text": "I think I reacted to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.71,
      "end_seconds": 264.55,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.78,
      "end_seconds": 268.05,
      "duration_seconds": 2.27,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.68,
      "end_seconds": 272.25,
      "duration_seconds": 2.57,
      "text": "Okay, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.98,
      "end_seconds": 274.73,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.37,
      "end_seconds": 278.0,
      "duration_seconds": 2.63,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.87,
      "end_seconds": 282.66,
      "duration_seconds": 3.79,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.28,
      "end_seconds": 288.53,
      "duration_seconds": 4.25,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.35,
      "end_seconds": 293.68,
      "duration_seconds": 3.33,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.13,
      "end_seconds": 300.13,
      "duration_seconds": 4.0,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.5,
      "end_seconds": 303.94,
      "duration_seconds": 2.44,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.78,
      "end_seconds": 320.79,
      "duration_seconds": 6.01,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.7,
      "end_seconds": 325.43,
      "duration_seconds": 1.73,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.33,
      "end_seconds": 350.07,
      "duration_seconds": 10.74,
      "text": "putting it all together, I'm honestly not certain yet. It could be a pleural effusion needing a cause, or it might be a tumour"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.67,
      "end_seconds": 353.78,
      "duration_seconds": 3.11,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.29,
      "end_seconds": 385.77,
      "duration_seconds": 31.48,
      "text": "It's reasonable to be concerned, but right now a pleural effusion needing a cause is my leading thought, not anything worse. I'll request a CT scan of the chest, it'll help with pleural effusion. I'll request a pleural fluid sample, it'll help with pleural effusion. I am arranging an urgent chest clinic review. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 387.26,
      "end_seconds": 388.88,
      "duration_seconds": 1.62,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.82,
      "end_seconds": 396.55,
      "duration_seconds": 5.73,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.11,
      "end_seconds": 399.64,
      "duration_seconds": 1.53,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.79,
      "end_seconds": 405.8,
      "duration_seconds": 2.01,
      "text": "Come back after the scan."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.88,
      "end_seconds": 409.94,
      "duration_seconds": 2.06,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.89,
      "end_seconds": 414.41,
      "duration_seconds": 3.52,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 416.23,
      "end_seconds": 420.67,
      "duration_seconds": 4.44,
      "text": "hmm, good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 422.18,
      "end_seconds": 423.35,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}