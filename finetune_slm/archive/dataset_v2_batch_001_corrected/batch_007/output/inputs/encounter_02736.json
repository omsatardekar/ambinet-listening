{
  "schema_version": "1.0",
  "encounter_id": "02736",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 5.29,
      "duration_seconds": 4.04,
      "text": "Actually, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 12.35,
      "duration_seconds": 5.54,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.12,
      "end_seconds": 29.62,
      "duration_seconds": 15.5,
      "text": "It's severe tummy pain out of proportion to the examination. I thought I'd wait, but it hasn't gone. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.56,
      "end_seconds": 34.95,
      "duration_seconds": 3.39,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.39,
      "end_seconds": 38.39,
      "duration_seconds": 2.0,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 45.74,
      "duration_seconds": 5.68,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 48.94,
      "duration_seconds": 1.94,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.67,
      "end_seconds": 52.44,
      "duration_seconds": 2.77,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.31,
      "end_seconds": 56.48,
      "duration_seconds": 3.17,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.07,
      "end_seconds": 62.49,
      "duration_seconds": 2.42,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.24,
      "end_seconds": 71.47,
      "duration_seconds": 8.23,
      "text": "Ah, it usually comes with bloody diarrhoea. The bloody diarrhoea? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.21,
      "end_seconds": 75.5,
      "duration_seconds": 3.29,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.11,
      "end_seconds": 78.79,
      "duration_seconds": 2.68,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.75,
      "end_seconds": 82.68,
      "duration_seconds": 2.93,
      "text": "Did you get fever or hernia?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.75,
      "end_seconds": 86.12,
      "duration_seconds": 2.37,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.27,
      "end_seconds": 94.69,
      "duration_seconds": 2.42,
      "text": "Has there been any chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.83,
      "end_seconds": 97.89,
      "duration_seconds": 2.06,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 101.65,
      "duration_seconds": 2.38,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.6,
      "end_seconds": 105.1,
      "duration_seconds": 1.5,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.82,
      "end_seconds": 109.1,
      "duration_seconds": 3.28,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.89,
      "end_seconds": 119.83,
      "duration_seconds": 8.94,
      "text": "Yes, I had my tonsils removed, as a teenager. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.21,
      "end_seconds": 138.06,
      "duration_seconds": 2.85,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 142.9,
      "duration_seconds": 3.93,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.13,
      "end_seconds": 147.43,
      "duration_seconds": 3.3,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.01,
      "end_seconds": 150.81,
      "duration_seconds": 2.8,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.57,
      "end_seconds": 156.77,
      "duration_seconds": 4.2,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.09,
      "end_seconds": 161.47,
      "duration_seconds": 3.38,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.81,
      "end_seconds": 164.85,
      "duration_seconds": 2.04,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.92,
      "end_seconds": 178.11,
      "duration_seconds": 11.19,
      "text": "Warfarin. I take it 3 milligrams, in the evening. Okay, so I take a blood thinner, 5 milligrams, stopped last month."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.73,
      "end_seconds": 198.41,
      "duration_seconds": 2.68,
      "text": "So, what about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.08,
      "end_seconds": 208.02,
      "duration_seconds": 8.94,
      "text": "I've had an irregular heartbeat for nearly five years now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.64,
      "end_seconds": 214.83,
      "duration_seconds": 5.19,
      "text": "Yes. Alright, an irregular heartbeat, that matches what I have here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 227.96,
      "duration_seconds": 3.11,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.64,
      "end_seconds": 244.17,
      "duration_seconds": 2.53,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.62,
      "end_seconds": 266.43,
      "duration_seconds": 8.81,
      "text": "Okay: blood pressure 117 over 86, temperature is 37.0 degrees. And SpO2 99 percent on room air, pulse 105."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.48,
      "end_seconds": 268.86,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.5,
      "end_seconds": 272.01,
      "duration_seconds": 2.51,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.47,
      "end_seconds": 275.71,
      "duration_seconds": 2.24,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.45,
      "end_seconds": 278.62,
      "duration_seconds": 1.17,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.76,
      "end_seconds": 301.95,
      "duration_seconds": 9.19,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.35,
      "end_seconds": 331.94,
      "duration_seconds": 24.59,
      "text": "Right, thank you, you can get dressed. Okay, so my impression is this: I think we're dealing with possible bowel ischaemia at this stage. We should do an urgent CT angiogram for possible bowel ischaemia. I'd rather check than guess, and this is the quickest way to know more. Urgent blood tests is what I'd like next, for severe abdominal pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.81,
      "end_seconds": 336.96,
      "duration_seconds": 1.15,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.11,
      "end_seconds": 356.3,
      "duration_seconds": 18.19,
      "text": "This is an emergency, you are going to hospital now. I think the surgical team should see you too. Do get help quickly if the symptoms get worse. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.36,
      "end_seconds": 360.46,
      "duration_seconds": 2.1,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.68,
      "end_seconds": 362.9,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}