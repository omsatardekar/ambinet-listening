{
  "schema_version": "1.0",
  "encounter_id": "02572",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.63,
      "duration_seconds": 5.76,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.1,
      "end_seconds": 13.04,
      "duration_seconds": 4.94,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 24.65,
      "duration_seconds": 7.32,
      "text": "Honestly, it's numbness in the foot, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.23,
      "end_seconds": 28.2,
      "duration_seconds": 2.97,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.81,
      "end_seconds": 37.81,
      "duration_seconds": 8.0,
      "text": "It's been like this since yesterday. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.78,
      "end_seconds": 42.65,
      "duration_seconds": 2.87,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.49,
      "end_seconds": 47.15,
      "duration_seconds": 3.66,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.57,
      "end_seconds": 67.68,
      "duration_seconds": 3.11,
      "text": "Have you noticed chest pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.68,
      "end_seconds": 71.22,
      "duration_seconds": 2.54,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.75,
      "end_seconds": 73.64,
      "duration_seconds": 1.89,
      "text": "Nothing like recent injury?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.4,
      "end_seconds": 76.45,
      "duration_seconds": 2.05,
      "text": "No recent injury, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.58,
      "end_seconds": 79.63,
      "duration_seconds": 2.05,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.82,
      "end_seconds": 81.82,
      "duration_seconds": 1.0,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.99,
      "end_seconds": 86.86,
      "duration_seconds": 3.87,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.39,
      "end_seconds": 94.84,
      "duration_seconds": 3.45,
      "text": "Um, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.75,
      "end_seconds": 102.38,
      "duration_seconds": 5.63,
      "text": "What about your medical history? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.1,
      "end_seconds": 106.91,
      "duration_seconds": 2.81,
      "text": "I've got an irregular heartbeat"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.88,
      "end_seconds": 113.53,
      "duration_seconds": 4.65,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.08,
      "end_seconds": 119.19,
      "duration_seconds": 5.11,
      "text": "not currently, but as a youngster trimethoprim gave me itching"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.0,
      "end_seconds": 131.22,
      "duration_seconds": 3.22,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.27,
      "end_seconds": 143.1,
      "duration_seconds": 6.83,
      "text": "Apixaban. I take it 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.5,
      "end_seconds": 150.02,
      "duration_seconds": 6.52,
      "text": "I see, go ahead let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.71,
      "end_seconds": 163.2,
      "duration_seconds": 11.49,
      "text": "I'm a bus driver, so I sit for long hours. I walk the dog every morning. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.12,
      "end_seconds": 170.1,
      "duration_seconds": 4.98,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.84,
      "end_seconds": 188.82,
      "duration_seconds": 0.98,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.62,
      "end_seconds": 192.91,
      "duration_seconds": 2.29,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.76,
      "end_seconds": 210.98,
      "duration_seconds": 7.22,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.8,
      "end_seconds": 215.87,
      "duration_seconds": 2.07,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.03,
      "end_seconds": 236.57,
      "duration_seconds": 13.54,
      "text": "Right, here's what I'm thinking. I think we're dealing with an acutely ischaemic leg at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.12,
      "end_seconds": 240.53,
      "duration_seconds": 3.41,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.56,
      "end_seconds": 275.05,
      "duration_seconds": 33.49,
      "text": "I understand the worry. At the moment I'd say it's an acutely ischaemic leg, and we'll know more once the an urgent CT angiogram is back. I'm going to order an urgent CT angiogram, for acute limb ischaemia. The treatment will be heparin, 5000 units, bolus now, single dose. It's for limb ischaemia. You need the vascular surgeons now, this is time critical. I think the vascular team should see you too"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.97,
      "end_seconds": 283.13,
      "duration_seconds": 6.16,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.16,
      "end_seconds": 285.2,
      "duration_seconds": 1.04,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.41,
      "end_seconds": 294.53,
      "duration_seconds": 8.12,
      "text": "let's plan a check straight away right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.49,
      "end_seconds": 298.5,
      "duration_seconds": 2.01,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.54,
      "end_seconds": 300.74,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}