{
  "schema_version": "1.0",
  "encounter_id": "02801",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.21,
      "duration_seconds": 2.99,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.22,
      "duration_seconds": 4.22,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.19,
      "end_seconds": 23.32,
      "duration_seconds": 12.13,
      "text": "Yeah, doctor, I'll sit in if that's okay, I know what's been happening. Doctor, it's a widespread sunburn-like rash. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.24,
      "end_seconds": 25.52,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.44,
      "end_seconds": 34.07,
      "duration_seconds": 6.63,
      "text": "I've had it for about a week. And a sudden high fever, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.23,
      "end_seconds": 47.81,
      "duration_seconds": 1.58,
      "text": "Nothing like stiff neck?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.54,
      "end_seconds": 51.55,
      "duration_seconds": 3.01,
      "text": "Not at all, no stiff neck."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.27,
      "end_seconds": 58.37,
      "duration_seconds": 5.1,
      "text": "Let me check a few things. Any cough or sore throat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.6,
      "end_seconds": 63.99,
      "duration_seconds": 4.39,
      "text": "Mm, no cough or sore throat, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.22,
      "end_seconds": 68.66,
      "duration_seconds": 3.44,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.43,
      "end_seconds": 72.4,
      "duration_seconds": 1.97,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.46,
      "end_seconds": 77.23,
      "duration_seconds": 2.77,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.97,
      "end_seconds": 80.01,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.08,
      "end_seconds": 85.83,
      "duration_seconds": 4.75,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.3,
      "end_seconds": 90.74,
      "duration_seconds": 3.44,
      "text": "Yes, trimethoprim. I get a rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.35,
      "end_seconds": 95.18,
      "duration_seconds": 2.83,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.84,
      "end_seconds": 101.16,
      "duration_seconds": 5.32,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.64,
      "end_seconds": 119.06,
      "duration_seconds": 4.42,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.66,
      "end_seconds": 123.31,
      "duration_seconds": 2.65,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.31,
      "end_seconds": 127.38,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.24,
      "end_seconds": 132.09,
      "duration_seconds": 3.85,
      "text": "I've got diabetes. I have high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.53,
      "end_seconds": 134.79,
      "duration_seconds": 1.26,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.73,
      "end_seconds": 141.99,
      "duration_seconds": 6.26,
      "text": "Alright, diabetes, that matches what I have here. Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.73,
      "end_seconds": 146.25,
      "duration_seconds": 3.52,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.23,
      "end_seconds": 149.87,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.94,
      "end_seconds": 157.84,
      "duration_seconds": 3.9,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.23,
      "end_seconds": 166.02,
      "duration_seconds": 3.79,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.21,
      "end_seconds": 170.16,
      "duration_seconds": 2.95,
      "text": "Sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.48,
      "end_seconds": 174.44,
      "duration_seconds": 2.96,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.27,
      "end_seconds": 176.75,
      "duration_seconds": 1.48,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.09,
      "end_seconds": 177.79,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.92,
      "end_seconds": 181.32,
      "duration_seconds": 2.4,
      "text": "It's telmisartan, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.95,
      "end_seconds": 184.15,
      "duration_seconds": 2.2,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.62,
      "end_seconds": 186.68,
      "duration_seconds": 1.06,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 203.17,
      "duration_seconds": 2.51,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.19,
      "end_seconds": 215.28,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.68,
      "end_seconds": 246.82,
      "duration_seconds": 10.14,
      "text": "Okay: respiratory rate 20, pressure 104 over 66, heart rate 109, SpO2 99 percent on room air, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.06,
      "end_seconds": 254.32,
      "duration_seconds": 5.26,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.76,
      "end_seconds": 257.73,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.62,
      "end_seconds": 275.12,
      "duration_seconds": 8.5,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.83,
      "end_seconds": 313.58,
      "duration_seconds": 33.75,
      "text": "Okay, that's all I needed to check. So where does that leave us? This looks most like possible toxic shock syndrome. I'm going to order blood cultures, for possible toxic shock. I'd like to arrange a vaginal swab for possible toxic shock. Let's use flucloxacillin, 2 grams, now, single dose. That should help with possible toxic shock syndrome. Remove any tampon, you are going to hospital now. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.18,
      "end_seconds": 323.04,
      "duration_seconds": 8.86,
      "text": "Do get help quickly if the symptoms get worse. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.31,
      "end_seconds": 328.61,
      "duration_seconds": 4.3,
      "text": "Um, um, thank you, doctor, goodbye."
    }
  ]
}