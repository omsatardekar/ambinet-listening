{
  "schema_version": "1.0",
  "encounter_id": "02726",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.0,
      "duration_seconds": 3.01,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.65,
      "end_seconds": 8.9,
      "duration_seconds": 4.25,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.09,
      "end_seconds": 18.09,
      "duration_seconds": 8.0,
      "text": "Oh, honestly, it's a chesty cough for a week, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.85,
      "end_seconds": 22.03,
      "duration_seconds": 3.18,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.51,
      "end_seconds": 28.13,
      "duration_seconds": 2.62,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.1,
      "end_seconds": 35.31,
      "duration_seconds": 5.21,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.8,
      "end_seconds": 40.94,
      "duration_seconds": 4.14,
      "text": "Severe, really. It settles a little with honey."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.9,
      "end_seconds": 47.22,
      "duration_seconds": 2.32,
      "text": "Have you had slight aching?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.7,
      "end_seconds": 49.92,
      "duration_seconds": 1.22,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.91,
      "end_seconds": 62.12,
      "duration_seconds": 3.21,
      "text": "And what about coughing up blood or breathlessness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.54,
      "end_seconds": 71.72,
      "duration_seconds": 4.18,
      "text": "No coughing up blood or breathlessness, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.08,
      "end_seconds": 76.54,
      "duration_seconds": 3.46,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.38,
      "end_seconds": 84.33,
      "duration_seconds": 3.95,
      "text": "Um, no, no fever or chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.43,
      "end_seconds": 91.04,
      "duration_seconds": 2.61,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.14,
      "end_seconds": 96.48,
      "duration_seconds": 1.34,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.4,
      "end_seconds": 101.35,
      "duration_seconds": 2.95,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.26,
      "end_seconds": 106.96,
      "duration_seconds": 4.7,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.66,
      "end_seconds": 109.83,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.05,
      "end_seconds": 114.24,
      "duration_seconds": 3.19,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.05,
      "end_seconds": 118.95,
      "duration_seconds": 3.9,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.93,
      "end_seconds": 127.0,
      "duration_seconds": 7.07,
      "text": "It's naproxen, 250 milligrams, twice a day. It's honey and lemon, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.58,
      "end_seconds": 134.75,
      "duration_seconds": 7.17,
      "text": "Mm-hmm. Are there any allergies I should be aware of? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.46,
      "end_seconds": 138.0,
      "duration_seconds": 2.54,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.3,
      "end_seconds": 143.29,
      "duration_seconds": 3.99,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.06,
      "end_seconds": 150.89,
      "duration_seconds": 5.83,
      "text": "Ah, I've had arthritis in my knees for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 165.36,
      "duration_seconds": 2.88,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.92,
      "end_seconds": 169.2,
      "duration_seconds": 2.28,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.64,
      "end_seconds": 183.86,
      "duration_seconds": 4.22,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.4,
      "end_seconds": 199.64,
      "duration_seconds": 2.24,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.11,
      "end_seconds": 222.92,
      "duration_seconds": 11.81,
      "text": "Okay: SpO2 97 percent on room air, pulse is 84 beats a minute, respiratory rate 14. And temperature 36.7, pressure 128 over 68."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.02,
      "end_seconds": 227.51,
      "duration_seconds": 3.49,
      "text": "Mm, um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.03,
      "end_seconds": 230.07,
      "duration_seconds": 2.04,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.54,
      "end_seconds": 236.95,
      "duration_seconds": 4.41,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.81,
      "end_seconds": 240.24,
      "duration_seconds": 1.43,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.48,
      "end_seconds": 256.47,
      "duration_seconds": 3.99,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.97,
      "end_seconds": 276.19,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.94,
      "end_seconds": 286.82,
      "duration_seconds": 7.88,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. The most likely explanation is acute viral bronchitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.09,
      "end_seconds": 291.4,
      "duration_seconds": 3.31,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.14,
      "end_seconds": 313.66,
      "duration_seconds": 19.52,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Come back if not better in three weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.12,
      "end_seconds": 319.4,
      "duration_seconds": 4.28,
      "text": "Let me think, um, that's fine with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.67,
      "end_seconds": 324.38,
      "duration_seconds": 3.71,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.41,
      "end_seconds": 329.98,
      "duration_seconds": 3.57,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.83,
      "end_seconds": 332.05,
      "duration_seconds": 1.22,
      "text": "All the best."
    }
  ]
}