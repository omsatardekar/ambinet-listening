{
  "schema_version": "1.0",
  "encounter_id": "02714",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 6.23,
      "duration_seconds": 5.07,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 12.31,
      "duration_seconds": 4.85,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.38,
      "end_seconds": 17.19,
      "duration_seconds": 2.81,
      "text": "well, I've been having itchy blisters"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.96,
      "end_seconds": 20.57,
      "duration_seconds": 1.61,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.99,
      "end_seconds": 24.75,
      "duration_seconds": 2.76,
      "text": "It's been about two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.3,
      "end_seconds": 28.21,
      "duration_seconds": 2.91,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.71,
      "end_seconds": 33.22,
      "duration_seconds": 2.51,
      "text": "I'd say on and off"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 38.67,
      "duration_seconds": 4.52,
      "text": "what about raw areas where blisters burst, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.44,
      "end_seconds": 42.57,
      "duration_seconds": 3.13,
      "text": "yes, about the same, six months"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.97,
      "end_seconds": 54.66,
      "duration_seconds": 3.69,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.73,
      "end_seconds": 60.64,
      "duration_seconds": 3.91,
      "text": "okay, so I've never had an allergy"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.99,
      "end_seconds": 63.27,
      "duration_seconds": 1.28,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 70.19,
      "duration_seconds": 5.99,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.07,
      "end_seconds": 76.01,
      "duration_seconds": 3.94,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.68,
      "end_seconds": 80.24,
      "duration_seconds": 3.56,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 83.71,
      "duration_seconds": 1.78,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.32,
      "end_seconds": 87.54,
      "duration_seconds": 3.22,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.33,
      "end_seconds": 93.62,
      "duration_seconds": 2.29,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.94,
      "end_seconds": 98.79,
      "duration_seconds": 3.85,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.24,
      "end_seconds": 103.71,
      "duration_seconds": 3.47,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.41,
      "end_seconds": 109.42,
      "duration_seconds": 4.01,
      "text": "I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.7,
      "end_seconds": 113.65,
      "duration_seconds": 2.95,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.74,
      "end_seconds": 123.09,
      "duration_seconds": 7.35,
      "text": "About six months. Febuxostat, 80 milligrams, once a day. Rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.86,
      "end_seconds": 127.28,
      "duration_seconds": 2.42,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.14,
      "end_seconds": 134.54,
      "duration_seconds": 5.4,
      "text": "For nearly five years. Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.14,
      "end_seconds": 138.8,
      "duration_seconds": 2.66,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.87,
      "end_seconds": 145.47,
      "duration_seconds": 4.6,
      "text": "About a month now. Simvastatin I don't take anymore."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.26,
      "end_seconds": 148.9,
      "duration_seconds": 2.64,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.51,
      "end_seconds": 166.0,
      "duration_seconds": 16.49,
      "text": "High blood pressure, for nearly five years. I wasn't sure whether to come in at all, to to be honest. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.63,
      "end_seconds": 167.62,
      "duration_seconds": 0.99,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.42,
      "end_seconds": 172.53,
      "duration_seconds": 3.11,
      "text": "I have gout, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.85,
      "end_seconds": 174.86,
      "duration_seconds": 1.01,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.68,
      "end_seconds": 180.97,
      "duration_seconds": 5.29,
      "text": "I have high cholesterol, for two years yes, heart disease"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.79,
      "end_seconds": 191.41,
      "duration_seconds": 9.62,
      "text": "Right, so gout and high cholesterol are already on your record. We'll keep that in mind today. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.4,
      "end_seconds": 202.62,
      "duration_seconds": 9.22,
      "text": "just a triple bypass, eight years ago. My sister suggested writing things down, but I forgot"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.73,
      "end_seconds": 222.08,
      "duration_seconds": 3.35,
      "text": "Have you had eye problems, by any chance?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.07,
      "end_seconds": 227.4,
      "duration_seconds": 3.33,
      "text": "I haven't noticed any eye problems."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.65,
      "end_seconds": 233.4,
      "duration_seconds": 4.75,
      "text": "Okay, and what about mouth sores, new medicine or fever?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.14,
      "end_seconds": 239.24,
      "duration_seconds": 4.1,
      "text": "No, no mouth sores, new medicine or fever."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.98,
      "end_seconds": 246.23,
      "duration_seconds": 3.25,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.27,
      "end_seconds": 249.73,
      "duration_seconds": 1.46,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.58,
      "end_seconds": 254.84,
      "duration_seconds": 3.26,
      "text": "right, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.61,
      "end_seconds": 257.25,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.28,
      "end_seconds": 263.72,
      "duration_seconds": 4.44,
      "text": "alright, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 273.55,
      "duration_seconds": 2.19,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.4,
      "end_seconds": 307.29,
      "duration_seconds": 16.89,
      "text": "Okay: temperature 36.9, weight 81 kilos, blood pressure 119 over 72, pulse is 75 beats a minute, SpO2 99 percent on room air, height 173 centimetres, BMI works out to 27.1, respiratory rate 16."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.5,
      "end_seconds": 312.77,
      "duration_seconds": 3.27,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.45,
      "end_seconds": 315.68,
      "duration_seconds": 2.23,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.51,
      "end_seconds": 318.45,
      "duration_seconds": 1.94,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.13,
      "end_seconds": 332.74,
      "duration_seconds": 5.61,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.0,
      "end_seconds": 335.03,
      "duration_seconds": 1.03,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.31,
      "end_seconds": 345.0,
      "duration_seconds": 5.69,
      "text": "Please sit back down. Taking everything into account, this is probably bullous pemphigoid."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.03,
      "end_seconds": 360.58,
      "duration_seconds": 7.55,
      "text": "do not burst the blisters and keep the raw areas dressed does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.5,
      "end_seconds": 365.14,
      "duration_seconds": 2.64,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.78,
      "end_seconds": 368.15,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}