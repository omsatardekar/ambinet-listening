{
  "schema_version": "1.0",
  "encounter_id": "02581",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 5.19,
      "duration_seconds": 3.83,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 10.53,
      "duration_seconds": 4.73,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.29,
      "end_seconds": 20.08,
      "duration_seconds": 4.79,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 23.97,
      "duration_seconds": 3.28,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.19,
      "end_seconds": 33.08,
      "duration_seconds": 4.89,
      "text": "He's been having a new headache at the temple, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.96,
      "end_seconds": 44.38,
      "duration_seconds": 9.42,
      "text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.17,
      "end_seconds": 62.55,
      "duration_seconds": 17.38,
      "text": "I'd say mild. Yes, touching. That makes it worse. And there's blurred vision in one eye as well, ten days now. I had pain when chewing before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.32,
      "end_seconds": 71.02,
      "duration_seconds": 7.7,
      "text": "Have you had a new headache at the temple before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.48,
      "end_seconds": 79.99,
      "duration_seconds": 7.51,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.43,
      "end_seconds": 92.85,
      "duration_seconds": 3.42,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.98,
      "end_seconds": 101.72,
      "duration_seconds": 3.74,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.02,
      "end_seconds": 105.78,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.83,
      "end_seconds": 118.47,
      "duration_seconds": 10.64,
      "text": "I'm a plumber, lots of bending and kneeling. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.87,
      "end_seconds": 130.99,
      "duration_seconds": 3.12,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.7,
      "end_seconds": 147.91,
      "duration_seconds": 15.21,
      "text": "I have depression, for nearly five years. I've got anxiety. I took the morning off to come in today. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.75,
      "end_seconds": 151.03,
      "duration_seconds": 1.28,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.26,
      "end_seconds": 156.48,
      "duration_seconds": 4.22,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.13,
      "end_seconds": 160.11,
      "duration_seconds": 2.98,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.5,
      "end_seconds": 166.47,
      "duration_seconds": 4.97,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.09,
      "end_seconds": 169.07,
      "duration_seconds": 1.98,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.77,
      "end_seconds": 174.43,
      "duration_seconds": 3.66,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.63,
      "end_seconds": 179.07,
      "duration_seconds": 3.44,
      "text": "I mean, my mother had a stroke."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.99,
      "end_seconds": 198.84,
      "duration_seconds": 4.85,
      "text": "A few quick ones: fever, shoulder stiffness or weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.61,
      "end_seconds": 202.64,
      "duration_seconds": 3.03,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.57,
      "end_seconds": 207.6,
      "duration_seconds": 4.03,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.49,
      "end_seconds": 210.04,
      "duration_seconds": 1.55,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.8,
      "end_seconds": 213.78,
      "duration_seconds": 2.98,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.35,
      "end_seconds": 226.31,
      "duration_seconds": 2.96,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.92,
      "end_seconds": 245.28,
      "duration_seconds": 8.36,
      "text": "Okay: temperature is 36.8 degrees, heart rate 74, blood pressure 108 over 80, respiratory rate 14."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.23,
      "end_seconds": 249.32,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.9,
      "end_seconds": 254.82,
      "duration_seconds": 3.92,
      "text": "Right, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.28,
      "end_seconds": 258.37,
      "duration_seconds": 2.09,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.24,
      "end_seconds": 261.9,
      "duration_seconds": 1.66,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.75,
      "end_seconds": 266.22,
      "duration_seconds": 2.47,
      "text": "Right, tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.51,
      "end_seconds": 284.14,
      "duration_seconds": 4.63,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.81,
      "end_seconds": 296.52,
      "duration_seconds": 8.71,
      "text": "That's the examination finished. Taking everything into account, it points towards possible giant cell arteritis threatening sight. We shouldn't forget a migraine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.33,
      "end_seconds": 299.24,
      "duration_seconds": 1.91,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.06,
      "end_seconds": 323.08,
      "duration_seconds": 22.02,
      "text": "I understand the worry. At the moment I'd say it's possible giant cell arteritis threatening sight, and we'll know more once the urgent blood tests is back. Let's book urgent blood tests to look into possible giant cell arteritis. I'm going to order a temporal artery biopsy, for possible giant cell arteritis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.67,
      "end_seconds": 326.95,
      "duration_seconds": 2.28,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.83,
      "end_seconds": 347.4,
      "duration_seconds": 19.57,
      "text": "I'm prescribing prednisolone, 60 milligrams, once a day, until review. That should help with possible giant cell arteritis. I'll put all of this in writing so you don't have to remember it. Start the steroid today, this is to protect your sight."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.66,
      "end_seconds": 353.88,
      "duration_seconds": 6.22,
      "text": "Hm, okay. We'll catch up tomorrow. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.69,
      "end_seconds": 357.8,
      "duration_seconds": 3.11,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.31,
      "end_seconds": 360.79,
      "duration_seconds": 1.48,
      "text": "See you soon."
    }
  ]
}