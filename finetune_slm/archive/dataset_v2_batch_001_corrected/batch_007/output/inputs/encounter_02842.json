{
  "schema_version": "1.0",
  "encounter_id": "02842",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.17,
      "duration_seconds": 3.26,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.65,
      "end_seconds": 9.55,
      "duration_seconds": 3.9,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.19,
      "end_seconds": 15.08,
      "duration_seconds": 4.89,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.09,
      "end_seconds": 20.17,
      "duration_seconds": 3.08,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.05,
      "end_seconds": 25.91,
      "duration_seconds": 4.86,
      "text": "Um, so... a rolled ankle. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.3,
      "end_seconds": 29.38,
      "duration_seconds": 2.08,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.34,
      "end_seconds": 36.61,
      "duration_seconds": 3.27,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.29,
      "end_seconds": 40.19,
      "duration_seconds": 1.9,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.41,
      "end_seconds": 44.29,
      "duration_seconds": 2.88,
      "text": "Only ice, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 46.91,
      "duration_seconds": 1.9,
      "text": "Have you had bruising?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.2,
      "end_seconds": 53.52,
      "duration_seconds": 2.32,
      "text": "Yes, that started yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.58,
      "end_seconds": 57.99,
      "duration_seconds": 2.41,
      "text": "Has there been some swelling too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.47,
      "end_seconds": 66.69,
      "duration_seconds": 7.22,
      "text": "Yes, about the same, ten days. With swelling, it feels severe to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.1,
      "end_seconds": 71.51,
      "duration_seconds": 3.41,
      "text": "Any sign of pain in the shin?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.31,
      "end_seconds": 77.03,
      "duration_seconds": 3.72,
      "text": "Not at all, no pain in the shin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 82.07,
      "duration_seconds": 4.41,
      "text": "Any pop, pain in the foot or numbness at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.64,
      "end_seconds": 88.3,
      "duration_seconds": 5.66,
      "text": "I haven't had pop, pain in the foot or numbness, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 92.66,
      "duration_seconds": 2.56,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.76,
      "end_seconds": 96.13,
      "duration_seconds": 2.37,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.82,
      "end_seconds": 116.94,
      "duration_seconds": 3.12,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.9,
      "end_seconds": 133.86,
      "duration_seconds": 12.96,
      "text": "I've never touched a cigarette. I only drink at family occasions. I'm vegetarian and have been for years. My partner and our baby. I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.46,
      "end_seconds": 137.67,
      "duration_seconds": 2.21,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.52,
      "end_seconds": 144.95,
      "duration_seconds": 5.43,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.71,
      "end_seconds": 157.18,
      "duration_seconds": 3.47,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.05,
      "end_seconds": 174.33,
      "duration_seconds": 15.28,
      "text": "I have an irregular heartbeat, for nearly five years. I wasn't sure whether to come in at all, to be honest. Yeah, I have high cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.33,
      "end_seconds": 192.67,
      "duration_seconds": 12.34,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.46,
      "end_seconds": 202.89,
      "duration_seconds": 9.43,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.33,
      "end_seconds": 207.85,
      "duration_seconds": 2.52,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 209.3,
      "end_seconds": 225.55,
      "duration_seconds": 16.25,
      "text": "She is on metoprolol, 50 milligrams, twice a day for the heart rhythm, I give it to her. She is on rosuvastatin, 10 milligrams, at night for my cholesterol, I give it to her."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.12,
      "end_seconds": 229.21,
      "duration_seconds": 3.09,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 230.45,
      "end_seconds": 231.88,
      "duration_seconds": 1.43,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.09,
      "end_seconds": 233.63,
      "duration_seconds": 1.54,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.35,
      "end_seconds": 240.17,
      "duration_seconds": 4.82,
      "text": "I was on warfarin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.66,
      "end_seconds": 250.24,
      "duration_seconds": 4.58,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.39,
      "end_seconds": 264.88,
      "duration_seconds": 2.49,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.58,
      "end_seconds": 292.34,
      "duration_seconds": 8.76,
      "text": "Okay: oxygen saturation is 98 percent, temp 36.8 degrees, heart rate 76. And respiratory rate 14, pressure 111 over 73."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.89,
      "end_seconds": 295.38,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.7,
      "end_seconds": 299.11,
      "duration_seconds": 2.41,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.71,
      "end_seconds": 306.15,
      "duration_seconds": 4.44,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.87,
      "end_seconds": 308.57,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.68,
      "end_seconds": 312.6,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.45,
      "end_seconds": 334.43,
      "duration_seconds": 7.98,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.61,
      "end_seconds": 346.03,
      "duration_seconds": 8.42,
      "text": "You can sit up now. Right, here's what I'm thinking. This is probably a mild ankle sprain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.78,
      "end_seconds": 362.39,
      "duration_seconds": 8.61,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.32,
      "end_seconds": 366.15,
      "duration_seconds": 2.83,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.38,
      "end_seconds": 374.73,
      "duration_seconds": 7.35,
      "text": "Come back if not better in two weeks. Alright, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.57,
      "end_seconds": 382.19,
      "duration_seconds": 3.62,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}