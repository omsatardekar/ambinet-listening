{
  "schema_version": "1.0",
  "encounter_id": "02962",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.81,
      "end_seconds": 5.74,
      "duration_seconds": 4.93,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.09,
      "end_seconds": 10.82,
      "duration_seconds": 3.73,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.65,
      "end_seconds": 15.71,
      "duration_seconds": 3.06,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 17.21,
      "end_seconds": 20.88,
      "duration_seconds": 3.67,
      "text": "Well, I've been having a rolled ankle."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 23.83,
      "duration_seconds": 2.34,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.46,
      "end_seconds": 33.21,
      "duration_seconds": 7.75,
      "text": "About... well, five days. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.27,
      "end_seconds": 37.16,
      "duration_seconds": 1.89,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.45,
      "end_seconds": 43.92,
      "duration_seconds": 5.47,
      "text": "Sorry, what was I saying, it's worse with walking."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.35,
      "end_seconds": 50.39,
      "duration_seconds": 6.04,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 50.49,
      "end_seconds": 57.33,
      "duration_seconds": 6.84,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.19,
      "end_seconds": 61.05,
      "duration_seconds": 2.86,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.68,
      "end_seconds": 72.56,
      "duration_seconds": 10.88,
      "text": "Erm, as for swelling, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.33,
      "end_seconds": 76.66,
      "duration_seconds": 3.33,
      "text": "Any numbness, pain in the shin or pop?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.84,
      "end_seconds": 92.45,
      "duration_seconds": 14.61,
      "text": "No, no numbness, no pain in the shin, no pop. I did have bruising at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.12,
      "end_seconds": 96.65,
      "duration_seconds": 3.53,
      "text": "Has there been any pain in the foot?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 97.71,
      "end_seconds": 101.38,
      "duration_seconds": 3.67,
      "text": "No, no pain in the foot."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.32,
      "end_seconds": 106.98,
      "duration_seconds": 3.66,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.56,
      "end_seconds": 112.59,
      "duration_seconds": 5.03,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.55,
      "end_seconds": 117.93,
      "duration_seconds": 2.38,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.74,
      "end_seconds": 120.8,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.49,
      "end_seconds": 124.84,
      "duration_seconds": 2.35,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.27,
      "end_seconds": 130.65,
      "duration_seconds": 4.38,
      "text": "I'm allergic to cat fur, I get wheezing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.69,
      "end_seconds": 140.61,
      "duration_seconds": 2.92,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.07,
      "end_seconds": 144.65,
      "duration_seconds": 2.58,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.52,
      "end_seconds": 149.87,
      "duration_seconds": 4.35,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.67,
      "end_seconds": 158.34,
      "duration_seconds": 6.67,
      "text": "I'm, I'm on sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 159.59,
      "end_seconds": 168.3,
      "duration_seconds": 8.71,
      "text": "Yeah, she is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.82,
      "end_seconds": 182.15,
      "duration_seconds": 13.33,
      "text": "It's Seretide inhaler, twice a day. I'm hoping you can tell me something definite. Alendronate, 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.97,
      "end_seconds": 190.11,
      "duration_seconds": 3.14,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.37,
      "end_seconds": 194.22,
      "duration_seconds": 2.85,
      "text": "Actually, no, it's at home."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.94,
      "end_seconds": 198.95,
      "duration_seconds": 3.01,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.41,
      "end_seconds": 202.09,
      "duration_seconds": 1.68,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.3,
      "end_seconds": 207.22,
      "duration_seconds": 0.92,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.79,
      "end_seconds": 212.14,
      "duration_seconds": 3.35,
      "text": "I have asthma, for five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.0,
      "end_seconds": 216.47,
      "duration_seconds": 2.47,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.22,
      "end_seconds": 221.4,
      "duration_seconds": 3.18,
      "text": "I, I have thin bones."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.11,
      "end_seconds": 228.63,
      "duration_seconds": 5.52,
      "text": "Yes. Yes, asthma is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.21,
      "end_seconds": 238.94,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.66,
      "end_seconds": 242.44,
      "duration_seconds": 1.78,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.18,
      "end_seconds": 246.0,
      "duration_seconds": 1.82,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.01,
      "end_seconds": 248.85,
      "duration_seconds": 1.84,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.48,
      "end_seconds": 251.69,
      "duration_seconds": 1.21,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.56,
      "end_seconds": 258.11,
      "duration_seconds": 4.55,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.09,
      "end_seconds": 265.93,
      "duration_seconds": 1.84,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.56,
      "end_seconds": 271.67,
      "duration_seconds": 4.11,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.58,
      "end_seconds": 276.98,
      "duration_seconds": 3.4,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 278.79,
      "end_seconds": 282.11,
      "duration_seconds": 3.32,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 283.97,
      "end_seconds": 291.98,
      "duration_seconds": 8.01,
      "text": "Here are the numbers, doctor. Pressure 121 over 68, pulse is 67 beats a minute, temperature 37.0."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.0,
      "end_seconds": 294.48,
      "duration_seconds": 1.48,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.01,
      "end_seconds": 300.06,
      "duration_seconds": 4.05,
      "text": "Okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.84,
      "end_seconds": 303.3,
      "duration_seconds": 1.46,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.03,
      "end_seconds": 324.55,
      "duration_seconds": 8.52,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.35,
      "end_seconds": 338.34,
      "duration_seconds": 8.99,
      "text": "Please sit back down. So, to recap quickly. You've had a rolled ankle for five days, and no pop or numbness."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 339.56,
      "end_seconds": 343.26,
      "duration_seconds": 3.7,
      "text": "Yes, you know, you've got it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.76,
      "end_seconds": 364.89,
      "duration_seconds": 20.13,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again if not better in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 366.96,
      "end_seconds": 371.39,
      "duration_seconds": 4.43,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.28,
      "end_seconds": 373.65,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}