{
  "schema_version": "1.0",
  "encounter_id": "02546",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 5.9,
      "duration_seconds": 4.6,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.44,
      "end_seconds": 11.16,
      "duration_seconds": 3.72,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.19,
      "end_seconds": 17.51,
      "duration_seconds": 4.32,
      "text": "It's, It's a chesty cough for a week, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 21.15,
      "duration_seconds": 1.86,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 27.2,
      "duration_seconds": 4.84,
      "text": "Sorry, what was I saying, for five days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.76,
      "end_seconds": 39.36,
      "duration_seconds": 10.6,
      "text": "Okay, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.92,
      "end_seconds": 45.89,
      "duration_seconds": 5.97,
      "text": "Honestly, once or twice a day. I get some relief from honey."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.5,
      "end_seconds": 49.57,
      "duration_seconds": 2.07,
      "text": "Any slight aching as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.17,
      "end_seconds": 53.39,
      "duration_seconds": 2.22,
      "text": "Yes, uh, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.28,
      "end_seconds": 60.25,
      "duration_seconds": 4.97,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.42,
      "end_seconds": 71.91,
      "duration_seconds": 10.49,
      "text": "It's a few times a day. Oh, and a sore throat earlier. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.08,
      "end_seconds": 78.98,
      "duration_seconds": 5.9,
      "text": "A few quick ones: breathlessness, coughing up blood, chest pain or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.2,
      "end_seconds": 83.0,
      "duration_seconds": 2.8,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 88.67,
      "duration_seconds": 4.56,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.83,
      "end_seconds": 91.97,
      "duration_seconds": 2.14,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.48,
      "end_seconds": 95.46,
      "duration_seconds": 2.98,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.94,
      "end_seconds": 99.74,
      "duration_seconds": 2.8,
      "text": "Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.52,
      "end_seconds": 107.36,
      "duration_seconds": 5.84,
      "text": "Sure. Okay, I can see heart disease in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.34,
      "end_seconds": 127.34,
      "duration_seconds": 5.0,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.85,
      "end_seconds": 140.43,
      "duration_seconds": 11.58,
      "text": "I'm on aspirin, 75 milligrams, once a day. Honey and lemon. I take it at night. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 146.43,
      "duration_seconds": 5.09,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.15,
      "end_seconds": 148.51,
      "duration_seconds": 1.36,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.49,
      "end_seconds": 152.7,
      "duration_seconds": 3.21,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.6,
      "end_seconds": 156.4,
      "duration_seconds": 2.8,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.95,
      "end_seconds": 160.42,
      "duration_seconds": 2.47,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.44,
      "end_seconds": 168.3,
      "duration_seconds": 6.86,
      "text": "So, I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.44,
      "end_seconds": 171.36,
      "duration_seconds": 1.92,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.11,
      "end_seconds": 176.32,
      "duration_seconds": 3.21,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.41,
      "end_seconds": 180.35,
      "duration_seconds": 1.94,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.19,
      "end_seconds": 187.26,
      "duration_seconds": 5.07,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.95,
      "end_seconds": 193.43,
      "duration_seconds": 4.48,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.7,
      "end_seconds": 208.66,
      "duration_seconds": 2.96,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.73,
      "end_seconds": 226.12,
      "duration_seconds": 8.39,
      "text": "Okay: respiratory rate 15, temperature 36.9, blood pressure 113 over 76, saturation 98 percent, heart rate 84."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.97,
      "end_seconds": 229.0,
      "duration_seconds": 2.03,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.6,
      "end_seconds": 232.92,
      "duration_seconds": 3.32,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.39,
      "end_seconds": 239.6,
      "duration_seconds": 4.21,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.98,
      "end_seconds": 241.96,
      "duration_seconds": 0.98,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.7,
      "end_seconds": 246.39,
      "duration_seconds": 2.69,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.06,
      "end_seconds": 266.26,
      "duration_seconds": 4.2,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.73,
      "end_seconds": 274.55,
      "duration_seconds": 2.82,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.21,
      "end_seconds": 299.05,
      "duration_seconds": 10.84,
      "text": "Right, here's what I'm thinking. My working impression is acute viral bronchitis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.89,
      "end_seconds": 304.92,
      "duration_seconds": 4.03,
      "text": "Erm, is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.86,
      "end_seconds": 325.99,
      "duration_seconds": 19.13,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Stop me if I've got anything wrong. You've had a chesty cough for a week for five days, and no coughing up blood or chest pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.96,
      "end_seconds": 328.66,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.75,
      "end_seconds": 346.1,
      "duration_seconds": 10.35,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Come back if not better in three weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.05,
      "end_seconds": 350.0,
      "duration_seconds": 1.95,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.88,
      "end_seconds": 355.99,
      "duration_seconds": 4.11,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.92,
      "end_seconds": 361.03,
      "duration_seconds": 4.11,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.16,
      "end_seconds": 363.58,
      "duration_seconds": 1.42,
      "text": "See you soon."
    }
  ]
}