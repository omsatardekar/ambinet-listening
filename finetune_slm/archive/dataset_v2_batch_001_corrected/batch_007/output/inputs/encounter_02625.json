{
  "schema_version": "1.0",
  "encounter_id": "02625",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 3.73,
      "duration_seconds": 2.76,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.28,
      "end_seconds": 5.56,
      "duration_seconds": 1.28,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 9.92,
      "duration_seconds": 3.03,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.34,
      "end_seconds": 15.96,
      "duration_seconds": 4.62,
      "text": "I wanted to get difficulty concentrating looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.9,
      "end_seconds": 21.16,
      "duration_seconds": 3.26,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.8,
      "end_seconds": 28.07,
      "duration_seconds": 6.27,
      "text": "It's been ten days now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.72,
      "end_seconds": 30.38,
      "duration_seconds": 1.66,
      "text": "Any impatience as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.82,
      "end_seconds": 38.54,
      "duration_seconds": 6.72,
      "text": "Yes, actually. Yeah, and I've been losing things as well, for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.52,
      "end_seconds": 45.42,
      "duration_seconds": 4.9,
      "text": "Right, have you noticed low mood, head injury or thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.11,
      "end_seconds": 50.26,
      "duration_seconds": 3.15,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.49,
      "end_seconds": 54.06,
      "duration_seconds": 2.57,
      "text": "Have you had any drug use?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.82,
      "end_seconds": 58.22,
      "duration_seconds": 2.4,
      "text": "No drug use, thankfully."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.72,
      "end_seconds": 61.61,
      "duration_seconds": 2.89,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.64,
      "end_seconds": 63.75,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.71,
      "end_seconds": 86.83,
      "duration_seconds": 4.12,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.76,
      "end_seconds": 91.56,
      "duration_seconds": 2.8,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.68,
      "end_seconds": 96.85,
      "duration_seconds": 4.17,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.64,
      "end_seconds": 114.08,
      "duration_seconds": 13.44,
      "text": "I'm vegetarian and have been for years. My husband and I live above the shop. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 119.14,
      "duration_seconds": 3.99,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.47,
      "end_seconds": 122.3,
      "duration_seconds": 1.83,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.89,
      "end_seconds": 129.18,
      "duration_seconds": 6.29,
      "text": "Yes, carry on. Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.88,
      "end_seconds": 133.5,
      "duration_seconds": 3.62,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.23,
      "end_seconds": 143.32,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.03,
      "end_seconds": 158.02,
      "duration_seconds": 13.99,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.44,
      "end_seconds": 162.22,
      "duration_seconds": 2.78,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.26,
      "end_seconds": 174.37,
      "duration_seconds": 11.11,
      "text": "Sorry, uh, what was I saying, I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.46,
      "end_seconds": 180.28,
      "duration_seconds": 2.82,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.44,
      "end_seconds": 188.87,
      "duration_seconds": 2.43,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.51,
      "end_seconds": 218.0,
      "duration_seconds": 11.49,
      "text": "Okay: pressure 123 over 72, weight 65 kilos, saturation 99 percent. And temp 36.5 degrees, height 182 centimetres, heart rate 74, BMI works out to 19.6."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.02,
      "end_seconds": 221.63,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.41,
      "end_seconds": 224.54,
      "duration_seconds": 2.13,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.93,
      "end_seconds": 228.33,
      "duration_seconds": 2.4,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.13,
      "end_seconds": 231.41,
      "duration_seconds": 1.28,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.71,
      "end_seconds": 246.1,
      "duration_seconds": 5.39,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.01,
      "end_seconds": 251.7,
      "duration_seconds": 2.69,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.36,
      "end_seconds": 276.49,
      "duration_seconds": 15.13,
      "text": "I'm sending you for a questionnaire because of attention problems. It's a routine test and it'll give us a much clearer picture. I'll request a thyroid test, it'll help with poor concentration."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.49,
      "end_seconds": 280.7,
      "duration_seconds": 2.21,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.37,
      "end_seconds": 299.32,
      "duration_seconds": 17.95,
      "text": "Use lists and reminders while we arrange the specialist assessment. We'll refer you to the adult ADHD service. Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again after the assessment. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.96,
      "end_seconds": 304.73,
      "duration_seconds": 4.77,
      "text": "Well, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.1,
      "end_seconds": 307.95,
      "duration_seconds": 1.85,
      "text": "Have a good day."
    }
  ]
}