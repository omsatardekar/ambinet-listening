{
  "schema_version": "1.0",
  "encounter_id": "02879",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.39,
      "duration_seconds": 3.19,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.86,
      "duration_seconds": 4.51,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.44,
      "end_seconds": 15.07,
      "duration_seconds": 3.63,
      "text": "So, I've been passing kidney stones, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.35,
      "end_seconds": 18.07,
      "duration_seconds": 1.72,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.01,
      "end_seconds": 21.69,
      "duration_seconds": 2.68,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.59,
      "end_seconds": 27.35,
      "duration_seconds": 3.76,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.93,
      "end_seconds": 29.66,
      "duration_seconds": 1.73,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.54,
      "end_seconds": 41.19,
      "duration_seconds": 2.65,
      "text": "Have you noticed fever or fractures?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.13,
      "end_seconds": 46.18,
      "duration_seconds": 4.05,
      "text": "No fever or fractures, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.14,
      "end_seconds": 50.84,
      "duration_seconds": 3.7,
      "text": "Have you had any weight loss or low mood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.91,
      "end_seconds": 58.63,
      "duration_seconds": 5.72,
      "text": "I, I haven't had weight loss or low mood, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.41,
      "end_seconds": 62.66,
      "duration_seconds": 3.25,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 67.15,
      "duration_seconds": 2.95,
      "text": "No, um, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.77,
      "end_seconds": 69.75,
      "duration_seconds": 1.98,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.88,
      "end_seconds": 72.54,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.26,
      "end_seconds": 94.07,
      "duration_seconds": 3.81,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.76,
      "end_seconds": 99.49,
      "duration_seconds": 4.73,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.59,
      "end_seconds": 102.66,
      "duration_seconds": 2.07,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.52,
      "end_seconds": 109.52,
      "duration_seconds": 5.0,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.97,
      "end_seconds": 113.88,
      "duration_seconds": 2.91,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.12,
      "end_seconds": 120.88,
      "duration_seconds": 5.76,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.36,
      "end_seconds": 135.93,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.69,
      "end_seconds": 148.84,
      "duration_seconds": 11.15,
      "text": "Okay, so yes, thin bones. My neighbour said I should get it looked at. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.86,
      "end_seconds": 162.07,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.92,
      "end_seconds": 166.29,
      "duration_seconds": 2.37,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.16,
      "end_seconds": 173.08,
      "duration_seconds": 4.92,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.97,
      "end_seconds": 187.37,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.3,
      "end_seconds": 208.85,
      "duration_seconds": 9.55,
      "text": "Okay: respiratory rate 16, saturation 99 percent, blood pressure 124 over 70. And heart rate 85, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.63,
      "end_seconds": 212.59,
      "duration_seconds": 2.96,
      "text": "Actually, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.12,
      "end_seconds": 221.13,
      "duration_seconds": 4.01,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.04,
      "end_seconds": 226.39,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.9,
      "end_seconds": 231.02,
      "duration_seconds": 3.12,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.64,
      "end_seconds": 249.75,
      "duration_seconds": 5.11,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.92,
      "end_seconds": 269.93,
      "duration_seconds": 15.01,
      "text": "All finished, thank you. Having listened and examined, I'd lean towards possible raised calcium from an overactive parathyroid. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.01,
      "end_seconds": 274.9,
      "duration_seconds": 2.89,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.47,
      "end_seconds": 297.94,
      "duration_seconds": 21.47,
      "text": "I can't promise yet, but most people with possible raised calcium from an overactive parathyroid do well once it's treated properly. I'm sending you for a calcium and parathyroid hormone test because of kidney stones. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.81,
      "end_seconds": 301.19,
      "duration_seconds": 2.38,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.84,
      "end_seconds": 330.47,
      "duration_seconds": 27.63,
      "text": "I'll request a bone density scan, it'll help with possible hyperparathyroidism. Drink plenty of water and avoid calcium supplements until the results. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'm going to send a referral to the endocrine clinic. A kidney ultrasound is something we might do if this doesn't improve next month."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.31,
      "end_seconds": 347.42,
      "duration_seconds": 12.11,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me after the results."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.0,
      "end_seconds": 353.63,
      "duration_seconds": 3.63,
      "text": "Alright, you know, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.37,
      "end_seconds": 358.81,
      "duration_seconds": 4.44,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.14,
      "end_seconds": 365.26,
      "duration_seconds": 5.12,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    }
  ]
}