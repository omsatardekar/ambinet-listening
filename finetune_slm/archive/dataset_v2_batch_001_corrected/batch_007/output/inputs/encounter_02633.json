{
  "schema_version": "1.0",
  "encounter_id": "02633",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 3.26,
      "duration_seconds": 2.02,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.49,
      "end_seconds": 7.91,
      "duration_seconds": 3.42,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.9,
      "end_seconds": 12.43,
      "duration_seconds": 2.53,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.95,
      "end_seconds": 24.32,
      "duration_seconds": 11.37,
      "text": "It's, It's stiff aching shoulders and hips, mostly. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.32,
      "end_seconds": 33.12,
      "duration_seconds": 4.8,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.57,
      "end_seconds": 42.8,
      "duration_seconds": 8.23,
      "text": "It's something called glib... glibenclamide, 5 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.79,
      "end_seconds": 47.01,
      "duration_seconds": 3.22,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.73,
      "end_seconds": 56.32,
      "duration_seconds": 4.59,
      "text": "Oh, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.91,
      "end_seconds": 62.19,
      "duration_seconds": 5.28,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.94,
      "end_seconds": 104.25,
      "duration_seconds": 40.31,
      "text": "Hmm, only moving about, and it's not much. I notice it more with mornings. Pretty severe, if I'm being honest. I'm hoping you can tell me something definite. My neighbour said I should get it looked at. Sorry, um, what was I saying, and I've been feeling tired and low as well. Erm, I had difficulty getting out of bed before. That's settled now, though."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.46,
      "end_seconds": 123.8,
      "duration_seconds": 2.34,
      "text": "Have you had any visual changes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.2,
      "end_seconds": 130.72,
      "duration_seconds": 5.52,
      "text": "Not that I've noticed, you know, no visual changes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.15,
      "end_seconds": 136.88,
      "duration_seconds": 5.73,
      "text": "Ah. Did you get weight loss, headache or jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.75,
      "end_seconds": 140.41,
      "duration_seconds": 2.66,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.29,
      "end_seconds": 143.51,
      "duration_seconds": 2.22,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.49,
      "end_seconds": 146.58,
      "duration_seconds": 2.09,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.81,
      "end_seconds": 152.16,
      "duration_seconds": 4.35,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.91,
      "end_seconds": 156.54,
      "duration_seconds": 2.63,
      "text": "Diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.04,
      "end_seconds": 170.1,
      "duration_seconds": 4.06,
      "text": "Alright, what do you do during the day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.02,
      "end_seconds": 175.16,
      "duration_seconds": 4.14,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.7,
      "end_seconds": 178.98,
      "duration_seconds": 2.28,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.84,
      "end_seconds": 185.4,
      "duration_seconds": 4.56,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.9,
      "end_seconds": 187.87,
      "duration_seconds": 1.97,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.16,
      "end_seconds": 194.16,
      "duration_seconds": 5.0,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.84,
      "end_seconds": 200.16,
      "duration_seconds": 4.32,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.89,
      "end_seconds": 205.84,
      "duration_seconds": 4.95,
      "text": "I mean, no, not that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 223.09,
      "end_seconds": 230.34,
      "duration_seconds": 7.25,
      "text": "Okay, so the vitals from earlier. Temperature 36.6, heart rate 70, blood pressure 109 over 79."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 235.96,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.52,
      "end_seconds": 242.0,
      "duration_seconds": 3.48,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.96,
      "end_seconds": 246.19,
      "duration_seconds": 2.23,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.85,
      "end_seconds": 260.39,
      "duration_seconds": 6.54,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.08,
      "end_seconds": 262.16,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.61,
      "end_seconds": 282.6,
      "duration_seconds": 15.99,
      "text": "That's all I needed to check. Having listened and examined, I'd lean towards polymyalgia rheumatica. The reason I say that is that your story and my examination fit together. I'd also keep rheumatoid arthritis in mind."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.8,
      "end_seconds": 286.02,
      "duration_seconds": 2.22,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.95,
      "end_seconds": 300.34,
      "duration_seconds": 13.39,
      "text": "Nothing I've seen today points to an emergency. It looks like polymyalgia rheumatica, but I'd like to confirm. Blood tests is what I'd like next, for proximal stiffness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.36,
      "end_seconds": 307.61,
      "duration_seconds": 5.25,
      "text": "Sorry, what was I saying, is that done today?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.52,
      "end_seconds": 328.94,
      "duration_seconds": 20.42,
      "text": "Let's use prednisolone, 15 milligrams, once a day, reducing course. That's for polymyalgia rheumatica. Report any headache or jaw pain immediately. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me in two weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.17,
      "end_seconds": 335.74,
      "duration_seconds": 5.57,
      "text": "Erm, uh, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.58,
      "end_seconds": 339.04,
      "duration_seconds": 2.46,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.12,
      "end_seconds": 343.95,
      "duration_seconds": 3.83,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}