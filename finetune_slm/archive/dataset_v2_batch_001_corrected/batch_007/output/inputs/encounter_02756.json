{
  "schema_version": "1.0",
  "encounter_id": "02756",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 2.8,
      "duration_seconds": 1.7,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.64,
      "end_seconds": 7.55,
      "duration_seconds": 3.91,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.87,
      "end_seconds": 14.86,
      "duration_seconds": 5.99,
      "text": "Um, so... stiff aching shoulders and hips. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.0,
      "end_seconds": 17.4,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.27,
      "end_seconds": 23.57,
      "duration_seconds": 4.3,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.91,
      "end_seconds": 29.5,
      "duration_seconds": 4.59,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.04,
      "end_seconds": 49.65,
      "duration_seconds": 16.61,
      "text": "It's worse with mornings. It happens a couple of times a week. I'd say mild. I've, I've also had difficulty getting out of bed, since Friday. As for difficulty getting out of bed, I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.06,
      "end_seconds": 57.86,
      "duration_seconds": 2.8,
      "text": "Have you been feeling tired and low?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.5,
      "end_seconds": 60.31,
      "duration_seconds": 1.81,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.74,
      "end_seconds": 61.49,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.32,
      "end_seconds": 66.61,
      "duration_seconds": 3.29,
      "text": "There's a mild temperature as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.26,
      "end_seconds": 70.58,
      "duration_seconds": 3.32,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.16,
      "end_seconds": 75.93,
      "duration_seconds": 3.77,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.52,
      "end_seconds": 92.41,
      "duration_seconds": 2.89,
      "text": "Any weight loss, visual changes or headache?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.86,
      "end_seconds": 102.62,
      "duration_seconds": 4.76,
      "text": "No, no weight loss, visual changes or headache."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.72,
      "end_seconds": 108.19,
      "duration_seconds": 3.47,
      "text": "Did you notice any jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.53,
      "end_seconds": 114.47,
      "duration_seconds": 4.94,
      "text": "Not that I've noticed, no jaw pain on chewing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.36,
      "end_seconds": 119.55,
      "duration_seconds": 3.19,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.62,
      "end_seconds": 121.98,
      "duration_seconds": 1.36,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.11,
      "end_seconds": 142.02,
      "duration_seconds": 3.91,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.85,
      "end_seconds": 146.98,
      "duration_seconds": 4.13,
      "text": "Ah, yes, erythromycin. I get a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.8,
      "end_seconds": 160.84,
      "duration_seconds": 2.04,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 165.89,
      "duration_seconds": 4.34,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.24,
      "end_seconds": 169.65,
      "duration_seconds": 2.41,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.27,
      "end_seconds": 174.98,
      "duration_seconds": 3.71,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.62,
      "end_seconds": 180.54,
      "duration_seconds": 3.92,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.48,
      "end_seconds": 185.65,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.55,
      "end_seconds": 189.48,
      "duration_seconds": 2.93,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.86,
      "end_seconds": 195.93,
      "duration_seconds": 5.07,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.67,
      "end_seconds": 199.85,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.56,
      "end_seconds": 204.46,
      "duration_seconds": 2.9,
      "text": "Low haemoglobin, for nearly five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.28,
      "end_seconds": 206.04,
      "duration_seconds": 0.76,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.81,
      "end_seconds": 216.12,
      "duration_seconds": 8.31,
      "text": "I've had COPD for about a year now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.0,
      "end_seconds": 222.1,
      "duration_seconds": 4.1,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.89,
      "end_seconds": 235.33,
      "duration_seconds": 11.44,
      "text": "Iron tablets, once a day. I'm supposed to take it regularly, but I don't always manage. Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 236.24,
      "end_seconds": 247.35,
      "duration_seconds": 11.11,
      "text": "Here are the numbers, doctor. Temperature is 36.8 degrees, pulse is 84 beats a minute, BP is 120 over 81. Saturation 97 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.93,
      "end_seconds": 250.89,
      "duration_seconds": 1.96,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.14,
      "end_seconds": 257.7,
      "duration_seconds": 4.56,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.5,
      "end_seconds": 259.67,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.67,
      "end_seconds": 280.28,
      "duration_seconds": 6.61,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.3,
      "end_seconds": 306.08,
      "duration_seconds": 20.78,
      "text": "Please sit back down. Having listened and examined, the most likely explanation is polymyalgia rheumatica. We shouldn't forget rheumatoid arthritis. Stop me if I've got anything wrong. You've had stiff aching shoulders and hips for about a week, mild, and no jaw pain on chewing or headache."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.7,
      "end_seconds": 308.31,
      "duration_seconds": 1.61,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.14,
      "end_seconds": 314.29,
      "duration_seconds": 4.15,
      "text": "I think blood tests makes sense here, for proximal stiffness."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.93,
      "end_seconds": 318.2,
      "duration_seconds": 2.27,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.02,
      "end_seconds": 322.71,
      "duration_seconds": 2.69,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.5,
      "end_seconds": 325.79,
      "duration_seconds": 2.29,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.65,
      "end_seconds": 328.12,
      "duration_seconds": 1.47,
      "text": "See you soon."
    }
  ]
}