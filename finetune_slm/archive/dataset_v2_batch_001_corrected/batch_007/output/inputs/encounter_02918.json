{
  "schema_version": "1.0",
  "encounter_id": "02918",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.31,
      "duration_seconds": 2.8,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.34,
      "end_seconds": 12.88,
      "duration_seconds": 4.54,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.52,
      "end_seconds": 23.24,
      "duration_seconds": 8.72,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. We came because of itchy blisters."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.66,
      "end_seconds": 32.06,
      "duration_seconds": 7.4,
      "text": "What's the timeline, when did it begin? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.68,
      "end_seconds": 36.22,
      "duration_seconds": 2.54,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.89,
      "end_seconds": 43.06,
      "duration_seconds": 2.17,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.37,
      "end_seconds": 46.84,
      "duration_seconds": 2.47,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.31,
      "end_seconds": 51.51,
      "duration_seconds": 3.2,
      "text": "Has there been an itchy rash first too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.21,
      "end_seconds": 66.46,
      "duration_seconds": 13.25,
      "text": "Yeah. Six months, I'd say. As for raw areas where blisters burst, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.16,
      "end_seconds": 74.55,
      "duration_seconds": 7.39,
      "text": "Let me check a few things. Any mouth sores, fever, new medicine or eye problems?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.54,
      "end_seconds": 82.48,
      "duration_seconds": 6.94,
      "text": "I haven't had mouth sores, fever, new medicine or eye problems, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.04,
      "end_seconds": 85.82,
      "duration_seconds": 2.78,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.74,
      "end_seconds": 88.24,
      "duration_seconds": 1.5,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.51,
      "end_seconds": 103.73,
      "duration_seconds": 3.22,
      "text": "Right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.23,
      "end_seconds": 108.19,
      "duration_seconds": 3.96,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.61,
      "end_seconds": 113.36,
      "duration_seconds": 3.75,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.69,
      "end_seconds": 124.51,
      "duration_seconds": 9.82,
      "text": "Valsartan. I take it 80 milligrams, once a day. Lansoprazole. I take it 30 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.76,
      "end_seconds": 133.31,
      "duration_seconds": 3.55,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.15,
      "end_seconds": 138.46,
      "duration_seconds": 4.31,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.48,
      "end_seconds": 152.84,
      "duration_seconds": 2.36,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.72,
      "end_seconds": 163.38,
      "duration_seconds": 9.66,
      "text": "I have high blood pressure, for about a year. I've had acid reflux for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.14,
      "end_seconds": 174.55,
      "duration_seconds": 10.41,
      "text": "Okay, I can see acid reflux in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.47,
      "end_seconds": 194.56,
      "duration_seconds": 19.09,
      "text": "I've never touched a cigarette. I used to drink heavily but I stopped four years ago. I live with my elderly mother. Yes, I work in a bakery, early starts. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.47,
      "end_seconds": 199.43,
      "duration_seconds": 3.96,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.05,
      "end_seconds": 205.6,
      "duration_seconds": 4.55,
      "text": "My brother has epilepsy. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.39,
      "end_seconds": 209.82,
      "duration_seconds": 3.43,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.99,
      "end_seconds": 219.59,
      "duration_seconds": 2.6,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.04,
      "end_seconds": 244.8,
      "duration_seconds": 7.76,
      "text": "Okay: respiratory rate 14, temp 36.8 degrees, pressure 120 over 81. And heart rate 67."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.51,
      "end_seconds": 247.04,
      "duration_seconds": 1.53,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.9,
      "end_seconds": 251.93,
      "duration_seconds": 4.03,
      "text": "So, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.87,
      "end_seconds": 257.85,
      "duration_seconds": 2.98,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.0,
      "end_seconds": 261.36,
      "duration_seconds": 2.36,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.59,
      "end_seconds": 285.06,
      "duration_seconds": 6.47,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.37,
      "end_seconds": 289.24,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.34,
      "end_seconds": 327.37,
      "duration_seconds": 23.03,
      "text": "From what you've told me and what I found, I think we're dealing with bullous pemphigoid at this stage. I can't rule out a drug reaction yet. I'm sending you for a skin biopsy because of blistering. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.57,
      "end_seconds": 331.96,
      "duration_seconds": 3.39,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.93,
      "end_seconds": 337.3,
      "duration_seconds": 2.37,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.62,
      "end_seconds": 345.24,
      "duration_seconds": 3.62,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.89,
      "end_seconds": 347.34,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}