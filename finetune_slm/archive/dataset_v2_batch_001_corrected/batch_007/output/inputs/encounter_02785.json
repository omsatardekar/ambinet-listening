{
  "schema_version": "1.0",
  "encounter_id": "02785",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.67,
      "duration_seconds": 5.08,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 10.72,
      "duration_seconds": 4.47,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.48,
      "end_seconds": 24.06,
      "duration_seconds": 11.58,
      "text": "doctor, I've come along because I know the history, if it helps she's been having a chesty cough for a week, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.98,
      "end_seconds": 29.88,
      "duration_seconds": 3.9,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.27,
      "end_seconds": 33.79,
      "duration_seconds": 2.52,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.82,
      "end_seconds": 39.72,
      "duration_seconds": 3.9,
      "text": "It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.71,
      "end_seconds": 46.26,
      "duration_seconds": 4.55,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.18,
      "end_seconds": 48.4,
      "duration_seconds": 1.22,
      "text": "yeah, roughly"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.93,
      "end_seconds": 58.69,
      "duration_seconds": 8.76,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.89,
      "end_seconds": 74.15,
      "duration_seconds": 12.26,
      "text": "I get some relief from honey. Pretty moderate, if I'm being honest. There was a sore throat earlier, yes, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.28,
      "end_seconds": 77.66,
      "duration_seconds": 2.38,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.68,
      "end_seconds": 87.35,
      "duration_seconds": 8.67,
      "text": "Migraines, for five years. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.46,
      "end_seconds": 89.83,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.21,
      "end_seconds": 96.75,
      "duration_seconds": 1.54,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.3,
      "end_seconds": 100.44,
      "duration_seconds": 3.14,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.01,
      "end_seconds": 105.87,
      "duration_seconds": 2.86,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.44,
      "end_seconds": 110.11,
      "duration_seconds": 2.67,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.11,
      "end_seconds": 115.14,
      "duration_seconds": 4.03,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.02,
      "end_seconds": 132.37,
      "duration_seconds": 4.35,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.73,
      "end_seconds": 141.13,
      "duration_seconds": 3.4,
      "text": "It's sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 143.02,
      "end_seconds": 150.83,
      "duration_seconds": 7.81,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.12,
      "end_seconds": 159.94,
      "duration_seconds": 4.82,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.98,
      "end_seconds": 167.44,
      "duration_seconds": 3.46,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.14,
      "end_seconds": 172.28,
      "duration_seconds": 4.14,
      "text": "have you had any chest pain, fever or breathlessness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.35,
      "end_seconds": 178.25,
      "duration_seconds": 4.9,
      "text": "no chest pain, fever or breathlessness, none of it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.27,
      "end_seconds": 182.26,
      "duration_seconds": 1.99,
      "text": "How about coughing up blood?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.05,
      "end_seconds": 186.31,
      "duration_seconds": 2.26,
      "text": "no. No coughing up blood"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.63,
      "end_seconds": 189.69,
      "duration_seconds": 2.06,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.76,
      "end_seconds": 192.42,
      "duration_seconds": 1.66,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.14,
      "end_seconds": 195.33,
      "duration_seconds": 2.19,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.75,
      "end_seconds": 197.7,
      "duration_seconds": 0.95,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.4,
      "end_seconds": 201.0,
      "duration_seconds": 2.6,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.15,
      "end_seconds": 211.24,
      "duration_seconds": 3.09,
      "text": "alright, that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.14,
      "end_seconds": 235.26,
      "duration_seconds": 9.12,
      "text": "Okay: respiratory rate 14, blood pressure 123 over 80, heart rate 65, temp 36.8 degrees, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.34,
      "end_seconds": 241.32,
      "duration_seconds": 3.98,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.67,
      "end_seconds": 252.17,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.31,
      "end_seconds": 255.55,
      "duration_seconds": 2.24,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.89,
      "end_seconds": 267.3,
      "duration_seconds": 4.41,
      "text": "Your chest is clear and and your oxygen is normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.87,
      "end_seconds": 272.68,
      "duration_seconds": 2.81,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 288.71,
      "duration_seconds": 4.81,
      "text": "taking everything into account, it fits best with acute viral bronchitis"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.69,
      "end_seconds": 293.75,
      "duration_seconds": 3.06,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.81,
      "end_seconds": 324.62,
      "duration_seconds": 29.81,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Come back or go to emergency straight away if you get a fever or breathlessness. I'd like to see you again if not better in three weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.29,
      "end_seconds": 329.71,
      "duration_seconds": 3.42,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.72,
      "end_seconds": 332.05,
      "duration_seconds": 1.33,
      "text": "See you soon."
    }
  ]
}