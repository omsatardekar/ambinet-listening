    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.94,
      "end_seconds": 196.99,
      "duration_seconds": 3.05,
      "text": "has anyone ever diagnosed you with something?"
