      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.99,
      "end_seconds": 66.53,
      "duration_seconds": 14.54,
      "text": "okay: weight 62 kilos, BMI works out to 18.1, pulse 88. And SpO2 97 percent on room air, height 185 centimetres, BP is 153 over 92, temperature is 36.4 degrees"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.6,
      "end_seconds": 70.8,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
