      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.5,
      "end_seconds": 98.25,
      "duration_seconds": 2.75,
      "text": "How troublesome is it day to day?"
