      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.88,
      "end_seconds": 261.84,
      "duration_seconds": 2.96,
      "text": "I'll listen to your chest now"
