    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 282.38,
      "duration_seconds": 4.45,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.42,
      "end_seconds": 303.4,
      "duration_seconds": 15.98,
      "text": "Please sit back down. Okay, so my impression is this: My working impression is severe pre-eclampsia. So, to recap quickly. You've had seeing flashing lights for six months, mild, and no reduced baby movements or vaginal bleeding."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.68,
      "end_seconds": 311.02,
      "duration_seconds": 2.34,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.91,
      "end_seconds": 316.8,
      "duration_seconds": 4.89,
      "text": "I want a urine protein test done, that's for pre-eclampsia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 317.35,
      "end_seconds": 319.81,
      "duration_seconds": 2.46,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.95,
      "end_seconds": 329.6,
      "duration_seconds": 8.65,
      "text": "I'm prescribing labetalol, 200 milligrams, once now, single dose. You take it by mouth. It's for severe hypertension."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.15,
      "end_seconds": 334.04,
      "duration_seconds": 2.89,
      "text": "Fine, um, I'll begin it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.19,
      "end_seconds": 339.94,
      "duration_seconds": 4.75,
      "text": "You need to go to the maternity unit straight away."
    },
