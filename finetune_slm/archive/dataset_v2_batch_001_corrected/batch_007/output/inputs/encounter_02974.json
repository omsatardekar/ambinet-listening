    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.42,
      "end_seconds": 108.89,
      "duration_seconds": 9.47,
      "text": "Pretty mild, if I'm being honest. And swollen face and hands, too. About swollen face and hands, I'd say severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.4,
      "end_seconds": 131.58,
      "duration_seconds": 5.18,
      "text": "Let me check a few things. Any vaginal bleeding or reduced baby movements?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.12,
      "end_seconds": 134.73,
      "duration_seconds": 2.61,
      "text": "No, nothing to report there."
