      "start_seconds": 0.77,
      "end_seconds": 6.11,
      "duration_seconds": 5.34,
      "text": "let me think, morning, doctor. Lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.21,
      "end_seconds": 12.24,
      "duration_seconds": 4.03,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 20.98,
      "duration_seconds": 6.99,
      "text": "Doctor, uh, it's seeing flashing lights. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 24.56,
      "duration_seconds": 2.88,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.53,
      "end_seconds": 39.62,
