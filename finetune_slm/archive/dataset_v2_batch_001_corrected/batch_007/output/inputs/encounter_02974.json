      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.53,
      "end_seconds": 202.6,
      "duration_seconds": 5.07,
      "text": "I've got high cholesterol. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.4,
      "end_seconds": 210.48,
      "duration_seconds": 6.08,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0028",
