  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.95,
      "duration_seconds": 5.87,
      "text": "Hi, uh, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.78,
      "end_seconds": 13.97,
      "duration_seconds": 5.19,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.65,
      "end_seconds": 20.3,
      "duration_seconds": 4.65,
      "text": "Well, I've been having a sudden painful cold leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.29,
      "end_seconds": 25.84,
      "duration_seconds": 3.55,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.2,
      "end_seconds": 36.86,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.12,
      "end_seconds": 64.91,
      "duration_seconds": 9.79,
      "text": "okay: respiratory rate 19, blood pressure 113 over 85, pulse 106, SpO2 98 percent on room air, temp 36.8 degrees"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.96,
      "end_seconds": 67.34,
      "duration_seconds": 1.38,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.37,
      "end_seconds": 71.95,
      "duration_seconds": 2.58,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.77,
      "end_seconds": 90.68,
      "duration_seconds": 2.91,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.36,
      "end_seconds": 94.72,
      "duration_seconds": 2.36,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.13,
      "end_seconds": 99.84,
      "duration_seconds": 3.71,
      "text": "Okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.63,
      "end_seconds": 115.54,
      "duration_seconds": 13.91,
      "text": "Numbness in the foot goes along with it, um, most of the time. Actually, the Numbness in the foot? That's been since Friday. Oh, and a pale leg."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.9,
      "end_seconds": 122.39,
      "duration_seconds": 5.49,
      "text": "Let me check a few things. Any chest pain or recent injury?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.27,
      "end_seconds": 126.22,
      "duration_seconds": 2.95,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.13,
      "end_seconds": 129.14,
      "duration_seconds": 2.01,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.33,
      "end_seconds": 131.7,
      "duration_seconds": 1.37,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.51,
      "end_seconds": 136.05,
      "duration_seconds": 2.54,
      "text": "Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.7,
      "end_seconds": 139.24,
      "duration_seconds": 1.54,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.26,
      "end_seconds": 143.71,
      "duration_seconds": 3.45,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.03,
      "end_seconds": 151.51,
      "duration_seconds": 6.48,
      "text": "It's bisoprolol, 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.43,
      "end_seconds": 156.89,
      "duration_seconds": 3.46,
      "text": "Alright, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.18,
      "end_seconds": 164.73,
      "duration_seconds": 6.55,
      "text": "Just a a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 178.27,
      "duration_seconds": 5.34,
      "text": "are you allergic to to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.65,
      "end_seconds": 181.26,
      "duration_seconds": 1.61,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.26,
      "end_seconds": 187.97,
      "duration_seconds": 4.71,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.72,
      "end_seconds": 203.33,
      "duration_seconds": 13.61,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. I live with my elderly mother. I'm vegetarian and have been for years. I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.81,
      "end_seconds": 208.77,
      "duration_seconds": 3.96,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.01,
      "end_seconds": 212.57,
      "duration_seconds": 2.56,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.84,
      "end_seconds": 219.33,
      "duration_seconds": 4.49,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.67,
      "end_seconds": 222.25,
      "duration_seconds": 1.58,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.29,
      "end_seconds": 243.01,
      "duration_seconds": 6.72,
      "text": "the right leg is cold, pale and mottled, with no pulses at the groin or below"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.07,
      "end_seconds": 245.08,
      "duration_seconds": 1.01,
      "text": "of course"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.63,
      "end_seconds": 250.64,
      "duration_seconds": 2.01,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.56,
      "end_seconds": 276.91,
      "duration_seconds": 8.35,
      "text": "Let me just check I've got this right. You've had a sudden painful cold leg, and no recent injury or fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.69,
      "end_seconds": 280.48,
      "duration_seconds": 1.79,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.27,
      "end_seconds": 315.1,
      "duration_seconds": 33.83,
      "text": "I'd like to arrange an urgent CT angiogram for acute limb ischaemia. That will help us see what's going on underneath and decide the next step. I'd like you to take heparin, 5000 units, bolus now, single dose. That should help with limb ischaemia. You need the vascular surgeons now, this is time critical. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.44,
      "end_seconds": 317.49,
      "duration_seconds": 1.05,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.43,
      "end_seconds": 323.82,
      "duration_seconds": 5.39,
      "text": "Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.33,
      "end_seconds": 327.5,
      "duration_seconds": 3.17,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.76,
      "end_seconds": 330.0,
      "duration_seconds": 1.24,
      "text": "see you soon"
    }
  ]
}