{
  "schema_version": "1.0",
  "encounter_id": "02926",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 4.13,
      "duration_seconds": 3.12,
      "text": "So, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.25,
      "end_seconds": 8.41,
      "duration_seconds": 1.16,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.46,
      "end_seconds": 13.07,
      "duration_seconds": 2.61,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.61,
      "end_seconds": 18.0,
      "duration_seconds": 3.39,
      "text": "I've been dealing with pain when chewing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.33,
      "end_seconds": 21.55,
      "duration_seconds": 2.22,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.73,
      "end_seconds": 24.75,
      "duration_seconds": 2.02,
      "text": "No, um, none."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.49,
      "end_seconds": 37.66,
      "duration_seconds": 3.17,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.9,
      "end_seconds": 41.53,
      "duration_seconds": 2.63,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.99,
      "end_seconds": 47.56,
      "duration_seconds": 5.57,
      "text": "Mm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.48,
      "end_seconds": 56.7,
      "duration_seconds": 6.22,
      "text": "About a eight out of ten. It's a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.86,
      "end_seconds": 62.3,
      "duration_seconds": 2.44,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.33,
      "end_seconds": 78.51,
      "duration_seconds": 14.18,
      "text": "A new headache at the temple goes along with it, most of the time. Ah, with new headache at the temple, I notice it more with touching."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.98,
      "end_seconds": 91.2,
      "duration_seconds": 2.22,
      "text": "Any sign of shoulder stiffness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.65,
      "end_seconds": 94.97,
      "duration_seconds": 2.32,
      "text": "Nope, no shoulder stiffness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.13,
      "end_seconds": 100.08,
      "duration_seconds": 3.95,
      "text": "Alright, and what about weight loss or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.77,
      "end_seconds": 103.59,
      "duration_seconds": 2.82,
      "text": "No, no weight loss or fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.1,
      "end_seconds": 106.89,
      "duration_seconds": 2.79,
      "text": "Right, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.61,
      "end_seconds": 109.13,
      "duration_seconds": 1.52,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.86,
      "end_seconds": 113.39,
      "duration_seconds": 2.53,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.89,
      "end_seconds": 116.29,
      "duration_seconds": 2.4,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.15,
      "end_seconds": 120.24,
      "duration_seconds": 3.09,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.97,
      "end_seconds": 124.01,
      "duration_seconds": 2.04,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.58,
      "end_seconds": 143.19,
      "duration_seconds": 5.61,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.64,
      "end_seconds": 156.15,
      "duration_seconds": 11.51,
      "text": "I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.2,
      "end_seconds": 159.39,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.95,
      "end_seconds": 161.69,
      "duration_seconds": 1.74,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.19,
      "end_seconds": 166.26,
      "duration_seconds": 4.07,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.51,
      "end_seconds": 170.41,
      "duration_seconds": 2.9,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.64,
      "end_seconds": 174.19,
      "duration_seconds": 2.55,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.48,
      "end_seconds": 188.02,
      "duration_seconds": 2.54,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.52,
      "end_seconds": 210.07,
      "duration_seconds": 10.55,
      "text": "Okay: blood pressure 117 over 70, respiratory rate 16, temperature is 36.6 degrees, saturation 99 percent, pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.97,
      "end_seconds": 216.43,
      "duration_seconds": 4.46,
      "text": "Alright, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.43,
      "end_seconds": 219.31,
      "duration_seconds": 1.88,
      "text": "Alright, breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.42,
      "end_seconds": 241.25,
      "duration_seconds": 4.83,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.49,
      "end_seconds": 252.44,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.11,
      "end_seconds": 273.2,
      "duration_seconds": 16.09,
      "text": "All finished, thank you. Taking everything into account, the most likely explanation is possible giant cell arteritis threatening sight. Just to be sure I understood. You've had pain when chewing for two months, and no shoulder stiffness or weight loss."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.19,
      "end_seconds": 277.36,
      "duration_seconds": 2.17,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.36,
      "end_seconds": 288.83,
      "duration_seconds": 10.47,
      "text": "Let's book urgent blood tests to look into possible giant cell arteritis. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.75,
      "end_seconds": 293.23,
      "duration_seconds": 2.48,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 307.93,
      "duration_seconds": 14.0,
      "text": "The treatment will be prednisolone, 60 milligrams, once a day, until review. It's for possible giant cell arteritis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.48,
      "end_seconds": 312.77,
      "duration_seconds": 3.29,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.54,
      "end_seconds": 328.85,
      "duration_seconds": 15.31,
      "text": "Start the steroid today, this is to protect your sight. The rheumatology team would be the right next step, I'll refer you. If you lose vision, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.24,
      "end_seconds": 331.72,
      "duration_seconds": 1.48,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.99,
      "end_seconds": 341.22,
      "duration_seconds": 5.23,
      "text": "Book a review tomorrow. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.31,
      "end_seconds": 346.84,
      "duration_seconds": 3.53,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.32,
      "end_seconds": 350.19,
      "duration_seconds": 1.87,
      "text": "Have a good day."
    }
  ]
}