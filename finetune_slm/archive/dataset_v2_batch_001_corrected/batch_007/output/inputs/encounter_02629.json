{
  "schema_version": "1.0",
  "encounter_id": "02629",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.79,
      "end_seconds": 4.93,
      "duration_seconds": 4.14,
      "text": "morning, doctor. I've settled them in, ready when you are"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.88,
      "end_seconds": 9.72,
      "duration_seconds": 3.84,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.38,
      "end_seconds": 16.53,
      "duration_seconds": 5.15,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.98,
      "end_seconds": 21.97,
      "duration_seconds": 3.99,
      "text": "right, please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 23.08,
      "end_seconds": 26.56,
      "duration_seconds": 3.48,
      "text": "Well, I've been having fainting on exertion."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.32,
      "end_seconds": 30.61,
      "duration_seconds": 2.29,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.3,
      "end_seconds": 33.5,
      "duration_seconds": 2.2,
      "text": "probably three days yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.27,
      "end_seconds": 40.73,
      "duration_seconds": 6.46,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.83,
      "end_seconds": 46.09,
      "duration_seconds": 5.26,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.69,
      "end_seconds": 54.74,
      "duration_seconds": 8.05,
      "text": "I was getting to that! Oh, and being very breathless that's been about the same, three days"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.66,
      "end_seconds": 62.38,
      "duration_seconds": 5.72,
      "text": "have you had fainting on exertion before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.58,
      "end_seconds": 74.33,
      "duration_seconds": 9.75,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 74.96,
      "end_seconds": 84.51,
      "duration_seconds": 9.55,
      "text": "Doctor, I've got the readings for you. Heart rate 88, SpO2 90 percent on room air, temp 37.1 degrees, pressure 138 over 72."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.88,
      "end_seconds": 86.58,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.24,
      "end_seconds": 94.03,
      "duration_seconds": 4.79,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.09,
      "end_seconds": 97.11,
      "duration_seconds": 2.02,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.09,
      "end_seconds": 119.61,
      "duration_seconds": 5.52,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.92,
      "end_seconds": 129.82,
      "duration_seconds": 4.9,
      "text": "that's the examination finished any cough, leg pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.05,
      "end_seconds": 143.43,
      "duration_seconds": 12.38,
      "text": "no, no cough, no leg pain, no fever i did have swollen ankles at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.77,
      "end_seconds": 147.64,
      "duration_seconds": 2.87,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.63,
      "end_seconds": 150.54,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.4,
      "end_seconds": 153.61,
      "duration_seconds": 2.21,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.45,
      "end_seconds": 157.21,
      "duration_seconds": 1.76,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.18,
      "end_seconds": 172.23,
      "duration_seconds": 2.05,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.14,
      "end_seconds": 181.69,
      "duration_seconds": 7.55,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.63,
      "end_seconds": 186.33,
      "duration_seconds": 2.7,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.78,
      "end_seconds": 213.58,
      "duration_seconds": 25.8,
      "text": "For my heart, I believe. My wife sets them out for me, I just take what I'm given. Hydrocortisone cream, when needed. Escitalopram. I take it 10 milligrams, once a day. Erm, I take iron tablets, once a day. I'd been on metoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.36,
      "end_seconds": 221.25,
      "duration_seconds": 3.89,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.03,
      "end_seconds": 228.31,
      "duration_seconds": 5.28,
      "text": "My daughter has type 1 diabetes. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.51,
      "end_seconds": 244.03,
      "duration_seconds": 4.52,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.83,
      "end_seconds": 248.87,
      "duration_seconds": 3.04,
      "text": "I have heart failure yes, eczema"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.09,
      "end_seconds": 254.86,
      "duration_seconds": 1.77,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.72,
      "end_seconds": 261.04,
      "duration_seconds": 5.32,
      "text": "Anxiety, for about a year. I've had low haemoglobin, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.8,
      "end_seconds": 265.64,
      "duration_seconds": 3.84,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.24,
      "end_seconds": 270.12,
      "duration_seconds": 3.88,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.14,
      "end_seconds": 273.47,
      "duration_seconds": 2.33,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 274.73,
      "end_seconds": 277.22,
      "duration_seconds": 2.49,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.1,
      "end_seconds": 285.48,
      "duration_seconds": 2.38,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.5,
      "end_seconds": 290.94,
      "duration_seconds": 4.44,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.15,
      "end_seconds": 304.53,
      "duration_seconds": 12.38,
      "text": "So where does that leave us? It's hard to say. Possible pulmonary hypertension is one possibility and a heart valve problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.49,
      "end_seconds": 309.74,
      "duration_seconds": 3.25,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.8,
      "end_seconds": 339.63,
      "duration_seconds": 27.83,
      "text": "Nothing I've seen today points to an emergency. It looks like possible pulmonary hypertension, but I'd like to confirm. I'll request an ECG, it'll help with syncope. We should do an echocardiogram for exertional syncope. That will help us see what's going on underneath and decide the next step. I think blood tests makes sense here, for breathlessness. No exertion for now, I am arranging urgent specialist tests."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.02,
      "end_seconds": 345.95,
      "duration_seconds": 4.93,
      "text": "I'm going to send a referral to the pulmonary hypertension service"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.1,
      "end_seconds": 351.8,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.48,
      "end_seconds": 361.89,
      "duration_seconds": 8.41,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again in one week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.26,
      "end_seconds": 365.55,
      "duration_seconds": 2.29,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.14,
      "end_seconds": 368.73,
      "duration_seconds": 2.59,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.53,
      "end_seconds": 372.5,
      "duration_seconds": 2.97,
      "text": "Mm, thank you, that's helpful."
    }
  ]
}