{
  "schema_version": "1.0",
  "encounter_id": "02523",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.19,
      "duration_seconds": 3.28,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 8.69,
      "duration_seconds": 3.71,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.07,
      "end_seconds": 19.72,
      "duration_seconds": 9.65,
      "text": "Well, doctor, it's severe pain in my left side going to the groin. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.86,
      "end_seconds": 22.83,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.36,
      "end_seconds": 27.31,
      "duration_seconds": 3.95,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.89,
      "end_seconds": 30.95,
      "duration_seconds": 2.06,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.9,
      "end_seconds": 35.56,
      "duration_seconds": 3.66,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.55,
      "end_seconds": 46.31,
      "duration_seconds": 2.76,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.74,
      "end_seconds": 51.66,
      "duration_seconds": 3.92,
      "text": "I've had migraines for about ten years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.49,
      "end_seconds": 59.65,
      "duration_seconds": 6.16,
      "text": "Right, so migraines is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.21,
      "end_seconds": 70.73,
      "duration_seconds": 2.52,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.94,
      "end_seconds": 76.46,
      "duration_seconds": 4.52,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.13,
      "end_seconds": 79.31,
      "duration_seconds": 2.18,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.95,
      "end_seconds": 87.19,
      "duration_seconds": 6.24,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.19,
      "end_seconds": 105.99,
      "duration_seconds": 3.8,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.01,
      "end_seconds": 113.06,
      "duration_seconds": 5.05,
      "text": "Right, I take propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.66,
      "end_seconds": 124.83,
      "duration_seconds": 7.17,
      "text": "Let me check a few things. Any burning when passing urine, passing no urine or vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.47,
      "end_seconds": 127.79,
      "duration_seconds": 2.32,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.11,
      "end_seconds": 132.99,
      "duration_seconds": 3.88,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.5,
      "end_seconds": 136.03,
      "duration_seconds": 2.53,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.68,
      "end_seconds": 139.56,
      "duration_seconds": 2.88,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.41,
      "end_seconds": 151.84,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.95,
      "end_seconds": 177.79,
      "duration_seconds": 5.84,
      "text": "Okay: blood pressure 121 over 72, pulse is 67 beats a minute."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.29,
      "end_seconds": 180.68,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.06,
      "end_seconds": 186.37,
      "duration_seconds": 4.31,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.37,
      "end_seconds": 190.07,
      "duration_seconds": 2.7,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.62,
      "end_seconds": 191.64,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.46,
      "end_seconds": 196.88,
      "duration_seconds": 3.42,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.21,
      "end_seconds": 216.07,
      "duration_seconds": 6.86,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.71,
      "end_seconds": 221.05,
      "duration_seconds": 2.34,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.34,
      "end_seconds": 250.92,
      "duration_seconds": 21.58,
      "text": "Having listened and examined, it fits best with kidney stone colic. Stop me if I've got anything wrong. You've had severe pain in your left side going to the groin for about four days, and no burning when passing urine or passing no urine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.35,
      "end_seconds": 255.37,
      "duration_seconds": 3.02,
      "text": "Yes, you know, you've got it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.41,
      "end_seconds": 279.66,
      "duration_seconds": 22.25,
      "text": "We should do kidney function tests for renal colic. I'm prescribing diclofenac, 75 milligrams, once now, single dose. It's for renal colic. Drink plenty of water and strain the urine to catch the stone. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Let's review you in one week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.92,
      "end_seconds": 281.62,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.31,
      "end_seconds": 288.08,
      "duration_seconds": 5.77,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.7,
      "end_seconds": 300.45,
      "duration_seconds": 10.75,
      "text": "So, you know, I take the diclofenac, 75 milligrams, once now and come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.43,
      "end_seconds": 307.59,
      "duration_seconds": 5.16,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.63,
      "end_seconds": 311.87,
      "duration_seconds": 3.24,
      "text": "I think I understand everything. Thanks."
    }
  ]
}