{
  "schema_version": "1.0",
  "encounter_id": "02758",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.09,
      "duration_seconds": 3.4,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.98,
      "end_seconds": 13.75,
      "duration_seconds": 3.77,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.51,
      "end_seconds": 24.43,
      "duration_seconds": 8.92,
      "text": "Honestly, it's severe tummy pain out of proportion to the examination, and and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.21,
      "end_seconds": 29.51,
      "duration_seconds": 3.3,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.05,
      "end_seconds": 32.16,
      "duration_seconds": 2.11,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.17,
      "end_seconds": 36.51,
      "duration_seconds": 3.34,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.09,
      "end_seconds": 43.06,
      "duration_seconds": 4.97,
      "text": "I'd give it a five, you know, out of ten"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.41,
      "end_seconds": 47.13,
      "duration_seconds": 2.72,
      "text": "Have you been feeling very unwell?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.02,
      "end_seconds": 50.69,
      "duration_seconds": 1.67,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.09,
      "end_seconds": 55.31,
      "duration_seconds": 4.22,
      "text": "understood. Have you had any fever, chest pain or hernia?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.81,
      "end_seconds": 60.27,
      "duration_seconds": 3.46,
      "text": "No, no fever, chest pain or hernia."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.98,
      "end_seconds": 63.93,
      "duration_seconds": 1.95,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.75,
      "end_seconds": 67.29,
      "duration_seconds": 2.54,
      "text": "no, uh, nothing there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.11,
      "end_seconds": 75.3,
      "duration_seconds": 5.19,
      "text": "alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.05,
      "end_seconds": 78.05,
      "duration_seconds": 2.0,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 95.87,
      "duration_seconds": 3.79,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.22,
      "end_seconds": 105.97,
      "duration_seconds": 8.75,
      "text": "An irregular heartbeat, for about a year. I just want to get back to normal, really"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 116.86,
      "duration_seconds": 2.39,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.43,
      "end_seconds": 121.42,
      "duration_seconds": 2.99,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.29,
      "end_seconds": 125.7,
      "duration_seconds": 2.41,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.89,
      "end_seconds": 128.47,
      "duration_seconds": 1.58,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.6,
      "end_seconds": 143.76,
      "duration_seconds": 3.16,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.47,
      "end_seconds": 154.53,
      "duration_seconds": 5.06,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.06,
      "end_seconds": 158.29,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.77,
      "end_seconds": 163.06,
      "duration_seconds": 3.29,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.79,
      "end_seconds": 165.79,
      "duration_seconds": 2.0,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 171.96,
      "duration_seconds": 4.17,
      "text": "Bisoprolol, 2.5 milligrams, once a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.4,
      "end_seconds": 188.9,
      "duration_seconds": 3.5,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.35,
      "end_seconds": 201.12,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.16,
      "end_seconds": 220.11,
      "duration_seconds": 7.95,
      "text": "okay: temperature is 36.7 degrees, pulse is 124 beats a a minute, blood pressure 117 over 81."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.26,
      "end_seconds": 227.22,
      "duration_seconds": 4.96,
      "text": "Let me look at the the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.37,
      "end_seconds": 232.95,
      "duration_seconds": 1.58,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.26,
      "end_seconds": 235.66,
      "duration_seconds": 1.4,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.77,
      "end_seconds": 259.0,
      "duration_seconds": 10.23,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.99,
      "end_seconds": 261.69,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.39,
      "end_seconds": 272.55,
      "duration_seconds": 7.16,
      "text": "you can sit up now. Okay, so my impression is this: This looks most like possible bowel ischaemia"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.3,
      "end_seconds": 276.24,
      "duration_seconds": 1.94,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.86,
      "end_seconds": 297.51,
      "duration_seconds": 20.65,
      "text": "I can't promise yet, but most people with possible bowel ischaemia do well once it's treated properly. Just to be sure I understood. You've had severe tummy pain out of proportion to the examination for two weeks, and no fever or hernia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.56,
      "end_seconds": 301.1,
      "duration_seconds": 1.54,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.91,
      "end_seconds": 328.84,
      "duration_seconds": 25.93,
      "text": "Let's book urgent blood tests to look into severe abdominal pain. This is an emergency, you are going to hospital now. Let's get you seen by the surgical team, I'll arrange the letter. If the symptoms get worse, or you feel really unwell, please come to the the emergency department. Let's plan a check straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.25,
      "end_seconds": 333.05,
      "duration_seconds": 2.8,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.96,
      "end_seconds": 335.28,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}