{
  "schema_version": "1.0",
  "encounter_id": "02808",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.27,
      "duration_seconds": 3.61,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.6,
      "end_seconds": 13.25,
      "duration_seconds": 4.65,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.59,
      "end_seconds": 24.53,
      "duration_seconds": 9.94,
      "text": "Mainly bright red blood on the paper. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.63,
      "end_seconds": 27.86,
      "duration_seconds": 2.23,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.34,
      "end_seconds": 38.74,
      "duration_seconds": 7.4,
      "text": "It's been three weeks, I'm fairly sure. There's a lump around the back passage as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.32,
      "end_seconds": 42.26,
      "duration_seconds": 1.94,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.46,
      "end_seconds": 55.75,
      "duration_seconds": 2.29,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.61,
      "end_seconds": 85.18,
      "duration_seconds": 10.57,
      "text": "Okay: SpO2 99 percent on room air, pressure 112 over 70, pulse is 66 beats a minute, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.55,
      "end_seconds": 88.09,
      "duration_seconds": 1.54,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.16,
      "end_seconds": 93.55,
      "duration_seconds": 3.39,
      "text": "So, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.38,
      "end_seconds": 101.62,
      "duration_seconds": 5.24,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.79,
      "end_seconds": 103.49,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.74,
      "end_seconds": 105.91,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.34,
      "end_seconds": 132.84,
      "duration_seconds": 8.5,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.71,
      "end_seconds": 137.63,
      "duration_seconds": 1.92,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.27,
      "end_seconds": 158.08,
      "duration_seconds": 4.81,
      "text": "Have you noticed black stools, weight loss or change in bowel habit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.03,
      "end_seconds": 164.02,
      "duration_seconds": 4.99,
      "text": "Let me think, no, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.06,
      "end_seconds": 168.59,
      "duration_seconds": 2.53,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 171.05,
      "duration_seconds": 1.81,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.1,
      "end_seconds": 188.94,
      "duration_seconds": 3.84,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.6,
      "end_seconds": 193.07,
      "duration_seconds": 2.47,
      "text": "Yes, I'm allergic to amoxicillin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.7,
      "end_seconds": 196.69,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.66,
      "end_seconds": 204.76,
      "duration_seconds": 6.1,
      "text": "I'm on iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.74,
      "end_seconds": 209.6,
      "duration_seconds": 2.86,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.17,
      "end_seconds": 214.13,
      "duration_seconds": 3.96,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.37,
      "end_seconds": 216.99,
      "duration_seconds": 1.62,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.49,
      "end_seconds": 220.17,
      "duration_seconds": 2.68,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.97,
      "end_seconds": 227.48,
      "duration_seconds": 5.51,
      "text": "Has anyone ever diagnosed you with something? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.36,
      "end_seconds": 234.32,
      "duration_seconds": 5.96,
      "text": "Mm, um, I've had low haemoglobin for about ten years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.6,
      "end_seconds": 260.94,
      "duration_seconds": 12.34,
      "text": "So where does that leave us? It fits best with haemorrhoids. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.1,
      "end_seconds": 264.11,
      "duration_seconds": 2.01,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.1,
      "end_seconds": 274.29,
      "duration_seconds": 8.19,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.77,
      "end_seconds": 298.54,
      "duration_seconds": 5.77,
      "text": "Eat more fibre and drink water. Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.06,
      "end_seconds": 299.76,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.7,
      "end_seconds": 305.92,
      "duration_seconds": 4.22,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.73,
      "end_seconds": 308.24,
      "duration_seconds": 1.51,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.79,
      "end_seconds": 310.99,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}