{
  "schema_version": "1.0",
  "encounter_id": "02550",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.86,
      "duration_seconds": 3.1,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.54,
      "end_seconds": 8.61,
      "duration_seconds": 3.07,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.61,
      "end_seconds": 12.23,
      "duration_seconds": 2.62,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.3,
      "end_seconds": 23.1,
      "duration_seconds": 5.8,
      "text": "Um, so... stiff aching shoulders and hips. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 24.4,
      "end_seconds": 31.68,
      "duration_seconds": 7.28,
      "text": "Here are the the numbers, doctor. Temperature 36.9, heart rate 76, pressure 125 over 80."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.0,
      "end_seconds": 36.71,
      "duration_seconds": 2.71,
      "text": "Okay, noted. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.81,
      "end_seconds": 40.23,
      "duration_seconds": 1.42,
      "text": "just since yesterday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.88,
      "end_seconds": 49.3,
      "duration_seconds": 8.42,
      "text": "Can you describe it a bit more for me? How strong it is, what the the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.23,
      "end_seconds": 55.3,
      "duration_seconds": 4.07,
      "text": "It's every other day. It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.31,
      "end_seconds": 59.04,
      "duration_seconds": 2.73,
      "text": "has there been a mild temperature too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.81,
      "end_seconds": 76.07,
      "duration_seconds": 15.26,
      "text": "yes, actually about mild temperature, it's mild, honestly it happens a few times a day i've had difficulty getting out of bed too, for about four days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.3,
      "end_seconds": 78.04,
      "duration_seconds": 1.74,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.17,
      "end_seconds": 83.41,
      "duration_seconds": 4.24,
      "text": "and I've been feeling tired and low as well"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.32,
      "end_seconds": 100.23,
      "duration_seconds": 3.91,
      "text": "Have you had any headache or visual changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.23,
      "end_seconds": 103.65,
      "duration_seconds": 2.42,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.13,
      "end_seconds": 111.94,
      "duration_seconds": 6.81,
      "text": "Let me check a few things. Any weight loss or jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.91,
      "end_seconds": 117.23,
      "duration_seconds": 4.32,
      "text": "No, no weight loss or jaw pain on chewing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.29,
      "end_seconds": 122.62,
      "duration_seconds": 4.33,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.95,
      "end_seconds": 127.96,
      "duration_seconds": 2.01,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.78,
      "end_seconds": 134.14,
      "duration_seconds": 4.36,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.63,
      "end_seconds": 141.12,
      "duration_seconds": 2.49,
      "text": "no, that side's been fine"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.16,
      "end_seconds": 146.17,
      "duration_seconds": 3.01,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.77,
      "end_seconds": 160.38,
      "duration_seconds": 12.61,
      "text": "I grab fast food at lunch most days. I live with my elderly mother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.38,
      "end_seconds": 179.62,
      "duration_seconds": 5.24,
      "text": "So, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.02,
      "end_seconds": 186.49,
      "duration_seconds": 5.47,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.77,
      "end_seconds": 190.29,
      "duration_seconds": 2.52,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.36,
      "end_seconds": 196.27,
      "duration_seconds": 3.91,
      "text": "Arthritis in my knees, for nearly five years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.77,
      "end_seconds": 198.75,
      "duration_seconds": 0.98,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.5,
      "end_seconds": 204.29,
      "duration_seconds": 3.79,
      "text": "I have thin bones, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.2,
      "end_seconds": 212.56,
      "duration_seconds": 6.36,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.69,
      "end_seconds": 233.72,
      "duration_seconds": 3.03,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.29,
      "end_seconds": 236.62,
      "duration_seconds": 2.33,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.56,
      "end_seconds": 239.68,
      "duration_seconds": 2.12,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.31,
      "end_seconds": 245.02,
      "duration_seconds": 4.71,
      "text": "I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 245.92,
      "end_seconds": 251.11,
      "duration_seconds": 5.19,
      "text": "doctor, our chart from the last visit lists it as 35 milligrams"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.2,
      "end_seconds": 258.36,
      "duration_seconds": 5.16,
      "text": "Okay. Have you got the newest prescription or the the box with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.4,
      "end_seconds": 263.98,
      "duration_seconds": 3.58,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.06,
      "end_seconds": 268.03,
      "duration_seconds": 2.97,
      "text": "so, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.91,
      "end_seconds": 273.7,
      "duration_seconds": 3.79,
      "text": "just part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.46,
      "end_seconds": 279.83,
      "duration_seconds": 3.37,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.49,
      "end_seconds": 284.59,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.88,
      "end_seconds": 299.95,
      "duration_seconds": 7.07,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.92,
      "end_seconds": 316.13,
      "duration_seconds": 13.21,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: The most likely explanation is polymyalgia rheumatica. It could also be rheumatoid arthritis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.54,
      "end_seconds": 319.66,
      "duration_seconds": 2.12,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.97,
      "end_seconds": 340.82,
      "duration_seconds": 19.85,
      "text": "I can't promise yet, but most people with polymyalgia rheumatica do well once it's treated properly. I'm going to order blood tests, for proximal stiffness. I'm going to put you on prednisolone, 15 milligrams, once a day, reducing course. You take it by mouth. It's for polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.54,
      "end_seconds": 343.66,
      "duration_seconds": 1.12,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.6,
      "end_seconds": 370.32,
      "duration_seconds": 25.72,
      "text": "Report any headache or jaw pain immediately. And please bring the latest prescription or the the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: you get a new headache or visual changes. In that case don't wait. I'd like you back in two weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.11,
      "end_seconds": 374.43,
      "duration_seconds": 2.32,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.11,
      "end_seconds": 378.91,
      "duration_seconds": 3.8,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.66,
      "end_seconds": 384.33,
      "duration_seconds": 3.67,
      "text": "I, I think I understand everything. Thanks."
    }
  ]
}