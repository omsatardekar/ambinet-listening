{
  "schema_version": "1.0",
  "encounter_id": "02544",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.07,
      "end_seconds": 6.22,
      "duration_seconds": 5.15,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 11.15,
      "duration_seconds": 4.24,
      "text": "thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.48,
      "end_seconds": 19.12,
      "duration_seconds": 6.64,
      "text": "It's a blocked nose for months. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 20.37,
      "end_seconds": 30.46,
      "duration_seconds": 10.09,
      "text": "Here are the numbers, doctor. Pulse is 82 beats a minute, respiratory rate 16, BP is 109 over 71, temperature 36.4."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.62,
      "end_seconds": 35.96,
      "duration_seconds": 4.34,
      "text": "okay, noted how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.03,
      "end_seconds": 40.62,
      "duration_seconds": 2.59,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.93,
      "end_seconds": 44.86,
      "duration_seconds": 3.93,
      "text": "I see, go ahead. Has there been any fever?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.44,
      "end_seconds": 51.47,
      "duration_seconds": 5.03,
      "text": "well, you know, not that I've noticed, no fever"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.59,
      "end_seconds": 59.61,
      "duration_seconds": 4.02,
      "text": "have you noticed nosebleeds, vision changes or facial swelling?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.46,
      "end_seconds": 66.45,
      "duration_seconds": 4.99,
      "text": "no nosebleeds, vision changes or facial swelling, none of it"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.13,
      "end_seconds": 71.35,
      "duration_seconds": 4.22,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.07,
      "end_seconds": 74.64,
      "duration_seconds": 1.57,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.38,
      "end_seconds": 90.02,
      "duration_seconds": 3.64,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.96,
      "end_seconds": 92.36,
      "duration_seconds": 1.4,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.73,
      "end_seconds": 111.33,
      "duration_seconds": 1.6,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.88,
      "end_seconds": 114.39,
      "duration_seconds": 1.51,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 116.74,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.7,
      "end_seconds": 121.77,
      "duration_seconds": 4.07,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.55,
      "end_seconds": 126.93,
      "duration_seconds": 4.38,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.32,
      "end_seconds": 132.3,
      "duration_seconds": 3.98,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.39,
      "end_seconds": 137.29,
      "duration_seconds": 2.9,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.19,
      "end_seconds": 143.86,
      "duration_seconds": 4.67,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.37,
      "end_seconds": 146.13,
      "duration_seconds": 1.76,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.81,
      "end_seconds": 150.36,
      "duration_seconds": 3.55,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.53,
      "end_seconds": 171.77,
      "duration_seconds": 4.24,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.57,
      "end_seconds": 174.59,
      "duration_seconds": 2.02,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.17,
      "end_seconds": 180.17,
      "duration_seconds": 4.0,
      "text": "Understood. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.14,
      "end_seconds": 187.83,
      "duration_seconds": 5.69,
      "text": "I take Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.9,
      "end_seconds": 193.79,
      "duration_seconds": 3.89,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.48,
      "end_seconds": 198.32,
      "duration_seconds": 2.84,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.15,
      "end_seconds": 213.84,
      "duration_seconds": 3.69,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.35,
      "end_seconds": 221.81,
      "duration_seconds": 2.46,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 246.77,
      "duration_seconds": 6.91,
      "text": "So, based on the history and the examination, the most likely explanation is nasal polyps."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.45,
      "end_seconds": 249.24,
      "duration_seconds": 1.79,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.2,
      "end_seconds": 267.95,
      "duration_seconds": 16.75,
      "text": "I understand the worry. At the moment I'd say it's nasal polyps, and we'll watch how it goes. Let me just check I've got this right. You've had a blocked nose for months for two weeks, and no vision changes or fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.53,
      "end_seconds": 270.23,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.85,
      "end_seconds": 281.4,
      "duration_seconds": 10.55,
      "text": "For this, mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That should help with nasal polyps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.48,
      "end_seconds": 286.53,
      "duration_seconds": 3.05,
      "text": "Okay, so fine, I'll begin it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.58,
      "end_seconds": 294.63,
      "duration_seconds": 7.05,
      "text": "See me again in eight weeks. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.15,
      "end_seconds": 308.72,
      "duration_seconds": 13.57,
      "text": "So, you know, I take the mometasone nasal spray, 50 micrograms, two sprays each side once a day and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.41,
      "end_seconds": 315.64,
      "duration_seconds": 4.23,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 316.67,
      "end_seconds": 318.79,
      "duration_seconds": 2.12,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.42,
      "end_seconds": 320.9,
      "duration_seconds": 1.48,
      "text": "Goodbye for now."
    }
  ]
}