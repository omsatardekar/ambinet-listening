      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.87,
      "end_seconds": 233.95,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
