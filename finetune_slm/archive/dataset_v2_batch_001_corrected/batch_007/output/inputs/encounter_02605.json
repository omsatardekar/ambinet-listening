      "role": "DOCTOR",
      "start_seconds": 216.23,
      "end_seconds": 225.1,
      "duration_seconds": 8.87,
      "text": "Okay: blood pressure 116 over 69, SpO2 99 percent on room air. And pulse 76, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.24,
      "end_seconds": 230.12,
      "duration_seconds": 2.88,
      "text": "Let's move on to the examination."
