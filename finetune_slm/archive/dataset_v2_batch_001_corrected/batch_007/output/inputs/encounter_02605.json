      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.64,
      "end_seconds": 256.07,
      "duration_seconds": 7.43,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
