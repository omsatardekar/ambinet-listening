{
  "schema_version": "1.0",
  "encounter_id": "02826",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 6.14,
      "duration_seconds": 5.22,
      "text": "Good evening, you know, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.17,
      "end_seconds": 11.01,
      "duration_seconds": 3.84,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.21,
      "end_seconds": 17.46,
      "duration_seconds": 5.25,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.31,
      "end_seconds": 29.91,
      "duration_seconds": 10.6,
      "text": "Doctor, it's a rolled ankle. It's getting on my nerves now. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.94,
      "end_seconds": 34.8,
      "duration_seconds": 3.86,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.53,
      "end_seconds": 40.08,
      "duration_seconds": 2.55,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.4,
      "end_seconds": 45.96,
      "duration_seconds": 1.56,
      "text": "does anything help it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.85,
      "end_seconds": 56.14,
      "duration_seconds": 8.29,
      "text": "Only rest and ice, and it's not much. I had bruising before. That's settled now, though."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.15,
      "end_seconds": 60.99,
      "duration_seconds": 2.84,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.4,
      "end_seconds": 71.9,
      "duration_seconds": 2.5,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.79,
      "end_seconds": 92.03,
      "duration_seconds": 10.24,
      "text": "Okay: temp 36.5 degrees, respiratory rate 18, blood pressure 127 over 82, SpO2 97 percent on room air, heart rate 77."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.83,
      "end_seconds": 98.74,
      "duration_seconds": 4.91,
      "text": "Let me look at the the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.06,
      "end_seconds": 103.16,
      "duration_seconds": 3.1,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.06,
      "end_seconds": 120.01,
      "duration_seconds": 7.95,
      "text": "There is mild swelling over the the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.64,
      "end_seconds": 126.99,
      "duration_seconds": 2.35,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.54,
      "end_seconds": 147.74,
      "duration_seconds": 4.2,
      "text": "And what about pop, numbness or pain in the foot?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.65,
      "end_seconds": 155.92,
      "duration_seconds": 6.27,
      "text": "No pop, numbness or pain in the foot, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 160.33,
      "duration_seconds": 4.01,
      "text": "Mm, okay. Any sign of pain in the shin?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.62,
      "end_seconds": 164.55,
      "duration_seconds": 2.93,
      "text": "Nope, no pain in the shin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.08,
      "end_seconds": 169.62,
      "duration_seconds": 4.54,
      "text": "Sure. So, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.38,
      "end_seconds": 180.52,
      "duration_seconds": 5.14,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.42,
      "end_seconds": 190.75,
      "duration_seconds": 8.33,
      "text": "Do you have any medical conditions I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.31,
      "end_seconds": 192.84,
      "duration_seconds": 1.53,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 212.84,
      "duration_seconds": 2.62,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 217.55,
      "duration_seconds": 3.62,
      "text": "It's ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.04,
      "end_seconds": 222.06,
      "duration_seconds": 3.02,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.36,
      "end_seconds": 228.93,
      "duration_seconds": 1.57,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 237.48,
      "duration_seconds": 8.03,
      "text": "are you allergic to anything? Any allergies to medicines or foods? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.36,
      "end_seconds": 241.1,
      "duration_seconds": 2.74,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.09,
      "end_seconds": 244.55,
      "duration_seconds": 2.46,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.6,
      "end_seconds": 249.5,
      "duration_seconds": 3.9,
      "text": "I had a bunion operation six years ago"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.2,
      "end_seconds": 255.71,
      "duration_seconds": 4.51,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.26,
      "end_seconds": 259.86,
      "duration_seconds": 2.6,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.75,
      "end_seconds": 263.17,
      "duration_seconds": 1.42,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.14,
      "end_seconds": 268.27,
      "duration_seconds": 4.13,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.04,
      "end_seconds": 271.23,
      "duration_seconds": 1.19,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.08,
      "end_seconds": 276.61,
      "duration_seconds": 4.53,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.7,
      "end_seconds": 280.13,
      "duration_seconds": 2.43,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.59,
      "end_seconds": 286.17,
      "duration_seconds": 4.58,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.81,
      "end_seconds": 290.11,
      "duration_seconds": 2.3,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.93,
      "end_seconds": 296.18,
      "duration_seconds": 4.25,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.39,
      "end_seconds": 331.02,
      "duration_seconds": 19.63,
      "text": "Rest, ice, compression and elevation, then gradual strengthening. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's review you if not better in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.0,
      "end_seconds": 335.27,
      "duration_seconds": 2.27,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.68,
      "end_seconds": 340.87,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}