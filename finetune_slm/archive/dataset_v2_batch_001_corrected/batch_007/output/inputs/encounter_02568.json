{
  "schema_version": "1.0",
  "encounter_id": "02568",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 7.74,
      "duration_seconds": 7.03,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.24,
      "end_seconds": 16.29,
      "duration_seconds": 4.05,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.94,
      "end_seconds": 27.32,
      "duration_seconds": 6.38,
      "text": "Um, so... a blister on my heel. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 33.07,
      "duration_seconds": 3.73,
      "text": "So, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.13,
      "end_seconds": 38.2,
      "duration_seconds": 3.07,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.42,
      "end_seconds": 40.92,
      "duration_seconds": 2.5,
      "text": "Understood. Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.98,
      "end_seconds": 44.93,
      "duration_seconds": 2.95,
      "text": "New shoes definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.24,
      "end_seconds": 49.14,
      "duration_seconds": 3.9,
      "text": "Yes, carry on. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.99,
      "end_seconds": 63.32,
      "duration_seconds": 10.33,
      "text": "When it it starts I tend to get a little soreness as well. The little soreness? That's been since last night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.28,
      "end_seconds": 68.35,
      "duration_seconds": 3.07,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.1,
      "end_seconds": 81.54,
      "duration_seconds": 2.44,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.09,
      "end_seconds": 100.5,
      "duration_seconds": 4.41,
      "text": "Okay: heart rate 75, BP is 122 over 77."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.36,
      "end_seconds": 103.98,
      "duration_seconds": 1.62,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.2,
      "end_seconds": 107.17,
      "duration_seconds": 1.97,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.57,
      "end_seconds": 111.95,
      "duration_seconds": 3.38,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.55,
      "end_seconds": 115.55,
      "duration_seconds": 2.0,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.97,
      "end_seconds": 135.14,
      "duration_seconds": 6.17,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.91,
      "end_seconds": 147.39,
      "duration_seconds": 7.48,
      "text": "Good, you can sit up again. Did you get pus, fever, diabetes or redness spreading?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.27,
      "end_seconds": 153.24,
      "duration_seconds": 4.97,
      "text": "No pus, fever, diabetes or redness spreading, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.73,
      "end_seconds": 157.4,
      "duration_seconds": 3.67,
      "text": "understood has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.32,
      "end_seconds": 162.69,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.71,
      "end_seconds": 168.2,
      "duration_seconds": 2.49,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.52,
      "end_seconds": 172.95,
      "duration_seconds": 3.43,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.63,
      "end_seconds": 177.16,
      "duration_seconds": 2.53,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.73,
      "end_seconds": 186.69,
      "duration_seconds": 4.96,
      "text": "yes, I had a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.38,
      "end_seconds": 190.8,
      "duration_seconds": 2.42,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.26,
      "end_seconds": 200.85,
      "duration_seconds": 8.59,
      "text": "Febuxostat. I take it 80 milligrams, once a day. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.16,
      "end_seconds": 205.85,
      "duration_seconds": 3.69,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.79,
      "end_seconds": 214.78,
      "duration_seconds": 6.99,
      "text": "Gout, for nearly five years. I've had high cholesterol for about ten years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.51,
      "end_seconds": 223.07,
      "duration_seconds": 6.56,
      "text": "Understood. Right, yes, gout is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.0,
      "end_seconds": 243.73,
      "duration_seconds": 2.73,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.65,
      "end_seconds": 249.04,
      "duration_seconds": 4.39,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.06,
      "end_seconds": 252.47,
      "duration_seconds": 2.41,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.16,
      "end_seconds": 257.49,
      "duration_seconds": 4.33,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.04,
      "end_seconds": 261.26,
      "duration_seconds": 2.22,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.92,
      "end_seconds": 267.07,
      "duration_seconds": 4.15,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.8,
      "end_seconds": 286.28,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.01,
      "end_seconds": 296.35,
      "duration_seconds": 9.34,
      "text": "I had a reaction to erythromycin when I was younger, bad stomach cramps, and I've avoided it since."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.97,
      "end_seconds": 303.07,
      "duration_seconds": 5.1,
      "text": "Any inherited conditions that you know of in the the family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.53,
      "end_seconds": 309.81,
      "duration_seconds": 5.28,
      "text": "Sorry, what was I saying, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.97,
      "end_seconds": 330.57,
      "duration_seconds": 6.6,
      "text": "Let me tell you where I've got to. It fits best with a a simple friction blister."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.95,
      "end_seconds": 337.5,
      "duration_seconds": 2.55,
      "text": "Is it it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.64,
      "end_seconds": 365.66,
      "duration_seconds": 27.02,
      "text": "I understand the worry. At the moment I'd say it's a simple friction blister, and we'll watch how it it goes. Leave it intact, cover it with a padded plaster and change the shoes. Do get help quickly if the area becomes red, hot or pus-filled. I'd like you back if it looks infected."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.95,
      "end_seconds": 369.58,
      "duration_seconds": 2.63,
      "text": "I can manage that that"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.79,
      "end_seconds": 373.59,
      "duration_seconds": 2.8,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.69,
      "end_seconds": 377.96,
      "duration_seconds": 3.27,
      "text": "good, thanks, I'll see you then"
    }
  ]
}