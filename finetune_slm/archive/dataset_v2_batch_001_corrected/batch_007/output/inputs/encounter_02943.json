{
  "schema_version": "1.0",
  "encounter_id": "02943",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 9.47,
      "duration_seconds": 8.67,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.47,
      "end_seconds": 15.06,
      "duration_seconds": 3.59,
      "text": "Alright, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.65,
      "end_seconds": 22.96,
      "duration_seconds": 6.31,
      "text": "um, so... a sudden painful cold leg that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.49,
      "end_seconds": 28.26,
      "duration_seconds": 3.77,
      "text": "Can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.82,
      "end_seconds": 34.4,
      "duration_seconds": 5.58,
      "text": "Ever since... since last Tuesday, really. I've also had a pale leg."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.36,
      "end_seconds": 46.44,
      "duration_seconds": 7.08,
      "text": "Have you had a sudden painful cold leg before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.99,
      "end_seconds": 52.86,
      "duration_seconds": 5.87,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.7,
      "end_seconds": 56.39,
      "duration_seconds": 1.69,
      "text": "How about recent injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.09,
      "end_seconds": 59.18,
      "duration_seconds": 2.09,
      "text": "No recent injury, thankfully."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.72,
      "end_seconds": 63.08,
      "duration_seconds": 3.36,
      "text": "any chest pain or fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.74,
      "end_seconds": 67.23,
      "duration_seconds": 3.49,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.25,
      "end_seconds": 72.06,
      "duration_seconds": 2.81,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.23,
      "end_seconds": 76.11,
      "duration_seconds": 2.88,
      "text": "Uh, no, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.19,
      "end_seconds": 80.39,
      "duration_seconds": 2.2,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.13,
      "end_seconds": 83.8,
      "duration_seconds": 2.67,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.21,
      "end_seconds": 87.78,
      "duration_seconds": 2.57,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.16,
      "end_seconds": 94.48,
      "duration_seconds": 5.32,
      "text": "It's apixaban, 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.2,
      "end_seconds": 97.31,
      "duration_seconds": 2.11,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.37,
      "end_seconds": 110.88,
      "duration_seconds": 8.51,
      "text": "Yes, I had a a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.81,
      "end_seconds": 126.21,
      "duration_seconds": 1.4,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.36,
      "end_seconds": 130.83,
      "duration_seconds": 3.47,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.14,
      "end_seconds": 136.35,
      "duration_seconds": 2.21,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.98,
      "end_seconds": 145.6,
      "duration_seconds": 3.62,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.62,
      "end_seconds": 150.86,
      "duration_seconds": 4.24,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.95,
      "end_seconds": 155.66,
      "duration_seconds": 3.71,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.2,
      "end_seconds": 163.37,
      "duration_seconds": 3.17,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.56,
      "end_seconds": 167.07,
      "duration_seconds": 2.51,
      "text": "my father had bowel cancer"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.42,
      "end_seconds": 181.08,
      "duration_seconds": 2.66,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.68,
      "end_seconds": 189.65,
      "duration_seconds": 6.97,
      "text": "I have an irregular heartbeat, for five years. I've had heart failure, yes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 198.9,
      "end_seconds": 210.99,
      "duration_seconds": 12.09,
      "text": "Okay, so the vitals from earlier. Blood pressure 128 over 71, pulse is 114 beats a minute, temperature is 37.1 degrees, saturation 97 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.47,
      "end_seconds": 213.5,
      "duration_seconds": 1.03,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.16,
      "end_seconds": 218.01,
      "duration_seconds": 2.85,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.64,
      "end_seconds": 220.74,
      "duration_seconds": 1.1,
      "text": "of course"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.83,
      "end_seconds": 224.46,
      "duration_seconds": 2.63,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.83,
      "end_seconds": 248.49,
      "duration_seconds": 7.66,
      "text": "the right leg is cold, pale and mottled, with no pulses at the groin or below"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.18,
      "end_seconds": 275.18,
      "duration_seconds": 22.0,
      "text": "please sit back down so where does that leave us? It points towards an acutely ischaemic leg we shouldn't forget a deep vein thrombosis stop me if I've got anything wrong you've had a sudden painful cold leg, since last Tuesday, and no chest pain or fever"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.16,
      "end_seconds": 278.28,
      "duration_seconds": 2.12,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.23,
      "end_seconds": 302.56,
      "duration_seconds": 23.33,
      "text": "I'll request an urgent CT angiogram, it'll help with acute limb ischaemia. What I'm giving you is heparin, 5000 units, bolus now, single dose. It's for limb ischaemia. You need the vascular surgeons now, this is time critical. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 303.6,
      "end_seconds": 306.87,
      "duration_seconds": 3.27,
      "text": "Okay, so thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.95,
      "end_seconds": 310.27,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}