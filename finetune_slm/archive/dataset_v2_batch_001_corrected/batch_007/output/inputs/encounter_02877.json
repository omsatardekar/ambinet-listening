    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.2,
      "end_seconds": 45.34,
      "duration_seconds": 11.14,
      "text": "It sort of comes and goes. Okay, so I've had an itchy rash first too, for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.33,
      "end_seconds": 51.36,
      "duration_seconds": 4.03,
      "text": "So, rate it for me, mild, moderate or severe?"
