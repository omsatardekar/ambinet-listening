    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.66,
      "end_seconds": 84.85,
      "duration_seconds": 4.19,
      "text": "I grab fast food at lunch most days."
