      "end_seconds": 7.67,
      "duration_seconds": 6.29,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 12.95,
      "duration_seconds": 4.31,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.48,
      "end_seconds": 20.31,
      "duration_seconds": 6.83,
      "text": "Yeah, um, it's itchy blisters. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.85,
      "end_seconds": 23.89,
      "duration_seconds": 2.04,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.12,
      "end_seconds": 28.73,
      "duration_seconds": 3.61,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.04,
      "end_seconds": 32.92,
      "duration_seconds": 2.88,
      "text": "how often do you get it?"
