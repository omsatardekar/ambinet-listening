    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.71,
      "end_seconds": 58.34,
      "duration_seconds": 5.63,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.41,
      "end_seconds": 63.62,
      "duration_seconds": 3.21,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.22,
      "end_seconds": 67.72,
      "duration_seconds": 3.5,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.69,
      "end_seconds": 71.06,
      "duration_seconds": 1.37,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.97,
      "end_seconds": 75.83,
      "duration_seconds": 3.86,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.92,
      "end_seconds": 78.6,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
