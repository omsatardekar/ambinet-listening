    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.59,
      "end_seconds": 89.97,
      "duration_seconds": 3.38,
      "text": "What do you do during the day?"
