    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.86,
      "end_seconds": 94.48,
      "duration_seconds": 3.62,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.67,
      "end_seconds": 105.65,
      "duration_seconds": 3.98,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.91,
      "end_seconds": 112.93,
      "duration_seconds": 6.02,
      "text": "High blood pressure, for nearly five years. I have heart failure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.4,
      "end_seconds": 116.04,
      "duration_seconds": 1.64,
      "text": "Is there anything more?"
