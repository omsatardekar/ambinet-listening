    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.56,
      "end_seconds": 120.26,
      "duration_seconds": 3.7,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.97,
      "end_seconds": 129.8,
      "duration_seconds": 7.83,
      "text": "It's something called vals... valsartan, 80 milligrams, maybe, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.47,
      "end_seconds": 134.68,
      "duration_seconds": 4.21,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.11,
      "end_seconds": 153.71,
      "duration_seconds": 17.6,
      "text": "not with me i'll bring it next time i'm on spironolactone, 25 milligrams, once a day for my heart i do miss it it now and then, to be fair"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.92,
      "end_seconds": 172.63,
      "duration_seconds": 4.71,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.22,
      "end_seconds": 179.83,
      "duration_seconds": 5.61,
      "text": "um, I'm allergic to walnuts, I get my lips swelling"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.31,
      "end_seconds": 186.69,
      "duration_seconds": 5.38,
      "text": "any fever, new medicine, eye problems or mouth sores at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.02,
      "end_seconds": 191.05,
      "duration_seconds": 3.03,
      "text": "Right, none of those, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.92,
      "end_seconds": 195.77,
      "duration_seconds": 2.85,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.49,
      "end_seconds": 201.46,
      "duration_seconds": 3.97,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.17,
      "end_seconds": 204.32,
      "duration_seconds": 2.15,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.89,
      "end_seconds": 207.56,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.39,
      "end_seconds": 211.56,
      "duration_seconds": 2.17,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.62,
      "end_seconds": 224.12,
      "duration_seconds": 2.5,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.61,
      "end_seconds": 247.6,
      "duration_seconds": 10.99,
      "text": "okay: pulse 64, respiratory rate 15, height 184 centimetres, weight 83 kilos, blood pressure 112 over 69, temperature 36.7, oxygen saturation is 99 percent"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.06,
      "end_seconds": 252.19,
      "duration_seconds": 3.13,
      "text": "Yeah, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.41,
      "end_seconds": 257.11,
      "duration_seconds": 3.7,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.11,
      "end_seconds": 260.62,
      "duration_seconds": 2.51,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.68,
      "end_seconds": 264.35,
      "duration_seconds": 2.67,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.98,
      "end_seconds": 284.36,
      "duration_seconds": 7.38,
      "text": "There are firm, tense blisters on a red base on the the arms and legs."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.38,
      "end_seconds": 295.76,
      "duration_seconds": 7.38,
      "text": "Good, you can sit up again. Okay, so my impression is this: It points towards bullous pemphigoid."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.72,
      "end_seconds": 328.26,
      "duration_seconds": 14.54,
      "text": "Let's book blood tests to look into blistering. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.25,
      "end_seconds": 332.39,
      "duration_seconds": 2.14,
      "text": "Thank you, that's helpful."
    }
