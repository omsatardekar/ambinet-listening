{
  "schema_version": "1.0",
  "encounter_id": "02586",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 4.82,
      "duration_seconds": 3.74,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.25,
      "end_seconds": 15.37,
      "duration_seconds": 5.12,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.31,
      "end_seconds": 24.21,
      "duration_seconds": 7.9,
      "text": "It's a growing red ring on my thigh. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.18,
      "end_seconds": 29.52,
      "duration_seconds": 3.34,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.84,
      "end_seconds": 34.01,
      "duration_seconds": 3.17,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.01,
      "end_seconds": 38.21,
      "duration_seconds": 2.2,
      "text": "Has there been tiredness too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.73,
      "end_seconds": 41.07,
      "duration_seconds": 1.34,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.48,
      "end_seconds": 42.97,
      "duration_seconds": 1.49,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.01,
      "end_seconds": 52.22,
      "duration_seconds": 7.21,
      "text": "Aching muscles was there, um, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.07,
      "end_seconds": 55.4,
      "duration_seconds": 2.33,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.06,
      "end_seconds": 60.89,
      "duration_seconds": 4.83,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.58,
      "end_seconds": 64.82,
      "duration_seconds": 3.24,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.47,
      "end_seconds": 86.22,
      "duration_seconds": 19.75,
      "text": "I have an enlarged prostate, for five years. Work has been very busy so I kept ignoring it. I have heart disease, for about a year. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.48,
      "end_seconds": 88.85,
      "duration_seconds": 1.37,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.46,
      "end_seconds": 91.75,
      "duration_seconds": 2.29,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.77,
      "end_seconds": 98.29,
      "duration_seconds": 5.52,
      "text": "Alright, an enlarged prostate and heart disease, that matches what I have here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.51,
      "end_seconds": 108.99,
      "duration_seconds": 3.48,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.92,
      "end_seconds": 113.19,
      "duration_seconds": 3.27,
      "text": "Tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.56,
      "end_seconds": 114.57,
      "duration_seconds": 1.01,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.97,
      "end_seconds": 120.23,
      "duration_seconds": 4.26,
      "text": "Aspirin. I take it once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.72,
      "end_seconds": 124.25,
      "duration_seconds": 2.53,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.78,
      "end_seconds": 133.29,
      "duration_seconds": 8.51,
      "text": "It's 75 milligrams. Actually, I take something called amlo... amlodipine, 5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.19,
      "end_seconds": 139.01,
      "duration_seconds": 4.82,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.94,
      "end_seconds": 144.17,
      "duration_seconds": 4.23,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.83,
      "end_seconds": 149.57,
      "duration_seconds": 3.74,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.83,
      "end_seconds": 155.01,
      "duration_seconds": 4.18,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.56,
      "end_seconds": 162.24,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.58,
      "end_seconds": 167.73,
      "duration_seconds": 4.15,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.25,
      "end_seconds": 170.5,
      "duration_seconds": 2.25,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.51,
      "end_seconds": 176.88,
      "duration_seconds": 4.37,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.36,
      "end_seconds": 187.07,
      "duration_seconds": 1.71,
      "text": "Any sign of palpitations?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.07,
      "end_seconds": 190.45,
      "duration_seconds": 2.38,
      "text": "No, none, no palpitations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.11,
      "end_seconds": 196.05,
      "duration_seconds": 4.94,
      "text": "Any stiff neck, facial weakness or joint swelling at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.22,
      "end_seconds": 199.35,
      "duration_seconds": 2.13,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.22,
      "end_seconds": 204.32,
      "duration_seconds": 4.1,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.27,
      "end_seconds": 209.19,
      "duration_seconds": 2.92,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.41,
      "end_seconds": 213.34,
      "duration_seconds": 2.93,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.7,
      "end_seconds": 216.5,
      "duration_seconds": 1.8,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.45,
      "end_seconds": 220.39,
      "duration_seconds": 1.94,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.42,
      "end_seconds": 231.53,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.87,
      "end_seconds": 254.87,
      "duration_seconds": 6.0,
      "text": "Okay: temperature is 36.9 degrees, blood pressure 121 over 80, heart rate 64."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.35,
      "end_seconds": 259.81,
      "duration_seconds": 3.46,
      "text": "Uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.25,
      "end_seconds": 265.79,
      "duration_seconds": 4.54,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.25,
      "end_seconds": 271.33,
      "duration_seconds": 4.08,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.57,
      "end_seconds": 275.48,
      "duration_seconds": 2.91,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.8,
      "end_seconds": 297.53,
      "duration_seconds": 6.73,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.59,
      "end_seconds": 306.16,
      "duration_seconds": 6.57,
      "text": "You can relax now. Having listened and examined, it fits best with early Lyme disease."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.47,
      "end_seconds": 310.66,
      "duration_seconds": 3.19,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.92,
      "end_seconds": 333.13,
      "duration_seconds": 21.21,
      "text": "I understand the worry. At the moment I'd say it's early Lyme disease, and we'll watch how it goes. Let me repeat that back to make sure. You've had a growing red ring on your thigh for two weeks, and no joint swelling or stiff neck."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.52,
      "end_seconds": 336.21,
      "duration_seconds": 1.69,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.34,
      "end_seconds": 354.44,
      "duration_seconds": 11.1,
      "text": "I'd like you to take doxycycline, 100 milligrams, twice a day, twenty-one days. You take it by mouth. That should help with early Lyme disease."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.29,
      "end_seconds": 361.01,
      "duration_seconds": 4.72,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.42,
      "end_seconds": 376.81,
      "duration_seconds": 11.39,
      "text": "Take the doxycycline with food and avoid strong sun. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.85,
      "end_seconds": 384.02,
      "duration_seconds": 2.17,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.41,
      "end_seconds": 387.53,
      "duration_seconds": 2.12,
      "text": "Come back in three weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.3,
      "end_seconds": 392.8,
      "duration_seconds": 3.5,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.46,
      "end_seconds": 398.56,
      "duration_seconds": 4.1,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.94,
      "end_seconds": 402.97,
      "duration_seconds": 3.03,
      "text": "Erm, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.41,
      "end_seconds": 405.66,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}