{
  "schema_version": "1.0",
  "encounter_id": "02664",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 3.4,
      "duration_seconds": 2.22,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.23,
      "end_seconds": 9.78,
      "duration_seconds": 4.55,
      "text": "Right, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.42,
      "end_seconds": 17.41,
      "duration_seconds": 1.99,
      "text": "Alright, what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.13,
      "end_seconds": 24.84,
      "duration_seconds": 5.71,
      "text": "Doctor, it's hot flushes. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.34,
      "end_seconds": 29.7,
      "duration_seconds": 3.36,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.7,
      "end_seconds": 37.53,
      "duration_seconds": 6.83,
      "text": "Well, I'd say three weeks. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.11,
      "end_seconds": 44.0,
      "duration_seconds": 4.89,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 53.75,
      "duration_seconds": 8.13,
      "text": "Maybe a five out of ten on a bad day. Honestly, on and off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.22,
      "end_seconds": 60.58,
      "duration_seconds": 4.36,
      "text": "What about periods becoming irregular, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.05,
      "end_seconds": 64.87,
      "duration_seconds": 2.82,
      "text": "Yeah. Two months, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.68,
      "end_seconds": 70.8,
      "duration_seconds": 4.12,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.72,
      "end_seconds": 83.95,
      "duration_seconds": 11.23,
      "text": "Pretty moderate, if I'm being honest. Oh, and mood swings. That's been about the same, about four days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.6,
      "end_seconds": 87.74,
      "duration_seconds": 3.14,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.81,
      "end_seconds": 90.95,
      "duration_seconds": 1.14,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.94,
      "end_seconds": 94.79,
      "duration_seconds": 2.85,
      "text": "Has there been poor sleep too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.18,
      "end_seconds": 98.38,
      "duration_seconds": 2.2,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 104.96,
      "duration_seconds": 4.96,
      "text": "Alright, did you get weight loss or bleeding after sex?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.76,
      "end_seconds": 111.02,
      "duration_seconds": 5.26,
      "text": "I haven't had weight loss or bleeding after sex, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.39,
      "end_seconds": 116.24,
      "duration_seconds": 3.85,
      "text": "Any very heavy bleeding or pelvic pain at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.2,
      "end_seconds": 123.5,
      "duration_seconds": 5.3,
      "text": "I haven't had very heavy bleeding or pelvic pain, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.03,
      "end_seconds": 127.39,
      "duration_seconds": 3.36,
      "text": "Mm-hmm. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.45,
      "end_seconds": 132.65,
      "duration_seconds": 3.2,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.4,
      "end_seconds": 137.14,
      "duration_seconds": 3.74,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.17,
      "end_seconds": 144.08,
      "duration_seconds": 5.91,
      "text": "Tiotropium inhaler. I take it once a day for my chest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.75,
      "end_seconds": 147.03,
      "duration_seconds": 1.28,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.46,
      "end_seconds": 160.94,
      "duration_seconds": 8.48,
      "text": "About nearly five years. I, I'd been on iron tablets, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 175.48,
      "duration_seconds": 3.28,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.18,
      "end_seconds": 192.53,
      "duration_seconds": 16.35,
      "text": "I only drink at family occasions. I've never touched a cigarette. I swim twice a week. My partner and our baby. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.54,
      "end_seconds": 197.83,
      "duration_seconds": 3.29,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.29,
      "end_seconds": 204.26,
      "duration_seconds": 4.97,
      "text": "My grandfather had a stroke. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.52,
      "end_seconds": 220.86,
      "duration_seconds": 4.34,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.35,
      "end_seconds": 227.07,
      "duration_seconds": 4.72,
      "text": "I've had COPD for about ten years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.63,
      "end_seconds": 231.44,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.55,
      "end_seconds": 237.47,
      "duration_seconds": 4.92,
      "text": "I have low haemoglobin, for nearly five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.43,
      "end_seconds": 243.92,
      "duration_seconds": 4.49,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.75,
      "end_seconds": 248.14,
      "duration_seconds": 2.39,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.11,
      "end_seconds": 251.36,
      "duration_seconds": 2.25,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.8,
      "end_seconds": 260.76,
      "duration_seconds": 2.96,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.74,
      "end_seconds": 282.77,
      "duration_seconds": 9.03,
      "text": "Okay: pulse 71, temperature 36.7. And respiratory rate 15, BP is 117 over 73, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.22,
      "end_seconds": 289.17,
      "duration_seconds": 3.95,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.36,
      "end_seconds": 292.72,
      "duration_seconds": 2.36,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.5,
      "end_seconds": 314.19,
      "duration_seconds": 4.69,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.06,
      "end_seconds": 326.66,
      "duration_seconds": 9.6,
      "text": "Good, you can sit up again. Taking everything into account, this is probably perimenopause. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.65,
      "end_seconds": 332.28,
      "duration_seconds": 3.63,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.45,
      "end_seconds": 352.14,
      "duration_seconds": 18.69,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopause, but I'd like to confirm. Stop me if I've got anything wrong. You've had hot flushes for about two weeks, and no pelvic pain or bleeding after sex."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.87,
      "end_seconds": 359.81,
      "duration_seconds": 2.94,
      "text": "Mm, uh, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.22,
      "end_seconds": 393.4,
      "duration_seconds": 21.18,
      "text": "Let's book a blood count to look into irregular periods. It's a routine test and it'll give us a much clearer picture. I want a thyroid test done, that's for hot flushes. We'll begin with estradiol gel, 1 pump, once a day, long term. That should help with menopausal symptoms."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.0,
      "end_seconds": 400.65,
      "duration_seconds": 5.65,
      "text": "Uh, uh, should I take that with food?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.26,
      "end_seconds": 424.54,
      "duration_seconds": 23.28,
      "text": "Regular exercise, light layers and avoiding triggers can help. A short walk every day, even twenty minutes, will help more than you'd think. If the symptoms get worse, or you feel really unwell, please come to the emergency department. We'll catch up in three months. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 426.47,
      "end_seconds": 429.89,
      "duration_seconds": 3.42,
      "text": "I think I understand everything. Thanks."
    }
  ]
}