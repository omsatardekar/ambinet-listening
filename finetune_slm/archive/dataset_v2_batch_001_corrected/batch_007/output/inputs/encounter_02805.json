{
  "schema_version": "1.0",
  "encounter_id": "02805",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 3.71,
      "duration_seconds": 2.76,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.09,
      "end_seconds": 10.61,
      "duration_seconds": 5.52,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.62,
      "end_seconds": 13.84,
      "duration_seconds": 2.22,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.43,
      "end_seconds": 22.52,
      "duration_seconds": 7.09,
      "text": "Yeah, it's bright red blood on the paper. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.38,
      "end_seconds": 28.11,
      "duration_seconds": 3.73,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.12,
      "end_seconds": 46.84,
      "duration_seconds": 16.72,
      "text": "It's been like this since last Tuesday. I've been reading about it online and it worried me. And a lump around the back passage, too. And, And there's itching as well, about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.95,
      "end_seconds": 61.01,
      "duration_seconds": 3.06,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.24,
      "end_seconds": 74.98,
      "duration_seconds": 2.74,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.01,
      "end_seconds": 95.38,
      "duration_seconds": 8.37,
      "text": "Okay: oxygen saturation is 97 percent, respiratory rate 15, blood pressure 110 over 79, heart rate 65, temperature 36.6."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.71,
      "end_seconds": 99.01,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.36,
      "end_seconds": 103.66,
      "duration_seconds": 3.3,
      "text": "So, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.95,
      "end_seconds": 109.89,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.49,
      "end_seconds": 112.07,
      "duration_seconds": 1.58,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.95,
      "end_seconds": 115.34,
      "duration_seconds": 2.39,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.26,
      "end_seconds": 137.12,
      "duration_seconds": 7.86,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.42,
      "end_seconds": 146.32,
      "duration_seconds": 4.9,
      "text": "Okay, that's enough for me. And tummy pain, any of that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.47,
      "end_seconds": 150.99,
      "duration_seconds": 3.52,
      "text": "No, I haven't had any tummy pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.33,
      "end_seconds": 157.28,
      "duration_seconds": 4.95,
      "text": "Have you noticed change in bowel habit, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.63,
      "end_seconds": 165.72,
      "duration_seconds": 4.09,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.4,
      "end_seconds": 170.91,
      "duration_seconds": 4.51,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.84,
      "end_seconds": 175.37,
      "duration_seconds": 2.53,
      "text": "Ah, no weakness or anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.24,
      "end_seconds": 178.54,
      "duration_seconds": 2.3,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.48,
      "end_seconds": 181.38,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.04,
      "end_seconds": 185.23,
      "duration_seconds": 2.19,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.73,
      "end_seconds": 203.1,
      "duration_seconds": 14.37,
      "text": "Alendronate. I take it 70 milligrams, once a week. I do miss it now and then, you know, to be fair. I take simvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.66,
      "end_seconds": 206.93,
      "duration_seconds": 2.27,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.47,
      "end_seconds": 208.51,
      "duration_seconds": 1.04,
      "text": "20 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.14,
      "end_seconds": 219.32,
      "duration_seconds": 3.18,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.98,
      "end_seconds": 231.64,
      "duration_seconds": 11.66,
      "text": "Yes, uh, I had a wisdom tooth extraction under sedation, five years ago. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.1,
      "end_seconds": 236.24,
      "duration_seconds": 3.14,
      "text": "Okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.04,
      "end_seconds": 250.71,
      "duration_seconds": 12.67,
      "text": "I've had thin bones, yes. Work has been very busy so I kept ignoring it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.03,
      "end_seconds": 253.58,
      "duration_seconds": 1.55,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.44,
      "end_seconds": 259.02,
      "duration_seconds": 4.58,
      "text": "I, I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.93,
      "end_seconds": 265.84,
      "duration_seconds": 4.91,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.79,
      "end_seconds": 280.76,
      "duration_seconds": 12.97,
      "text": "My partner and our baby. Not much, I mostly stay in these days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.7,
      "end_seconds": 296.86,
      "duration_seconds": 7.16,
      "text": "Having listened and examined, it fits best with haemorrhoids. An anal fissure is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.81,
      "end_seconds": 299.18,
      "duration_seconds": 1.37,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.24,
      "end_seconds": 317.64,
      "duration_seconds": 17.4,
      "text": "I understand the worry. At the moment I'd say it's haemorrhoids, and we'll know more once the a blood count is back. Let's book a blood count to look into rectal bleeding. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.68,
      "end_seconds": 322.66,
      "duration_seconds": 2.98,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.67,
      "end_seconds": 324.92,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}