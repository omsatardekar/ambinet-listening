{
  "schema_version": "1.0",
  "encounter_id": "02716",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.7,
      "duration_seconds": 3.53,
      "text": "Yeah, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.72,
      "end_seconds": 9.22,
      "duration_seconds": 3.5,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.88,
      "end_seconds": 19.99,
      "duration_seconds": 7.11,
      "text": "Yeah, it's stiff aching shoulders and hips. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.38,
      "end_seconds": 24.71,
      "duration_seconds": 3.33,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.26,
      "end_seconds": 27.67,
      "duration_seconds": 2.41,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.85,
      "end_seconds": 30.92,
      "duration_seconds": 2.07,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.83,
      "end_seconds": 34.6,
      "duration_seconds": 2.77,
      "text": "Mornings definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.15,
      "end_seconds": 41.91,
      "duration_seconds": 5.76,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.25,
      "end_seconds": 45.55,
      "duration_seconds": 2.3,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.4,
      "end_seconds": 49.37,
      "duration_seconds": 2.97,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.63,
      "end_seconds": 57.68,
      "duration_seconds": 5.05,
      "text": "Right, maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.54,
      "end_seconds": 62.01,
      "duration_seconds": 2.47,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.1,
      "end_seconds": 68.19,
      "duration_seconds": 4.09,
      "text": "Only moving about, and it's not much."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.22,
      "end_seconds": 73.64,
      "duration_seconds": 3.42,
      "text": "Has there been a mild temperature too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.68,
      "end_seconds": 85.0,
      "duration_seconds": 7.32,
      "text": "Yes, about the same, two days. About mild temperature, it's a few times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.17,
      "end_seconds": 87.4,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.39,
      "end_seconds": 92.46,
      "duration_seconds": 3.07,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.43,
      "end_seconds": 98.76,
      "duration_seconds": 4.33,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.61,
      "end_seconds": 104.19,
      "duration_seconds": 3.58,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.05,
      "end_seconds": 107.27,
      "duration_seconds": 2.22,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.98,
      "end_seconds": 110.32,
      "duration_seconds": 2.34,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.71,
      "end_seconds": 124.13,
      "duration_seconds": 2.42,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.87,
      "end_seconds": 128.3,
      "duration_seconds": 2.43,
      "text": "Yes, tramadol. I get vomiting."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.67,
      "end_seconds": 131.92,
      "duration_seconds": 2.25,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 136.08,
      "duration_seconds": 2.95,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.86,
      "end_seconds": 141.87,
      "duration_seconds": 4.01,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.04,
      "end_seconds": 146.51,
      "duration_seconds": 3.47,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.18,
      "end_seconds": 152.5,
      "duration_seconds": 5.32,
      "text": "And what about weight loss, headache or jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.09,
      "end_seconds": 159.86,
      "duration_seconds": 5.77,
      "text": "No, no weight loss, headache or jaw pain on chewing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.91,
      "end_seconds": 165.89,
      "duration_seconds": 3.98,
      "text": "Have you had visual changes, by any chance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.14,
      "end_seconds": 169.26,
      "duration_seconds": 2.12,
      "text": "No, no visual changes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.95,
      "end_seconds": 173.54,
      "duration_seconds": 3.59,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.99,
      "end_seconds": 176.48,
      "duration_seconds": 1.49,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.05,
      "end_seconds": 197.86,
      "duration_seconds": 2.81,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.9,
      "end_seconds": 211.77,
      "duration_seconds": 2.87,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.8,
      "end_seconds": 237.99,
      "duration_seconds": 7.19,
      "text": "Okay: saturation 97 percent, pulse is 67 beats a minute, blood pressure 124 over 69."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.98,
      "end_seconds": 242.15,
      "duration_seconds": 2.17,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.42,
      "end_seconds": 259.93,
      "duration_seconds": 1.51,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.83,
      "end_seconds": 262.13,
      "duration_seconds": 1.3,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.06,
      "end_seconds": 282.63,
      "duration_seconds": 6.57,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.25,
      "end_seconds": 293.71,
      "duration_seconds": 6.46,
      "text": "You can sit up now. Putting it all together, I'd lean towards polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.41,
      "end_seconds": 297.6,
      "duration_seconds": 2.19,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.16,
      "end_seconds": 309.81,
      "duration_seconds": 10.65,
      "text": "I understand the worry. At the moment I'd say it's polymyalgia rheumatica, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.84,
      "end_seconds": 351.22,
      "duration_seconds": 27.38,
      "text": "I'd like to arrange blood tests for proximal stiffness. I'm going to put you on prednisolone, 15 milligrams, once a day, reducing course. It's for polymyalgia rheumatica. Report any headache or jaw pain immediately. One warning sign to remember: you get a new headache or visual changes. In that case don't wait. Book a review in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.06,
      "end_seconds": 356.1,
      "duration_seconds": 3.04,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.78,
      "end_seconds": 357.98,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}