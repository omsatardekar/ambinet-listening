{
  "schema_version": "1.0",
  "encounter_id": "02882",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 2.53,
      "duration_seconds": 1.62,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.47,
      "end_seconds": 8.43,
      "duration_seconds": 0.96,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.63,
      "end_seconds": 14.59,
      "duration_seconds": 1.96,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.1,
      "end_seconds": 23.61,
      "duration_seconds": 7.51,
      "text": "Oh, you know, so the thing is, I've got breathlessness building over weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.26,
      "end_seconds": 27.64,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.09,
      "end_seconds": 35.86,
      "duration_seconds": 3.77,
      "text": "It's omeprazole, once a day for the reflux."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.09,
      "end_seconds": 40.21,
      "duration_seconds": 2.12,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.22,
      "end_seconds": 51.36,
      "duration_seconds": 9.14,
      "text": "20 milligrams, I think that's what's on the box. I take rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.09,
      "end_seconds": 56.55,
      "duration_seconds": 3.46,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.44,
      "end_seconds": 60.82,
      "duration_seconds": 3.38,
      "text": "It's, It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.19,
      "end_seconds": 66.87,
      "duration_seconds": 2.68,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.44,
      "end_seconds": 88.94,
      "duration_seconds": 20.5,
      "text": "It's severe, honestly. Well, you know, I've had a dull ache on one side of the chest too, for about a month. Uh, with dull ache on one side of the chest, I'd call it severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.8,
      "end_seconds": 94.08,
      "duration_seconds": 4.28,
      "text": "Alright, have you noticed night sweats or leg swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.27,
      "end_seconds": 97.2,
      "duration_seconds": 1.93,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.76,
      "end_seconds": 102.36,
      "duration_seconds": 3.6,
      "text": "Have you noticed coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.75,
      "end_seconds": 108.67,
      "duration_seconds": 1.92,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.4,
      "end_seconds": 110.87,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.81,
      "end_seconds": 117.26,
      "duration_seconds": 1.45,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.44,
      "end_seconds": 122.6,
      "duration_seconds": 4.16,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.12,
      "end_seconds": 125.87,
      "duration_seconds": 2.75,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.79,
      "end_seconds": 144.45,
      "duration_seconds": 1.66,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.04,
      "end_seconds": 149.65,
      "duration_seconds": 3.61,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.42,
      "end_seconds": 151.85,
      "duration_seconds": 1.43,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.3,
      "end_seconds": 156.73,
      "duration_seconds": 3.43,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.34,
      "end_seconds": 164.19,
      "duration_seconds": 2.85,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.19,
      "end_seconds": 169.71,
      "duration_seconds": 3.52,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.17,
      "end_seconds": 173.92,
      "duration_seconds": 2.75,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.67,
      "end_seconds": 179.26,
      "duration_seconds": 3.59,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.79,
      "end_seconds": 182.18,
      "duration_seconds": 2.39,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.84,
      "end_seconds": 185.4,
      "duration_seconds": 2.56,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.18,
      "end_seconds": 189.63,
      "duration_seconds": 2.45,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.82,
      "end_seconds": 197.24,
      "duration_seconds": 6.42,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.88,
      "end_seconds": 206.83,
      "duration_seconds": 1.95,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.02,
      "end_seconds": 220.58,
      "duration_seconds": 12.56,
      "text": "Oh, I have acid reflux, for two years. I've had high cholesterol for about a year now. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.82,
      "end_seconds": 226.29,
      "duration_seconds": 4.47,
      "text": "Mm, okay. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.37,
      "end_seconds": 231.42,
      "duration_seconds": 4.05,
      "text": "Kiwi. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.23,
      "end_seconds": 236.98,
      "duration_seconds": 3.75,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.52,
      "end_seconds": 250.17,
      "duration_seconds": 2.65,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.04,
      "end_seconds": 272.99,
      "duration_seconds": 7.95,
      "text": "Okay: SpO2 89 percent on room air, pulse 86, pressure 140 over 87, respiratory rate 24, temperature 36.7."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.59,
      "end_seconds": 276.06,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.99,
      "end_seconds": 280.57,
      "duration_seconds": 2.58,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.84,
      "end_seconds": 286.72,
      "duration_seconds": 3.88,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.01,
      "end_seconds": 290.35,
      "duration_seconds": 2.34,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.23,
      "end_seconds": 310.2,
      "duration_seconds": 5.97,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.8,
      "end_seconds": 323.14,
      "duration_seconds": 9.34,
      "text": "Please sit back down. Putting it all together, the most likely explanation is a pleural effusion needing a cause."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.12,
      "end_seconds": 337.86,
      "duration_seconds": 4.74,
      "text": "I think a chest X-ray makes sense here, for breathlessness."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.39,
      "end_seconds": 341.89,
      "duration_seconds": 2.5,
      "text": "Right, that's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.71,
      "end_seconds": 353.31,
      "duration_seconds": 7.6,
      "text": "I am arranging an urgent chest clinic review. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.39,
      "end_seconds": 357.62,
      "duration_seconds": 3.23,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.14,
      "end_seconds": 359.52,
      "duration_seconds": 1.38,
      "text": "Look after yourself."
    }
  ]
}