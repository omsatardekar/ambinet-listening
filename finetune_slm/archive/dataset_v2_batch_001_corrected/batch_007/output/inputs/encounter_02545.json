{
  "schema_version": "1.0",
  "encounter_id": "02545",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 8.15,
      "duration_seconds": 6.98,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.24,
      "end_seconds": 14.65,
      "duration_seconds": 4.41,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.91,
      "end_seconds": 30.45,
      "duration_seconds": 14.54,
      "text": "Well, honestly, it's stiff aching shoulders and hips, and my family pushed me to come. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.31,
      "end_seconds": 35.35,
      "duration_seconds": 3.04,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.62,
      "end_seconds": 43.33,
      "duration_seconds": 6.71,
      "text": "Ah, um, I'd say two months. Actually, no, closer to six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.95,
      "end_seconds": 52.71,
      "duration_seconds": 8.76,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.41,
      "end_seconds": 63.84,
      "duration_seconds": 10.43,
      "text": "It happens all the time. I'd give it a six, out of ten. Yes, mornings. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.81,
      "end_seconds": 68.53,
      "duration_seconds": 2.72,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.61,
      "end_seconds": 103.71,
      "duration_seconds": 33.1,
      "text": "It usually comes with difficulty getting out of bed. I mean, about difficulty getting out of bed, I'd give it a six, out of ten. And I've been feeling tired and low as well, you know, since yesterday. Uh, about feeling tired and low, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 112.28,
      "duration_seconds": 4.36,
      "text": "Have you had any jaw pain on chewing or headache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.94,
      "end_seconds": 115.67,
      "duration_seconds": 2.73,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.38,
      "end_seconds": 120.78,
      "duration_seconds": 4.4,
      "text": "Have you had any weight loss or visual changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.81,
      "end_seconds": 126.39,
      "duration_seconds": 3.58,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.13,
      "end_seconds": 131.83,
      "duration_seconds": 3.7,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.7,
      "end_seconds": 138.09,
      "duration_seconds": 5.39,
      "text": "Um, you know, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.08,
      "end_seconds": 142.08,
      "duration_seconds": 2.0,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.0,
      "end_seconds": 147.66,
      "duration_seconds": 1.66,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.56,
      "end_seconds": 151.51,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.37,
      "end_seconds": 161.4,
      "duration_seconds": 8.03,
      "text": "Febuxostat. I take it 80 milligrams, once a day. Tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.65,
      "end_seconds": 165.42,
      "duration_seconds": 2.77,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.12,
      "end_seconds": 168.44,
      "duration_seconds": 2.32,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.89,
      "end_seconds": 173.32,
      "duration_seconds": 3.43,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.19,
      "end_seconds": 178.55,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.36,
      "end_seconds": 183.29,
      "duration_seconds": 2.93,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.11,
      "end_seconds": 189.83,
      "duration_seconds": 4.72,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.82,
      "end_seconds": 195.93,
      "duration_seconds": 4.11,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.94,
      "end_seconds": 206.58,
      "duration_seconds": 8.64,
      "text": "Gout, for nearly five years. I've got an enlarged prostate. I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.1,
      "end_seconds": 210.04,
      "duration_seconds": 1.94,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.56,
      "end_seconds": 227.86,
      "duration_seconds": 5.3,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.7,
      "end_seconds": 233.06,
      "duration_seconds": 4.36,
      "text": "I'm allergic to erythromycin, I get a rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.22,
      "end_seconds": 246.09,
      "duration_seconds": 2.87,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.99,
      "end_seconds": 262.07,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.57,
      "end_seconds": 280.86,
      "duration_seconds": 8.29,
      "text": "Okay: heart rate 66, respiratory rate 16. And pressure 113 over 77, saturation 99 percent, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 299.58,
      "duration_seconds": 5.03,
      "text": "Going by what you've described, the most likely explanation is polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.38,
      "end_seconds": 303.51,
      "duration_seconds": 2.13,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.35,
      "end_seconds": 337.02,
      "duration_seconds": 28.67,
      "text": "I understand the worry. At the moment I'd say it's polymyalgia rheumatica, and we'll know more once the blood tests is back. Let's get blood tests, for proximal stiffness. I'd like you to take prednisolone, 15 milligrams, once a day, reducing course. It's for polymyalgia rheumatica. Report any headache or jaw pain immediately. If you get a new headache or visual changes, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.82,
      "end_seconds": 345.07,
      "duration_seconds": 3.25,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.79,
      "end_seconds": 349.56,
      "duration_seconds": 2.77,
      "text": "Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.43,
      "end_seconds": 352.03,
      "duration_seconds": 1.6,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.87,
      "end_seconds": 356.24,
      "duration_seconds": 2.37,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.23,
      "end_seconds": 361.74,
      "duration_seconds": 3.51,
      "text": "Great, thank you for your help."
    }
  ]
}