{
  "schema_version": "1.0",
  "encounter_id": "02564",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 6.63,
      "duration_seconds": 5.64,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.82,
      "end_seconds": 12.29,
      "duration_seconds": 4.47,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 17.06,
      "duration_seconds": 3.71,
      "text": "I'm here because of a postnasal drip."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.66,
      "end_seconds": 24.06,
      "duration_seconds": 5.4,
      "text": "What about a dull pressure over your face, have you noticed that?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.73,
      "end_seconds": 26.3,
      "duration_seconds": 1.57,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.17,
      "end_seconds": 37.73,
      "duration_seconds": 3.56,
      "text": "So, has there been any vision changes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.43,
      "end_seconds": 40.38,
      "duration_seconds": 1.95,
      "text": "Definitely no vision changes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.87,
      "end_seconds": 44.48,
      "duration_seconds": 2.61,
      "text": "Any nosebleeds or fever at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.4,
      "end_seconds": 54.05,
      "duration_seconds": 3.65,
      "text": "No nosebleeds or fever, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.13,
      "end_seconds": 58.24,
      "duration_seconds": 2.11,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.09,
      "end_seconds": 61.0,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.8,
      "end_seconds": 65.87,
      "duration_seconds": 4.07,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.1,
      "end_seconds": 71.51,
      "duration_seconds": 1.41,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.2,
      "end_seconds": 91.04,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.43,
      "end_seconds": 95.37,
      "duration_seconds": 2.94,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 98.07,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.67,
      "end_seconds": 102.82,
      "duration_seconds": 4.15,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.27,
      "end_seconds": 107.06,
      "duration_seconds": 2.79,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.73,
      "end_seconds": 110.92,
      "duration_seconds": 3.19,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.79,
      "end_seconds": 113.93,
      "duration_seconds": 2.14,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.84,
      "end_seconds": 118.56,
      "duration_seconds": 3.72,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.38,
      "end_seconds": 121.83,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.4,
      "end_seconds": 127.04,
      "duration_seconds": 3.64,
      "text": "Ah, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.89,
      "end_seconds": 133.3,
      "duration_seconds": 4.41,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.0,
      "end_seconds": 153.34,
      "duration_seconds": 15.34,
      "text": "Asthalin inhaler. I take it when needed for my asthma. Tamsulosin, 0.4 milligrams, at night for the prostate. I'd been on Seretide inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.23,
      "end_seconds": 156.3,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.37,
      "end_seconds": 170.7,
      "duration_seconds": 13.33,
      "text": "I mean, I have asthma. I didn't want to bother you but it keeps coming back. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.58,
      "end_seconds": 172.47,
      "duration_seconds": 0.89,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.18,
      "end_seconds": 181.2,
      "duration_seconds": 7.02,
      "text": "Yes, an enlarged prostate. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.55,
      "end_seconds": 192.52,
      "duration_seconds": 9.97,
      "text": "Yes, an enlarged prostate is known to us, good to have that clear. Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 203.09,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.83,
      "end_seconds": 218.13,
      "duration_seconds": 5.3,
      "text": "Okay: pulse 83, temperature 36.9, blood pressure 128 over 76."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.39,
      "end_seconds": 221.49,
      "duration_seconds": 2.1,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.68,
      "end_seconds": 223.9,
      "duration_seconds": 1.22,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.78,
      "end_seconds": 242.46,
      "duration_seconds": 3.68,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.63,
      "end_seconds": 250.11,
      "duration_seconds": 2.48,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.79,
      "end_seconds": 298.16,
      "duration_seconds": 32.37,
      "text": "So where does that leave us? It points towards nasal polyps. That's my thinking for now, and it may change as we learn more. I'm sending you for a nasal endoscopy because of nasal obstruction. The result will help us decide whether anything more is needed. I'm prescribing mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. That's for nasal polyps. Rinse with saline and use the spray daily."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.18,
      "end_seconds": 314.5,
      "duration_seconds": 15.32,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.61,
      "end_seconds": 316.72,
      "duration_seconds": 1.11,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.26,
      "end_seconds": 320.61,
      "duration_seconds": 2.35,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.08,
      "end_seconds": 328.71,
      "duration_seconds": 4.63,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.74,
      "end_seconds": 332.15,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
}