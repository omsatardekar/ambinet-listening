{
  "schema_version": "1.0",
  "encounter_id": "02626",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.52,
      "duration_seconds": 4.41,
      "text": "Um, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.68,
      "end_seconds": 14.77,
      "duration_seconds": 4.09,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.39,
      "end_seconds": 26.32,
      "duration_seconds": 9.93,
      "text": "Doctor, it's periods becoming irregular. It's getting on my nerves now. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.09,
      "end_seconds": 30.07,
      "duration_seconds": 1.98,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.67,
      "end_seconds": 34.37,
      "duration_seconds": 3.7,
      "text": "Uh, I've had it for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.09,
      "end_seconds": 39.6,
      "duration_seconds": 3.51,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.53,
      "end_seconds": 42.23,
      "duration_seconds": 1.7,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.21,
      "end_seconds": 49.92,
      "duration_seconds": 2.71,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.84,
      "end_seconds": 60.0,
      "duration_seconds": 9.16,
      "text": "Actually, it usually comes with mood swings. Um, the mood swings? That's been for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.67,
      "end_seconds": 64.59,
      "duration_seconds": 3.92,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.28,
      "end_seconds": 74.69,
      "duration_seconds": 8.41,
      "text": "Escitalopram, 10 milligrams, once a day. I was on sitagliptin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.45,
      "end_seconds": 80.76,
      "duration_seconds": 4.31,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.6,
      "end_seconds": 88.47,
      "duration_seconds": 6.87,
      "text": "I've had anxiety for two years now. I have diabetes, for five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 96.69,
      "duration_seconds": 2.85,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.0,
      "end_seconds": 102.36,
      "duration_seconds": 4.36,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 105.36,
      "duration_seconds": 2.4,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.44,
      "end_seconds": 110.71,
      "duration_seconds": 4.27,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.82,
      "end_seconds": 125.78,
      "duration_seconds": 4.96,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.97,
      "end_seconds": 133.02,
      "duration_seconds": 6.05,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.21,
      "end_seconds": 149.65,
      "duration_seconds": 3.44,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.86,
      "end_seconds": 156.32,
      "duration_seconds": 5.46,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.84,
      "end_seconds": 163.44,
      "duration_seconds": 6.6,
      "text": "And what about bleeding after sex, very heavy bleeding, weight loss or pelvic pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.36,
      "end_seconds": 173.08,
      "duration_seconds": 7.72,
      "text": "Right, no bleeding after sex, very heavy bleeding, weight loss or pelvic pain, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.75,
      "end_seconds": 176.71,
      "duration_seconds": 2.96,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.68,
      "end_seconds": 184.13,
      "duration_seconds": 1.45,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.82,
      "end_seconds": 189.18,
      "duration_seconds": 3.36,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.88,
      "end_seconds": 200.83,
      "duration_seconds": 1.95,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.33,
      "end_seconds": 225.31,
      "duration_seconds": 7.98,
      "text": "Okay: oxygen saturation is 98 percent, temperature is 36.8 degrees. And pulse 74, blood pressure 117 over 79."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.08,
      "end_seconds": 228.31,
      "duration_seconds": 2.23,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.06,
      "end_seconds": 231.49,
      "duration_seconds": 2.43,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.29,
      "end_seconds": 253.14,
      "duration_seconds": 11.85,
      "text": "So, based on your history, it's hard to say. Perimenopause is one possibility and a thyroid problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.8,
      "end_seconds": 258.16,
      "duration_seconds": 3.36,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.22,
      "end_seconds": 271.52,
      "duration_seconds": 11.3,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopause, but I'd like to confirm. I want a thyroid test done, that's for hot flushes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.02,
      "end_seconds": 273.96,
      "duration_seconds": 1.94,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.98,
      "end_seconds": 282.01,
      "duration_seconds": 6.03,
      "text": "Do I need a blood count? I read it might help."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.8,
      "end_seconds": 289.22,
      "duration_seconds": 6.42,
      "text": "Not at this point, no. It isn't indicated yet. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.39,
      "end_seconds": 298.4,
      "duration_seconds": 4.01,
      "text": "Erm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.42,
      "end_seconds": 302.8,
      "duration_seconds": 1.38,
      "text": "All the best."
    }
  ]
}