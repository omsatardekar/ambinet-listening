{
  "schema_version": "1.0",
  "encounter_id": "02685",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 2.87,
      "duration_seconds": 1.85,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.69,
      "end_seconds": 7.81,
      "duration_seconds": 4.12,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.49,
      "end_seconds": 20.46,
      "duration_seconds": 11.97,
      "text": "Erm, I've been dealing with a blocked nose for months. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.97,
      "end_seconds": 27.64,
      "duration_seconds": 3.67,
      "text": "Okay, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.84,
      "end_seconds": 38.92,
      "duration_seconds": 10.08,
      "text": "It's been two days, I'm fairly sure. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.57,
      "end_seconds": 44.55,
      "duration_seconds": 3.98,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.63,
      "end_seconds": 50.64,
      "duration_seconds": 5.01,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.97,
      "end_seconds": 54.66,
      "duration_seconds": 3.69,
      "text": "Mm-hmm. Right, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.55,
      "end_seconds": 71.0,
      "duration_seconds": 15.45,
      "text": "When it starts I tend to get a postnasal drip as well. Yeah, the postnasal drip? That's been since Friday. Ah, with postnasal drip, I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.55,
      "end_seconds": 75.46,
      "duration_seconds": 3.91,
      "text": "Yes. Any fever, vision changes, nosebleeds or facial swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.32,
      "end_seconds": 80.47,
      "duration_seconds": 4.15,
      "text": "Right, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.45,
      "end_seconds": 86.74,
      "duration_seconds": 4.29,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.28,
      "end_seconds": 89.64,
      "duration_seconds": 2.36,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.25,
      "end_seconds": 94.19,
      "duration_seconds": 2.94,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.97,
      "end_seconds": 96.75,
      "duration_seconds": 1.78,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.57,
      "end_seconds": 104.32,
      "duration_seconds": 5.75,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.9,
      "end_seconds": 121.91,
      "duration_seconds": 16.01,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. My partner and our baby. I'm vegetarian and have been for years. I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.61,
      "end_seconds": 135.84,
      "duration_seconds": 3.23,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.31,
      "end_seconds": 150.18,
      "duration_seconds": 9.87,
      "text": "Uh, you know, yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.74,
      "end_seconds": 157.44,
      "duration_seconds": 2.7,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.51,
      "end_seconds": 167.73,
      "duration_seconds": 9.22,
      "text": "Gliclazide, 80 milligrams, twice a day for my sugar. I take saline spray, three times a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.32,
      "end_seconds": 175.05,
      "duration_seconds": 2.73,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.18,
      "end_seconds": 177.95,
      "duration_seconds": 1.77,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.66,
      "end_seconds": 183.64,
      "duration_seconds": 3.98,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.43,
      "end_seconds": 187.75,
      "duration_seconds": 3.32,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.75,
      "end_seconds": 191.79,
      "duration_seconds": 3.04,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.87,
      "end_seconds": 201.28,
      "duration_seconds": 7.41,
      "text": "Yes, asthma. I have heart failure. I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 210.04,
      "duration_seconds": 7.67,
      "text": "Alright, yes, asthma and heart failure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.98,
      "end_seconds": 229.14,
      "duration_seconds": 3.16,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.91,
      "end_seconds": 233.54,
      "duration_seconds": 2.63,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.07,
      "end_seconds": 236.85,
      "duration_seconds": 2.78,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.73,
      "end_seconds": 251.71,
      "duration_seconds": 2.98,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.62,
      "end_seconds": 277.51,
      "duration_seconds": 4.89,
      "text": "Okay: pressure 121 over 74, temp 36.9 degrees, pulse 69."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.47,
      "end_seconds": 281.98,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.19,
      "end_seconds": 285.55,
      "duration_seconds": 2.36,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.11,
      "end_seconds": 305.59,
      "duration_seconds": 3.48,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.72,
      "end_seconds": 320.4,
      "duration_seconds": 12.68,
      "text": "Thank you, you can get dressed. So where does that leave us? I think we're dealing with nasal polyps at this stage. I can't rule out chronic sinusitis yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.47,
      "end_seconds": 338.54,
      "duration_seconds": 4.07,
      "text": "I want a nasal endoscopy done, that's for nasal obstruction."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.26,
      "end_seconds": 341.91,
      "duration_seconds": 2.65,
      "text": "Erm, that's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.06,
      "end_seconds": 373.8,
      "duration_seconds": 30.74,
      "text": "Let's use mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for nasal polyps. Rinse with saline and use the spray daily. If you smoke, this is a good moment to think about stopping, and we can help you with that. The ENT clinic would be the right next step, I'll refer you. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.72,
      "end_seconds": 378.58,
      "duration_seconds": 2.86,
      "text": "So, alright, thanks, take care."
    }
  ]
}