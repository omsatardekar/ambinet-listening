  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 3.03,
      "duration_seconds": 2.22,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.96,
      "end_seconds": 7.9,
      "duration_seconds": 2.94,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.88,
      "end_seconds": 11.5,
      "duration_seconds": 1.62,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.65,
      "end_seconds": 21.66,
      "duration_seconds": 6.01,
      "text": "It's itchy blisters. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.63,
      "end_seconds": 26.04,
      "duration_seconds": 3.41,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.8,
      "end_seconds": 31.58,
      "duration_seconds": 3.78,
      "text": "well, it's ramipril, 5 milligrams, every morning"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.96,
      "end_seconds": 32.66,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.35,
      "end_seconds": 38.2,
      "duration_seconds": 3.85,
      "text": "It's tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.66,
      "end_seconds": 41.32,
      "duration_seconds": 2.66,
      "text": "Hm, okay. When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.89,
      "end_seconds": 49.84,
      "duration_seconds": 6.95,
      "text": "For two days, I'd say. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 60.87,
      "duration_seconds": 5.89,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.94,
      "end_seconds": 73.37,
      "duration_seconds": 10.43,
      "text": "It, It happens on and off. Oh, there's an itchy rash first as well. As for itchy rash first, mostly severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.83,
      "end_seconds": 80.04,
      "duration_seconds": 5.21,
      "text": "Have you had itchy blisters before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 88.26,
      "duration_seconds": 6.33,
      "text": "Right, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.82,
      "end_seconds": 94.36,
      "duration_seconds": 4.54,
      "text": "Any new medicine, mouth sores or fever at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.36,
      "end_seconds": 100.94,
      "duration_seconds": 4.58,
      "text": "No, uh, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.26,
      "end_seconds": 104.91,
      "duration_seconds": 2.65,
      "text": "And eye problems, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.33,
      "end_seconds": 109.32,
      "duration_seconds": 2.99,
      "text": "nope, uh, no eye problems"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.83,
      "end_seconds": 113.71,
      "duration_seconds": 3.88,
      "text": "Hm, okay. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.47,
      "end_seconds": 116.1,
      "duration_seconds": 1.63,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.94,
      "end_seconds": 122.58,
      "duration_seconds": 4.64,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.22,
      "end_seconds": 134.73,
      "duration_seconds": 11.51,
      "text": "Not much, I mostly stay in these days. I grab fast food at lunch most days. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.33,
      "end_seconds": 139.15,
      "duration_seconds": 3.82,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.24,
      "end_seconds": 143.5,
      "duration_seconds": 2.26,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.06,
      "end_seconds": 164.67,
      "duration_seconds": 2.61,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.77,
      "end_seconds": 167.01,
      "duration_seconds": 1.24,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.71,
      "end_seconds": 171.91,
      "duration_seconds": 3.2,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.99,
      "end_seconds": 176.12,
      "duration_seconds": 2.13,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.59,
      "end_seconds": 179.45,
      "duration_seconds": 1.86,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.2,
      "end_seconds": 191.29,
      "duration_seconds": 10.09,
      "text": "An enlarged prostate, for nearly five years. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.03,
      "end_seconds": 201.1,
      "duration_seconds": 8.07,
      "text": "Alright, an enlarged prostate, that matches what I have here. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.15,
      "end_seconds": 213.49,
      "duration_seconds": 2.34,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.47,
      "end_seconds": 232.88,
      "duration_seconds": 9.41,
      "text": "Okay: saturation 98 percent, respiratory rate 15. And temperature is 36.7 degrees, pulse 64, BP is 119 over 72."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.44,
      "end_seconds": 236.74,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 241.55,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.1,
      "end_seconds": 249.0,
      "duration_seconds": 4.9,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.52,
      "end_seconds": 251.95,
      "duration_seconds": 1.43,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.48,
      "end_seconds": 273.22,
      "duration_seconds": 5.74,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.66,
      "end_seconds": 278.35,
      "duration_seconds": 1.69,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.74,
      "end_seconds": 299.89,
      "duration_seconds": 8.15,
      "text": "So where does that leave us? The most likely explanation is bullous pemphigoid. A drug reaction is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.2,
      "end_seconds": 307.39,
      "duration_seconds": 2.19,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.81,
      "end_seconds": 320.37,
      "duration_seconds": 11.56,
      "text": "Nothing I've seen today points to an emergency. It looks like bullous pemphigoid. Today I'm not changing anything. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.23,
      "end_seconds": 325.18,
      "duration_seconds": 2.95,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.61,
      "end_seconds": 327.92,
      "duration_seconds": 1.31,
      "text": "see you soon"
    }
  ]
}