{
  "schema_version": "1.0",
  "encounter_id": "02765",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.25,
      "duration_seconds": 4.57,
      "text": "Well, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 10.2,
      "duration_seconds": 3.65,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.08,
      "end_seconds": 16.85,
      "duration_seconds": 5.77,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.68,
      "end_seconds": 20.51,
      "duration_seconds": 2.83,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.11,
      "end_seconds": 26.5,
      "duration_seconds": 5.39,
      "text": "Doctor, it's bloody diarrhoea. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.83,
      "end_seconds": 29.04,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.73,
      "end_seconds": 35.93,
      "duration_seconds": 6.2,
      "text": "Sorry, what was I saying, it's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.74,
      "end_seconds": 46.4,
      "duration_seconds": 5.66,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.33,
      "end_seconds": 50.97,
      "duration_seconds": 3.64,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.84,
      "end_seconds": 58.4,
      "duration_seconds": 3.56,
      "text": "Alright, have you been feeling very unwell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.96,
      "end_seconds": 66.98,
      "duration_seconds": 8.02,
      "text": "Yes, actually. With feeling very unwell, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.1,
      "end_seconds": 73.37,
      "duration_seconds": 5.27,
      "text": "Have you had bloody diarrhoea before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.12,
      "end_seconds": 87.35,
      "duration_seconds": 12.23,
      "text": "I mean, uh, yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.07,
      "end_seconds": 91.73,
      "duration_seconds": 3.66,
      "text": "Have you noticed fever, chest pain or hernia?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.82,
      "end_seconds": 102.09,
      "duration_seconds": 6.27,
      "text": "I mean, no fever, chest pain or hernia, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.19,
      "end_seconds": 105.66,
      "duration_seconds": 2.47,
      "text": "Right, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.76,
      "end_seconds": 110.85,
      "duration_seconds": 4.09,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.8,
      "end_seconds": 127.21,
      "duration_seconds": 4.41,
      "text": "Alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.73,
      "end_seconds": 131.19,
      "duration_seconds": 3.46,
      "text": "It's, It's warfarin, in the evening."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.85,
      "end_seconds": 135.53,
      "duration_seconds": 2.68,
      "text": "Right, and what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.49,
      "end_seconds": 140.5,
      "duration_seconds": 1.01,
      "text": "3 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.8,
      "end_seconds": 148.56,
      "duration_seconds": 3.76,
      "text": "So, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.53,
      "end_seconds": 153.15,
      "duration_seconds": 2.62,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.76,
      "end_seconds": 156.51,
      "duration_seconds": 2.75,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.4,
      "end_seconds": 169.14,
      "duration_seconds": 11.74,
      "text": "I live with my elderly mother. I'm vegetarian and have been for years. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.85,
      "end_seconds": 175.32,
      "duration_seconds": 4.47,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.95,
      "end_seconds": 178.54,
      "duration_seconds": 2.59,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.3,
      "end_seconds": 182.74,
      "duration_seconds": 3.44,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.84,
      "end_seconds": 190.39,
      "duration_seconds": 6.55,
      "text": "Um, yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.83,
      "end_seconds": 195.8,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.46,
      "end_seconds": 199.95,
      "duration_seconds": 3.49,
      "text": "I've, I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.48,
      "end_seconds": 201.84,
      "duration_seconds": 1.36,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.92,
      "end_seconds": 205.86,
      "duration_seconds": 2.94,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.86,
      "end_seconds": 216.39,
      "duration_seconds": 8.53,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 224.64,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.19,
      "end_seconds": 255.71,
      "duration_seconds": 10.52,
      "text": "Okay: SpO2 98 percent on room air, pulse is 107 beats a minute, temp 36.8 degrees. And pressure 119 over 86."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.94,
      "end_seconds": 259.17,
      "duration_seconds": 2.23,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.98,
      "end_seconds": 262.37,
      "duration_seconds": 2.39,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.68,
      "end_seconds": 268.84,
      "duration_seconds": 4.16,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.93,
      "end_seconds": 286.13,
      "duration_seconds": 1.2,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.1,
      "end_seconds": 288.38,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.64,
      "end_seconds": 315.86,
      "duration_seconds": 10.22,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.26,
      "end_seconds": 321.91,
      "duration_seconds": 1.65,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.67,
      "end_seconds": 342.77,
      "duration_seconds": 8.1,
      "text": "Having listened and examined, I don't have a clear answer today: possible bowel ischaemia is possible, and so is pancreatitis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.77,
      "end_seconds": 347.41,
      "duration_seconds": 3.64,
      "text": "Okay, so is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.09,
      "end_seconds": 381.94,
      "duration_seconds": 32.85,
      "text": "Nothing I've seen today points to an emergency. It looks like possible bowel ischaemia, but I'd like to confirm. I'll request an urgent CT angiogram, it'll help with possible bowel ischaemia. This is an emergency, you are going to hospital now. One warning sign to remember: the symptoms get worse. In that case don't wait. See me again straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.49,
      "end_seconds": 384.19,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    }
  ]
}