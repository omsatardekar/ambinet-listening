{
  "schema_version": "1.0",
  "encounter_id": "02980",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 2.51,
      "duration_seconds": 1.78,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.69,
      "end_seconds": 7.25,
      "duration_seconds": 3.56,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.64,
      "end_seconds": 13.55,
      "duration_seconds": 4.91,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.0,
      "end_seconds": 18.38,
      "duration_seconds": 3.38,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.49,
      "end_seconds": 25.33,
      "duration_seconds": 5.84,
      "text": "Well, I've been having a severe sore throat on one side."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.2,
      "end_seconds": 28.56,
      "duration_seconds": 2.36,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.66,
      "end_seconds": 35.4,
      "duration_seconds": 5.74,
      "text": "He is on carvedilol, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.06,
      "end_seconds": 38.18,
      "duration_seconds": 2.12,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.02,
      "end_seconds": 42.09,
      "duration_seconds": 2.07,
      "text": "It's 6.25 milligrams."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.8,
      "end_seconds": 46.07,
      "duration_seconds": 3.27,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.58,
      "end_seconds": 57.2,
      "duration_seconds": 9.62,
      "text": "Around five days... no wait, it's more like ten days. There was drooling, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.91,
      "end_seconds": 62.9,
      "duration_seconds": 3.99,
      "text": "Did you get cough, rash or noisy breathing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.23,
      "end_seconds": 67.38,
      "duration_seconds": 3.15,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.19,
      "end_seconds": 71.53,
      "duration_seconds": 2.34,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.1,
      "end_seconds": 74.52,
      "duration_seconds": 2.42,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 78.92,
      "duration_seconds": 2.79,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.05,
      "end_seconds": 85.75,
      "duration_seconds": 5.7,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.74,
      "end_seconds": 90.73,
      "duration_seconds": 2.99,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.99,
      "end_seconds": 94.58,
      "duration_seconds": 2.59,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.5,
      "end_seconds": 99.11,
      "duration_seconds": 3.61,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.17,
      "end_seconds": 104.81,
      "duration_seconds": 1.64,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.34,
      "end_seconds": 123.87,
      "duration_seconds": 2.53,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.45,
      "end_seconds": 136.71,
      "duration_seconds": 12.26,
      "text": "I do a yoga class on Thursdays. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.16,
      "end_seconds": 144.18,
      "duration_seconds": 6.02,
      "text": "Have you got any known allergies? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.79,
      "end_seconds": 147.25,
      "duration_seconds": 2.46,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.42,
      "end_seconds": 156.13,
      "duration_seconds": 3.71,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.14,
      "end_seconds": 170.54,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.99,
      "end_seconds": 196.69,
      "duration_seconds": 12.7,
      "text": "Okay: oxygen saturation is 96 percent, BP is 113 over 73, pulse is 91 beats a minute. And respiratory rate 16, temperature is 39.2 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.58,
      "end_seconds": 198.98,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.09,
      "end_seconds": 203.56,
      "duration_seconds": 3.47,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.12,
      "end_seconds": 208.47,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.51,
      "end_seconds": 211.58,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.36,
      "end_seconds": 227.64,
      "duration_seconds": 8.28,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.66,
      "end_seconds": 234.59,
      "duration_seconds": 2.93,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.26,
      "end_seconds": 255.22,
      "duration_seconds": 10.96,
      "text": "Okay, so my impression is this: I don't have a clear answer today: a quinsy, a peritonsillar abscess is possible, and so is severe tonsillitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.53,
      "end_seconds": 294.8,
      "duration_seconds": 26.27,
      "text": "Let's get blood tests, for abscess. I want an urgent ENT drainage done, that's for peritonsillar abscess. For this, benzylpenicillin, 1.2 grams, now, single dose. That's for peritonsillar abscess. You need to be seen by ENT today to drain it. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.63,
      "end_seconds": 298.27,
      "duration_seconds": 1.64,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.08,
      "end_seconds": 307.65,
      "duration_seconds": 7.57,
      "text": "Please come and see me straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.42,
      "end_seconds": 310.83,
      "duration_seconds": 2.41,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.7,
      "end_seconds": 313.06,
      "duration_seconds": 1.36,
      "text": "Goodbye for now."
    }
  ]
}