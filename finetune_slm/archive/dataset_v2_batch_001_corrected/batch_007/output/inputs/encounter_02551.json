{
  "schema_version": "1.0",
  "encounter_id": "02551",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 7.32,
      "duration_seconds": 6.06,
      "text": "Hello, sorry about the delay, do sit. Okay, what's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.3,
      "end_seconds": 18.53,
      "duration_seconds": 9.23,
      "text": "Doctor, it's weakness climbing up my legs. It's getting on my nerves now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.25,
      "end_seconds": 23.21,
      "duration_seconds": 2.96,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.6,
      "end_seconds": 26.94,
      "duration_seconds": 2.34,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.33,
      "end_seconds": 30.83,
      "duration_seconds": 3.5,
      "text": "Mm-hmm. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.86,
      "end_seconds": 41.76,
      "duration_seconds": 9.9,
      "text": "When it starts I tend to get a recent stomach bug as well. The recent stomach bug? That's been for two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.49,
      "end_seconds": 46.32,
      "duration_seconds": 3.83,
      "text": "So, any bladder problems, fever or back pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.56,
      "end_seconds": 49.71,
      "duration_seconds": 2.15,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.87,
      "end_seconds": 57.66,
      "duration_seconds": 3.79,
      "text": "Right, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.55,
      "end_seconds": 60.25,
      "duration_seconds": 1.7,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.96,
      "end_seconds": 64.89,
      "duration_seconds": 2.93,
      "text": "So, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.72,
      "end_seconds": 66.79,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.08,
      "end_seconds": 77.2,
      "duration_seconds": 2.12,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.93,
      "end_seconds": 83.0,
      "duration_seconds": 4.07,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.88,
      "end_seconds": 88.79,
      "duration_seconds": 3.91,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.8,
      "end_seconds": 93.31,
      "duration_seconds": 3.51,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.28,
      "end_seconds": 96.54,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.33,
      "end_seconds": 101.05,
      "duration_seconds": 2.72,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.08,
      "end_seconds": 107.91,
      "duration_seconds": 4.83,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.52,
      "end_seconds": 111.97,
      "duration_seconds": 3.45,
      "text": "Yeah, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 131.34,
      "duration_seconds": 4.41,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.27,
      "end_seconds": 136.08,
      "duration_seconds": 2.81,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.78,
      "end_seconds": 140.21,
      "duration_seconds": 2.43,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.58,
      "end_seconds": 142.82,
      "duration_seconds": 1.24,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 162.69,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.51,
      "end_seconds": 176.17,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.19,
      "end_seconds": 205.61,
      "duration_seconds": 12.42,
      "text": "Okay: temperature 36.8, BMI works out to 15.9. And respiratory rate 18, blood pressure 108 over 68, pulse 81, weight 52 kilos, height 181 centimetres."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.71,
      "end_seconds": 209.39,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.35,
      "end_seconds": 213.02,
      "duration_seconds": 2.67,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.44,
      "end_seconds": 216.69,
      "duration_seconds": 2.25,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.06,
      "end_seconds": 219.42,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.72,
      "end_seconds": 238.58,
      "duration_seconds": 5.86,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.47,
      "end_seconds": 245.61,
      "duration_seconds": 2.14,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.97,
      "end_seconds": 270.23,
      "duration_seconds": 9.26,
      "text": "Putting it all together, I'm honestly not certain yet. It could be possible Guillain-Barre syndrome, or it might be a spinal cord problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.93,
      "end_seconds": 274.18,
      "duration_seconds": 3.25,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.44,
      "end_seconds": 290.49,
      "duration_seconds": 13.05,
      "text": "I can't promise yet, but most people with possible Guillain-Barre syndrome do well once it's treated properly. An urgent admission is what I'd like next, for ascending weakness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.31,
      "end_seconds": 296.88,
      "duration_seconds": 1.57,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.86,
      "end_seconds": 302.62,
      "duration_seconds": 3.76,
      "text": "Let's get a breathing test, for possible GBS."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.18,
      "end_seconds": 307.02,
      "duration_seconds": 2.84,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.28,
      "end_seconds": 333.72,
      "duration_seconds": 20.44,
      "text": "You must be admitted today for monitoring of your breathing. I'd like you to see the neurology team as well, and I'll write the referral. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.49,
      "end_seconds": 337.12,
      "duration_seconds": 1.63,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.66,
      "end_seconds": 347.09,
      "duration_seconds": 8.43,
      "text": "We'll catch up straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.74,
      "end_seconds": 351.96,
      "duration_seconds": 4.22,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.67,
      "end_seconds": 356.74,
      "duration_seconds": 4.07,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.52,
      "end_seconds": 360.49,
      "duration_seconds": 2.97,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.23,
      "end_seconds": 362.88,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
}