{
  "schema_version": "1.0",
  "encounter_id": "02556",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.95,
      "duration_seconds": 3.42,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.59,
      "end_seconds": 5.83,
      "duration_seconds": 1.24,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.8,
      "end_seconds": 9.49,
      "duration_seconds": 2.69,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.69,
      "end_seconds": 13.53,
      "duration_seconds": 2.84,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.15,
      "end_seconds": 19.68,
      "duration_seconds": 5.53,
      "text": "So, she's been having a chesty cough for a week, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 25.61,
      "duration_seconds": 3.93,
      "text": "Right, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.15,
      "end_seconds": 35.73,
      "duration_seconds": 9.58,
      "text": "Two months, I think... sorry, six months, I got that wrong. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.22,
      "end_seconds": 41.36,
      "duration_seconds": 5.14,
      "text": "Sure. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.39,
      "end_seconds": 48.69,
      "duration_seconds": 5.3,
      "text": "I mean, honestly, a few times a day. Moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.16,
      "end_seconds": 52.73,
      "duration_seconds": 2.57,
      "text": "Has there been slight aching too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.44,
      "end_seconds": 58.0,
      "duration_seconds": 3.56,
      "text": "Yes, you know, for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.88,
      "end_seconds": 64.3,
      "duration_seconds": 5.42,
      "text": "Any breathlessness, chest pain, coughing up blood or fever at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.23,
      "end_seconds": 70.32,
      "duration_seconds": 4.09,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.3,
      "end_seconds": 75.0,
      "duration_seconds": 2.7,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.52,
      "end_seconds": 76.55,
      "duration_seconds": 1.03,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.51,
      "end_seconds": 81.05,
      "duration_seconds": 3.54,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.76,
      "end_seconds": 90.05,
      "duration_seconds": 3.29,
      "text": "Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 90.59,
      "end_seconds": 96.72,
      "duration_seconds": 6.13,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.44,
      "end_seconds": 103.36,
      "duration_seconds": 1.92,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.05,
      "end_seconds": 110.55,
      "duration_seconds": 5.5,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 113.67,
      "duration_seconds": 1.45,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.29,
      "end_seconds": 118.51,
      "duration_seconds": 4.22,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.74,
      "end_seconds": 123.98,
      "duration_seconds": 4.24,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.97,
      "end_seconds": 128.95,
      "duration_seconds": 3.98,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.09,
      "end_seconds": 131.27,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.41,
      "end_seconds": 137.46,
      "duration_seconds": 3.05,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.21,
      "end_seconds": 141.32,
      "duration_seconds": 2.11,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.74,
      "end_seconds": 148.88,
      "duration_seconds": 4.14,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.39,
      "end_seconds": 170.78,
      "duration_seconds": 3.39,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.04,
      "end_seconds": 174.77,
      "duration_seconds": 2.73,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.34,
      "end_seconds": 196.77,
      "duration_seconds": 3.43,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.34,
      "end_seconds": 199.69,
      "duration_seconds": 2.35,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.54,
      "end_seconds": 205.38,
      "duration_seconds": 4.84,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.28,
      "end_seconds": 211.19,
      "duration_seconds": 3.91,
      "text": "Uh, yes, trimethoprim, it gives me itching."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.2,
      "end_seconds": 214.75,
      "duration_seconds": 2.55,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.9,
      "end_seconds": 222.86,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.68,
      "end_seconds": 244.08,
      "duration_seconds": 10.4,
      "text": "Okay: height 170 centimetres, temperature 36.9, heart rate 81. And saturation 98 percent, respiratory rate 14, weight 93 kilos, pressure 118 over 77."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.78,
      "end_seconds": 250.9,
      "duration_seconds": 5.12,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.44,
      "end_seconds": 254.81,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.71,
      "end_seconds": 268.54,
      "duration_seconds": 3.83,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.32,
      "end_seconds": 276.6,
      "duration_seconds": 3.28,
      "text": "Right, good, you can sit up again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.91,
      "end_seconds": 311.22,
      "duration_seconds": 18.31,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. If you get a fever or breathlessness, that's the point to come in urgently. Come back if not better in three weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.92,
      "end_seconds": 315.19,
      "duration_seconds": 2.27,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.16,
      "end_seconds": 320.7,
      "duration_seconds": 4.54,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.18,
      "end_seconds": 323.78,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.43,
      "end_seconds": 327.44,
      "duration_seconds": 2.01,
      "text": "Right, take care now."
    }
  ]
}