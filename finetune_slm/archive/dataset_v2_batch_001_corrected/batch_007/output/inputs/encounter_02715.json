{
  "schema_version": "1.0",
  "encounter_id": "02715",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 3.25,
      "duration_seconds": 2.69,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.68,
      "end_seconds": 11.85,
      "duration_seconds": 7.17,
      "text": "Um, uh, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.26,
      "end_seconds": 18.11,
      "duration_seconds": 1.85,
      "text": "So, what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.3,
      "end_seconds": 34.74,
      "duration_seconds": 15.44,
      "text": "Um, so... aching all over. That's why I came. I did try to ignore it for a while. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.27,
      "end_seconds": 40.18,
      "duration_seconds": 3.91,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.91,
      "end_seconds": 47.64,
      "duration_seconds": 6.73,
      "text": "Sorry, what was I saying, it's sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.56,
      "end_seconds": 52.0,
      "duration_seconds": 3.44,
      "text": "Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.35,
      "end_seconds": 57.67,
      "duration_seconds": 4.32,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.97,
      "end_seconds": 61.38,
      "duration_seconds": 2.41,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.44,
      "end_seconds": 66.64,
      "duration_seconds": 3.2,
      "text": "Only heat, and it's not much."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.74,
      "end_seconds": 71.91,
      "duration_seconds": 3.17,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.16,
      "end_seconds": 78.3,
      "duration_seconds": 5.14,
      "text": "I'd give it a six, you know, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.87,
      "end_seconds": 81.35,
      "duration_seconds": 2.48,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.42,
      "end_seconds": 91.75,
      "duration_seconds": 9.33,
      "text": "Ah, it sort of comes and goes. I, I had poor concentration before. That's settled now, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.02,
      "end_seconds": 97.19,
      "duration_seconds": 4.17,
      "text": "Have you had any joint swelling, weight loss or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.78,
      "end_seconds": 103.65,
      "duration_seconds": 5.87,
      "text": "No joint swelling, weight loss or fever, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.97,
      "end_seconds": 106.34,
      "duration_seconds": 1.37,
      "text": "What about rash?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.19,
      "end_seconds": 109.66,
      "duration_seconds": 1.47,
      "text": "No. No rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.52,
      "end_seconds": 114.41,
      "duration_seconds": 3.89,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.92,
      "end_seconds": 117.65,
      "duration_seconds": 1.73,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.66,
      "end_seconds": 131.39,
      "duration_seconds": 4.73,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.95,
      "end_seconds": 137.58,
      "duration_seconds": 4.63,
      "text": "I don't think I have any, you know, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.57,
      "end_seconds": 142.15,
      "duration_seconds": 3.58,
      "text": "Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.99,
      "end_seconds": 167.84,
      "duration_seconds": 23.85,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. Yes, I work in a bakery, early starts. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.6,
      "end_seconds": 176.47,
      "duration_seconds": 6.87,
      "text": "Tell me about any past illnesses or ongoing conditions. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.4,
      "end_seconds": 187.79,
      "duration_seconds": 10.39,
      "text": "Hmm, I've had migraines for about a year now. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.35,
      "end_seconds": 195.31,
      "duration_seconds": 2.96,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.78,
      "end_seconds": 205.82,
      "duration_seconds": 3.04,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.13,
      "end_seconds": 222.95,
      "duration_seconds": 4.82,
      "text": "Okay: BP is 118 over 73, respiratory rate 18, pulse 82."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.81,
      "end_seconds": 229.55,
      "duration_seconds": 2.74,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.05,
      "end_seconds": 233.14,
      "duration_seconds": 2.09,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 239.28,
      "duration_seconds": 3.82,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.91,
      "end_seconds": 243.47,
      "duration_seconds": 2.56,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.89,
      "end_seconds": 258.15,
      "duration_seconds": 6.26,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.44,
      "end_seconds": 269.47,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.24,
      "end_seconds": 275.51,
      "duration_seconds": 3.27,
      "text": "Right, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.35,
      "end_seconds": 294.26,
      "duration_seconds": 6.91,
      "text": "Having listened and examined, it fits best with fibromyalgia. I can't rule out polymyalgia yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.19,
      "end_seconds": 296.96,
      "duration_seconds": 1.77,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.04,
      "end_seconds": 316.52,
      "duration_seconds": 18.48,
      "text": "I understand the worry. At the moment I'd say it's fibromyalgia, and we'll know more once the blood tests is back. I want blood tests done, that's for widespread pain. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.3,
      "end_seconds": 319.14,
      "duration_seconds": 1.84,
      "text": "That's clear, thanks."
    }
  ]
}