{
  "schema_version": "1.0",
  "encounter_id": "02707",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.81,
      "duration_seconds": 4.26,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 11.29,
      "duration_seconds": 4.96,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.02,
      "end_seconds": 19.89,
      "duration_seconds": 6.87,
      "text": "It's vomiting, mostly. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.4,
      "end_seconds": 24.43,
      "duration_seconds": 4.03,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.89,
      "end_seconds": 43.45,
      "duration_seconds": 17.56,
      "text": "It's metoprolol, 50 milligrams, twice a day. It's valsartan, 80 milligrams, once a day for my blood pressure. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.32,
      "end_seconds": 48.88,
      "duration_seconds": 3.56,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.4,
      "end_seconds": 52.77,
      "duration_seconds": 2.37,
      "text": "For five days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.5,
      "end_seconds": 59.21,
      "duration_seconds": 4.71,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.86,
      "end_seconds": 68.68,
      "duration_seconds": 7.82,
      "text": "Pretty severe, if I'm being honest. It happens all the time. I've also been feeling very unwell."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.33,
      "end_seconds": 75.12,
      "duration_seconds": 4.79,
      "text": "Any severe tummy pain out of proportion to the examination as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.56,
      "end_seconds": 90.95,
      "duration_seconds": 12.39,
      "text": "Well, yes, about the same, about four days. With severe tummy pain out of proportion to the examination, I'd say every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.39,
      "end_seconds": 96.81,
      "duration_seconds": 4.42,
      "text": "Have you had vomiting before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.33,
      "end_seconds": 104.14,
      "duration_seconds": 6.81,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.89,
      "end_seconds": 114.7,
      "duration_seconds": 5.81,
      "text": "Let me check a few things. Any hernia, chest pain or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.98,
      "end_seconds": 119.95,
      "duration_seconds": 3.97,
      "text": "Well, no, no hernia, chest pain or fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.42,
      "end_seconds": 123.76,
      "duration_seconds": 2.34,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.44,
      "end_seconds": 127.64,
      "duration_seconds": 2.2,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.05,
      "end_seconds": 146.04,
      "duration_seconds": 3.99,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.87,
      "end_seconds": 148.3,
      "duration_seconds": 1.43,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.17,
      "end_seconds": 150.98,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.74,
      "end_seconds": 159.53,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.33,
      "end_seconds": 162.54,
      "duration_seconds": 2.21,
      "text": "Okay, have you retired yet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.62,
      "end_seconds": 167.77,
      "duration_seconds": 4.15,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.01,
      "end_seconds": 172.57,
      "duration_seconds": 3.56,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.6,
      "end_seconds": 182.68,
      "duration_seconds": 8.08,
      "text": "An irregular heartbeat, for two years. I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.49,
      "end_seconds": 195.84,
      "duration_seconds": 12.35,
      "text": "I see, go ahead. Okay, I can see an irregular heartbeat in your file as well. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.5,
      "end_seconds": 207.84,
      "duration_seconds": 2.34,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.14,
      "end_seconds": 228.28,
      "duration_seconds": 6.14,
      "text": "Okay: respiratory rate 18, pressure 136 over 84, temp 37.0 degrees, pulse 121."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.46,
      "end_seconds": 233.05,
      "duration_seconds": 2.59,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.32,
      "end_seconds": 236.71,
      "duration_seconds": 2.39,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.26,
      "end_seconds": 254.28,
      "duration_seconds": 10.02,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.29,
      "end_seconds": 265.99,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.64,
      "end_seconds": 272.86,
      "duration_seconds": 2.22,
      "text": "Right, that's the examination finished."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.53,
      "end_seconds": 305.65,
      "duration_seconds": 16.12,
      "text": "Taking everything into account, my working impression is possible bowel ischaemia. I want to be honest that this is an impression, not a final answer. We shouldn't forget a bowel obstruction. Let's get urgent blood tests, for severe abdominal pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 306.45,
      "end_seconds": 310.76,
      "duration_seconds": 4.31,
      "text": "I can book that for Tuesday at 11:30 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.39,
      "end_seconds": 320.39,
      "duration_seconds": 9.0,
      "text": "This is an emergency, you are going to hospital now. The surgical team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.67,
      "end_seconds": 324.56,
      "duration_seconds": 2.89,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.35,
      "end_seconds": 336.17,
      "duration_seconds": 9.82,
      "text": "Come back or go to emergency straight away if the symptoms get worse. I'd like you back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.3,
      "end_seconds": 341.49,
      "duration_seconds": 4.19,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}