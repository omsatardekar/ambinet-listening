{
  "schema_version": "1.0",
  "encounter_id": "02861",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 5.25,
      "duration_seconds": 4.26,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 11.27,
      "duration_seconds": 5.02,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.37,
      "end_seconds": 21.74,
      "duration_seconds": 9.37,
      "text": "Doctor, I'm just here to help with the details. It's difficulty concentrating, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 22.27,
      "end_seconds": 33.09,
      "duration_seconds": 10.82,
      "text": "Doctor, I've got the readings for you. Pressure 112 over 75, temp 36.6 degrees, oxygen saturation is 99 percent. Pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.05,
      "end_seconds": 38.45,
      "duration_seconds": 4.4,
      "text": "Thanks. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.13,
      "end_seconds": 41.82,
      "duration_seconds": 2.69,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 48.29,
      "duration_seconds": 3.07,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.69,
      "end_seconds": 56.61,
      "duration_seconds": 5.92,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.62,
      "end_seconds": 65.74,
      "duration_seconds": 5.12,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.94,
      "end_seconds": 68.32,
      "duration_seconds": 1.38,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.83,
      "end_seconds": 75.55,
      "duration_seconds": 6.72,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 75.65,
      "end_seconds": 80.92,
      "duration_seconds": 5.27,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.51,
      "end_seconds": 85.69,
      "duration_seconds": 3.18,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.12,
      "end_seconds": 91.21,
      "duration_seconds": 4.09,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.03,
      "end_seconds": 108.37,
      "duration_seconds": 12.34,
      "text": "I've had restlessness too, uh, for about a month. I did have impatience at one point, um, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.21,
      "end_seconds": 115.61,
      "duration_seconds": 5.4,
      "text": "Have you had any thoughts of self-harm, head injury or drug use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.9,
      "end_seconds": 119.41,
      "duration_seconds": 2.51,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.91,
      "end_seconds": 123.01,
      "duration_seconds": 2.1,
      "text": "Any sign of low mood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.07,
      "end_seconds": 127.97,
      "duration_seconds": 2.9,
      "text": "I haven't noticed any low mood."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.78,
      "end_seconds": 131.61,
      "duration_seconds": 2.83,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.8,
      "end_seconds": 135.81,
      "duration_seconds": 3.01,
      "text": "Erm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.1,
      "end_seconds": 140.56,
      "duration_seconds": 3.46,
      "text": "Okay, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.16,
      "end_seconds": 144.68,
      "duration_seconds": 2.52,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.41,
      "end_seconds": 149.17,
      "duration_seconds": 3.76,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.84,
      "end_seconds": 157.54,
      "duration_seconds": 6.7,
      "text": "My father has Parkinson's disease. Erm, uh, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.22,
      "end_seconds": 173.6,
      "duration_seconds": 3.38,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.76,
      "end_seconds": 187.21,
      "duration_seconds": 12.45,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.11,
      "end_seconds": 190.51,
      "duration_seconds": 2.4,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.61,
      "end_seconds": 200.41,
      "duration_seconds": 7.8,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.84,
      "end_seconds": 204.22,
      "duration_seconds": 2.38,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.24,
      "end_seconds": 221.08,
      "duration_seconds": 15.84,
      "text": "For the anxiety, I believe. My son sets them out for me, I just take what I'm given. I'm on something called prop... propranolol, 40 milligrams, maybe, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.65,
      "end_seconds": 224.52,
      "duration_seconds": 2.87,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.18,
      "end_seconds": 231.83,
      "duration_seconds": 6.65,
      "text": "No, it's at home. Right, I used to take sumatriptan, but I stopped it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.79,
      "end_seconds": 251.01,
      "duration_seconds": 3.22,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.76,
      "end_seconds": 254.1,
      "duration_seconds": 1.34,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.51,
      "end_seconds": 256.75,
      "duration_seconds": 1.24,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.01,
      "end_seconds": 262.39,
      "duration_seconds": 4.38,
      "text": "I've had migraines for about ten years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.28,
      "end_seconds": 266.11,
      "duration_seconds": 2.83,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.22,
      "end_seconds": 272.17,
      "duration_seconds": 1.95,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.91,
      "end_seconds": 274.51,
      "duration_seconds": 1.6,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.9,
      "end_seconds": 277.61,
      "duration_seconds": 1.71,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.85,
      "end_seconds": 281.59,
      "duration_seconds": 2.74,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.13,
      "end_seconds": 286.98,
      "duration_seconds": 2.85,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.62,
      "end_seconds": 289.21,
      "duration_seconds": 1.59,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.7,
      "end_seconds": 292.53,
      "duration_seconds": 1.83,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.47,
      "end_seconds": 314.33,
      "duration_seconds": 4.86,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.74,
      "end_seconds": 330.9,
      "duration_seconds": 12.16,
      "text": "That's all I needed to check. Let me tell you where I've got to. It points towards possible adult attention deficit disorder. Anxiety is still possible. Thyroid problems is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.81,
      "end_seconds": 336.29,
      "duration_seconds": 3.48,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.67,
      "end_seconds": 357.35,
      "duration_seconds": 19.68,
      "text": "Nothing I've seen today points to an emergency. It looks like possible adult attention deficit disorder, but I'd like to confirm. A thyroid test is what I'd like next, for poor concentration. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 358.8,
      "end_seconds": 362.14,
      "duration_seconds": 3.34,
      "text": "I can book that for Tuesday at 10 am."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.34,
      "end_seconds": 365.29,
      "duration_seconds": 1.95,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.99,
      "end_seconds": 370.34,
      "duration_seconds": 4.35,
      "text": "I'm sending you for a questionnaire because of attention problems."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.44,
      "end_seconds": 374.35,
      "duration_seconds": 1.91,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.96,
      "end_seconds": 391.3,
      "duration_seconds": 15.34,
      "text": "Use lists and reminders while we arrange the specialist assessment. Cut down on salt and fried food for now, it really does make a difference. I'm going to send a referral to the adult ADHD service."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.58,
      "end_seconds": 394.09,
      "duration_seconds": 1.51,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.63,
      "end_seconds": 404.48,
      "duration_seconds": 8.85,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.9,
      "end_seconds": 409.53,
      "duration_seconds": 3.63,
      "text": "Ah, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.56,
      "end_seconds": 419.38,
      "duration_seconds": 8.82,
      "text": "Come back or go to emergency straight away if the symptoms get worse. We'll catch up after the assessment."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.51,
      "end_seconds": 425.74,
      "duration_seconds": 2.23,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.46,
      "end_seconds": 433.87,
      "duration_seconds": 7.41,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.21,
      "end_seconds": 440.64,
      "duration_seconds": 5.43,
      "text": "So, I come back after the assessment. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.66,
      "end_seconds": 445.28,
      "duration_seconds": 3.62,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.04,
      "end_seconds": 449.22,
      "duration_seconds": 3.18,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.28,
      "end_seconds": 452.69,
      "duration_seconds": 1.41,
      "text": "See you soon."
    }
  ]
}