{
  "schema_version": "1.0",
  "encounter_id": "02833",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.25,
      "end_seconds": 5.11,
      "duration_seconds": 3.86,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.58,
      "end_seconds": 10.63,
      "duration_seconds": 4.05,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.52,
      "end_seconds": 19.51,
      "duration_seconds": 7.99,
      "text": "Hmm, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.56,
      "end_seconds": 25.09,
      "duration_seconds": 4.53,
      "text": "So, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.83,
      "end_seconds": 34.99,
      "duration_seconds": 8.16,
      "text": "I've been dealing with severe pain in my left side going to the groin."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.96,
      "end_seconds": 39.46,
      "duration_seconds": 3.5,
      "text": "Okay, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.43,
      "end_seconds": 44.02,
      "duration_seconds": 2.59,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.1,
      "end_seconds": 55.22,
      "duration_seconds": 9.12,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.1,
      "end_seconds": 65.44,
      "duration_seconds": 9.34,
      "text": "I, I get some relief from heat. Mostly mild. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.35,
      "end_seconds": 72.29,
      "duration_seconds": 5.94,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 72.39,
      "end_seconds": 79.21,
      "duration_seconds": 6.82,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.48,
      "end_seconds": 82.79,
      "duration_seconds": 2.31,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.82,
      "end_seconds": 91.45,
      "duration_seconds": 6.63,
      "text": "And there's blood in the urine as well, five days now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 94.63,
      "end_seconds": 97.0,
      "duration_seconds": 2.37,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 99.59,
      "duration_seconds": 1.89,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.13,
      "end_seconds": 105.21,
      "duration_seconds": 4.08,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.85,
      "end_seconds": 107.12,
      "duration_seconds": 1.27,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.22,
      "end_seconds": 111.59,
      "duration_seconds": 3.37,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.44,
      "end_seconds": 115.52,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.0,
      "end_seconds": 121.87,
      "duration_seconds": 4.87,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.44,
      "end_seconds": 127.55,
      "duration_seconds": 5.11,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.44,
      "end_seconds": 142.65,
      "duration_seconds": 14.21,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.74,
      "end_seconds": 148.47,
      "duration_seconds": 3.73,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.15,
      "end_seconds": 156.68,
      "duration_seconds": 7.53,
      "text": "Anxiety, for two years. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.25,
      "end_seconds": 157.95,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.73,
      "end_seconds": 163.43,
      "duration_seconds": 3.7,
      "text": "Yes, asthma. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.41,
      "end_seconds": 166.11,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.44,
      "end_seconds": 168.98,
      "duration_seconds": 1.54,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.49,
      "end_seconds": 181.19,
      "duration_seconds": 11.7,
      "text": "Right, so asthma and arthritis in your knees are already on your record. We'll keep that in mind today. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.83,
      "end_seconds": 188.99,
      "duration_seconds": 6.16,
      "text": "Yeah, I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.81,
      "end_seconds": 193.0,
      "duration_seconds": 2.19,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.87,
      "end_seconds": 200.5,
      "duration_seconds": 6.63,
      "text": "It's Seretide inhaler, twice a day. Diclofenac, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.63,
      "end_seconds": 208.58,
      "duration_seconds": 2.95,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.44,
      "end_seconds": 227.1,
      "duration_seconds": 16.66,
      "text": "Ah, not with me. I'll bring it next time. It's hydrocortisone cream, when needed. Okay, uh, so I used to take paracetamol, but I stopped it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.16,
      "end_seconds": 240.9,
      "duration_seconds": 4.74,
      "text": "Have you had any vomiting or burning when passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.96,
      "end_seconds": 259.4,
      "duration_seconds": 17.44,
      "text": "Um, um, no, no vomiting, no burning when passing urine. I did have not being able to lie still at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.96,
      "end_seconds": 264.61,
      "duration_seconds": 3.65,
      "text": "A few quick ones: passing no urine or fever?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.17,
      "end_seconds": 269.0,
      "duration_seconds": 2.83,
      "text": "Erm, none of those, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.18,
      "end_seconds": 278.38,
      "duration_seconds": 3.2,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 279.91,
      "end_seconds": 286.28,
      "duration_seconds": 6.37,
      "text": "Right, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.44,
      "end_seconds": 290.12,
      "duration_seconds": 2.68,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.47,
      "end_seconds": 294.02,
      "duration_seconds": 2.55,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 296.84,
      "end_seconds": 309.22,
      "duration_seconds": 12.38,
      "text": "Here are the numbers, doctor. Respiratory rate 18, pulse is 67 beats a minute. Oxygen saturation is 99 percent, temperature 36.5, BP is 118 over 82."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.01,
      "end_seconds": 312.39,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.23,
      "end_seconds": 318.95,
      "duration_seconds": 3.72,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.72,
      "end_seconds": 322.37,
      "duration_seconds": 2.65,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.19,
      "end_seconds": 326.57,
      "duration_seconds": 2.38,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.43,
      "end_seconds": 351.81,
      "duration_seconds": 6.38,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 352.52,
      "end_seconds": 354.24,
      "duration_seconds": 1.72,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.58,
      "end_seconds": 360.21,
      "duration_seconds": 1.63,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.4,
      "end_seconds": 384.34,
      "duration_seconds": 10.94,
      "text": "Taking everything into account, it's hard to say. Kidney stone colic is one possibility and a urine infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 385.8,
      "end_seconds": 389.0,
      "duration_seconds": 3.2,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.52,
      "end_seconds": 415.8,
      "duration_seconds": 26.28,
      "text": "Nothing I've seen today points to an emergency. It looks like kidney stone colic, but I'd like to confirm. I'd like to arrange kidney function tests for renal colic. Let's get a CT scan of the kidneys and bladder, for renal colic. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 421.02,
      "end_seconds": 422.51,
      "duration_seconds": 1.49,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.18,
      "end_seconds": 452.61,
      "duration_seconds": 29.43,
      "text": "Drink plenty of water and strain the urine to catch the stone. I think the urology clinic should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's hold off on a urine dipstick for now, and if there's no change next month we can revisit it. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 454.56,
      "end_seconds": 458.31,
      "duration_seconds": 3.75,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.2,
      "end_seconds": 461.75,
      "duration_seconds": 2.55,
      "text": "We'll catch up in one week."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 463.05,
      "end_seconds": 465.26,
      "duration_seconds": 2.21,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.65,
      "end_seconds": 471.88,
      "duration_seconds": 5.23,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 475.61,
      "end_seconds": 478.08,
      "duration_seconds": 2.47,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.64,
      "end_seconds": 480.84,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}