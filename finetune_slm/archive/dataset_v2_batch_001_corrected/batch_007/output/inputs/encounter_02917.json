{
  "schema_version": "1.0",
  "encounter_id": "02917",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.56,
      "duration_seconds": 3.67,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.99,
      "end_seconds": 11.15,
      "duration_seconds": 5.16,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.92,
      "end_seconds": 19.32,
      "duration_seconds": 7.4,
      "text": "Doctor, it's a growing red ring on my thigh. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.07,
      "end_seconds": 23.98,
      "duration_seconds": 2.91,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.89,
      "end_seconds": 31.32,
      "duration_seconds": 3.43,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.81,
      "end_seconds": 36.15,
      "duration_seconds": 3.34,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.86,
      "end_seconds": 41.23,
      "duration_seconds": 3.37,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.82,
      "end_seconds": 45.34,
      "duration_seconds": 2.52,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.91,
      "end_seconds": 57.59,
      "duration_seconds": 10.68,
      "text": "A mild headache goes along with it, most of the time. The mild headache? That's been for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.76,
      "end_seconds": 66.2,
      "duration_seconds": 4.44,
      "text": "Have you noticed facial weakness, palpitations or stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.3,
      "end_seconds": 73.85,
      "duration_seconds": 5.55,
      "text": "No facial weakness, palpitations or stiff neck, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.4,
      "end_seconds": 79.45,
      "duration_seconds": 4.05,
      "text": "Have you had joint swelling, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.88,
      "end_seconds": 84.84,
      "duration_seconds": 3.96,
      "text": "No, I haven't had any joint swelling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.57,
      "end_seconds": 88.53,
      "duration_seconds": 2.96,
      "text": "Alright, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.81,
      "end_seconds": 91.98,
      "duration_seconds": 2.17,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.1,
      "end_seconds": 95.26,
      "duration_seconds": 2.16,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.4,
      "end_seconds": 98.13,
      "duration_seconds": 1.73,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 102.96,
      "duration_seconds": 3.88,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.06,
      "end_seconds": 105.52,
      "duration_seconds": 1.46,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.19,
      "end_seconds": 119.85,
      "duration_seconds": 1.66,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.33,
      "end_seconds": 124.55,
      "duration_seconds": 3.22,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.03,
      "end_seconds": 127.36,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.55,
      "end_seconds": 134.19,
      "duration_seconds": 3.64,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.56,
      "end_seconds": 140.17,
      "duration_seconds": 2.61,
      "text": "Alright, tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.65,
      "end_seconds": 147.55,
      "duration_seconds": 5.9,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.85,
      "end_seconds": 151.72,
      "duration_seconds": 2.87,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.63,
      "end_seconds": 161.58,
      "duration_seconds": 4.95,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.52,
      "end_seconds": 183.33,
      "duration_seconds": 3.81,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.45,
      "end_seconds": 187.28,
      "duration_seconds": 2.83,
      "text": "Well, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.56,
      "end_seconds": 193.34,
      "duration_seconds": 4.78,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.85,
      "end_seconds": 198.35,
      "duration_seconds": 4.5,
      "text": "Yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.6,
      "end_seconds": 213.94,
      "duration_seconds": 2.34,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.35,
      "end_seconds": 228.31,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.0,
      "end_seconds": 248.86,
      "duration_seconds": 9.86,
      "text": "Okay: respiratory rate 16, oxygen saturation is 97 percent, temperature is 36.7 degrees, pulse is 67 beats a minute, pressure 114 over 76."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.81,
      "end_seconds": 251.86,
      "duration_seconds": 2.05,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.51,
      "end_seconds": 255.71,
      "duration_seconds": 3.2,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.77,
      "end_seconds": 261.05,
      "duration_seconds": 4.28,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.49,
      "end_seconds": 266.46,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.06,
      "end_seconds": 269.33,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.53,
      "end_seconds": 284.69,
      "duration_seconds": 6.16,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.06,
      "end_seconds": 295.39,
      "duration_seconds": 7.33,
      "text": "You can sit up now. Okay, so my impression is this: It points towards early Lyme disease."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.46,
      "end_seconds": 300.33,
      "duration_seconds": 3.87,
      "text": "Erm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.16,
      "end_seconds": 309.84,
      "duration_seconds": 7.68,
      "text": "I understand the worry. At the moment I'd say it's early Lyme disease, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.27,
      "end_seconds": 343.89,
      "duration_seconds": 23.62,
      "text": "Let's use doxycycline, 100 milligrams, twice a day, twenty-one days. That should help with early Lyme disease. Take the doxycycline with food and avoid strong sun. A short walk every day, even twenty minutes, will help more than you'd think. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.71,
      "end_seconds": 346.31,
      "duration_seconds": 1.6,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.39,
      "end_seconds": 351.79,
      "duration_seconds": 4.4,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.0,
      "end_seconds": 356.62,
      "duration_seconds": 3.62,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}