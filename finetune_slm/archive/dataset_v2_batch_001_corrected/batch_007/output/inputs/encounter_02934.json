{
  "schema_version": "1.0",
  "encounter_id": "02934",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 7.94,
      "duration_seconds": 7.03,
      "text": "Ah, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.49,
      "end_seconds": 14.18,
      "duration_seconds": 4.69,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.17,
      "end_seconds": 21.65,
      "duration_seconds": 6.48,
      "text": "So the thing is, I've got a growing red ring on my thigh."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.17,
      "end_seconds": 25.36,
      "duration_seconds": 3.19,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.72,
      "end_seconds": 44.13,
      "duration_seconds": 14.41,
      "text": "Uh, I'd say about three months. Actually, no, closer to about a month. Oh, and a mild headache. I had aching muscles before. That's settled now, though."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.14,
      "end_seconds": 53.19,
      "duration_seconds": 7.05,
      "text": "Have you had a growing red ring on your thigh before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.04,
      "end_seconds": 60.24,
      "duration_seconds": 6.2,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 81.36,
      "duration_seconds": 5.64,
      "text": "And what about stiff neck, joint swelling, facial weakness or palpitations?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.1,
      "end_seconds": 88.56,
      "duration_seconds": 5.46,
      "text": "No, no stiff neck, joint swelling, facial weakness or palpitations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.23,
      "end_seconds": 92.94,
      "duration_seconds": 3.71,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.55,
      "end_seconds": 95.19,
      "duration_seconds": 1.64,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.94,
      "end_seconds": 99.16,
      "duration_seconds": 2.22,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.93,
      "end_seconds": 102.99,
      "duration_seconds": 3.06,
      "text": "Hmm, no, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 116.06,
      "duration_seconds": 2.56,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.06,
      "end_seconds": 119.89,
      "duration_seconds": 2.83,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.86,
      "end_seconds": 123.76,
      "duration_seconds": 2.9,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.0,
      "end_seconds": 139.16,
      "duration_seconds": 14.16,
      "text": "I'll have a glass of wine with dinner. No, I've never smoked in my life. My partner and our baby. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.18,
      "end_seconds": 143.87,
      "duration_seconds": 3.69,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.94,
      "end_seconds": 149.57,
      "duration_seconds": 4.63,
      "text": "It's metoprolol, twice a day for my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.97,
      "end_seconds": 153.27,
      "duration_seconds": 2.3,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.87,
      "end_seconds": 155.83,
      "duration_seconds": 0.96,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.31,
      "end_seconds": 160.73,
      "duration_seconds": 3.42,
      "text": "How long has that that been going on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.72,
      "end_seconds": 167.1,
      "duration_seconds": 5.38,
      "text": "About three months now. It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 168.81,
      "end_seconds": 174.31,
      "duration_seconds": 5.5,
      "text": "Doctor, our chart from the last visit lists it as 35 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.32,
      "end_seconds": 181.45,
      "duration_seconds": 4.13,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.57,
      "end_seconds": 186.98,
      "duration_seconds": 4.41,
      "text": "mm, I don't think I have it with me"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.5,
      "end_seconds": 191.06,
      "duration_seconds": 2.56,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.75,
      "end_seconds": 203.34,
      "duration_seconds": 11.59,
      "text": "Epilepsy, for five years. I've had heart disease for about a year now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.86,
      "end_seconds": 205.31,
      "duration_seconds": 1.45,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.15,
      "end_seconds": 207.91,
      "duration_seconds": 1.76,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.69,
      "end_seconds": 217.57,
      "duration_seconds": 7.88,
      "text": "Right, so heart disease and thin bones are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 230.8,
      "end_seconds": 239.58,
      "duration_seconds": 8.78,
      "text": "here are the numbers, doctor. Heart rate 65, BP is 114 over 81, oxygen saturation is 98 percent, temp 36.6 degrees"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.33,
      "end_seconds": 242.25,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.81,
      "end_seconds": 248.48,
      "duration_seconds": 4.67,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.34,
      "end_seconds": 250.55,
      "duration_seconds": 1.21,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.3,
      "end_seconds": 268.01,
      "duration_seconds": 6.71,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.92,
      "end_seconds": 287.21,
      "duration_seconds": 14.29,
      "text": "That's all I needed to check. Right, here's what I'm thinking. The most likely explanation is early Lyme disease. That's my thinking for now, and it may change as we learn more. Another possibility is cellulitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.27,
      "end_seconds": 291.97,
      "duration_seconds": 2.7,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.19,
      "end_seconds": 322.2,
      "duration_seconds": 29.01,
      "text": "nothing I've seen today points to an emergency. It looks like early Lyme disease. What I'm giving you is doxycycline, 100 milligrams, twice a day, twenty-one days. It's for early Lyme disease. Take the doxycycline with food and avoid strong sun. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.51,
      "end_seconds": 325.27,
      "duration_seconds": 1.76,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.51,
      "end_seconds": 336.85,
      "duration_seconds": 6.34,
      "text": "Come back in three weeks. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.8,
      "end_seconds": 341.17,
      "duration_seconds": 2.37,
      "text": "Thank you, that's helpful."
    }
  ]
}