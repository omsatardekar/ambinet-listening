{
  "schema_version": "1.0",
  "encounter_id": "02593",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.04,
      "end_seconds": 3.81,
      "duration_seconds": 2.77,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.31,
      "end_seconds": 7.04,
      "duration_seconds": 2.73,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 8.92,
      "duration_seconds": 1.31,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 19.63,
      "duration_seconds": 8.87,
      "text": "It's a blister on my heel. I thought I'd wait, uh, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.99,
      "end_seconds": 22.96,
      "duration_seconds": 1.97,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 26.97,
      "duration_seconds": 3.12,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.9,
      "end_seconds": 30.86,
      "duration_seconds": 2.96,
      "text": "Okay, have you tried anything for it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.91,
      "end_seconds": 35.69,
      "duration_seconds": 3.78,
      "text": "Only a plaster, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.23,
      "end_seconds": 39.7,
      "duration_seconds": 2.47,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.62,
      "end_seconds": 51.18,
      "duration_seconds": 9.56,
      "text": "When it starts I tend to get a little soreness as well. The, The little soreness? That's been for three days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.95,
      "end_seconds": 70.03,
      "duration_seconds": 2.08,
      "text": "And pus, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.86,
      "end_seconds": 73.45,
      "duration_seconds": 1.59,
      "text": "No, no pus."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.5,
      "end_seconds": 77.85,
      "duration_seconds": 2.35,
      "text": "Have you noticed fever or diabetes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.57,
      "end_seconds": 82.65,
      "duration_seconds": 3.08,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 86.13,
      "duration_seconds": 2.47,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.7,
      "end_seconds": 89.31,
      "duration_seconds": 2.61,
      "text": "Oh, no, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.01,
      "end_seconds": 91.47,
      "duration_seconds": 1.46,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.78,
      "end_seconds": 94.83,
      "duration_seconds": 2.05,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.37,
      "end_seconds": 96.63,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.66,
      "end_seconds": 101.39,
      "duration_seconds": 2.73,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.91,
      "end_seconds": 105.92,
      "duration_seconds": 4.01,
      "text": "Alright, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.73,
      "end_seconds": 112.27,
      "duration_seconds": 4.54,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 115.0,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.59,
      "end_seconds": 118.98,
      "duration_seconds": 2.39,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.94,
      "end_seconds": 127.67,
      "duration_seconds": 3.73,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.98,
      "end_seconds": 132.44,
      "duration_seconds": 2.46,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.68,
      "end_seconds": 142.31,
      "duration_seconds": 2.63,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.34,
      "end_seconds": 148.21,
      "duration_seconds": 3.87,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.62,
      "end_seconds": 169.86,
      "duration_seconds": 4.24,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.6,
      "end_seconds": 172.74,
      "duration_seconds": 2.14,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.92,
      "end_seconds": 175.14,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.12,
      "end_seconds": 180.6,
      "duration_seconds": 3.48,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.93,
      "end_seconds": 184.14,
      "duration_seconds": 2.21,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.95,
      "end_seconds": 186.53,
      "duration_seconds": 1.58,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.34,
      "end_seconds": 197.11,
      "duration_seconds": 4.77,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.8,
      "end_seconds": 211.81,
      "duration_seconds": 2.01,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.46,
      "end_seconds": 238.12,
      "duration_seconds": 10.66,
      "text": "Okay: blood pressure 122 over 78, height 179 centimetres. And saturation 97 percent, heart rate 78, weight 57 kilos, temperature 37.0."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.1,
      "end_seconds": 244.88,
      "duration_seconds": 3.78,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.17,
      "end_seconds": 247.94,
      "duration_seconds": 1.77,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.24,
      "end_seconds": 251.57,
      "duration_seconds": 2.33,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.46,
      "end_seconds": 274.4,
      "duration_seconds": 6.94,
      "text": "It's an intact blister on the back of the heel with no redness around it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.83,
      "end_seconds": 282.76,
      "duration_seconds": 2.93,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.28,
      "end_seconds": 300.4,
      "duration_seconds": 7.12,
      "text": "So, based on the history and the examination, the most likely explanation is a simple friction blister."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.17,
      "end_seconds": 303.98,
      "duration_seconds": 2.81,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.15,
      "end_seconds": 325.3,
      "duration_seconds": 20.15,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple friction blister. Leave it intact, cover it with a padded plaster and change the shoes. Book a review if it looks infected. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.34,
      "end_seconds": 329.17,
      "duration_seconds": 2.83,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}