{
  "schema_version": "1.0",
  "encounter_id": "02647",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 3.29,
      "duration_seconds": 2.56,
      "text": "Okay, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.98,
      "end_seconds": 5.88,
      "duration_seconds": 0.9,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 8.71,
      "duration_seconds": 1.25,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.28,
      "end_seconds": 13.55,
      "duration_seconds": 3.27,
      "text": "I've been dealing with a severe headache."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.93,
      "end_seconds": 18.62,
      "duration_seconds": 3.69,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.13,
      "end_seconds": 22.5,
      "duration_seconds": 3.37,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.74,
      "end_seconds": 26.58,
      "duration_seconds": 2.84,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.19,
      "end_seconds": 31.82,
      "duration_seconds": 4.63,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.68,
      "end_seconds": 36.2,
      "duration_seconds": 2.52,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.77,
      "end_seconds": 55.25,
      "duration_seconds": 18.48,
      "text": "When it starts I tend to get swollen face and hands as well. The swollen face and hands? That's been for three days. With swollen face and hands, it happens a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.02,
      "end_seconds": 69.98,
      "duration_seconds": 2.96,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.09,
      "end_seconds": 85.13,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.66,
      "end_seconds": 107.78,
      "duration_seconds": 6.12,
      "text": "Okay: temperature 36.6, heart rate 72, BP is 156 over 93."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.1,
      "end_seconds": 111.4,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.16,
      "end_seconds": 115.46,
      "duration_seconds": 2.3,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.04,
      "end_seconds": 121.25,
      "duration_seconds": 4.21,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.45,
      "end_seconds": 123.73,
      "duration_seconds": 1.28,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.29,
      "end_seconds": 144.76,
      "duration_seconds": 4.47,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.77,
      "end_seconds": 150.34,
      "duration_seconds": 1.57,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.49,
      "end_seconds": 171.43,
      "duration_seconds": 4.94,
      "text": "Any vaginal bleeding, reduced baby movements or leaking fluid at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.95,
      "end_seconds": 175.92,
      "duration_seconds": 3.97,
      "text": "No, uh, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.35,
      "end_seconds": 180.73,
      "duration_seconds": 3.38,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.35,
      "end_seconds": 183.41,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.91,
      "end_seconds": 186.95,
      "duration_seconds": 3.04,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.85,
      "end_seconds": 190.36,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.47,
      "end_seconds": 193.84,
      "duration_seconds": 2.37,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.13,
      "end_seconds": 198.35,
      "duration_seconds": 3.22,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.84,
      "end_seconds": 210.61,
      "duration_seconds": 2.77,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.4,
      "end_seconds": 221.98,
      "duration_seconds": 9.58,
      "text": "Just a meniscus repair on my knee, four years ago. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.78,
      "end_seconds": 232.37,
      "duration_seconds": 4.59,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.17,
      "end_seconds": 235.54,
      "duration_seconds": 2.37,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.17,
      "end_seconds": 239.58,
      "duration_seconds": 3.41,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.19,
      "end_seconds": 241.76,
      "duration_seconds": 1.57,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.08,
      "end_seconds": 246.98,
      "duration_seconds": 3.9,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.4,
      "end_seconds": 259.39,
      "duration_seconds": 10.99,
      "text": "I look after my grandchildren most days. I swim twice a week. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.21,
      "end_seconds": 265.76,
      "duration_seconds": 5.55,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.37,
      "end_seconds": 269.19,
      "duration_seconds": 2.82,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 287.04,
      "duration_seconds": 5.41,
      "text": "Okay, so my impression is this: It points towards severe pre-eclampsia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.94,
      "end_seconds": 294.86,
      "duration_seconds": 2.92,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.65,
      "end_seconds": 315.26,
      "duration_seconds": 18.61,
      "text": "It's reasonable to be concerned, but right now severe pre-eclampsia is my leading thought, not anything worse. Just to be sure I understood. You've had a severe headache, since this morning, and no vaginal bleeding or leaking fluid."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.54,
      "end_seconds": 317.24,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.91,
      "end_seconds": 322.55,
      "duration_seconds": 4.64,
      "text": "I think urgent blood tests makes sense here, for pre-eclampsia."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 323.78,
      "end_seconds": 326.09,
      "duration_seconds": 2.31,
      "text": "The earliest is Thursday, 10 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.82,
      "end_seconds": 331.92,
      "duration_seconds": 1.1,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.61,
      "end_seconds": 354.83,
      "duration_seconds": 22.22,
      "text": "I'm going to put you on labetalol, 200 milligrams, once now, single dose. You take it by mouth. It's for severe hypertension. The pharmacy will go through the details again when you pick it up. You need to go to the maternity unit straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.42,
      "end_seconds": 362.78,
      "duration_seconds": 7.36,
      "text": "Okay, go on. The obstetric team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.56,
      "end_seconds": 367.45,
      "duration_seconds": 2.89,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.2,
      "end_seconds": 375.66,
      "duration_seconds": 7.46,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.24,
      "end_seconds": 378.93,
      "duration_seconds": 1.69,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.69,
      "end_seconds": 383.72,
      "duration_seconds": 4.03,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.34,
      "end_seconds": 386.26,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    }
  ]
}