{
  "schema_version": "1.0",
  "encounter_id": "02617",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.16,
      "end_seconds": 5.35,
      "duration_seconds": 4.19,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 11.65,
      "duration_seconds": 5.09,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.33,
      "end_seconds": 18.47,
      "duration_seconds": 6.14,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.76,
      "end_seconds": 23.39,
      "duration_seconds": 3.63,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.26,
      "end_seconds": 32.84,
      "duration_seconds": 7.58,
      "text": "Honestly, it's dizziness on standing, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.79,
      "end_seconds": 38.14,
      "duration_seconds": 3.35,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.9,
      "end_seconds": 43.45,
      "duration_seconds": 3.55,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.0,
      "end_seconds": 53.3,
      "duration_seconds": 9.3,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.51,
      "end_seconds": 59.07,
      "duration_seconds": 4.56,
      "text": "Standing definitely sets it off. I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.72,
      "end_seconds": 66.45,
      "duration_seconds": 6.73,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 66.55,
      "end_seconds": 72.62,
      "duration_seconds": 6.07,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.86,
      "end_seconds": 78.9,
      "duration_seconds": 5.04,
      "text": "Later, thanks. Please go on. Have you had a sudden high fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.66,
      "end_seconds": 96.61,
      "duration_seconds": 15.95,
      "text": "Yes, about the same, two months. Okay, so and there's vomiting and diarrhoea as well, about three months now. I've also had a widespread sunburn-like rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 97.99,
      "end_seconds": 101.42,
      "duration_seconds": 3.43,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.41,
      "end_seconds": 104.89,
      "duration_seconds": 2.48,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.36,
      "end_seconds": 111.35,
      "duration_seconds": 4.99,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.6,
      "end_seconds": 116.72,
      "duration_seconds": 4.12,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.44,
      "end_seconds": 126.69,
      "duration_seconds": 8.25,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.25,
      "end_seconds": 130.84,
      "duration_seconds": 2.59,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 157.07,
      "duration_seconds": 25.25,
      "text": "For my cholesterol, I believe. My son sets them out for me, I just take what I'm given. Seretide inhaler. I take it twice a day for my asthma. Mm, um, I'm on clopidogrel, 75 milligrams, once a day. I take losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 158.04,
      "end_seconds": 163.07,
      "duration_seconds": 5.03,
      "text": "Doctor, our chart from the last visit lists it as 25 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.52,
      "end_seconds": 169.01,
      "duration_seconds": 4.49,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.55,
      "end_seconds": 172.6,
      "duration_seconds": 3.05,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.68,
      "end_seconds": 177.22,
      "duration_seconds": 3.54,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.07,
      "end_seconds": 181.29,
      "duration_seconds": 2.22,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.05,
      "end_seconds": 184.69,
      "duration_seconds": 1.64,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.21,
      "end_seconds": 187.7,
      "duration_seconds": 2.49,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.74,
      "end_seconds": 190.7,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.74,
      "end_seconds": 198.53,
      "duration_seconds": 6.79,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.48,
      "end_seconds": 220.09,
      "duration_seconds": 2.61,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.64,
      "end_seconds": 224.29,
      "duration_seconds": 3.65,
      "text": "Mm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 225.72,
      "end_seconds": 232.08,
      "duration_seconds": 6.36,
      "text": "I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.62,
      "end_seconds": 237.45,
      "duration_seconds": 3.83,
      "text": "So, maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.28,
      "end_seconds": 245.31,
      "duration_seconds": 6.03,
      "text": "Okay, I'll note both of those. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.1,
      "end_seconds": 269.97,
      "duration_seconds": 23.87,
      "text": "High cholesterol, for about ten years. Asthma, for about a year. I've never really been one for hospitals. Mm, I have heart disease. It's the not knowing that gets to me. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.33,
      "end_seconds": 276.03,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.73,
      "end_seconds": 280.31,
      "duration_seconds": 3.58,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.4,
      "end_seconds": 291.26,
      "duration_seconds": 8.86,
      "text": "Mm-hmm. Okay, I can see asthma and heart disease in your file as well. Any cough, stiff neck or sore throat?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.21,
      "end_seconds": 297.27,
      "duration_seconds": 4.06,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.68,
      "end_seconds": 301.11,
      "duration_seconds": 2.43,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.4,
      "end_seconds": 308.21,
      "duration_seconds": 1.81,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 309.07,
      "end_seconds": 319.66,
      "duration_seconds": 10.59,
      "text": "Okay, so the vitals from earlier. Pressure 94 over 60, SpO2 99 percent on room air, pulse is 110 beats a minute, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.12,
      "end_seconds": 321.82,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.41,
      "end_seconds": 327.34,
      "duration_seconds": 2.93,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.6,
      "end_seconds": 342.83,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.66,
      "end_seconds": 345.09,
      "duration_seconds": 1.43,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.3,
      "end_seconds": 368.09,
      "duration_seconds": 8.79,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.81,
      "end_seconds": 383.1,
      "duration_seconds": 11.29,
      "text": "Right, all finished, thank you. Having listened and examined, my working impression is possible toxic shock syndrome. A viral illness is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.9,
      "end_seconds": 389.62,
      "duration_seconds": 4.72,
      "text": "Yeah, um, is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.28,
      "end_seconds": 419.18,
      "duration_seconds": 25.9,
      "text": "I can't promise yet, but most people with possible toxic shock syndrome do well once it's treated properly. I want blood cultures done, that's for possible toxic shock. I'd like to arrange a vaginal swab for possible toxic shock. I'm prescribing flucloxacillin, 2 grams, now, single dose. That's for possible toxic shock syndrome. Remove any tampon, you are going to hospital now."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.66,
      "end_seconds": 434.68,
      "duration_seconds": 11.02,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back straight away."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 435.46,
      "end_seconds": 437.71,
      "duration_seconds": 2.25,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.88,
      "end_seconds": 443.28,
      "duration_seconds": 4.4,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 444.49,
      "end_seconds": 447.06,
      "duration_seconds": 2.57,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.02,
      "end_seconds": 449.29,
      "duration_seconds": 1.27,
      "text": "Goodbye for now."
    }
  ]
}