{
  "schema_version": "1.0",
  "encounter_id": "02910",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 4.26,
      "duration_seconds": 3.33,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 9.97,
      "duration_seconds": 3.83,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 21.9,
      "duration_seconds": 8.61,
      "text": "Mainly a rolled ankle. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.51,
      "end_seconds": 26.46,
      "duration_seconds": 2.95,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.14,
      "end_seconds": 30.46,
      "duration_seconds": 2.32,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.66,
      "end_seconds": 32.26,
      "duration_seconds": 1.6,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.19,
      "end_seconds": 48.04,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.75,
      "end_seconds": 53.11,
      "duration_seconds": 3.36,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 56.14,
      "duration_seconds": 1.89,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.81,
      "end_seconds": 61.68,
      "duration_seconds": 3.87,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.14,
      "end_seconds": 66.28,
      "duration_seconds": 3.14,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.99,
      "end_seconds": 75.35,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.71,
      "end_seconds": 83.0,
      "duration_seconds": 2.29,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.15,
      "end_seconds": 90.31,
      "duration_seconds": 6.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 106.63,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.53,
      "end_seconds": 114.04,
      "duration_seconds": 5.51,
      "text": "I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.31,
      "end_seconds": 117.82,
      "duration_seconds": 2.51,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.89,
      "end_seconds": 129.76,
      "duration_seconds": 10.87,
      "text": "Naproxen, 250 milligrams, twice a day. I took the morning off to come in today. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.59,
      "end_seconds": 152.2,
      "duration_seconds": 4.61,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.0,
      "end_seconds": 160.64,
      "duration_seconds": 6.64,
      "text": "Years back I got vomiting from tramadol, so I stay away from it now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.94,
      "end_seconds": 164.83,
      "duration_seconds": 2.89,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.8,
      "end_seconds": 170.07,
      "duration_seconds": 3.27,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.47,
      "end_seconds": 174.72,
      "duration_seconds": 3.25,
      "text": "Any pop, pain in the shin or numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.69,
      "end_seconds": 182.77,
      "duration_seconds": 6.08,
      "text": "I haven't had pop, pain in the shin or numbness, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.7,
      "end_seconds": 186.37,
      "duration_seconds": 2.67,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.92,
      "end_seconds": 188.85,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.45,
      "end_seconds": 193.31,
      "duration_seconds": 3.86,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.81,
      "end_seconds": 197.2,
      "duration_seconds": 2.39,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.27,
      "end_seconds": 204.13,
      "duration_seconds": 4.86,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.57,
      "end_seconds": 218.7,
      "duration_seconds": 2.13,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 247.17,
      "duration_seconds": 8.6,
      "text": "Okay: heart rate 73, oxygen saturation is 99 percent, temperature 36.7, BP is 123 over 80, respiratory rate 17."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.63,
      "end_seconds": 254.01,
      "duration_seconds": 4.38,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.12,
      "end_seconds": 256.34,
      "duration_seconds": 1.22,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.4,
      "end_seconds": 275.69,
      "duration_seconds": 8.29,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.48,
      "end_seconds": 281.43,
      "duration_seconds": 2.95,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.95,
      "end_seconds": 313.41,
      "duration_seconds": 15.46,
      "text": "So, based on the history and the examination, this looks most like a mild ankle sprain. Rest, ice, compression and elevation, then gradual strengthening. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.85,
      "end_seconds": 317.71,
      "duration_seconds": 2.86,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.71,
      "end_seconds": 320.38,
      "duration_seconds": 1.67,
      "text": "Have a good day."
    }
  ]
}