{
  "schema_version": "1.0",
  "encounter_id": "02862",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 6.34,
      "duration_seconds": 5.18,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.9,
      "end_seconds": 11.31,
      "duration_seconds": 4.41,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.52,
      "end_seconds": 21.07,
      "duration_seconds": 5.55,
      "text": "Um, so... fainting on exertion. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.33,
      "end_seconds": 25.06,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.61,
      "end_seconds": 39.95,
      "duration_seconds": 14.34,
      "text": "Uh, I'm on omeprazole, 20 milligrams, once a day for the reflux. Hmm, I used to take pantoprazole, but I stopped it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.39,
      "end_seconds": 59.03,
      "duration_seconds": 3.64,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.58,
      "end_seconds": 73.2,
      "duration_seconds": 13.62,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.94,
      "end_seconds": 77.02,
      "duration_seconds": 2.08,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.92,
      "end_seconds": 85.41,
      "duration_seconds": 7.49,
      "text": "It's worse with exertion. Actually, and swollen ankles as well, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.31,
      "end_seconds": 90.68,
      "duration_seconds": 3.37,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.64,
      "end_seconds": 95.76,
      "duration_seconds": 3.12,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.6,
      "end_seconds": 100.31,
      "duration_seconds": 3.71,
      "text": "A few quick ones: leg pain, fever or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.36,
      "end_seconds": 105.63,
      "duration_seconds": 3.27,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.38,
      "end_seconds": 108.94,
      "duration_seconds": 2.56,
      "text": "Okay, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 113.03,
      "duration_seconds": 2.78,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.22,
      "end_seconds": 118.41,
      "duration_seconds": 2.19,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.3,
      "end_seconds": 120.28,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.3,
      "end_seconds": 133.69,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.46,
      "end_seconds": 136.23,
      "duration_seconds": 1.77,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.1,
      "end_seconds": 140.99,
      "duration_seconds": 2.89,
      "text": "Okay, what about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.53,
      "end_seconds": 151.74,
      "duration_seconds": 10.21,
      "text": "Sorry, what was I saying, I've got acid reflux. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.93,
      "end_seconds": 157.95,
      "duration_seconds": 5.02,
      "text": "Alright, acid reflux, that matches what I have here. How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.52,
      "end_seconds": 162.02,
      "duration_seconds": 3.5,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.32,
      "end_seconds": 169.2,
      "duration_seconds": 1.88,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.06,
      "end_seconds": 175.64,
      "duration_seconds": 5.58,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.65,
      "end_seconds": 179.59,
      "duration_seconds": 2.94,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.33,
      "end_seconds": 189.14,
      "duration_seconds": 3.81,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.59,
      "end_seconds": 192.4,
      "duration_seconds": 1.81,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.06,
      "end_seconds": 198.05,
      "duration_seconds": 3.99,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.1,
      "end_seconds": 200.92,
      "duration_seconds": 1.82,
      "text": "Okay, and your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.07,
      "end_seconds": 206.23,
      "duration_seconds": 4.16,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.96,
      "end_seconds": 217.95,
      "duration_seconds": 6.99,
      "text": "Right, are there any allergies I should be aware of? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.21,
      "end_seconds": 224.48,
      "duration_seconds": 5.27,
      "text": "Okay, so no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 225.15,
      "end_seconds": 234.56,
      "duration_seconds": 9.41,
      "text": "Here are the numbers, doctor. Heart rate 95, saturation 92 percent. Blood pressure 136 over 79, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.1,
      "end_seconds": 237.19,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.37,
      "end_seconds": 243.9,
      "duration_seconds": 5.53,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.86,
      "end_seconds": 247.97,
      "duration_seconds": 2.11,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.89,
      "end_seconds": 270.82,
      "duration_seconds": 4.93,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.32,
      "end_seconds": 294.33,
      "duration_seconds": 21.01,
      "text": "You can sit up now. Okay, thinking it through, my working impression is possible pulmonary hypertension. I want to be honest that this is an impression, not a final answer. It could also be chronic clots in the lungs, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 303.81,
      "end_seconds": 309.39,
      "duration_seconds": 5.58,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.42,
      "end_seconds": 320.22,
      "duration_seconds": 9.8,
      "text": "Good, thanks for doing that. Let's book an echocardiogram to look into exertional syncope. No exertion for now, I am arranging urgent specialist tests."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.72,
      "end_seconds": 333.86,
      "duration_seconds": 13.14,
      "text": "Mm, okay. I'm not ordering blood tests today. If things carry on in two weeks, we'll consider it. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.2,
      "end_seconds": 338.18,
      "duration_seconds": 0.98,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.5,
      "end_seconds": 341.89,
      "duration_seconds": 2.39,
      "text": "We'll catch up in one week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.3,
      "end_seconds": 344.0,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.51,
      "end_seconds": 347.85,
      "duration_seconds": 3.34,
      "text": "Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.63,
      "end_seconds": 351.77,
      "duration_seconds": 3.14,
      "text": "Ah, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.05,
      "end_seconds": 354.42,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
}