{
  "schema_version": "1.0",
  "encounter_id": "02557",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.43,
      "duration_seconds": 4.52,
      "text": "Morning, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.28,
      "end_seconds": 12.26,
      "duration_seconds": 4.98,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.26,
      "end_seconds": 21.96,
      "duration_seconds": 8.7,
      "text": "Let me think, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.94,
      "end_seconds": 29.08,
      "duration_seconds": 5.14,
      "text": "well, I've been having pain under the right ribs"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.5,
      "end_seconds": 33.32,
      "duration_seconds": 2.82,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.01,
      "end_seconds": 37.12,
      "duration_seconds": 3.11,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.78,
      "end_seconds": 40.63,
      "duration_seconds": 2.85,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.77,
      "end_seconds": 44.86,
      "duration_seconds": 1.09,
      "text": "mostly severe"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.17,
      "end_seconds": 48.61,
      "duration_seconds": 2.44,
      "text": "Have you had seeing flashing lights?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.38,
      "end_seconds": 51.32,
      "duration_seconds": 1.94,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.82,
      "end_seconds": 55.83,
      "duration_seconds": 4.01,
      "text": "What about swollen face and hands, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.87,
      "end_seconds": 60.11,
      "duration_seconds": 2.24,
      "text": "yes, for three days"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.23,
      "end_seconds": 70.18,
      "duration_seconds": 6.95,
      "text": "Have you had pain under the right ribs before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.97,
      "end_seconds": 75.99,
      "duration_seconds": 5.02,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.82,
      "end_seconds": 83.86,
      "duration_seconds": 6.04,
      "text": "have you had any reduced baby movements, leaking fluid or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.58,
      "end_seconds": 90.46,
      "duration_seconds": 4.88,
      "text": "I mean, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.32,
      "end_seconds": 94.38,
      "duration_seconds": 3.06,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.3,
      "end_seconds": 99.85,
      "duration_seconds": 3.55,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.91,
      "end_seconds": 103.03,
      "duration_seconds": 2.12,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.62,
      "end_seconds": 106.26,
      "duration_seconds": 1.64,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.92,
      "end_seconds": 110.26,
      "duration_seconds": 3.34,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.84,
      "end_seconds": 118.08,
      "duration_seconds": 6.24,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.2,
      "end_seconds": 135.66,
      "duration_seconds": 4.46,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 143.18,
      "duration_seconds": 6.73,
      "text": "Diabetes, for about ten years. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.32,
      "end_seconds": 147.58,
      "duration_seconds": 3.26,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.76,
      "end_seconds": 150.93,
      "duration_seconds": 2.17,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.02,
      "end_seconds": 168.79,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.35,
      "end_seconds": 171.88,
      "duration_seconds": 2.53,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.61,
      "end_seconds": 179.57,
      "duration_seconds": 2.96,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.16,
      "end_seconds": 187.06,
      "duration_seconds": 5.9,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.89,
      "end_seconds": 191.29,
      "duration_seconds": 2.4,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.27,
      "end_seconds": 198.98,
      "duration_seconds": 6.71,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.39,
      "end_seconds": 205.01,
      "duration_seconds": 4.62,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 206.8,
      "end_seconds": 215.06,
      "duration_seconds": 8.26,
      "text": "She is on glibenclamide, 5 milligrams, before breakfast, I give it to to her."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.71,
      "end_seconds": 220.12,
      "duration_seconds": 4.41,
      "text": "before this I was on gliclazide; that's been stopped"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.93,
      "end_seconds": 225.99,
      "duration_seconds": 4.06,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.57,
      "end_seconds": 235.69,
      "duration_seconds": 2.12,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.78,
      "end_seconds": 267.27,
      "duration_seconds": 14.49,
      "text": "Okay: height 164 centimetres, blood pressure 150 over 100, temp 36.7 degrees, pulse 88, oxygen saturation is 96 percent, BMI works out to 19.3, weight 52 kilos, respiratory rate 18."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.94,
      "end_seconds": 272.61,
      "duration_seconds": 3.67,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.22,
      "end_seconds": 275.44,
      "duration_seconds": 1.22,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.19,
      "end_seconds": 288.6,
      "duration_seconds": 4.41,
      "text": "your blood pressure is very high and your reflexes are brisk"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.53,
      "end_seconds": 292.61,
      "duration_seconds": 1.08,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.86,
      "end_seconds": 312.35,
      "duration_seconds": 14.49,
      "text": "Okay, thank you, you can get dressed. Putting it all together, I'd lean towards severe pre-eclampsia. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.25,
      "end_seconds": 314.77,
      "duration_seconds": 1.52,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.06,
      "end_seconds": 331.24,
      "duration_seconds": 15.18,
      "text": "It's reasonable to be concerned, but right now severe pre-eclampsia is my leading thought, not anything worse. I think a urine protein test makes sense here, for pre-eclampsia. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.58,
      "end_seconds": 339.83,
      "duration_seconds": 3.25,
      "text": "Um, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.18,
      "end_seconds": 342.38,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}