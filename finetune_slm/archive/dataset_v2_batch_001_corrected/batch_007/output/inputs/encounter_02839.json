      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.11,
      "end_seconds": 324.72,
      "duration_seconds": 4.61,
      "text": "Hmm, do you think it's something serious?"
