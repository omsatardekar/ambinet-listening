{
  "schema_version": "1.0",
  "encounter_id": "02659",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.47,
      "duration_seconds": 3.92,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.97,
      "end_seconds": 9.08,
      "duration_seconds": 4.11,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.95,
      "end_seconds": 13.7,
      "duration_seconds": 3.75,
      "text": "It's weakness climbing up my legs, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.84,
      "end_seconds": 19.5,
      "duration_seconds": 2.66,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.9,
      "end_seconds": 33.55,
      "duration_seconds": 2.65,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.02,
      "end_seconds": 56.31,
      "duration_seconds": 9.29,
      "text": "okay: temperature is 36.5 degrees, BP is 123 over 70, saturation 97 percent, pulse is 68 beats a minute"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.76,
      "end_seconds": 59.31,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.71,
      "end_seconds": 66.34,
      "duration_seconds": 3.63,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.6,
      "end_seconds": 81.68,
      "duration_seconds": 6.08,
      "text": "how long has this been bothering you? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.24,
      "end_seconds": 85.8,
      "duration_seconds": 3.56,
      "text": "It's been going on for five days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.06,
      "end_seconds": 89.61,
      "duration_seconds": 3.55,
      "text": "Mm-hmm. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.34,
      "end_seconds": 93.09,
      "duration_seconds": 1.75,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.47,
      "end_seconds": 97.84,
      "duration_seconds": 4.37,
      "text": "Hm, okay. Any a recent stomach bug as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.29,
      "end_seconds": 103.24,
      "duration_seconds": 3.95,
      "text": "Yeah, that too. There's difficulty walking as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.66,
      "end_seconds": 113.23,
      "duration_seconds": 5.57,
      "text": "Let me check a few things. Any back pain, fever or bladder problems?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.58,
      "end_seconds": 122.06,
      "duration_seconds": 2.48,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.95,
      "end_seconds": 126.16,
      "duration_seconds": 2.21,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.77,
      "end_seconds": 130.53,
      "duration_seconds": 2.76,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.2,
      "end_seconds": 144.45,
      "duration_seconds": 2.25,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.92,
      "end_seconds": 147.05,
      "duration_seconds": 1.13,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.64,
      "end_seconds": 150.64,
      "duration_seconds": 3.0,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.07,
      "end_seconds": 158.5,
      "duration_seconds": 2.43,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.95,
      "end_seconds": 164.2,
      "duration_seconds": 4.25,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.53,
      "end_seconds": 169.48,
      "duration_seconds": 3.95,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.5,
      "end_seconds": 171.86,
      "duration_seconds": 1.36,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.39,
      "end_seconds": 176.64,
      "duration_seconds": 4.25,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.11,
      "end_seconds": 179.81,
      "duration_seconds": 1.7,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.3,
      "end_seconds": 183.6,
      "duration_seconds": 2.3,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.82,
      "end_seconds": 198.35,
      "duration_seconds": 3.53,
      "text": "so, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.02,
      "end_seconds": 203.65,
      "duration_seconds": 3.63,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.21,
      "end_seconds": 207.23,
      "duration_seconds": 3.02,
      "text": "Right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.17,
      "end_seconds": 210.42,
      "duration_seconds": 2.25,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.34,
      "end_seconds": 215.62,
      "duration_seconds": 3.28,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.24,
      "end_seconds": 220.35,
      "duration_seconds": 3.11,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.2,
      "end_seconds": 226.5,
      "duration_seconds": 3.3,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.25,
      "end_seconds": 229.59,
      "duration_seconds": 1.34,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.92,
      "end_seconds": 246.11,
      "duration_seconds": 6.19,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.07,
      "end_seconds": 279.96,
      "duration_seconds": 28.89,
      "text": "thank you, you can get dressed so, based on the history and the examination, it's hard to say. Possible Guillain-Barre syndrome is one possibility and a spinal cord problem another, and I'd rather not commit yet stop me if I've got anything wrong you've had weakness climbing up your legs for five days, moderate, and no fever or back pain"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.89,
      "end_seconds": 281.59,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.49,
      "end_seconds": 287.01,
      "duration_seconds": 4.52,
      "text": "A lumbar puncture is what I'd like next, for possible GBS."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 291.42,
      "end_seconds": 296.23,
      "duration_seconds": 4.81,
      "text": "We have a slot Wednesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.96,
      "end_seconds": 305.39,
      "duration_seconds": 8.43,
      "text": "I'll request a breathing test, it'll help with possible GBS. You must be admitted today for monitoring of your breathing"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.93,
      "end_seconds": 311.08,
      "duration_seconds": 5.15,
      "text": "I see, go ahead. I'll also refer you to the neurology team."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.89,
      "end_seconds": 313.36,
      "duration_seconds": 1.47,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.41,
      "end_seconds": 320.65,
      "duration_seconds": 5.24,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.73,
      "end_seconds": 324.26,
      "duration_seconds": 1.53,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.32,
      "end_seconds": 327.84,
      "duration_seconds": 2.52,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.68,
      "end_seconds": 330.4,
      "duration_seconds": 1.72,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.94,
      "end_seconds": 332.35,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}