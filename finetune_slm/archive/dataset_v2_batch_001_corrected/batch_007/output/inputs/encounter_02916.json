{
  "schema_version": "1.0",
  "encounter_id": "02916",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 4.73,
      "duration_seconds": 3.54,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 9.62,
      "duration_seconds": 3.71,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.22,
      "end_seconds": 15.07,
      "duration_seconds": 4.85,
      "text": "I've been dealing with a chesty cough for a week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.7,
      "end_seconds": 18.84,
      "duration_seconds": 3.14,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.83,
      "end_seconds": 24.76,
      "duration_seconds": 3.93,
      "text": "Yeah, for about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.15,
      "end_seconds": 30.58,
      "duration_seconds": 2.43,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.36,
      "end_seconds": 35.81,
      "duration_seconds": 3.45,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.93,
      "end_seconds": 40.2,
      "duration_seconds": 3.27,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.75,
      "end_seconds": 45.1,
      "duration_seconds": 4.35,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.39,
      "end_seconds": 48.34,
      "duration_seconds": 1.95,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.86,
      "end_seconds": 52.74,
      "duration_seconds": 2.88,
      "text": "It settles a little with honey."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.97,
      "end_seconds": 55.97,
      "duration_seconds": 2.0,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.92,
      "end_seconds": 70.58,
      "duration_seconds": 13.66,
      "text": "Slight aching goes along with it, most of the time. The slight aching? That's been for about three months. I've also had a sore throat earlier, for about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.61,
      "end_seconds": 75.16,
      "duration_seconds": 2.55,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.88,
      "end_seconds": 90.36,
      "duration_seconds": 2.48,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.23,
      "end_seconds": 116.88,
      "duration_seconds": 8.65,
      "text": "Okay: BP is 113 over 72, heart rate 66. And respiratory rate 15, oxygen saturation is 97 percent, temperature 36.7."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.83,
      "end_seconds": 124.39,
      "duration_seconds": 4.56,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.68,
      "end_seconds": 127.32,
      "duration_seconds": 1.64,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.28,
      "end_seconds": 141.98,
      "duration_seconds": 3.7,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.37,
      "end_seconds": 146.14,
      "duration_seconds": 1.77,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.35,
      "end_seconds": 165.46,
      "duration_seconds": 6.11,
      "text": "So, any breathlessness, chest pain, coughing up blood or fever at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.98,
      "end_seconds": 170.85,
      "duration_seconds": 3.87,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.7,
      "end_seconds": 174.71,
      "duration_seconds": 3.01,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.6,
      "end_seconds": 178.37,
      "duration_seconds": 1.77,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.69,
      "end_seconds": 182.16,
      "duration_seconds": 2.47,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.2,
      "end_seconds": 189.5,
      "duration_seconds": 3.3,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.86,
      "end_seconds": 198.55,
      "duration_seconds": 7.69,
      "text": "Right, right. Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.24,
      "end_seconds": 221.07,
      "duration_seconds": 5.83,
      "text": "Let's run through your medicines. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.97,
      "end_seconds": 227.64,
      "duration_seconds": 4.67,
      "text": "I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.61,
      "end_seconds": 229.81,
      "duration_seconds": 1.2,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.88,
      "end_seconds": 237.85,
      "duration_seconds": 5.97,
      "text": "About a year now. I'm, I'm on honey and lemon, at night."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.45,
      "end_seconds": 244.46,
      "duration_seconds": 5.01,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.87,
      "end_seconds": 248.94,
      "duration_seconds": 3.07,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.44,
      "end_seconds": 251.63,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.59,
      "end_seconds": 259.82,
      "duration_seconds": 6.23,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.53,
      "end_seconds": 266.84,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.59,
      "end_seconds": 271.96,
      "duration_seconds": 4.37,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.6,
      "end_seconds": 275.23,
      "duration_seconds": 1.63,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.34,
      "end_seconds": 280.07,
      "duration_seconds": 3.73,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.94,
      "end_seconds": 282.21,
      "duration_seconds": 1.27,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.31,
      "end_seconds": 287.76,
      "duration_seconds": 4.45,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.49,
      "end_seconds": 309.4,
      "duration_seconds": 6.91,
      "text": "Putting it all together, I think we're dealing with acute viral bronchitis at this stage."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.05,
      "end_seconds": 315.91,
      "duration_seconds": 2.86,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.72,
      "end_seconds": 347.21,
      "duration_seconds": 30.49,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Let's plan a check if not better in three weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.34,
      "end_seconds": 351.61,
      "duration_seconds": 3.27,
      "text": "Great, thank you for your help."
    }
  ]
}