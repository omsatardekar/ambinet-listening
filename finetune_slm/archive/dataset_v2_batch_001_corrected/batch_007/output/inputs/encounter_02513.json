{
  "schema_version": "1.0",
  "encounter_id": "02513",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 3.16,
      "duration_seconds": 2.49,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.66,
      "end_seconds": 4.67,
      "duration_seconds": 1.01,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.72,
      "end_seconds": 12.8,
      "duration_seconds": 6.08,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.81,
      "end_seconds": 20.22,
      "duration_seconds": 5.41,
      "text": "Of course, please stay. It's helpful to have you here. What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.23,
      "end_seconds": 38.26,
      "duration_seconds": 17.03,
      "text": "Yeah, uh, it's it stopping just as suddenly. I don't know what's causing it. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 41.26,
      "duration_seconds": 2.14,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 56.8,
      "duration_seconds": 2.55,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.16,
      "end_seconds": 84.86,
      "duration_seconds": 9.7,
      "text": "Okay: BP is 109 over 71, weight 60 kilos. And temp 36.5 degrees, heart rate 74, saturation 99 percent, height 181 centimetres."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.93,
      "end_seconds": 87.44,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.86,
      "end_seconds": 95.24,
      "duration_seconds": 6.38,
      "text": "Okay, I'll come back to the numbers. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.22,
      "end_seconds": 103.0,
      "duration_seconds": 6.78,
      "text": "Ah, you know, around two weeks... no wait, it's more like four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.38,
      "end_seconds": 106.42,
      "duration_seconds": 2.04,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.77,
      "end_seconds": 114.67,
      "duration_seconds": 6.9,
      "text": "When it starts I tend to get my heart suddenly racing as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 124.62,
      "duration_seconds": 9.01,
      "text": "Mm, um, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 124.72,
      "end_seconds": 131.41,
      "duration_seconds": 6.69,
      "text": "Uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.34,
      "end_seconds": 136.22,
      "duration_seconds": 2.88,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.19,
      "end_seconds": 140.35,
      "duration_seconds": 2.16,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.18,
      "end_seconds": 148.27,
      "duration_seconds": 7.09,
      "text": "Hmm, um, only cold water on the face, and it's not much."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.83,
      "end_seconds": 155.32,
      "duration_seconds": 6.49,
      "text": "Alright, have you had any fainting, breathlessness or family history of sudden death?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.21,
      "end_seconds": 172.92,
      "duration_seconds": 16.71,
      "text": "No, no fainting, no breathlessness, no family history of sudden death. I was feeling lightheaded during an episode at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.27,
      "end_seconds": 177.08,
      "duration_seconds": 2.81,
      "text": "Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.72,
      "end_seconds": 183.05,
      "duration_seconds": 2.33,
      "text": "Nope, no chest pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.59,
      "end_seconds": 188.85,
      "duration_seconds": 4.26,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.64,
      "end_seconds": 191.37,
      "duration_seconds": 1.73,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.4,
      "end_seconds": 193.28,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.77,
      "end_seconds": 198.12,
      "duration_seconds": 3.35,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.86,
      "end_seconds": 203.63,
      "duration_seconds": 3.77,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.44,
      "end_seconds": 211.89,
      "duration_seconds": 3.45,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.95,
      "end_seconds": 216.18,
      "duration_seconds": 3.23,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.23,
      "end_seconds": 220.26,
      "duration_seconds": 2.03,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.16,
      "end_seconds": 225.04,
      "duration_seconds": 3.88,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.13,
      "end_seconds": 227.87,
      "duration_seconds": 1.74,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.15,
      "end_seconds": 242.81,
      "duration_seconds": 5.66,
      "text": "What do you take on a normal day? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.67,
      "end_seconds": 251.96,
      "duration_seconds": 7.29,
      "text": "Sumatriptan, 50 milligrams, when needed. Escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 253.86,
      "end_seconds": 265.29,
      "duration_seconds": 11.43,
      "text": "Uh, um, doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.38,
      "end_seconds": 270.85,
      "duration_seconds": 4.47,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.67,
      "end_seconds": 277.29,
      "duration_seconds": 5.62,
      "text": "Mm, um, no, I left it at home."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.31,
      "end_seconds": 280.68,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.65,
      "end_seconds": 296.21,
      "duration_seconds": 14.56,
      "text": "Ah, uh, I have migraines, for about a year. I didn't want to bother you but it keeps coming back. I've got anxiety."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.9,
      "end_seconds": 301.94,
      "duration_seconds": 3.04,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.93,
      "end_seconds": 305.83,
      "duration_seconds": 2.9,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.52,
      "end_seconds": 320.1,
      "duration_seconds": 3.58,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.76,
      "end_seconds": 325.76,
      "duration_seconds": 2.0,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.84,
      "end_seconds": 349.56,
      "duration_seconds": 8.72,
      "text": "Okay, so my impression is this: This looks most like episodes of supraventricular tachycardia. I'd also keep atrial fibrillation in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.26,
      "end_seconds": 354.99,
      "duration_seconds": 4.73,
      "text": "Well, you know, is there something to worry about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.93,
      "end_seconds": 377.77,
      "duration_seconds": 18.84,
      "text": "I can't promise yet, but most people with episodes of supraventricular tachycardia do well once it's treated properly. I'm sending you for an ECG because of palpitations. Let's book a thyroid test to look into palpitations. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.31,
      "end_seconds": 380.16,
      "duration_seconds": 1.85,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.92,
      "end_seconds": 391.87,
      "duration_seconds": 10.95,
      "text": "We should do a 7-day heart monitor for paroxysmal palpitations. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.44,
      "end_seconds": 394.25,
      "duration_seconds": 1.81,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.08,
      "end_seconds": 419.66,
      "duration_seconds": 24.58,
      "text": "Try blowing hard against a closed mouth and nose when it starts. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 420.5,
      "end_seconds": 421.57,
      "duration_seconds": 1.07,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 422.78,
      "end_seconds": 429.79,
      "duration_seconds": 7.01,
      "text": "Let's plan a check after the monitor. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.01,
      "end_seconds": 437.21,
      "duration_seconds": 6.2,
      "text": "So, I come back after the monitor. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 437.71,
      "end_seconds": 443.32,
      "duration_seconds": 5.61,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 444.52,
      "end_seconds": 447.7,
      "duration_seconds": 3.18,
      "text": "Erm, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.87,
      "end_seconds": 450.7,
      "duration_seconds": 1.83,
      "text": "Right, see you soon."
    }
  ]
}