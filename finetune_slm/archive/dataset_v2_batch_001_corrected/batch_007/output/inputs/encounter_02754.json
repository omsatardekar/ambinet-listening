{
  "schema_version": "1.0",
  "encounter_id": "02754",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.56,
      "duration_seconds": 3.24,
      "text": "morning, doctor lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.47,
      "end_seconds": 10.33,
      "duration_seconds": 4.86,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 19.1,
      "duration_seconds": 7.94,
      "text": "yeah, uh, it's a severe sore throat on one side i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.91,
      "end_seconds": 25.44,
      "duration_seconds": 4.53,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.58,
      "end_seconds": 37.84,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.68,
      "end_seconds": 66.71,
      "duration_seconds": 8.03,
      "text": "Okay: temperature 39.2, saturation 95 percent, heart rate 88. And blood pressure 126 over 78."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.6,
      "end_seconds": 69.15,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.99,
      "end_seconds": 76.73,
      "duration_seconds": 6.74,
      "text": "they help me see the whole picture, more shortly did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.62,
      "end_seconds": 81.03,
      "duration_seconds": 2.41,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 85.51,
      "duration_seconds": 3.58,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.21,
      "end_seconds": 90.63,
      "duration_seconds": 3.42,
      "text": "a four out of ten, I suppose"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.49,
      "end_seconds": 95.03,
      "duration_seconds": 2.54,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.54,
      "end_seconds": 112.15,
      "duration_seconds": 16.61,
      "text": "Mm, it usually comes with drooling. As for drooling, I honestly can't say when that began. It might have been last month or the month before. About drooling, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.86,
      "end_seconds": 117.06,
      "duration_seconds": 4.2,
      "text": "A few quick ones: rash, cough or noisy breathing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.9,
      "end_seconds": 123.68,
      "duration_seconds": 5.78,
      "text": "sorry, what was I saying, no, none of those at all"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.47,
      "end_seconds": 130.31,
      "duration_seconds": 4.84,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.36,
      "end_seconds": 136.77,
      "duration_seconds": 2.41,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.58,
      "end_seconds": 141.26,
      "duration_seconds": 2.68,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.23,
      "end_seconds": 144.76,
      "duration_seconds": 2.53,
      "text": "Yeah, no, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.27,
      "end_seconds": 149.67,
      "duration_seconds": 4.4,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.09,
      "end_seconds": 156.47,
      "duration_seconds": 5.38,
      "text": "not currently, but as a youngster trimethoprim gave me a rash"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.18,
      "end_seconds": 171.99,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.22,
      "end_seconds": 177.73,
      "duration_seconds": 4.51,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.75,
      "end_seconds": 182.07,
      "duration_seconds": 3.32,
      "text": "right, what line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.49,
      "end_seconds": 188.12,
      "duration_seconds": 4.63,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.78,
      "end_seconds": 191.39,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.92,
      "end_seconds": 194.23,
      "duration_seconds": 2.31,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.01,
      "end_seconds": 196.97,
      "duration_seconds": 1.96,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.73,
      "end_seconds": 201.0,
      "duration_seconds": 2.27,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.92,
      "end_seconds": 204.0,
      "duration_seconds": 2.08,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.45,
      "end_seconds": 220.59,
      "duration_seconds": 11.14,
      "text": "I'm, I'm on spironolactone, 25 milligrams, once a day. I'm on clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.99,
      "end_seconds": 236.47,
      "duration_seconds": 2.48,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.52,
      "end_seconds": 248.21,
      "duration_seconds": 10.69,
      "text": "I've, I've got heart failure. Heart disease, for about ten years. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.85,
      "end_seconds": 256.65,
      "duration_seconds": 7.8,
      "text": "Yes, heart disease is known to us, good to have that clear. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.54,
      "end_seconds": 258.62,
      "duration_seconds": 1.08,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.09,
      "end_seconds": 265.69,
      "duration_seconds": 5.6,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.83,
      "end_seconds": 271.06,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.02,
      "end_seconds": 273.75,
      "duration_seconds": 1.73,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.47,
      "end_seconds": 298.85,
      "duration_seconds": 8.38,
      "text": "The The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.17,
      "end_seconds": 314.49,
      "duration_seconds": 12.32,
      "text": "Good, you can sit up again. From what you've told me and what I found, it points towards a quinsy, a peritonsillar abscess. I'd also keep severe tonsillitis in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.04,
      "end_seconds": 335.36,
      "duration_seconds": 12.32,
      "text": "Let's get an urgent ENT drainage, for peritonsillar abscess. For this, benzylpenicillin, 1.2 grams, now, single dose. That should help with peritonsillar abscess."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.9,
      "end_seconds": 338.97,
      "duration_seconds": 3.07,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.79,
      "end_seconds": 358.65,
      "duration_seconds": 18.86,
      "text": "You need to be seen by ENT today to drain it. Let's hold off on blood tests for now, and if there's no change in two weeks we can revisit it. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.55,
      "end_seconds": 361.77,
      "duration_seconds": 2.22,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.18,
      "end_seconds": 365.98,
      "duration_seconds": 2.8,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.38,
      "end_seconds": 374.29,
      "duration_seconds": 3.91,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}