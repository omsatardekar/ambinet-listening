{
  "schema_version": "1.0",
  "encounter_id": "02996",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.12,
      "duration_seconds": 4.94,
      "text": "Doctor? Hello I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.01,
      "end_seconds": 10.54,
      "duration_seconds": 3.53,
      "text": "That's fine sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 17.84,
      "duration_seconds": 4.9,
      "text": "um, so... a postnasal drip that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.84,
      "end_seconds": 24.49,
      "duration_seconds": 4.65,
      "text": "alright, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 29.59,
      "duration_seconds": 4.16,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.17,
      "end_seconds": 34.41,
      "duration_seconds": 4.24,
      "text": "Has there been a blocked nose for months too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.27,
      "end_seconds": 59.42,
      "duration_seconds": 23.15,
      "text": "mm, yes about blocked nose for months, maybe a five out of ten on a bad day i've also been losing my sense of smell i did have a dull pressure over my face at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.37,
      "end_seconds": 63.81,
      "duration_seconds": 2.44,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.51,
      "end_seconds": 73.26,
      "duration_seconds": 7.75,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.51,
      "end_seconds": 79.05,
      "duration_seconds": 4.54,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.16,
      "end_seconds": 99.73,
      "duration_seconds": 19.57,
      "text": "I was told I'm allergic to erythromycin, but I don't remember what reaction I had. Yes, tramadol. I've no idea what the reaction was, only that I'm not supposed to have it"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.37,
      "end_seconds": 103.67,
      "duration_seconds": 2.3,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.31,
      "end_seconds": 120.93,
      "duration_seconds": 15.62,
      "text": "I'm on alendronate, 70 milligrams, once a week for my bones. Though honestly, uh, some days I forget to take it. It's saline spray, three times a day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.16,
      "end_seconds": 134.11,
      "duration_seconds": 3.95,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.19,
      "end_seconds": 151.85,
      "duration_seconds": 16.66,
      "text": "yeah, I have asthma, for two years. Work has been very busy so I kept ignoring it. I wasn't sure whether to to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.11,
      "end_seconds": 154.13,
      "duration_seconds": 1.02,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.58,
      "end_seconds": 158.2,
      "duration_seconds": 2.62,
      "text": "I've, I've got thin bones"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.6,
      "end_seconds": 160.97,
      "duration_seconds": 1.37,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.48,
      "end_seconds": 163.39,
      "duration_seconds": 1.91,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.29,
      "end_seconds": 166.38,
      "duration_seconds": 2.09,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.92,
      "end_seconds": 171.34,
      "duration_seconds": 3.42,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.21,
      "end_seconds": 174.28,
      "duration_seconds": 2.07,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.55,
      "end_seconds": 180.47,
      "duration_seconds": 4.92,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.11,
      "end_seconds": 187.26,
      "duration_seconds": 3.15,
      "text": "What do you do during the the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.58,
      "end_seconds": 192.12,
      "duration_seconds": 3.54,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.65,
      "end_seconds": 203.89,
      "duration_seconds": 3.24,
      "text": "have you noticed fever, vision changes or nosebleeds?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.99,
      "end_seconds": 208.48,
      "duration_seconds": 3.49,
      "text": "nope, uh, nothing like that"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.47,
      "end_seconds": 215.36,
      "duration_seconds": 4.89,
      "text": "what about your tummy and and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.21,
      "end_seconds": 221.63,
      "duration_seconds": 4.42,
      "text": "Well, you know, no, that side's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.56,
      "end_seconds": 226.27,
      "duration_seconds": 3.71,
      "text": "So, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.27,
      "end_seconds": 230.23,
      "duration_seconds": 2.96,
      "text": "Mm, I move fine otherwise."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.56,
      "end_seconds": 243.03,
      "duration_seconds": 2.47,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.27,
      "end_seconds": 253.35,
      "duration_seconds": 3.08,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.7,
      "end_seconds": 281.68,
      "duration_seconds": 13.98,
      "text": "Okay: BMI works out to 31.6, oxygen saturation is 98 percent, weight 88 kilos. And pulse is 73 beats a minute, respiratory rate 18, pressure 116 over 78, height 167 centimetres."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.11,
      "end_seconds": 287.06,
      "duration_seconds": 3.95,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.96,
      "end_seconds": 290.35,
      "duration_seconds": 1.39,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.32,
      "end_seconds": 305.75,
      "duration_seconds": 3.43,
      "text": "there are pale, grape-like swellings inside both nostrils"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.36,
      "end_seconds": 331.34,
      "duration_seconds": 19.98,
      "text": "good you can sit up again so based on the history and the examination it fits best with nasal polyps i want to be honest that this is an impression not a final answer i'd also keep chronic sinusitis in mind"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.66,
      "end_seconds": 334.21,
      "duration_seconds": 1.55,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.69,
      "end_seconds": 350.25,
      "duration_seconds": 14.56,
      "text": "nothing I've seen today points to an emergency. It looks like nasal polyps, but I'd like to confirm. So, to recap quickly. You've had a postnasal drip, and no nosebleeds or vision changes"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.43,
      "end_seconds": 353.65,
      "duration_seconds": 2.22,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.42,
      "end_seconds": 358.25,
      "duration_seconds": 3.83,
      "text": "we should do a nasal endoscopy for nasal obstruction"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 359.55,
      "end_seconds": 363.57,
      "duration_seconds": 4.02,
      "text": "I can book that for Thursday at 2 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.9,
      "end_seconds": 367.37,
      "duration_seconds": 2.47,
      "text": "Thursday that works for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.33,
      "end_seconds": 390.9,
      "duration_seconds": 21.57,
      "text": "We'll begin with mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for nasal polyps. Rinse with saline and use the spray daily. We'll refer you to the ENT clinic. Let's review you in eight weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.52,
      "end_seconds": 394.81,
      "duration_seconds": 3.29,
      "text": "ah, thank you, that's helpful"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.36,
      "end_seconds": 398.29,
      "duration_seconds": 1.93,
      "text": "Right, see you soon."
    }
  ]
}