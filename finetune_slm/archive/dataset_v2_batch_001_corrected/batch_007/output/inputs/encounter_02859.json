{
  "schema_version": "1.0",
  "encounter_id": "02859",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.8,
      "duration_seconds": 3.75,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.66,
      "end_seconds": 9.32,
      "duration_seconds": 3.66,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.85,
      "end_seconds": 16.0,
      "duration_seconds": 6.15,
      "text": "Doctor, it's a widespread rash with fever. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.48,
      "end_seconds": 20.54,
      "duration_seconds": 3.06,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.2,
      "end_seconds": 34.06,
      "duration_seconds": 12.86,
      "text": "Erm, probably about two weeks. Yeah. It's a relief to finally sit down and talk about it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 37.86,
      "duration_seconds": 2.85,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.3,
      "end_seconds": 43.5,
      "duration_seconds": 4.2,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.53,
      "end_seconds": 47.26,
      "duration_seconds": 2.73,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.25,
      "end_seconds": 61.53,
      "duration_seconds": 13.28,
      "text": "It usually comes with swollen glands. The swollen glands? That's been for about a week. Right, as for swollen glands, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.03,
      "end_seconds": 67.24,
      "duration_seconds": 4.21,
      "text": "And what about blisters, mouth sores or breathing difficulty?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.1,
      "end_seconds": 72.87,
      "duration_seconds": 4.77,
      "text": "No blisters, mouth sores or breathing difficulty, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.42,
      "end_seconds": 75.99,
      "duration_seconds": 2.57,
      "text": "Sure. Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.53,
      "end_seconds": 79.57,
      "duration_seconds": 2.04,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.14,
      "end_seconds": 84.47,
      "duration_seconds": 3.33,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.78,
      "end_seconds": 89.61,
      "duration_seconds": 3.83,
      "text": "It's allopurinol, 300 milligrams, started four weeks ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.98,
      "end_seconds": 105.17,
      "duration_seconds": 4.19,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.72,
      "end_seconds": 119.86,
      "duration_seconds": 14.14,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.92,
      "end_seconds": 125.53,
      "duration_seconds": 3.61,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.01,
      "end_seconds": 129.39,
      "duration_seconds": 2.38,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.96,
      "end_seconds": 148.98,
      "duration_seconds": 3.02,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.76,
      "end_seconds": 163.77,
      "duration_seconds": 3.01,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.6,
      "end_seconds": 193.3,
      "duration_seconds": 9.7,
      "text": "Okay: SpO2 98 percent on room air, heart rate 103, temperature is 38.7 degrees, pressure 111 over 74."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.65,
      "end_seconds": 196.22,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.55,
      "end_seconds": 200.39,
      "duration_seconds": 2.84,
      "text": "Alright, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.33,
      "end_seconds": 206.77,
      "duration_seconds": 3.44,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.2,
      "end_seconds": 225.28,
      "duration_seconds": 1.08,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.54,
      "end_seconds": 228.62,
      "duration_seconds": 2.08,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.63,
      "end_seconds": 252.85,
      "duration_seconds": 7.22,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.82,
      "end_seconds": 255.31,
      "duration_seconds": 1.49,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.4,
      "end_seconds": 268.36,
      "duration_seconds": 7.96,
      "text": "Good, you can sit up again. Having listened and examined, this looks most like a severe drug reaction."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.87,
      "end_seconds": 273.22,
      "duration_seconds": 3.35,
      "text": "Uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.87,
      "end_seconds": 283.32,
      "duration_seconds": 8.45,
      "text": "Nothing I've seen today points to an emergency. It looks like a severe drug reaction, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.14,
      "end_seconds": 313.94,
      "duration_seconds": 12.8,
      "text": "Let's get urgent blood tests, for severe drug reaction. I'm prescribing prednisolone, 40 milligrams, once a day, until review. You take it by mouth. It's for severe drug reaction."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 317.04,
      "duration_seconds": 1.35,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.96,
      "end_seconds": 337.72,
      "duration_seconds": 19.76,
      "text": "Stop the allopurinol now and you need admission. The dermatology team would be the right next step, I'll refer you. Come back or go to emergency straight away if the symptoms get worse. Please come and see me straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.12,
      "end_seconds": 342.64,
      "duration_seconds": 3.52,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}