{
  "schema_version": "1.0",
  "encounter_id": "02723",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.0,
      "duration_seconds": 3.42,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.79,
      "end_seconds": 10.89,
      "duration_seconds": 5.1,
      "text": "Right, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 17.34,
      "duration_seconds": 4.59,
      "text": "Well, I've been having a blister on my heel."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.09,
      "end_seconds": 22.03,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.38,
      "end_seconds": 36.18,
      "duration_seconds": 12.8,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 40.73,
      "duration_seconds": 4.17,
      "text": "Hm, okay. Has there been a little soreness too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.04,
      "end_seconds": 45.28,
      "duration_seconds": 3.24,
      "text": "Yes, about the same, four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.98,
      "end_seconds": 54.0,
      "duration_seconds": 7.02,
      "text": "So, have you had a blister on your heel before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.12,
      "end_seconds": 66.55,
      "duration_seconds": 7.43,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.61,
      "end_seconds": 71.47,
      "duration_seconds": 2.86,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.75,
      "end_seconds": 75.09,
      "duration_seconds": 2.34,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.03,
      "end_seconds": 80.1,
      "duration_seconds": 4.07,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.5,
      "end_seconds": 90.95,
      "duration_seconds": 1.45,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.58,
      "end_seconds": 93.12,
      "duration_seconds": 1.54,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.0,
      "end_seconds": 96.38,
      "duration_seconds": 1.38,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.75,
      "end_seconds": 101.6,
      "duration_seconds": 3.85,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.21,
      "end_seconds": 106.77,
      "duration_seconds": 3.56,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.11,
      "end_seconds": 111.56,
      "duration_seconds": 3.45,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 114.67,
      "duration_seconds": 1.2,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.65,
      "end_seconds": 119.98,
      "duration_seconds": 4.33,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.68,
      "end_seconds": 123.58,
      "duration_seconds": 2.9,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 128.08,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 135.94,
      "duration_seconds": 7.02,
      "text": "What do you take on a normal day? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.87,
      "end_seconds": 140.65,
      "duration_seconds": 2.78,
      "text": "Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.68,
      "end_seconds": 147.11,
      "duration_seconds": 4.43,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.6,
      "end_seconds": 152.54,
      "duration_seconds": 3.94,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.54,
      "end_seconds": 156.89,
      "duration_seconds": 3.35,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.23,
      "end_seconds": 162.97,
      "duration_seconds": 2.74,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.0,
      "end_seconds": 166.87,
      "duration_seconds": 2.87,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.57,
      "end_seconds": 173.16,
      "duration_seconds": 4.59,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.15,
      "end_seconds": 176.89,
      "duration_seconds": 2.74,
      "text": "Any diabetes or pus at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.12,
      "end_seconds": 180.64,
      "duration_seconds": 2.52,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.36,
      "end_seconds": 184.42,
      "duration_seconds": 3.06,
      "text": "Any fever or redness spreading at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 188.91,
      "duration_seconds": 3.09,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.04,
      "end_seconds": 192.07,
      "duration_seconds": 2.03,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.89,
      "end_seconds": 196.12,
      "duration_seconds": 2.23,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.87,
      "end_seconds": 200.44,
      "duration_seconds": 2.57,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.31,
      "end_seconds": 216.85,
      "duration_seconds": 2.54,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.13,
      "end_seconds": 248.29,
      "duration_seconds": 10.16,
      "text": "Okay: pulse is 85 beats a minute, blood pressure 121 over 80, temperature is 36.7 degrees. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.26,
      "end_seconds": 273.43,
      "duration_seconds": 12.17,
      "text": "Okay, so my impression from what you've said is this: I'd lean towards a simple friction blister. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.3,
      "end_seconds": 276.66,
      "duration_seconds": 1.36,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.3,
      "end_seconds": 283.95,
      "duration_seconds": 6.65,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple friction blister."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.99,
      "end_seconds": 316.56,
      "duration_seconds": 16.57,
      "text": "Leave it intact, cover it with a padded plaster and change the shoes. I'd like to see you again if it looks infected. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.56,
      "end_seconds": 320.14,
      "duration_seconds": 1.58,
      "text": "That's clear, thanks."
    }
  ]
}