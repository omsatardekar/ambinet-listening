      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.17,
      "end_seconds": 302.95,
      "duration_seconds": 6.78,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks."
