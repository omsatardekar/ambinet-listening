{
  "schema_version": "1.0",
  "encounter_id": "02936",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 4.75,
      "duration_seconds": 3.57,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.63,
      "end_seconds": 9.59,
      "duration_seconds": 2.96,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.75,
      "end_seconds": 12.88,
      "duration_seconds": 2.13,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.34,
      "end_seconds": 17.64,
      "duration_seconds": 3.3,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.47,
      "end_seconds": 20.27,
      "duration_seconds": 1.8,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.89,
      "end_seconds": 23.79,
      "duration_seconds": 1.9,
      "text": "I've been losing things."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.9,
      "end_seconds": 26.88,
      "duration_seconds": 1.98,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.86,
      "end_seconds": 41.8,
      "duration_seconds": 12.94,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date. I've also had difficulty concentrating, for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.6,
      "end_seconds": 45.29,
      "duration_seconds": 1.69,
      "text": "How about head injury?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.68,
      "end_seconds": 50.16,
      "duration_seconds": 3.48,
      "text": "Ah, not at all, no head injury."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.13,
      "end_seconds": 56.74,
      "duration_seconds": 4.61,
      "text": "Did you get low mood, drug use or thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.36,
      "end_seconds": 61.74,
      "duration_seconds": 3.38,
      "text": "Mm, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.01,
      "end_seconds": 68.05,
      "duration_seconds": 2.04,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.0,
      "end_seconds": 72.04,
      "duration_seconds": 2.04,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.55,
      "end_seconds": 81.14,
      "duration_seconds": 1.59,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.25,
      "end_seconds": 88.03,
      "duration_seconds": 3.78,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.3,
      "end_seconds": 92.11,
      "duration_seconds": 2.81,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.21,
      "end_seconds": 96.45,
      "duration_seconds": 3.24,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.54,
      "end_seconds": 100.91,
      "duration_seconds": 3.37,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.82,
      "end_seconds": 105.28,
      "duration_seconds": 3.46,
      "text": "I have low haemoglobin, for five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.35,
      "end_seconds": 107.05,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.19,
      "end_seconds": 127.21,
      "duration_seconds": 4.02,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.87,
      "end_seconds": 131.28,
      "duration_seconds": 2.41,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.46,
      "end_seconds": 136.15,
      "duration_seconds": 3.69,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.78,
      "end_seconds": 139.24,
      "duration_seconds": 2.46,
      "text": "Iron tablets, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.97,
      "end_seconds": 143.96,
      "duration_seconds": 3.99,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.03,
      "end_seconds": 149.7,
      "duration_seconds": 3.67,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.96,
      "end_seconds": 155.78,
      "duration_seconds": 4.82,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.52,
      "end_seconds": 165.22,
      "duration_seconds": 2.7,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.15,
      "end_seconds": 185.69,
      "duration_seconds": 8.54,
      "text": "Okay: blood pressure 112 over 69, temperature is 36.4 degrees, SpO2 98 percent on room air, pulse 79."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.19,
      "end_seconds": 187.85,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.23,
      "end_seconds": 192.28,
      "duration_seconds": 3.05,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.07,
      "end_seconds": 199.05,
      "duration_seconds": 3.98,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 200.47,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.47,
      "end_seconds": 203.6,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 223.58,
      "duration_seconds": 5.1,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.77,
      "end_seconds": 231.76,
      "duration_seconds": 2.99,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.53,
      "end_seconds": 262.56,
      "duration_seconds": 13.03,
      "text": "I'm going to order a questionnaire, for attention problems. Let's get a thyroid test, for poor concentration. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.44,
      "end_seconds": 266.19,
      "duration_seconds": 2.75,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.67,
      "end_seconds": 287.1,
      "duration_seconds": 19.43,
      "text": "Use lists and reminders while we arrange the specialist assessment. Let's get you seen by the adult ADHD service, I'll arrange the letter. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look after the assessment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.15,
      "end_seconds": 291.99,
      "duration_seconds": 2.84,
      "text": "Alright, um, I'll be back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.85,
      "end_seconds": 296.7,
      "duration_seconds": 2.85,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.26,
      "end_seconds": 301.2,
      "duration_seconds": 3.94,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.79,
      "end_seconds": 307.26,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}