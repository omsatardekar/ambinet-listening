{
  "schema_version": "1.0",
  "encounter_id": "02584",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 4.37,
      "duration_seconds": 3.16,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 11.16,
      "duration_seconds": 4.96,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.17,
      "end_seconds": 22.35,
      "duration_seconds": 7.18,
      "text": "It's difficulty opening my mouth. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.31,
      "end_seconds": 26.83,
      "duration_seconds": 3.52,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.62,
      "end_seconds": 30.95,
      "duration_seconds": 2.33,
      "text": "I've had it since Friday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.3,
      "end_seconds": 36.04,
      "duration_seconds": 4.74,
      "text": "Hm, okay. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.61,
      "end_seconds": 37.84,
      "duration_seconds": 1.23,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.84,
      "end_seconds": 42.78,
      "duration_seconds": 2.94,
      "text": "Right, and rash, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.72,
      "end_seconds": 45.39,
      "duration_seconds": 1.67,
      "text": "Definitely no rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.49,
      "end_seconds": 49.7,
      "duration_seconds": 3.21,
      "text": "And what about cough or noisy breathing?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.9,
      "end_seconds": 55.9,
      "duration_seconds": 3.0,
      "text": "None of those, you know, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.36,
      "end_seconds": 60.7,
      "duration_seconds": 3.34,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.41,
      "end_seconds": 64.17,
      "duration_seconds": 2.76,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.28,
      "end_seconds": 70.39,
      "duration_seconds": 5.11,
      "text": "Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.32,
      "end_seconds": 72.42,
      "duration_seconds": 1.1,
      "text": "Yes, walnuts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.08,
      "end_seconds": 88.09,
      "duration_seconds": 4.01,
      "text": "Alright, what line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.11,
      "end_seconds": 95.72,
      "duration_seconds": 5.61,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.32,
      "end_seconds": 98.97,
      "duration_seconds": 1.65,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.54,
      "end_seconds": 103.3,
      "duration_seconds": 3.76,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.56,
      "end_seconds": 109.51,
      "duration_seconds": 1.95,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.24,
      "end_seconds": 115.16,
      "duration_seconds": 3.92,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.1,
      "end_seconds": 119.82,
      "duration_seconds": 3.72,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.21,
      "end_seconds": 133.48,
      "duration_seconds": 12.27,
      "text": "I take metoprolol, 50 milligrams, twice a day. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.73,
      "end_seconds": 134.43,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.52,
      "end_seconds": 152.93,
      "duration_seconds": 2.41,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.91,
      "end_seconds": 159.17,
      "duration_seconds": 2.26,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.66,
      "end_seconds": 163.25,
      "duration_seconds": 2.59,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.83,
      "end_seconds": 175.5,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.68,
      "end_seconds": 199.09,
      "duration_seconds": 13.41,
      "text": "Okay: weight 87 kilos, BMI works out to 38.7, BP is 116 over 68, temperature 38.2, saturation 97 percent, heart rate 107, height 150 centimetres."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.17,
      "end_seconds": 205.84,
      "duration_seconds": 4.67,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.07,
      "end_seconds": 208.32,
      "duration_seconds": 1.25,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.86,
      "end_seconds": 227.58,
      "duration_seconds": 7.72,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.2,
      "end_seconds": 244.22,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.21,
      "end_seconds": 249.56,
      "duration_seconds": 2.35,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.92,
      "end_seconds": 267.59,
      "duration_seconds": 9.67,
      "text": "From what you've told me and what I found, I think we're dealing with a quinsy, a peritonsillar abscess at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.68,
      "end_seconds": 272.94,
      "duration_seconds": 3.26,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.97,
      "end_seconds": 286.37,
      "duration_seconds": 11.4,
      "text": "It's reasonable to be concerned, but right now a quinsy, a peritonsillar abscess is my leading thought, not anything worse. I want blood tests done, that's for abscess."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.26,
      "end_seconds": 293.39,
      "duration_seconds": 2.13,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.15,
      "end_seconds": 316.15,
      "duration_seconds": 21.0,
      "text": "I'm prescribing benzylpenicillin, 1.2 grams, now, single dose. That's for peritonsillar abscess. You need to be seen by ENT today to drain it. We'll refer you to the ENT team. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.37,
      "end_seconds": 320.17,
      "duration_seconds": 2.8,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.34,
      "end_seconds": 326.17,
      "duration_seconds": 4.83,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.11,
      "end_seconds": 330.45,
      "duration_seconds": 3.34,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.14,
      "end_seconds": 335.42,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}