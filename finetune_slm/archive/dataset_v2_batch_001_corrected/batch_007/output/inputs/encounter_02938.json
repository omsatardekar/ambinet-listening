{
  "schema_version": "1.0",
  "encounter_id": "02938",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 6.39,
      "duration_seconds": 5.56,
      "text": "Let me think, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.16,
      "end_seconds": 12.32,
      "duration_seconds": 4.16,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.71,
      "end_seconds": 19.73,
      "duration_seconds": 6.02,
      "text": "Oh, mainly I've been losing my sense of smell. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.23,
      "end_seconds": 30.58,
      "duration_seconds": 6.35,
      "text": "Did it come on recently? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.76,
      "end_seconds": 37.52,
      "duration_seconds": 2.76,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.75,
      "end_seconds": 41.48,
      "duration_seconds": 3.73,
      "text": "Mm-hmm. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.78,
      "end_seconds": 46.15,
      "duration_seconds": 3.37,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.15,
      "end_seconds": 50.33,
      "duration_seconds": 3.18,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.4,
      "end_seconds": 66.09,
      "duration_seconds": 14.69,
      "text": "A dull pressure over my face goes along with it, most of the time. About dull pressure over my face, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.15,
      "end_seconds": 71.19,
      "duration_seconds": 3.04,
      "text": "Have you had nosebleeds, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.19,
      "end_seconds": 73.69,
      "duration_seconds": 1.5,
      "text": "Nope, no nosebleeds."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.75,
      "end_seconds": 78.86,
      "duration_seconds": 3.11,
      "text": "A few quick ones: fever or vision changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.95,
      "end_seconds": 82.43,
      "duration_seconds": 2.48,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 86.91,
      "duration_seconds": 3.26,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.23,
      "end_seconds": 90.0,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.67,
      "end_seconds": 92.65,
      "duration_seconds": 1.98,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.65,
      "end_seconds": 96.64,
      "duration_seconds": 2.99,
      "text": "Right, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.63,
      "end_seconds": 110.1,
      "duration_seconds": 3.47,
      "text": "Okay, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.73,
      "end_seconds": 123.54,
      "duration_seconds": 11.81,
      "text": "Not much, I mostly stay in these days. Lots of rice, lentils and some fruit. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.15,
      "end_seconds": 143.88,
      "duration_seconds": 2.73,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.86,
      "end_seconds": 148.98,
      "duration_seconds": 4.12,
      "text": "Ah, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 152.87,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.34,
      "end_seconds": 168.55,
      "duration_seconds": 14.21,
      "text": "I take Seretide inhaler, twice a day. I'm supposed to take it regularly, but I don't always manage. I'm on paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.47,
      "end_seconds": 172.71,
      "duration_seconds": 3.24,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.51,
      "end_seconds": 201.08,
      "duration_seconds": 26.57,
      "text": "I've had asthma for two years now. I did try to ignore it for a while. I've been putting this off for weeks. I've got arthritis in my knees. My family kept telling me to get it checked. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.43,
      "end_seconds": 211.32,
      "duration_seconds": 8.89,
      "text": "Sure. Alright, arthritis in your knees, that matches what I have here. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.08,
      "end_seconds": 226.76,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.41,
      "end_seconds": 255.47,
      "duration_seconds": 17.06,
      "text": "Okay: heart rate 85, respiratory rate 14. And weight 58 kilos, SpO2 97 percent on room air, blood pressure 122 over 79, temperature is 36.7 degrees, BMI works out to 21.8, height 163 centimetres."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.34,
      "end_seconds": 262.05,
      "duration_seconds": 4.71,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.42,
      "end_seconds": 264.52,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.58,
      "end_seconds": 267.29,
      "duration_seconds": 1.71,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.87,
      "end_seconds": 284.32,
      "duration_seconds": 3.45,
      "text": "There are pale, grape-like swellings inside both nostrils."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.1,
      "end_seconds": 290.16,
      "duration_seconds": 3.06,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.66,
      "end_seconds": 307.09,
      "duration_seconds": 4.43,
      "text": "Taking everything into account, this is probably nasal polyps."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.78,
      "end_seconds": 310.64,
      "duration_seconds": 2.86,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.48,
      "end_seconds": 334.57,
      "duration_seconds": 22.09,
      "text": "I understand the worry. At the moment I'd say it's nasal polyps, and we'll watch how it goes. For this, mometasone nasal spray, 50 micrograms, two sprays each side once a day, eight weeks. It's for nasal polyps. Please come and see me in eight weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.56,
      "end_seconds": 337.14,
      "duration_seconds": 1.58,
      "text": "That's clear, thanks."
    }
  ]
}