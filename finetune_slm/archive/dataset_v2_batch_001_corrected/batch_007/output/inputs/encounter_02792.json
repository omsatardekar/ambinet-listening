{
  "schema_version": "1.0",
  "encounter_id": "02792",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 7.59,
      "duration_seconds": 6.29,
      "text": "Actually, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.29,
      "end_seconds": 13.64,
      "duration_seconds": 5.35,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.65,
      "end_seconds": 26.51,
      "duration_seconds": 10.86,
      "text": "Yeah, it's a new headache at the temple. I don't know what's causing it. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.48,
      "end_seconds": 31.63,
      "duration_seconds": 3.15,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.1,
      "end_seconds": 41.87,
      "duration_seconds": 2.77,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.72,
      "end_seconds": 75.77,
      "duration_seconds": 12.05,
      "text": "Okay: oxygen saturation is 99 percent, temp 36.9 degrees, pulse is 72 beats a minute, blood pressure 124 over 75. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.97,
      "end_seconds": 85.98,
      "duration_seconds": 9.01,
      "text": "Uh, it's been going on for ten days. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.35,
      "end_seconds": 90.41,
      "duration_seconds": 4.06,
      "text": "Mm, okay. How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.78,
      "end_seconds": 96.57,
      "duration_seconds": 1.79,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.69,
      "end_seconds": 101.0,
      "duration_seconds": 3.31,
      "text": "Any fever, shoulder stiffness or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.58,
      "end_seconds": 106.8,
      "duration_seconds": 4.22,
      "text": "No, no fever, shoulder stiffness or weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.23,
      "end_seconds": 110.67,
      "duration_seconds": 2.44,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.41,
      "end_seconds": 113.43,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.17,
      "end_seconds": 116.13,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.1,
      "end_seconds": 119.99,
      "duration_seconds": 2.89,
      "text": "I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.72,
      "end_seconds": 142.07,
      "duration_seconds": 4.35,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.85,
      "end_seconds": 145.13,
      "duration_seconds": 2.28,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.21,
      "end_seconds": 150.29,
      "duration_seconds": 4.08,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.99,
      "end_seconds": 154.82,
      "duration_seconds": 2.83,
      "text": "Yes, I'm allergic to cat fur."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.95,
      "end_seconds": 158.36,
      "duration_seconds": 2.41,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.73,
      "end_seconds": 163.37,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.95,
      "end_seconds": 168.11,
      "duration_seconds": 3.16,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.98,
      "end_seconds": 173.94,
      "duration_seconds": 3.96,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.63,
      "end_seconds": 193.23,
      "duration_seconds": 3.6,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.94,
      "end_seconds": 202.13,
      "duration_seconds": 8.19,
      "text": "I have eczema, for two years. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.0,
      "end_seconds": 207.77,
      "duration_seconds": 3.77,
      "text": "Alright, eczema, that matches what I have here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.51,
      "end_seconds": 214.31,
      "duration_seconds": 3.8,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.35,
      "end_seconds": 226.05,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.45,
      "end_seconds": 229.59,
      "duration_seconds": 2.14,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.59,
      "end_seconds": 246.96,
      "duration_seconds": 4.37,
      "text": "The temporal artery is hard, tender and has no pulse."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.67,
      "end_seconds": 254.37,
      "duration_seconds": 2.7,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.72,
      "end_seconds": 301.13,
      "duration_seconds": 28.41,
      "text": "Let's get a temporal artery biopsy, for possible giant cell arteritis. I'm sending you for urgent blood tests because of possible giant cell arteritis. I'd rather check than guess, and this is the quickest way to know more. I'd like you to take prednisolone, 60 milligrams, once a day, until review. That's for possible giant cell arteritis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.02,
      "end_seconds": 304.67,
      "duration_seconds": 1.65,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.33,
      "end_seconds": 329.61,
      "duration_seconds": 21.28,
      "text": "Start the steroid today, this is to protect your sight. The rheumatology team would be the right next step, I'll refer you. Please don't wait if you lose vision. That's when to be seen urgently. We'll catch up tomorrow. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.73,
      "end_seconds": 334.75,
      "duration_seconds": 4.02,
      "text": "Right, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.65,
      "end_seconds": 338.46,
      "duration_seconds": 1.81,
      "text": "Have a good day."
    }
  ]
}