{
  "schema_version": "1.0",
  "encounter_id": "02784",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 8.11,
      "duration_seconds": 6.96,
      "text": "Okay, hello, good to see you. Please sit. So what can I do for you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.48,
      "end_seconds": 13.89,
      "duration_seconds": 4.41,
      "text": "Well, I've been having a blister on my heel."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.45,
      "end_seconds": 22.34,
      "duration_seconds": 2.89,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.95,
      "end_seconds": 26.52,
      "duration_seconds": 3.57,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.56,
      "end_seconds": 37.38,
      "duration_seconds": 9.82,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.48,
      "end_seconds": 49.37,
      "duration_seconds": 10.89,
      "text": "Sorry, what was I saying, I notice it more with new shoes. I get some relief from a plaster."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.65,
      "end_seconds": 54.81,
      "duration_seconds": 4.16,
      "text": "What about a little soreness, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.07,
      "end_seconds": 58.27,
      "duration_seconds": 2.2,
      "text": "Yes, since last weekend."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.92,
      "end_seconds": 67.16,
      "duration_seconds": 7.24,
      "text": "So, have you had a blister on your heel before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.78,
      "end_seconds": 76.16,
      "duration_seconds": 7.38,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.05,
      "end_seconds": 80.38,
      "duration_seconds": 2.33,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.19,
      "end_seconds": 90.27,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.84,
      "end_seconds": 108.72,
      "duration_seconds": 6.88,
      "text": "Okay: blood pressure 118 over 81, oxygen saturation is 97 percent, pulse 84. And temperature 36.7."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 111.66,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.47,
      "end_seconds": 120.37,
      "duration_seconds": 7.9,
      "text": "Okay, I'll interpret them after the examination. Let me check a few things. Any diabetes, redness spreading or pus?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.99,
      "end_seconds": 123.87,
      "duration_seconds": 2.88,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.49,
      "end_seconds": 125.76,
      "duration_seconds": 1.27,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.6,
      "end_seconds": 128.05,
      "duration_seconds": 1.45,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.89,
      "end_seconds": 132.51,
      "duration_seconds": 3.62,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.59,
      "end_seconds": 136.61,
      "duration_seconds": 2.02,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.44,
      "end_seconds": 143.13,
      "duration_seconds": 4.69,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.68,
      "end_seconds": 146.74,
      "duration_seconds": 2.06,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.74,
      "end_seconds": 154.67,
      "duration_seconds": 2.93,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 163.16,
      "duration_seconds": 6.68,
      "text": "I have anxiety, for about a year. I have eczema, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.81,
      "end_seconds": 170.88,
      "duration_seconds": 6.07,
      "text": "Mm, okay. Yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.57,
      "end_seconds": 185.91,
      "duration_seconds": 2.34,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.46,
      "end_seconds": 193.88,
      "duration_seconds": 7.42,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.05,
      "end_seconds": 200.63,
      "duration_seconds": 2.58,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.73,
      "end_seconds": 215.45,
      "duration_seconds": 11.72,
      "text": "It's escitalopram, 10 milligrams, once a day. I take hydrocortisone cream, when needed. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.81,
      "end_seconds": 221.05,
      "duration_seconds": 4.24,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.75,
      "end_seconds": 241.01,
      "duration_seconds": 18.26,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. Lots of rice, lentils and some fruit. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.0,
      "end_seconds": 268.43,
      "duration_seconds": 8.43,
      "text": "Okay, so my impression from what you've said is this: The most likely explanation is a simple friction blister."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.08,
      "end_seconds": 271.23,
      "duration_seconds": 2.15,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.24,
      "end_seconds": 279.1,
      "duration_seconds": 6.86,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple friction blister."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.23,
      "end_seconds": 306.1,
      "duration_seconds": 14.87,
      "text": "Leave it intact, cover it with a padded plaster and change the shoes. Let's plan a check if it looks infected. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.81,
      "end_seconds": 314.48,
      "duration_seconds": 6.67,
      "text": "So, uh, I come back if it looks infected. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.65,
      "end_seconds": 323.08,
      "duration_seconds": 7.43,
      "text": "So, yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.81,
      "end_seconds": 328.67,
      "duration_seconds": 3.86,
      "text": "Yeah, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.43,
      "end_seconds": 331.71,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}