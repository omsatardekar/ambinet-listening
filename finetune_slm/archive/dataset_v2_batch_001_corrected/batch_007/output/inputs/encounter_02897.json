{
  "schema_version": "1.0",
  "encounter_id": "02897",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 2.38,
      "duration_seconds": 1.66,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.84,
      "end_seconds": 8.41,
      "duration_seconds": 4.57,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.88,
      "end_seconds": 16.74,
      "duration_seconds": 4.86,
      "text": "Um, so... swollen face. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.98,
      "end_seconds": 20.34,
      "duration_seconds": 2.36,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.71,
      "end_seconds": 36.3,
      "duration_seconds": 2.59,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.45,
      "end_seconds": 67.19,
      "duration_seconds": 13.74,
      "text": "Okay: heart rate 93, saturation 98 percent, BP is 119 over 67. And respiratory rate 19. When was the first time you noticed it? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.22,
      "end_seconds": 72.19,
      "duration_seconds": 2.97,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.71,
      "end_seconds": 75.98,
      "duration_seconds": 3.27,
      "text": "Right, right. How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.66,
      "end_seconds": 79.62,
      "duration_seconds": 2.96,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.89,
      "end_seconds": 83.62,
      "duration_seconds": 3.73,
      "text": "Okay, go on. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.33,
      "end_seconds": 94.29,
      "duration_seconds": 8.96,
      "text": "Swollen glands goes along with it, most of the time. The swollen glands? That's been for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 99.0,
      "duration_seconds": 3.82,
      "text": "Right, any blisters or breathing difficulty at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.77,
      "end_seconds": 105.02,
      "duration_seconds": 4.25,
      "text": "No blisters or breathing difficulty, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.48,
      "end_seconds": 108.33,
      "duration_seconds": 2.85,
      "text": "Right, right. Any sign of mouth sores?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.04,
      "end_seconds": 113.2,
      "duration_seconds": 3.16,
      "text": "I haven't noticed any mouth sores."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.24,
      "end_seconds": 117.52,
      "duration_seconds": 2.28,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 120.57,
      "duration_seconds": 2.5,
      "text": "Erm, I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.15,
      "end_seconds": 140.17,
      "duration_seconds": 3.02,
      "text": "Right, any regular medication at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.1,
      "end_seconds": 142.66,
      "duration_seconds": 1.56,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.86,
      "end_seconds": 154.7,
      "duration_seconds": 4.84,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.4,
      "end_seconds": 157.98,
      "duration_seconds": 1.58,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.98,
      "end_seconds": 176.84,
      "duration_seconds": 1.86,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.16,
      "end_seconds": 179.69,
      "duration_seconds": 1.53,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.29,
      "end_seconds": 182.9,
      "duration_seconds": 2.61,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.97,
      "end_seconds": 188.96,
      "duration_seconds": 3.99,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.17,
      "end_seconds": 192.56,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.32,
      "end_seconds": 197.47,
      "duration_seconds": 3.15,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.26,
      "end_seconds": 199.89,
      "duration_seconds": 1.63,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.87,
      "end_seconds": 204.71,
      "duration_seconds": 3.84,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.91,
      "end_seconds": 227.47,
      "duration_seconds": 4.56,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.94,
      "end_seconds": 236.75,
      "duration_seconds": 3.81,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.26,
      "end_seconds": 242.87,
      "duration_seconds": 3.61,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.16,
      "end_seconds": 246.57,
      "duration_seconds": 2.41,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.98,
      "end_seconds": 271.72,
      "duration_seconds": 6.74,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.81,
      "end_seconds": 314.61,
      "duration_seconds": 37.8,
      "text": "That's all I needed to check. Okay, so my impression is this: I'd lean towards a severe drug reaction. I'd like to arrange urgent blood tests for severe drug reaction. I'll start you on prednisolone, 40 milligrams, once a day, until review. That's for severe drug reaction. Stop the allopurinol now and you need admission. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.55,
      "end_seconds": 319.77,
      "duration_seconds": 3.22,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.75,
      "end_seconds": 323.86,
      "duration_seconds": 3.11,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.37,
      "end_seconds": 326.78,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
}