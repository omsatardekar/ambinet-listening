{
  "schema_version": "1.0",
  "encounter_id": "02752",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 3.32,
      "duration_seconds": 2.76,
      "text": "hi doctor am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.58,
      "end_seconds": 9.05,
      "duration_seconds": 4.47,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.23,
      "end_seconds": 23.07,
      "duration_seconds": 12.84,
      "text": "so honestly it's dizziness on standing and my family pushed me to come work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.97,
      "end_seconds": 38.74,
      "duration_seconds": 9.77,
      "text": "right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.61,
      "end_seconds": 50.22,
      "duration_seconds": 10.61,
      "text": "it happens on and off. About a four out of ten. I thought it would sort itself out but it hasn't"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.3,
      "end_seconds": 54.23,
      "duration_seconds": 2.93,
      "text": "Have you had a widespread sunburn-like rash?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.02,
      "end_seconds": 60.63,
      "duration_seconds": 4.61,
      "text": "Yes, about the the same, about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.21,
      "end_seconds": 67.52,
      "duration_seconds": 5.31,
      "text": "have you had dizziness on standing before or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.37,
      "end_seconds": 73.87,
      "duration_seconds": 5.5,
      "text": "I had a similar thing about six months ago it went away"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.46,
      "end_seconds": 78.18,
      "duration_seconds": 3.72,
      "text": "so, any sore throat, stiff neck or cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.16,
      "end_seconds": 85.16,
      "duration_seconds": 3.0,
      "text": "No none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.92,
      "end_seconds": 89.37,
      "duration_seconds": 2.45,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.95,
      "end_seconds": 91.98,
      "duration_seconds": 2.03,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.34,
      "end_seconds": 96.14,
      "duration_seconds": 2.8,
      "text": "okay, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.44,
      "end_seconds": 98.97,
      "duration_seconds": 1.53,
      "text": "no nothing there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.76,
      "end_seconds": 103.7,
      "duration_seconds": 2.94,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.26,
      "end_seconds": 107.2,
      "duration_seconds": 1.94,
      "text": "I've had migraines yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.56,
      "end_seconds": 120.83,
      "duration_seconds": 5.27,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.11,
      "end_seconds": 125.54,
      "duration_seconds": 3.43,
      "text": "Kiwi. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.97,
      "end_seconds": 129.46,
      "duration_seconds": 2.49,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.36,
      "end_seconds": 135.45,
      "duration_seconds": 5.09,
      "text": "yes, I had a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.15,
      "end_seconds": 138.93,
      "duration_seconds": 2.78,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.84,
      "end_seconds": 144.75,
      "duration_seconds": 4.91,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.25,
      "end_seconds": 146.86,
      "duration_seconds": 1.61,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.38,
      "end_seconds": 150.52,
      "duration_seconds": 3.14,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.65,
      "end_seconds": 160.83,
      "duration_seconds": 2.18,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.57,
      "end_seconds": 175.8,
      "duration_seconds": 14.23,
      "text": "It's, It's sumatriptan, 50 milligrams, when needed. Though honestly, some days I forget to take it. I was on propranolol before. I stopped taking it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.7,
      "end_seconds": 183.26,
      "duration_seconds": 2.56,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.25,
      "end_seconds": 195.3,
      "duration_seconds": 3.05,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.04,
      "end_seconds": 217.58,
      "duration_seconds": 6.54,
      "text": "Okay: temperature 37.2, BP is 95 over 59, respiratory rate 20, heart rate 105."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.96,
      "end_seconds": 220.54,
      "duration_seconds": 1.58,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.17,
      "end_seconds": 224.4,
      "duration_seconds": 3.23,
      "text": "I'll come back to to the numbers"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.21,
      "end_seconds": 231.33,
      "duration_seconds": 4.12,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.28,
      "end_seconds": 233.2,
      "duration_seconds": 0.92,
      "text": "of course"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.08,
      "end_seconds": 236.3,
      "duration_seconds": 1.22,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.74,
      "end_seconds": 261.09,
      "duration_seconds": 8.35,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.95,
      "end_seconds": 267.77,
      "duration_seconds": 1.82,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.61,
      "end_seconds": 282.05,
      "duration_seconds": 4.44,
      "text": "Taking everything into account, this is probably possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.71,
      "end_seconds": 284.1,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.1,
      "end_seconds": 298.19,
      "duration_seconds": 13.09,
      "text": "it's reasonable to to be concerned, but right now possible toxic shock syndrome is my leading thought, not anything worse we should do a vaginal swab for possible toxic shock"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.85,
      "end_seconds": 300.66,
      "duration_seconds": 1.81,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.76,
      "end_seconds": 309.87,
      "duration_seconds": 7.11,
      "text": "The treatment will be flucloxacillin 2 grams now single dose. It's for possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.01,
      "end_seconds": 317.92,
      "duration_seconds": 1.91,
      "text": "fine I'll begin it"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.49,
      "end_seconds": 326.32,
      "duration_seconds": 6.83,
      "text": "remove any tampon you are going to hospital now. I'll also refer you to the emergency team"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.12,
      "end_seconds": 330.6,
      "duration_seconds": 2.48,
      "text": "sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.07,
      "end_seconds": 339.31,
      "duration_seconds": 7.24,
      "text": "Please come and see me straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.16,
      "end_seconds": 343.47,
      "duration_seconds": 3.31,
      "text": "okay that makes sense thanks for explaining"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.39,
      "end_seconds": 345.86,
      "duration_seconds": 1.47,
      "text": "See you soon."
    }
  ]
}