  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 3.8,
      "duration_seconds": 2.83,
      "text": "Good morning grab a a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.73,
      "end_seconds": 7.94,
      "duration_seconds": 3.21,
      "text": "morning doctor sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.8,
      "end_seconds": 11.63,
      "duration_seconds": 2.83,
      "text": "Is it it your first time here?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.83,
      "end_seconds": 16.98,
      "duration_seconds": 4.15,
      "text": "no, I came last year for something else"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.95,
      "end_seconds": 22.87,
      "duration_seconds": 1.92,
      "text": "where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.11,
      "end_seconds": 33.54,
      "duration_seconds": 6.43,
      "text": "I wanted to get a chesty cough for a week looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.11,
      "end_seconds": 37.99,
      "duration_seconds": 2.88,
      "text": "okay I'll do your observations first"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.84,
      "end_seconds": 49.96,
      "duration_seconds": 2.12,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.05,
      "end_seconds": 77.2,
      "duration_seconds": 10.15,
      "text": "Okay: respiratory rate 15, temperature 36.4, pulse is 64 beats a minute. And blood pressure 110 over 72, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.02,
      "end_seconds": 80.39,
      "duration_seconds": 2.37,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.87,
      "end_seconds": 84.59,
      "duration_seconds": 2.72,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.01,
      "end_seconds": 96.32,
      "duration_seconds": 1.31,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.78,
      "end_seconds": 99.93,
      "duration_seconds": 2.15,
      "text": "About... well, three weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.18,
      "end_seconds": 114.95,
      "duration_seconds": 13.77,
      "text": "tell me a bit more about it: how bad it it gets how often and whether anything makes it better or worse. It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.91,
      "end_seconds": 124.4,
      "duration_seconds": 8.49,
      "text": "honestly once or twice a day. I'd say mild. I've also had slight aching for two weeks"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.37,
      "end_seconds": 135.55,
      "duration_seconds": 9.18,
      "text": "Can you describe it a bit more for me? How strong it it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.36,
      "end_seconds": 140.94,
      "duration_seconds": 3.58,
      "text": "it's all the time i'd say severe"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.54,
      "end_seconds": 149.17,
      "duration_seconds": 6.63,
      "text": "let me check a few things any chest pain, fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.84,
      "end_seconds": 152.99,
      "duration_seconds": 2.15,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.85,
      "end_seconds": 158.18,
      "duration_seconds": 3.33,
      "text": "Alright, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.7,
      "end_seconds": 164.26,
      "duration_seconds": 4.56,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.04,
      "end_seconds": 168.47,
      "duration_seconds": 2.43,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.15,
      "end_seconds": 171.79,
      "duration_seconds": 1.64,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.38,
      "end_seconds": 184.48,
      "duration_seconds": 4.1,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.41,
      "end_seconds": 188.3,
      "duration_seconds": 1.89,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.2,
      "end_seconds": 206.59,
      "duration_seconds": 4.39,
      "text": "right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.13,
      "end_seconds": 211.93,
      "duration_seconds": 1.8,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.1,
      "end_seconds": 228.84,
      "duration_seconds": 4.74,
      "text": "let's talk a little about your daily life and and habits"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.34,
      "end_seconds": 243.58,
      "duration_seconds": 13.24,
      "text": "No, I share a house with my brother. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.08,
      "end_seconds": 250.42,
      "duration_seconds": 5.34,
      "text": "So, based on your history, this looks most like acute viral bronchitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.09,
      "end_seconds": 253.68,
      "duration_seconds": 1.59,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.3,
      "end_seconds": 275.34,
      "duration_seconds": 19.04,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. So, to recap quickly. You've had a chesty cough for a week for three weeks, mild, and no chest pain or coughing up blood"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.32,
      "end_seconds": 280.91,
      "duration_seconds": 1.59,
      "text": "mm, that's right"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.17,
      "end_seconds": 293.2,
      "duration_seconds": 11.03,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Book a review if not better in three weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.64,
      "end_seconds": 298.24,
      "duration_seconds": 3.6,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.85,
      "end_seconds": 300.54,
      "duration_seconds": 1.69,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.34,
      "end_seconds": 306.06,
      "duration_seconds": 3.72,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.5,
      "end_seconds": 313.27,
      "duration_seconds": 2.77,
      "text": "great thank you for your help"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.57,
      "end_seconds": 319.79,
      "duration_seconds": 1.22,
      "text": "see you soon"
    }
  ]
}