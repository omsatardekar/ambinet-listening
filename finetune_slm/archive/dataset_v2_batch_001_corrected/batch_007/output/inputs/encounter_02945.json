{
  "schema_version": "1.0",
  "encounter_id": "02945",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.33,
      "duration_seconds": 4.23,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 10.42,
      "duration_seconds": 4.29,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.15,
      "end_seconds": 19.22,
      "duration_seconds": 8.07,
      "text": "Doctor, it's stiff aching shoulders and hips. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.3,
      "end_seconds": 23.33,
      "duration_seconds": 3.03,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.92,
      "end_seconds": 26.22,
      "duration_seconds": 2.3,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.06,
      "end_seconds": 30.61,
      "duration_seconds": 3.55,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.03,
      "end_seconds": 44.06,
      "duration_seconds": 12.03,
      "text": "Um, pretty severe, if I'm being honest. Okay, so I did have a mild temperature at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.5,
      "end_seconds": 49.04,
      "duration_seconds": 2.54,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.31,
      "end_seconds": 64.35,
      "duration_seconds": 3.04,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.25,
      "end_seconds": 92.29,
      "duration_seconds": 7.04,
      "text": "Okay: heart rate 77, temp 36.6 degrees, pressure 123 over 74. And respiratory rate 18."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.24,
      "end_seconds": 98.23,
      "duration_seconds": 3.99,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.9,
      "end_seconds": 99.9,
      "duration_seconds": 1.0,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 103.69,
      "duration_seconds": 1.91,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.3,
      "end_seconds": 123.78,
      "duration_seconds": 6.48,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.46,
      "end_seconds": 136.33,
      "duration_seconds": 9.87,
      "text": "That's all I needed to check. So, any headache, visual changes, jaw pain on chewing or weight loss at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.96,
      "end_seconds": 145.54,
      "duration_seconds": 5.58,
      "text": "Sorry, what was I saying, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.23,
      "end_seconds": 154.16,
      "duration_seconds": 2.93,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.78,
      "end_seconds": 156.26,
      "duration_seconds": 1.48,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.2,
      "end_seconds": 164.39,
      "duration_seconds": 4.19,
      "text": "Alright, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.95,
      "end_seconds": 168.78,
      "duration_seconds": 2.83,
      "text": "Right, no, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.69,
      "end_seconds": 190.26,
      "duration_seconds": 3.57,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.03,
      "end_seconds": 195.38,
      "duration_seconds": 3.35,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.63,
      "end_seconds": 199.99,
      "duration_seconds": 3.36,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.08,
      "end_seconds": 203.64,
      "duration_seconds": 2.56,
      "text": "COPD, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.41,
      "end_seconds": 206.77,
      "duration_seconds": 2.36,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.69,
      "end_seconds": 213.5,
      "duration_seconds": 4.81,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.37,
      "end_seconds": 218.24,
      "duration_seconds": 2.87,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.85,
      "end_seconds": 224.96,
      "duration_seconds": 5.11,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.76,
      "end_seconds": 229.36,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.41,
      "end_seconds": 233.97,
      "duration_seconds": 3.56,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.68,
      "end_seconds": 256.69,
      "duration_seconds": 4.01,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.34,
      "end_seconds": 260.52,
      "duration_seconds": 3.18,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.58,
      "end_seconds": 269.9,
      "duration_seconds": 4.32,
      "text": "Putting it all together, I'd lean towards polymyalgia rheumatica."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.93,
      "end_seconds": 273.12,
      "duration_seconds": 2.19,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.22,
      "end_seconds": 282.29,
      "duration_seconds": 7.07,
      "text": "I can't promise yet, but most people with polymyalgia rheumatica do well once it's treated properly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.87,
      "end_seconds": 320.49,
      "duration_seconds": 21.62,
      "text": "Blood tests is what I'd like next, for proximal stiffness. I'm going to put you on prednisolone, 15 milligrams, once a day, reducing course. It's for polymyalgia rheumatica. Report any headache or jaw pain immediately. One warning sign to remember: you get a new headache or visual changes. In that case don't wait."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.68,
      "end_seconds": 324.8,
      "duration_seconds": 3.12,
      "text": "Thank you, uh, that's clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.56,
      "end_seconds": 332.47,
      "duration_seconds": 6.91,
      "text": "See me again in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.82,
      "end_seconds": 336.88,
      "duration_seconds": 3.06,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}