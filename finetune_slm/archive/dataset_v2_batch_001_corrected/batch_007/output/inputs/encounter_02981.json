{
  "schema_version": "1.0",
  "encounter_id": "02981",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.18,
      "duration_seconds": 3.06,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.99,
      "end_seconds": 8.76,
      "duration_seconds": 3.77,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.61,
      "end_seconds": 19.05,
      "duration_seconds": 8.44,
      "text": "It's a chesty cough for a week. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.66,
      "end_seconds": 24.12,
      "duration_seconds": 3.46,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.63,
      "end_seconds": 29.13,
      "duration_seconds": 4.5,
      "text": "it's been about two weeks, I'm fairly sure"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.64,
      "end_seconds": 32.8,
      "duration_seconds": 3.16,
      "text": "Any breathlessness or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.65,
      "end_seconds": 38.84,
      "duration_seconds": 5.19,
      "text": "No breathlessness or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.91,
      "end_seconds": 43.26,
      "duration_seconds": 2.35,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.14,
      "end_seconds": 48.45,
      "duration_seconds": 3.31,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.36,
      "end_seconds": 56.36,
      "duration_seconds": 2.0,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.37,
      "end_seconds": 60.11,
      "duration_seconds": 1.74,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.94,
      "end_seconds": 65.81,
      "duration_seconds": 4.87,
      "text": "What about your tummy and and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.74,
      "end_seconds": 69.46,
      "duration_seconds": 2.72,
      "text": "no, that side's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.5,
      "end_seconds": 91.45,
      "duration_seconds": 4.95,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.93,
      "end_seconds": 95.77,
      "duration_seconds": 2.84,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.56,
      "end_seconds": 116.07,
      "duration_seconds": 3.51,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.99,
      "end_seconds": 118.44,
      "duration_seconds": 1.45,
      "text": "I've got gout."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.28,
      "end_seconds": 125.59,
      "duration_seconds": 6.31,
      "text": "Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.96,
      "end_seconds": 146.57,
      "duration_seconds": 3.61,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.48,
      "end_seconds": 152.75,
      "duration_seconds": 4.27,
      "text": "I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.78,
      "end_seconds": 156.05,
      "duration_seconds": 1.27,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.04,
      "end_seconds": 160.87,
      "duration_seconds": 2.83,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.52,
      "end_seconds": 163.97,
      "duration_seconds": 1.45,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.98,
      "end_seconds": 170.34,
      "duration_seconds": 4.36,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.88,
      "end_seconds": 174.05,
      "duration_seconds": 2.17,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.45,
      "end_seconds": 181.02,
      "duration_seconds": 5.57,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.96,
      "end_seconds": 184.27,
      "duration_seconds": 2.31,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.84,
      "end_seconds": 193.04,
      "duration_seconds": 4.2,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.35,
      "end_seconds": 197.05,
      "duration_seconds": 2.7,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.68,
      "end_seconds": 206.96,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.11,
      "end_seconds": 232.2,
      "duration_seconds": 14.09,
      "text": "Okay: pulse is 78 beats a minute, temperature is 36.8 degrees, height 162 centimetres. And weight 73 kilos, oxygen saturation is 97 percent, respiratory rate 14, BP is 122 over 75."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.66,
      "end_seconds": 236.16,
      "duration_seconds": 2.5,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.03,
      "end_seconds": 241.07,
      "duration_seconds": 3.04,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.97,
      "end_seconds": 263.67,
      "duration_seconds": 3.7,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.83,
      "end_seconds": 270.69,
      "duration_seconds": 1.86,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.52,
      "end_seconds": 287.88,
      "duration_seconds": 5.36,
      "text": "So where does that leave us? This is probably acute viral bronchitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.19,
      "end_seconds": 291.44,
      "duration_seconds": 2.25,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.39,
      "end_seconds": 319.22,
      "duration_seconds": 26.83,
      "text": "Nothing I've seen today points to an emergency. It looks like acute viral bronchitis. Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Come back or go to emergency straight away if you get a fever or breathlessness. I'd like to see you again if not better in three weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.25,
      "end_seconds": 322.36,
      "duration_seconds": 2.11,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.2,
      "end_seconds": 324.64,
      "duration_seconds": 1.44,
      "text": "Goodbye for now."
    }
  ]
}