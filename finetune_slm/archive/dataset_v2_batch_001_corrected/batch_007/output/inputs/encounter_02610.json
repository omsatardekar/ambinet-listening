  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.03,
      "duration_seconds": 2.98,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 9.65,
      "duration_seconds": 4.2,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.41,
      "end_seconds": 18.29,
      "duration_seconds": 7.88,
      "text": "Mainly difficulty concentrating. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 21.78,
      "duration_seconds": 2.0,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.8,
      "end_seconds": 29.57,
      "duration_seconds": 2.77,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.49,
      "end_seconds": 33.57,
      "duration_seconds": 3.08,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.48,
      "end_seconds": 41.88,
      "duration_seconds": 6.4,
      "text": "It's moderate, honestly. I've also been losing things, for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.34,
      "end_seconds": 46.28,
      "duration_seconds": 2.94,
      "text": "Did you notice any drug use?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.66,
      "end_seconds": 49.79,
      "duration_seconds": 2.13,
      "text": "Nope, no drug use."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.39,
      "end_seconds": 58.72,
      "duration_seconds": 7.33,
      "text": "Let me check a few things. Any low mood, head injury or thoughts of self-harm?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.4,
      "end_seconds": 65.38,
      "duration_seconds": 4.98,
      "text": "No, no low mood, head injury or thoughts of self-harm."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.76,
      "end_seconds": 68.84,
      "duration_seconds": 3.08,
      "text": "Understood. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.66,
      "end_seconds": 73.32,
      "duration_seconds": 3.66,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.77,
      "end_seconds": 77.42,
      "duration_seconds": 2.65,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.48,
      "end_seconds": 86.59,
      "duration_seconds": 7.11,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.49,
      "end_seconds": 91.66,
      "duration_seconds": 4.17,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.35,
      "end_seconds": 95.21,
      "duration_seconds": 2.86,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.58,
      "end_seconds": 99.47,
      "duration_seconds": 2.89,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.2,
      "end_seconds": 104.81,
      "duration_seconds": 4.61,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.25,
      "end_seconds": 108.23,
      "duration_seconds": 1.98,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.58,
      "end_seconds": 114.1,
      "duration_seconds": 4.52,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.68,
      "end_seconds": 137.25,
      "duration_seconds": 4.57,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.05,
      "end_seconds": 142.39,
      "duration_seconds": 3.34,
      "text": "Uh, no, nothing at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.16,
      "end_seconds": 162.21,
      "duration_seconds": 3.05,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.05,
      "end_seconds": 169.58,
      "duration_seconds": 2.53,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.6,
      "end_seconds": 177.43,
      "duration_seconds": 2.83,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.46,
      "end_seconds": 189.72,
      "duration_seconds": 2.26,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.9,
      "end_seconds": 222.14,
      "duration_seconds": 12.24,
      "text": "Okay: BMI works out to 40.2, height 153 centimetres. And saturation 98 percent, pulse 80, blood pressure 110 over 79, weight 94 kilos."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.47,
      "end_seconds": 225.01,
      "duration_seconds": 1.54,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.92,
      "end_seconds": 229.84,
      "duration_seconds": 2.92,
      "text": "So, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.11,
      "end_seconds": 235.0,
      "duration_seconds": 3.89,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.89,
      "end_seconds": 237.3,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 257.71,
      "duration_seconds": 5.62,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.27,
      "end_seconds": 263.78,
      "duration_seconds": 2.51,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.81,
      "end_seconds": 290.86,
      "duration_seconds": 9.05,
      "text": "Right, here's what I'm thinking. I can't pin this down yet. We're looking at possible adult attention deficit disorder or anxiety."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.06,
      "end_seconds": 297.81,
      "duration_seconds": 2.75,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.11,
      "end_seconds": 308.72,
      "duration_seconds": 9.61,
      "text": "I understand the worry. At the moment I'd say it's possible adult attention deficit disorder, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.8,
      "end_seconds": 335.38,
      "duration_seconds": 8.58,
      "text": "Use lists and reminders while we arrange the specialist assessment. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.3,
      "end_seconds": 339.09,
      "duration_seconds": 2.79,
      "text": "I think I understand everything. Thanks."
    }
  ]
