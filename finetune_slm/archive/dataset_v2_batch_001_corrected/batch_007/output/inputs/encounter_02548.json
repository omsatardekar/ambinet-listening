    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.95,
      "end_seconds": 151.31,
      "duration_seconds": 2.36,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.34,
      "end_seconds": 154.47,
      "duration_seconds": 2.13,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.26,
      "end_seconds": 161.27,
      "duration_seconds": 5.01,
      "text": "It's levetiracetam, 500 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.82,
      "end_seconds": 165.94,
      "duration_seconds": 4.12,
      "text": "Are there any allergies I should be aware of?"
