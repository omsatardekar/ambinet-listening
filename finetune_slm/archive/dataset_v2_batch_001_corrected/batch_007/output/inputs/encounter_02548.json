    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 170.51,
      "duration_seconds": 3.99,
      "text": "Yes, erythromycin, it gives me a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.73,
      "end_seconds": 178.19,
      "duration_seconds": 4.46,
      "text": "What conditions have you been treated for in the the past?"
