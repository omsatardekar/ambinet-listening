      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.83,
      "end_seconds": 186.83,
      "duration_seconds": 6.0,
      "text": "Right, so so epilepsy is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.54,
      "end_seconds": 204.55,
      "duration_seconds": 3.01,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.34,
      "end_seconds": 211.03,
      "duration_seconds": 5.69,
      "text": "Right, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.54,
      "end_seconds": 213.27,
      "duration_seconds": 1.73,
      "text": "And alcohol, how much?"
