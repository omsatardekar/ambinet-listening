    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.16,
      "end_seconds": 248.43,
      "duration_seconds": 4.27,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.27,
      "end_seconds": 250.89,
      "duration_seconds": 1.62,
      "text": "does that that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.21,
      "end_seconds": 267.14,
      "duration_seconds": 4.93,
      "text": "your blood pressure is normal and the abdomen is soft"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.55,
      "end_seconds": 286.5,
      "duration_seconds": 16.95,
      "text": "Okay, that's enough for me. Putting it all together, my working impression is perimenopause. I want to be honest that this is an impression, not a final answer. A thyroid problem is also on my list."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.35,
      "end_seconds": 307.66,
      "duration_seconds": 9.31,
      "text": "I'm prescribing estradiol gel, 1 pump, once a day, long term. That's for menopausal symptoms. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.36,
      "end_seconds": 312.88,
      "duration_seconds": 3.52,
