    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.79,
      "end_seconds": 180.03,
      "duration_seconds": 1.24,
      "text": "yes, epilepsy"
