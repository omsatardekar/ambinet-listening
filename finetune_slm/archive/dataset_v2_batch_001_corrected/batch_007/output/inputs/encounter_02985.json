{
  "schema_version": "1.0",
  "encounter_id": "02985",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 5.11,
      "duration_seconds": 4.33,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 11.36,
      "duration_seconds": 4.8,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.49,
      "end_seconds": 20.56,
      "duration_seconds": 8.07,
      "text": "Mainly difficulty walking. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.41,
      "end_seconds": 25.54,
      "duration_seconds": 3.13,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.87,
      "end_seconds": 38.9,
      "duration_seconds": 9.03,
      "text": "It's been about four days, I'm fairly sure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.35,
      "end_seconds": 43.87,
      "duration_seconds": 3.52,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.6,
      "end_seconds": 48.07,
      "duration_seconds": 2.47,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.14,
      "end_seconds": 52.65,
      "duration_seconds": 2.51,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.68,
      "end_seconds": 65.24,
      "duration_seconds": 10.56,
      "text": "Tingling in my feet goes along with it, most of the time. The tingling in my feet? That's been for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.78,
      "end_seconds": 75.2,
      "duration_seconds": 2.42,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.76,
      "end_seconds": 87.02,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.46,
      "end_seconds": 115.45,
      "duration_seconds": 7.99,
      "text": "Okay: respiratory rate 17, blood pressure 127 over 77, saturation 98 percent, temperature is 36.6 degrees, pulse 70."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.27,
      "end_seconds": 118.56,
      "duration_seconds": 2.29,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.84,
      "end_seconds": 122.03,
      "duration_seconds": 2.19,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.89,
      "end_seconds": 129.0,
      "duration_seconds": 4.11,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.01,
      "end_seconds": 131.49,
      "duration_seconds": 1.48,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.71,
      "end_seconds": 143.95,
      "duration_seconds": 5.24,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.64,
      "end_seconds": 150.39,
      "duration_seconds": 1.75,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 168.71,
      "duration_seconds": 3.29,
      "text": "Have you had any fever or back pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.13,
      "end_seconds": 175.32,
      "duration_seconds": 2.19,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.43,
      "end_seconds": 178.16,
      "duration_seconds": 1.73,
      "text": "How about bladder problems?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.13,
      "end_seconds": 183.94,
      "duration_seconds": 4.81,
      "text": "Um, no, I haven't had any bladder problems."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.36,
      "end_seconds": 188.11,
      "duration_seconds": 2.75,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.16,
      "end_seconds": 194.13,
      "duration_seconds": 0.97,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.71,
      "end_seconds": 197.14,
      "duration_seconds": 2.43,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.19,
      "end_seconds": 199.91,
      "duration_seconds": 1.72,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.98,
      "end_seconds": 203.64,
      "duration_seconds": 2.66,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.26,
      "end_seconds": 213.29,
      "duration_seconds": 8.03,
      "text": "I was told I'm allergic to wheat, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.2,
      "end_seconds": 219.57,
      "duration_seconds": 4.37,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.56,
      "end_seconds": 226.53,
      "duration_seconds": 4.97,
      "text": "I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 241.18,
      "duration_seconds": 2.92,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.65,
      "end_seconds": 246.89,
      "duration_seconds": 2.24,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.25,
      "end_seconds": 255.62,
      "duration_seconds": 7.37,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.73,
      "end_seconds": 260.85,
      "duration_seconds": 4.12,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.23,
      "end_seconds": 263.41,
      "duration_seconds": 1.18,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.46,
      "end_seconds": 267.95,
      "duration_seconds": 3.49,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.03,
      "end_seconds": 272.2,
      "duration_seconds": 2.17,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.92,
      "end_seconds": 276.41,
      "duration_seconds": 2.49,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 279.7,
      "duration_seconds": 1.77,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.12,
      "end_seconds": 285.58,
      "duration_seconds": 4.46,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.95,
      "end_seconds": 311.83,
      "duration_seconds": 18.88,
      "text": "From what you've told me and what I found, I can't pin this down yet. We're looking at possible Guillain-Barre syndrome or a spinal cord problem. So, to recap quickly. You've had difficulty walking for about four days, moderate, and no back pain or fever."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.76,
      "end_seconds": 314.42,
      "duration_seconds": 1.66,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.58,
      "end_seconds": 326.37,
      "duration_seconds": 7.79,
      "text": "Let's get a lumbar puncture, for possible GBS. You must be admitted today for monitoring of your breathing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.77,
      "end_seconds": 338.72,
      "duration_seconds": 11.95,
      "text": "Yes. Come back or go to emergency straight away if the symptoms get worse. Please come and see me straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.76,
      "end_seconds": 343.15,
      "duration_seconds": 2.39,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.73,
      "end_seconds": 345.5,
      "duration_seconds": 1.77,
      "text": "So, see you soon."
    }
  ]
}