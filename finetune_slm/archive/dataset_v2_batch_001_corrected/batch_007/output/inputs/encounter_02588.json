{
  "schema_version": "1.0",
  "encounter_id": "02588",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.27,
      "duration_seconds": 4.01,
      "text": "sorry, um, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.11,
      "end_seconds": 11.01,
      "duration_seconds": 4.9,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.06,
      "end_seconds": 22.48,
      "duration_seconds": 9.42,
      "text": "Yeah, it's bloody diarrhoea. I don't know what's causing it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.41,
      "end_seconds": 26.56,
      "duration_seconds": 3.15,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.99,
      "end_seconds": 30.68,
      "duration_seconds": 2.69,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.0,
      "end_seconds": 50.45,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.35,
      "end_seconds": 64.32,
      "duration_seconds": 2.97,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.66,
      "end_seconds": 89.01,
      "duration_seconds": 8.35,
      "text": "okay: temperature 36.9, heart rate 108, blood pressure 119 over 87, oxygen saturation is 96 percent"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.4,
      "end_seconds": 91.78,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.86,
      "end_seconds": 97.6,
      "duration_seconds": 3.74,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.88,
      "end_seconds": 104.02,
      "duration_seconds": 4.14,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.13,
      "end_seconds": 108.83,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.04,
      "end_seconds": 112.45,
      "duration_seconds": 2.41,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.82,
      "end_seconds": 134.62,
      "duration_seconds": 10.8,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.55,
      "end_seconds": 144.77,
      "duration_seconds": 5.22,
      "text": "Please sit back down. Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.86,
      "end_seconds": 148.68,
      "duration_seconds": 2.82,
      "text": "not that I've noticed, no fever"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.61,
      "end_seconds": 154.5,
      "duration_seconds": 3.89,
      "text": "Have you had any chest pain or hernia?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.3,
      "end_seconds": 160.08,
      "duration_seconds": 3.78,
      "text": "No chest pain or hernia, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.62,
      "end_seconds": 167.32,
      "duration_seconds": 2.7,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.4,
      "end_seconds": 170.13,
      "duration_seconds": 1.73,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.9,
      "end_seconds": 175.1,
      "duration_seconds": 3.2,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.09,
      "end_seconds": 178.44,
      "duration_seconds": 2.35,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.97,
      "end_seconds": 199.79,
      "duration_seconds": 3.82,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.04,
      "end_seconds": 210.27,
      "duration_seconds": 9.23,
      "text": "Okay, so I have an irregular heartbeat, for about a year. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.11,
      "end_seconds": 213.24,
      "duration_seconds": 2.13,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.79,
      "end_seconds": 216.51,
      "duration_seconds": 2.72,
      "text": "It's metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.54,
      "end_seconds": 221.31,
      "duration_seconds": 2.77,
      "text": "Alright, how much do you take?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.53,
      "end_seconds": 228.35,
      "duration_seconds": 5.82,
      "text": "50 milligrams i'm, I'm on a blood thinner, stopped last month"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.79,
      "end_seconds": 233.9,
      "duration_seconds": 2.11,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.34,
      "end_seconds": 236.4,
      "duration_seconds": 1.06,
      "text": "5 milligrams"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.12,
      "end_seconds": 255.59,
      "duration_seconds": 2.47,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.48,
      "end_seconds": 258.99,
      "duration_seconds": 1.51,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.33,
      "end_seconds": 274.01,
      "duration_seconds": 5.68,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.97,
      "end_seconds": 284.97,
      "duration_seconds": 10.0,
      "text": "My husband and I live above the shop. I walk the dog every morning. I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.67,
      "end_seconds": 298.06,
      "duration_seconds": 12.39,
      "text": "From what you've told me and what I found, this is probably possible bowel ischaemia. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.83,
      "end_seconds": 301.78,
      "duration_seconds": 2.95,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.38,
      "end_seconds": 329.62,
      "duration_seconds": 27.24,
      "text": "I can't promise yet, but most people with possible bowel ischaemia do well once it's treated properly. I'm going to order an urgent CT angiogram, for possible bowel ischaemia. This is an emergency, you are going to hospital now. If it hasn't settled next month, we'd think about urgent blood tests, but not now. Come back straight away. I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.36,
      "end_seconds": 334.54,
      "duration_seconds": 3.18,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.95,
      "end_seconds": 337.8,
      "duration_seconds": 1.85,
      "text": "Right, take care now."
    }
  ]
}