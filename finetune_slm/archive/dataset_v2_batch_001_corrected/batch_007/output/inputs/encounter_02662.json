{
  "schema_version": "1.0",
  "encounter_id": "02662",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.56,
      "end_seconds": 7.3,
      "duration_seconds": 6.74,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.78,
      "end_seconds": 15.73,
      "duration_seconds": 4.95,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.58,
      "end_seconds": 22.17,
      "duration_seconds": 5.59,
      "text": "Hello, um, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.97,
      "end_seconds": 27.51,
      "duration_seconds": 4.54,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 29.28,
      "end_seconds": 33.2,
      "duration_seconds": 3.92,
      "text": "He's been having a sudden high fever, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.94,
      "end_seconds": 36.42,
      "duration_seconds": 1.48,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 37.83,
      "end_seconds": 45.2,
      "duration_seconds": 7.37,
      "text": "It's been going on for about three months. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.14,
      "end_seconds": 49.94,
      "duration_seconds": 2.8,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 51.48,
      "end_seconds": 54.97,
      "duration_seconds": 3.49,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 55.55,
      "end_seconds": 60.96,
      "duration_seconds": 5.41,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 61.06,
      "end_seconds": 67.5,
      "duration_seconds": 6.44,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.08,
      "end_seconds": 70.57,
      "duration_seconds": 2.49,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 71.52,
      "end_seconds": 79.47,
      "duration_seconds": 7.95,
      "text": "Oh, uh, and dizziness on standing. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.84,
      "end_seconds": 85.25,
      "duration_seconds": 2.41,
      "text": "Any vomiting and diarrhoea as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 87.33,
      "end_seconds": 88.4,
      "duration_seconds": 1.07,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.22,
      "end_seconds": 92.72,
      "duration_seconds": 3.5,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 94.29,
      "end_seconds": 95.47,
      "duration_seconds": 1.18,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_6",
      "role": "UNKNOWN",
      "start_seconds": 97.37,
      "end_seconds": 99.28,
      "duration_seconds": 1.91,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.16,
      "end_seconds": 104.07,
      "duration_seconds": 3.91,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 104.65,
      "end_seconds": 111.69,
      "duration_seconds": 7.04,
      "text": "I've had asthma, yes. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.67,
      "end_seconds": 113.41,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 115.16,
      "end_seconds": 143.91,
      "duration_seconds": 28.75,
      "text": "I've got an underactive thyroid. A neighbour of mine said I should see someone about it. I didn't want to make a fuss, you know. Okay, so I've had migraines for about ten years now. I've had eczema for five years now. I told my wife I'd come today. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.56,
      "end_seconds": 154.74,
      "duration_seconds": 10.18,
      "text": "Right, so asthma and an underactive thyroid are already on your record. We'll keep that in mind today. Right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 156.36,
      "end_seconds": 169.77,
      "duration_seconds": 13.41,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.04,
      "end_seconds": 176.91,
      "duration_seconds": 2.87,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 178.97,
      "end_seconds": 185.69,
      "duration_seconds": 6.72,
      "text": "Yes, um, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.47,
      "end_seconds": 191.91,
      "duration_seconds": 4.44,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 192.87,
      "end_seconds": 204.48,
      "duration_seconds": 11.61,
      "text": "It's Asthalin inhaler, when needed, doctor. It's Eltroxin, 100 micrograms, every morning, doctor. Well, it's sumatriptan, 50 milligrams, when needed, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 205.68,
      "end_seconds": 212.6,
      "duration_seconds": 6.92,
      "text": "I had Foracort inhaler at one point, you know, but I'm off it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.02,
      "end_seconds": 234.81,
      "duration_seconds": 4.79,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 236.0,
      "end_seconds": 249.96,
      "duration_seconds": 13.96,
      "text": "No, I've never smoked in my life. Nothing, I'm teetotal. I drink a lot of tea and snack through the day. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.11,
      "end_seconds": 263.1,
      "duration_seconds": 3.99,
      "text": "Right, any stiff neck or sore throat at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 264.43,
      "end_seconds": 276.41,
      "duration_seconds": 11.98,
      "text": "No, no stiff neck, no sore throat. I did have a widespread sunburn-like rash at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.03,
      "end_seconds": 279.26,
      "duration_seconds": 1.23,
      "text": "Nothing like cough?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 280.39,
      "end_seconds": 282.01,
      "duration_seconds": 1.62,
      "text": "No cough, thankfully."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 283.98,
      "end_seconds": 289.33,
      "duration_seconds": 5.35,
      "text": "Actually, doctor, I did notice cough. He doesn't always say."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 290.35,
      "end_seconds": 296.32,
      "duration_seconds": 5.97,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.98,
      "end_seconds": 304.9,
      "duration_seconds": 6.92,
      "text": "Alright, I'll note both what you've said and what you've noticed. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 306.86,
      "end_seconds": 310.28,
      "duration_seconds": 3.42,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 310.79,
      "end_seconds": 320.88,
      "duration_seconds": 10.09,
      "text": "Okay, so the vitals from earlier. Pulse is 96 beats a minute, BP is 97 over 57, SpO2 98 percent on room air. Respiratory rate 18."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.22,
      "end_seconds": 323.14,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.07,
      "end_seconds": 329.58,
      "duration_seconds": 4.51,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.75,
      "end_seconds": 332.18,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.85,
      "end_seconds": 349.18,
      "duration_seconds": 9.33,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.12,
      "end_seconds": 380.54,
      "duration_seconds": 27.42,
      "text": "You can sit up now. Okay, so my impression is this: This is probably possible toxic shock syndrome. That's my thinking for now, and it may change as we learn more. A viral illness is still possible. Let me repeat that back to make sure. You've had a sudden high fever for about three months, and no sore throat or stiff neck."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 382.53,
      "end_seconds": 383.23,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.49,
      "end_seconds": 414.43,
      "duration_seconds": 29.94,
      "text": "I want blood cultures done, that's for possible toxic shock. I'd rather check than guess, and this is the quickest way to know more. I'm sending you for a vaginal swab because of possible toxic shock. For this, flucloxacillin, 2 grams, now, single dose. That's for possible toxic shock syndrome. Remove any tampon, you are going to hospital now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.18,
      "end_seconds": 429.15,
      "duration_seconds": 13.97,
      "text": "Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 430.1,
      "end_seconds": 432.65,
      "duration_seconds": 2.55,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.87,
      "end_seconds": 439.32,
      "duration_seconds": 5.45,
      "text": "Let's review you straight away. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 441.86,
      "end_seconds": 444.28,
      "duration_seconds": 2.42,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.05,
      "end_seconds": 447.22,
      "duration_seconds": 1.17,
      "text": "Take care now."
    }
  ]
}