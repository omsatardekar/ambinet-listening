{
  "schema_version": "1.0",
  "encounter_id": "02976",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 5.75,
      "duration_seconds": 4.88,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 11.74,
      "duration_seconds": 4.12,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.15,
      "end_seconds": 20.25,
      "duration_seconds": 6.1,
      "text": "Right, you know, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.16,
      "end_seconds": 30.58,
      "duration_seconds": 8.42,
      "text": "Actually, mainly it stopping just as suddenly. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.93,
      "end_seconds": 34.78,
      "duration_seconds": 2.85,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.79,
      "end_seconds": 41.73,
      "duration_seconds": 2.94,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 42.59,
      "end_seconds": 46.35,
      "duration_seconds": 3.76,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.39,
      "end_seconds": 53.21,
      "duration_seconds": 4.82,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.27,
      "end_seconds": 57.36,
      "duration_seconds": 2.09,
      "text": "Yeah, you know, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.83,
      "end_seconds": 61.09,
      "duration_seconds": 2.26,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.72,
      "end_seconds": 66.61,
      "duration_seconds": 4.89,
      "text": "Uh, it usually comes with my heart suddenly racing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.1,
      "end_seconds": 74.41,
      "duration_seconds": 3.31,
      "text": "Have you been feeling lightheaded during an episode?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.37,
      "end_seconds": 77.74,
      "duration_seconds": 2.37,
      "text": "Yes, for six months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.32,
      "end_seconds": 83.63,
      "duration_seconds": 5.31,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.23,
      "end_seconds": 93.33,
      "duration_seconds": 9.1,
      "text": "It happens all the time. About a six out of ten. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.48,
      "end_seconds": 98.32,
      "duration_seconds": 3.84,
      "text": "Has there been a pounding in your neck too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.05,
      "end_seconds": 104.09,
      "duration_seconds": 1.04,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.68,
      "end_seconds": 108.03,
      "duration_seconds": 3.35,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 113.11,
      "duration_seconds": 3.61,
      "text": "Well, about a eight out of ten."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.01,
      "end_seconds": 123.46,
      "duration_seconds": 5.45,
      "text": "Any chest pain, breathlessness, fainting or family history of sudden death at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.14,
      "end_seconds": 130.11,
      "duration_seconds": 5.97,
      "text": "No, no chest pain, breathlessness, fainting or family history of sudden death."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.0,
      "end_seconds": 134.8,
      "duration_seconds": 2.8,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.94,
      "end_seconds": 138.43,
      "duration_seconds": 2.49,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.91,
      "end_seconds": 145.18,
      "duration_seconds": 4.27,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.02,
      "end_seconds": 151.56,
      "duration_seconds": 2.54,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 155.94,
      "duration_seconds": 2.66,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.74,
      "end_seconds": 174.39,
      "duration_seconds": 12.65,
      "text": "I was told I'm allergic to grass pollen, but I don't remember what reaction I had. Kiwi. I come out in... well, an itchy mouth."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.52,
      "end_seconds": 178.47,
      "duration_seconds": 2.95,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.31,
      "end_seconds": 184.96,
      "duration_seconds": 4.65,
      "text": "Oh, I have acid reflux, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.47,
      "end_seconds": 186.89,
      "duration_seconds": 1.42,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.23,
      "end_seconds": 189.26,
      "duration_seconds": 1.03,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.54,
      "end_seconds": 198.07,
      "duration_seconds": 7.53,
      "text": "Yes, carry on. Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.46,
      "end_seconds": 214.59,
      "duration_seconds": 3.13,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.76,
      "end_seconds": 232.65,
      "duration_seconds": 16.89,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I look after my grandchildren most days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.3,
      "end_seconds": 246.68,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.36,
      "end_seconds": 249.84,
      "duration_seconds": 2.48,
      "text": "Allopurinol I don't take anymore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.01,
      "end_seconds": 254.35,
      "duration_seconds": 3.34,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.1,
      "end_seconds": 259.49,
      "duration_seconds": 3.39,
      "text": "Erm, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 261.02,
      "end_seconds": 268.25,
      "duration_seconds": 7.23,
      "text": "Okay, so the vitals from earlier. Pressure 110 over 73, temperature is 36.4 degrees, heart rate 84."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.07,
      "end_seconds": 270.03,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.21,
      "end_seconds": 275.94,
      "duration_seconds": 4.73,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.0,
      "end_seconds": 279.07,
      "duration_seconds": 2.07,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.54,
      "end_seconds": 295.75,
      "duration_seconds": 3.21,
      "text": "Your heart sounds and rhythm are normal today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.38,
      "end_seconds": 301.62,
      "duration_seconds": 2.24,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.24,
      "end_seconds": 339.68,
      "duration_seconds": 20.44,
      "text": "Having listened and examined, I don't have a clear answer today: episodes of supraventricular tachycardia is possible, and so is atrial fibrillation. Try blowing hard against a closed mouth and nose when it starts. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 340.89,
      "end_seconds": 344.01,
      "duration_seconds": 3.12,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}