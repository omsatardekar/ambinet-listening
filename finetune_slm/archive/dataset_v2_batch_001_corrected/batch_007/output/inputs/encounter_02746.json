{
  "schema_version": "1.0",
  "encounter_id": "02746",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.18,
      "duration_seconds": 3.06,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 8.72,
      "duration_seconds": 3.72,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.55,
      "end_seconds": 15.07,
      "duration_seconds": 4.52,
      "text": "Um, so... bloody diarrhoea. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.76,
      "end_seconds": 17.07,
      "duration_seconds": 1.31,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.78,
      "end_seconds": 24.41,
      "duration_seconds": 6.63,
      "text": "Around about four days... no wait, uh, it's more like five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.68,
      "end_seconds": 28.7,
      "duration_seconds": 3.02,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.23,
      "end_seconds": 34.92,
      "duration_seconds": 5.69,
      "text": "Actually, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.88,
      "end_seconds": 53.42,
      "duration_seconds": 2.54,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.59,
      "end_seconds": 66.96,
      "duration_seconds": 2.37,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 89.07,
      "duration_seconds": 7.87,
      "text": "Okay: oxygen saturation is 97 percent, pressure 114 over 83, temp 36.9 degrees, heart rate 122."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.11,
      "end_seconds": 91.46,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.26,
      "end_seconds": 95.87,
      "duration_seconds": 2.61,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.74,
      "end_seconds": 100.18,
      "duration_seconds": 2.44,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.77,
      "end_seconds": 103.72,
      "duration_seconds": 1.95,
      "text": "Okay, nearly finished here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.87,
      "end_seconds": 130.74,
      "duration_seconds": 10.87,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.39,
      "end_seconds": 136.13,
      "duration_seconds": 2.74,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.36,
      "end_seconds": 154.66,
      "duration_seconds": 3.3,
      "text": "And what about fever, hernia or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.52,
      "end_seconds": 159.21,
      "duration_seconds": 3.69,
      "text": "Uh, no, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.64,
      "end_seconds": 163.6,
      "duration_seconds": 2.96,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.16,
      "end_seconds": 166.28,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.21,
      "end_seconds": 172.22,
      "duration_seconds": 4.01,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.74,
      "end_seconds": 176.24,
      "duration_seconds": 2.5,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.58,
      "end_seconds": 181.71,
      "duration_seconds": 4.13,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.34,
      "end_seconds": 184.14,
      "duration_seconds": 1.8,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.87,
      "end_seconds": 188.09,
      "duration_seconds": 3.22,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.75,
      "end_seconds": 194.76,
      "duration_seconds": 5.01,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.32,
      "end_seconds": 199.91,
      "duration_seconds": 3.59,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.63,
      "end_seconds": 205.09,
      "duration_seconds": 3.46,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.86,
      "end_seconds": 210.19,
      "duration_seconds": 4.33,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.9,
      "end_seconds": 215.19,
      "duration_seconds": 4.29,
      "text": "It's a blood thinner, 5 milligrams, stopped last month."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.42,
      "end_seconds": 223.83,
      "duration_seconds": 7.41,
      "text": "So, based on the history and the examination, my working impression is possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.84,
      "end_seconds": 228.28,
      "duration_seconds": 3.44,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.87,
      "end_seconds": 240.3,
      "duration_seconds": 11.43,
      "text": "I understand the worry. At the moment I'd say it's possible bowel ischaemia, and we'll know more once the an urgent CT angiogram is back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.73,
      "end_seconds": 262.79,
      "duration_seconds": 9.06,
      "text": "Let's get an urgent CT angiogram, for possible bowel ischaemia. This is an emergency, you are going to hospital now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.12,
      "end_seconds": 268.05,
      "duration_seconds": 4.93,
      "text": "Mm, okay. I'll also refer you to the surgical team."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.74,
      "end_seconds": 272.37,
      "duration_seconds": 3.63,
      "text": "Right, sure, where do I go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.1,
      "end_seconds": 282.64,
      "duration_seconds": 8.54,
      "text": "I'd like you back straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.86,
      "end_seconds": 288.58,
      "duration_seconds": 4.72,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.5,
      "end_seconds": 295.14,
      "duration_seconds": 5.64,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.25,
      "end_seconds": 299.93,
      "duration_seconds": 3.68,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.54,
      "end_seconds": 302.9,
      "duration_seconds": 1.36,
      "text": "Take care now."
    }
  ]
}