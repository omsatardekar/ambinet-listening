{
  "schema_version": "1.0",
  "encounter_id": "02530",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 3.66,
      "duration_seconds": 3.05,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.68,
      "end_seconds": 9.87,
      "duration_seconds": 4.19,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.6,
      "end_seconds": 18.13,
      "duration_seconds": 6.53,
      "text": "I've been passing kidney stones. It's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.6,
      "end_seconds": 22.76,
      "duration_seconds": 3.16,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.67,
      "end_seconds": 31.24,
      "duration_seconds": 7.57,
      "text": "Sorry, um, what was I saying, it's been going on for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.04,
      "end_seconds": 35.64,
      "duration_seconds": 3.6,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.45,
      "end_seconds": 38.6,
      "duration_seconds": 2.15,
      "text": "It's, It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.13,
      "end_seconds": 41.49,
      "duration_seconds": 2.36,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.51,
      "end_seconds": 69.17,
      "duration_seconds": 25.66,
      "text": "It usually comes with aching bones. There's being thirsty as well. As for aching bones, I honestly can't say when that began. It might have been last month or the month before. Sorry, what was I saying, about aching bones, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.22,
      "end_seconds": 83.55,
      "duration_seconds": 1.33,
      "text": "Nothing like fractures?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.66,
      "end_seconds": 86.24,
      "duration_seconds": 1.58,
      "text": "Definitely no fractures."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.75,
      "end_seconds": 91.85,
      "duration_seconds": 4.1,
      "text": "Have you had any fever, weight loss or low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.43,
      "end_seconds": 94.92,
      "duration_seconds": 2.49,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 103.3,
      "duration_seconds": 1.84,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.23,
      "end_seconds": 108.13,
      "duration_seconds": 0.9,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.62,
      "end_seconds": 114.95,
      "duration_seconds": 2.33,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.83,
      "end_seconds": 121.01,
      "duration_seconds": 5.18,
      "text": "Well, I have thin bones, for two years. I've got anxiety."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.32,
      "end_seconds": 127.68,
      "duration_seconds": 5.36,
      "text": "Okay, I can see thin bones in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.59,
      "end_seconds": 140.75,
      "duration_seconds": 5.16,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.99,
      "end_seconds": 157.68,
      "duration_seconds": 15.69,
      "text": "It's alendronate, 70 milligrams, once a week. I'm supposed to take it regularly, but I don't always manage. I take escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.24,
      "end_seconds": 159.8,
      "duration_seconds": 1.56,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.44,
      "end_seconds": 161.9,
      "duration_seconds": 1.46,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.13,
      "end_seconds": 166.63,
      "duration_seconds": 3.5,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.68,
      "end_seconds": 181.18,
      "duration_seconds": 11.5,
      "text": "I live with my elderly mother. I hardly move around during the day. I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.46,
      "end_seconds": 183.72,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.52,
      "end_seconds": 188.58,
      "duration_seconds": 3.06,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.1,
      "end_seconds": 201.11,
      "duration_seconds": 4.01,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.31,
      "end_seconds": 216.93,
      "duration_seconds": 14.62,
      "text": "um, yes, erythromycin. I've no idea what the reaction was, only that I'm not supposed to have it. Plasters. I come out in... well, a red itchy rash"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.49,
      "end_seconds": 220.19,
      "duration_seconds": 2.7,
      "text": "right, I'll do your observations first"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 231.74,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 260.71,
      "duration_seconds": 14.55,
      "text": "Okay: height 161 centimetres, oxygen saturation is 97 percent, weight 67 kilos. And pressure 110 over 81, BMI works out to 25.8, pulse is 82 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.85,
      "end_seconds": 263.35,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.46,
      "end_seconds": 266.86,
      "duration_seconds": 2.4,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.19,
      "end_seconds": 271.17,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.68,
      "end_seconds": 278.65,
      "duration_seconds": 0.97,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.63,
      "end_seconds": 282.67,
      "duration_seconds": 2.04,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.09,
      "end_seconds": 303.78,
      "duration_seconds": 5.69,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.46,
      "end_seconds": 317.18,
      "duration_seconds": 8.72,
      "text": "That's the examination finished. I want a kidney ultrasound done, that's for kidney stones. Please come and see me after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.79,
      "end_seconds": 323.14,
      "duration_seconds": 5.35,
      "text": "sorry, what was I saying, I can manage that"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.18,
      "end_seconds": 329.91,
      "duration_seconds": 3.73,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.76,
      "end_seconds": 333.7,
      "duration_seconds": 1.94,
      "text": "thank you, that's helpful"
    }
  ]
