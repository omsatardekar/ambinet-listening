{
  "schema_version": "1.0",
  "encounter_id": "02655",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 5.08,
      "duration_seconds": 4.14,
      "text": "Hello, you know, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 11.53,
      "duration_seconds": 4.72,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.6,
      "end_seconds": 17.7,
      "duration_seconds": 5.1,
      "text": "I wanted to get a rolled ankle looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.45,
      "end_seconds": 21.11,
      "duration_seconds": 1.66,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.83,
      "end_seconds": 44.68,
      "duration_seconds": 21.85,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many. And there's bruising as well, three weeks now. I've also had some swelling, since Friday. About swelling, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.42,
      "end_seconds": 51.11,
      "duration_seconds": 5.69,
      "text": "have you noticed pain in the foot, numbness, pain in the shin or pop?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.6,
      "end_seconds": 55.38,
      "duration_seconds": 2.78,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.32,
      "end_seconds": 60.14,
      "duration_seconds": 2.82,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.0,
      "end_seconds": 66.43,
      "duration_seconds": 5.43,
      "text": "Sorry, what was I saying, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.1,
      "end_seconds": 70.58,
      "duration_seconds": 3.48,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.06,
      "end_seconds": 75.64,
      "duration_seconds": 3.58,
      "text": "No, you know, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.39,
      "end_seconds": 88.49,
      "duration_seconds": 2.1,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.01,
      "end_seconds": 96.74,
      "duration_seconds": 7.73,
      "text": "It's something called warf... warfarin, 3 milligrams, maybe, in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.8,
      "end_seconds": 100.74,
      "duration_seconds": 2.94,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.62,
      "end_seconds": 121.03,
      "duration_seconds": 18.41,
      "text": "sorry, what was I saying, not with me. I'll bring it next time. It's febuxostat, 80 milligrams, once a day. Though honestly, some days I forget to take it. Ibuprofen gel, three times a day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.07,
      "end_seconds": 126.35,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.8,
      "end_seconds": 133.15,
      "duration_seconds": 5.35,
      "text": "Yeah, you know, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.74,
      "end_seconds": 137.91,
      "duration_seconds": 3.17,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.0,
      "end_seconds": 141.29,
      "duration_seconds": 2.29,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.05,
      "end_seconds": 144.45,
      "duration_seconds": 1.4,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.49,
      "end_seconds": 146.59,
      "duration_seconds": 1.1,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.3,
      "end_seconds": 153.31,
      "duration_seconds": 6.01,
      "text": "Okay, I can see an irregular heartbeat in your file as well. What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.3,
      "end_seconds": 157.87,
      "duration_seconds": 3.57,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.16,
      "end_seconds": 160.53,
      "duration_seconds": 1.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.1,
      "end_seconds": 165.26,
      "duration_seconds": 4.16,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.01,
      "end_seconds": 168.65,
      "duration_seconds": 1.64,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.26,
      "end_seconds": 173.85,
      "duration_seconds": 4.59,
      "text": "I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.45,
      "end_seconds": 182.18,
      "duration_seconds": 3.73,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.15,
      "end_seconds": 187.51,
      "duration_seconds": 3.36,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.93,
      "end_seconds": 200.06,
      "duration_seconds": 5.13,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.9,
      "end_seconds": 204.43,
      "duration_seconds": 3.53,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.31,
      "end_seconds": 207.65,
      "duration_seconds": 2.34,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.38,
      "end_seconds": 222.84,
      "duration_seconds": 2.46,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.47,
      "end_seconds": 252.13,
      "duration_seconds": 8.66,
      "text": "Okay: temp 36.9 degrees, BP is 119 over 79, SpO2 98 percent on room air. And pulse 80."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.36,
      "end_seconds": 259.44,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.22,
      "end_seconds": 263.96,
      "duration_seconds": 2.74,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.67,
      "end_seconds": 270.96,
      "duration_seconds": 5.29,
      "text": "Right, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.03,
      "end_seconds": 274.97,
      "duration_seconds": 2.94,
      "text": "Alright, tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.98,
      "end_seconds": 293.27,
      "duration_seconds": 7.29,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.04,
      "end_seconds": 301.31,
      "duration_seconds": 2.27,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.23,
      "end_seconds": 313.05,
      "duration_seconds": 3.82,
      "text": "Rest, ice, compression and elevation, then gradual strengthening."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.37,
      "end_seconds": 335.9,
      "duration_seconds": 22.53,
      "text": "Okay, go on. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me if not better in two weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.97,
      "end_seconds": 343.63,
      "duration_seconds": 6.66,
      "text": "so, I come back if not better in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.52,
      "end_seconds": 350.75,
      "duration_seconds": 5.23,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.79,
      "end_seconds": 354.78,
      "duration_seconds": 1.99,
      "text": "Thank you, that's helpful."
    }
  ]
}