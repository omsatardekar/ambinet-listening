{
  "schema_version": "1.0",
  "encounter_id": "02803",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.2,
      "duration_seconds": 3.59,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.96,
      "end_seconds": 10.57,
      "duration_seconds": 4.61,
      "text": "okay, no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.07,
      "end_seconds": 17.46,
      "duration_seconds": 5.39,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.54,
      "end_seconds": 27.17,
      "duration_seconds": 7.63,
      "text": "Honestly, uh, it's being very confused, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.82,
      "end_seconds": 31.26,
      "duration_seconds": 3.44,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.63,
      "end_seconds": 42.98,
      "duration_seconds": 10.35,
      "text": "I take allopurinol, 100 milligrams, once a day. I had febuxostat at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.74,
      "end_seconds": 48.42,
      "duration_seconds": 3.68,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.32,
      "end_seconds": 57.7,
      "duration_seconds": 3.38,
      "text": "I've had it for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.75,
      "end_seconds": 62.4,
      "duration_seconds": 3.65,
      "text": "Right, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.01,
      "end_seconds": 67.51,
      "duration_seconds": 3.5,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.66,
      "end_seconds": 74.1,
      "duration_seconds": 2.44,
      "text": "Any bone pain as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.75,
      "end_seconds": 78.32,
      "duration_seconds": 3.57,
      "text": "yes, um, for about a week"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.13,
      "end_seconds": 91.09,
      "duration_seconds": 3.96,
      "text": "Any fall, fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.95,
      "end_seconds": 97.78,
      "duration_seconds": 4.83,
      "text": "Sorry, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.96,
      "end_seconds": 102.34,
      "duration_seconds": 3.38,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.28,
      "end_seconds": 107.4,
      "duration_seconds": 3.12,
      "text": "uh, no, that's been fine"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.35,
      "end_seconds": 110.32,
      "duration_seconds": 1.97,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 111.78,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.87,
      "end_seconds": 117.52,
      "duration_seconds": 4.65,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 124.13,
      "duration_seconds": 1.95,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.68,
      "end_seconds": 140.91,
      "duration_seconds": 4.23,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.74,
      "end_seconds": 145.44,
      "duration_seconds": 3.7,
      "text": "yes, erythromycin. I get bad stomach cramps"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.37,
      "end_seconds": 149.83,
      "duration_seconds": 3.46,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.74,
      "end_seconds": 154.02,
      "duration_seconds": 3.28,
      "text": "I have gout, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.77,
      "end_seconds": 163.85,
      "duration_seconds": 8.08,
      "text": "Okay, I can see gout in your file as well. What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.41,
      "end_seconds": 169.18,
      "duration_seconds": 3.77,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.97,
      "end_seconds": 176.57,
      "duration_seconds": 1.6,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.34,
      "end_seconds": 181.47,
      "duration_seconds": 3.13,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 186.79,
      "duration_seconds": 3.25,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.47,
      "end_seconds": 191.33,
      "duration_seconds": 3.86,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.41,
      "end_seconds": 209.04,
      "duration_seconds": 2.63,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.12,
      "end_seconds": 224.19,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.37,
      "end_seconds": 253.64,
      "duration_seconds": 8.27,
      "text": "Okay: temperature 36.5, respiratory rate 17, SpO2 99 percent on room air, pulse 96, blood pressure 99 over 57."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.84,
      "end_seconds": 256.42,
      "duration_seconds": 1.58,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.25,
      "end_seconds": 259.94,
      "duration_seconds": 2.69,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.75,
      "end_seconds": 266.62,
      "duration_seconds": 4.87,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.95,
      "end_seconds": 270.79,
      "duration_seconds": 2.84,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.64,
      "end_seconds": 295.73,
      "duration_seconds": 6.09,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.79,
      "end_seconds": 313.04,
      "duration_seconds": 14.25,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: It fits best with a high calcium emergency. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.79,
      "end_seconds": 317.1,
      "duration_seconds": 2.31,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.13,
      "end_seconds": 352.73,
      "duration_seconds": 33.6,
      "text": "I understand the worry. At the moment I'd say it's a high calcium emergency, and we'll know more once the urgent blood tests is back. urgent blood tests is what I'd like next, for confusion and polyuria. That will help us see what's going on underneath and decide the next step. We should do an ECG for hypercalcaemia. Let's use sodium chloride 0.9%, 1 litre, over one hour, single dose. That's for dehydration."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.3,
      "end_seconds": 360.57,
      "duration_seconds": 6.27,
      "text": "you need hospital fluids and and treatment now we'll refer you to the emergency team"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.28,
      "end_seconds": 362.98,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.13,
      "end_seconds": 372.53,
      "duration_seconds": 8.4,
      "text": "keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.08,
      "end_seconds": 374.56,
      "duration_seconds": 1.48,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.58,
      "end_seconds": 381.71,
      "duration_seconds": 5.13,
      "text": "See me again straight away. Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.76,
      "end_seconds": 386.13,
      "duration_seconds": 3.37,
      "text": "I think I understand everything. Thanks"
    }
  ]
}