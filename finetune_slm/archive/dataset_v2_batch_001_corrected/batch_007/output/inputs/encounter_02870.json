{
  "schema_version": "1.0",
  "encounter_id": "02870",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 5.96,
      "duration_seconds": 5.18,
      "text": "okay, um, so sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.41,
      "end_seconds": 11.46,
      "duration_seconds": 4.05,
      "text": "that's fine, sit down. Tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.26,
      "end_seconds": 17.85,
      "duration_seconds": 4.59,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.89,
      "end_seconds": 22.77,
      "duration_seconds": 3.88,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.62,
      "end_seconds": 28.97,
      "duration_seconds": 5.35,
      "text": "Doctor, it's aching all over. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.87,
      "end_seconds": 35.76,
      "duration_seconds": 4.89,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.34,
      "end_seconds": 51.11,
      "duration_seconds": 14.77,
      "text": "It's on and off. I notice it more with cold weather and stress. Only heat, and it's not much. Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.62,
      "end_seconds": 54.71,
      "duration_seconds": 3.09,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.41,
      "end_seconds": 59.81,
      "duration_seconds": 3.4,
      "text": "It usually comes with tender spots."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.22,
      "end_seconds": 67.26,
      "duration_seconds": 7.04,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 67.36,
      "end_seconds": 73.35,
      "duration_seconds": 5.99,
      "text": "Oh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.29,
      "end_seconds": 88.5,
      "duration_seconds": 12.21,
      "text": "I was getting to that! And I've been waking unrefreshed as well, um, for two months the tender spots? That's been for about four days"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.15,
      "end_seconds": 93.21,
      "duration_seconds": 3.06,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.24,
      "end_seconds": 97.53,
      "duration_seconds": 3.29,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 98.51,
      "end_seconds": 101.58,
      "duration_seconds": 3.07,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.27,
      "end_seconds": 105.64,
      "duration_seconds": 2.37,
      "text": "has there been any rash?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.63,
      "end_seconds": 108.27,
      "duration_seconds": 1.64,
      "text": "Definitely no rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.71,
      "end_seconds": 114.86,
      "duration_seconds": 6.15,
      "text": "I follow let me check a few things any fever, weight loss or joint swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.36,
      "end_seconds": 132.28,
      "duration_seconds": 13.92,
      "text": "No, uh, no fever, no weight loss, no joint swelling. I did have poor concentration at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.1,
      "end_seconds": 136.86,
      "duration_seconds": 2.76,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.94,
      "end_seconds": 139.41,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.72,
      "end_seconds": 143.45,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 153.25,
      "duration_seconds": 8.43,
      "text": "I take metoprolol, 50 milligrams, twice a day. Ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.07,
      "end_seconds": 158.3,
      "duration_seconds": 4.23,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.11,
      "end_seconds": 166.4,
      "duration_seconds": 6.29,
      "text": "No, it's at home. Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 169.6,
      "end_seconds": 176.94,
      "duration_seconds": 7.34,
      "text": "That's what's prescribed, uh, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.12,
      "end_seconds": 181.09,
      "duration_seconds": 2.97,
      "text": "Paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.59,
      "end_seconds": 186.86,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.19,
      "end_seconds": 192.5,
      "duration_seconds": 4.31,
      "text": "nothing, um, I haven't had any operations"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 197.45,
      "duration_seconds": 3.72,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.52,
      "end_seconds": 204.14,
      "duration_seconds": 4.62,
      "text": "My mother had a stroke. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.66,
      "end_seconds": 209.35,
      "duration_seconds": 3.69,
      "text": "So, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.57,
      "end_seconds": 215.02,
      "duration_seconds": 4.45,
      "text": "Hmm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.4,
      "end_seconds": 220.03,
      "duration_seconds": 3.63,
      "text": "Right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.79,
      "end_seconds": 227.68,
      "duration_seconds": 5.89,
      "text": "Yes, an irregular heartbeat. High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.81,
      "end_seconds": 229.64,
      "duration_seconds": 0.83,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.25,
      "end_seconds": 235.9,
      "duration_seconds": 1.65,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 237.39,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.37,
      "end_seconds": 242.3,
      "duration_seconds": 2.93,
      "text": "I have anxiety, for five years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.15,
      "end_seconds": 254.13,
      "duration_seconds": 10.98,
      "text": "Okay, I can see gout and anxiety in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.04,
      "end_seconds": 269.74,
      "duration_seconds": 13.7,
      "text": "I'll have a glass of wine with dinner. I quit smoking around ten years ago. I swim twice a week. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.87,
      "end_seconds": 275.28,
      "duration_seconds": 4.41,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.95,
      "end_seconds": 290.22,
      "duration_seconds": 3.27,
      "text": "That's it, just a a little longer..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.74,
      "end_seconds": 308.76,
      "duration_seconds": 6.02,
      "text": "Okay: SpO2 98 percent on room air, blood pressure 109 over 71, pulse 73."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.95,
      "end_seconds": 314.08,
      "duration_seconds": 4.13,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.43,
      "end_seconds": 331.02,
      "duration_seconds": 1.59,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.7,
      "end_seconds": 334.89,
      "duration_seconds": 2.19,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.46,
      "end_seconds": 357.76,
      "duration_seconds": 5.3,
      "text": "Your joints are not swollen and you are tender over many muscle points."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.59,
      "end_seconds": 364.24,
      "duration_seconds": 2.65,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.44,
      "end_seconds": 401.63,
      "duration_seconds": 22.19,
      "text": "I'm going to order blood tests, for widespread pain. I'll start you on amitriptyline, 10 milligrams, at night, long term. It's for pain and sleep. Gentle graded exercise such as swimming helps more than rest. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.37,
      "end_seconds": 405.89,
      "duration_seconds": 2.52,
      "text": "Yes, uh, will do."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.84,
      "end_seconds": 412.9,
      "duration_seconds": 6.06,
      "text": "I'll want another look in six weeks have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.94,
      "end_seconds": 419.19,
      "duration_seconds": 2.25,
      "text": "Alright, thanks, take care."
    }
  ]
}