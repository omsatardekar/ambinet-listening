{
  "schema_version": "1.0",
  "encounter_id": "02743",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.04,
      "end_seconds": 5.0,
      "duration_seconds": 3.96,
      "text": "morning, doctor i've settled them in, ready when you are"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 9.73,
      "duration_seconds": 3.49,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 19.42,
      "duration_seconds": 7.74,
      "text": "Mm, honestly, it's aching bones, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.1,
      "end_seconds": 23.04,
      "duration_seconds": 2.94,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.32,
      "end_seconds": 35.37,
      "duration_seconds": 11.05,
      "text": "It's escitalopram, 10 milligrams, once a day for the anxiety. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.92,
      "end_seconds": 43.46,
      "duration_seconds": 4.54,
      "text": "alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.6,
      "end_seconds": 47.18,
      "duration_seconds": 2.58,
      "text": "For six months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.52,
      "end_seconds": 51.41,
      "duration_seconds": 2.89,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.63,
      "end_seconds": 57.68,
      "duration_seconds": 5.05,
      "text": "It's, It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.03,
      "end_seconds": 60.82,
      "duration_seconds": 1.79,
      "text": "Have you had constipation?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.9,
      "end_seconds": 63.59,
      "duration_seconds": 1.69,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.9,
      "end_seconds": 68.26,
      "duration_seconds": 3.36,
      "text": "What about being thirsty, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.26,
      "end_seconds": 73.7,
      "duration_seconds": 4.44,
      "text": "mm, yes. With being thirsty, mostly mild"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 80.29,
      "duration_seconds": 5.03,
      "text": "Have you had aching bones before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.2,
      "end_seconds": 89.74,
      "duration_seconds": 7.54,
      "text": "a bit, a couple of years ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.53,
      "end_seconds": 95.27,
      "duration_seconds": 3.74,
      "text": "any weight loss, low mood or fever at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.59,
      "end_seconds": 101.76,
      "duration_seconds": 5.17,
      "text": "Right, you know, no, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.75,
      "end_seconds": 105.64,
      "duration_seconds": 1.89,
      "text": "any sign of fractures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.93,
      "end_seconds": 109.54,
      "duration_seconds": 2.61,
      "text": "No, none, no fractures."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.43,
      "end_seconds": 112.4,
      "duration_seconds": 1.97,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.47,
      "end_seconds": 116.98,
      "duration_seconds": 2.51,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.81,
      "end_seconds": 123.56,
      "duration_seconds": 4.75,
      "text": "Right, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.68,
      "end_seconds": 127.55,
      "duration_seconds": 2.87,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.51,
      "end_seconds": 149.55,
      "duration_seconds": 8.04,
      "text": "has anything ever caused you a reaction? I mean any allergies just so I get the full picture"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.63,
      "end_seconds": 154.82,
      "duration_seconds": 4.19,
      "text": "No, you know, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.67,
      "end_seconds": 167.79,
      "duration_seconds": 3.12,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.56,
      "end_seconds": 176.28,
      "duration_seconds": 6.72,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.12,
      "end_seconds": 182.07,
      "duration_seconds": 4.95,
      "text": "So, what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.65,
      "end_seconds": 198.88,
      "duration_seconds": 15.23,
      "text": "I have anxiety, for about ten years. Yes, asthma. It's a relief to finally sit down and talk about it. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.99,
      "end_seconds": 208.09,
      "duration_seconds": 8.1,
      "text": "ah. Alright, anxiety and asthma, that matches what I have here. What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.72,
      "end_seconds": 213.15,
      "duration_seconds": 4.43,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.6,
      "end_seconds": 216.05,
      "duration_seconds": 1.45,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.18,
      "end_seconds": 220.16,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.75,
      "end_seconds": 224.82,
      "duration_seconds": 3.07,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.28,
      "end_seconds": 229.69,
      "duration_seconds": 3.41,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 240.67,
      "end_seconds": 254.34,
      "duration_seconds": 13.67,
      "text": "Here are the numbers, doctor. Blood pressure 126 over 73, BMI works out to 31.2, weight 77 kilos, height 157 centimetres, SpO2 99 percent on room air, pulse 76, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.24,
      "end_seconds": 256.32,
      "duration_seconds": 1.08,
      "text": "Alright, thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.52,
      "end_seconds": 262.58,
      "duration_seconds": 5.06,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.84,
      "end_seconds": 264.82,
      "duration_seconds": 0.98,
      "text": "of course"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.54,
      "end_seconds": 268.87,
      "duration_seconds": 2.33,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.04,
      "end_seconds": 283.69,
      "duration_seconds": 5.65,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.17,
      "end_seconds": 300.42,
      "duration_seconds": 11.25,
      "text": "okay, that's enough for me putting it all together, I'd lean towards possible raised calcium from an overactive parathyroid. Vitamin D excess is also on my list"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.82,
      "end_seconds": 305.09,
      "duration_seconds": 3.27,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.1,
      "end_seconds": 325.39,
      "duration_seconds": 18.29,
      "text": "I understand the worry at the moment I'd say it's possible raised calcium from an overactive parathyroid, and we'll watch how it goes i'll also refer you to the endocrine clinic do get help quickly if the symptoms get worse does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 327.26,
      "end_seconds": 330.48,
      "duration_seconds": 3.22,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.24,
      "end_seconds": 333.2,
      "duration_seconds": 1.96,
      "text": "Have a good day."
    }
  ]
}