    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.22,
      "end_seconds": 50.27,
      "duration_seconds": 6.05,
      "text": "and what about black stools, change in bowel habit, tummy pain or weight loss?"
