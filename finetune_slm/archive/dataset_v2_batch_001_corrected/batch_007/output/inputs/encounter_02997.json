      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.15,
      "end_seconds": 116.8,
      "duration_seconds": 3.65,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.13,
      "end_seconds": 120.63,
      "duration_seconds": 2.5,
      "text": "Well, no allergies at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.5,
      "end_seconds": 123.76,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.42,
      "end_seconds": 127.19,
      "duration_seconds": 2.77,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 132.15,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.43,
      "end_seconds": 136.64,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.43,
      "end_seconds": 155.4,
      "duration_seconds": 3.97,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.03,
      "end_seconds": 159.44,
      "duration_seconds": 2.41,
      "text": "Epilepsy, for about a year."
