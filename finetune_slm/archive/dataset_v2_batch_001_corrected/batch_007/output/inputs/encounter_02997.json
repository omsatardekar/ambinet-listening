    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.73,
      "end_seconds": 164.42,
      "duration_seconds": 3.69,
      "text": "mm-hmm time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.07,
      "end_seconds": 179.64,
      "duration_seconds": 2.57,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.5,
      "end_seconds": 210.58,
      "duration_seconds": 10.08,
      "text": "okay: pressure 128 over 75, temperature 37.0, heart rate 73. And oxygen saturation is 99 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.48,
      "end_seconds": 216.0,
      "duration_seconds": 3.52,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.23,
      "end_seconds": 218.44,
      "duration_seconds": 1.21,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.42,
      "end_seconds": 235.54,
      "duration_seconds": 8.12,
      "text": "There is a soft swelling at the edge of the back passage and a non-tender rectum with no mass."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.0,
      "end_seconds": 241.81,
      "duration_seconds": 2.81,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 284.96,
      "duration_seconds": 24.64,
      "text": "Having listened and examined, this looks most like haemorrhoids. I want to be honest that this is an impression, not a final answer. I'm sending you for a blood count because of rectal bleeding. For this, lactulose, 15 ml, twice a day, four weeks. You take it by mouth. That should help with constipation."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.78,
      "end_seconds": 288.99,
      "duration_seconds": 3.21,
      "text": "is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.91,
      "end_seconds": 304.87,
      "duration_seconds": 14.96,
      "text": "eat more fibre and drink water avoid taking any extra painkillers on top of what I'm prescribing without checking with us i'd like you back in four weeks have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.87,
      "end_seconds": 309.82,
      "duration_seconds": 2.95,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0036",
