      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.9,
      "end_seconds": 102.83,
      "duration_seconds": 10.93,
      "text": "Mm, I take sodium valproate, 500 milligrams, twice a day for the fits. It's the not knowing that gets to me."
