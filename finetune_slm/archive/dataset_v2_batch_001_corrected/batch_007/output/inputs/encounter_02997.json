      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.03,
      "end_seconds": 59.86,
      "duration_seconds": 8.83,
      "text": "I haven't had black stools, change in bowel habit, tummy pain or weight loss, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.3,
      "end_seconds": 64.27,
      "duration_seconds": 3.97,
      "text": "Mm-hmm. And And your skin, any changes there?"
