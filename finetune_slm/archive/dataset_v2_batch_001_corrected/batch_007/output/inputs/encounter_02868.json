{
  "schema_version": "1.0",
  "encounter_id": "02868",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.58,
      "duration_seconds": 4.74,
      "text": "I mean, good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 10.43,
      "duration_seconds": 3.88,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.23,
      "end_seconds": 18.28,
      "duration_seconds": 6.05,
      "text": "Oh, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.69,
      "end_seconds": 23.26,
      "duration_seconds": 3.57,
      "text": "good, that'll be useful pull up a chair"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.68,
      "end_seconds": 36.99,
      "duration_seconds": 12.31,
      "text": "Yeah, it's a chesty cough for a week. I don't know what's causing it. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.95,
      "end_seconds": 41.78,
      "duration_seconds": 2.83,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.44,
      "end_seconds": 46.18,
      "duration_seconds": 3.74,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.14,
      "end_seconds": 51.44,
      "duration_seconds": 3.3,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.29,
      "end_seconds": 56.66,
      "duration_seconds": 4.37,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.94,
      "end_seconds": 57.64,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.38,
      "end_seconds": 65.59,
      "duration_seconds": 7.21,
      "text": "Actually, um, and there's slight aching as well, six months now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.69,
      "end_seconds": 70.08,
      "duration_seconds": 3.39,
      "text": "Has there been a sore throat earlier too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.93,
      "end_seconds": 78.74,
      "duration_seconds": 7.81,
      "text": "Yes, about the same, six months. With sore throat earlier, mild, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.04,
      "end_seconds": 82.87,
      "duration_seconds": 2.83,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.0,
      "end_seconds": 97.59,
      "duration_seconds": 2.59,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.62,
      "end_seconds": 120.48,
      "duration_seconds": 7.86,
      "text": "Okay: pressure 126 over 76, pulse 70, respiratory rate 15, saturation 98 percent, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.32,
      "end_seconds": 123.8,
      "duration_seconds": 2.48,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.47,
      "end_seconds": 126.8,
      "duration_seconds": 2.33,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.24,
      "end_seconds": 133.26,
      "duration_seconds": 5.02,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.99,
      "end_seconds": 137.24,
      "duration_seconds": 2.25,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.45,
      "end_seconds": 148.37,
      "duration_seconds": 3.92,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.5,
      "end_seconds": 153.45,
      "duration_seconds": 1.95,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.97,
      "end_seconds": 166.52,
      "duration_seconds": 2.55,
      "text": "have you had any chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.96,
      "end_seconds": 171.67,
      "duration_seconds": 3.71,
      "text": "No, um, none, no chest pain."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.21,
      "end_seconds": 177.68,
      "duration_seconds": 4.47,
      "text": "Any breathlessness, coughing up blood or fever at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.59,
      "end_seconds": 183.31,
      "duration_seconds": 3.72,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.98,
      "end_seconds": 188.25,
      "duration_seconds": 4.27,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.43,
      "end_seconds": 191.94,
      "duration_seconds": 2.51,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.26,
      "end_seconds": 194.69,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.52,
      "end_seconds": 196.83,
      "duration_seconds": 1.31,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.47,
      "end_seconds": 213.76,
      "duration_seconds": 4.29,
      "text": "Right, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.39,
      "end_seconds": 217.05,
      "duration_seconds": 2.66,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.64,
      "end_seconds": 220.45,
      "duration_seconds": 1.81,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.48,
      "end_seconds": 224.06,
      "duration_seconds": 1.58,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.16,
      "end_seconds": 228.05,
      "duration_seconds": 2.89,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.7,
      "end_seconds": 231.99,
      "duration_seconds": 3.29,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.42,
      "end_seconds": 236.21,
      "duration_seconds": 2.79,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.37,
      "end_seconds": 241.73,
      "duration_seconds": 4.36,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.47,
      "end_seconds": 261.56,
      "duration_seconds": 2.09,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.7,
      "end_seconds": 271.29,
      "duration_seconds": 4.59,
      "text": "Omeprazole. I take it 20 milligrams, once a day"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.18,
      "end_seconds": 275.86,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.83,
      "end_seconds": 284.94,
      "duration_seconds": 6.11,
      "text": "yeah, uh, I've had acid reflux for about ten years now"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.87,
      "end_seconds": 310.3,
      "duration_seconds": 24.43,
      "text": "Okay, I can see acid reflux in your file as well. So where does that leave us? This is probably acute viral bronchitis. The reason I say that is that your story and my examination fit together. Today I'm not changing anything. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.68,
      "end_seconds": 313.64,
      "duration_seconds": 1.96,
      "text": "That's clear, thanks."
    }
  ]
}