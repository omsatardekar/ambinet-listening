{
  "schema_version": "1.0",
  "encounter_id": "02767",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.35,
      "end_seconds": 7.6,
      "duration_seconds": 6.25,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.36,
      "end_seconds": 12.9,
      "duration_seconds": 4.54,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.52,
      "end_seconds": 19.96,
      "duration_seconds": 6.44,
      "text": "Honestly, it's a sudden high fever, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 24.41,
      "end_seconds": 31.73,
      "duration_seconds": 7.32,
      "text": "Doctor, I've got the readings for you. Temperature 36.8, pulse 94, blood pressure 104 over 62."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.26,
      "end_seconds": 37.51,
      "duration_seconds": 4.25,
      "text": "Good, thank you. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.2,
      "end_seconds": 41.52,
      "duration_seconds": 2.32,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.09,
      "end_seconds": 45.13,
      "duration_seconds": 3.04,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.11,
      "end_seconds": 51.92,
      "duration_seconds": 5.81,
      "text": "Vomiting and diarrhoea goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.47,
      "end_seconds": 57.42,
      "duration_seconds": 4.95,
      "text": "What about a widespread sunburn-like rash, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.45,
      "end_seconds": 65.66,
      "duration_seconds": 7.21,
      "text": "Yeah. Two days, I'd say. The, The vomiting and diarrhoea? That's been since last night."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.14,
      "end_seconds": 72.97,
      "duration_seconds": 5.83,
      "text": "Have you had a sudden high fever before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.89,
      "end_seconds": 80.76,
      "duration_seconds": 6.87,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.79,
      "end_seconds": 95.52,
      "duration_seconds": 1.73,
      "text": "What about sore throat?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.02,
      "end_seconds": 101.06,
      "duration_seconds": 2.04,
      "text": "No, no sore throat."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.91,
      "end_seconds": 105.9,
      "duration_seconds": 2.99,
      "text": "And what about cough or stiff neck?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.31,
      "end_seconds": 111.03,
      "duration_seconds": 3.72,
      "text": "No cough or stiff neck, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.77,
      "end_seconds": 116.06,
      "duration_seconds": 3.29,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.58,
      "end_seconds": 118.58,
      "duration_seconds": 2.0,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.16,
      "end_seconds": 122.88,
      "duration_seconds": 3.72,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.72,
      "end_seconds": 126.58,
      "duration_seconds": 2.86,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.75,
      "end_seconds": 146.71,
      "duration_seconds": 2.96,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.76,
      "end_seconds": 165.46,
      "duration_seconds": 17.7,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I grab fast food at lunch most days. I swim twice a week. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.29,
      "end_seconds": 176.07,
      "duration_seconds": 2.78,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.11,
      "end_seconds": 180.12,
      "duration_seconds": 2.01,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.59,
      "end_seconds": 184.59,
      "duration_seconds": 3.0,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.32,
      "end_seconds": 188.62,
      "duration_seconds": 3.3,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.22,
      "end_seconds": 197.83,
      "duration_seconds": 7.61,
      "text": "Alright, arthritis in your knees, that matches what I have here. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.44,
      "end_seconds": 206.68,
      "duration_seconds": 7.24,
      "text": "Sorry, what was I saying, just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.47,
      "end_seconds": 209.53,
      "duration_seconds": 2.06,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.14,
      "end_seconds": 212.49,
      "duration_seconds": 2.35,
      "text": "It's a tampon, in use."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.54,
      "end_seconds": 217.58,
      "duration_seconds": 3.04,
      "text": "Alright, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.59,
      "end_seconds": 224.04,
      "duration_seconds": 1.45,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.85,
      "end_seconds": 231.17,
      "duration_seconds": 4.32,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.47,
      "end_seconds": 235.31,
      "duration_seconds": 2.84,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.64,
      "end_seconds": 259.13,
      "duration_seconds": 10.49,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.26,
      "end_seconds": 286.83,
      "duration_seconds": 25.57,
      "text": "Okay, that's enough for me. Okay, so my impression is this: This looks most like possible toxic shock syndrome. That's my thinking for now, and it may change as we learn more. I want a vaginal swab done, that's for possible toxic shock. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.38,
      "end_seconds": 290.63,
      "duration_seconds": 2.25,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.96,
      "end_seconds": 296.5,
      "duration_seconds": 4.54,
      "text": "Blood cultures is what I'd like next, for possible toxic shock."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.67,
      "end_seconds": 304.12,
      "duration_seconds": 3.45,
      "text": "Oh, do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.36,
      "end_seconds": 324.59,
      "duration_seconds": 19.23,
      "text": "What I'm giving you is flucloxacillin, 2 grams, now, single dose. It's for possible toxic shock syndrome. Remove any tampon, you are going to hospital now. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.43,
      "end_seconds": 328.44,
      "duration_seconds": 3.01,
      "text": "Thank you, uh, that's clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.52,
      "end_seconds": 337.05,
      "duration_seconds": 6.53,
      "text": "We'll catch up straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.02,
      "end_seconds": 346.49,
      "duration_seconds": 8.47,
      "text": "So, I take the flucloxacillin, 2 grams, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.69,
      "end_seconds": 355.94,
      "duration_seconds": 5.25,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.8,
      "end_seconds": 358.91,
      "duration_seconds": 2.11,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.78,
      "end_seconds": 361.67,
      "duration_seconds": 1.89,
      "text": "Alright, look after yourself."
    }
  ]
}