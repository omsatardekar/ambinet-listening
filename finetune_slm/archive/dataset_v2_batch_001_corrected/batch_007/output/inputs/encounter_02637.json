{
  "schema_version": "1.0",
  "encounter_id": "02637",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 8.03,
      "duration_seconds": 6.7,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.61,
      "end_seconds": 14.48,
      "duration_seconds": 4.87,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.28,
      "end_seconds": 19.53,
      "duration_seconds": 4.25,
      "text": "I wanted to get a rolled ankle looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.12,
      "end_seconds": 24.24,
      "duration_seconds": 3.12,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.19,
      "end_seconds": 33.63,
      "duration_seconds": 2.44,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.07,
      "end_seconds": 53.77,
      "duration_seconds": 3.7,
      "text": "Okay: heart rate 72, BP is 122 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.94,
      "end_seconds": 74.34,
      "duration_seconds": 3.4,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.98,
      "end_seconds": 77.8,
      "duration_seconds": 2.82,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.53,
      "end_seconds": 81.43,
      "duration_seconds": 2.9,
      "text": "Okay, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.0,
      "end_seconds": 94.91,
      "duration_seconds": 9.91,
      "text": "Bruising goes along with it, most of the time. Erm, um, I've had some swelling too, for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.68,
      "end_seconds": 99.23,
      "duration_seconds": 2.55,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.98,
      "end_seconds": 104.51,
      "duration_seconds": 1.53,
      "text": "I'd say moderate"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.15,
      "end_seconds": 111.64,
      "duration_seconds": 2.49,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.63,
      "end_seconds": 119.17,
      "duration_seconds": 3.54,
      "text": "it happens once or twice a day"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.87,
      "end_seconds": 125.04,
      "duration_seconds": 4.17,
      "text": "a few quick ones: numbness or pain in the shin?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.7,
      "end_seconds": 133.55,
      "duration_seconds": 2.85,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.41,
      "end_seconds": 138.15,
      "duration_seconds": 3.74,
      "text": "any pain in the foot or pop at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.38,
      "end_seconds": 144.54,
      "duration_seconds": 5.16,
      "text": "I haven't had pain in the foot or pop, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.54,
      "end_seconds": 147.88,
      "duration_seconds": 2.34,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.51,
      "end_seconds": 151.4,
      "duration_seconds": 2.89,
      "text": "so, no problems with breathing"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.37,
      "end_seconds": 155.44,
      "duration_seconds": 3.07,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 178.27,
      "duration_seconds": 21.28,
      "text": "Hmm, you know, I have heart failure, for about a year. I told my wife I'd come today. I, I have COPD, for about a year. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.98,
      "end_seconds": 186.24,
      "duration_seconds": 7.26,
      "text": "right, so so heart failure is already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.82,
      "end_seconds": 198.11,
      "duration_seconds": 3.29,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.13,
      "end_seconds": 206.94,
      "duration_seconds": 7.81,
      "text": "I'm on Tiotropium inhaler, once a day. It's ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.56,
      "end_seconds": 212.36,
      "duration_seconds": 4.8,
      "text": "okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.84,
      "end_seconds": 216.68,
      "duration_seconds": 2.84,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.52,
      "end_seconds": 222.01,
      "duration_seconds": 4.49,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.69,
      "end_seconds": 225.21,
      "duration_seconds": 2.52,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.86,
      "end_seconds": 238.61,
      "duration_seconds": 2.75,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.13,
      "end_seconds": 245.64,
      "duration_seconds": 6.51,
      "text": "Um, I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.26,
      "end_seconds": 247.92,
      "duration_seconds": 1.66,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.91,
      "end_seconds": 252.52,
      "duration_seconds": 1.61,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.98,
      "end_seconds": 256.85,
      "duration_seconds": 2.87,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.49,
      "end_seconds": 262.14,
      "duration_seconds": 4.65,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.68,
      "end_seconds": 266.57,
      "duration_seconds": 2.89,
      "text": "Okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.69,
      "end_seconds": 270.05,
      "duration_seconds": 2.36,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.41,
      "end_seconds": 276.42,
      "duration_seconds": 5.01,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.08,
      "end_seconds": 277.78,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.74,
      "end_seconds": 281.71,
      "duration_seconds": 1.97,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.35,
      "end_seconds": 297.56,
      "duration_seconds": 7.21,
      "text": "there is mild swelling over the outer ankle but no bony tenderness and you can take four steps"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.5,
      "end_seconds": 308.22,
      "duration_seconds": 6.72,
      "text": "You can sit up now. Having listened and examined, it points towards a mild ankle sprain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.82,
      "end_seconds": 313.12,
      "duration_seconds": 3.3,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.47,
      "end_seconds": 343.3,
      "duration_seconds": 25.83,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild ankle sprain. Rest, ice, compression and elevation, then gradual strengthening. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check if not better in two weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 344.88,
      "end_seconds": 348.29,
      "duration_seconds": 3.41,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.72,
      "end_seconds": 352.95,
      "duration_seconds": 3.23,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.27,
      "end_seconds": 360.71,
      "duration_seconds": 2.44,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.29,
      "end_seconds": 362.6,
      "duration_seconds": 1.31,
      "text": "Goodbye for now."
    }
  ]
}