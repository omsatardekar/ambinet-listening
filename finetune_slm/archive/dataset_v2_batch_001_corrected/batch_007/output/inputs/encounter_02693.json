{
  "schema_version": "1.0",
  "encounter_id": "02693",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 3.84,
      "duration_seconds": 2.93,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.27,
      "end_seconds": 8.24,
      "duration_seconds": 0.97,
      "text": "hi there"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.97,
      "end_seconds": 14.15,
      "duration_seconds": 2.18,
      "text": "Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.4,
      "end_seconds": 20.3,
      "duration_seconds": 4.9,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.66,
      "end_seconds": 23.07,
      "duration_seconds": 1.41,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.61,
      "end_seconds": 28.5,
      "duration_seconds": 3.89,
      "text": "Well, I've been having my heart suddenly racing."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.37,
      "end_seconds": 33.72,
      "duration_seconds": 3.35,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.27,
      "end_seconds": 38.19,
      "duration_seconds": 3.92,
      "text": "It's been going on for five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.44,
      "end_seconds": 42.05,
      "duration_seconds": 2.61,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.03,
      "end_seconds": 49.16,
      "duration_seconds": 5.13,
      "text": "I get some relief from cold water on the face."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.77,
      "end_seconds": 54.29,
      "duration_seconds": 3.52,
      "text": "Any a pounding in your neck as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.7,
      "end_seconds": 59.01,
      "duration_seconds": 3.31,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.82,
      "end_seconds": 64.78,
      "duration_seconds": 3.96,
      "text": "so, have you had it stopping just as suddenly?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.1,
      "end_seconds": 78.46,
      "duration_seconds": 12.36,
      "text": "yeah, that too i've also been feeling lightheaded during an episode, for two days as for feeling lightheaded during an episode, I'd call it moderate"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.36,
      "end_seconds": 87.83,
      "duration_seconds": 7.47,
      "text": "Have you had your heart suddenly racing before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.92,
      "end_seconds": 95.76,
      "duration_seconds": 5.84,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.87,
      "end_seconds": 102.46,
      "duration_seconds": 5.59,
      "text": "Any breathlessness, family history of sudden death, fainting or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.27,
      "end_seconds": 105.28,
      "duration_seconds": 2.01,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.91,
      "end_seconds": 109.02,
      "duration_seconds": 2.11,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.54,
      "end_seconds": 112.47,
      "duration_seconds": 2.93,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.45,
      "end_seconds": 115.82,
      "duration_seconds": 2.37,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.8,
      "end_seconds": 120.65,
      "duration_seconds": 2.85,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.83,
      "end_seconds": 138.97,
      "duration_seconds": 4.14,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.93,
      "end_seconds": 153.11,
      "duration_seconds": 13.18,
      "text": "I'm a plumber, lots of bending and kneeling. No, I share a house with my brother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.76,
      "end_seconds": 157.66,
      "duration_seconds": 2.9,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.17,
      "end_seconds": 163.73,
      "duration_seconds": 4.56,
      "text": "I have acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.25,
      "end_seconds": 167.73,
      "duration_seconds": 3.48,
      "text": "alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.81,
      "end_seconds": 175.43,
      "duration_seconds": 5.62,
      "text": "I had omeprazole at one point, but I'm off it now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.4,
      "end_seconds": 188.83,
      "duration_seconds": 2.43,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.14,
      "end_seconds": 195.64,
      "duration_seconds": 5.5,
      "text": "mm, just a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.15,
      "end_seconds": 200.05,
      "duration_seconds": 3.9,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.36,
      "end_seconds": 204.92,
      "duration_seconds": 3.56,
      "text": "Hmm, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.49,
      "end_seconds": 209.85,
      "duration_seconds": 4.36,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.46,
      "end_seconds": 212.86,
      "duration_seconds": 1.4,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.79,
      "end_seconds": 217.14,
      "duration_seconds": 2.35,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.91,
      "end_seconds": 233.81,
      "duration_seconds": 2.9,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.44,
      "end_seconds": 259.15,
      "duration_seconds": 8.71,
      "text": "Okay: BP is 119 over 80, pulse is 77 beats a minute, temperature is 36.9 degrees. And respiratory rate 16."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.3,
      "end_seconds": 265.28,
      "duration_seconds": 3.98,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.84,
      "end_seconds": 269.51,
      "duration_seconds": 2.67,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.61,
      "end_seconds": 280.0,
      "duration_seconds": 3.39,
      "text": "your heart sounds and rhythm are normal today"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.42,
      "end_seconds": 288.15,
      "duration_seconds": 2.73,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.33,
      "end_seconds": 309.77,
      "duration_seconds": 9.44,
      "text": "Putting it all together, my working impression is episodes of supraventricular tachycardia. I can't rule out atrial fibrillation yet."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.35,
      "end_seconds": 314.19,
      "duration_seconds": 2.84,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.67,
      "end_seconds": 326.87,
      "duration_seconds": 11.2,
      "text": "it's reasonable to be concerned, but right now episodes of supraventricular tachycardia is my leading thought, not anything worse have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.82,
      "end_seconds": 337.34,
      "duration_seconds": 8.52,
      "text": "I had a thyroid test done at another clinic last year. I don't have the report with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.91,
      "end_seconds": 344.82,
      "duration_seconds": 6.91,
      "text": "today I'm not changing anything is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.9,
      "end_seconds": 347.61,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.92,
      "end_seconds": 350.54,
      "duration_seconds": 1.62,
      "text": "Have a good day."
    }
  ]
}