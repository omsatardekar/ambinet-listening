{
  "schema_version": "1.0",
  "encounter_id": "02923",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 6.37,
      "duration_seconds": 5.43,
      "text": "Hello, come in. Mind the step. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.67,
      "end_seconds": 11.77,
      "duration_seconds": 4.1,
      "text": "So the thing is, I've got hot flushes."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.39,
      "end_seconds": 16.29,
      "duration_seconds": 3.9,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.45,
      "end_seconds": 19.69,
      "duration_seconds": 2.24,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.54,
      "end_seconds": 24.98,
      "duration_seconds": 3.44,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.73,
      "end_seconds": 26.83,
      "duration_seconds": 1.1,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.94,
      "end_seconds": 30.46,
      "duration_seconds": 2.52,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.79,
      "end_seconds": 38.33,
      "duration_seconds": 6.54,
      "text": "Well, it usually comes with poor sleep. Oh, and periods becoming irregular."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.05,
      "end_seconds": 57.46,
      "duration_seconds": 3.41,
      "text": "Any bleeding after sex or very heavy bleeding?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.57,
      "end_seconds": 63.7,
      "duration_seconds": 5.13,
      "text": "No, no bleeding after sex or very heavy bleeding."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.65,
      "end_seconds": 69.33,
      "duration_seconds": 3.68,
      "text": "Have you noticed pelvic pain or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.75,
      "end_seconds": 74.84,
      "duration_seconds": 4.09,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.78,
      "end_seconds": 81.7,
      "duration_seconds": 2.92,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.79,
      "end_seconds": 88.44,
      "duration_seconds": 4.65,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 91.42,
      "duration_seconds": 2.34,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.35,
      "end_seconds": 94.13,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.78,
      "end_seconds": 99.44,
      "duration_seconds": 3.66,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.25,
      "end_seconds": 103.92,
      "duration_seconds": 3.67,
      "text": "I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 108.09,
      "duration_seconds": 3.43,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.07,
      "end_seconds": 113.26,
      "duration_seconds": 3.19,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.27,
      "end_seconds": 118.15,
      "duration_seconds": 3.88,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.61,
      "end_seconds": 137.8,
      "duration_seconds": 18.19,
      "text": "Sorry, what was I saying, I have high blood pressure, for two years. A neighbour of mine said I should see someone about it. I've had arthritis in my knees for about ten years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.2,
      "end_seconds": 140.57,
      "duration_seconds": 1.37,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.74,
      "end_seconds": 159.62,
      "duration_seconds": 3.88,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.28,
      "end_seconds": 171.49,
      "duration_seconds": 10.21,
      "text": "Okay, so I take diclofenac, 50 milligrams, when needed. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 172.71,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.37,
      "end_seconds": 178.75,
      "duration_seconds": 5.38,
      "text": "I'd been on losartan, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.5,
      "end_seconds": 186.13,
      "duration_seconds": 5.63,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.66,
      "end_seconds": 198.81,
      "duration_seconds": 12.15,
      "text": "I used to drink heavily but I stopped four years ago. I do a yoga class on Thursdays. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 200.02,
      "end_seconds": 212.93,
      "duration_seconds": 12.91,
      "text": "Doctor, I've got the readings for you. Blood pressure 119 over 73, pulse is 70 beats a minute, oxygen saturation is 98 percent, respiratory rate 17, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.76,
      "end_seconds": 215.22,
      "duration_seconds": 1.46,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.01,
      "end_seconds": 222.92,
      "duration_seconds": 4.91,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.91,
      "end_seconds": 226.94,
      "duration_seconds": 2.03,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.88,
      "end_seconds": 249.22,
      "duration_seconds": 4.34,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.03,
      "end_seconds": 253.73,
      "duration_seconds": 1.7,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.18,
      "end_seconds": 275.86,
      "duration_seconds": 4.68,
      "text": "So where does that leave us? It points towards perimenopause."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.3,
      "end_seconds": 280.51,
      "duration_seconds": 3.21,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.52,
      "end_seconds": 318.12,
      "duration_seconds": 35.6,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopause, but I'd like to confirm. Let's get a blood count, for irregular periods. Let's get a thyroid test, for hot flushes. I'd like you to take estradiol gel, 1 pump, once a day, long term. It's for menopausal symptoms. Regular exercise, light layers and avoiding triggers can help. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.03,
      "end_seconds": 326.64,
      "duration_seconds": 6.61,
      "text": "Book a review in three months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.19,
      "end_seconds": 334.26,
      "duration_seconds": 4.07,
      "text": "Let me think, thank you, doctor, goodbye."
    }
  ]
}