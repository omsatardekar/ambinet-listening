{
  "schema_version": "1.0",
  "encounter_id": "02979",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 3.72,
      "duration_seconds": 3.19,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.33,
      "end_seconds": 9.67,
      "duration_seconds": 4.34,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.32,
      "end_seconds": 21.11,
      "duration_seconds": 10.79,
      "text": "I'm here because of a severe sore throat on one side. I'm not great at remembering details, uh, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.02,
      "end_seconds": 30.17,
      "duration_seconds": 4.15,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.74,
      "end_seconds": 34.76,
      "duration_seconds": 4.02,
      "text": "Right, it's been like this since Friday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.55,
      "end_seconds": 38.73,
      "duration_seconds": 2.18,
      "text": "what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.49,
      "end_seconds": 48.63,
      "duration_seconds": 9.14,
      "text": "It's worse with swallowing. Oh, and a muffled voice. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.22,
      "end_seconds": 51.67,
      "duration_seconds": 2.45,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.89,
      "end_seconds": 56.51,
      "duration_seconds": 3.62,
      "text": "Mild, I'd say. I've also had drooling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 70.91,
      "duration_seconds": 2.99,
      "text": "okay, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.91,
      "end_seconds": 76.47,
      "duration_seconds": 1.56,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.31,
      "end_seconds": 84.89,
      "duration_seconds": 6.58,
      "text": "Are there any allergies I should be aware of? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.94,
      "end_seconds": 91.7,
      "duration_seconds": 4.76,
      "text": "No, uh, nothing as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.48,
      "end_seconds": 114.48,
      "duration_seconds": 4.0,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.41,
      "end_seconds": 120.05,
      "duration_seconds": 3.64,
      "text": "So, um, I've had gout, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.56,
      "end_seconds": 126.28,
      "duration_seconds": 4.72,
      "text": "Sure. Is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.14,
      "end_seconds": 129.84,
      "duration_seconds": 2.7,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.23,
      "end_seconds": 133.27,
      "duration_seconds": 2.04,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.13,
      "end_seconds": 139.6,
      "duration_seconds": 4.47,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.81,
      "end_seconds": 142.87,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.67,
      "end_seconds": 149.25,
      "duration_seconds": 5.58,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.27,
      "end_seconds": 156.02,
      "duration_seconds": 3.75,
      "text": "a few quick ones: cough, noisy breathing or rash?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.96,
      "end_seconds": 161.33,
      "duration_seconds": 3.37,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.55,
      "end_seconds": 164.89,
      "duration_seconds": 2.34,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.96,
      "end_seconds": 169.0,
      "duration_seconds": 2.04,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.9,
      "end_seconds": 174.44,
      "duration_seconds": 4.54,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.28,
      "end_seconds": 179.59,
      "duration_seconds": 4.31,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.56,
      "end_seconds": 186.89,
      "duration_seconds": 5.33,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.83,
      "end_seconds": 190.91,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.13,
      "end_seconds": 209.34,
      "duration_seconds": 7.21,
      "text": "The right tonsil is pushed towards the middle, the uvula is deviated, and the palate is swollen."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.5,
      "end_seconds": 216.64,
      "duration_seconds": 2.14,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.16,
      "end_seconds": 242.34,
      "duration_seconds": 11.18,
      "text": "Okay, thinking it through, I don't have a clear answer today: a quinsy, a peritonsillar abscess is possible, and so is severe tonsillitis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.3,
      "end_seconds": 250.28,
      "duration_seconds": 1.98,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.75,
      "end_seconds": 267.22,
      "duration_seconds": 15.47,
      "text": "I understand the worry at the moment I'd say it's a quinsy, a peritonsillar abscess, and we'll know more once the an urgent ENT drainage is back i want an urgent ENT drainage done, that's for peritonsillar abscess"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 267.97,
      "end_seconds": 271.64,
      "duration_seconds": 3.67,
      "text": "I can book that for Thursday at 10 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.45,
      "end_seconds": 275.73,
      "duration_seconds": 2.28,
      "text": "okay, I'll be there"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.16,
      "end_seconds": 304.76,
      "duration_seconds": 27.6,
      "text": "I'd like to arrange blood tests for abscess. The treatment will be benzylpenicillin, 1.2 grams, now, single dose. It's for peritonsillar abscess. You need to be seen by ENT today to drain it. A short walk every day, even twenty minutes, will help more than you'd think. I'd like you to see the ENT team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.2,
      "end_seconds": 311.86,
      "duration_seconds": 1.66,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.82,
      "end_seconds": 322.56,
      "duration_seconds": 8.74,
      "text": "come back or go to emergency straight away if the symptoms get worse that's all from me any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.81,
      "end_seconds": 326.66,
      "duration_seconds": 2.85,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.51,
      "end_seconds": 328.73,
      "duration_seconds": 1.22,
      "text": "look after yourself"
    }
  ]
}