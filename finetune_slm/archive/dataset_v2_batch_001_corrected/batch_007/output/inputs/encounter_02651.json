{
  "schema_version": "1.0",
  "encounter_id": "02651",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.96,
      "end_seconds": 3.87,
      "duration_seconds": 2.91,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.8,
      "end_seconds": 9.91,
      "duration_seconds": 4.11,
      "text": "Ah, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.23,
      "end_seconds": 14.78,
      "duration_seconds": 3.55,
      "text": "Right, did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.01,
      "end_seconds": 22.35,
      "duration_seconds": 6.34,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.97,
      "end_seconds": 27.41,
      "duration_seconds": 3.44,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.37,
      "end_seconds": 33.12,
      "duration_seconds": 4.75,
      "text": "I've, I've been dealing with sneezing in spring."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.79,
      "end_seconds": 36.99,
      "duration_seconds": 3.2,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.38,
      "end_seconds": 42.56,
      "duration_seconds": 4.18,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.12,
      "end_seconds": 45.84,
      "duration_seconds": 2.72,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.46,
      "end_seconds": 49.68,
      "duration_seconds": 3.22,
      "text": "I get some relief from antihistamine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.49,
      "end_seconds": 53.35,
      "duration_seconds": 2.86,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.89,
      "end_seconds": 73.97,
      "duration_seconds": 20.08,
      "text": "Maybe a six out of ten on a bad day. I've also had a runny itchy nose, for ten days. Watery eyes was there, uh, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.53,
      "end_seconds": 81.86,
      "duration_seconds": 6.33,
      "text": "Alright, have you had sneezing in spring before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.53,
      "end_seconds": 90.29,
      "duration_seconds": 7.76,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 92.0,
      "end_seconds": 103.18,
      "duration_seconds": 11.18,
      "text": "Doctor, I've got the readings for you. Weight 65 kilos, height 181 centimetres, saturation 99 percent, pulse 66, BP is 119 over 74, BMI works out to 19.8."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 105.72,
      "duration_seconds": 1.54,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.51,
      "end_seconds": 111.62,
      "duration_seconds": 4.11,
      "text": "Alright, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.95,
      "end_seconds": 116.1,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.89,
      "end_seconds": 134.16,
      "duration_seconds": 5.27,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.15,
      "end_seconds": 142.72,
      "duration_seconds": 2.57,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.35,
      "end_seconds": 161.75,
      "duration_seconds": 5.4,
      "text": "Did you get fever, loss of smell, facial pain or wheeze?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.41,
      "end_seconds": 171.01,
      "duration_seconds": 7.6,
      "text": "I, I haven't had fever, loss of smell, facial pain or wheeze, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.42,
      "end_seconds": 176.97,
      "duration_seconds": 5.55,
      "text": "Right, right. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.9,
      "end_seconds": 182.86,
      "duration_seconds": 3.96,
      "text": "I mean, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.89,
      "end_seconds": 186.44,
      "duration_seconds": 2.55,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.56,
      "end_seconds": 190.12,
      "duration_seconds": 2.56,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.87,
      "end_seconds": 193.4,
      "duration_seconds": 2.53,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.35,
      "end_seconds": 203.58,
      "duration_seconds": 8.23,
      "text": "Allopurinol, 100 milligrams, once a day for the gout. Loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.25,
      "end_seconds": 207.04,
      "duration_seconds": 2.79,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.25,
      "end_seconds": 209.92,
      "duration_seconds": 1.67,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.01,
      "end_seconds": 213.48,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.47,
      "end_seconds": 221.03,
      "duration_seconds": 6.56,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.78,
      "end_seconds": 224.72,
      "duration_seconds": 1.94,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.83,
      "end_seconds": 228.54,
      "duration_seconds": 2.71,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.38,
      "end_seconds": 232.13,
      "duration_seconds": 2.75,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.89,
      "end_seconds": 236.82,
      "duration_seconds": 3.93,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.42,
      "end_seconds": 238.62,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.59,
      "end_seconds": 243.59,
      "duration_seconds": 3.0,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.21,
      "end_seconds": 250.09,
      "duration_seconds": 2.88,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.71,
      "end_seconds": 256.07,
      "duration_seconds": 4.36,
      "text": "Um, I have gout, for five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.68,
      "end_seconds": 263.67,
      "duration_seconds": 5.99,
      "text": "Alright, gout, that matches what I have here. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.15,
      "end_seconds": 266.87,
      "duration_seconds": 1.72,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.72,
      "end_seconds": 279.79,
      "duration_seconds": 4.07,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.23,
      "end_seconds": 288.83,
      "duration_seconds": 3.6,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.92,
      "end_seconds": 302.97,
      "duration_seconds": 12.05,
      "text": "Let me tell you where I've got to. It points towards seasonal allergic rhinitis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.16,
      "end_seconds": 346.71,
      "duration_seconds": 31.55,
      "text": "We'll begin with fluticasone nasal spray, 50 micrograms, once a day, the season. That should help with hay fever. It's a commonly used medicine and most people tolerate it well. Shower after being outdoors and keep windows shut when pollen is high. Book a review if not better in a month. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.91,
      "end_seconds": 361.69,
      "duration_seconds": 13.78,
      "text": "So, I take the fluticasone nasal spray, 50 micrograms, once a day and come back if not better in a month. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.91,
      "end_seconds": 367.92,
      "duration_seconds": 5.01,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.46,
      "end_seconds": 371.78,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    }
  ]
}