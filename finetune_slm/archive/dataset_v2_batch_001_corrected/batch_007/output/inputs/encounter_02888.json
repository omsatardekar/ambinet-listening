{
  "schema_version": "1.0",
  "encounter_id": "02888",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.25,
      "duration_seconds": 2.74,
      "text": "good afternoon, um, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.3,
      "end_seconds": 8.08,
      "duration_seconds": 3.78,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.92,
      "end_seconds": 20.16,
      "duration_seconds": 11.24,
      "text": "Um, so... fainting on exertion. That's why I came. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.44,
      "end_seconds": 24.72,
      "duration_seconds": 3.28,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.81,
      "end_seconds": 33.2,
      "duration_seconds": 6.39,
      "text": "About... well, six months. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.45,
      "end_seconds": 44.66,
      "duration_seconds": 11.21,
      "text": "Mm, okay. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.54,
      "end_seconds": 59.75,
      "duration_seconds": 13.21,
      "text": "Oh, honestly, all the time. Mostly mild. I'm hoping you can tell me something definite. Oh, and being very breathless. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.18,
      "end_seconds": 74.98,
      "duration_seconds": 2.8,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.55,
      "end_seconds": 83.57,
      "duration_seconds": 7.02,
      "text": "I was told I'm allergic to erythromycin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.06,
      "end_seconds": 88.37,
      "duration_seconds": 3.31,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.28,
      "end_seconds": 95.64,
      "duration_seconds": 5.36,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.89,
      "end_seconds": 103.91,
      "duration_seconds": 3.02,
      "text": "So, do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.17,
      "end_seconds": 109.75,
      "duration_seconds": 4.58,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.67,
      "end_seconds": 116.87,
      "duration_seconds": 3.2,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.55,
      "end_seconds": 120.84,
      "duration_seconds": 3.29,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.66,
      "end_seconds": 135.06,
      "duration_seconds": 3.4,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.05,
      "end_seconds": 142.12,
      "duration_seconds": 3.07,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.26,
      "end_seconds": 160.19,
      "duration_seconds": 2.93,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.06,
      "end_seconds": 163.58,
      "duration_seconds": 1.52,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.55,
      "end_seconds": 168.3,
      "duration_seconds": 2.75,
      "text": "Any leg pain, fever or cough?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.82,
      "end_seconds": 173.48,
      "duration_seconds": 3.66,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.67,
      "end_seconds": 177.6,
      "duration_seconds": 2.93,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.82,
      "end_seconds": 180.73,
      "duration_seconds": 1.91,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.75,
      "end_seconds": 187.98,
      "duration_seconds": 2.23,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.96,
      "end_seconds": 193.79,
      "duration_seconds": 3.83,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.53,
      "end_seconds": 198.69,
      "duration_seconds": 3.16,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.46,
      "end_seconds": 215.45,
      "duration_seconds": 2.99,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.64,
      "end_seconds": 240.31,
      "duration_seconds": 7.67,
      "text": "Okay: temperature is 37.6 degrees, blood pressure 119 over 86, saturation 94 percent, heart rate 102."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.68,
      "end_seconds": 258.82,
      "duration_seconds": 5.14,
      "text": "Right, here's what I'm thinking. My working impression is possible pulmonary hypertension."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.7,
      "end_seconds": 262.9,
      "duration_seconds": 2.2,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.63,
      "end_seconds": 279.46,
      "duration_seconds": 15.83,
      "text": "Nothing I've seen today points to an emergency. It looks like possible pulmonary hypertension, but I'd like to confirm. So, to recap quickly. You've had fainting on exertion for six months, mild, and no fever or cough."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.54,
      "end_seconds": 283.61,
      "duration_seconds": 2.07,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.24,
      "end_seconds": 289.1,
      "duration_seconds": 3.86,
      "text": "I want an echocardiogram done, that's for exertional syncope."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.76,
      "end_seconds": 291.6,
      "duration_seconds": 1.84,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.17,
      "end_seconds": 311.45,
      "duration_seconds": 17.28,
      "text": "No exertion for now, I am arranging urgent specialist tests. Let's get you seen by the pulmonary hypertension service, I'll arrange the letter. I'll want another look in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.58,
      "end_seconds": 314.69,
      "duration_seconds": 2.11,
      "text": "alright, thanks, take care"
    }
  ]
}