{
  "schema_version": "1.0",
  "encounter_id": "02692",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 2.88,
      "duration_seconds": 2.09,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.79,
      "end_seconds": 7.23,
      "duration_seconds": 2.44,
      "text": "Hi, uh, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.02,
      "end_seconds": 11.72,
      "duration_seconds": 2.7,
      "text": "Did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.7,
      "end_seconds": 20.32,
      "duration_seconds": 6.62,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.87,
      "end_seconds": 26.75,
      "duration_seconds": 2.88,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.34,
      "end_seconds": 40.74,
      "duration_seconds": 12.4,
      "text": "I've been dealing with severe pain in my left side going to the groin. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.42,
      "end_seconds": 45.3,
      "duration_seconds": 2.88,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.52,
      "end_seconds": 56.34,
      "duration_seconds": 2.82,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.18,
      "end_seconds": 76.79,
      "duration_seconds": 8.61,
      "text": "Okay: SpO2 98 percent on room air, temp 36.5 degrees, pulse 77, blood pressure 117 over 81."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.58,
      "end_seconds": 81.46,
      "duration_seconds": 2.88,
      "text": "Mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.09,
      "end_seconds": 86.59,
      "duration_seconds": 4.5,
      "text": "We'll go over that shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.01,
      "end_seconds": 94.4,
      "duration_seconds": 6.39,
      "text": "Probably two months. Yeah. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.73,
      "end_seconds": 100.16,
      "duration_seconds": 5.43,
      "text": "Right, right. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.86,
      "end_seconds": 110.9,
      "duration_seconds": 10.04,
      "text": "Ah, you know, I'd say mild. Honestly, every other day. Okay, you know, so I've also been feeling sick."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 120.4,
      "duration_seconds": 8.07,
      "text": "Have you had severe pain in your left side going to the groin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.5,
      "end_seconds": 127.34,
      "duration_seconds": 5.84,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.64,
      "end_seconds": 131.6,
      "duration_seconds": 2.96,
      "text": "What about burning when passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.86,
      "end_seconds": 137.68,
      "duration_seconds": 4.82,
      "text": "Not that I've noticed, no burning when passing urine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.77,
      "end_seconds": 143.08,
      "duration_seconds": 4.31,
      "text": "Alright, did you get passing no urine, vomiting or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.45,
      "end_seconds": 148.63,
      "duration_seconds": 4.18,
      "text": "I mean, no, I'd have said so."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.31,
      "end_seconds": 155.61,
      "duration_seconds": 5.3,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.7,
      "end_seconds": 161.13,
      "duration_seconds": 4.43,
      "text": "Um, um, no, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.91,
      "end_seconds": 164.57,
      "duration_seconds": 2.66,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.36,
      "end_seconds": 168.56,
      "duration_seconds": 2.2,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.53,
      "end_seconds": 179.73,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.54,
      "end_seconds": 181.88,
      "duration_seconds": 1.34,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.49,
      "end_seconds": 185.42,
      "duration_seconds": 2.93,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.62,
      "end_seconds": 200.41,
      "duration_seconds": 13.79,
      "text": "No, I share a house with my brother. Not much, I mostly stay in these days. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.66,
      "end_seconds": 204.28,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.98,
      "end_seconds": 210.89,
      "duration_seconds": 5.91,
      "text": "Let me think, I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.24,
      "end_seconds": 218.65,
      "duration_seconds": 6.41,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.66,
      "end_seconds": 238.16,
      "duration_seconds": 4.5,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.12,
      "end_seconds": 244.22,
      "duration_seconds": 4.1,
      "text": "Um, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 248.79,
      "duration_seconds": 3.77,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.83,
      "end_seconds": 255.95,
      "duration_seconds": 6.12,
      "text": "Naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.27,
      "end_seconds": 264.52,
      "duration_seconds": 7.25,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.19,
      "end_seconds": 272.36,
      "duration_seconds": 7.17,
      "text": "Let me think, uh, yes, grass pollen, it gives me sneezing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.08,
      "end_seconds": 277.48,
      "duration_seconds": 3.4,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.86,
      "end_seconds": 280.03,
      "duration_seconds": 1.17,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.26,
      "end_seconds": 296.75,
      "duration_seconds": 6.49,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.1,
      "end_seconds": 303.83,
      "duration_seconds": 1.73,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.59,
      "end_seconds": 331.41,
      "duration_seconds": 14.82,
      "text": "Taking everything into account, my working impression is kidney stone colic. We should do a urine dipstick for haematuria. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.39,
      "end_seconds": 335.99,
      "duration_seconds": 3.6,
      "text": "Um, okay, I'll do it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.55,
      "end_seconds": 356.91,
      "duration_seconds": 19.36,
      "text": "I want a CT scan of the kidneys and bladder done, that's for renal colic. Drink plenty of water and strain the urine to catch the stone. Let's get you seen by the urology clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.16,
      "end_seconds": 362.35,
      "duration_seconds": 4.19,
      "text": "I mean, sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.91,
      "end_seconds": 379.16,
      "duration_seconds": 16.25,
      "text": "Let's hold off on kidney function tests for now, and if there's no change in a month we can revisit it. See me again in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.14,
      "end_seconds": 382.7,
      "duration_seconds": 2.56,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.4,
      "end_seconds": 385.28,
      "duration_seconds": 1.88,
      "text": "Have a good day."
    }
  ]
}