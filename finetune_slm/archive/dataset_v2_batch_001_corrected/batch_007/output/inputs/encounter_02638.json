{
  "schema_version": "1.0",
  "encounter_id": "02638",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 6.95,
      "duration_seconds": 6.38,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 12.04,
      "duration_seconds": 4.32,
      "text": "Okay, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.41,
      "end_seconds": 18.64,
      "duration_seconds": 5.23,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.45,
      "end_seconds": 23.82,
      "duration_seconds": 3.37,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.24,
      "end_seconds": 32.26,
      "duration_seconds": 7.02,
      "text": "It's weakness climbing up my legs, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 32.82,
      "end_seconds": 42.68,
      "duration_seconds": 9.86,
      "text": "Okay, so the vitals from earlier. Heart rate 69, temperature is 36.4 degrees, SpO2 99 percent on room air. BP is 121 over 81."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.22,
      "end_seconds": 45.54,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.85,
      "end_seconds": 64.59,
      "duration_seconds": 4.74,
      "text": "Since when exactly? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.24,
      "end_seconds": 74.09,
      "duration_seconds": 8.85,
      "text": "For two days, I'd say. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.96,
      "end_seconds": 78.95,
      "duration_seconds": 3.99,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.14,
      "end_seconds": 93.1,
      "duration_seconds": 7.96,
      "text": "Um, um, it feels moderate to me. Actually, I've also had tingling in my feet."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.61,
      "end_seconds": 96.95,
      "duration_seconds": 2.34,
      "text": "Have you had difficulty walking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 108.92,
      "duration_seconds": 10.22,
      "text": "yeah, that too. And a recent stomach bug as well, since last night. About recent stomach bug, it feels severe to me"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.54,
      "end_seconds": 115.79,
      "duration_seconds": 6.25,
      "text": "Have you had weakness climbing up your legs before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 127.2,
      "duration_seconds": 7.75,
      "text": "a a bit, a couple of years ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.27,
      "end_seconds": 132.15,
      "duration_seconds": 3.88,
      "text": "And what about bladder problems or back pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.43,
      "end_seconds": 136.28,
      "duration_seconds": 2.85,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.03,
      "end_seconds": 140.2,
      "duration_seconds": 2.17,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.72,
      "end_seconds": 143.47,
      "duration_seconds": 1.75,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 147.81,
      "end_seconds": 152.6,
      "duration_seconds": 4.79,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.96,
      "end_seconds": 160.75,
      "duration_seconds": 6.79,
      "text": "no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.68,
      "end_seconds": 170.91,
      "duration_seconds": 8.23,
      "text": "alright, I'll note both what you've said and what you've noticed. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.98,
      "end_seconds": 180.3,
      "duration_seconds": 4.32,
      "text": "yeah, uh, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.64,
      "end_seconds": 182.9,
      "duration_seconds": 1.26,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.94,
      "end_seconds": 188.95,
      "duration_seconds": 4.01,
      "text": "no, um, I've never been operated on"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.02,
      "end_seconds": 208.67,
      "duration_seconds": 3.65,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.69,
      "end_seconds": 217.85,
      "duration_seconds": 7.16,
      "text": "High cholesterol, for about ten years. I have an enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.88,
      "end_seconds": 227.38,
      "duration_seconds": 7.5,
      "text": "Okay, I can see high cholesterol and an enlarged prostate in your file as well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.79,
      "end_seconds": 239.98,
      "duration_seconds": 1.19,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.77,
      "end_seconds": 244.61,
      "duration_seconds": 3.84,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.76,
      "end_seconds": 248.59,
      "duration_seconds": 2.83,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.53,
      "end_seconds": 252.89,
      "duration_seconds": 3.36,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.26,
      "end_seconds": 257.63,
      "duration_seconds": 3.37,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.77,
      "end_seconds": 261.89,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.97,
      "end_seconds": 268.38,
      "duration_seconds": 5.41,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.9,
      "end_seconds": 272.82,
      "duration_seconds": 3.92,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.91,
      "end_seconds": 278.17,
      "duration_seconds": 2.26,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.62,
      "end_seconds": 288.56,
      "duration_seconds": 5.94,
      "text": "Oh, I'm on rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 290.34,
      "end_seconds": 295.07,
      "duration_seconds": 4.73,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.73,
      "end_seconds": 302.42,
      "duration_seconds": 5.69,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.44,
      "end_seconds": 315.27,
      "duration_seconds": 10.83,
      "text": "Not with me. I'll bring it next time. I'm on tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.48,
      "end_seconds": 318.18,
      "duration_seconds": 1.7,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.58,
      "end_seconds": 321.18,
      "duration_seconds": 1.6,
      "text": "about two months"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.41,
      "end_seconds": 322.11,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.16,
      "end_seconds": 327.06,
      "duration_seconds": 3.9,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.11,
      "end_seconds": 329.39,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.61,
      "end_seconds": 351.23,
      "duration_seconds": 5.62,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.83,
      "end_seconds": 373.27,
      "duration_seconds": 16.44,
      "text": "That's all I needed to check. Having listened and examined, I'd lean towards possible Guillain-Barre syndrome. I want to be honest that this is an impression, not a final answer. I can't rule out a spinal cord problem yet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 374.81,
      "end_seconds": 377.6,
      "duration_seconds": 2.79,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.25,
      "end_seconds": 395.86,
      "duration_seconds": 17.61,
      "text": "Nothing I've seen today points to an emergency. It looks like possible Guillain-Barre syndrome, but I'd like to confirm. Stop me if I've got anything wrong. You've had weakness climbing up your legs for two days, moderate, and no bladder problems or back pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.11,
      "end_seconds": 401.62,
      "duration_seconds": 1.51,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.27,
      "end_seconds": 436.12,
      "duration_seconds": 33.85,
      "text": "I'm sending you for an urgent admission because of ascending weakness. I'd rather check than guess, and this is the quickest way to know more. I'm sending you for a lumbar puncture because of possible GBS. I'm sending you for a breathing test because of possible GBS. It's a routine test and it'll give us a much clearer picture. You must be admitted today for monitoring of your breathing."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.46,
      "end_seconds": 452.13,
      "duration_seconds": 14.67,
      "text": "Let's get you seen by the neurology team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 453.95,
      "end_seconds": 455.07,
      "duration_seconds": 1.12,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.15,
      "end_seconds": 465.97,
      "duration_seconds": 9.82,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back straight away."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 467.29,
      "end_seconds": 470.47,
      "duration_seconds": 3.18,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 471.1,
      "end_seconds": 473.84,
      "duration_seconds": 2.74,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 474.38,
      "end_seconds": 477.54,
      "duration_seconds": 3.16,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 478.17,
      "end_seconds": 479.36,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}