{
  "schema_version": "1.0",
  "encounter_id": "02620",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 3.84,
      "duration_seconds": 2.82,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.62,
      "end_seconds": 9.02,
      "duration_seconds": 2.4,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.76,
      "end_seconds": 15.6,
      "duration_seconds": 4.84,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.99,
      "end_seconds": 21.58,
      "duration_seconds": 4.59,
      "text": "Please do. Extra information is always welcome. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.35,
      "end_seconds": 29.89,
      "duration_seconds": 7.54,
      "text": "I'm, I'm here because of severe tummy pain out of proportion to the examination."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.42,
      "end_seconds": 35.27,
      "duration_seconds": 3.85,
      "text": "Alright, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.81,
      "end_seconds": 41.99,
      "duration_seconds": 5.18,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.61,
      "end_seconds": 47.01,
      "duration_seconds": 3.4,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.41,
      "end_seconds": 58.6,
      "duration_seconds": 10.19,
      "text": "It usually comes with vomiting. I've been feeling very unwell too, for one week. With vomiting, moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.51,
      "end_seconds": 61.48,
      "duration_seconds": 1.97,
      "text": "Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.58,
      "end_seconds": 64.2,
      "duration_seconds": 1.62,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.21,
      "end_seconds": 67.15,
      "duration_seconds": 0.94,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.21,
      "end_seconds": 72.08,
      "duration_seconds": 2.87,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.53,
      "end_seconds": 76.82,
      "duration_seconds": 3.29,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.82,
      "end_seconds": 81.57,
      "duration_seconds": 2.75,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.86,
      "end_seconds": 86.02,
      "duration_seconds": 3.16,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.49,
      "end_seconds": 96.95,
      "duration_seconds": 4.46,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.79,
      "end_seconds": 107.96,
      "duration_seconds": 3.17,
      "text": "So, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.84,
      "end_seconds": 115.1,
      "duration_seconds": 6.26,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.26,
      "end_seconds": 118.92,
      "duration_seconds": 2.66,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.81,
      "end_seconds": 123.89,
      "duration_seconds": 3.08,
      "text": "Yes, naproxen. I get stomach pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 128.6,
      "duration_seconds": 3.92,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.37,
      "end_seconds": 145.17,
      "duration_seconds": 14.8,
      "text": "An irregular heartbeat, for nearly five years. I wasn't sure whether to come in at all, to be honest. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.01,
      "end_seconds": 147.8,
      "duration_seconds": 1.79,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.32,
      "end_seconds": 150.37,
      "duration_seconds": 2.05,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.74,
      "end_seconds": 152.96,
      "duration_seconds": 1.22,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.49,
      "end_seconds": 161.89,
      "duration_seconds": 7.4,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.97,
      "end_seconds": 166.68,
      "duration_seconds": 2.71,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.36,
      "end_seconds": 170.54,
      "duration_seconds": 2.18,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 175.21,
      "end_seconds": 189.13,
      "duration_seconds": 13.92,
      "text": "He is on metoprolol, 50 milligrams, twice a day for the heart rhythm, I give it to him. It's a blood thinner, 5 milligrams, stopped last month, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.28,
      "end_seconds": 210.18,
      "duration_seconds": 3.9,
      "text": "Did you get fever, hernia or chest pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.28,
      "end_seconds": 213.35,
      "duration_seconds": 2.07,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.0,
      "end_seconds": 217.08,
      "duration_seconds": 3.08,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.8,
      "end_seconds": 220.5,
      "duration_seconds": 1.7,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.18,
      "end_seconds": 224.15,
      "duration_seconds": 2.97,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.92,
      "end_seconds": 226.92,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.13,
      "end_seconds": 230.44,
      "duration_seconds": 2.31,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.4,
      "end_seconds": 235.26,
      "duration_seconds": 2.86,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.94,
      "end_seconds": 259.58,
      "duration_seconds": 10.64,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.02,
      "end_seconds": 275.3,
      "duration_seconds": 13.28,
      "text": "Okay, that's enough for me. Putting it all together, I'm honestly not certain yet. It could be possible bowel ischaemia, or it might be a bowel obstruction."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.87,
      "end_seconds": 278.66,
      "duration_seconds": 2.79,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.68,
      "end_seconds": 289.33,
      "duration_seconds": 7.65,
      "text": "It's reasonable to be concerned, but right now possible bowel ischaemia is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.09,
      "end_seconds": 331.06,
      "duration_seconds": 29.97,
      "text": "I'm sending you for an urgent CT angiogram because of possible bowel ischaemia. I think urgent blood tests makes sense here, for severe abdominal pain. This is an emergency, you are going to hospital now. If the symptoms get worse, or you feel really unwell, please come to the emergency department. See me again straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.88,
      "end_seconds": 338.5,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    }
  ]
}