{
  "schema_version": "1.0",
  "encounter_id": "02616",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 3.69,
      "duration_seconds": 3.09,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.68,
      "end_seconds": 12.22,
      "duration_seconds": 4.54,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.27,
      "end_seconds": 20.28,
      "duration_seconds": 6.01,
      "text": "Let me think, so the thing is, I've got a severe headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.64,
      "end_seconds": 24.75,
      "duration_seconds": 3.11,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.77,
      "end_seconds": 38.24,
      "duration_seconds": 2.47,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.61,
      "end_seconds": 67.73,
      "duration_seconds": 12.12,
      "text": "Okay: saturation 98 percent, blood pressure 163 over 95, heart rate 78. And BMI works out to 32.0, temperature 36.6, weight 82 kilos, height 160 centimetres."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.89,
      "end_seconds": 71.28,
      "duration_seconds": 2.39,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.89,
      "end_seconds": 74.66,
      "duration_seconds": 2.77,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.53,
      "end_seconds": 89.5,
      "duration_seconds": 2.97,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.09,
      "end_seconds": 96.48,
      "duration_seconds": 6.39,
      "text": "Probably ten days. Yeah. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.65,
      "end_seconds": 100.48,
      "duration_seconds": 2.83,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.46,
      "end_seconds": 104.04,
      "duration_seconds": 1.58,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.27,
      "end_seconds": 126.76,
      "duration_seconds": 4.49,
      "text": "Have you noticed leaking fluid, reduced baby movements or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.59,
      "end_seconds": 130.4,
      "duration_seconds": 2.81,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.87,
      "end_seconds": 136.54,
      "duration_seconds": 5.67,
      "text": "Okay, go on. So, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.28,
      "end_seconds": 141.74,
      "duration_seconds": 2.46,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.77,
      "end_seconds": 147.0,
      "duration_seconds": 3.23,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.98,
      "end_seconds": 149.89,
      "duration_seconds": 1.91,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.18,
      "end_seconds": 155.08,
      "duration_seconds": 3.9,
      "text": "Alright, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.15,
      "end_seconds": 164.88,
      "duration_seconds": 7.73,
      "text": "Well, uh, I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.74,
      "end_seconds": 172.16,
      "duration_seconds": 5.42,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.16,
      "end_seconds": 186.32,
      "duration_seconds": 12.16,
      "text": "I retired from the post office two years ago. I grab fast food at lunch most days. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.72,
      "end_seconds": 200.66,
      "duration_seconds": 2.94,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.63,
      "end_seconds": 204.23,
      "duration_seconds": 1.6,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.48,
      "end_seconds": 209.2,
      "duration_seconds": 3.72,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.12,
      "end_seconds": 216.5,
      "duration_seconds": 5.38,
      "text": "Metoprolol. I take it twice a day for my heart."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.95,
      "end_seconds": 219.9,
      "duration_seconds": 1.95,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.62,
      "end_seconds": 222.27,
      "duration_seconds": 1.65,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.96,
      "end_seconds": 228.82,
      "duration_seconds": 3.86,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 232.26,
      "duration_seconds": 2.4,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.75,
      "end_seconds": 248.3,
      "duration_seconds": 4.55,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.49,
      "end_seconds": 254.56,
      "duration_seconds": 2.07,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.12,
      "end_seconds": 279.87,
      "duration_seconds": 8.75,
      "text": "I think urgent blood tests makes sense here, for pre-eclampsia. I think a urine protein test makes sense here, for pre-eclampsia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.87,
      "end_seconds": 283.03,
      "duration_seconds": 2.16,
      "text": "Mm, uh, alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.72,
      "end_seconds": 306.84,
      "duration_seconds": 23.12,
      "text": "I'm prescribing labetalol, 200 milligrams, once now, single dose. That should help with severe hypertension. You need to go to the maternity unit straight away. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'd like you to see the obstetric team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.38,
      "end_seconds": 310.01,
      "duration_seconds": 1.63,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.34,
      "end_seconds": 328.03,
      "duration_seconds": 16.69,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check straight away. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.95,
      "end_seconds": 338.09,
      "duration_seconds": 8.14,
      "text": "So, I take the labetalol, 200 milligrams, once now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.02,
      "end_seconds": 344.14,
      "duration_seconds": 5.12,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.1,
      "end_seconds": 349.62,
      "duration_seconds": 3.52,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}