{
  "schema_version": "1.0",
  "encounter_id": "02713",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 4.77,
      "duration_seconds": 3.41,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.8,
      "end_seconds": 13.81,
      "duration_seconds": 8.01,
      "text": "Sorry, uh, what was I saying, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.69,
      "end_seconds": 16.27,
      "duration_seconds": 1.58,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.31,
      "end_seconds": 26.67,
      "duration_seconds": 9.36,
      "text": "Let me think, you know, we came because of severe pain in my left side going to the groin."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.37,
      "end_seconds": 30.87,
      "duration_seconds": 2.5,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.88,
      "end_seconds": 35.26,
      "duration_seconds": 2.38,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.79,
      "end_seconds": 38.22,
      "duration_seconds": 2.43,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.57,
      "end_seconds": 51.4,
      "duration_seconds": 11.83,
      "text": "Yes, about the same, four weeks. Right, as for feeling sick, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.11,
      "end_seconds": 61.71,
      "duration_seconds": 8.6,
      "text": "Have you had severe pain in your left side going to the groin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.23,
      "end_seconds": 69.1,
      "duration_seconds": 6.87,
      "text": "Oh, a bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 70.97,
      "end_seconds": 73.34,
      "duration_seconds": 2.37,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.3,
      "end_seconds": 79.69,
      "duration_seconds": 5.39,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.58,
      "end_seconds": 93.14,
      "duration_seconds": 12.56,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 104.36,
      "duration_seconds": 3.41,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.18,
      "end_seconds": 111.59,
      "duration_seconds": 5.41,
      "text": "Well, my cousin has psoriasis. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.02,
      "end_seconds": 129.86,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 130.43,
      "end_seconds": 155.52,
      "duration_seconds": 25.09,
      "text": "It's metformin, 500 milligrams, twice a day for my sugar, doctor. Well, he is on escitalopram, 10 milligrams, once a day for the anxiety, I give it to him. He is on febuxostat, 80 milligrams, once a day, I give it to him."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.07,
      "end_seconds": 158.41,
      "duration_seconds": 2.34,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.7,
      "end_seconds": 162.5,
      "duration_seconds": 2.8,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.75,
      "end_seconds": 166.66,
      "duration_seconds": 2.91,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.49,
      "end_seconds": 171.85,
      "duration_seconds": 4.36,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 175.55,
      "duration_seconds": 2.62,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.42,
      "end_seconds": 183.66,
      "duration_seconds": 7.24,
      "text": "So, you know, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.35,
      "end_seconds": 188.03,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.33,
      "end_seconds": 191.91,
      "duration_seconds": 2.58,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.39,
      "end_seconds": 195.2,
      "duration_seconds": 1.81,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.95,
      "end_seconds": 200.22,
      "duration_seconds": 3.27,
      "text": "Erm, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.13,
      "end_seconds": 203.15,
      "duration_seconds": 1.02,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.03,
      "end_seconds": 206.27,
      "duration_seconds": 1.24,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.89,
      "end_seconds": 214.83,
      "duration_seconds": 7.94,
      "text": "Ah. Yes, anxiety is known to us, good to have that clear. Any fever or vomiting at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.89,
      "end_seconds": 229.85,
      "duration_seconds": 13.96,
      "text": "Let me think, no, no fever, no vomiting. I did have not being able to lie still at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.79,
      "end_seconds": 235.55,
      "duration_seconds": 3.76,
      "text": "Any burning when passing urine or passing no urine?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.1,
      "end_seconds": 240.94,
      "duration_seconds": 3.84,
      "text": "Oh, no, not a single one."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.51,
      "end_seconds": 247.33,
      "duration_seconds": 4.82,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.12,
      "end_seconds": 250.35,
      "duration_seconds": 2.23,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.29,
      "end_seconds": 255.6,
      "duration_seconds": 3.31,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.36,
      "end_seconds": 258.9,
      "duration_seconds": 1.54,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.92,
      "end_seconds": 264.01,
      "duration_seconds": 3.09,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.14,
      "end_seconds": 280.19,
      "duration_seconds": 3.05,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.42,
      "end_seconds": 307.34,
      "duration_seconds": 7.92,
      "text": "Okay: saturation 97 percent, BP is 114 over 70. And pulse 86, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 308.89,
      "end_seconds": 310.38,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.76,
      "end_seconds": 313.96,
      "duration_seconds": 2.2,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.79,
      "end_seconds": 320.84,
      "duration_seconds": 4.05,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.07,
      "end_seconds": 324.9,
      "duration_seconds": 2.83,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.57,
      "end_seconds": 346.88,
      "duration_seconds": 7.31,
      "text": "You are writhing in pain with tenderness in the left loin but your tummy is soft."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.57,
      "end_seconds": 360.45,
      "duration_seconds": 10.88,
      "text": "Please sit back down. From what you've told me and what I found, this looks most like kidney stone colic. Another possibility is a urine infection."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.8,
      "end_seconds": 367.09,
      "duration_seconds": 5.29,
      "text": "Okay, um, so is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.22,
      "end_seconds": 388.78,
      "duration_seconds": 20.56,
      "text": "Nothing I've seen today points to an emergency. It looks like kidney stone colic, but I'd like to confirm. Let's book a CT scan of the kidneys and bladder to look into renal colic. We should do a urine dipstick for haematuria."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 390.26,
      "end_seconds": 393.06,
      "duration_seconds": 2.8,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.63,
      "end_seconds": 400.21,
      "duration_seconds": 6.58,
      "text": "For this, diclofenac, 75 milligrams, once now, single dose. That's for renal colic."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 401.79,
      "end_seconds": 405.36,
      "duration_seconds": 3.57,
      "text": "So, should I take that with food?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.45,
      "end_seconds": 416.98,
      "duration_seconds": 9.53,
      "text": "Drink plenty of water and strain the urine to catch the stone. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 418.27,
      "end_seconds": 422.11,
      "duration_seconds": 3.84,
      "text": "Actually, I know what to watch for."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.52,
      "end_seconds": 427.33,
      "duration_seconds": 2.81,
      "text": "We'll catch up in one week."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.97,
      "end_seconds": 433.85,
      "duration_seconds": 4.88,
      "text": "Sorry, what was I saying, alright, I'll be back."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.15,
      "end_seconds": 439.85,
      "duration_seconds": 4.7,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 441.79,
      "end_seconds": 445.58,
      "duration_seconds": 3.79,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 446.44,
      "end_seconds": 447.7,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}