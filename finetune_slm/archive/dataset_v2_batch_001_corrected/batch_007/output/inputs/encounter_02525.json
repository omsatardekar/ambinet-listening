{
  "schema_version": "1.0",
  "encounter_id": "02525",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 5.52,
      "duration_seconds": 4.16,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.52,
      "end_seconds": 11.17,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.64,
      "end_seconds": 18.94,
      "duration_seconds": 6.3,
      "text": "Um, so... a chesty cough for a week. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 22.92,
      "duration_seconds": 3.04,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.37,
      "end_seconds": 26.55,
      "duration_seconds": 2.18,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.04,
      "end_seconds": 34.04,
      "duration_seconds": 3.0,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 39.2,
      "duration_seconds": 3.8,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.83,
      "end_seconds": 56.52,
      "duration_seconds": 1.69,
      "text": "Any breathlessness or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.45,
      "end_seconds": 59.61,
      "duration_seconds": 2.16,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.44,
      "end_seconds": 64.03,
      "duration_seconds": 3.59,
      "text": "Any coughing up blood or chest pain at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.96,
      "end_seconds": 70.7,
      "duration_seconds": 4.74,
      "text": "I haven't had coughing up blood or chest pain, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.08,
      "end_seconds": 74.2,
      "duration_seconds": 3.12,
      "text": "Yes. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.91,
      "end_seconds": 77.52,
      "duration_seconds": 1.61,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.22,
      "end_seconds": 90.11,
      "duration_seconds": 2.89,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.95,
      "end_seconds": 104.52,
      "duration_seconds": 10.57,
      "text": "I'm a bus driver, so I sit for long hours. I swim twice a week. My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.53,
      "end_seconds": 120.3,
      "duration_seconds": 4.77,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.87,
      "end_seconds": 124.2,
      "duration_seconds": 2.33,
      "text": "I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.09,
      "end_seconds": 133.53,
      "duration_seconds": 7.44,
      "text": "Okay, I can see epilepsy in your file as well. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.33,
      "end_seconds": 138.15,
      "duration_seconds": 2.82,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.63,
      "end_seconds": 156.94,
      "duration_seconds": 3.31,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.21,
      "end_seconds": 168.57,
      "duration_seconds": 10.36,
      "text": "I'm on carbamazepine, 200 milligrams, twice a day for the seizures. Honey and lemon. I take it at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.65,
      "end_seconds": 172.54,
      "duration_seconds": 2.89,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.15,
      "end_seconds": 182.17,
      "duration_seconds": 2.02,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.14,
      "end_seconds": 204.45,
      "duration_seconds": 8.31,
      "text": "Okay: respiratory rate 16, BP is 120 over 79, pulse 71, temp 36.8 degrees, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.85,
      "end_seconds": 207.53,
      "duration_seconds": 1.68,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.23,
      "end_seconds": 211.22,
      "duration_seconds": 1.99,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.7,
      "end_seconds": 217.38,
      "duration_seconds": 4.68,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.71,
      "end_seconds": 221.11,
      "duration_seconds": 2.4,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.01,
      "end_seconds": 235.12,
      "duration_seconds": 4.11,
      "text": "Your chest is clear and your oxygen is normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.57,
      "end_seconds": 244.4,
      "duration_seconds": 6.83,
      "text": "Okay, that's enough for me. Okay, thinking it through, my working impression is acute viral bronchitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.12,
      "end_seconds": 248.06,
      "duration_seconds": 1.94,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.56,
      "end_seconds": 266.92,
      "duration_seconds": 18.36,
      "text": "I understand the worry. At the moment I'd say it's acute viral bronchitis, and we'll watch how it goes. Stop me if I've got anything wrong. You've had a chesty cough for a week for two months, and no fever or coughing up blood."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.12,
      "end_seconds": 273.29,
      "duration_seconds": 2.17,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.95,
      "end_seconds": 301.88,
      "duration_seconds": 26.93,
      "text": "Antibiotics will not help; fluids, rest and honey are best and the cough can last three weeks. Don't skip meals, and try to eat smaller portions more often through the day. Come back or go to emergency straight away if you get a fever or breathlessness. Please come and see me if not better in three weeks. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.32,
      "end_seconds": 312.62,
      "duration_seconds": 7.3,
      "text": "So, I come back if not better in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.4,
      "end_seconds": 318.47,
      "duration_seconds": 4.07,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.94,
      "end_seconds": 323.85,
      "duration_seconds": 2.91,
      "text": "Actually, thank you, doctor, goodbye."
    }
  ]
}