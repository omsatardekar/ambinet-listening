{
  "schema_version": "1.0",
  "encounter_id": "02600",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.83,
      "duration_seconds": 3.69,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.54,
      "end_seconds": 10.73,
      "duration_seconds": 4.19,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.79,
      "end_seconds": 18.01,
      "duration_seconds": 6.22,
      "text": "Doctor, it's fainting on exertion. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.66,
      "end_seconds": 23.36,
      "duration_seconds": 3.7,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.6,
      "end_seconds": 26.77,
      "duration_seconds": 2.17,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.48,
      "end_seconds": 37.32,
      "duration_seconds": 9.84,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.22,
      "end_seconds": 44.52,
      "duration_seconds": 5.3,
      "text": "It happens on and off. About a three out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 48.08,
      "duration_seconds": 2.04,
      "text": "Have you had chest tightness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.66,
      "end_seconds": 61.53,
      "duration_seconds": 11.87,
      "text": "Mm, yes. As for chest tightness, mostly mild. Yes, exertion. That makes it worse. Oh, uh, and being very breathless. Had that since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.02,
      "end_seconds": 83.21,
      "duration_seconds": 3.19,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.34,
      "end_seconds": 99.37,
      "duration_seconds": 3.03,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.68,
      "end_seconds": 128.34,
      "duration_seconds": 10.66,
      "text": "Okay: pulse is 85 beats a minute, SpO2 89 percent on room air, blood pressure 139 over 90, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.4,
      "end_seconds": 134.39,
      "duration_seconds": 3.99,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.33,
      "end_seconds": 137.31,
      "duration_seconds": 1.98,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.41,
      "end_seconds": 156.39,
      "duration_seconds": 4.98,
      "text": "There is a loud second heart sound and a raised jugular pulse."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.32,
      "end_seconds": 162.68,
      "duration_seconds": 2.36,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.96,
      "end_seconds": 182.74,
      "duration_seconds": 1.78,
      "text": "Any sign of fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.63,
      "end_seconds": 186.86,
      "duration_seconds": 3.23,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.95,
      "end_seconds": 195.29,
      "duration_seconds": 2.34,
      "text": "Any leg pain or cough?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.97,
      "end_seconds": 204.28,
      "duration_seconds": 4.31,
      "text": "No leg pain or cough, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.01,
      "end_seconds": 208.95,
      "duration_seconds": 2.94,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.74,
      "end_seconds": 211.45,
      "duration_seconds": 1.71,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.45,
      "end_seconds": 218.45,
      "duration_seconds": 5.0,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.0,
      "end_seconds": 220.52,
      "duration_seconds": 1.52,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.72,
      "end_seconds": 225.1,
      "duration_seconds": 3.38,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.52,
      "end_seconds": 227.55,
      "duration_seconds": 1.03,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.58,
      "end_seconds": 230.92,
      "duration_seconds": 2.34,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.58,
      "end_seconds": 235.07,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.08,
      "end_seconds": 239.37,
      "duration_seconds": 2.29,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.22,
      "end_seconds": 248.5,
      "duration_seconds": 4.28,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.05,
      "end_seconds": 252.46,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.73,
      "end_seconds": 260.83,
      "duration_seconds": 3.1,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.77,
      "end_seconds": 278.5,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.16,
      "end_seconds": 284.53,
      "duration_seconds": 4.37,
      "text": "Seretide inhaler. I take it twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.49,
      "end_seconds": 288.35,
      "duration_seconds": 2.86,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.61,
      "end_seconds": 291.22,
      "duration_seconds": 1.61,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.82,
      "end_seconds": 296.79,
      "duration_seconds": 3.97,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.14,
      "end_seconds": 301.24,
      "duration_seconds": 3.1,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.8,
      "end_seconds": 314.02,
      "duration_seconds": 11.22,
      "text": "Okay, thinking it through, it points towards possible pulmonary hypertension. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.04,
      "end_seconds": 319.09,
      "duration_seconds": 3.05,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.78,
      "end_seconds": 347.73,
      "duration_seconds": 23.95,
      "text": "I can't promise yet, but most people with possible pulmonary hypertension do well once it's treated properly. I'd like to arrange an echocardiogram for exertional syncope. No exertion for now, I am arranging urgent specialist tests. Let's review you in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.55,
      "end_seconds": 355.11,
      "duration_seconds": 6.56,
      "text": "Sorry, what was I saying, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.26,
      "end_seconds": 357.64,
      "duration_seconds": 1.38,
      "text": "All the best."
    }
  ]
}