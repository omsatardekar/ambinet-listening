  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 2.93,
      "duration_seconds": 2.28,
      "text": "Okay, welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.21,
      "end_seconds": 5.34,
      "duration_seconds": 1.13,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 9.75,
      "duration_seconds": 2.95,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.98,
      "end_seconds": 15.29,
      "duration_seconds": 4.31,
      "text": "I wanted to get difficulty concentrating looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.02,
      "end_seconds": 19.02,
      "duration_seconds": 2.0,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.65,
      "end_seconds": 25.3,
      "duration_seconds": 5.65,
      "text": "I'm on Eltroxin, 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.13,
      "end_seconds": 32.45,
      "duration_seconds": 3.32,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.89,
      "end_seconds": 39.04,
      "duration_seconds": 4.15,
      "text": "Ah, it's been like this since last weekend."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.75,
      "end_seconds": 43.38,
      "duration_seconds": 2.63,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.9,
      "end_seconds": 49.66,
      "duration_seconds": 1.76,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.32,
      "end_seconds": 52.66,
      "duration_seconds": 2.34,
      "text": "Have you been losing things?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.96,
      "end_seconds": 57.44,
      "duration_seconds": 3.48,
      "text": "Ah, yes, for about a month."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.1,
      "end_seconds": 59.97,
      "duration_seconds": 1.87,
      "text": "Have you had restlessness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.68,
      "end_seconds": 64.89,
      "duration_seconds": 3.21,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.86,
      "end_seconds": 70.61,
      "duration_seconds": 3.75,
      "text": "Any head injury or drug use at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.31,
      "end_seconds": 78.48,
      "duration_seconds": 4.17,
      "text": "No, um, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.18,
      "end_seconds": 83.17,
      "duration_seconds": 3.99,
      "text": "Have you noticed thoughts of self-harm or low mood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.48,
      "end_seconds": 91.23,
      "duration_seconds": 6.75,
      "text": "I mean, um, no, no thoughts of self-harm or low mood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.05,
      "end_seconds": 94.03,
      "duration_seconds": 1.98,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.45,
      "end_seconds": 98.18,
      "duration_seconds": 2.73,
      "text": "I, I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.44,
      "end_seconds": 102.45,
      "duration_seconds": 3.01,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.25,
      "end_seconds": 106.54,
      "duration_seconds": 3.29,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.51,
      "end_seconds": 113.21,
      "duration_seconds": 4.7,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.33,
      "end_seconds": 129.78,
      "duration_seconds": 13.45,
      "text": "I work in accounts at a hospital. I grab fast food at lunch most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.44,
      "end_seconds": 148.89,
      "duration_seconds": 4.45,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.62,
      "end_seconds": 153.18,
      "duration_seconds": 2.56,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.9,
      "end_seconds": 164.76,
      "duration_seconds": 8.86,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.33,
      "end_seconds": 170.57,
      "duration_seconds": 4.24,
      "text": "Ah, uh, no, not at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.45,
      "end_seconds": 176.12,
      "duration_seconds": 3.67,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.55,
      "end_seconds": 179.62,
      "duration_seconds": 2.07,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.58,
      "end_seconds": 198.33,
      "duration_seconds": 5.75,
      "text": "Your pulse and blood pressure are normal and your examination is unremarkable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.04,
      "end_seconds": 201.68,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.39,
      "end_seconds": 209.89,
      "duration_seconds": 2.5,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.71,
      "end_seconds": 227.75,
      "duration_seconds": 7.04,
      "text": "So, based on the history and the examination, this looks most like possible adult attention deficit disorder."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.22,
      "end_seconds": 232.88,
      "duration_seconds": 3.66,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.44,
      "end_seconds": 245.78,
      "duration_seconds": 12.34,
      "text": "I understand the worry. At the moment I'd say it's possible adult attention deficit disorder, and we'll know more once the a thyroid test is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.02,
      "end_seconds": 268.75,
      "duration_seconds": 8.73,
      "text": "Let's get a thyroid test, for poor concentration. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 271.43,
      "end_seconds": 275.31,
      "duration_seconds": 3.88,
      "text": "I can book that for Thursday at 10 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.44,
      "end_seconds": 296.0,
      "duration_seconds": 19.56,
      "text": "Use lists and reminders while we arrange the specialist assessment. I'll also refer you to the adult ADHD service. I'm not ordering a questionnaire today. If things carry on next month, we'll consider it. Please come and see me after the assessment. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.02,
      "end_seconds": 301.11,
      "duration_seconds": 4.09,
      "text": "Ah, um, thank you, that's helpful."
    }
  ]
}