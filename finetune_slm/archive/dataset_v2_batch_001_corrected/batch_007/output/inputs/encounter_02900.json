{
  "schema_version": "1.0",
  "encounter_id": "02900",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.14,
      "end_seconds": 4.21,
      "duration_seconds": 3.07,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.32,
      "end_seconds": 7.93,
      "duration_seconds": 2.61,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.93,
      "end_seconds": 10.88,
      "duration_seconds": 1.95,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.87,
      "end_seconds": 21.53,
      "duration_seconds": 6.66,
      "text": "Mainly vomiting. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.27,
      "end_seconds": 24.33,
      "duration_seconds": 2.06,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.84,
      "end_seconds": 33.39,
      "duration_seconds": 8.55,
      "text": "It's been like this since last night. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.73,
      "end_seconds": 36.11,
      "duration_seconds": 2.38,
      "text": "Sure. How frequently does it come?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.99,
      "end_seconds": 40.38,
      "duration_seconds": 3.39,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.34,
      "end_seconds": 48.75,
      "duration_seconds": 3.41,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.19,
      "end_seconds": 60.25,
      "duration_seconds": 2.06,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.75,
      "end_seconds": 88.38,
      "duration_seconds": 11.63,
      "text": "Okay: blood pressure 96 over 66, height 163 centimetres, BMI works out to 34.3. And weight 91 kilos, pulse is 107 beats a minute."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.95,
      "end_seconds": 93.59,
      "duration_seconds": 3.64,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.15,
      "end_seconds": 102.65,
      "duration_seconds": 1.5,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.65,
      "end_seconds": 107.73,
      "duration_seconds": 3.08,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.61,
      "end_seconds": 122.9,
      "duration_seconds": 6.29,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.34,
      "end_seconds": 129.85,
      "duration_seconds": 2.51,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.61,
      "end_seconds": 143.66,
      "duration_seconds": 4.05,
      "text": "And what about fever, chest pain or fall?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.07,
      "end_seconds": 147.27,
      "duration_seconds": 2.2,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.26,
      "end_seconds": 150.44,
      "duration_seconds": 2.18,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.86,
      "end_seconds": 153.92,
      "duration_seconds": 2.06,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.5,
      "end_seconds": 158.8,
      "duration_seconds": 3.3,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.1,
      "end_seconds": 161.34,
      "duration_seconds": 1.24,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.05,
      "end_seconds": 179.82,
      "duration_seconds": 2.77,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.29,
      "end_seconds": 183.71,
      "duration_seconds": 2.42,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 197.52,
      "duration_seconds": 2.9,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.35,
      "end_seconds": 203.32,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.64,
      "end_seconds": 208.86,
      "duration_seconds": 4.22,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.73,
      "end_seconds": 214.48,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.01,
      "end_seconds": 222.7,
      "duration_seconds": 2.69,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.81,
      "end_seconds": 228.04,
      "duration_seconds": 4.23,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.69,
      "end_seconds": 234.49,
      "duration_seconds": 4.8,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.45,
      "end_seconds": 237.02,
      "duration_seconds": 1.57,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.36,
      "end_seconds": 240.87,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.92,
      "end_seconds": 243.91,
      "duration_seconds": 1.99,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.2,
      "end_seconds": 248.59,
      "duration_seconds": 3.39,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.92,
      "end_seconds": 252.63,
      "duration_seconds": 2.71,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.41,
      "end_seconds": 258.73,
      "duration_seconds": 5.32,
      "text": "Having listened and examined, this is probably a high calcium emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.56,
      "end_seconds": 265.53,
      "duration_seconds": 2.97,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.63,
      "end_seconds": 281.77,
      "duration_seconds": 15.14,
      "text": "I understand the worry. At the moment I'd say it's a high calcium emergency, and we'll know more once the an ECG is back. I think an ECG makes sense here, for hypercalcaemia."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.69,
      "end_seconds": 285.2,
      "duration_seconds": 1.51,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.54,
      "end_seconds": 304.19,
      "duration_seconds": 15.65,
      "text": "We'll begin with sodium chloride 0.9%, 1 litre, over one hour, single dose. That's for dehydration. You need hospital fluids and treatment now. See me again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.99,
      "end_seconds": 309.42,
      "duration_seconds": 3.43,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.94,
      "end_seconds": 311.14,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}