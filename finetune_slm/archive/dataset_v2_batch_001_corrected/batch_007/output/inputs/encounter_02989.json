{
  "schema_version": "1.0",
  "encounter_id": "02989",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 4.58,
      "duration_seconds": 3.45,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.04,
      "end_seconds": 9.83,
      "duration_seconds": 3.79,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.41,
      "end_seconds": 27.51,
      "duration_seconds": 13.1,
      "text": "It's periods becoming irregular, mostly. I didn't want to bother you but it keeps coming back. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.48,
      "end_seconds": 31.91,
      "duration_seconds": 2.43,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.25,
      "end_seconds": 43.31,
      "duration_seconds": 3.06,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.82,
      "end_seconds": 74.62,
      "duration_seconds": 9.8,
      "text": "Okay: temperature 36.9, SpO2 98 percent on room air, pulse is 85 beats a minute, pressure 126 over 77. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 78.69,
      "duration_seconds": 2.65,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.28,
      "end_seconds": 84.91,
      "duration_seconds": 5.63,
      "text": "Yes, carry on. Right, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.67,
      "end_seconds": 86.77,
      "duration_seconds": 1.1,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.35,
      "end_seconds": 107.77,
      "duration_seconds": 5.42,
      "text": "And what about very heavy bleeding, weight loss or bleeding after sex?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.77,
      "end_seconds": 118.13,
      "duration_seconds": 8.36,
      "text": "Let me think, I haven't had very heavy bleeding, weight loss or bleeding after sex, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.47,
      "end_seconds": 122.12,
      "duration_seconds": 3.65,
      "text": "Yes, carry on. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.97,
      "end_seconds": 125.61,
      "duration_seconds": 2.64,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.89,
      "end_seconds": 129.69,
      "duration_seconds": 2.8,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.4,
      "end_seconds": 133.17,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.89,
      "end_seconds": 137.24,
      "duration_seconds": 2.35,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.81,
      "end_seconds": 140.73,
      "duration_seconds": 2.92,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.72,
      "end_seconds": 148.53,
      "duration_seconds": 6.81,
      "text": "What do you take on a normal day? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.15,
      "end_seconds": 152.66,
      "duration_seconds": 3.51,
      "text": "I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.38,
      "end_seconds": 173.86,
      "duration_seconds": 3.48,
      "text": "So, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.88,
      "end_seconds": 187.6,
      "duration_seconds": 9.72,
      "text": "I live with my elderly mother. I'm a hairdresser, on my feet all day. I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.17,
      "end_seconds": 192.74,
      "duration_seconds": 4.57,
      "text": "So, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.21,
      "end_seconds": 196.35,
      "duration_seconds": 2.14,
      "text": "Asthma, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.33,
      "end_seconds": 207.76,
      "duration_seconds": 5.43,
      "text": "Mm, okay. Yes, asthma is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.3,
      "end_seconds": 225.88,
      "duration_seconds": 3.58,
      "text": "Okay, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.78,
      "end_seconds": 234.65,
      "duration_seconds": 3.87,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.44,
      "end_seconds": 239.97,
      "duration_seconds": 2.53,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.85,
      "end_seconds": 253.02,
      "duration_seconds": 1.17,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.13,
      "end_seconds": 256.51,
      "duration_seconds": 2.38,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.91,
      "end_seconds": 277.43,
      "duration_seconds": 4.52,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.2,
      "end_seconds": 280.16,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.64,
      "end_seconds": 298.23,
      "duration_seconds": 12.59,
      "text": "Thank you, you can get dressed. So where does that leave us? It fits best with perimenopause. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.12,
      "end_seconds": 302.57,
      "duration_seconds": 3.45,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.22,
      "end_seconds": 336.31,
      "duration_seconds": 32.09,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopause, but I'd like to confirm. I'm sending you for a thyroid test because of hot flushes. Let's get a blood count, for irregular periods. I'd like you to take estradiol gel, 1 pump, once a day, long term. It's for menopausal symptoms. Regular exercise, light layers and avoiding triggers can help. Please come and see me in three months."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.06,
      "end_seconds": 345.51,
      "duration_seconds": 5.45,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.51,
      "end_seconds": 350.97,
      "duration_seconds": 3.46,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.43,
      "end_seconds": 354.12,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}