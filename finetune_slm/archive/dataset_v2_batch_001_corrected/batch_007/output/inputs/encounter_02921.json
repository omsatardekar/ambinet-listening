{
  "schema_version": "1.0",
  "encounter_id": "02921",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 4.14,
      "duration_seconds": 2.93,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.25,
      "end_seconds": 8.82,
      "duration_seconds": 3.57,
      "text": "Afternoon, you know, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.42,
      "end_seconds": 12.56,
      "duration_seconds": 3.14,
      "text": "So, what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 22.68,
      "duration_seconds": 9.33,
      "text": "Sorry, what was I saying, honestly, it's being very confused, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.69,
      "end_seconds": 28.81,
      "duration_seconds": 4.12,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.63,
      "end_seconds": 43.74,
      "duration_seconds": 14.11,
      "text": "About... well, three days. My family kept telling me to get it checked. I've never really been one for hospitals. And there's bone pain as well, about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.86,
      "end_seconds": 49.28,
      "duration_seconds": 4.42,
      "text": "Right, and what about chest pain, fever or fall?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.78,
      "end_seconds": 52.83,
      "duration_seconds": 3.05,
      "text": "Hmm, none of those, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.37,
      "end_seconds": 57.0,
      "duration_seconds": 3.63,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.73,
      "end_seconds": 60.67,
      "duration_seconds": 2.94,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.15,
      "end_seconds": 64.49,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.61,
      "end_seconds": 66.59,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.32,
      "end_seconds": 71.63,
      "duration_seconds": 3.31,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.4,
      "end_seconds": 75.13,
      "duration_seconds": 2.73,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.55,
      "end_seconds": 81.31,
      "duration_seconds": 4.76,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.65,
      "end_seconds": 89.36,
      "duration_seconds": 6.71,
      "text": "Sorry, what was I saying, I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.48,
      "end_seconds": 91.59,
      "duration_seconds": 1.11,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.19,
      "end_seconds": 98.25,
      "duration_seconds": 5.06,
      "text": "Yeah, I've had high cholesterol for about a year now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.37,
      "end_seconds": 108.92,
      "duration_seconds": 9.55,
      "text": "Right, right. Okay, I can see high cholesterol in your file as well. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.66,
      "end_seconds": 115.61,
      "duration_seconds": 5.95,
      "text": "It's diclofenac, 50 milligrams, when needed. Atorvastatin. I take it at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.66,
      "end_seconds": 118.83,
      "duration_seconds": 2.17,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.54,
      "end_seconds": 126.87,
      "duration_seconds": 4.33,
      "text": "20 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.31,
      "end_seconds": 144.22,
      "duration_seconds": 3.91,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.51,
      "end_seconds": 149.37,
      "duration_seconds": 3.86,
      "text": "Okay, so no, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.89,
      "end_seconds": 153.73,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.6,
      "end_seconds": 157.33,
      "duration_seconds": 1.73,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.13,
      "end_seconds": 174.53,
      "duration_seconds": 1.4,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.42,
      "end_seconds": 179.38,
      "duration_seconds": 3.96,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.11,
      "end_seconds": 182.91,
      "duration_seconds": 1.8,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.59,
      "end_seconds": 189.45,
      "duration_seconds": 4.86,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.46,
      "end_seconds": 194.21,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.21,
      "end_seconds": 198.37,
      "duration_seconds": 3.16,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.88,
      "end_seconds": 201.64,
      "duration_seconds": 1.76,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.01,
      "end_seconds": 205.53,
      "duration_seconds": 2.52,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.84,
      "end_seconds": 210.53,
      "duration_seconds": 3.69,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.11,
      "end_seconds": 221.31,
      "duration_seconds": 2.2,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.68,
      "end_seconds": 250.8,
      "duration_seconds": 14.12,
      "text": "Okay: pulse 107, weight 98 kilos, height 159 centimetres. And respiratory rate 19, temp 36.4 degrees, SpO2 96 percent on room air, pressure 102 over 66, BMI works out to 38.8."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.84,
      "end_seconds": 257.11,
      "duration_seconds": 5.27,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.85,
      "end_seconds": 270.44,
      "duration_seconds": 1.59,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.12,
      "end_seconds": 274.24,
      "duration_seconds": 2.12,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.04,
      "end_seconds": 294.21,
      "duration_seconds": 6.17,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.28,
      "end_seconds": 298.53,
      "duration_seconds": 2.25,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.71,
      "end_seconds": 315.66,
      "duration_seconds": 9.95,
      "text": "Let me repeat that back to make sure. You've had being very confused for three days, and no chest pain or fall."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.42,
      "end_seconds": 323.21,
      "duration_seconds": 1.79,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.74,
      "end_seconds": 335.47,
      "duration_seconds": 11.73,
      "text": "Urgent blood tests is what I'd like next, for confusion and polyuria. Let's use sodium chloride 0.9%, 1 litre, over one hour, single dose. That's for dehydration."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.45,
      "end_seconds": 340.82,
      "duration_seconds": 3.37,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.64,
      "end_seconds": 353.71,
      "duration_seconds": 12.07,
      "text": "You need hospital fluids and treatment now. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.3,
      "end_seconds": 363.32,
      "duration_seconds": 8.02,
      "text": "So, I take the sodium chloride 0.9%, 1 litre, over one hour. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.3,
      "end_seconds": 369.7,
      "duration_seconds": 5.4,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.37,
      "end_seconds": 374.27,
      "duration_seconds": 2.9,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}