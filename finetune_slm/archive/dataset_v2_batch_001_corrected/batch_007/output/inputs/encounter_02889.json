{
  "schema_version": "1.0",
  "encounter_id": "02889",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 7.51,
      "duration_seconds": 6.58,
      "text": "So, you know, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.9,
      "end_seconds": 12.55,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.44,
      "end_seconds": 19.93,
      "duration_seconds": 5.49,
      "text": "Erm, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 26.26,
      "duration_seconds": 4.91,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.02,
      "end_seconds": 33.79,
      "duration_seconds": 6.77,
      "text": "Hmm, it's itchy blisters, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.4,
      "end_seconds": 36.4,
      "duration_seconds": 2.0,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.07,
      "end_seconds": 43.48,
      "duration_seconds": 6.41,
      "text": "Three days, I think... sorry, two days, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.03,
      "end_seconds": 47.4,
      "duration_seconds": 2.37,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.11,
      "end_seconds": 52.51,
      "duration_seconds": 4.4,
      "text": "It's, It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.28,
      "end_seconds": 56.23,
      "duration_seconds": 2.95,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.21,
      "end_seconds": 69.59,
      "duration_seconds": 12.38,
      "text": "An itchy rash first goes along with it, most of the time. Oh, you know, the itchy rash first? That's been for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.86,
      "end_seconds": 73.14,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.53,
      "end_seconds": 83.48,
      "duration_seconds": 2.95,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.04,
      "end_seconds": 102.62,
      "duration_seconds": 8.58,
      "text": "Okay: temperature is 36.6 degrees, blood pressure 125 over 68. And heart rate 66, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.39,
      "end_seconds": 106.21,
      "duration_seconds": 1.82,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.18,
      "end_seconds": 112.17,
      "duration_seconds": 1.99,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.27,
      "end_seconds": 115.25,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.34,
      "end_seconds": 117.59,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.3,
      "end_seconds": 139.25,
      "duration_seconds": 6.95,
      "text": "There are firm, tense blisters on a red base on the arms and legs."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.02,
      "end_seconds": 140.72,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.49,
      "end_seconds": 150.04,
      "duration_seconds": 6.55,
      "text": "That's the examination finished. Any new medicine, eye problems, mouth sores or fever at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.75,
      "end_seconds": 156.01,
      "duration_seconds": 4.26,
      "text": "Mm, no, none of those at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.99,
      "end_seconds": 160.34,
      "duration_seconds": 2.35,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.25,
      "end_seconds": 163.33,
      "duration_seconds": 2.08,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.31,
      "end_seconds": 167.84,
      "duration_seconds": 3.53,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.38,
      "end_seconds": 169.87,
      "duration_seconds": 1.49,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.1,
      "end_seconds": 190.94,
      "duration_seconds": 2.84,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.66,
      "end_seconds": 196.74,
      "duration_seconds": 5.08,
      "text": "Ramipril. I take it 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.34,
      "end_seconds": 201.55,
      "duration_seconds": 3.21,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.18,
      "end_seconds": 206.42,
      "duration_seconds": 4.24,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.18,
      "end_seconds": 210.87,
      "duration_seconds": 3.69,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.79,
      "end_seconds": 219.4,
      "duration_seconds": 3.61,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.49,
      "end_seconds": 226.94,
      "duration_seconds": 2.45,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.98,
      "end_seconds": 234.34,
      "duration_seconds": 6.36,
      "text": "So, um, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.13,
      "end_seconds": 239.7,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.74,
      "end_seconds": 245.7,
      "duration_seconds": 3.96,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.93,
      "end_seconds": 248.32,
      "duration_seconds": 1.39,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.78,
      "end_seconds": 253.81,
      "duration_seconds": 4.03,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.47,
      "end_seconds": 259.64,
      "duration_seconds": 1.17,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.69,
      "end_seconds": 264.49,
      "duration_seconds": 2.8,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.59,
      "end_seconds": 268.18,
      "duration_seconds": 1.59,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.12,
      "end_seconds": 273.86,
      "duration_seconds": 3.74,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.2,
      "end_seconds": 277.49,
      "duration_seconds": 2.29,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.35,
      "end_seconds": 283.53,
      "duration_seconds": 4.18,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.66,
      "end_seconds": 287.46,
      "duration_seconds": 2.8,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.41,
      "end_seconds": 293.13,
      "duration_seconds": 3.72,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.82,
      "end_seconds": 313.09,
      "duration_seconds": 10.27,
      "text": "Putting it all together, it fits best with bullous pemphigoid. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.41,
      "end_seconds": 316.86,
      "duration_seconds": 2.45,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.68,
      "end_seconds": 324.53,
      "duration_seconds": 5.85,
      "text": "Nothing I've seen today points to an emergency. It looks like bullous pemphigoid."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.26,
      "end_seconds": 354.61,
      "duration_seconds": 18.35,
      "text": "Do not burst the blisters and keep the raw areas dressed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.11,
      "end_seconds": 357.85,
      "duration_seconds": 1.74,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.6,
      "end_seconds": 360.0,
      "duration_seconds": 1.4,
      "text": "Look after yourself."
    }
  ]
}