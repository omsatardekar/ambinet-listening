{
  "schema_version": "1.0",
  "encounter_id": "02806",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.61,
      "duration_seconds": 4.73,
      "text": "ah, hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.25,
      "end_seconds": 11.56,
      "duration_seconds": 4.31,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.11,
      "end_seconds": 18.97,
      "duration_seconds": 3.86,
      "text": "well, I've been having a sudden high fever"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.92,
      "end_seconds": 24.84,
      "duration_seconds": 3.92,
      "text": "right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.89,
      "end_seconds": 31.38,
      "duration_seconds": 5.49,
      "text": "it's been five days now. Erm, there's vomiting and diarrhoea as well"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.05,
      "end_seconds": 34.86,
      "duration_seconds": 2.81,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.88,
      "end_seconds": 39.13,
      "duration_seconds": 3.25,
      "text": "Right, it feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.98,
      "end_seconds": 43.19,
      "duration_seconds": 2.21,
      "text": "Any sign of sore throat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.38,
      "end_seconds": 47.63,
      "duration_seconds": 3.25,
      "text": "Not that I've noticed, no sore throat."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.67,
      "end_seconds": 52.42,
      "duration_seconds": 2.75,
      "text": "Have you noticed cough or stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.86,
      "end_seconds": 56.06,
      "duration_seconds": 2.2,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.92,
      "end_seconds": 58.91,
      "duration_seconds": 1.99,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.54,
      "end_seconds": 63.12,
      "duration_seconds": 2.58,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.36,
      "end_seconds": 68.1,
      "duration_seconds": 3.74,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.89,
      "end_seconds": 72.2,
      "duration_seconds": 3.31,
      "text": "Um, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.94,
      "end_seconds": 85.6,
      "duration_seconds": 2.66,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.15,
      "end_seconds": 100.85,
      "duration_seconds": 13.7,
      "text": "I retired from the post office two years ago. I hardly move around during the day. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 113.84,
      "duration_seconds": 3.62,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.71,
      "end_seconds": 120.83,
      "duration_seconds": 6.12,
      "text": "so, I take Seretide inhaler, twice a day for my asthma"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.79,
      "end_seconds": 125.41,
      "duration_seconds": 2.62,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 133.1,
      "duration_seconds": 6.36,
      "text": "Yes, um, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.8,
      "end_seconds": 138.59,
      "duration_seconds": 4.79,
      "text": "so, tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.55,
      "end_seconds": 143.07,
      "duration_seconds": 2.52,
      "text": "Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.43,
      "end_seconds": 147.09,
      "duration_seconds": 2.66,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.28,
      "end_seconds": 152.81,
      "duration_seconds": 4.53,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.97,
      "end_seconds": 158.85,
      "duration_seconds": 3.88,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.76,
      "end_seconds": 161.99,
      "duration_seconds": 1.23,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 181.42,
      "duration_seconds": 8.67,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.39,
      "end_seconds": 188.42,
      "duration_seconds": 3.03,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.03,
      "end_seconds": 203.18,
      "duration_seconds": 5.15,
      "text": "Putting it all together, this is probably possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.36,
      "end_seconds": 207.83,
      "duration_seconds": 3.47,
      "text": "Is there something to to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.66,
      "end_seconds": 218.57,
      "duration_seconds": 8.91,
      "text": "Nothing I've seen today points to an emergency. It looks like possible toxic shock syndrome, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.18,
      "end_seconds": 239.44,
      "duration_seconds": 4.26,
      "text": "Let's get a vaginal swab, for possible toxic shock."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.24,
      "end_seconds": 249.28,
      "duration_seconds": 4.04,
      "text": "So, you know, how long will it take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.84,
      "end_seconds": 258.62,
      "duration_seconds": 8.78,
      "text": "I'm going to order blood cultures, for possible toxic shock. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.15,
      "end_seconds": 262.03,
      "duration_seconds": 2.88,
      "text": "Okay, uh, I'll do it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.77,
      "end_seconds": 269.34,
      "duration_seconds": 6.57,
      "text": "I'll start you on flucloxacillin, 2 grams, now, single dose. That's for possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.12,
      "end_seconds": 271.51,
      "duration_seconds": 1.39,
      "text": "that's simple enough"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.15,
      "end_seconds": 287.8,
      "duration_seconds": 14.65,
      "text": "Remove any tampon, you are going to hospital now. A short walk every day, even twenty minutes, will help more than you'd think. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.48,
      "end_seconds": 291.25,
      "duration_seconds": 1.77,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.46,
      "end_seconds": 301.27,
      "duration_seconds": 8.81,
      "text": "do get help quickly if the symptoms get worse how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.82,
      "end_seconds": 308.29,
      "duration_seconds": 5.47,
      "text": "So, I take the flucloxacillin, 2 grams, now. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.69,
      "end_seconds": 319.24,
      "duration_seconds": 7.55,
      "text": "yes, exactly right. Right, that's the plan. Do you want to to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.84,
      "end_seconds": 322.48,
      "duration_seconds": 1.64,
      "text": "that's clear, thanks"
    }
  ]
}