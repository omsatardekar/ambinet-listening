  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.31,
      "end_seconds": 5.2,
      "duration_seconds": 3.89,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.84,
      "end_seconds": 11.61,
      "duration_seconds": 4.77,
      "text": "great hello come in and sit down how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.77,
      "end_seconds": 18.46,
      "duration_seconds": 5.69,
      "text": "doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 23.24,
      "duration_seconds": 3.61,
      "text": "yes that's no problem at all please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.25,
      "end_seconds": 33.27,
      "duration_seconds": 8.02,
      "text": "I mean it's a blister on my heel i thought I'd wait but it it hasn't gone"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.35,
      "end_seconds": 41.71,
      "duration_seconds": 3.36,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.3,
      "end_seconds": 49.7,
      "duration_seconds": 7.4,
      "text": "I'd say about a month actually, uh, no, closer to to two months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.44,
      "end_seconds": 53.98,
      "duration_seconds": 2.54,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.98,
      "end_seconds": 62.68,
      "duration_seconds": 6.7,
      "text": "A little soreness goes along with it most of the the time"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.27,
      "end_seconds": 69.28,
      "duration_seconds": 3.01,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.67,
      "end_seconds": 72.52,
      "duration_seconds": 1.85,
      "text": "I'd call it mild"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.18,
      "end_seconds": 77.51,
      "duration_seconds": 4.33,
      "text": "what do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.95,
      "end_seconds": 83.03,
      "duration_seconds": 4.08,
      "text": "Gliclazide 80 milligrams twice a day for my sugar."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.72,
      "end_seconds": 99.06,
      "duration_seconds": 3.34,
      "text": "Okay do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.8,
      "end_seconds": 111.91,
      "duration_seconds": 12.11,
      "text": "actually, I've had heart failure, yes right, you know, I've had diabetes, yes i looked a few things up online, and that probably didn't help"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.55,
      "end_seconds": 123.95,
      "duration_seconds": 8.4,
      "text": "Right, right. Right, so heart failure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.59,
      "end_seconds": 142.14,
      "duration_seconds": 2.55,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.87,
      "end_seconds": 154.94,
      "duration_seconds": 11.07,
      "text": "I only drink at family occasions. I drink a lot of tea and snack through the day. I swim twice a week"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.04,
      "end_seconds": 168.08,
      "duration_seconds": 2.04,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.76,
      "end_seconds": 175.42,
      "duration_seconds": 5.66,
      "text": "just a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.37,
      "end_seconds": 180.65,
      "duration_seconds": 4.28,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.3,
      "end_seconds": 189.77,
      "duration_seconds": 6.47,
      "text": "okay, so my grandfather had a stroke hmm, my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.45,
      "end_seconds": 193.94,
      "duration_seconds": 2.49,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.0,
      "end_seconds": 197.48,
      "duration_seconds": 2.48,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 198.92,
      "end_seconds": 205.52,
      "duration_seconds": 6.6,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 209.34,
      "duration_seconds": 2.66,
      "text": "really? I don't think so"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.05,
      "end_seconds": 218.22,
      "duration_seconds": 8.17,
      "text": "Fair enough, I'll write down both versions. Let me check a a few things. Any pus or redness spreading?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.84,
      "end_seconds": 222.04,
      "duration_seconds": 3.2,
      "text": "no no pus or redness spreading"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.81,
      "end_seconds": 225.29,
      "duration_seconds": 1.48,
      "text": "how about fever?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.34,
      "end_seconds": 229.03,
      "duration_seconds": 1.69,
      "text": "No fever thankfully."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 229.66,
      "end_seconds": 234.87,
      "duration_seconds": 5.21,
      "text": "actually, doctor, I did notice fever. She doesn't always say"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.43,
      "end_seconds": 241.32,
      "duration_seconds": 5.89,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.65,
      "end_seconds": 249.98,
      "duration_seconds": 7.33,
      "text": "alright, I'll note both what you've said and and what you've noticed. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 251.75,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.47,
      "end_seconds": 257.04,
      "duration_seconds": 4.57,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.55,
      "end_seconds": 260.61,
      "duration_seconds": 2.06,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 266.31,
      "end_seconds": 275.74,
      "duration_seconds": 9.43,
      "text": "okay, so the vitals from earlier saturation 98 percent, temperature is 36.6 degrees, blood pressure 120 over 76, pulse is 84 beats a minute"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.77,
      "end_seconds": 278.47,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.29,
      "end_seconds": 284.49,
      "duration_seconds": 3.2,
      "text": "Right let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.49,
      "end_seconds": 286.95,
      "duration_seconds": 1.46,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.55,
      "end_seconds": 302.8,
      "duration_seconds": 7.25,
      "text": "it's an intact blister on the back of the heel with no redness around it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 308.68,
      "end_seconds": 309.67,
      "duration_seconds": 0.99,
      "text": "of course"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.99,
      "end_seconds": 326.95,
      "duration_seconds": 12.96,
      "text": "that's all I needed to check. Taking everything into account, my working impression is a simple friction blister. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.06,
      "end_seconds": 330.41,
      "duration_seconds": 2.35,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.09,
      "end_seconds": 353.7,
      "duration_seconds": 22.61,
      "text": "I understand the worry at the moment I'd say it's a simple friction blister, and we'll watch how it goes leave it intact, cover it with a padded plaster and change the shoes i'll want another look if it looks infected that's all from me any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.85,
      "end_seconds": 357.15,
      "duration_seconds": 2.3,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.71,
      "end_seconds": 361.13,
      "duration_seconds": 1.42,
      "text": "all the best"
    }
  ]
}