{
  "schema_version": "1.0",
  "encounter_id": "02836",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 7.25,
      "duration_seconds": 6.68,
      "text": "Ah, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 13.86,
      "duration_seconds": 4.98,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.33,
      "end_seconds": 19.99,
      "duration_seconds": 4.66,
      "text": "So the thing is, I've got breathlessness building over weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.23,
      "end_seconds": 24.29,
      "duration_seconds": 3.06,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.39,
      "end_seconds": 28.62,
      "duration_seconds": 3.23,
      "text": "Hmm, it's been two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.96,
      "end_seconds": 32.33,
      "duration_seconds": 3.37,
      "text": "Hm, okay. How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.41,
      "end_seconds": 35.23,
      "duration_seconds": 1.82,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.75,
      "end_seconds": 40.51,
      "duration_seconds": 3.76,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.64,
      "end_seconds": 49.39,
      "duration_seconds": 7.75,
      "text": "Erm, about a six out of ten. I've also had weight loss, for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.73,
      "end_seconds": 55.65,
      "duration_seconds": 4.92,
      "text": "Have you had any night sweats, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.3,
      "end_seconds": 62.49,
      "duration_seconds": 5.19,
      "text": "No, no night sweats, coughing up blood or fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.06,
      "end_seconds": 64.74,
      "duration_seconds": 1.68,
      "text": "What about leg swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.61,
      "end_seconds": 68.54,
      "duration_seconds": 1.93,
      "text": "No, no leg swelling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.31,
      "end_seconds": 72.07,
      "duration_seconds": 2.76,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.02,
      "end_seconds": 75.26,
      "duration_seconds": 2.24,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.04,
      "end_seconds": 80.88,
      "duration_seconds": 3.84,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.84,
      "end_seconds": 87.52,
      "duration_seconds": 5.68,
      "text": "Ah, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.01,
      "end_seconds": 91.73,
      "duration_seconds": 2.72,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.37,
      "end_seconds": 103.51,
      "duration_seconds": 10.14,
      "text": "I had a meniscus repair on my knee four years ago. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.12,
      "end_seconds": 107.75,
      "duration_seconds": 3.63,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.34,
      "end_seconds": 113.03,
      "duration_seconds": 3.69,
      "text": "Let me think, my son has asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.03,
      "end_seconds": 131.64,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.49,
      "end_seconds": 147.99,
      "duration_seconds": 14.5,
      "text": "I only drink at family occasions. I quit smoking around ten years ago. I'm a bus driver, so I sit for long hours. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.55,
      "end_seconds": 154.15,
      "duration_seconds": 5.6,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.52,
      "end_seconds": 158.17,
      "duration_seconds": 2.65,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.97,
      "end_seconds": 161.78,
      "duration_seconds": 2.81,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.89,
      "end_seconds": 174.25,
      "duration_seconds": 11.36,
      "text": "I have low haemoglobin. I told my wife I'd come today. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.12,
      "end_seconds": 180.24,
      "duration_seconds": 4.12,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.69,
      "end_seconds": 185.7,
      "duration_seconds": 4.01,
      "text": "Iron tablets. I take it once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.03,
      "end_seconds": 186.96,
      "duration_seconds": 0.93,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.43,
      "end_seconds": 192.67,
      "duration_seconds": 4.24,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.65,
      "end_seconds": 195.76,
      "duration_seconds": 2.11,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.3,
      "end_seconds": 213.8,
      "duration_seconds": 5.5,
      "text": "There is dullness to percussion and reduced breath sounds at the right base."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.35,
      "end_seconds": 219.76,
      "duration_seconds": 3.41,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.4,
      "end_seconds": 246.93,
      "duration_seconds": 12.53,
      "text": "From what you've told me and what I found, this is probably a pleural effusion needing a cause. It could also be a tumour, so we'll keep that open."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.81,
      "end_seconds": 251.33,
      "duration_seconds": 2.52,
      "text": "Ah, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.91,
      "end_seconds": 262.44,
      "duration_seconds": 10.53,
      "text": "It's reasonable to be concerned, but right now a pleural effusion needing a cause is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.03,
      "end_seconds": 283.6,
      "duration_seconds": 10.57,
      "text": "I think a chest X-ray makes sense here, for breathlessness. A pleural fluid sample is what I'd like next, for pleural effusion."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.62,
      "end_seconds": 289.83,
      "duration_seconds": 1.21,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.46,
      "end_seconds": 304.78,
      "duration_seconds": 14.32,
      "text": "I am arranging an urgent chest clinic review. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'll want another look after the scan."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.16,
      "end_seconds": 308.18,
      "duration_seconds": 2.02,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.85,
      "end_seconds": 315.38,
      "duration_seconds": 5.53,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.96,
      "end_seconds": 322.27,
      "duration_seconds": 5.31,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.83,
      "end_seconds": 328.31,
      "duration_seconds": 4.48,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.49,
      "end_seconds": 333.85,
      "duration_seconds": 4.36,
      "text": "No, you know, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.17,
      "end_seconds": 336.36,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}