{
  "schema_version": "1.0",
  "encounter_id": "02964",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.42,
      "duration_seconds": 5.22,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.97,
      "end_seconds": 11.88,
      "duration_seconds": 3.91,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.87,
      "end_seconds": 18.98,
      "duration_seconds": 6.11,
      "text": "So, doctor, it's sneezing in spring. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.36,
      "end_seconds": 22.65,
      "duration_seconds": 2.29,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.39,
      "end_seconds": 30.44,
      "duration_seconds": 7.05,
      "text": "Allopurinol, 100 milligrams, once a day for the gout. Metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.45,
      "end_seconds": 34.62,
      "duration_seconds": 2.17,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.35,
      "end_seconds": 37.43,
      "duration_seconds": 1.08,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.53,
      "end_seconds": 41.15,
      "duration_seconds": 1.62,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.12,
      "end_seconds": 43.97,
      "duration_seconds": 1.85,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.05,
      "end_seconds": 48.44,
      "duration_seconds": 3.39,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.37,
      "end_seconds": 53.04,
      "duration_seconds": 3.67,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.41,
      "end_seconds": 63.79,
      "duration_seconds": 10.38,
      "text": "I follow. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.04,
      "end_seconds": 89.52,
      "duration_seconds": 24.48,
      "text": "It happens every other day. It's severe, honestly. Yes, pollen. That makes it worse. As for runny itchy nose, I honestly can't say when that began. It might have been last month or the month before. And there's watery eyes as well, about a week now. About watery eyes, it's mild, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.6,
      "end_seconds": 110.38,
      "duration_seconds": 4.78,
      "text": "Did you get loss of smell, fever or facial pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.37,
      "end_seconds": 113.75,
      "duration_seconds": 2.38,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.36,
      "end_seconds": 117.71,
      "duration_seconds": 2.35,
      "text": "And wheeze, any of that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.78,
      "end_seconds": 121.54,
      "duration_seconds": 1.76,
      "text": "No wheeze, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 125.95,
      "duration_seconds": 2.49,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.48,
      "end_seconds": 131.85,
      "duration_seconds": 2.37,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.34,
      "end_seconds": 136.97,
      "duration_seconds": 3.63,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.03,
      "end_seconds": 140.85,
      "duration_seconds": 1.82,
      "text": "I've got low haemoglobin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.36,
      "end_seconds": 142.13,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.43,
      "end_seconds": 147.2,
      "duration_seconds": 3.77,
      "text": "Gout, for two years. Yes, heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.54,
      "end_seconds": 154.82,
      "duration_seconds": 6.28,
      "text": "Sure. Right, yes, gout is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.42,
      "end_seconds": 168.8,
      "duration_seconds": 1.38,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.33,
      "end_seconds": 173.84,
      "duration_seconds": 3.51,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.14,
      "end_seconds": 178.53,
      "duration_seconds": 2.39,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.39,
      "end_seconds": 187.34,
      "duration_seconds": 3.95,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.78,
      "end_seconds": 192.78,
      "duration_seconds": 4.0,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.74,
      "end_seconds": 198.67,
      "duration_seconds": 3.93,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.3,
      "end_seconds": 202.04,
      "duration_seconds": 1.74,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.67,
      "end_seconds": 205.92,
      "duration_seconds": 2.25,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.57,
      "end_seconds": 209.98,
      "duration_seconds": 2.41,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.86,
      "end_seconds": 220.66,
      "duration_seconds": 9.8,
      "text": "I had two stents put in my heart three years ago. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 227.48,
      "duration_seconds": 5.04,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.11,
      "end_seconds": 240.0,
      "duration_seconds": 10.89,
      "text": "So, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.0,
      "end_seconds": 244.71,
      "duration_seconds": 2.71,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.05,
      "end_seconds": 258.72,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.02,
      "end_seconds": 277.67,
      "duration_seconds": 8.65,
      "text": "Okay: saturation 99 percent, BP is 110 over 77, respiratory rate 16, pulse 86, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.55,
      "end_seconds": 279.99,
      "duration_seconds": 1.44,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.53,
      "end_seconds": 283.96,
      "duration_seconds": 3.43,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.42,
      "end_seconds": 291.64,
      "duration_seconds": 5.22,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.5,
      "end_seconds": 294.62,
      "duration_seconds": 2.12,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.42,
      "end_seconds": 307.67,
      "duration_seconds": 5.25,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.07,
      "end_seconds": 316.14,
      "duration_seconds": 3.07,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.82,
      "end_seconds": 345.78,
      "duration_seconds": 14.96,
      "text": "Okay, so my impression is this: It points towards seasonal allergic rhinitis. Let me just check I've got this right. You've had sneezing in spring, since this morning, severe, and no loss of smell or fever."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.19,
      "end_seconds": 347.89,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.18,
      "end_seconds": 357.24,
      "duration_seconds": 8.06,
      "text": "I'll start you on fluticasone nasal spray, 50 micrograms, once a day, the season. That's for hay fever."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.22,
      "end_seconds": 362.82,
      "duration_seconds": 3.6,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.78,
      "end_seconds": 384.55,
      "duration_seconds": 19.77,
      "text": "Shower after being outdoors and keep windows shut when pollen is high. If you smoke, this is a good moment to think about stopping, and we can help you with that. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.2,
      "end_seconds": 386.88,
      "duration_seconds": 1.68,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.94,
      "end_seconds": 394.45,
      "duration_seconds": 5.51,
      "text": "Come back if not better in a month. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.65,
      "end_seconds": 398.61,
      "duration_seconds": 2.96,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}