  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 6.55,
      "duration_seconds": 5.44,
      "text": "Um, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.82,
      "end_seconds": 11.49,
      "duration_seconds": 3.67,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.19,
      "end_seconds": 22.97,
      "duration_seconds": 9.78,
      "text": "mainly a new headache at the temple. There's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.47,
      "end_seconds": 26.7,
      "duration_seconds": 3.23,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.13,
      "end_seconds": 31.05,
      "duration_seconds": 2.92,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.55,
      "end_seconds": 37.33,
      "duration_seconds": 2.78,
      "text": "how much does it it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.02,
      "end_seconds": 60.94,
      "duration_seconds": 21.92,
      "text": "sorry, you know, what was I saying, maybe a three out of ten on a bad day. I've also had blurred vision in one eye, since yesterday. And there's a scalp that hurts to brush as well, two months now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.57,
      "end_seconds": 69.31,
      "duration_seconds": 6.74,
      "text": "Have you had a new headache at the temple before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.81,
      "end_seconds": 79.71,
      "duration_seconds": 8.9,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.92,
      "end_seconds": 97.7,
      "duration_seconds": 4.78,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.46,
      "end_seconds": 105.1,
      "duration_seconds": 5.64,
      "text": "Diclofenac. I come out in... well, swelling of my lips."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.91,
      "end_seconds": 109.98,
      "duration_seconds": 3.07,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.72,
      "end_seconds": 113.16,
      "duration_seconds": 2.44,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.66,
      "end_seconds": 119.59,
      "duration_seconds": 4.93,
      "text": "are you taking anything regularly including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.65,
      "end_seconds": 135.07,
      "duration_seconds": 14.42,
      "text": "I'm on alendronate 70 milligrams once a week. I'm not great at remembering details so bear with me. I take simvastatin 20 milligrams at night."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.92,
      "end_seconds": 138.89,
      "duration_seconds": 2.97,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.46,
      "end_seconds": 142.48,
      "duration_seconds": 3.02,
      "text": "Thin bones, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.0,
      "end_seconds": 144.7,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.6,
      "end_seconds": 149.1,
      "duration_seconds": 3.5,
      "text": "High cholesterol, for about a year"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.01,
      "end_seconds": 161.11,
      "duration_seconds": 10.1,
      "text": "right, so thin bones and high cholesterol are already on your record we'll keep that in mind today a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.03,
      "end_seconds": 179.75,
      "duration_seconds": 17.72,
      "text": "I smoke roughly a pack every two days. I hardly move around during the day. No, I share a house with my brother. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.04,
      "end_seconds": 186.2,
      "duration_seconds": 4.16,
      "text": "Have you had any weight loss fever or shoulder stiffness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.09,
      "end_seconds": 193.69,
      "duration_seconds": 2.6,
      "text": "no nothing to report there"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.79,
      "end_seconds": 199.97,
      "duration_seconds": 5.18,
      "text": "so any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.32,
      "end_seconds": 202.84,
      "duration_seconds": 1.52,
      "text": "Nothing unusual no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.52,
      "end_seconds": 206.12,
      "duration_seconds": 2.6,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 214.9,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.26,
      "end_seconds": 236.74,
      "duration_seconds": 9.48,
      "text": "Okay: pressure 120 over 68, respiratory rate 17, temperature is 36.5 degrees, pulse is 67 beats a minute, saturation 97 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.9,
      "end_seconds": 240.6,
      "duration_seconds": 2.7,
      "text": "is that that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.96,
      "end_seconds": 244.31,
      "duration_seconds": 2.35,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.12,
      "end_seconds": 252.07,
      "duration_seconds": 4.95,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.9,
      "end_seconds": 254.96,
      "duration_seconds": 2.06,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.79,
      "end_seconds": 271.1,
      "duration_seconds": 4.31,
      "text": "the temporal artery is hard, tender and has no pulse"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.63,
      "end_seconds": 278.06,
      "duration_seconds": 2.43,
      "text": "right, that's the examination finished"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.04,
      "end_seconds": 300.83,
      "duration_seconds": 12.79,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be possible giant cell arteritis threatening sight, or it might be a migraine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.91,
      "end_seconds": 305.12,
      "duration_seconds": 2.21,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.4,
      "end_seconds": 319.32,
      "duration_seconds": 12.92,
      "text": "I understand the worry at the moment I'd say it's possible giant cell arteritis threatening sight, and we'll know more once the a temporal artery biopsy is back"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.05,
      "end_seconds": 335.73,
      "duration_seconds": 5.68,
      "text": "I'm going to order a temporal artery biopsy, for possible giant cell arteritis"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 336.84,
      "end_seconds": 341.36,
      "duration_seconds": 4.52,
      "text": "we have a slot Monday at 9 am, if that works"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.11,
      "end_seconds": 366.2,
      "duration_seconds": 23.09,
      "text": "I'd like to arrange urgent blood tests for possible giant cell arteritis. You'll be taking prednisolone, 60 milligrams, once a day, until review. That's for possible giant cell arteritis. Start the steroid today, this is to protect your sight. The The rheumatology team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.17,
      "end_seconds": 370.44,
      "duration_seconds": 3.27,
      "text": "So sure where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.33,
      "end_seconds": 374.71,
      "duration_seconds": 2.38,
      "text": "please come and see me tomorrow"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.39,
      "end_seconds": 376.09,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.22,
      "end_seconds": 382.74,
      "duration_seconds": 2.52,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.83,
      "end_seconds": 387.73,
      "duration_seconds": 2.9,
      "text": "Actually, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.44,
      "end_seconds": 390.64,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
