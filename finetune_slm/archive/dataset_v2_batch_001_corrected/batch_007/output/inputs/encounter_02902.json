{
  "schema_version": "1.0",
  "encounter_id": "02902",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.32,
      "duration_seconds": 3.76,
      "text": "Erm, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.15,
      "end_seconds": 10.69,
      "duration_seconds": 4.54,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.29,
      "end_seconds": 16.23,
      "duration_seconds": 3.94,
      "text": "Well, um, I've been having vomiting."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.93,
      "end_seconds": 20.71,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.42,
      "end_seconds": 30.28,
      "duration_seconds": 8.86,
      "text": "Let me think, you know, it's been going on for two weeks. Oh, and bone pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.49,
      "end_seconds": 40.17,
      "duration_seconds": 8.68,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.35,
      "end_seconds": 51.54,
      "duration_seconds": 5.19,
      "text": "It's once or twice a day. It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.57,
      "end_seconds": 65.62,
      "duration_seconds": 4.05,
      "text": "Alright, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 71.59,
      "duration_seconds": 5.16,
      "text": "No, you know, I don't take any tablets."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.98,
      "end_seconds": 92.37,
      "duration_seconds": 4.39,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.16,
      "end_seconds": 103.25,
      "duration_seconds": 10.09,
      "text": "I've got thin bones. Sorry, what was I saying, I've had gout for about a year now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.45,
      "end_seconds": 113.3,
      "duration_seconds": 8.85,
      "text": "Alright, thin bones and gout, that matches what I have here. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 118.54,
      "duration_seconds": 1.77,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.19,
      "end_seconds": 120.06,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.67,
      "end_seconds": 125.6,
      "duration_seconds": 3.93,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.13,
      "end_seconds": 128.68,
      "duration_seconds": 1.55,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.99,
      "end_seconds": 135.16,
      "duration_seconds": 5.17,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.03,
      "end_seconds": 137.72,
      "duration_seconds": 1.69,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.31,
      "end_seconds": 142.02,
      "duration_seconds": 3.71,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 147.35,
      "duration_seconds": 4.06,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.33,
      "end_seconds": 152.44,
      "duration_seconds": 4.11,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 155.6,
      "duration_seconds": 2.18,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.52,
      "end_seconds": 160.72,
      "duration_seconds": 3.2,
      "text": "No, uh, none, no fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.55,
      "end_seconds": 164.84,
      "duration_seconds": 2.29,
      "text": "Any chest pain or fall?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.33,
      "end_seconds": 169.27,
      "duration_seconds": 2.94,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.86,
      "end_seconds": 175.35,
      "duration_seconds": 4.49,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.9,
      "end_seconds": 177.97,
      "duration_seconds": 2.07,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.54,
      "end_seconds": 180.27,
      "duration_seconds": 1.73,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.42,
      "end_seconds": 183.14,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.4,
      "end_seconds": 187.9,
      "duration_seconds": 3.5,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.81,
      "end_seconds": 202.19,
      "duration_seconds": 2.38,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.87,
      "end_seconds": 227.8,
      "duration_seconds": 6.93,
      "text": "Okay: blood pressure 97 over 64, saturation 99 percent, pulse 111. And temperature 36.6."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.29,
      "end_seconds": 231.02,
      "duration_seconds": 1.73,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.75,
      "end_seconds": 236.25,
      "duration_seconds": 4.5,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.16,
      "end_seconds": 241.88,
      "duration_seconds": 2.72,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.41,
      "end_seconds": 250.5,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 253.26,
      "duration_seconds": 1.39,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.32,
      "end_seconds": 268.25,
      "duration_seconds": 5.93,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.73,
      "end_seconds": 279.16,
      "duration_seconds": 7.43,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. I'd lean towards a high calcium emergency."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.21,
      "end_seconds": 284.38,
      "duration_seconds": 3.17,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.46,
      "end_seconds": 300.91,
      "duration_seconds": 14.45,
      "text": "I can't promise yet, but most people with a high calcium emergency do well once it's treated properly. I'll request urgent blood tests, it'll help with confusion and polyuria."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 302.87,
      "end_seconds": 308.42,
      "duration_seconds": 5.55,
      "text": "We have a slot Monday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.28,
      "end_seconds": 312.35,
      "duration_seconds": 2.07,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.41,
      "end_seconds": 337.59,
      "duration_seconds": 24.18,
      "text": "I'm going to order an ECG, for hypercalcaemia. You'll be taking sodium chloride 0.9%, 1 litre, over one hour, single dose. That should help with dehydration. You need hospital fluids and treatment now. We'll refer you to the emergency team. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.19,
      "end_seconds": 341.65,
      "duration_seconds": 3.46,
      "text": "Okay, uh, I'll arrange it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.42,
      "end_seconds": 345.81,
      "duration_seconds": 3.39,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.55,
      "end_seconds": 349.24,
      "duration_seconds": 1.69,
      "text": "That's clear, thanks."
    }
  ]
}