{
  "schema_version": "1.0",
  "encounter_id": "02562",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 3.35,
      "duration_seconds": 2.84,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.88,
      "end_seconds": 5.9,
      "duration_seconds": 1.02,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.45,
      "end_seconds": 11.47,
      "duration_seconds": 2.02,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.04,
      "end_seconds": 21.02,
      "duration_seconds": 8.98,
      "text": "Mainly a growing red ring on my thigh. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 24.04,
      "duration_seconds": 2.14,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.24,
      "end_seconds": 31.76,
      "duration_seconds": 6.52,
      "text": "Probably three days. Yeah. There was a mild headache, yes, but that went away."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.29,
      "end_seconds": 40.82,
      "duration_seconds": 7.53,
      "text": "Have you had a a growing red ring on your thigh before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.88,
      "end_seconds": 49.03,
      "duration_seconds": 6.15,
      "text": "I had a a similar thing about six months ago it went away"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.11,
      "end_seconds": 54.56,
      "duration_seconds": 2.45,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.43,
      "end_seconds": 69.2,
      "duration_seconds": 11.77,
      "text": "I hardly move around during the day. My partner and our baby. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.17,
      "end_seconds": 86.97,
      "duration_seconds": 3.8,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.0,
      "end_seconds": 92.36,
      "duration_seconds": 3.36,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.87,
      "end_seconds": 96.05,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.72,
      "end_seconds": 97.77,
      "duration_seconds": 1.05,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.38,
      "end_seconds": 100.76,
      "duration_seconds": 1.38,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.85,
      "end_seconds": 108.1,
      "duration_seconds": 5.25,
      "text": "I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.07,
      "end_seconds": 111.01,
      "duration_seconds": 0.94,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.12,
      "end_seconds": 114.11,
      "duration_seconds": 1.99,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.94,
      "end_seconds": 124.82,
      "duration_seconds": 8.88,
      "text": "I see, go ahead. Yes, diabetes and high blood pressure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.8,
      "end_seconds": 144.27,
      "duration_seconds": 3.47,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.81,
      "end_seconds": 157.69,
      "duration_seconds": 11.88,
      "text": "Amlodipine. I take it 5 milligrams, once a day. Aspirin. I take it 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.95,
      "end_seconds": 169.27,
      "duration_seconds": 3.32,
      "text": "alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.96,
      "end_seconds": 175.03,
      "duration_seconds": 4.07,
      "text": "I had a a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.12,
      "end_seconds": 180.87,
      "duration_seconds": 3.75,
      "text": "did you get facial weakness or stiff neck?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.22,
      "end_seconds": 187.35,
      "duration_seconds": 5.13,
      "text": "No facial weakness or stiff neck, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.18,
      "end_seconds": 192.7,
      "duration_seconds": 3.52,
      "text": "have you had any palpitations or joint swelling?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.5,
      "end_seconds": 196.02,
      "duration_seconds": 2.52,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.62,
      "end_seconds": 199.16,
      "duration_seconds": 2.54,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.17,
      "end_seconds": 203.69,
      "duration_seconds": 3.52,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.39,
      "end_seconds": 207.74,
      "duration_seconds": 2.35,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.54,
      "end_seconds": 209.64,
      "duration_seconds": 1.1,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.85,
      "end_seconds": 213.44,
      "duration_seconds": 2.59,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.07,
      "end_seconds": 224.24,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.37,
      "end_seconds": 253.85,
      "duration_seconds": 8.48,
      "text": "Okay: temperature 36.8, SpO2 98 percent on room air. And pulse 71, blood pressure 126 over 81."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.5,
      "end_seconds": 257.11,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.65,
      "end_seconds": 260.8,
      "duration_seconds": 2.15,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.78,
      "end_seconds": 266.12,
      "duration_seconds": 2.34,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.99,
      "end_seconds": 270.12,
      "duration_seconds": 2.13,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.73,
      "end_seconds": 287.72,
      "duration_seconds": 6.99,
      "text": "There is an expanding ring-shaped red patch, about eight centimetres across, on the thigh."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.0,
      "end_seconds": 325.02,
      "duration_seconds": 34.02,
      "text": "okay, please sit back down. So where does that leave us? It points towards early Lyme disease. I'd also keep cellulitis in mind. What I'm giving you is doxycycline, 100 milligrams, twice a day, twenty-one days. You take it by mouth. That should help with early Lyme disease. Take the doxycycline with food and avoid strong sun. Cut down on salt and fried food for now, it really does make a difference"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.47,
      "end_seconds": 334.51,
      "duration_seconds": 6.04,
      "text": "one warning sign to remember: the symptoms get worse. In that case don't wait"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.89,
      "end_seconds": 337.69,
      "duration_seconds": 1.8,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.23,
      "end_seconds": 343.19,
      "duration_seconds": 4.96,
      "text": "Come back in three weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.67,
      "end_seconds": 351.68,
      "duration_seconds": 3.01,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}