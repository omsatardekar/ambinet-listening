{
  "schema_version": "1.0",
  "encounter_id": "02986",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 6.91,
      "duration_seconds": 5.57,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 12.67,
      "duration_seconds": 4.42,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.38,
      "end_seconds": 17.91,
      "duration_seconds": 4.53,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 23.77,
      "duration_seconds": 4.65,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.99,
      "end_seconds": 31.54,
      "duration_seconds": 6.55,
      "text": "Hmm, doctor, it's being thirsty. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.52,
      "end_seconds": 36.19,
      "duration_seconds": 3.67,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.73,
      "end_seconds": 41.05,
      "duration_seconds": 3.32,
      "text": "Ever since... since last night, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.4,
      "end_seconds": 47.08,
      "duration_seconds": 5.68,
      "text": "Okay, go on. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.83,
      "end_seconds": 51.76,
      "duration_seconds": 2.93,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.31,
      "end_seconds": 57.74,
      "duration_seconds": 2.43,
      "text": "Have you been passing kidney stones?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.27,
      "end_seconds": 63.97,
      "duration_seconds": 4.7,
      "text": "Hmm, yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.04,
      "end_seconds": 69.59,
      "duration_seconds": 3.55,
      "text": "So, has there been aching bones too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.9,
      "end_seconds": 72.15,
      "duration_seconds": 1.25,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.21,
      "end_seconds": 77.06,
      "duration_seconds": 3.85,
      "text": "So, any fever or low mood at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.83,
      "end_seconds": 81.81,
      "duration_seconds": 2.98,
      "text": "Actually, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.24,
      "end_seconds": 85.28,
      "duration_seconds": 2.04,
      "text": "Any fractures or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.85,
      "end_seconds": 90.05,
      "duration_seconds": 4.2,
      "text": "Um, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.28,
      "end_seconds": 96.96,
      "duration_seconds": 2.68,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.85,
      "end_seconds": 104.81,
      "duration_seconds": 5.96,
      "text": "Sorry, what was I saying, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.96,
      "end_seconds": 108.37,
      "duration_seconds": 2.41,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.91,
      "end_seconds": 113.88,
      "duration_seconds": 4.97,
      "text": "I, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.45,
      "end_seconds": 135.94,
      "duration_seconds": 4.49,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.95,
      "end_seconds": 141.77,
      "duration_seconds": 4.82,
      "text": "I'm, I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 142.7,
      "end_seconds": 154.16,
      "duration_seconds": 11.46,
      "text": "Sorry, what was I saying, she is supposed to take it once a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.62,
      "end_seconds": 157.49,
      "duration_seconds": 1.87,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.74,
      "end_seconds": 162.32,
      "duration_seconds": 3.58,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.98,
      "end_seconds": 166.22,
      "duration_seconds": 3.24,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.83,
      "end_seconds": 174.56,
      "duration_seconds": 3.73,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.38,
      "end_seconds": 178.3,
      "duration_seconds": 2.92,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.04,
      "end_seconds": 183.26,
      "duration_seconds": 3.22,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.32,
      "end_seconds": 188.14,
      "duration_seconds": 3.82,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.8,
      "end_seconds": 191.66,
      "duration_seconds": 2.86,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.38,
      "end_seconds": 203.68,
      "duration_seconds": 4.3,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.79,
      "end_seconds": 213.35,
      "duration_seconds": 8.56,
      "text": "Mm, uh, I've had COPD, yes. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.49,
      "end_seconds": 219.92,
      "duration_seconds": 5.43,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.97,
      "end_seconds": 222.54,
      "duration_seconds": 1.57,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.63,
      "end_seconds": 229.34,
      "duration_seconds": 2.71,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.39,
      "end_seconds": 245.2,
      "duration_seconds": 2.81,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.6,
      "end_seconds": 276.54,
      "duration_seconds": 9.94,
      "text": "Okay: height 179 centimetres, heart rate 79, respiratory rate 15, weight 79 kilos, pressure 123 over 79, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.7,
      "end_seconds": 279.96,
      "duration_seconds": 2.26,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.42,
      "end_seconds": 297.52,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 301.28,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.27,
      "end_seconds": 321.51,
      "duration_seconds": 5.24,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.71,
      "end_seconds": 355.64,
      "duration_seconds": 29.93,
      "text": "All finished, thank you. So, based on the history and the examination, it points towards possible raised calcium from an overactive parathyroid. We shouldn't forget vitamin D excess. A kidney ultrasound is what I'd like next, for kidney stones. It's a routine test and it'll give us a much clearer picture. I think a bone density scan makes sense here, for possible hyperparathyroidism. Drink plenty of water and avoid calcium supplements until the results."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.34,
      "end_seconds": 368.69,
      "duration_seconds": 12.35,
      "text": "I think the endocrine clinic should see you too. I'll want another look after the results. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.68,
      "end_seconds": 376.71,
      "duration_seconds": 6.03,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.42,
      "end_seconds": 382.37,
      "duration_seconds": 4.95,
      "text": "Alright, yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.28,
      "end_seconds": 388.43,
      "duration_seconds": 5.15,
      "text": "Good, you know, thanks, I'll see you then."
    }
  ]
}