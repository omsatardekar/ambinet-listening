{
  "schema_version": "1.0",
  "encounter_id": "02951",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 3.12,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.76,
      "end_seconds": 8.78,
      "duration_seconds": 4.02,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.1,
      "end_seconds": 19.27,
      "duration_seconds": 9.17,
      "text": "I'm here because of a rolled ankle. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.18,
      "end_seconds": 23.57,
      "duration_seconds": 3.39,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.3,
      "end_seconds": 27.67,
      "duration_seconds": 2.37,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.3,
      "end_seconds": 31.0,
      "duration_seconds": 1.7,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.73,
      "end_seconds": 35.46,
      "duration_seconds": 3.73,
      "text": "I, I notice it more with walking"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.69,
      "end_seconds": 39.61,
      "duration_seconds": 2.92,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.55,
      "end_seconds": 44.51,
      "duration_seconds": 3.96,
      "text": "yes, tramadol, it gives me feeling very drowsy"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.69,
      "end_seconds": 48.29,
      "duration_seconds": 2.6,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.21,
      "end_seconds": 52.72,
      "duration_seconds": 3.51,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.96,
      "end_seconds": 57.51,
      "duration_seconds": 3.55,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.98,
      "end_seconds": 61.86,
      "duration_seconds": 2.88,
      "text": "Right, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.02,
      "end_seconds": 66.87,
      "duration_seconds": 3.85,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.29,
      "end_seconds": 69.8,
      "duration_seconds": 1.51,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.69,
      "end_seconds": 74.8,
      "duration_seconds": 4.11,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.06,
      "end_seconds": 93.24,
      "duration_seconds": 17.18,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.64,
      "end_seconds": 105.92,
      "duration_seconds": 3.28,
      "text": "Any sign of pain in the shin?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.46,
      "end_seconds": 110.73,
      "duration_seconds": 3.27,
      "text": "No. No pain in the shin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.68,
      "end_seconds": 118.96,
      "duration_seconds": 4.28,
      "text": "did you get numbness, pop or pain in the foot?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.57,
      "end_seconds": 124.58,
      "duration_seconds": 4.01,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.25,
      "end_seconds": 128.92,
      "duration_seconds": 3.67,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.6,
      "end_seconds": 133.11,
      "duration_seconds": 2.51,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.79,
      "end_seconds": 147.95,
      "duration_seconds": 3.16,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.6,
      "end_seconds": 162.31,
      "duration_seconds": 2.71,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.98,
      "end_seconds": 183.24,
      "duration_seconds": 9.26,
      "text": "okay: pulse 67, blood pressure 119 over 82, temperature is 36.6 degrees and SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.31,
      "end_seconds": 188.75,
      "duration_seconds": 3.44,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.73,
      "end_seconds": 193.8,
      "duration_seconds": 4.07,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.77,
      "end_seconds": 199.93,
      "duration_seconds": 4.16,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.22,
      "end_seconds": 204.07,
      "duration_seconds": 2.85,
      "text": "So, raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.67,
      "end_seconds": 227.95,
      "duration_seconds": 7.28,
      "text": "There is mild swelling over the outer ankle but no bony tenderness and you can take four steps."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.73,
      "end_seconds": 234.57,
      "duration_seconds": 1.84,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.1,
      "end_seconds": 256.27,
      "duration_seconds": 5.17,
      "text": "Having listened and examined, this is probably a mild ankle sprain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.51,
      "end_seconds": 263.18,
      "duration_seconds": 5.67,
      "text": "let me think, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.96,
      "end_seconds": 274.9,
      "duration_seconds": 8.94,
      "text": "I understand the worry. At the moment I'd say it's a mild ankle sprain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.4,
      "end_seconds": 299.12,
      "duration_seconds": 8.72,
      "text": "rest, ice, compression and elevation, then gradual strengthening let's review you if not better in two weeks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.11,
      "end_seconds": 304.23,
      "duration_seconds": 3.12,
      "text": "Alright, uh, I'll be back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.25,
      "end_seconds": 315.75,
      "duration_seconds": 6.5,
      "text": "tell me what you've taken from all that, so I can fill in any gaps"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.68,
      "end_seconds": 324.1,
      "duration_seconds": 6.42,
      "text": "So, I come back if not better in two weeks. Is that that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.0,
      "end_seconds": 329.58,
      "duration_seconds": 4.58,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.67,
      "end_seconds": 332.97,
      "duration_seconds": 2.3,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.56,
      "end_seconds": 335.22,
      "duration_seconds": 1.66,
      "text": "Have a good day."
    }
  ]
}