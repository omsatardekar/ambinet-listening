{
  "schema_version": "1.0",
  "encounter_id": "02609",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 8.36,
      "duration_seconds": 7.35,
      "text": "Sorry, uh, what was I saying, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.83,
      "end_seconds": 14.09,
      "duration_seconds": 4.26,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.97,
      "end_seconds": 23.38,
      "duration_seconds": 7.41,
      "text": "Um, uh, so... pain under the right ribs. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.85,
      "end_seconds": 28.28,
      "duration_seconds": 3.43,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.56,
      "end_seconds": 32.94,
      "duration_seconds": 3.38,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.92,
      "end_seconds": 37.72,
      "duration_seconds": 2.8,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.24,
      "end_seconds": 41.46,
      "duration_seconds": 3.22,
      "text": "I mean, I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.34,
      "end_seconds": 44.8,
      "duration_seconds": 2.46,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.05,
      "end_seconds": 51.46,
      "duration_seconds": 5.41,
      "text": "Um, it usually comes with seeing flashing lights."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.62,
      "end_seconds": 62.18,
      "duration_seconds": 5.56,
      "text": "Have you had any reduced baby movements, leaking fluid or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.82,
      "end_seconds": 65.89,
      "duration_seconds": 3.07,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.87,
      "end_seconds": 70.8,
      "duration_seconds": 2.93,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.72,
      "end_seconds": 75.58,
      "duration_seconds": 3.86,
      "text": "Yeah, uh, no, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.56,
      "end_seconds": 80.35,
      "duration_seconds": 2.79,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.45,
      "end_seconds": 83.77,
      "duration_seconds": 2.32,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.57,
      "end_seconds": 88.93,
      "duration_seconds": 3.36,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.29,
      "end_seconds": 94.97,
      "duration_seconds": 4.68,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.02,
      "end_seconds": 100.22,
      "duration_seconds": 3.2,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.85,
      "end_seconds": 104.39,
      "duration_seconds": 3.54,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.94,
      "end_seconds": 107.71,
      "duration_seconds": 2.77,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.01,
      "end_seconds": 112.43,
      "duration_seconds": 3.42,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.17,
      "end_seconds": 131.01,
      "duration_seconds": 3.84,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.17,
      "end_seconds": 141.53,
      "duration_seconds": 9.36,
      "text": "Yes, migraines. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.38,
      "end_seconds": 144.95,
      "duration_seconds": 2.57,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.01,
      "end_seconds": 148.72,
      "duration_seconds": 2.71,
      "text": "Nothing regular, uh, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.84,
      "end_seconds": 152.77,
      "duration_seconds": 2.93,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.8,
      "end_seconds": 158.11,
      "duration_seconds": 4.31,
      "text": "Okay, so no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.29,
      "end_seconds": 168.24,
      "duration_seconds": 2.95,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.54,
      "end_seconds": 182.15,
      "duration_seconds": 2.61,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.88,
      "end_seconds": 212.75,
      "duration_seconds": 9.87,
      "text": "Okay: pulse 90, oxygen saturation is 96 percent, respiratory rate 15. And temp 36.4 degrees, pressure 166 over 96."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.36,
      "end_seconds": 218.69,
      "duration_seconds": 4.33,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.02,
      "end_seconds": 221.47,
      "duration_seconds": 1.45,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.96,
      "end_seconds": 234.35,
      "duration_seconds": 4.39,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.96,
      "end_seconds": 240.63,
      "duration_seconds": 1.67,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.61,
      "end_seconds": 267.06,
      "duration_seconds": 11.45,
      "text": "Taking everything into account, it's hard to say. Severe pre-eclampsia is one possibility and a migraine another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.62,
      "end_seconds": 269.12,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.72,
      "end_seconds": 285.55,
      "duration_seconds": 10.83,
      "text": "It's reasonable to be concerned, but right now severe pre-eclampsia is my leading thought, not anything worse. Let's get a urine protein test, for pre-eclampsia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.12,
      "end_seconds": 293.13,
      "duration_seconds": 2.01,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.76,
      "end_seconds": 304.8,
      "duration_seconds": 10.04,
      "text": "Let's book urgent blood tests to look into pre-eclampsia. I'm prescribing labetalol, 200 milligrams, once now, single dose. It's for severe hypertension."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.23,
      "end_seconds": 313.24,
      "duration_seconds": 3.01,
      "text": "Okay, uh, I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.01,
      "end_seconds": 318.85,
      "duration_seconds": 4.84,
      "text": "You need to go to the maternity unit straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.11,
      "end_seconds": 334.38,
      "duration_seconds": 15.27,
      "text": "Hm, okay. Please take the tablets with food so they don't upset your stomach. If the symptoms get worse, that's the point to come in urgently. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.85,
      "end_seconds": 339.02,
      "duration_seconds": 3.17,
      "text": "Hmm, thank you, doctor, goodbye."
    }
  ]
}