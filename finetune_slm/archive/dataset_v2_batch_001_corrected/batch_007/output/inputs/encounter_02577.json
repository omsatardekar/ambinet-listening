{
  "schema_version": "1.0",
  "encounter_id": "02577",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 5.21,
      "duration_seconds": 4.52,
      "text": "Actually, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.05,
      "end_seconds": 9.96,
      "duration_seconds": 3.91,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 17.98,
      "duration_seconds": 5.95,
      "text": "I wanted to get difficulty getting out of bed looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.25,
      "end_seconds": 21.42,
      "duration_seconds": 2.17,
      "text": "So, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.12,
      "end_seconds": 25.92,
      "duration_seconds": 3.8,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.44,
      "end_seconds": 31.18,
      "duration_seconds": 3.74,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.96,
      "end_seconds": 33.1,
      "duration_seconds": 1.14,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 37.0,
      "duration_seconds": 2.35,
      "text": "have you had any weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.07,
      "end_seconds": 43.18,
      "duration_seconds": 4.11,
      "text": "Not that that I've noticed, no weight loss."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.24,
      "end_seconds": 49.24,
      "duration_seconds": 4.0,
      "text": "A few quick ones: jaw pain on chewing or headache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.04,
      "end_seconds": 57.98,
      "duration_seconds": 6.94,
      "text": "Sorry, what was I saying, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.63,
      "end_seconds": 62.76,
      "duration_seconds": 4.13,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.4,
      "end_seconds": 66.88,
      "duration_seconds": 2.48,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.05,
      "end_seconds": 70.43,
      "duration_seconds": 2.38,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.72,
      "end_seconds": 76.18,
      "duration_seconds": 1.46,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.06,
      "end_seconds": 82.4,
      "duration_seconds": 4.34,
      "text": "right, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.38,
      "end_seconds": 85.91,
      "duration_seconds": 2.53,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.78,
      "end_seconds": 90.07,
      "duration_seconds": 3.29,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.05,
      "end_seconds": 95.26,
      "duration_seconds": 3.21,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 100.72,
      "duration_seconds": 4.23,
      "text": "So, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.57,
      "end_seconds": 106.34,
      "duration_seconds": 3.77,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.35,
      "end_seconds": 113.35,
      "duration_seconds": 2.0,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.24,
      "end_seconds": 118.62,
      "duration_seconds": 4.38,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.58,
      "end_seconds": 137.82,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 142.23,
      "duration_seconds": 2.89,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 145.7,
      "duration_seconds": 2.41,
      "text": "do you take any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.92,
      "end_seconds": 148.41,
      "duration_seconds": 1.49,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.69,
      "end_seconds": 156.77,
      "duration_seconds": 4.08,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.74,
      "end_seconds": 159.4,
      "duration_seconds": 1.66,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.48,
      "end_seconds": 164.9,
      "duration_seconds": 3.42,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.75,
      "end_seconds": 174.6,
      "duration_seconds": 2.85,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.34,
      "end_seconds": 201.92,
      "duration_seconds": 9.58,
      "text": "Okay: respiratory rate 15, oxygen saturation is 97 percent, pressure 123 over 74. And temperature 36.6, pulse is 67 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.02,
      "end_seconds": 205.36,
      "duration_seconds": 1.34,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.73,
      "end_seconds": 210.78,
      "duration_seconds": 4.05,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.54,
      "end_seconds": 214.84,
      "duration_seconds": 2.3,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.77,
      "end_seconds": 226.69,
      "duration_seconds": 0.92,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.49,
      "end_seconds": 229.44,
      "duration_seconds": 1.95,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.19,
      "end_seconds": 244.86,
      "duration_seconds": 7.67,
      "text": "The shoulders are painful to move but strength is normal and there is no joint swelling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.33,
      "end_seconds": 251.17,
      "duration_seconds": 1.84,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.91,
      "end_seconds": 276.88,
      "duration_seconds": 9.97,
      "text": "Let me tell you where I've got to. I'm honestly not certain yet. It could be polymyalgia rheumatica, or it might be rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.97,
      "end_seconds": 285.27,
      "duration_seconds": 2.3,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.17,
      "end_seconds": 307.42,
      "duration_seconds": 20.25,
      "text": "It's reasonable to be concerned, but right now polymyalgia rheumatica is my leading thought, not anything worse. Let me just check I've got this right. You've had difficulty getting out of bed for about four days, severe, and no jaw pain on chewing or weight loss."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.15,
      "end_seconds": 309.69,
      "duration_seconds": 1.54,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.95,
      "end_seconds": 315.24,
      "duration_seconds": 4.29,
      "text": "I'd like to arrange blood tests for proximal stiffness"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.95,
      "end_seconds": 317.88,
      "duration_seconds": 1.93,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.41,
      "end_seconds": 344.29,
      "duration_seconds": 25.88,
      "text": "I'd like you to take prednisolone, 15 milligrams, once a day, reducing course. It's for polymyalgia rheumatica. Report any headache or jaw pain immediately. Please take the tablets with food so they don't upset your stomach. Do get help quickly if you get a new headache or visual changes. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.57,
      "end_seconds": 352.62,
      "duration_seconds": 2.05,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.17,
      "end_seconds": 356.51,
      "duration_seconds": 2.34,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.61,
      "end_seconds": 361.88,
      "duration_seconds": 2.27,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.88,
      "end_seconds": 364.3,
      "duration_seconds": 1.42,
      "text": "look after yourself"
    }
  ]
}