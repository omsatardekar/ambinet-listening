{
  "schema_version": "1.0",
  "encounter_id": "02540",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 6.07,
      "duration_seconds": 5.03,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 12.06,
      "duration_seconds": 5.12,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.64,
      "end_seconds": 17.37,
      "duration_seconds": 4.73,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.12,
      "end_seconds": 25.0,
      "duration_seconds": 6.88,
      "text": "Honestly, it's breathlessness building over weeks, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.61,
      "end_seconds": 30.36,
      "duration_seconds": 3.75,
      "text": "Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.34,
      "end_seconds": 34.28,
      "duration_seconds": 2.94,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.2,
      "end_seconds": 38.32,
      "duration_seconds": 3.12,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.62,
      "end_seconds": 44.03,
      "duration_seconds": 4.41,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.31,
      "end_seconds": 47.26,
      "duration_seconds": 1.95,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.98,
      "end_seconds": 50.47,
      "duration_seconds": 2.49,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.91,
      "end_seconds": 58.75,
      "duration_seconds": 6.84,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 65.29,
      "duration_seconds": 5.83,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.61,
      "end_seconds": 73.02,
      "duration_seconds": 2.41,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.84,
      "end_seconds": 77.23,
      "duration_seconds": 2.39,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.63,
      "end_seconds": 85.86,
      "duration_seconds": 6.23,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.93,
      "end_seconds": 94.02,
      "duration_seconds": 6.09,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.82,
      "end_seconds": 96.18,
      "duration_seconds": 1.36,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.63,
      "end_seconds": 104.51,
      "duration_seconds": 7.88,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 104.61,
      "end_seconds": 109.71,
      "duration_seconds": 5.1,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.62,
      "end_seconds": 117.99,
      "duration_seconds": 6.37,
      "text": "I was getting to that! I've also had a dry cough, since yesterday."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.87,
      "end_seconds": 124.79,
      "duration_seconds": 4.92,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.93,
      "end_seconds": 128.76,
      "duration_seconds": 2.83,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 129.3,
      "end_seconds": 140.64,
      "duration_seconds": 11.34,
      "text": "Okay, so the vitals from earlier. Blood pressure 128 over 80, saturation 92 percent, respiratory rate 20, temperature is 37.2 degrees, pulse is 89 beats a minute."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.78,
      "end_seconds": 142.48,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.41,
      "end_seconds": 165.84,
      "duration_seconds": 5.43,
      "text": "Did you get coughing up blood, leg swelling or night sweats?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.44,
      "end_seconds": 178.92,
      "duration_seconds": 12.48,
      "text": "No, no coughing up blood, no leg swelling, no night sweats. I did have weight loss at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.59,
      "end_seconds": 182.73,
      "duration_seconds": 3.14,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.73,
      "end_seconds": 187.67,
      "duration_seconds": 2.94,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.41,
      "end_seconds": 193.1,
      "duration_seconds": 3.69,
      "text": "Right, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.87,
      "end_seconds": 194.78,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.77,
      "end_seconds": 201.06,
      "duration_seconds": 2.29,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.86,
      "end_seconds": 204.39,
      "duration_seconds": 1.53,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.11,
      "end_seconds": 208.63,
      "duration_seconds": 3.52,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.66,
      "end_seconds": 219.49,
      "duration_seconds": 9.83,
      "text": "I had a reaction to diclofenac when I was younger, swelling of my lips, and I've avoided it since."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.17,
      "end_seconds": 230.52,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.3,
      "end_seconds": 236.22,
      "duration_seconds": 3.92,
      "text": "I take carbamazepine, 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 236.85,
      "end_seconds": 245.3,
      "duration_seconds": 8.45,
      "text": "Doctor, I think the last prescription for the carbamazepine was 400 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.02,
      "end_seconds": 251.6,
      "duration_seconds": 5.58,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.24,
      "end_seconds": 260.25,
      "duration_seconds": 7.01,
      "text": "No, I left it at home. Iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.03,
      "end_seconds": 264.29,
      "duration_seconds": 3.26,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.2,
      "end_seconds": 272.33,
      "duration_seconds": 7.13,
      "text": "Actually, yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.42,
      "end_seconds": 278.47,
      "duration_seconds": 4.05,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.4,
      "end_seconds": 286.22,
      "duration_seconds": 2.82,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.97,
      "end_seconds": 291.55,
      "duration_seconds": 3.58,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.62,
      "end_seconds": 295.99,
      "duration_seconds": 3.37,
      "text": "Yes, epilepsy. I've had low haemoglobin, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.02,
      "end_seconds": 298.89,
      "duration_seconds": 1.87,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.71,
      "end_seconds": 303.87,
      "duration_seconds": 3.16,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.78,
      "end_seconds": 306.25,
      "duration_seconds": 1.47,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.32,
      "end_seconds": 310.4,
      "duration_seconds": 3.08,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.91,
      "end_seconds": 316.25,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.28,
      "end_seconds": 321.39,
      "duration_seconds": 4.11,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.94,
      "end_seconds": 324.54,
      "duration_seconds": 1.6,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.51,
      "end_seconds": 329.55,
      "duration_seconds": 4.04,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.32,
      "end_seconds": 344.25,
      "duration_seconds": 12.93,
      "text": "Going by what you've described, I think we're dealing with a pleural effusion needing a cause at this stage. Heart failure is still possible. A tumour is still possible."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.95,
      "end_seconds": 346.58,
      "duration_seconds": 1.63,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.19,
      "end_seconds": 381.63,
      "duration_seconds": 34.44,
      "text": "I understand the worry. At the moment I'd say it's a pleural effusion needing a cause, and we'll know more once the a CT scan of the chest is back. Let's book a CT scan of the chest to look into pleural effusion. I think a pleural fluid sample makes sense here, for pleural effusion. I am arranging an urgent chest clinic review. I'll also refer you to the chest clinic."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.46,
      "end_seconds": 390.07,
      "duration_seconds": 2.61,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.82,
      "end_seconds": 409.05,
      "duration_seconds": 18.23,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again after the scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.25,
      "end_seconds": 411.98,
      "duration_seconds": 1.73,
      "text": "That's clear, thanks."
    }
  ]
}