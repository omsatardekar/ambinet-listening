{
  "schema_version": "1.0",
  "encounter_id": "02614",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 7.06,
      "duration_seconds": 6.22,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.94,
      "end_seconds": 11.74,
      "duration_seconds": 3.8,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.45,
      "end_seconds": 19.74,
      "duration_seconds": 6.29,
      "text": "Honestly, it's dizziness on standing, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.83,
      "end_seconds": 29.28,
      "duration_seconds": 3.45,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.09,
      "end_seconds": 33.54,
      "duration_seconds": 3.45,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.64,
      "end_seconds": 38.53,
      "duration_seconds": 2.89,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.13,
      "end_seconds": 44.08,
      "duration_seconds": 1.95,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.97,
      "end_seconds": 50.39,
      "duration_seconds": 4.42,
      "text": "Have you had any sore throat, cough or stiff neck?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.41,
      "end_seconds": 54.86,
      "duration_seconds": 2.45,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.09,
      "end_seconds": 58.55,
      "duration_seconds": 2.46,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.52,
      "end_seconds": 63.85,
      "duration_seconds": 3.33,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.34,
      "end_seconds": 83.81,
      "duration_seconds": 2.47,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.84,
      "end_seconds": 86.73,
      "duration_seconds": 1.89,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.73,
      "end_seconds": 93.11,
      "duration_seconds": 1.38,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.69,
      "end_seconds": 97.79,
      "duration_seconds": 3.1,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.83,
      "end_seconds": 101.91,
      "duration_seconds": 2.08,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.58,
      "end_seconds": 106.66,
      "duration_seconds": 3.08,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.33,
      "end_seconds": 110.29,
      "duration_seconds": 2.96,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.2,
      "end_seconds": 114.66,
      "duration_seconds": 3.46,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.35,
      "end_seconds": 118.95,
      "duration_seconds": 2.6,
      "text": "Alright, is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.78,
      "end_seconds": 123.93,
      "duration_seconds": 4.15,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.72,
      "end_seconds": 126.9,
      "duration_seconds": 1.18,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.63,
      "end_seconds": 131.85,
      "duration_seconds": 3.22,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.44,
      "end_seconds": 135.35,
      "duration_seconds": 2.91,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.24,
      "end_seconds": 139.86,
      "duration_seconds": 2.62,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.32,
      "end_seconds": 148.72,
      "duration_seconds": 7.4,
      "text": "Any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.69,
      "end_seconds": 154.11,
      "duration_seconds": 3.42,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.67,
      "end_seconds": 158.47,
      "duration_seconds": 2.8,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.27,
      "end_seconds": 162.42,
      "duration_seconds": 3.15,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.35,
      "end_seconds": 166.2,
      "duration_seconds": 2.85,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.12,
      "end_seconds": 181.92,
      "duration_seconds": 2.8,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.83,
      "end_seconds": 209.01,
      "duration_seconds": 10.18,
      "text": "Okay: SpO2 97 percent on room air, BP is 98 over 61, pulse 93, respiratory rate 20, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.53,
      "end_seconds": 211.62,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.01,
      "end_seconds": 216.78,
      "duration_seconds": 3.77,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.97,
      "end_seconds": 222.93,
      "duration_seconds": 4.96,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.77,
      "end_seconds": 225.1,
      "duration_seconds": 1.33,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.6,
      "end_seconds": 245.94,
      "duration_seconds": 10.34,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.27,
      "end_seconds": 250.44,
      "duration_seconds": 2.17,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.11,
      "end_seconds": 274.17,
      "duration_seconds": 8.06,
      "text": "From what you've told me and what I found, my working impression is possible toxic shock syndrome."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.75,
      "end_seconds": 276.15,
      "duration_seconds": 1.4,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.18,
      "end_seconds": 286.53,
      "duration_seconds": 8.35,
      "text": "It's reasonable to be concerned, but right now possible toxic shock syndrome is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.17,
      "end_seconds": 304.53,
      "duration_seconds": 5.36,
      "text": "I'll request a vaginal swab, it'll help with possible toxic shock."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.27,
      "end_seconds": 309.07,
      "duration_seconds": 2.8,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.12,
      "end_seconds": 315.2,
      "duration_seconds": 4.08,
      "text": "Let's book blood cultures to look into possible toxic shock."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.09,
      "end_seconds": 317.13,
      "duration_seconds": 1.04,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.07,
      "end_seconds": 349.24,
      "duration_seconds": 30.17,
      "text": "I'll start you on flucloxacillin, 2 grams, now, single dose. It's for possible toxic shock syndrome. Remove any tampon, you are going to hospital now. I'd like you to see the emergency team as well, and I'll write the referral. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.75,
      "end_seconds": 358.96,
      "duration_seconds": 6.21,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.64,
      "end_seconds": 368.56,
      "duration_seconds": 8.92,
      "text": "So, I take the flucloxacillin, 2 grams, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.61,
      "end_seconds": 374.59,
      "duration_seconds": 4.98,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.55,
      "end_seconds": 379.39,
      "duration_seconds": 3.84,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.24,
      "end_seconds": 387.06,
      "duration_seconds": 1.82,
      "text": "Right, see you soon."
    }
  ]
}