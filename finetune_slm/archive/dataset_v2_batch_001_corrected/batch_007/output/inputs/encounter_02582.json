{
  "schema_version": "1.0",
  "encounter_id": "02582",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.78,
      "duration_seconds": 3.4,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.34,
      "end_seconds": 9.72,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.6,
      "end_seconds": 28.6,
      "duration_seconds": 18.0,
      "text": "Let me think, good afternoon, doctor. I look after them so I thought I'd come. Mm, you know, doctor, it's severe tummy pain out of proportion to the examination. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.19,
      "end_seconds": 33.4,
      "duration_seconds": 3.21,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.27,
      "end_seconds": 37.78,
      "duration_seconds": 2.51,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.24,
      "end_seconds": 39.17,
      "duration_seconds": 0.93,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.12,
      "end_seconds": 46.97,
      "duration_seconds": 5.85,
      "text": "I've had vomiting too, for one week. About vomiting, I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.49,
      "end_seconds": 50.99,
      "duration_seconds": 2.5,
      "text": "Any chest pain, fever or hernia?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.58,
      "end_seconds": 57.82,
      "duration_seconds": 5.24,
      "text": "No chest pain, fever or hernia, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.77,
      "end_seconds": 60.37,
      "duration_seconds": 1.6,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.38,
      "end_seconds": 63.57,
      "duration_seconds": 2.19,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.56,
      "end_seconds": 70.64,
      "duration_seconds": 4.08,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.92,
      "end_seconds": 76.41,
      "duration_seconds": 2.49,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.32,
      "end_seconds": 97.12,
      "duration_seconds": 2.8,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.52,
      "end_seconds": 104.3,
      "duration_seconds": 5.78,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.51,
      "end_seconds": 112.26,
      "duration_seconds": 3.75,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.46,
      "end_seconds": 116.43,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.31,
      "end_seconds": 119.31,
      "duration_seconds": 2.0,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.68,
      "end_seconds": 127.99,
      "duration_seconds": 5.31,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.25,
      "end_seconds": 131.61,
      "duration_seconds": 2.36,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.47,
      "end_seconds": 141.11,
      "duration_seconds": 8.64,
      "text": "Well, I take something called a bl... a blood thinner, 5 milligrams, maybe, stopped last month."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.0,
      "end_seconds": 149.0,
      "duration_seconds": 4.0,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.06,
      "end_seconds": 154.78,
      "duration_seconds": 4.72,
      "text": "Mm, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.54,
      "end_seconds": 165.51,
      "duration_seconds": 4.97,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.29,
      "end_seconds": 169.98,
      "duration_seconds": 3.69,
      "text": "Right, no, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.22,
      "end_seconds": 173.56,
      "duration_seconds": 2.34,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.45,
      "end_seconds": 187.78,
      "duration_seconds": 13.33,
      "text": "I've had an irregular heartbeat, yes. I'm not great at remembering details, so bear with me. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.85,
      "end_seconds": 201.14,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.29,
      "end_seconds": 204.88,
      "duration_seconds": 2.59,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 209.87,
      "duration_seconds": 4.27,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.56,
      "end_seconds": 222.57,
      "duration_seconds": 2.01,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.98,
      "end_seconds": 241.93,
      "duration_seconds": 8.95,
      "text": "Okay: height 167 centimetres, BMI works out to 25.5, BP is 129 over 76. And weight 71 kilos, pulse 116."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.49,
      "end_seconds": 248.97,
      "duration_seconds": 4.48,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.86,
      "end_seconds": 253.7,
      "duration_seconds": 2.84,
      "text": "Alright, I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.39,
      "end_seconds": 275.09,
      "duration_seconds": 9.7,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.4,
      "end_seconds": 286.37,
      "duration_seconds": 7.97,
      "text": "That's all I needed to check. So where does that leave us? The most likely explanation is possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.6,
      "end_seconds": 291.9,
      "duration_seconds": 4.3,
      "text": "Okay, so is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.54,
      "end_seconds": 304.6,
      "duration_seconds": 12.06,
      "text": "I understand the worry. At the moment I'd say it's possible bowel ischaemia, and we'll know more once the an urgent CT angiogram is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.71,
      "end_seconds": 341.0,
      "duration_seconds": 28.29,
      "text": "I'm sending you for an urgent CT angiogram because of possible bowel ischaemia. This is an emergency, you are going to hospital now. I'd like you to see the surgical team as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.06,
      "end_seconds": 345.81,
      "duration_seconds": 2.75,
      "text": "Okay, uh, makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.33,
      "end_seconds": 350.05,
      "duration_seconds": 3.72,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.83,
      "end_seconds": 355.81,
      "duration_seconds": 3.98,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.99,
      "end_seconds": 358.23,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}