{
  "schema_version": "1.0",
  "encounter_id": "02514",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 6.38,
      "duration_seconds": 5.42,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.52,
      "end_seconds": 12.06,
      "duration_seconds": 4.54,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.83,
      "end_seconds": 20.11,
      "duration_seconds": 6.28,
      "text": "erm, hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.57,
      "end_seconds": 28.56,
      "duration_seconds": 3.99,
      "text": "Good, that'll be useful. Pull up a a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.29,
      "end_seconds": 41.06,
      "duration_seconds": 10.77,
      "text": "Honestly, it's periods becoming irregular, and my family pushed me to come. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.89,
      "end_seconds": 45.68,
      "duration_seconds": 3.79,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.04,
      "end_seconds": 57.61,
      "duration_seconds": 10.57,
      "text": "right, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.51,
      "end_seconds": 62.9,
      "duration_seconds": 3.39,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.34,
      "end_seconds": 67.05,
      "duration_seconds": 2.71,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.63,
      "end_seconds": 71.15,
      "duration_seconds": 2.52,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.23,
      "end_seconds": 78.34,
      "duration_seconds": 5.11,
      "text": "When it starts I tend to get mood swings as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.89,
      "end_seconds": 80.86,
      "duration_seconds": 1.97,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.84,
      "end_seconds": 93.82,
      "duration_seconds": 1.98,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.52,
      "end_seconds": 117.36,
      "duration_seconds": 11.84,
      "text": "Okay: saturation 97 percent, weight 94 kilos, height 175 centimetres, blood pressure 128 over 78, temp 36.9 degrees, BMI works out to 30.7, pulse 79."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.08,
      "end_seconds": 120.59,
      "duration_seconds": 1.51,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.62,
      "end_seconds": 127.06,
      "duration_seconds": 4.44,
      "text": "So, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.55,
      "end_seconds": 133.62,
      "duration_seconds": 4.07,
      "text": "so, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.5,
      "end_seconds": 135.4,
      "duration_seconds": 0.9,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.06,
      "end_seconds": 140.37,
      "duration_seconds": 3.31,
      "text": "Take a a deep breath for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.49,
      "end_seconds": 151.87,
      "duration_seconds": 4.38,
      "text": "Your blood pressure is normal and the abdomen is soft."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.83,
      "end_seconds": 163.11,
      "duration_seconds": 8.28,
      "text": "Thank you, you can get dressed. Have you had any very heavy bleeding, bleeding after sex or pelvic pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.32,
      "end_seconds": 166.32,
      "duration_seconds": 2.0,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.86,
      "end_seconds": 168.69,
      "duration_seconds": 1.83,
      "text": "What about weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.29,
      "end_seconds": 172.42,
      "duration_seconds": 3.13,
      "text": "I haven't noticed any weight loss."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.64,
      "end_seconds": 174.92,
      "duration_seconds": 2.28,
      "text": "Understood. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.3,
      "end_seconds": 178.1,
      "duration_seconds": 1.8,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.26,
      "end_seconds": 182.92,
      "duration_seconds": 3.66,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.64,
      "end_seconds": 186.69,
      "duration_seconds": 3.05,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.31,
      "end_seconds": 190.9,
      "duration_seconds": 2.59,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.68,
      "end_seconds": 193.91,
      "duration_seconds": 1.23,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.83,
      "end_seconds": 201.51,
      "duration_seconds": 4.68,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.23,
      "end_seconds": 203.93,
      "duration_seconds": 1.7,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.54,
      "end_seconds": 217.22,
      "duration_seconds": 2.68,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.7,
      "end_seconds": 221.14,
      "duration_seconds": 2.44,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.93,
      "end_seconds": 224.6,
      "duration_seconds": 2.67,
      "text": "So, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.49,
      "end_seconds": 230.99,
      "duration_seconds": 4.5,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.26,
      "end_seconds": 233.49,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.71,
      "end_seconds": 238.41,
      "duration_seconds": 3.7,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.97,
      "end_seconds": 241.9,
      "duration_seconds": 1.93,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.93,
      "end_seconds": 246.47,
      "duration_seconds": 2.54,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.07,
      "end_seconds": 249.46,
      "duration_seconds": 2.39,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.42,
      "end_seconds": 254.72,
      "duration_seconds": 4.3,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.8,
      "end_seconds": 258.13,
      "duration_seconds": 1.33,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.31,
      "end_seconds": 266.01,
      "duration_seconds": 3.7,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.74,
      "end_seconds": 275.69,
      "duration_seconds": 4.95,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.33,
      "end_seconds": 277.87,
      "duration_seconds": 1.54,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.96,
      "end_seconds": 296.22,
      "duration_seconds": 5.26,
      "text": "taking everything into account, I think we're dealing with perimenopause at this stage"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.74,
      "end_seconds": 300.27,
      "duration_seconds": 3.53,
      "text": "I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.97,
      "end_seconds": 309.33,
      "duration_seconds": 7.36,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopause, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.51,
      "end_seconds": 342.87,
      "duration_seconds": 16.36,
      "text": "Let's get a thyroid test, for hot flushes. I'm going to order a blood count, for irregular periods. I'll start you on estradiol gel, 1 pump, once a day, long term. That should help with menopausal symptoms."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.71,
      "end_seconds": 348.84,
      "duration_seconds": 5.13,
      "text": "Yeah, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.85,
      "end_seconds": 359.53,
      "duration_seconds": 9.68,
      "text": "Regular exercise, light layers and avoiding triggers can help. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.05,
      "end_seconds": 362.59,
      "duration_seconds": 1.54,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.0,
      "end_seconds": 369.85,
      "duration_seconds": 5.85,
      "text": "Let's review you in three months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.26,
      "end_seconds": 374.06,
      "duration_seconds": 2.8,
      "text": "no, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.12,
      "end_seconds": 377.39,
      "duration_seconds": 1.27,
      "text": "All the best."
    }
  ]
}