{
  "schema_version": "1.0",
  "encounter_id": "02768",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 4.0,
      "duration_seconds": 3.18,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.39,
      "end_seconds": 7.98,
      "duration_seconds": 2.59,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.91,
      "end_seconds": 12.35,
      "duration_seconds": 2.44,
      "text": "Did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.62,
      "end_seconds": 22.25,
      "duration_seconds": 5.63,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.48,
      "end_seconds": 26.08,
      "duration_seconds": 2.6,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.05,
      "end_seconds": 34.21,
      "duration_seconds": 6.16,
      "text": "Doctor, it's a widespread sunburn-like rash. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.34,
      "end_seconds": 37.61,
      "duration_seconds": 2.27,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.13,
      "end_seconds": 50.62,
      "duration_seconds": 12.49,
      "text": "It's been about three months, I'm fairly sure. I've never really been one for hospitals. I've had dizziness on standing too, for about a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.61,
      "end_seconds": 55.94,
      "duration_seconds": 4.33,
      "text": "Right, a few quick ones: sore throat or stiff neck?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.46,
      "end_seconds": 60.27,
      "duration_seconds": 2.81,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.67,
      "end_seconds": 64.08,
      "duration_seconds": 2.41,
      "text": "And cough, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.38,
      "end_seconds": 68.41,
      "duration_seconds": 3.03,
      "text": "Not that I've noticed, no cough."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.08,
      "end_seconds": 75.43,
      "duration_seconds": 5.35,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.13,
      "end_seconds": 79.8,
      "duration_seconds": 2.67,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.33,
      "end_seconds": 100.5,
      "duration_seconds": 3.17,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.44,
      "end_seconds": 106.72,
      "duration_seconds": 4.28,
      "text": "Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.71,
      "end_seconds": 123.1,
      "duration_seconds": 4.39,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.19,
      "end_seconds": 127.91,
      "duration_seconds": 2.72,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.31,
      "end_seconds": 131.76,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.28,
      "end_seconds": 135.61,
      "duration_seconds": 3.33,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.91,
      "end_seconds": 138.29,
      "duration_seconds": 1.38,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.1,
      "end_seconds": 142.38,
      "duration_seconds": 3.28,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.87,
      "end_seconds": 163.82,
      "duration_seconds": 2.95,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.34,
      "end_seconds": 167.94,
      "duration_seconds": 2.6,
      "text": "Diabetes, for about a year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.05,
      "end_seconds": 173.52,
      "duration_seconds": 4.47,
      "text": "I see, go ahead. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.33,
      "end_seconds": 179.03,
      "duration_seconds": 3.7,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.0,
      "end_seconds": 198.78,
      "duration_seconds": 2.78,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.11,
      "end_seconds": 212.14,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.15,
      "end_seconds": 237.35,
      "duration_seconds": 8.2,
      "text": "Okay: pressure 99 over 62, heart rate 105, temperature is 36.5 degrees. And respiratory rate 16."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.7,
      "end_seconds": 240.38,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.59,
      "end_seconds": 244.34,
      "duration_seconds": 2.75,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.88,
      "end_seconds": 249.62,
      "duration_seconds": 3.74,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.18,
      "end_seconds": 251.13,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.42,
      "end_seconds": 254.05,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.43,
      "end_seconds": 280.19,
      "duration_seconds": 8.76,
      "text": "You are very hot, your blood pressure is low and there is a flat red rash over the body and palms."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.21,
      "end_seconds": 314.58,
      "duration_seconds": 29.37,
      "text": "Please sit back down. Putting it all together, it fits best with possible toxic shock syndrome. I'll request a vaginal swab, it'll help with possible toxic shock. The treatment will be flucloxacillin, 2 grams, now, single dose. That should help with possible toxic shock syndrome. Remove any tampon, you are going to hospital now. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.79,
      "end_seconds": 318.61,
      "duration_seconds": 2.82,
      "text": "Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.58,
      "end_seconds": 322.76,
      "duration_seconds": 3.18,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.21,
      "end_seconds": 326.82,
      "duration_seconds": 2.61,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.65,
      "end_seconds": 329.39,
      "duration_seconds": 1.74,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.13,
      "end_seconds": 332.58,
      "duration_seconds": 1.45,
      "text": "Look after yourself."
    }
  ]
}