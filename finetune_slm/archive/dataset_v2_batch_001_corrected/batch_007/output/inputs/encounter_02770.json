{
  "schema_version": "1.0",
  "encounter_id": "02770",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 6.08,
      "duration_seconds": 4.71,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.2,
      "end_seconds": 12.35,
      "duration_seconds": 5.15,
      "text": "Right, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.08,
      "end_seconds": 17.54,
      "duration_seconds": 3.46,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.77,
      "end_seconds": 23.01,
      "duration_seconds": 4.24,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.51,
      "end_seconds": 31.32,
      "duration_seconds": 6.81,
      "text": "Doctor, you know, it's poor concentration. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.35,
      "end_seconds": 35.56,
      "duration_seconds": 3.21,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.94,
      "end_seconds": 39.42,
      "duration_seconds": 2.48,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.44,
      "end_seconds": 47.48,
      "duration_seconds": 3.04,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.86,
      "end_seconds": 55.4,
      "duration_seconds": 6.54,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.16,
      "end_seconds": 62.37,
      "duration_seconds": 5.21,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.29,
      "end_seconds": 66.58,
      "duration_seconds": 3.29,
      "text": "About a three out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.31,
      "end_seconds": 70.88,
      "duration_seconds": 2.57,
      "text": "Have you had aching all over?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.9,
      "end_seconds": 78.79,
      "duration_seconds": 6.89,
      "text": "Yes, for about a week. And I've been waking unrefreshed as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.28,
      "end_seconds": 86.08,
      "duration_seconds": 3.8,
      "text": "Okay, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.86,
      "end_seconds": 91.86,
      "duration_seconds": 5.0,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 92.56,
      "end_seconds": 95.28,
      "duration_seconds": 2.72,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.49,
      "end_seconds": 108.12,
      "duration_seconds": 4.63,
      "text": "Have you had any weight loss, fever or joint swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.67,
      "end_seconds": 123.07,
      "duration_seconds": 13.4,
      "text": "No, no weight loss, no fever, no joint swelling. I did have tender spots at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.29,
      "end_seconds": 127.06,
      "duration_seconds": 2.77,
      "text": "Okay, did you notice any rash?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.24,
      "end_seconds": 131.11,
      "duration_seconds": 2.87,
      "text": "Not at all, no rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.95,
      "end_seconds": 134.57,
      "duration_seconds": 2.62,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.12,
      "end_seconds": 136.73,
      "duration_seconds": 1.61,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.55,
      "end_seconds": 141.52,
      "duration_seconds": 2.97,
      "text": "Okay, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.96,
      "end_seconds": 145.86,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.3,
      "end_seconds": 149.86,
      "duration_seconds": 2.56,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.84,
      "end_seconds": 163.93,
      "duration_seconds": 13.09,
      "text": "I've had asthma for nearly five years now. Migraines, for about ten years. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.97,
      "end_seconds": 167.28,
      "duration_seconds": 1.31,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 176.6,
      "duration_seconds": 7.36,
      "text": "I've had diabetes, yes. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.42,
      "end_seconds": 178.12,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.74,
      "end_seconds": 180.27,
      "duration_seconds": 1.53,
      "text": "I have depression."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.36,
      "end_seconds": 189.34,
      "duration_seconds": 7.98,
      "text": "Alright, migraines and diabetes, that matches what I have here. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.44,
      "end_seconds": 203.22,
      "duration_seconds": 10.78,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 206.29,
      "duration_seconds": 1.44,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.03,
      "end_seconds": 210.13,
      "duration_seconds": 3.1,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.96,
      "end_seconds": 213.79,
      "duration_seconds": 2.83,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.1,
      "end_seconds": 218.95,
      "duration_seconds": 3.85,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.04,
      "end_seconds": 222.7,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.95,
      "end_seconds": 226.37,
      "duration_seconds": 2.42,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.64,
      "end_seconds": 231.45,
      "duration_seconds": 3.81,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.29,
      "end_seconds": 242.23,
      "duration_seconds": 4.94,
      "text": "My mother had a stroke. My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.05,
      "end_seconds": 248.26,
      "duration_seconds": 4.21,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.44,
      "end_seconds": 255.54,
      "duration_seconds": 6.1,
      "text": "Foracort inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 256.94,
      "end_seconds": 262.42,
      "duration_seconds": 5.48,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.05,
      "end_seconds": 264.56,
      "duration_seconds": 1.51,
      "text": "Paracetamol, when needed."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.46,
      "end_seconds": 271.1,
      "duration_seconds": 2.64,
      "text": "So, how much do you take?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.34,
      "end_seconds": 278.93,
      "duration_seconds": 6.59,
      "text": "It's 1 gram. I used to take mirtazapine, but I stopped it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 280.56,
      "end_seconds": 288.46,
      "duration_seconds": 7.9,
      "text": "Okay, so the vitals from earlier. Pulse 71, respiratory rate 18, temp 36.7 degrees, blood pressure 127 over 70."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.01,
      "end_seconds": 290.91,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.01,
      "end_seconds": 323.68,
      "duration_seconds": 18.67,
      "text": "Going by what you've described, it fits best with fibromyalgia. It could also be an underactive thyroid, so we'll keep that open. Gentle graded exercise such as swimming helps more than rest. I'll want another look in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.43,
      "end_seconds": 328.39,
      "duration_seconds": 2.96,
      "text": "I think I understand everything. Thanks."
    }
  ]
}