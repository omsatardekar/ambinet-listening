{
  "schema_version": "1.0",
  "encounter_id": "02606",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.06,
      "duration_seconds": 5.79,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.38,
      "end_seconds": 12.39,
      "duration_seconds": 4.01,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.37,
      "end_seconds": 18.96,
      "duration_seconds": 5.59,
      "text": "It's severe tummy pain out of proportion to the examination, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.94,
      "end_seconds": 26.08,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.16,
      "end_seconds": 41.01,
      "duration_seconds": 13.85,
      "text": "It's been going on for six months. I'm not great at remembering details, so bear with me. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.04,
      "end_seconds": 45.34,
      "duration_seconds": 2.3,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.34,
      "end_seconds": 50.64,
      "duration_seconds": 3.3,
      "text": "honestly, once or twice a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.31,
      "end_seconds": 54.36,
      "duration_seconds": 2.05,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.64,
      "end_seconds": 67.98,
      "duration_seconds": 10.34,
      "text": "when it starts I tend to get bloody diarrhoea as well yeah, the bloody diarrhoea? That's been for about a week"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.48,
      "end_seconds": 71.95,
      "duration_seconds": 2.47,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.63,
      "end_seconds": 76.92,
      "duration_seconds": 4.29,
      "text": "I have an irregular heartbeat i've got heart disease"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.87,
      "end_seconds": 80.02,
      "duration_seconds": 2.15,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.57,
      "end_seconds": 86.82,
      "duration_seconds": 6.25,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.08,
      "end_seconds": 100.81,
      "duration_seconds": 2.73,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.9,
      "end_seconds": 105.1,
      "duration_seconds": 2.2,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.68,
      "end_seconds": 108.75,
      "duration_seconds": 2.07,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.46,
      "end_seconds": 113.04,
      "duration_seconds": 3.58,
      "text": "Aspirin, once a day for my heart"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.04,
      "end_seconds": 116.19,
      "duration_seconds": 2.15,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.2,
      "end_seconds": 127.4,
      "duration_seconds": 9.2,
      "text": "75 milligrams, I think that's what's on the box. I was on metoprolol before. I stopped taking it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.02,
      "end_seconds": 132.37,
      "duration_seconds": 4.35,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.92,
      "end_seconds": 137.43,
      "duration_seconds": 3.51,
      "text": "I'm allergic to trimethoprim, I get itching"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.7,
      "end_seconds": 143.62,
      "duration_seconds": 4.92,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.02,
      "end_seconds": 164.69,
      "duration_seconds": 19.67,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. I'm a bus driver, so I sit for long hours. I drink a lot of tea and snack through the day. I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.65,
      "end_seconds": 169.32,
      "duration_seconds": 3.67,
      "text": "And what about hernia, chest pain or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.16,
      "end_seconds": 174.56,
      "duration_seconds": 4.4,
      "text": "no hernia, chest pain or fever, none of it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.54,
      "end_seconds": 179.49,
      "duration_seconds": 3.95,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.25,
      "end_seconds": 182.18,
      "duration_seconds": 1.93,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.1,
      "end_seconds": 185.71,
      "duration_seconds": 2.61,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.24,
      "end_seconds": 189.62,
      "duration_seconds": 2.38,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.21,
      "end_seconds": 202.25,
      "duration_seconds": 2.04,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.07,
      "end_seconds": 218.46,
      "duration_seconds": 2.39,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.41,
      "end_seconds": 247.27,
      "duration_seconds": 8.86,
      "text": "Okay: temp 36.6 degrees, SpO2 99 percent on room air. And blood pressure 132 over 73, heart rate 108."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.82,
      "end_seconds": 250.82,
      "duration_seconds": 2.0,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.51,
      "end_seconds": 253.91,
      "duration_seconds": 2.4,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.06,
      "end_seconds": 260.02,
      "duration_seconds": 3.96,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.46,
      "end_seconds": 262.81,
      "duration_seconds": 1.35,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.13,
      "end_seconds": 288.84,
      "duration_seconds": 10.71,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.05,
      "end_seconds": 307.47,
      "duration_seconds": 15.42,
      "text": "That's all I needed to check. Having listened and examined, it fits best with possible bowel ischaemia. The reason I say that is that your story and my examination fit together. I'd also keep a bowel obstruction in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.03,
      "end_seconds": 312.66,
      "duration_seconds": 3.63,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.68,
      "end_seconds": 322.16,
      "duration_seconds": 8.48,
      "text": "It's reasonable to be concerned, but right now possible bowel ischaemia is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.04,
      "end_seconds": 345.26,
      "duration_seconds": 5.22,
      "text": "An urgent CT angiogram is what I'd like next, for possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.6,
      "end_seconds": 351.41,
      "duration_seconds": 2.81,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.84,
      "end_seconds": 358.42,
      "duration_seconds": 5.58,
      "text": "Urgent blood tests is what I'd like next, for severe abdominal pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.91,
      "end_seconds": 362.76,
      "duration_seconds": 2.85,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.43,
      "end_seconds": 377.67,
      "duration_seconds": 14.24,
      "text": "this is an emergency, you are going to hospital now. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. See me again straight away"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.16,
      "end_seconds": 379.86,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.23,
      "end_seconds": 385.48,
      "duration_seconds": 4.25,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.25,
      "end_seconds": 389.21,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.44,
      "end_seconds": 391.84,
      "duration_seconds": 1.4,
      "text": "All the best."
    }
  ]
}