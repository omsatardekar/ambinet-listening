{
  "schema_version": "1.0",
  "encounter_id": "02630",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 6.84,
      "duration_seconds": 5.65,
      "text": "Erm, uh, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.85,
      "end_seconds": 13.54,
      "duration_seconds": 4.69,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.81,
      "end_seconds": 22.45,
      "duration_seconds": 5.64,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.04,
      "end_seconds": 27.52,
      "duration_seconds": 3.48,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.8,
      "end_seconds": 32.6,
      "duration_seconds": 3.8,
      "text": "I've been dealing with tingling in my feet."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.08,
      "end_seconds": 37.62,
      "duration_seconds": 3.54,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.72,
      "end_seconds": 52.43,
      "duration_seconds": 13.71,
      "text": "It's been like this since Monday. And there's difficulty walking as well, four weeks now. About difficulty walking, moderate, really. There's a recent stomach bug as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.57,
      "end_seconds": 56.96,
      "duration_seconds": 3.39,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.54,
      "end_seconds": 61.61,
      "duration_seconds": 4.07,
      "text": "Erm, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.34,
      "end_seconds": 65.97,
      "duration_seconds": 3.63,
      "text": "Has there been weakness climbing up your legs too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.25,
      "end_seconds": 70.68,
      "duration_seconds": 3.43,
      "text": "Well, yeah. Three weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.02,
      "end_seconds": 75.27,
      "duration_seconds": 3.25,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.82,
      "end_seconds": 80.04,
      "duration_seconds": 1.22,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.3,
      "end_seconds": 92.93,
      "duration_seconds": 3.63,
      "text": "Any back pain or bladder problems at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.8,
      "end_seconds": 98.21,
      "duration_seconds": 4.41,
      "text": "No back pain or bladder problems, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.5,
      "end_seconds": 101.77,
      "duration_seconds": 1.27,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.63,
      "end_seconds": 105.2,
      "duration_seconds": 1.57,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 106.34,
      "end_seconds": 111.89,
      "duration_seconds": 5.55,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.13,
      "end_seconds": 119.01,
      "duration_seconds": 5.88,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.94,
      "end_seconds": 127.56,
      "duration_seconds": 7.62,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.12,
      "end_seconds": 129.1,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.61,
      "end_seconds": 131.61,
      "duration_seconds": 2.0,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 134.7,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.65,
      "end_seconds": 139.98,
      "duration_seconds": 3.33,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.45,
      "end_seconds": 146.91,
      "duration_seconds": 5.46,
      "text": "My mother had a stroke. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.81,
      "end_seconds": 152.0,
      "duration_seconds": 4.19,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.35,
      "end_seconds": 161.94,
      "duration_seconds": 4.59,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.42,
      "end_seconds": 178.92,
      "duration_seconds": 3.5,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.3,
      "end_seconds": 184.77,
      "duration_seconds": 4.47,
      "text": "Lamotrigine, 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 186.87,
      "end_seconds": 195.48,
      "duration_seconds": 8.61,
      "text": "Doctor, I think the last prescription for the lamotrigine was 200 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.56,
      "end_seconds": 199.44,
      "duration_seconds": 2.88,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.71,
      "end_seconds": 205.17,
      "duration_seconds": 4.46,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.31,
      "end_seconds": 210.24,
      "duration_seconds": 3.93,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.23,
      "end_seconds": 218.63,
      "duration_seconds": 6.4,
      "text": "Low haemoglobin, for about ten years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 221.43,
      "duration_seconds": 0.82,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.4,
      "end_seconds": 230.81,
      "duration_seconds": 7.41,
      "text": "So, I've got epilepsy. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.84,
      "end_seconds": 243.67,
      "duration_seconds": 11.83,
      "text": "Mm-hmm. Right, so epilepsy is already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.47,
      "end_seconds": 259.14,
      "duration_seconds": 14.67,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I'm vegetarian and have been for years. My partner and our baby. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.9,
      "end_seconds": 262.19,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.62,
      "end_seconds": 266.7,
      "duration_seconds": 3.08,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.95,
      "end_seconds": 270.6,
      "duration_seconds": 2.65,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.0,
      "end_seconds": 286.36,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.72,
      "end_seconds": 312.29,
      "duration_seconds": 9.57,
      "text": "Okay: SpO2 99 percent on room air, blood pressure 119 over 79, pulse is 65 beats a minute, temperature 36.5."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.51,
      "end_seconds": 315.49,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.17,
      "end_seconds": 318.57,
      "duration_seconds": 2.4,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.89,
      "end_seconds": 323.91,
      "duration_seconds": 3.02,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.97,
      "end_seconds": 327.35,
      "duration_seconds": 2.38,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.05,
      "end_seconds": 340.42,
      "duration_seconds": 5.37,
      "text": "Your ankle reflexes are absent and the strength in both legs is reduced."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.6,
      "end_seconds": 345.5,
      "duration_seconds": 1.9,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.26,
      "end_seconds": 363.37,
      "duration_seconds": 9.11,
      "text": "So where does that leave us? This is probably possible Guillain-Barre syndrome. I'd also keep a spinal cord problem in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.97,
      "end_seconds": 367.16,
      "duration_seconds": 2.19,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.76,
      "end_seconds": 385.54,
      "duration_seconds": 17.78,
      "text": "I understand the worry. At the moment I'd say it's possible Guillain-Barre syndrome, and we'll know more once the a breathing test is back. Just to be sure I understood. You've had tingling in your feet, since Monday, and no back pain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.39,
      "end_seconds": 388.92,
      "duration_seconds": 1.53,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.56,
      "end_seconds": 402.46,
      "duration_seconds": 11.9,
      "text": "I'm going to order a breathing test, for possible GBS. I'll request a lumbar puncture, it'll help with possible GBS. Let's book an urgent admission to look into ascending weakness."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.45,
      "end_seconds": 406.06,
      "duration_seconds": 2.61,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.57,
      "end_seconds": 419.93,
      "duration_seconds": 12.36,
      "text": "You must be admitted today for monitoring of your breathing. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.95,
      "end_seconds": 423.54,
      "duration_seconds": 1.59,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.15,
      "end_seconds": 428.31,
      "duration_seconds": 3.16,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.01,
      "end_seconds": 432.13,
      "duration_seconds": 3.12,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}