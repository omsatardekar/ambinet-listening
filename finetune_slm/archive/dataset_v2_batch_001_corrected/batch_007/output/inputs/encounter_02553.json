{
  "schema_version": "1.0",
  "encounter_id": "02553",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 3.66,
      "duration_seconds": 3.06,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.72,
      "end_seconds": 5.81,
      "duration_seconds": 1.09,
      "text": "hi, thanks"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 9.96,
      "duration_seconds": 2.92,
      "text": "So, what's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.49,
      "end_seconds": 19.64,
      "duration_seconds": 8.15,
      "text": "I mean, so the thing is, I've got a widespread rash with fever"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.55,
      "end_seconds": 22.75,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.55,
      "end_seconds": 27.27,
      "duration_seconds": 2.72,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.11,
      "end_seconds": 31.49,
      "duration_seconds": 3.38,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.56,
      "end_seconds": 35.16,
      "duration_seconds": 1.6,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.25,
      "end_seconds": 39.29,
      "duration_seconds": 2.04,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.18,
      "end_seconds": 49.62,
      "duration_seconds": 8.44,
      "text": "It usually comes with a recent new medicine. The recent new medicine? That's been for six months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.58,
      "end_seconds": 53.72,
      "duration_seconds": 3.14,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.4,
      "end_seconds": 57.02,
      "duration_seconds": 1.62,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.34,
      "end_seconds": 61.59,
      "duration_seconds": 3.25,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.98,
      "end_seconds": 73.0,
      "duration_seconds": 10.02,
      "text": "Metoprolol, 50 milligrams, twice a day for my heart it's allopurinol, 300 milligrams, started four weeks ago"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.17,
      "end_seconds": 77.28,
      "duration_seconds": 3.11,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.58,
      "end_seconds": 80.61,
      "duration_seconds": 2.03,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.77,
      "end_seconds": 96.26,
      "duration_seconds": 2.49,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.15,
      "end_seconds": 104.24,
      "duration_seconds": 6.09,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.77,
      "end_seconds": 108.57,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.31,
      "end_seconds": 117.87,
      "duration_seconds": 8.56,
      "text": "I've had heart failure for two years now i didn't want to make a fuss, you know"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.78,
      "end_seconds": 125.99,
      "duration_seconds": 7.21,
      "text": "right, so heart failure is already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.96,
      "end_seconds": 144.27,
      "duration_seconds": 2.31,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.48,
      "end_seconds": 149.56,
      "duration_seconds": 4.08,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.17,
      "end_seconds": 152.55,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.49,
      "end_seconds": 157.11,
      "duration_seconds": 3.62,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.56,
      "end_seconds": 163.52,
      "duration_seconds": 4.96,
      "text": "right, any mouth sores, blisters or breathing difficulty at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.06,
      "end_seconds": 169.82,
      "duration_seconds": 4.76,
      "text": "No, no mouth sores, blisters or breathing difficulty."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.69,
      "end_seconds": 174.27,
      "duration_seconds": 2.58,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.34,
      "end_seconds": 177.07,
      "duration_seconds": 1.73,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.77,
      "end_seconds": 181.44,
      "duration_seconds": 3.67,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.68,
      "end_seconds": 185.67,
      "duration_seconds": 2.99,
      "text": "actually, no, that's all normal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 202.83,
      "end_seconds": 213.84,
      "duration_seconds": 11.01,
      "text": "Okay, so the vitals from earlier. Saturation 97 percent, pressure 124 over 78, pulse is 92 beats a a minute. Temperature is 38.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.02,
      "end_seconds": 215.99,
      "duration_seconds": 0.97,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 223.52,
      "duration_seconds": 4.9,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.65,
      "end_seconds": 226.03,
      "duration_seconds": 1.38,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.64,
      "end_seconds": 250.0,
      "duration_seconds": 7.36,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.77,
      "end_seconds": 262.02,
      "duration_seconds": 7.25,
      "text": "You can sit up now. Putting it all together, my working impression is a severe drug reaction."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.01,
      "end_seconds": 268.7,
      "duration_seconds": 5.69,
      "text": "Sorry, what was I saying, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.26,
      "end_seconds": 289.9,
      "duration_seconds": 19.64,
      "text": "I can't promise yet, but most people with a severe drug reaction do well once it's treated properly. Just to be sure I understood. You've had a widespread rash with fever for about a week, severe, and no blisters or breathing difficulty."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.74,
      "end_seconds": 293.48,
      "duration_seconds": 2.74,
      "text": "Mm, you know, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.57,
      "end_seconds": 300.11,
      "duration_seconds": 5.54,
      "text": "I'm sending you for urgent blood tests because of severe drug reaction."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.63,
      "end_seconds": 304.7,
      "duration_seconds": 3.07,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.29,
      "end_seconds": 315.9,
      "duration_seconds": 9.61,
      "text": "The treatment will be prednisolone, 40 milligrams, once a day, until review. That should help with severe drug reaction."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.27,
      "end_seconds": 320.56,
      "duration_seconds": 3.29,
      "text": "alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.48,
      "end_seconds": 327.03,
      "duration_seconds": 5.55,
      "text": "Stop the allopurinol now and you need admission. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.16,
      "end_seconds": 332.36,
      "duration_seconds": 4.2,
      "text": "Well, uh, I can manage that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.4,
      "end_seconds": 338.97,
      "duration_seconds": 4.57,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.58,
      "end_seconds": 346.16,
      "duration_seconds": 6.58,
      "text": "Okay, you know, so okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.9,
      "end_seconds": 348.31,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
}