{
  "schema_version": "1.0",
  "encounter_id": "02504",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 4.01,
      "duration_seconds": 3.1,
      "text": "Right, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.02,
      "end_seconds": 8.43,
      "duration_seconds": 3.41,
      "text": "So, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.58,
      "end_seconds": 11.28,
      "duration_seconds": 1.7,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 21.96,
      "duration_seconds": 9.93,
      "text": "I've been dealing with a rolled ankle i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.3,
      "end_seconds": 25.68,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.42,
      "end_seconds": 43.61,
      "duration_seconds": 16.19,
      "text": "I'm on allopurinol, 100 milligrams, once a day. Mm, it's ibuprofen gel, three times a day. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.03,
      "end_seconds": 54.43,
      "duration_seconds": 3.4,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.24,
      "end_seconds": 59.55,
      "duration_seconds": 3.31,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.81,
      "end_seconds": 65.97,
      "duration_seconds": 6.16,
      "text": "yes, carry on okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.18,
      "end_seconds": 74.02,
      "duration_seconds": 6.84,
      "text": "It's worse with walking. Ice and rest helps a bit. I've also had bruising."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.78,
      "end_seconds": 80.06,
      "duration_seconds": 4.28,
      "text": "Any pain in the shin or pop at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.05,
      "end_seconds": 84.07,
      "duration_seconds": 3.02,
      "text": "um, nope, nothing like that"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.51,
      "end_seconds": 89.06,
      "duration_seconds": 3.55,
      "text": "and what about pain in the foot or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.14,
      "end_seconds": 94.1,
      "duration_seconds": 2.96,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.64,
      "end_seconds": 96.72,
      "duration_seconds": 2.08,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.14,
      "end_seconds": 100.11,
      "duration_seconds": 1.97,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.07,
      "end_seconds": 118.57,
      "duration_seconds": 3.5,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.26,
      "end_seconds": 122.03,
      "duration_seconds": 2.77,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.82,
      "end_seconds": 125.58,
      "duration_seconds": 1.76,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.19,
      "end_seconds": 131.77,
      "duration_seconds": 5.58,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.86,
      "end_seconds": 135.08,
      "duration_seconds": 1.22,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.67,
      "end_seconds": 137.94,
      "duration_seconds": 2.27,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.67,
      "end_seconds": 140.23,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.45,
      "end_seconds": 147.07,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.77,
      "end_seconds": 149.99,
      "duration_seconds": 2.22,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.59,
      "end_seconds": 154.76,
      "duration_seconds": 4.17,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.6,
      "end_seconds": 159.35,
      "duration_seconds": 2.75,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.03,
      "end_seconds": 164.73,
      "duration_seconds": 3.7,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.69,
      "end_seconds": 169.56,
      "duration_seconds": 2.87,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.68,
      "end_seconds": 172.3,
      "duration_seconds": 1.62,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.69,
      "end_seconds": 179.64,
      "duration_seconds": 5.95,
      "text": "Mm-hmm. Right, yes, gout is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.94,
      "end_seconds": 190.23,
      "duration_seconds": 3.29,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 199.68,
      "duration_seconds": 2.42,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.14,
      "end_seconds": 232.28,
      "duration_seconds": 11.14,
      "text": "okay: blood pressure 110 over 70, temperature 36.8. And respiratory rate 15, pulse is 74 beats a minute, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.51,
      "end_seconds": 235.08,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.94,
      "end_seconds": 239.43,
      "duration_seconds": 2.49,
      "text": "we'll go over that that shortly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 276.56,
      "duration_seconds": 18.16,
      "text": "putting together what you've described, I think we're dealing with a mild ankle sprain at this stage. Let me repeat that back to to make sure. You've had a rolled ankle, since Friday, and no numbness or pop"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.0,
      "end_seconds": 283.78,
      "duration_seconds": 1.78,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.37,
      "end_seconds": 292.15,
      "duration_seconds": 7.78,
      "text": "Rest, ice, compression and and elevation, then gradual strengthening. Let's review you if not better in two weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 293.58,
      "end_seconds": 297.08,
      "duration_seconds": 3.5,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.13,
      "end_seconds": 304.38,
      "duration_seconds": 5.25,
      "text": "before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.43,
      "end_seconds": 312.47,
      "duration_seconds": 6.04,
      "text": "so, I come back if not better in two weeks is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.57,
      "end_seconds": 317.21,
      "duration_seconds": 3.64,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.76,
      "end_seconds": 321.4,
      "duration_seconds": 3.64,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.85,
      "end_seconds": 327.1,
      "duration_seconds": 1.25,
      "text": "see you soon"
    }
  ]
}