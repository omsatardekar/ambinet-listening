{
  "schema_version": "1.0",
  "encounter_id": "02807",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.63,
      "duration_seconds": 4.58,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 10.8,
      "duration_seconds": 4.1,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.02,
      "end_seconds": 15.69,
      "duration_seconds": 3.67,
      "text": "So, I've been passing kidney stones, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.32,
      "end_seconds": 19.3,
      "duration_seconds": 1.98,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.41,
      "end_seconds": 28.26,
      "duration_seconds": 7.85,
      "text": "It's been about three months now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.45,
      "end_seconds": 32.72,
      "duration_seconds": 3.27,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.3,
      "end_seconds": 34.25,
      "duration_seconds": 0.95,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.67,
      "end_seconds": 35.59,
      "duration_seconds": 0.92,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.21,
      "end_seconds": 47.8,
      "duration_seconds": 10.59,
      "text": "Oh, and aching bones. That's been about the same, about three months. About aching bones, mostly severe. And constipation, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.52,
      "end_seconds": 51.86,
      "duration_seconds": 2.34,
      "text": "Have you had any weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.73,
      "end_seconds": 56.22,
      "duration_seconds": 3.49,
      "text": "No, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.06,
      "end_seconds": 61.55,
      "duration_seconds": 4.49,
      "text": "A few quick ones: low mood, fever or fractures?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.5,
      "end_seconds": 66.24,
      "duration_seconds": 3.74,
      "text": "No, no low mood, fever or fractures."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.84,
      "end_seconds": 69.43,
      "duration_seconds": 2.59,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.48,
      "end_seconds": 72.39,
      "duration_seconds": 0.91,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.0,
      "end_seconds": 77.36,
      "duration_seconds": 3.36,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.45,
      "end_seconds": 80.41,
      "duration_seconds": 0.96,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.51,
      "end_seconds": 85.15,
      "duration_seconds": 3.64,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.51,
      "end_seconds": 90.2,
      "duration_seconds": 3.69,
      "text": "I take tamsulosin, at night for the prostate."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.73,
      "end_seconds": 92.89,
      "duration_seconds": 2.16,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.87,
      "end_seconds": 102.28,
      "duration_seconds": 8.41,
      "text": "0.4 milligrams. Okay, so it's alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.98,
      "end_seconds": 108.18,
      "duration_seconds": 4.2,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.18,
      "end_seconds": 127.95,
      "duration_seconds": 15.77,
      "text": "No, I've never smoked in my life. I do a yoga class on Thursdays. I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.52,
      "end_seconds": 133.35,
      "duration_seconds": 3.83,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.36,
      "end_seconds": 138.81,
      "duration_seconds": 3.45,
      "text": "So, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.58,
      "end_seconds": 158.76,
      "duration_seconds": 3.18,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.53,
      "end_seconds": 169.89,
      "duration_seconds": 5.36,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.13,
      "end_seconds": 184.8,
      "duration_seconds": 4.67,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.74,
      "end_seconds": 189.25,
      "duration_seconds": 3.51,
      "text": "Yes, naproxen, it gives me a rash."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.18,
      "end_seconds": 193.96,
      "duration_seconds": 3.78,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.01,
      "end_seconds": 204.43,
      "duration_seconds": 8.42,
      "text": "I have an enlarged prostate, for two years. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.3,
      "end_seconds": 207.0,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.8,
      "end_seconds": 210.49,
      "duration_seconds": 1.69,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.52,
      "end_seconds": 212.22,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.76,
      "end_seconds": 214.69,
      "duration_seconds": 1.93,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.69,
      "end_seconds": 217.9,
      "duration_seconds": 1.21,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.65,
      "end_seconds": 229.86,
      "duration_seconds": 10.21,
      "text": "Yes, thin bones is known to us, good to have that clear. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.32,
      "end_seconds": 242.59,
      "duration_seconds": 3.27,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.48,
      "end_seconds": 266.85,
      "duration_seconds": 11.37,
      "text": "Okay: pressure 125 over 68, pulse 86. And saturation 99 percent, height 158 centimetres, BMI works out to 37.3, temp 36.8 degrees, weight 93 kilos."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.35,
      "end_seconds": 269.81,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.39,
      "end_seconds": 273.92,
      "duration_seconds": 2.53,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.87,
      "end_seconds": 279.29,
      "duration_seconds": 3.42,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.79,
      "end_seconds": 282.04,
      "duration_seconds": 1.25,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.02,
      "end_seconds": 299.92,
      "duration_seconds": 4.9,
      "text": "Your examination is normal and there is no tenderness over the bones."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.38,
      "end_seconds": 310.33,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.73,
      "end_seconds": 335.24,
      "duration_seconds": 20.51,
      "text": "You can sit up now. Having listened and examined, this is probably possible raised calcium from an overactive parathyroid. I want to be honest that this is an impression, not a final answer. I want a bone density scan done, that's for possible hyperparathyroidism."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 338.19,
      "end_seconds": 341.84,
      "duration_seconds": 3.65,
      "text": "I can book that for Tuesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.42,
      "end_seconds": 357.9,
      "duration_seconds": 15.48,
      "text": "Drink plenty of water and avoid calcium supplements until the results. Please take the tablets with food so they don't upset your stomach. I'll want another look after the results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.64,
      "end_seconds": 363.32,
      "duration_seconds": 3.68,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.25,
      "end_seconds": 366.6,
      "duration_seconds": 1.35,
      "text": "Look after yourself."
    }
  ]
}