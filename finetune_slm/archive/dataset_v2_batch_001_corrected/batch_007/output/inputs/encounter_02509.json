{
  "schema_version": "1.0",
  "encounter_id": "02509",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 6.24,
      "duration_seconds": 4.93,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.57,
      "end_seconds": 11.33,
      "duration_seconds": 3.76,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 29.85,
      "duration_seconds": 17.1,
      "text": "Honestly, it's severe tummy pain out of proportion to the examination, and my family pushed me to come. My family kept telling me to get it checked. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.19,
      "end_seconds": 34.02,
      "duration_seconds": 2.83,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.97,
      "end_seconds": 38.74,
      "duration_seconds": 3.77,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.87,
      "end_seconds": 45.23,
      "duration_seconds": 5.36,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.9,
      "end_seconds": 52.39,
      "duration_seconds": 5.49,
      "text": "It's on and off. A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.55,
      "end_seconds": 65.3,
      "duration_seconds": 4.75,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 70.27,
      "duration_seconds": 3.78,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.17,
      "end_seconds": 75.98,
      "duration_seconds": 3.81,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.41,
      "end_seconds": 83.04,
      "duration_seconds": 5.63,
      "text": "A blood thinner. I take it 5 milligrams, stopped last month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.68,
      "end_seconds": 101.55,
      "duration_seconds": 2.87,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.79,
      "end_seconds": 114.36,
      "duration_seconds": 11.57,
      "text": "I live with my elderly mother. I drink a lot of tea and snack through the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.82,
      "end_seconds": 120.53,
      "duration_seconds": 4.71,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.33,
      "end_seconds": 122.91,
      "duration_seconds": 1.58,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.87,
      "end_seconds": 141.31,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.26,
      "end_seconds": 145.62,
      "duration_seconds": 2.36,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.74,
      "end_seconds": 150.28,
      "duration_seconds": 3.54,
      "text": "Alright, and what about hernia or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.44,
      "end_seconds": 155.04,
      "duration_seconds": 3.6,
      "text": "I haven't had hernia or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.52,
      "end_seconds": 158.18,
      "duration_seconds": 1.66,
      "text": "What about chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.76,
      "end_seconds": 165.44,
      "duration_seconds": 2.68,
      "text": "No, none, no chest pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.61,
      "end_seconds": 171.9,
      "duration_seconds": 5.29,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.14,
      "end_seconds": 176.12,
      "duration_seconds": 2.98,
      "text": "Um, no, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.68,
      "end_seconds": 179.0,
      "duration_seconds": 2.32,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.64,
      "end_seconds": 189.36,
      "duration_seconds": 2.72,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.97,
      "end_seconds": 215.03,
      "duration_seconds": 6.06,
      "text": "Okay: pulse 117, BP is 136 over 82, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.11,
      "end_seconds": 219.61,
      "duration_seconds": 2.5,
      "text": "Right, shall I start the examination?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.68,
      "end_seconds": 223.7,
      "duration_seconds": 1.02,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.11,
      "end_seconds": 226.96,
      "duration_seconds": 1.85,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.91,
      "end_seconds": 250.42,
      "duration_seconds": 9.51,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.33,
      "end_seconds": 259.36,
      "duration_seconds": 3.03,
      "text": "So, good, you can sit up again."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.59,
      "end_seconds": 279.1,
      "duration_seconds": 6.51,
      "text": "Okay, so my impression is this: This looks most like possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.88,
      "end_seconds": 287.47,
      "duration_seconds": 3.59,
      "text": "So, you know, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.44,
      "end_seconds": 313.51,
      "duration_seconds": 24.07,
      "text": "I understand the worry. At the moment I'd say it's possible bowel ischaemia, and we'll know more once the an urgent CT angiogram is back. Just to be sure I understood. You've had severe tummy pain out of proportion to the examination for two weeks, and no fever or hernia."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.91,
      "end_seconds": 321.61,
      "duration_seconds": 1.7,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.45,
      "end_seconds": 332.67,
      "duration_seconds": 5.22,
      "text": "I'm going to order an urgent CT angiogram, for possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.43,
      "end_seconds": 334.5,
      "duration_seconds": 1.07,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.14,
      "end_seconds": 357.49,
      "duration_seconds": 21.35,
      "text": "This is an emergency, you are going to hospital now. I think the surgical team should see you too. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.45,
      "end_seconds": 362.39,
      "duration_seconds": 3.94,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}