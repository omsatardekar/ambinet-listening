{
  "schema_version": "1.0",
  "encounter_id": "02939",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 2.18,
      "duration_seconds": 1.68,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.3,
      "end_seconds": 5.98,
      "duration_seconds": 2.68,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 9.4,
      "duration_seconds": 2.03,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.99,
      "end_seconds": 22.88,
      "duration_seconds": 11.89,
      "text": "Um, so... not being able to move the foot. That's why I came. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.07,
      "end_seconds": 30.88,
      "duration_seconds": 6.81,
      "text": "What's the timeline, when did it begin? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.37,
      "end_seconds": 35.41,
      "duration_seconds": 3.04,
      "text": "Right, ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.13,
      "end_seconds": 40.07,
      "duration_seconds": 2.94,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.41,
      "end_seconds": 45.21,
      "duration_seconds": 3.8,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.06,
      "end_seconds": 51.6,
      "duration_seconds": 4.54,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.61,
      "end_seconds": 55.0,
      "duration_seconds": 2.39,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.87,
      "end_seconds": 57.57,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.78,
      "end_seconds": 76.02,
      "duration_seconds": 4.24,
      "text": "Okay, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.44,
      "end_seconds": 82.33,
      "duration_seconds": 4.89,
      "text": "Bisoprolol. I take it 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.94,
      "end_seconds": 84.69,
      "duration_seconds": 1.75,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.37,
      "end_seconds": 87.45,
      "duration_seconds": 1.08,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.3,
      "end_seconds": 91.94,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.67,
      "end_seconds": 95.1,
      "duration_seconds": 2.43,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.56,
      "end_seconds": 112.35,
      "duration_seconds": 2.79,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.01,
      "end_seconds": 124.24,
      "duration_seconds": 10.23,
      "text": "I look after my grandchildren most days. No, I share a house with my brother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.6,
      "end_seconds": 129.67,
      "duration_seconds": 4.07,
      "text": "And what about fever, recent injury or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.18,
      "end_seconds": 136.2,
      "duration_seconds": 5.02,
      "text": "No fever, recent injury or chest pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.09,
      "end_seconds": 141.62,
      "duration_seconds": 3.53,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.64,
      "end_seconds": 144.79,
      "duration_seconds": 2.15,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.26,
      "end_seconds": 149.03,
      "duration_seconds": 2.77,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.71,
      "end_seconds": 161.2,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.67,
      "end_seconds": 181.67,
      "duration_seconds": 7.0,
      "text": "Okay: saturation 99 percent, temperature 37.1. And pulse 126, pressure 122 over 72."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.3,
      "end_seconds": 184.88,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.77,
      "end_seconds": 189.09,
      "duration_seconds": 2.32,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.28,
      "end_seconds": 192.59,
      "duration_seconds": 2.31,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.19,
      "end_seconds": 197.89,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.82,
      "end_seconds": 201.81,
      "duration_seconds": 1.99,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.27,
      "end_seconds": 227.01,
      "duration_seconds": 6.74,
      "text": "The right leg is cold, pale and mottled, with no pulses at the groin or below."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.03,
      "end_seconds": 234.01,
      "duration_seconds": 1.98,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.61,
      "end_seconds": 255.02,
      "duration_seconds": 5.41,
      "text": "Right, here's what I'm thinking. This looks most like an acutely ischaemic leg."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.31,
      "end_seconds": 258.34,
      "duration_seconds": 2.03,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.67,
      "end_seconds": 268.18,
      "duration_seconds": 8.51,
      "text": "Nothing I've seen today points to an emergency. It looks like an acutely ischaemic leg, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.18,
      "end_seconds": 282.88,
      "duration_seconds": 4.7,
      "text": "Let's book an urgent CT angiogram to look into acute limb ischaemia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.82,
      "end_seconds": 286.18,
      "duration_seconds": 1.36,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.09,
      "end_seconds": 306.54,
      "duration_seconds": 17.45,
      "text": "I'd like you to take heparin, 5000 units, bolus now, single dose. That's for limb ischaemia. You need the vascular surgeons now, this is time critical. I'd like you back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.63,
      "end_seconds": 310.96,
      "duration_seconds": 3.33,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}