{
  "schema_version": "1.0",
  "encounter_id": "02829",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 3.12,
      "duration_seconds": 1.78,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.86,
      "end_seconds": 9.41,
      "duration_seconds": 4.55,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.9,
      "end_seconds": 20.99,
      "duration_seconds": 10.09,
      "text": "So the thing is, I've got sneezing in spring. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.71,
      "end_seconds": 24.83,
      "duration_seconds": 3.12,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.14,
      "end_seconds": 29.11,
      "duration_seconds": 2.97,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.95,
      "end_seconds": 33.37,
      "duration_seconds": 3.42,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.57,
      "end_seconds": 38.38,
      "duration_seconds": 3.81,
      "text": "Hmm, about a three out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.56,
      "end_seconds": 45.13,
      "duration_seconds": 3.57,
      "text": "Alright, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.18,
      "end_seconds": 49.0,
      "duration_seconds": 1.82,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.83,
      "end_seconds": 52.42,
      "duration_seconds": 1.59,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.44,
      "end_seconds": 57.87,
      "duration_seconds": 3.43,
      "text": "Yes, pollen. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.37,
      "end_seconds": 62.67,
      "duration_seconds": 3.3,
      "text": "What about watery eyes, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.4,
      "end_seconds": 70.46,
      "duration_seconds": 2.06,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.42,
      "end_seconds": 74.5,
      "duration_seconds": 3.08,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.21,
      "end_seconds": 78.67,
      "duration_seconds": 3.46,
      "text": "Right, about a four out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.75,
      "end_seconds": 103.61,
      "duration_seconds": 6.86,
      "text": "So, what do you take on a normal day? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.24,
      "end_seconds": 107.9,
      "duration_seconds": 3.66,
      "text": "It's hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.37,
      "end_seconds": 109.17,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.0,
      "end_seconds": 113.67,
      "duration_seconds": 3.67,
      "text": "It's loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.88,
      "end_seconds": 119.77,
      "duration_seconds": 4.89,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.41,
      "end_seconds": 125.0,
      "duration_seconds": 2.59,
      "text": "Yes, I'm allergic to kiwi."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.73,
      "end_seconds": 127.48,
      "duration_seconds": 1.75,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.67,
      "end_seconds": 132.93,
      "duration_seconds": 4.26,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.54,
      "end_seconds": 138.11,
      "duration_seconds": 3.57,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 142.91,
      "duration_seconds": 3.29,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.52,
      "end_seconds": 146.86,
      "duration_seconds": 2.34,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.7,
      "end_seconds": 152.9,
      "duration_seconds": 4.2,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.26,
      "end_seconds": 166.05,
      "duration_seconds": 2.79,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.71,
      "end_seconds": 171.22,
      "duration_seconds": 3.51,
      "text": "High cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.94,
      "end_seconds": 175.69,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.8,
      "end_seconds": 182.2,
      "duration_seconds": 5.4,
      "text": "I've, I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.61,
      "end_seconds": 193.06,
      "duration_seconds": 9.45,
      "text": "Right, so high cholesterol and high blood pressure are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.82,
      "end_seconds": 209.76,
      "duration_seconds": 4.94,
      "text": "Did you get loss of smell, wheeze or facial pain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.7,
      "end_seconds": 216.32,
      "duration_seconds": 5.62,
      "text": "No loss of smell, wheeze or facial pain, none of it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.23,
      "end_seconds": 221.26,
      "duration_seconds": 3.03,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.04,
      "end_seconds": 226.46,
      "duration_seconds": 1.42,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.56,
      "end_seconds": 230.77,
      "duration_seconds": 3.21,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.19,
      "end_seconds": 246.02,
      "duration_seconds": 2.83,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.04,
      "end_seconds": 275.3,
      "duration_seconds": 14.26,
      "text": "Okay: saturation 97 percent, temp 36.8 degrees, weight 93 kilos. And blood pressure 109 over 81, BMI works out to 29.4, pulse is 85 beats a minute, height 178 centimetres."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.16,
      "end_seconds": 281.96,
      "duration_seconds": 3.8,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.31,
      "end_seconds": 285.52,
      "duration_seconds": 2.21,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.47,
      "end_seconds": 298.98,
      "duration_seconds": 5.51,
      "text": "The inside of the nose is pale and boggy with clear mucus."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.55,
      "end_seconds": 305.89,
      "duration_seconds": 2.34,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.31,
      "end_seconds": 319.82,
      "duration_seconds": 4.51,
      "text": "Taking everything into account, it fits best with seasonal allergic rhinitis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.8,
      "end_seconds": 324.82,
      "duration_seconds": 3.02,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.08,
      "end_seconds": 354.48,
      "duration_seconds": 28.4,
      "text": "I understand the worry. At the moment I'd say it's seasonal allergic rhinitis, and we'll watch how it goes. I'll start you on fluticasone nasal spray, 50 micrograms, once a day, the season. That's for hay fever. It's a commonly used medicine and most people tolerate it well. Shower after being outdoors and keep windows shut when pollen is high."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.0,
      "end_seconds": 371.62,
      "duration_seconds": 15.62,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back if not better in a month. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.59,
      "end_seconds": 375.05,
      "duration_seconds": 2.46,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.75,
      "end_seconds": 377.94,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}