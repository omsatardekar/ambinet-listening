{
  "schema_version": "1.0",
  "encounter_id": "02554",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 3.95,
      "duration_seconds": 3.24,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.73,
      "end_seconds": 9.47,
      "duration_seconds": 4.74,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.87,
      "end_seconds": 14.83,
      "duration_seconds": 3.96,
      "text": "I'm here cos of being very confused"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.67,
      "end_seconds": 18.24,
      "duration_seconds": 2.57,
      "text": "Right, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.89,
      "end_seconds": 30.1,
      "duration_seconds": 10.21,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.0,
      "end_seconds": 34.32,
      "duration_seconds": 3.32,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.19,
      "end_seconds": 43.29,
      "duration_seconds": 7.1,
      "text": "Moderate, I'd say. I've also had severe thirst and passing lots of urine."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.12,
      "end_seconds": 47.13,
      "duration_seconds": 3.01,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.95,
      "end_seconds": 52.84,
      "duration_seconds": 3.89,
      "text": "a four out of ten, I suppose"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.03,
      "end_seconds": 56.23,
      "duration_seconds": 2.2,
      "text": "has there been vomiting too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.07,
      "end_seconds": 70.46,
      "duration_seconds": 13.39,
      "text": "Yes, about the the same, about four days. As for vomiting, honestly, every other day. Bone pain was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.28,
      "end_seconds": 74.61,
      "duration_seconds": 3.33,
      "text": "right, any fall, fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.16,
      "end_seconds": 81.71,
      "duration_seconds": 5.55,
      "text": "I, I haven't had fall, fever or chest pain, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.73,
      "end_seconds": 84.34,
      "duration_seconds": 1.61,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.33,
      "end_seconds": 89.05,
      "duration_seconds": 2.72,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.13,
      "end_seconds": 93.75,
      "duration_seconds": 3.62,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.39,
      "end_seconds": 97.78,
      "duration_seconds": 2.39,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.81,
      "end_seconds": 102.98,
      "duration_seconds": 4.17,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.53,
      "end_seconds": 114.38,
      "duration_seconds": 9.85,
      "text": "Mirtazapine. I take it 15 milligrams, at night for my mood. I, I take Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.85,
      "end_seconds": 118.44,
      "duration_seconds": 2.59,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.03,
      "end_seconds": 124.74,
      "duration_seconds": 4.71,
      "text": "no, you know, not that I know of"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.19,
      "end_seconds": 139.81,
      "duration_seconds": 2.62,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.88,
      "end_seconds": 141.91,
      "duration_seconds": 1.03,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.93,
      "end_seconds": 148.61,
      "duration_seconds": 5.68,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.8,
      "end_seconds": 160.82,
      "duration_seconds": 11.02,
      "text": "Lots of rice, lentils and some fruit. No, I share a house with my brother. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.31,
      "end_seconds": 181.06,
      "duration_seconds": 3.75,
      "text": "So, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.84,
      "end_seconds": 191.81,
      "duration_seconds": 8.97,
      "text": "I have depression. So, I've had asthma, yes. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.91,
      "end_seconds": 206.49,
      "duration_seconds": 12.58,
      "text": "right, right right, so depression and asthma are already on your record we'll keep that in mind today i'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.2,
      "end_seconds": 219.59,
      "duration_seconds": 2.39,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.36,
      "end_seconds": 239.54,
      "duration_seconds": 6.18,
      "text": "Okay: temperature 36.8, pulse is 109 beats a minute, BP is 96 over 59."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.59,
      "end_seconds": 243.01,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.42,
      "end_seconds": 250.23,
      "duration_seconds": 3.81,
      "text": "I'll explain what these mean in a a moment"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.93,
      "end_seconds": 254.02,
      "duration_seconds": 2.09,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.56,
      "end_seconds": 258.5,
      "duration_seconds": 0.94,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.38,
      "end_seconds": 261.21,
      "duration_seconds": 1.83,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.15,
      "end_seconds": 281.33,
      "duration_seconds": 6.18,
      "text": "You are dehydrated and drowsy with a slow, odd rhythm on the monitor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.42,
      "end_seconds": 283.48,
      "duration_seconds": 1.06,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.01,
      "end_seconds": 300.93,
      "duration_seconds": 14.92,
      "text": "Alright, thank you, you can get dressed. From what you've told me and what I found, it points towards a high calcium emergency. It could also be a kidney failure, so we'll keep that open."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.02,
      "end_seconds": 304.2,
      "duration_seconds": 2.18,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.81,
      "end_seconds": 325.2,
      "duration_seconds": 19.39,
      "text": "I understand the worry. At the moment I'd say it's a high calcium emergency, and we'll know more once the an ECG is back. Stop me if I've got anything wrong. You've had being very confused, moderate, and no chest pain or fever."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.86,
      "end_seconds": 326.56,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.02,
      "end_seconds": 344.92,
      "duration_seconds": 3.9,
      "text": "I want an ECG done, that's for hypercalcaemia."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 346.71,
      "end_seconds": 351.13,
      "duration_seconds": 4.42,
      "text": "We have a slot Wednesday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.26,
      "end_seconds": 388.93,
      "duration_seconds": 36.67,
      "text": "I'll request urgent blood tests, it'll help with confusion and polyuria. We'll begin with sodium chloride 0.9%, 1 litre, over one hour, single dose. It's for dehydration. I'll put all of this in writing so you don't have to remember it. You need hospital fluids and treatment now. Cut down on salt and fried food for now, it really does make a difference. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.72,
      "end_seconds": 395.02,
      "duration_seconds": 4.3,
      "text": "Actually, uh, sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.28,
      "end_seconds": 400.48,
      "duration_seconds": 4.2,
      "text": "Come back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.19,
      "end_seconds": 402.83,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.38,
      "end_seconds": 405.86,
      "duration_seconds": 1.48,
      "text": "Look after yourself."
    }
  ]
}