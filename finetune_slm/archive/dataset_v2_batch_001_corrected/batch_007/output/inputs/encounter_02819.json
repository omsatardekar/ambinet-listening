{
  "schema_version": "1.0",
  "encounter_id": "02819",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 3.1,
      "duration_seconds": 1.71,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.29,
      "end_seconds": 5.41,
      "duration_seconds": 1.12,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 9.39,
      "duration_seconds": 2.02,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.91,
      "end_seconds": 13.18,
      "duration_seconds": 3.27,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.98,
      "end_seconds": 18.35,
      "duration_seconds": 3.37,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.25,
      "end_seconds": 24.5,
      "duration_seconds": 4.25,
      "text": "Um, so... swollen face. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.33,
      "end_seconds": 28.5,
      "duration_seconds": 3.17,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.58,
      "end_seconds": 38.66,
      "duration_seconds": 9.08,
      "text": "Alendronate, 70 milligrams, once a week for my bones. Febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.33,
      "end_seconds": 42.79,
      "duration_seconds": 3.46,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.05,
      "end_seconds": 51.87,
      "duration_seconds": 4.82,
      "text": "Right, uh, it's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.97,
      "end_seconds": 55.77,
      "duration_seconds": 2.8,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.66,
      "end_seconds": 67.45,
      "duration_seconds": 9.79,
      "text": "I'd say mild. Oh, I've had swollen glands too, for ten days. As for swollen glands, I'd say mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.51,
      "end_seconds": 80.5,
      "duration_seconds": 4.99,
      "text": "A few quick ones: mouth sores, breathing difficulty or blisters?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.3,
      "end_seconds": 85.86,
      "duration_seconds": 3.56,
      "text": "Oh, no, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.58,
      "end_seconds": 92.83,
      "duration_seconds": 5.25,
      "text": "Okay, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.51,
      "end_seconds": 95.16,
      "duration_seconds": 1.65,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.33,
      "end_seconds": 114.81,
      "duration_seconds": 3.48,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.5,
      "end_seconds": 120.12,
      "duration_seconds": 4.62,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.08,
      "end_seconds": 127.44,
      "duration_seconds": 2.36,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.5,
      "end_seconds": 136.49,
      "duration_seconds": 6.99,
      "text": "Ah, yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.55,
      "end_seconds": 140.37,
      "duration_seconds": 2.82,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.97,
      "end_seconds": 145.1,
      "duration_seconds": 4.13,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.07,
      "end_seconds": 148.24,
      "duration_seconds": 2.17,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.15,
      "end_seconds": 153.86,
      "duration_seconds": 3.71,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.65,
      "end_seconds": 157.91,
      "duration_seconds": 3.26,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.48,
      "end_seconds": 161.37,
      "duration_seconds": 2.89,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.04,
      "end_seconds": 168.9,
      "duration_seconds": 6.86,
      "text": "Has anyone ever diagnosed you with something? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.35,
      "end_seconds": 176.76,
      "duration_seconds": 6.41,
      "text": "I have thin bones. I've been putting this off for weeks. Yes, gout."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.17,
      "end_seconds": 180.56,
      "duration_seconds": 2.39,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.41,
      "end_seconds": 194.61,
      "duration_seconds": 2.2,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.07,
      "end_seconds": 224.87,
      "duration_seconds": 10.8,
      "text": "Okay: respiratory rate 17, SpO2 98 percent on room air, heart rate 88. And pressure 113 over 75, temp 38.4 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.72,
      "end_seconds": 228.4,
      "duration_seconds": 1.68,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.07,
      "end_seconds": 231.81,
      "duration_seconds": 2.74,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.6,
      "end_seconds": 239.41,
      "duration_seconds": 4.81,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.1,
      "end_seconds": 243.48,
      "duration_seconds": 2.38,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.57,
      "end_seconds": 263.7,
      "duration_seconds": 7.13,
      "text": "There is a widespread red rash, facial swelling, and your temperature is high with enlarged glands."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.55,
      "end_seconds": 267.3,
      "duration_seconds": 1.75,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.87,
      "end_seconds": 274.62,
      "duration_seconds": 1.75,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.5,
      "end_seconds": 291.89,
      "duration_seconds": 6.39,
      "text": "From what you've told me and what I found, this is probably a severe drug reaction."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.24,
      "end_seconds": 295.55,
      "duration_seconds": 2.31,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.26,
      "end_seconds": 305.94,
      "duration_seconds": 9.68,
      "text": "Nothing I've seen today points to an emergency. It looks like a severe drug reaction, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.0,
      "end_seconds": 349.78,
      "duration_seconds": 31.78,
      "text": "I'll request urgent blood tests, it'll help with severe drug reaction. The treatment will be prednisolone, 40 milligrams, once a day, until review. That should help with severe drug reaction. I'll put all of this in writing so you don't have to remember it. Stop the allopurinol now and you need admission. The dermatology team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.37,
      "end_seconds": 363.82,
      "duration_seconds": 13.45,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Alright, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.09,
      "end_seconds": 374.0,
      "duration_seconds": 6.91,
      "text": "So, I take the prednisolone, 40 milligrams, once a day. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.92,
      "end_seconds": 379.79,
      "duration_seconds": 3.87,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.81,
      "end_seconds": 384.18,
      "duration_seconds": 2.37,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}