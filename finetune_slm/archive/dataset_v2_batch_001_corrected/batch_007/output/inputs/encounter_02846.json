{
  "schema_version": "1.0",
  "encounter_id": "02846",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.32,
      "duration_seconds": 4.29,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 10.49,
      "duration_seconds": 4.11,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 15.24,
      "duration_seconds": 3.11,
      "text": "I've been dealing with aching bones."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.8,
      "end_seconds": 19.94,
      "duration_seconds": 3.14,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.72,
      "end_seconds": 31.82,
      "duration_seconds": 10.1,
      "text": "ah, it's been going on for one week i told myself I'd wait and see, and and here I am"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.42,
      "end_seconds": 38.15,
      "duration_seconds": 5.73,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.44,
      "end_seconds": 41.71,
      "duration_seconds": 2.27,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.31,
      "end_seconds": 47.4,
      "duration_seconds": 3.09,
      "text": "What about constipation, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.21,
      "end_seconds": 50.32,
      "duration_seconds": 2.11,
      "text": "Yes, since last Tuesday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.23,
      "end_seconds": 66.02,
      "duration_seconds": 3.79,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.25,
      "end_seconds": 78.11,
      "duration_seconds": 2.86,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.01,
      "end_seconds": 105.86,
      "duration_seconds": 11.85,
      "text": "Okay: BMI works out to 20.3, SpO2 99 percent on room air. And weight 52 kilos, height 160 centimetres, heart rate 85, pressure 114 over 77."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.04,
      "end_seconds": 111.32,
      "duration_seconds": 4.28,
      "text": "Alright, could you come over to the the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.65,
      "end_seconds": 114.1,
      "duration_seconds": 1.45,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.2,
      "end_seconds": 133.91,
      "duration_seconds": 4.71,
      "text": "your examination is normal and there is no tenderness over the bones"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.09,
      "end_seconds": 138.33,
      "duration_seconds": 2.24,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.53,
      "end_seconds": 160.06,
      "duration_seconds": 5.53,
      "text": "Let me check a few things. Any low mood, fever or fractures?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.99,
      "end_seconds": 164.91,
      "duration_seconds": 3.92,
      "text": "Well, you know, none of those, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.62,
      "end_seconds": 172.74,
      "duration_seconds": 3.12,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.13,
      "end_seconds": 178.62,
      "duration_seconds": 2.49,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.13,
      "end_seconds": 184.6,
      "duration_seconds": 4.47,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.13,
      "end_seconds": 187.61,
      "duration_seconds": 2.48,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.63,
      "end_seconds": 195.52,
      "duration_seconds": 2.89,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.1,
      "end_seconds": 199.58,
      "duration_seconds": 2.48,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.66,
      "end_seconds": 204.97,
      "duration_seconds": 3.31,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.64,
      "end_seconds": 208.81,
      "duration_seconds": 3.17,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.37,
      "end_seconds": 214.46,
      "duration_seconds": 4.09,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.33,
      "end_seconds": 221.02,
      "duration_seconds": 5.69,
      "text": "not currently, but as a youngster trimethoprim gave me itching"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.09,
      "end_seconds": 223.33,
      "duration_seconds": 1.24,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.41,
      "end_seconds": 225.9,
      "duration_seconds": 1.49,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.9,
      "end_seconds": 230.26,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.22,
      "end_seconds": 235.14,
      "duration_seconds": 2.92,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.67,
      "end_seconds": 237.62,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.54,
      "end_seconds": 243.03,
      "duration_seconds": 4.49,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.16,
      "end_seconds": 246.91,
      "duration_seconds": 2.75,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.66,
      "end_seconds": 251.3,
      "duration_seconds": 3.64,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.3,
      "end_seconds": 260.43,
      "duration_seconds": 7.13,
      "text": "So where does that leave us? It points towards possible raised calcium from an overactive parathyroid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.53,
      "end_seconds": 266.35,
      "duration_seconds": 3.82,
      "text": "Oh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.45,
      "end_seconds": 276.28,
      "duration_seconds": 8.83,
      "text": "it's reasonable to be concerned, but right now possible raised calcium from an overactive parathyroid is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.07,
      "end_seconds": 302.39,
      "duration_seconds": 17.32,
      "text": "We should do a calcium and parathyroid hormone test for kidney stones. I think a bone density scan makes sense here, for possible hyperparathyroidism. Drink plenty of water and avoid calcium supplements until the results. I think the endocrine clinic should see you too."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.66,
      "end_seconds": 304.36,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.72,
      "end_seconds": 326.42,
      "duration_seconds": 20.7,
      "text": "Let's hold off on a kidney ultrasound for now, and if there's no change next month we can revisit it. If the symptoms get worse, or you feel really unwell, please come to to the emergency department. We'll catch up after the results. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.6,
      "end_seconds": 330.75,
      "duration_seconds": 3.15,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.34,
      "end_seconds": 332.54,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}