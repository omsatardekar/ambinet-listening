        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Is it there all the time or does it come and go?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "It sort of comes and goes.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:48",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Alright, have you had a very fast heartbeat before, or is this the first time?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:56",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
