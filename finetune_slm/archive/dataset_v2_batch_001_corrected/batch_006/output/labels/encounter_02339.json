    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Since when exactly?",
      "start_timestamp": "00:29",
      "end_timestamp": "00:31",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "I, I'd say about four days. Actually, no, closer to two days.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Sure. How much trouble does it give you?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "Mild, really.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "Okay, so I've also had vomiting and diarrhoea, for about a month.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Would you say mild, moderate or severe?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "Mild, I'd say. Erm, um, as for high temperature, I honestly can't say when that began. It might have been last month or the month before.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:37",
      "supports": [
