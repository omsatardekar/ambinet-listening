  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "family_member",
      "transcript_text": "It's, It's a very fast heartbeat, doctor. She didn't want to come, but I insisted.",
