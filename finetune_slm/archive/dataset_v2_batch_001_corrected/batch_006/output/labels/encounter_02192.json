      "end_timestamp": "01:59",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How strong would you say it is?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
