  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've been dealing with a very fast heartbeat. I told myself I'd wait and see, and here I am.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:27",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, what's on your current medicine list?",
      "start_timestamp": "00:28",
      "end_timestamp": "00:31",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's escitalopram, 10 milligrams, once a day.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:36",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Alright, and for how long?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:39",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Six months now. I'm on furosemide, every morning.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:45",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you know the dose?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:49",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "40 milligrams, I think that's what's on the box.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:55",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And for how long?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:02",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "For two months. Sitagliptin. I take it 100 milligrams, once a day for my sugar. I do miss it now and then, to be fair. Let me think, I had Glycomet at one point, but I'm off it now.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:21",
      "supports": [
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like this?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since last night, that's when it began. I've never really been one for hospitals.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it bearing on you a lot?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About a eight out of ten.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, any other symptoms with it?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:46",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It usually comes with agitation.",
