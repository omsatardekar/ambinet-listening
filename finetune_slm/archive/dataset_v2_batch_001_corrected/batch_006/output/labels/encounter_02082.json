    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: pressure 109 over 71, respiratory rate 21, height 177 centimetres. And weight 72 kilos, pulse 106, temp 38.6 degrees, BMI works out to 23.0.",
