    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, that's enough for me. So where does that leave us? It fits best with a thyroid storm. I want to be honest that this is an impression, not a final answer.",
      "start_timestamp": "04:04",
      "end_timestamp": "04:20",
