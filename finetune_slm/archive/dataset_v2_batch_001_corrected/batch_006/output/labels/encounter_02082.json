    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I grab fast food at lunch most days. My husband and I live above the shop. I'm a plumber, lots of bending and kneeling.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:41",
      "supports": [
