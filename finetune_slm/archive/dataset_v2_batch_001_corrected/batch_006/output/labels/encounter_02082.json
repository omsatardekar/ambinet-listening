    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You are hot, shaking, and your pulse is over one hundred and forty and irregular.",
      "start_timestamp": "03:55",
      "end_timestamp": "04:01",
      "supports": [
