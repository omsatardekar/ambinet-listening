      "transcript_text": "No, no hearing loss.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has your skin been okay?",
      "start_timestamp": "01:48",
