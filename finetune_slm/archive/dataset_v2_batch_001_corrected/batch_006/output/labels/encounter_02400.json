  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "It's electric shock pains in my cheek, mostly.",
      "start_timestamp": "00:14",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "I'd say mild. It's on and off. I've also had being afraid to eat, for four weeks. Oh, and pain lasting seconds. Had that since yesterday. About pain lasting seconds, I'd say mild. It's a couple of times a week.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "Here are the numbers, doctor. SpO2 97 percent on room air, pulse is 70 beats a minute, blood pressure 113 over 75.",
      "start_timestamp": "00:52",
      "end_timestamp": "01:01",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Touching the right cheek sets off the pain and the face muscles work normally.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's all I needed to check. Have you had any hearing loss?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
