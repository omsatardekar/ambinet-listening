      "end_timestamp": "05:47",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_030",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sending you for a uric acid blood test because of gout. Rest the foot, ice it, and drink plenty of water; limit beer and red meat. A short walk every day, even twenty minutes, will help more than you'd think. We'll catch up in two weeks. Okay, does all of that make sense?",
