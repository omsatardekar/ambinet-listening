      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I've, I've had it since Monday. My neighbour said I should get it looked at. A neighbour of mine said I should see someone about it.",
