  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm here because of severe pain.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, how long has this been bothering you?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had it for three days.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it constant or in episodes?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "00:45",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It, It happens every other day.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How strong would you say it is?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:09",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'd say mild.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Any numbness in the foot as well?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:48",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, about a week. I've also had a bone sticking out of my lower leg, for about three months.",
      "start_timestamp": "01:50",
      "end_timestamp": "02:01",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about heavy bleeding, have you noticed that?",
      "start_timestamp": "02:03",
      "end_timestamp": "02:06",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I have.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:09",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_5",
      "speaker_role": "unknown",
      "transcript_text": "Yes, that's right, that's how it was.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:18",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_4",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, I've got the readings for you. Saturation 99 percent, temperature is 36.6 degrees, pulse 109. Respiratory rate 17, blood pressure 119 over 83.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:30",
      "supports": [
