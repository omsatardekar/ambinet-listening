      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'd say once or twice a day.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it a lot or only a little?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I mean, pretty severe, if I'm being honest. There was being drowsy, yes, but that went away.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you noticed chest pain, fever or rash?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nope, nothing like that.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ah. How are your bowels, any trouble?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:04",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, that side's been fine.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:07",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you taking anything regularly, including from the pharmacy?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:13",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I take furosemide, 40 milligrams, every morning for the fluid. It's alendronate, 70 milligrams, once a week for my bones.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:25",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been to theatre before?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:37",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I had keyhole surgery on my gallbladder, two years back.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are there any allergies I should be aware of?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:49",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not currently, uh, but as a youngster amoxicillin gave me a rash all over.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:57",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any long-term conditions?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, heart failure. I wasn't sure whether to come in at all, to be honest. I'm hoping you can tell me something definite. I have thin bones, for about a year.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, heart failure is known to us, good to have that clear. Now some background about your lifestyle.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]",
        "medical_history.social_history[3]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up cigarettes last spring. I'll have a glass of wine with dinner. I'm a plumber, lots of bending and kneeling. Not much, I mostly stay in these days.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:53",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]",
        "medical_history.social_history[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: BP is 113 over 77, saturation 98 percent. And respiratory rate 14, pulse 70. From what you've told me, my working impression is possible carbon monoxide poisoning.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:43",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing I've seen today points to an emergency. It looks like possible carbon monoxide poisoning, but I'd like to confirm.",
      "start_timestamp": "03:50",
      "end_timestamp": "03:58",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A carboxyhaemoglobin blood test is what I'd like next, for possible carbon monoxide poisoning.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:21",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We'll begin with high-flow oxygen, 15 litres per minute, continuous, until reviewed. That's for carbon monoxide poisoning. Leave the house now, don't use the boiler, and call the gas emergency number. I'm going to send a referral to the emergency team.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:43",
      "supports": [
        "medications[2]",
        "clinical_actions[1]",
        "clinical_actions[2]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
