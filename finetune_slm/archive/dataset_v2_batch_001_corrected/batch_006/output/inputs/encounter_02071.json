      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.84,
      "end_seconds": 261.18,
      "duration_seconds": 9.34,
      "text": "Nothing I've seen today points to an emergency. It looks like a routine screen with no symptoms, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 285.06,
      "duration_seconds": 5.4,
      "text": "Let's get a urine test for chlamydia and gonorrhoea, for sexual health screen."
