      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.02,
      "end_seconds": 250.34,
      "duration_seconds": 3.32,
      "text": "what are the odds it's serious?"
