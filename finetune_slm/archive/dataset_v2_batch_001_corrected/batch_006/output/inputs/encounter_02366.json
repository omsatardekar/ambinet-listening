{
  "schema_version": "1.0",
  "encounter_id": "02366",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.79,
      "duration_seconds": 5.66,
      "text": "Erm, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 11.83,
      "duration_seconds": 4.46,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.12,
      "end_seconds": 24.28,
      "duration_seconds": 11.16,
      "text": "I mean, doctor, it's sudden severe pain on the right side of my pelvis. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.34,
      "end_seconds": 28.1,
      "duration_seconds": 1.76,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.13,
      "end_seconds": 33.15,
      "duration_seconds": 4.02,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.12,
      "end_seconds": 45.3,
      "duration_seconds": 10.18,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.52,
      "end_seconds": 53.19,
      "duration_seconds": 6.67,
      "text": "I'd say every other day. I notice it more with movement"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.78,
      "end_seconds": 57.91,
      "duration_seconds": 3.13,
      "text": "have you had pain that comes in waves?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.81,
      "end_seconds": 68.21,
      "duration_seconds": 8.4,
      "text": "right, you know, yes, since last night. And And I've been feeling faint as well"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.4,
      "end_seconds": 78.84,
      "duration_seconds": 2.44,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.78,
      "end_seconds": 82.26,
      "duration_seconds": 1.48,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.95,
      "end_seconds": 91.65,
      "duration_seconds": 3.7,
      "text": "Have you noticed discharge, missed period or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.01,
      "end_seconds": 97.96,
      "duration_seconds": 4.95,
      "text": "No, you know, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.33,
      "end_seconds": 103.23,
      "duration_seconds": 3.9,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.08,
      "end_seconds": 107.95,
      "duration_seconds": 3.87,
      "text": "yeah, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.27,
      "end_seconds": 112.49,
      "duration_seconds": 3.22,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.9,
      "end_seconds": 115.08,
      "duration_seconds": 1.18,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.06,
      "end_seconds": 119.6,
      "duration_seconds": 3.54,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.65,
      "end_seconds": 124.22,
      "duration_seconds": 2.57,
      "text": "Gout, for nearly five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.29,
      "end_seconds": 130.21,
      "duration_seconds": 2.92,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.73,
      "end_seconds": 146.97,
      "duration_seconds": 15.24,
      "text": "I quit smoking around ten years ago. I retired from the post office two years ago. I hardly move around during the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.29,
      "end_seconds": 156.16,
      "duration_seconds": 4.87,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.54,
      "end_seconds": 162.08,
      "duration_seconds": 4.54,
      "text": "um, I take febuxostat, once a day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.1,
      "end_seconds": 165.46,
      "duration_seconds": 2.36,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.11,
      "end_seconds": 171.31,
      "duration_seconds": 5.2,
      "text": "80 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.0,
      "end_seconds": 177.25,
      "duration_seconds": 5.25,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.99,
      "end_seconds": 182.74,
      "duration_seconds": 4.75,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 186.38,
      "duration_seconds": 2.62,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.84,
      "end_seconds": 200.36,
      "duration_seconds": 2.52,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.79,
      "end_seconds": 224.62,
      "duration_seconds": 5.83,
      "text": "Okay: SpO2 98 percent on room air, heart rate 113, pressure 115 over 80."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.86,
      "end_seconds": 246.51,
      "duration_seconds": 9.65,
      "text": "Listening to the whole story, it fits best with possible ovarian torsion. It could also be appendicitis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.96,
      "end_seconds": 260.35,
      "duration_seconds": 3.39,
      "text": "Let's get a pregnancy test, for pelvic pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 263.94,
      "end_seconds": 267.69,
      "duration_seconds": 3.75,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.13,
      "end_seconds": 285.94,
      "duration_seconds": 16.81,
      "text": "I want an urgent pelvic ultrasound done, that's for possible torsion. You need an emergency scan and probably surgery today. I'd like you to see the gynaecology team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.64,
      "end_seconds": 288.34,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.13,
      "end_seconds": 295.94,
      "duration_seconds": 5.81,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.38,
      "end_seconds": 299.21,
      "duration_seconds": 1.83,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.62,
      "end_seconds": 304.99,
      "duration_seconds": 4.37,
      "text": "see me again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.95,
      "end_seconds": 312.07,
      "duration_seconds": 5.12,
      "text": "Um, you know, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.67,
      "end_seconds": 314.26,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}