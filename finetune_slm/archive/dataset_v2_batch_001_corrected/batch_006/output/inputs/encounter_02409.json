{
  "schema_version": "1.0",
  "encounter_id": "02409",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 4.3,
      "duration_seconds": 3.8,
      "text": "Hello, come in. Mind the step. What's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.91,
      "end_seconds": 13.29,
      "duration_seconds": 8.38,
      "text": "I, I wanted to get a knee that gave way playing football looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.14,
      "end_seconds": 19.42,
      "duration_seconds": 4.28,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.78,
      "end_seconds": 31.67,
      "duration_seconds": 2.89,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.14,
      "end_seconds": 53.16,
      "duration_seconds": 10.02,
      "text": "Okay: blood pressure 110 over 70, pulse is 70 beats a minute, oxygen saturation is 97 percent, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.72,
      "end_seconds": 57.02,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.08,
      "end_seconds": 63.46,
      "duration_seconds": 5.38,
      "text": "Don't worry, we'll discuss it in a second. Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.51,
      "end_seconds": 76.42,
      "duration_seconds": 10.91,
      "text": "Ah, I've had it for about four days. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.08,
      "end_seconds": 86.29,
      "duration_seconds": 8.21,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.68,
      "end_seconds": 96.55,
      "duration_seconds": 8.87,
      "text": "I mean, mostly severe. I notice it more with twisting. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.08,
      "end_seconds": 100.21,
      "duration_seconds": 2.13,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.0,
      "end_seconds": 128.26,
      "duration_seconds": 26.26,
      "text": "I mean, when it starts I tend to get a pop at the time as well. As for swelling within hours, I honestly can't say when that began. It might have been last month or the month before. Actually, with swelling within hours, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.48,
      "end_seconds": 130.19,
      "duration_seconds": 1.71,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.85,
      "end_seconds": 144.3,
      "duration_seconds": 12.45,
      "text": "Oh, and not being able to straighten it fully. Oh, the pop at the time? That's been for one week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 153.72,
      "duration_seconds": 7.44,
      "text": "Okay, have you had a knee that gave way playing football before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.25,
      "end_seconds": 159.62,
      "duration_seconds": 5.37,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.75,
      "end_seconds": 162.34,
      "duration_seconds": 1.59,
      "text": "Any sign of fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.07,
      "end_seconds": 167.3,
      "duration_seconds": 3.23,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.25,
      "end_seconds": 173.16,
      "duration_seconds": 3.91,
      "text": "Did you get calf pain, locked knee or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.96,
      "end_seconds": 176.12,
      "duration_seconds": 2.16,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.91,
      "end_seconds": 179.24,
      "duration_seconds": 2.33,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.73,
      "end_seconds": 183.25,
      "duration_seconds": 2.52,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.74,
      "end_seconds": 189.76,
      "duration_seconds": 4.02,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.48,
      "end_seconds": 194.21,
      "duration_seconds": 3.73,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.33,
      "end_seconds": 199.18,
      "duration_seconds": 3.85,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.88,
      "end_seconds": 205.07,
      "duration_seconds": 4.19,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.99,
      "end_seconds": 208.38,
      "duration_seconds": 2.39,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.69,
      "end_seconds": 212.24,
      "duration_seconds": 2.55,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.91,
      "end_seconds": 215.59,
      "duration_seconds": 1.68,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.52,
      "end_seconds": 220.27,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.71,
      "end_seconds": 234.1,
      "duration_seconds": 4.39,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.03,
      "end_seconds": 242.57,
      "duration_seconds": 7.54,
      "text": "I take escitalopram, 10 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.58,
      "end_seconds": 248.84,
      "duration_seconds": 4.26,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.88,
      "end_seconds": 266.06,
      "duration_seconds": 12.18,
      "text": "No, you know, it's at home. Alendronate, 70 milligrams, once a week. Ibuprofen. I take it 400 milligrams, with food."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.5,
      "end_seconds": 278.47,
      "duration_seconds": 4.97,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.08,
      "end_seconds": 284.75,
      "duration_seconds": 4.67,
      "text": "Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.14,
      "end_seconds": 289.89,
      "duration_seconds": 3.75,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.53,
      "end_seconds": 298.21,
      "duration_seconds": 6.68,
      "text": "I've got depression. So, I've had thin bones for about ten years now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.06,
      "end_seconds": 314.67,
      "duration_seconds": 15.61,
      "text": "Going by what you've described, this looks most like a likely anterior cruciate ligament tear. That's my thinking for now, and it may change as we learn more. A meniscal tear is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.5,
      "end_seconds": 318.12,
      "duration_seconds": 2.62,
      "text": "Yeah, will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.85,
      "end_seconds": 328.22,
      "duration_seconds": 8.37,
      "text": "I can't promise yet, but most people with a likely anterior cruciate ligament tear do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.45,
      "end_seconds": 363.55,
      "duration_seconds": 26.1,
      "text": "I'll request an X-ray of the knee, it'll help with knee injury. I want an MRI of the knee done, that's for knee injury. Rest, ice and elevation, and use crutches until the scan. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Let's get you seen by the sports injury clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.32,
      "end_seconds": 369.41,
      "duration_seconds": 5.09,
      "text": "Let me think, sure, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.93,
      "end_seconds": 380.23,
      "duration_seconds": 9.3,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.35,
      "end_seconds": 382.97,
      "duration_seconds": 1.62,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.85,
      "end_seconds": 389.48,
      "duration_seconds": 4.63,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.07,
      "end_seconds": 393.79,
      "duration_seconds": 2.72,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.49,
      "end_seconds": 396.18,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}