{
  "schema_version": "1.0",
  "encounter_id": "02331",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.59,
      "duration_seconds": 3.36,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 9.44,
      "duration_seconds": 3.73,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.58,
      "end_seconds": 18.25,
      "duration_seconds": 7.67,
      "text": "Mainly night sweats. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.93,
      "end_seconds": 23.21,
      "duration_seconds": 3.28,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.49,
      "end_seconds": 28.52,
      "duration_seconds": 4.03,
      "text": "I'm on sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.79,
      "end_seconds": 31.82,
      "duration_seconds": 3.03,
      "text": "Okay, go on. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.48,
      "end_seconds": 36.96,
      "duration_seconds": 3.48,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.39,
      "end_seconds": 43.15,
      "duration_seconds": 4.76,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.72,
      "end_seconds": 50.79,
      "duration_seconds": 6.07,
      "text": "About a six out of ten. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.13,
      "end_seconds": 57.86,
      "duration_seconds": 2.73,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.78,
      "end_seconds": 79.96,
      "duration_seconds": 20.18,
      "text": "When it starts I tend to get small painful spots on my fingers as well. The small painful spots on my fingers? That's been since last night. As for small painful spots on my fingers, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 85.78,
      "duration_seconds": 3.85,
      "text": "Any cough, weight loss or chest pain at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.96,
      "end_seconds": 92.4,
      "duration_seconds": 5.44,
      "text": "No cough, weight loss or chest pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.17,
      "end_seconds": 96.18,
      "duration_seconds": 3.01,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.42,
      "end_seconds": 99.33,
      "duration_seconds": 1.91,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.32,
      "end_seconds": 106.27,
      "duration_seconds": 4.95,
      "text": "Right, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.19,
      "end_seconds": 108.55,
      "duration_seconds": 1.36,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.48,
      "end_seconds": 111.61,
      "duration_seconds": 2.13,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.12,
      "end_seconds": 118.0,
      "duration_seconds": 5.88,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.54,
      "end_seconds": 122.27,
      "duration_seconds": 2.73,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.47,
      "end_seconds": 127.32,
      "duration_seconds": 3.85,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.58,
      "end_seconds": 130.95,
      "duration_seconds": 2.37,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.11,
      "end_seconds": 135.53,
      "duration_seconds": 3.42,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.61,
      "end_seconds": 147.49,
      "duration_seconds": 2.88,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.53,
      "end_seconds": 155.82,
      "duration_seconds": 6.29,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.75,
      "end_seconds": 174.34,
      "duration_seconds": 3.59,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.39,
      "end_seconds": 179.06,
      "duration_seconds": 3.67,
      "text": "I have migraines, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.94,
      "end_seconds": 183.07,
      "duration_seconds": 2.13,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.73,
      "end_seconds": 192.72,
      "duration_seconds": 2.99,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.35,
      "end_seconds": 214.69,
      "duration_seconds": 12.34,
      "text": "Okay: weight 83 kilos, height 154 centimetres, pressure 113 over 69. And pulse is 108 beats a minute, temperature is 39.0 degrees, oxygen saturation is 95 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.16,
      "end_seconds": 220.32,
      "duration_seconds": 4.16,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.11,
      "end_seconds": 224.45,
      "duration_seconds": 2.34,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.97,
      "end_seconds": 240.12,
      "duration_seconds": 8.15,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.96,
      "end_seconds": 247.59,
      "duration_seconds": 2.63,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.2,
      "end_seconds": 266.7,
      "duration_seconds": 7.5,
      "text": "Okay, so my impression is this: This is probably possible infective endocarditis. A viral illness is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.74,
      "end_seconds": 272.61,
      "duration_seconds": 3.87,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.03,
      "end_seconds": 285.4,
      "duration_seconds": 11.37,
      "text": "I can't promise yet, but most people with possible infective endocarditis do well once it's treated properly. I'm going to order blood cultures, for possible endocarditis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.01,
      "end_seconds": 292.4,
      "duration_seconds": 2.39,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.02,
      "end_seconds": 306.96,
      "duration_seconds": 10.94,
      "text": "We should do blood tests for prolonged fever. You need admission today for blood cultures and a heart scan. We'll refer you to the cardiology team."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.36,
      "end_seconds": 313.99,
      "duration_seconds": 5.63,
      "text": "Okay. Uh, you know, should I have an echocardiogram as well?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.61,
      "end_seconds": 324.71,
      "duration_seconds": 9.1,
      "text": "Not right now, it wouldn't change what we do today. See me again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.96,
      "end_seconds": 329.86,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.88,
      "end_seconds": 332.21,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}