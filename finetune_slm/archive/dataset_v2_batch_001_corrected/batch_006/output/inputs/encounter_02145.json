{
  "schema_version": "1.0",
  "encounter_id": "02145",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.35,
      "duration_seconds": 3.81,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.27,
      "end_seconds": 10.43,
      "duration_seconds": 5.16,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.72,
      "end_seconds": 20.75,
      "duration_seconds": 4.03,
      "text": "It's spots on my forehead and chin, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.73,
      "end_seconds": 29.14,
      "duration_seconds": 6.41,
      "text": "How long has it been like this? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.05,
      "end_seconds": 32.83,
      "duration_seconds": 2.78,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.08,
      "end_seconds": 36.19,
      "duration_seconds": 3.11,
      "text": "Ah. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.19,
      "end_seconds": 38.32,
      "duration_seconds": 1.13,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.08,
      "end_seconds": 41.53,
      "duration_seconds": 2.45,
      "text": "Alright, have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.39,
      "end_seconds": 46.26,
      "duration_seconds": 3.87,
      "text": "I, I notice it more with stress."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.58,
      "end_seconds": 67.29,
      "duration_seconds": 4.71,
      "text": "Did you get painful cysts, low mood or irregular periods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.08,
      "end_seconds": 71.84,
      "duration_seconds": 2.76,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.7,
      "end_seconds": 76.05,
      "duration_seconds": 2.35,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.04,
      "end_seconds": 79.5,
      "duration_seconds": 1.46,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.7,
      "end_seconds": 89.9,
      "duration_seconds": 3.2,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.7,
      "end_seconds": 94.5,
      "duration_seconds": 2.8,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.06,
      "end_seconds": 96.42,
      "duration_seconds": 1.36,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.77,
      "end_seconds": 103.36,
      "duration_seconds": 3.59,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.57,
      "end_seconds": 106.63,
      "duration_seconds": 2.06,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.79,
      "end_seconds": 112.14,
      "duration_seconds": 4.35,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.94,
      "end_seconds": 116.76,
      "duration_seconds": 2.82,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.97,
      "end_seconds": 122.18,
      "duration_seconds": 4.21,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 125.9,
      "duration_seconds": 2.26,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.63,
      "end_seconds": 133.31,
      "duration_seconds": 2.68,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.28,
      "end_seconds": 138.18,
      "duration_seconds": 2.9,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.07,
      "end_seconds": 147.01,
      "duration_seconds": 3.94,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.4,
      "end_seconds": 162.2,
      "duration_seconds": 2.8,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.14,
      "end_seconds": 166.44,
      "duration_seconds": 3.3,
      "text": "Um, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.18,
      "end_seconds": 169.37,
      "duration_seconds": 2.19,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.94,
      "end_seconds": 173.27,
      "duration_seconds": 3.33,
      "text": "I have migraines, for nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.49,
      "end_seconds": 190.33,
      "duration_seconds": 3.84,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.4,
      "end_seconds": 195.04,
      "duration_seconds": 3.64,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.56,
      "end_seconds": 199.87,
      "duration_seconds": 3.31,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 213.44,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.3,
      "end_seconds": 245.36,
      "duration_seconds": 10.06,
      "text": "Okay: pulse is 80 beats a minute, pressure 119 over 82, SpO2 98 percent on room air, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.9,
      "end_seconds": 248.13,
      "duration_seconds": 2.23,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.16,
      "end_seconds": 252.6,
      "duration_seconds": 2.44,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.22,
      "end_seconds": 258.57,
      "duration_seconds": 4.35,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.0,
      "end_seconds": 262.52,
      "duration_seconds": 2.52,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.11,
      "end_seconds": 276.23,
      "duration_seconds": 5.12,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.12,
      "end_seconds": 290.77,
      "duration_seconds": 8.65,
      "text": "That's all I needed to check. Okay, so my impression is this: This looks most like mild acne."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.6,
      "end_seconds": 293.75,
      "duration_seconds": 2.15,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.75,
      "end_seconds": 320.34,
      "duration_seconds": 24.59,
      "text": "I understand the worry. At the moment I'd say it's mild acne, and we'll watch how it goes. I'd like you to take benzoyl peroxide gel, 5%, once a day, eight weeks. That's for acne. Wash gently twice a day and don't squeeze the spots. I'd like to see you again in eight weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.69,
      "end_seconds": 325.37,
      "duration_seconds": 3.68,
      "text": "Yeah, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.39,
      "end_seconds": 328.61,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}