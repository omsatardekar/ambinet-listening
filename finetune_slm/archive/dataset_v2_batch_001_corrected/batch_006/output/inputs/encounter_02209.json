  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.19,
      "end_seconds": 8.51,
      "duration_seconds": 7.32,
      "text": "doctor, your next patient is here. I've done the basics, I'll read them out in a moment"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.01,
      "end_seconds": 13.17,
      "duration_seconds": 4.16,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.91,
      "end_seconds": 19.41,
      "duration_seconds": 4.5,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.77,
      "end_seconds": 24.18,
      "duration_seconds": 3.41,
      "text": "Okay, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.74,
      "end_seconds": 27.89,
      "duration_seconds": 3.15,
      "text": "we came because of no symptoms"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.95,
      "end_seconds": 32.33,
      "duration_seconds": 2.38,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.4,
      "end_seconds": 45.21,
      "duration_seconds": 11.81,
      "text": "Being a little overweight goes along with it most of the time. The Being a little overweight? That's been for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.36,
      "end_seconds": 52.03,
      "duration_seconds": 5.67,
      "text": "Right, any a high blood sugar on a routine test as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.1,
      "end_seconds": 61.38,
      "duration_seconds": 8.28,
      "text": "yes, you know, I have. About high blood sugar on a routine test, I'd call it moderate"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.35,
      "end_seconds": 64.16,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.95,
      "end_seconds": 68.58,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.44,
      "end_seconds": 73.93,
      "duration_seconds": 3.49,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.73,
      "end_seconds": 78.19,
      "duration_seconds": 3.46,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.28,
      "end_seconds": 80.47,
      "duration_seconds": 1.19,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.26,
      "end_seconds": 84.4,
      "duration_seconds": 3.14,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.03,
      "end_seconds": 98.89,
      "duration_seconds": 2.86,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.5,
      "end_seconds": 103.63,
      "duration_seconds": 4.13,
      "text": "I've got an underactive thyroid. I have asthma"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.34,
      "end_seconds": 106.75,
      "duration_seconds": 1.41,
      "text": "Okay go on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.8,
      "end_seconds": 118.26,
      "duration_seconds": 10.46,
      "text": "Yes heart disease. My family kept telling me to get it checked. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.19,
      "end_seconds": 128.66,
      "duration_seconds": 9.47,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 135.58,
      "duration_seconds": 5.24,
      "text": "actually, something called eltr... Eltroxin, 100 micrograms, maybe, every morning"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.86,
      "end_seconds": 144.06,
      "duration_seconds": 3.2,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.96,
      "end_seconds": 150.28,
      "duration_seconds": 5.32,
      "text": "no, it's at home so, I take Asthalin inhaler, when needed"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.37,
      "end_seconds": 155.67,
      "duration_seconds": 3.3,
      "text": "alright, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.36,
      "end_seconds": 162.68,
      "duration_seconds": 5.32,
      "text": "just two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.44,
      "end_seconds": 167.24,
      "duration_seconds": 2.8,
      "text": "before we go further any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.84,
      "end_seconds": 172.82,
      "duration_seconds": 3.98,
      "text": "No, I'm not allergic to to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 177.5,
      "end_seconds": 184.27,
      "duration_seconds": 6.77,
      "text": "Hold on, doctor, I think she reacted to trimethoprim once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.45,
      "end_seconds": 188.68,
      "duration_seconds": 3.23,
      "text": "maybe, but I don't recall it"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.69,
      "end_seconds": 198.15,
      "duration_seconds": 4.46,
      "text": "alright, so that's unclear i'll record what each of you said"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.0,
      "end_seconds": 218.06,
      "duration_seconds": 5.06,
      "text": "so, a few quick ones: blurred vision, weight loss or frequent urination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.24,
      "end_seconds": 227.73,
      "duration_seconds": 5.49,
      "text": "Sorry what was I saying no not a single one."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.91,
      "end_seconds": 231.85,
      "duration_seconds": 2.94,
      "text": "have you had thirst by any chance?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.78,
      "end_seconds": 236.19,
      "duration_seconds": 3.41,
      "text": "No, I haven't had any thirst."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 241.98,
      "duration_seconds": 2.12,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.73,
      "end_seconds": 244.13,
      "duration_seconds": 1.4,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.1,
      "end_seconds": 247.83,
      "duration_seconds": 2.73,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.75,
      "end_seconds": 250.11,
      "duration_seconds": 1.36,
      "text": "nothing there no"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 254.63,
      "end_seconds": 270.41,
      "duration_seconds": 15.78,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 98 percent, pressure 113 over 73. Respiratory rate 14, BMI works out to 25.1, temperature 36.5, height 185 centimetres, weight 86 kilos, heart rate 81."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.17,
      "end_seconds": 272.15,
      "duration_seconds": 0.98,
      "text": "Okay thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.27,
      "end_seconds": 277.72,
      "duration_seconds": 4.45,
      "text": "Alright over here please and and I'll take a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 278.82,
      "end_seconds": 279.83,
      "duration_seconds": 1.01,
      "text": "okay doctor"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.49,
      "end_seconds": 283.69,
      "duration_seconds": 2.2,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.86,
      "end_seconds": 305.26,
      "duration_seconds": 3.4,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.86,
      "end_seconds": 318.35,
      "duration_seconds": 7.49,
      "text": "right thank you you can get dressed. Okay so my impression is this: This looks most like prediabetes"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.4,
      "end_seconds": 320.92,
      "duration_seconds": 1.52,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.1,
      "end_seconds": 330.46,
      "duration_seconds": 8.36,
      "text": "Nothing I've seen today points to an emergency. It looks like prediabetes, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.51,
      "end_seconds": 369.41,
      "duration_seconds": 29.9,
      "text": "I'll request a repeat HbA1c, it'll help with prediabetes. Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. Please take the tablets with food so they don't upset your stomach. I'd like you to see the diabetes prevention programme as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.28,
      "end_seconds": 372.72,
      "duration_seconds": 1.44,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.72,
      "end_seconds": 377.52,
      "duration_seconds": 2.8,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.21,
      "end_seconds": 381.14,
      "duration_seconds": 2.93,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.87,
      "end_seconds": 383.79,
      "duration_seconds": 1.92,
      "text": "have a good day"
    }
  ]
}