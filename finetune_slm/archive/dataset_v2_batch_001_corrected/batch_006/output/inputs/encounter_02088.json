      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.82,
      "end_seconds": 261.62,
      "duration_seconds": 2.8,
      "text": "oh, will it clear up?"
