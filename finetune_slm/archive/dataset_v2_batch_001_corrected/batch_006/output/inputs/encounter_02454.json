{
  "schema_version": "1.0",
  "encounter_id": "02454",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 5.72,
      "duration_seconds": 4.74,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.53,
      "end_seconds": 8.69,
      "duration_seconds": 1.16,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.51,
      "end_seconds": 12.31,
      "duration_seconds": 2.8,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 18.4,
      "duration_seconds": 5.5,
      "text": "So the thing is, I've got an ulcer under the big toe."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.36,
      "end_seconds": 26.46,
      "duration_seconds": 7.1,
      "text": "What's the timeline, when did it begin? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 32.96,
      "duration_seconds": 5.51,
      "text": "Around two days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.87,
      "end_seconds": 39.89,
      "duration_seconds": 3.02,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.55,
      "end_seconds": 44.85,
      "duration_seconds": 4.3,
      "text": "Severe, I'd say. And a red swollen foot, too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.84,
      "end_seconds": 50.25,
      "duration_seconds": 3.41,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.52,
      "end_seconds": 53.69,
      "duration_seconds": 2.17,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.93,
      "end_seconds": 63.03,
      "duration_seconds": 5.1,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.98,
      "end_seconds": 68.81,
      "duration_seconds": 3.83,
      "text": "I take metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.47,
      "end_seconds": 89.37,
      "duration_seconds": 4.9,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.89,
      "end_seconds": 96.02,
      "duration_seconds": 6.13,
      "text": "I've got diabetes. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.57,
      "end_seconds": 99.33,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.91,
      "end_seconds": 114.57,
      "duration_seconds": 13.66,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I do a yoga class on Thursdays. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.17,
      "end_seconds": 119.78,
      "duration_seconds": 3.61,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.17,
      "end_seconds": 124.22,
      "duration_seconds": 3.05,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.16,
      "end_seconds": 145.06,
      "duration_seconds": 1.9,
      "text": "What about tracking redness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.12,
      "end_seconds": 149.14,
      "duration_seconds": 3.02,
      "text": "No, none, no tracking redness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.01,
      "end_seconds": 157.32,
      "duration_seconds": 7.31,
      "text": "Let me check a few things. Any black skin, fever or pain in the foot?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.61,
      "end_seconds": 163.59,
      "duration_seconds": 4.98,
      "text": "No, no black skin, fever or pain in the foot."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 166.59,
      "duration_seconds": 1.4,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.66,
      "end_seconds": 170.33,
      "duration_seconds": 1.67,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.22,
      "end_seconds": 174.4,
      "duration_seconds": 2.18,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.83,
      "end_seconds": 183.25,
      "duration_seconds": 2.42,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.6,
      "end_seconds": 199.89,
      "duration_seconds": 5.29,
      "text": "Okay: pressure 108 over 79, temperature 39.0, heart rate 108."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.43,
      "end_seconds": 201.99,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.24,
      "end_seconds": 206.12,
      "duration_seconds": 2.88,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.11,
      "end_seconds": 213.05,
      "duration_seconds": 3.94,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.1,
      "end_seconds": 217.0,
      "duration_seconds": 2.9,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.94,
      "end_seconds": 236.27,
      "duration_seconds": 6.33,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.35,
      "end_seconds": 250.39,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.27,
      "end_seconds": 257.55,
      "duration_seconds": 2.28,
      "text": "So, please sit back down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.69,
      "end_seconds": 282.57,
      "duration_seconds": 7.88,
      "text": "Let me tell you where I've got to. This looks most like an infected diabetic foot ulcer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.67,
      "end_seconds": 287.65,
      "duration_seconds": 2.98,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.2,
      "end_seconds": 320.55,
      "duration_seconds": 31.35,
      "text": "It's reasonable to be concerned, but right now an infected diabetic foot ulcer is my leading thought, not anything worse. We should do blood tests for infected ulcer. For this, co-amoxiclav, 625 milligrams, three times a day, seven days. It's for infected ulcer. Keep the weight off the foot and keep the dressing dry. I'll also refer you to the diabetic foot clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.97,
      "end_seconds": 325.67,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.34,
      "end_seconds": 332.81,
      "duration_seconds": 5.47,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.73,
      "end_seconds": 335.62,
      "duration_seconds": 0.89,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.02,
      "end_seconds": 339.81,
      "duration_seconds": 2.79,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.07,
      "end_seconds": 344.05,
      "duration_seconds": 2.98,
      "text": "Great, thank you for your help."
    }
  ]
}