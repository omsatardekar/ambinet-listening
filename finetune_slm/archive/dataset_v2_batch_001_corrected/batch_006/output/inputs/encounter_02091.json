{
  "schema_version": "1.0",
  "encounter_id": "02091",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 8.09,
      "duration_seconds": 7.2,
      "text": "Hello doctor, sorry, I took a wrong turn on the the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.57,
      "end_seconds": 14.35,
      "duration_seconds": 4.78,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.99,
      "end_seconds": 24.14,
      "duration_seconds": 8.15,
      "text": "I wanted to get sudden severe pain on the right side of my pelvis looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.91,
      "end_seconds": 29.11,
      "duration_seconds": 4.2,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 39.94,
      "duration_seconds": 2.04,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.95,
      "end_seconds": 60.43,
      "duration_seconds": 5.48,
      "text": "Okay: pressure 137 over 86, pulse 115, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.99,
      "end_seconds": 62.42,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.58,
      "end_seconds": 69.0,
      "duration_seconds": 5.42,
      "text": "We'll go over that shortly. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.94,
      "end_seconds": 81.86,
      "duration_seconds": 7.92,
      "text": "I've had it for three days. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.62,
      "end_seconds": 84.84,
      "duration_seconds": 2.22,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.77,
      "end_seconds": 90.07,
      "duration_seconds": 3.3,
      "text": "I notice it more with movement"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.53,
      "end_seconds": 91.23,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.38,
      "end_seconds": 98.29,
      "duration_seconds": 1.91,
      "text": "there's vomiting as well"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.18,
      "end_seconds": 106.64,
      "duration_seconds": 3.46,
      "text": "and what about discharge, fever or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.84,
      "end_seconds": 113.59,
      "duration_seconds": 5.75,
      "text": "sorry, what was I saying, no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.93,
      "end_seconds": 120.05,
      "duration_seconds": 5.12,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.81,
      "end_seconds": 123.39,
      "duration_seconds": 2.58,
      "text": "Actually, no weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.27,
      "end_seconds": 135.11,
      "duration_seconds": 2.84,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.85,
      "end_seconds": 139.79,
      "duration_seconds": 2.94,
      "text": "actually, not to my knowledge, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.32,
      "end_seconds": 144.14,
      "duration_seconds": 2.82,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.3,
      "end_seconds": 159.03,
      "duration_seconds": 13.73,
      "text": "I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.53,
      "end_seconds": 179.64,
      "duration_seconds": 2.11,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.07,
      "end_seconds": 184.27,
      "duration_seconds": 3.2,
      "text": "right, no, I'm not on anything"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.0,
      "end_seconds": 198.85,
      "duration_seconds": 2.85,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.7,
      "end_seconds": 203.0,
      "duration_seconds": 3.3,
      "text": "Yeah, uh, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.37,
      "end_seconds": 218.91,
      "duration_seconds": 3.54,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.77,
      "end_seconds": 226.66,
      "duration_seconds": 2.89,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 229.3,
      "duration_seconds": 1.36,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.15,
      "end_seconds": 235.0,
      "duration_seconds": 3.85,
      "text": "Um, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.56,
      "end_seconds": 241.6,
      "duration_seconds": 5.04,
      "text": "from what you've told me, I'd lean towards possible ovarian torsion"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.07,
      "end_seconds": 245.81,
      "duration_seconds": 2.74,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.63,
      "end_seconds": 272.15,
      "duration_seconds": 24.52,
      "text": "I understand the worry. At the moment I'd say it's possible ovarian torsion, and we'll know more once the an urgent pelvic ultrasound is back. Stop me if I've got anything wrong. You've had sudden severe pain on the right side of your pelvis for three days, and no vaginal bleeding or discharge."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.77,
      "end_seconds": 276.06,
      "duration_seconds": 2.29,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.51,
      "end_seconds": 282.51,
      "duration_seconds": 5.0,
      "text": "I want an urgent pelvic ultrasound done, that's for possible torsion."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 283.8,
      "end_seconds": 287.39,
      "duration_seconds": 3.59,
      "text": "The The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.36,
      "end_seconds": 298.14,
      "duration_seconds": 8.78,
      "text": "You need an emergency scan and probably surgery today. Let's get you seen by the gynaecology team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.4,
      "end_seconds": 301.78,
      "duration_seconds": 2.38,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.09,
      "end_seconds": 310.69,
      "duration_seconds": 7.6,
      "text": "See me again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.4,
      "end_seconds": 314.33,
      "duration_seconds": 2.93,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}