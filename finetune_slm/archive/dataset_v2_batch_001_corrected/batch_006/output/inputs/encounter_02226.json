{
  "schema_version": "1.0",
  "encounter_id": "02226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 3.43,
      "duration_seconds": 2.74,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.58,
      "end_seconds": 5.65,
      "duration_seconds": 1.07,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 11.0,
      "duration_seconds": 3.63,
      "text": "Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.26,
      "end_seconds": 22.11,
      "duration_seconds": 5.85,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.69,
      "end_seconds": 25.02,
      "duration_seconds": 1.33,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.57,
      "end_seconds": 29.33,
      "duration_seconds": 3.76,
      "text": "It's a fever for two weeks, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.58,
      "end_seconds": 33.9,
      "duration_seconds": 3.32,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.5,
      "end_seconds": 41.79,
      "duration_seconds": 7.29,
      "text": "I've had it since last weekend. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.16,
      "end_seconds": 45.86,
      "duration_seconds": 2.7,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.84,
      "end_seconds": 49.28,
      "duration_seconds": 2.44,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.65,
      "end_seconds": 53.98,
      "duration_seconds": 3.33,
      "text": "Okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.16,
      "end_seconds": 62.73,
      "duration_seconds": 7.57,
      "text": "Small painful spots on my fingers goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.46,
      "end_seconds": 67.1,
      "duration_seconds": 3.64,
      "text": "What about night sweats, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.67,
      "end_seconds": 75.87,
      "duration_seconds": 7.2,
      "text": "Yeah, I've had that since last night. About night sweats, I'd say moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.4,
      "end_seconds": 77.2,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.07,
      "end_seconds": 85.35,
      "duration_seconds": 7.28,
      "text": "The small painful spots on my fingers? That's been for about a month."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.98,
      "end_seconds": 102.94,
      "duration_seconds": 2.96,
      "text": "Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.29,
      "end_seconds": 106.66,
      "duration_seconds": 2.37,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.54,
      "end_seconds": 111.64,
      "duration_seconds": 3.1,
      "text": "Did you get weight loss or cough?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.38,
      "end_seconds": 117.41,
      "duration_seconds": 4.03,
      "text": "No weight loss or cough, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.05,
      "end_seconds": 124.27,
      "duration_seconds": 5.22,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.23,
      "end_seconds": 127.48,
      "duration_seconds": 2.25,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.29,
      "end_seconds": 132.14,
      "duration_seconds": 2.85,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.16,
      "end_seconds": 137.42,
      "duration_seconds": 3.26,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.11,
      "end_seconds": 142.79,
      "duration_seconds": 3.68,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.7,
      "end_seconds": 147.49,
      "duration_seconds": 3.79,
      "text": "I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.17,
      "end_seconds": 153.79,
      "duration_seconds": 5.62,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.03,
      "end_seconds": 168.43,
      "duration_seconds": 13.4,
      "text": "No, I share a house with my brother. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.86,
      "end_seconds": 183.04,
      "duration_seconds": 3.18,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.32,
      "end_seconds": 187.15,
      "duration_seconds": 2.83,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.76,
      "end_seconds": 193.33,
      "duration_seconds": 4.57,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.39,
      "end_seconds": 197.63,
      "duration_seconds": 2.24,
      "text": "I've had COPD, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.47,
      "end_seconds": 201.35,
      "duration_seconds": 2.88,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.16,
      "end_seconds": 206.72,
      "duration_seconds": 3.56,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.63,
      "end_seconds": 212.57,
      "duration_seconds": 3.94,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.29,
      "end_seconds": 225.49,
      "duration_seconds": 2.2,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.81,
      "end_seconds": 255.31,
      "duration_seconds": 9.5,
      "text": "Okay: temp 39.3 degrees, blood pressure 114 over 68, respiratory rate 18, saturation 97 percent, pulse is 90 beats a minute."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.23,
      "end_seconds": 257.59,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.23,
      "end_seconds": 262.32,
      "duration_seconds": 4.09,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.07,
      "end_seconds": 270.61,
      "duration_seconds": 5.54,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.38,
      "end_seconds": 274.03,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 300.07,
      "duration_seconds": 8.51,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.68,
      "end_seconds": 307.49,
      "duration_seconds": 1.81,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.95,
      "end_seconds": 355.47,
      "duration_seconds": 29.52,
      "text": "From what you've told me and what I found, I think we're dealing with possible infective endocarditis at this stage. Another possibility is a viral illness. I'm sending you for an echocardiogram because of new murmur. You need admission today for blood cultures and a heart scan. I'd like you to see the cardiology team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.47,
      "end_seconds": 357.17,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.96,
      "end_seconds": 365.3,
      "duration_seconds": 6.34,
      "text": "I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.38,
      "end_seconds": 369.59,
      "duration_seconds": 3.21,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.16,
      "end_seconds": 371.96,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}