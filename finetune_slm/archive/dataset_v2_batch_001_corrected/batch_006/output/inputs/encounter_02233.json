{
  "schema_version": "1.0",
  "encounter_id": "02233",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.81,
      "end_seconds": 7.02,
      "duration_seconds": 6.21,
      "text": "all set here, doctor. Chart's updated, and I'll read the readings out when you're ready"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.78,
      "end_seconds": 14.17,
      "duration_seconds": 4.39,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.03,
      "end_seconds": 21.85,
      "duration_seconds": 5.82,
      "text": "I wanted to to get a nosebleed that won't stop looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.36,
      "end_seconds": 27.69,
      "duration_seconds": 4.33,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.7,
      "end_seconds": 39.52,
      "duration_seconds": 10.82,
      "text": "Sorry, what was I saying, I'm on lamotrigine, 100 milligrams, twice a day. A blood thinner. I take it twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.5,
      "end_seconds": 42.63,
      "duration_seconds": 2.13,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.19,
      "end_seconds": 45.22,
      "duration_seconds": 1.03,
      "text": "5 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.77,
      "end_seconds": 50.16,
      "duration_seconds": 4.39,
      "text": "Yes, carry on. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.75,
      "end_seconds": 54.58,
      "duration_seconds": 3.83,
      "text": "a five out of ten, I suppose"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.6,
      "end_seconds": 57.91,
      "duration_seconds": 2.31,
      "text": "Have you been feeling lightheaded?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.97,
      "end_seconds": 72.21,
      "duration_seconds": 13.24,
      "text": "yeah, I've had that since this morning hmm, I did have blood down the back of my throat at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.1,
      "end_seconds": 88.0,
      "duration_seconds": 4.9,
      "text": "Any head injury, chest pain, black stools or easy bruising?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.83,
      "end_seconds": 91.45,
      "duration_seconds": 2.62,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.75,
      "end_seconds": 97.84,
      "duration_seconds": 2.09,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.31,
      "end_seconds": 101.69,
      "duration_seconds": 2.38,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.23,
      "end_seconds": 106.07,
      "duration_seconds": 2.84,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.89,
      "end_seconds": 110.99,
      "duration_seconds": 2.1,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.71,
      "end_seconds": 122.48,
      "duration_seconds": 2.77,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.53,
      "end_seconds": 130.8,
      "duration_seconds": 3.27,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.2,
      "end_seconds": 134.39,
      "duration_seconds": 2.19,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.05,
      "end_seconds": 138.85,
      "duration_seconds": 2.8,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.68,
      "end_seconds": 142.04,
      "duration_seconds": 2.36,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.68,
      "end_seconds": 146.53,
      "duration_seconds": 3.85,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.68,
      "end_seconds": 151.12,
      "duration_seconds": 3.44,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.87,
      "end_seconds": 155.29,
      "duration_seconds": 2.42,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.75,
      "end_seconds": 160.79,
      "duration_seconds": 4.04,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.73,
      "end_seconds": 168.55,
      "duration_seconds": 5.82,
      "text": "I have an irregular heartbeat, for about ten years. I have epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.64,
      "end_seconds": 177.86,
      "duration_seconds": 7.22,
      "text": "Ah. Okay, I can see epilepsy in your file as well. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.85,
      "end_seconds": 183.65,
      "duration_seconds": 3.8,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 185.69,
      "end_seconds": 196.13,
      "duration_seconds": 10.44,
      "text": "Here are the numbers, doctor. SpO2 99 percent on room air, blood pressure 122 over 70, pulse 70, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 199.21,
      "duration_seconds": 1.11,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.64,
      "end_seconds": 207.14,
      "duration_seconds": 5.5,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.34,
      "end_seconds": 209.69,
      "duration_seconds": 1.35,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.91,
      "end_seconds": 236.26,
      "duration_seconds": 8.35,
      "text": "There is a bleeding point on the front of the septum and the nose has been dry."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.23,
      "end_seconds": 256.24,
      "duration_seconds": 1.01,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.84,
      "end_seconds": 269.66,
      "duration_seconds": 9.82,
      "text": "You can sit up now. Having listened and examined, this looks most like an anterior nosebleed on a blood thinner."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 270.6,
      "end_seconds": 274.37,
      "duration_seconds": 3.77,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.96,
      "end_seconds": 310.94,
      "duration_seconds": 34.98,
      "text": "It's reasonable to be concerned, but right now an anterior nosebleed on a blood thinner is my leading thought, not anything worse. We should do a blood count for epistaxis. I think a clotting test makes sense here, for epistaxis on anticoagulant. Lean forward and pinch the soft part of the nose for fifteen minutes; I will cauterise the point. Come back or go to emergency straight away if the bleeding does not stop after twenty minutes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.38,
      "end_seconds": 313.98,
      "duration_seconds": 1.6,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.32,
      "end_seconds": 319.08,
      "duration_seconds": 3.76,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.11,
      "end_seconds": 323.46,
      "duration_seconds": 3.35,
      "text": "Actually, I think I understand everything. Thanks."
    }
  ]
}