{
  "schema_version": "1.0",
  "encounter_id": "02195",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 2.67,
      "duration_seconds": 1.81,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.69,
      "end_seconds": 9.94,
      "duration_seconds": 5.25,
      "text": "Okay, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 18.69,
      "duration_seconds": 4.09,
      "text": "It's burning pain in the upper tummy, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.49,
      "end_seconds": 26.85,
      "duration_seconds": 7.36,
      "text": "What's the timeline, when did it begin? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.85,
      "end_seconds": 30.67,
      "duration_seconds": 1.82,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.91,
      "end_seconds": 34.15,
      "duration_seconds": 2.24,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.66,
      "end_seconds": 40.7,
      "duration_seconds": 4.04,
      "text": "I notice it more with an empty stomach."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.3,
      "end_seconds": 45.03,
      "duration_seconds": 2.73,
      "text": "Have you been feeling full quickly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.91,
      "end_seconds": 53.92,
      "duration_seconds": 7.01,
      "text": "Yes, I have. As for feeling full quickly, I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.47,
      "end_seconds": 68.08,
      "duration_seconds": 4.61,
      "text": "Any weight loss, black stools or vomiting blood at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.09,
      "end_seconds": 75.09,
      "duration_seconds": 6.0,
      "text": "No weight loss, black stools or vomiting blood, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.67,
      "end_seconds": 76.9,
      "duration_seconds": 1.23,
      "text": "Any difficulty swallowing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.19,
      "end_seconds": 82.08,
      "duration_seconds": 3.89,
      "text": "No, I haven't had any difficulty swallowing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.02,
      "end_seconds": 85.85,
      "duration_seconds": 2.83,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.66,
      "end_seconds": 95.16,
      "duration_seconds": 4.5,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.74,
      "end_seconds": 98.14,
      "duration_seconds": 2.4,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.69,
      "end_seconds": 103.76,
      "duration_seconds": 1.07,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.73,
      "end_seconds": 108.4,
      "duration_seconds": 3.67,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.49,
      "end_seconds": 116.64,
      "duration_seconds": 7.15,
      "text": "Arthritis in my knees, for nearly five years. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 123.71,
      "duration_seconds": 4.98,
      "text": "Understood. Alright, arthritis in your knees, that matches what I have here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 143.18,
      "duration_seconds": 4.2,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.74,
      "end_seconds": 156.95,
      "duration_seconds": 13.21,
      "text": "It's paracetamol, 650 milligrams, when needed. I told myself I'd wait and see, and here I am. I'm on clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.97,
      "end_seconds": 161.41,
      "duration_seconds": 3.44,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.31,
      "end_seconds": 174.91,
      "duration_seconds": 11.6,
      "text": "I only drink at family occasions. I drink a lot of tea and snack through the day. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.79,
      "end_seconds": 182.16,
      "duration_seconds": 4.37,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.39,
      "end_seconds": 196.36,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 218.71,
      "duration_seconds": 8.0,
      "text": "Okay: saturation 99 percent, pulse 64. And blood pressure 127 over 78, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.41,
      "end_seconds": 223.16,
      "duration_seconds": 2.75,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.5,
      "end_seconds": 227.1,
      "duration_seconds": 2.6,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.91,
      "end_seconds": 245.47,
      "duration_seconds": 4.56,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.48,
      "end_seconds": 250.05,
      "duration_seconds": 2.57,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.4,
      "end_seconds": 264.59,
      "duration_seconds": 7.19,
      "text": "Okay, thinking it through, this looks most like a possible stomach ulcer from anti-inflammatory tablets."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.52,
      "end_seconds": 268.65,
      "duration_seconds": 2.13,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.67,
      "end_seconds": 291.11,
      "duration_seconds": 20.44,
      "text": "It's reasonable to be concerned, but right now a possible stomach ulcer from anti-inflammatory tablets is my leading thought, not anything worse. I'm going to order a blood count, for dyspepsia. You'll be taking omeprazole, 20 milligrams, once a day, eight weeks. It's for stomach ulcer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.81,
      "end_seconds": 295.75,
      "duration_seconds": 2.94,
      "text": "Fine, uh, I'll begin it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.56,
      "end_seconds": 307.76,
      "duration_seconds": 10.2,
      "text": "Stop the ibuprofen and use paracetamol for the knee pain instead. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.17,
      "end_seconds": 312.43,
      "duration_seconds": 3.26,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.49,
      "end_seconds": 316.89,
      "duration_seconds": 2.4,
      "text": "Come back in six weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.52,
      "end_seconds": 319.43,
      "duration_seconds": 1.91,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.08,
      "end_seconds": 324.88,
      "duration_seconds": 3.8,
      "text": "Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.78,
      "end_seconds": 328.03,
      "duration_seconds": 2.25,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.71,
      "end_seconds": 330.02,
      "duration_seconds": 1.31,
      "text": "Take care now."
    }
  ]
}