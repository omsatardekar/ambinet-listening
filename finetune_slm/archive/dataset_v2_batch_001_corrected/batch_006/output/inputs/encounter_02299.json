{
  "schema_version": "1.0",
  "encounter_id": "02299",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 4.29,
      "duration_seconds": 2.98,
      "text": "right, thanks for waiting, come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.35,
      "end_seconds": 10.48,
      "duration_seconds": 5.13,
      "text": "hi doctor, I got here as fast as I could"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.34,
      "end_seconds": 16.9,
      "duration_seconds": 2.56,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.33,
      "end_seconds": 35.11,
      "duration_seconds": 13.78,
      "text": "I'm here because of spots on my forehead and chin. I didn't want to bother you but it keeps coming back. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.05,
      "end_seconds": 40.37,
      "duration_seconds": 3.32,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.21,
      "end_seconds": 51.25,
      "duration_seconds": 9.04,
      "text": "let me think, about... well, about three months i told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.38,
      "end_seconds": 55.45,
      "duration_seconds": 3.07,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.27,
      "end_seconds": 59.56,
      "duration_seconds": 3.29,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.16,
      "end_seconds": 62.6,
      "duration_seconds": 2.44,
      "text": "Any oily skin as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.03,
      "end_seconds": 67.28,
      "duration_seconds": 3.25,
      "text": "Yeah, I've had that since this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.68,
      "end_seconds": 71.56,
      "duration_seconds": 2.88,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.41,
      "end_seconds": 77.74,
      "duration_seconds": 4.33,
      "text": "not to to my knowledge, um, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.2,
      "end_seconds": 96.21,
      "duration_seconds": 4.01,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.39,
      "end_seconds": 109.5,
      "duration_seconds": 8.11,
      "text": "Sumatriptan, 50 milligrams, when needed for my migraines. It's a face wash, twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.92,
      "end_seconds": 113.41,
      "duration_seconds": 2.49,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.34,
      "end_seconds": 123.27,
      "duration_seconds": 7.93,
      "text": "I have migraines, for about a year it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.29,
      "end_seconds": 125.84,
      "duration_seconds": 1.55,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.09,
      "end_seconds": 141.27,
      "duration_seconds": 4.18,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.2,
      "end_seconds": 145.79,
      "duration_seconds": 2.59,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.82,
      "end_seconds": 152.31,
      "duration_seconds": 4.49,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.21,
      "end_seconds": 164.35,
      "duration_seconds": 11.14,
      "text": "I've never touched a cigarette. I grab fast food at lunch most days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.75,
      "end_seconds": 167.16,
      "duration_seconds": 1.41,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.4,
      "end_seconds": 172.28,
      "duration_seconds": 3.88,
      "text": "No, you know, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.77,
      "end_seconds": 178.81,
      "duration_seconds": 5.04,
      "text": "Let me check a few things. Any low mood or scarring?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.83,
      "end_seconds": 185.44,
      "duration_seconds": 4.61,
      "text": "I haven't had low mood or scarring, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.55,
      "end_seconds": 188.35,
      "duration_seconds": 1.8,
      "text": "how about painful cysts?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.2,
      "end_seconds": 193.36,
      "duration_seconds": 3.16,
      "text": "not at all, no painful cysts"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 198.36,
      "duration_seconds": 3.26,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.26,
      "end_seconds": 202.18,
      "duration_seconds": 1.92,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.28,
      "end_seconds": 208.22,
      "duration_seconds": 4.94,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.87,
      "end_seconds": 210.76,
      "duration_seconds": 1.89,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.89,
      "end_seconds": 214.79,
      "duration_seconds": 2.9,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.42,
      "end_seconds": 224.84,
      "duration_seconds": 2.42,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.08,
      "end_seconds": 247.92,
      "duration_seconds": 11.84,
      "text": "Okay: temp 36.8 degrees, respiratory rate 15, BMI works out to 27.3, heart rate 81, BP is 128 over 74, weight 77 kilos, height 168 centimetres."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.41,
      "end_seconds": 253.2,
      "duration_seconds": 3.79,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.44,
      "end_seconds": 270.41,
      "duration_seconds": 0.97,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 272.72,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.99,
      "end_seconds": 296.32,
      "duration_seconds": 5.33,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.37,
      "end_seconds": 313.04,
      "duration_seconds": 12.67,
      "text": "That's the examination finished. Taking everything into account, the most likely explanation is mild acne. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.54,
      "end_seconds": 317.88,
      "duration_seconds": 3.34,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.63,
      "end_seconds": 327.66,
      "duration_seconds": 8.03,
      "text": "I understand the worry. At the the moment I'd say it's mild acne, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.01,
      "end_seconds": 350.42,
      "duration_seconds": 15.41,
      "text": "I'm prescribing benzoyl peroxide gel, 5%, once a day, eight weeks. That should help with acne. Wash gently twice a day and don't squeeze the spots. Book a review in eight weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.37,
      "end_seconds": 355.67,
      "duration_seconds": 3.3,
      "text": "uh, alright, I'll be back"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.32,
      "end_seconds": 361.73,
      "duration_seconds": 5.41,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.1,
      "end_seconds": 371.68,
      "duration_seconds": 3.58,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.07,
      "end_seconds": 374.38,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}