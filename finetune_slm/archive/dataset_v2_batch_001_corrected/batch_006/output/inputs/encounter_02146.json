{
  "schema_version": "1.0",
  "encounter_id": "02146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 2.12,
      "duration_seconds": 1.46,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.22,
      "end_seconds": 7.01,
      "duration_seconds": 3.79,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.67,
      "end_seconds": 15.69,
      "duration_seconds": 8.02,
      "text": "Honestly, uh, it's itchy spots all over, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.43,
      "end_seconds": 19.78,
      "duration_seconds": 3.35,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.54,
      "end_seconds": 24.44,
      "duration_seconds": 3.9,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.21,
      "end_seconds": 28.93,
      "duration_seconds": 2.72,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.72,
      "end_seconds": 32.78,
      "duration_seconds": 2.06,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.6,
      "end_seconds": 53.54,
      "duration_seconds": 3.94,
      "text": "Have you had stiff neck, by any chance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.5,
      "end_seconds": 59.18,
      "duration_seconds": 4.68,
      "text": "No, you know, I haven't had any stiff neck."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.9,
      "end_seconds": 64.09,
      "duration_seconds": 4.19,
      "text": "A few quick ones: breathlessness, pregnancy or being immunosuppressed?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.04,
      "end_seconds": 68.94,
      "duration_seconds": 3.9,
      "text": "No, no breathlessness, pregnancy or being immunosuppressed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.03,
      "end_seconds": 73.8,
      "duration_seconds": 2.77,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.91,
      "end_seconds": 76.82,
      "duration_seconds": 1.91,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.52,
      "end_seconds": 93.75,
      "duration_seconds": 2.23,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.72,
      "end_seconds": 100.21,
      "duration_seconds": 4.49,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.8,
      "end_seconds": 102.92,
      "duration_seconds": 2.12,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.17,
      "end_seconds": 106.89,
      "duration_seconds": 2.72,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.71,
      "end_seconds": 112.72,
      "duration_seconds": 4.01,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.79,
      "end_seconds": 133.08,
      "duration_seconds": 15.29,
      "text": "I've had eczema for nearly five years now. I didn't want to make a fuss, um, you know. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.58,
      "end_seconds": 138.62,
      "duration_seconds": 4.04,
      "text": "Sure. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.36,
      "end_seconds": 142.72,
      "duration_seconds": 3.36,
      "text": "Hydrocortisone cream. I take it when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.35,
      "end_seconds": 153.48,
      "duration_seconds": 3.13,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.38,
      "end_seconds": 165.99,
      "duration_seconds": 2.61,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.16,
      "end_seconds": 195.55,
      "duration_seconds": 8.39,
      "text": "Okay: temperature 36.6, BP is 121 over 82. And SpO2 98 percent on room air, pulse 78."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.77,
      "end_seconds": 199.72,
      "duration_seconds": 2.95,
      "text": "Hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.67,
      "end_seconds": 203.9,
      "duration_seconds": 2.23,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.13,
      "end_seconds": 209.7,
      "duration_seconds": 3.57,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.22,
      "end_seconds": 212.17,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.01,
      "end_seconds": 214.98,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.67,
      "end_seconds": 237.1,
      "duration_seconds": 5.43,
      "text": "There are crops of blisters and scabs in different stages on the trunk."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.95,
      "end_seconds": 249.44,
      "duration_seconds": 7.49,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. This is probably chickenpox."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.51,
      "end_seconds": 253.6,
      "duration_seconds": 3.09,
      "text": "I mean, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.46,
      "end_seconds": 261.04,
      "duration_seconds": 5.58,
      "text": "Nothing I've seen today points to an emergency. It looks like chickenpox."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.87,
      "end_seconds": 310.94,
      "duration_seconds": 33.07,
      "text": "You'll be taking aciclovir, 800 milligrams, five times a day, seven days. You take it by mouth. That's for adult chickenpox. Stay at home until all the spots have crusted and stay away from pregnant women. Please take the tablets with food so they don't upset your stomach. If you become breathless or have chest pain, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.47,
      "end_seconds": 314.07,
      "duration_seconds": 1.6,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.89,
      "end_seconds": 322.37,
      "duration_seconds": 6.48,
      "text": "We'll catch up if you become breathless. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.55,
      "end_seconds": 327.19,
      "duration_seconds": 3.64,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}