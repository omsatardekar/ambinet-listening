{
  "schema_version": "1.0",
  "encounter_id": "02007",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 4.01,
      "duration_seconds": 2.83,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.04,
      "end_seconds": 8.5,
      "duration_seconds": 3.46,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.76,
      "end_seconds": 14.9,
      "duration_seconds": 5.14,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.97,
      "end_seconds": 19.19,
      "duration_seconds": 3.22,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.97,
      "end_seconds": 24.75,
      "duration_seconds": 4.78,
      "text": "I've been dealing with pain that comes in waves."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.67,
      "end_seconds": 28.51,
      "duration_seconds": 2.84,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.35,
      "end_seconds": 31.62,
      "duration_seconds": 2.27,
      "text": "It's, It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.1,
      "end_seconds": 32.89,
      "duration_seconds": 0.79,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.68,
      "end_seconds": 50.74,
      "duration_seconds": 17.06,
      "text": "Uh, uh, and there's sudden severe pain on the right side of my pelvis as well, about four days now. I've also had vomiting, since yesterday. I've been feeling faint too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.64,
      "end_seconds": 56.36,
      "duration_seconds": 4.72,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.23,
      "end_seconds": 68.17,
      "duration_seconds": 10.94,
      "text": "Severe, I'd say. It's a few times a day. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.35,
      "end_seconds": 75.99,
      "duration_seconds": 6.64,
      "text": "Have you had pain that comes in waves before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.87,
      "end_seconds": 85.15,
      "duration_seconds": 7.28,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 89.53,
      "duration_seconds": 2.34,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.01,
      "end_seconds": 94.99,
      "duration_seconds": 3.98,
      "text": "I've had migraines for five years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.4,
      "end_seconds": 107.97,
      "duration_seconds": 6.57,
      "text": "Right, so migraines is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.89,
      "end_seconds": 126.15,
      "duration_seconds": 3.26,
      "text": "Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.77,
      "end_seconds": 129.24,
      "duration_seconds": 2.47,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.47,
      "end_seconds": 134.45,
      "duration_seconds": 3.98,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 141.04,
      "duration_seconds": 4.59,
      "text": "My cousin has psoriasis. Yeah, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.52,
      "end_seconds": 145.62,
      "duration_seconds": 3.1,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 156.79,
      "duration_seconds": 10.12,
      "text": "I had keyhole surgery on my gallbladder two years back. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.82,
      "end_seconds": 159.89,
      "duration_seconds": 2.07,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.39,
      "end_seconds": 164.72,
      "duration_seconds": 3.33,
      "text": "Sumatriptan, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.66,
      "end_seconds": 169.0,
      "duration_seconds": 3.34,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.39,
      "end_seconds": 174.8,
      "duration_seconds": 4.41,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.34,
      "end_seconds": 179.18,
      "duration_seconds": 2.84,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.12,
      "end_seconds": 184.54,
      "duration_seconds": 3.42,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.59,
      "end_seconds": 187.77,
      "duration_seconds": 2.18,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.03,
      "end_seconds": 193.27,
      "duration_seconds": 4.24,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.3,
      "end_seconds": 195.57,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.56,
      "end_seconds": 200.35,
      "duration_seconds": 2.79,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.36,
      "end_seconds": 211.83,
      "duration_seconds": 2.47,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.78,
      "end_seconds": 214.27,
      "duration_seconds": 1.49,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.3,
      "end_seconds": 220.24,
      "duration_seconds": 4.94,
      "text": "Have you had any missed period, vaginal bleeding or discharge?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.94,
      "end_seconds": 225.82,
      "duration_seconds": 3.88,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.69,
      "end_seconds": 231.06,
      "duration_seconds": 3.37,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.7,
      "end_seconds": 233.64,
      "duration_seconds": 1.94,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.46,
      "end_seconds": 239.44,
      "duration_seconds": 3.98,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.18,
      "end_seconds": 242.7,
      "duration_seconds": 2.52,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.7,
      "end_seconds": 247.29,
      "duration_seconds": 2.59,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.18,
      "end_seconds": 261.56,
      "duration_seconds": 5.38,
      "text": "You are in severe pain with a tender mass low on the right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.68,
      "end_seconds": 279.55,
      "duration_seconds": 14.87,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I'm honestly not certain yet. It could be possible ovarian torsion, or it might be a ruptured cyst."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.46,
      "end_seconds": 282.83,
      "duration_seconds": 1.37,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.93,
      "end_seconds": 302.05,
      "duration_seconds": 18.12,
      "text": "Nothing I've seen today points to an emergency. It looks like possible ovarian torsion, but I'd like to confirm. So, to recap quickly. You've had pain that comes in waves, moderate, and no fever or discharge."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.59,
      "end_seconds": 304.29,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.84,
      "end_seconds": 351.16,
      "duration_seconds": 35.32,
      "text": "An urgent pelvic ultrasound is what I'd like next, for possible torsion. I'd rather check than guess, and this is the quickest way to know more. A pregnancy test is what I'd like next, for pelvic pain. You need an emergency scan and probably surgery today. Let's get you seen by the gynaecology team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.75,
      "end_seconds": 368.27,
      "duration_seconds": 12.52,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.86,
      "end_seconds": 376.7,
      "duration_seconds": 4.84,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.8,
      "end_seconds": 381.87,
      "duration_seconds": 4.07,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.46,
      "end_seconds": 385.38,
      "duration_seconds": 2.92,
      "text": "Great, thank you for your help."
    }
  ]
}