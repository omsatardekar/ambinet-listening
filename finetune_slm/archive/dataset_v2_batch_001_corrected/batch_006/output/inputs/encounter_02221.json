{
  "schema_version": "1.0",
  "encounter_id": "02221",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 5.51,
      "duration_seconds": 4.77,
      "text": "Sorry I'm a little late, um, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 11.38,
      "duration_seconds": 3.91,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.34,
      "end_seconds": 17.15,
      "duration_seconds": 4.81,
      "text": "Thank you for fitting us in, uh, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.18,
      "end_seconds": 22.04,
      "duration_seconds": 3.86,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.98,
      "end_seconds": 30.88,
      "duration_seconds": 6.9,
      "text": "Oh, doctor, it's pain behind the ear. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.9,
      "end_seconds": 36.3,
      "duration_seconds": 3.4,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.17,
      "end_seconds": 40.54,
      "duration_seconds": 3.37,
      "text": "Erm, it's been one week now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.87,
      "end_seconds": 45.87,
      "duration_seconds": 4.0,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.27,
      "end_seconds": 49.62,
      "duration_seconds": 2.35,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.61,
      "end_seconds": 53.98,
      "duration_seconds": 2.37,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.71,
      "end_seconds": 66.58,
      "duration_seconds": 10.87,
      "text": "Honestly, once or twice a day. My face drooping on the right was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.32,
      "end_seconds": 72.43,
      "duration_seconds": 4.11,
      "text": "Have you noticed slurred speech or rash in the ear?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.87,
      "end_seconds": 79.89,
      "duration_seconds": 6.02,
      "text": "I haven't had slurred speech or rash in the ear, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.94,
      "end_seconds": 86.71,
      "duration_seconds": 4.77,
      "text": "Alright, any headache or weakness in the arm or leg?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.77,
      "end_seconds": 97.21,
      "duration_seconds": 8.44,
      "text": "Um, uh, no, no headache or weakness in the arm or leg."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.12,
      "end_seconds": 102.09,
      "duration_seconds": 2.97,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.4,
      "end_seconds": 108.21,
      "duration_seconds": 1.81,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.09,
      "end_seconds": 112.6,
      "duration_seconds": 3.51,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.12,
      "end_seconds": 118.17,
      "duration_seconds": 5.05,
      "text": "Milk. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.32,
      "end_seconds": 123.06,
      "duration_seconds": 3.74,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.98,
      "end_seconds": 130.05,
      "duration_seconds": 5.07,
      "text": "Actually, I've had thin bones for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.35,
      "end_seconds": 139.44,
      "duration_seconds": 8.09,
      "text": "Alright, thin bones, that matches what I have here. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.68,
      "end_seconds": 150.41,
      "duration_seconds": 6.73,
      "text": "It's, It's something called alen... alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.28,
      "end_seconds": 155.25,
      "duration_seconds": 3.97,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.15,
      "end_seconds": 160.26,
      "duration_seconds": 3.11,
      "text": "Um, no, it's at home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.61,
      "end_seconds": 164.41,
      "duration_seconds": 2.8,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.94,
      "end_seconds": 181.36,
      "duration_seconds": 16.42,
      "text": "I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.73,
      "end_seconds": 198.91,
      "duration_seconds": 3.18,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.78,
      "end_seconds": 212.49,
      "duration_seconds": 2.71,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.41,
      "end_seconds": 238.5,
      "duration_seconds": 4.09,
      "text": "Okay: heart rate 77, BP is 120 over 74."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.64,
      "end_seconds": 241.14,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.02,
      "end_seconds": 247.56,
      "duration_seconds": 4.54,
      "text": "Okay, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.07,
      "end_seconds": 253.33,
      "duration_seconds": 3.26,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.17,
      "end_seconds": 269.35,
      "duration_seconds": 1.18,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.79,
      "end_seconds": 273.18,
      "duration_seconds": 2.39,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.42,
      "end_seconds": 293.01,
      "duration_seconds": 8.59,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.14,
      "end_seconds": 295.24,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.01,
      "end_seconds": 313.35,
      "duration_seconds": 12.34,
      "text": "Right, good, you can sit up again. So where does that leave us? I don't have a clear answer today: Bell's palsy is possible, and so is a stroke."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.08,
      "end_seconds": 317.74,
      "duration_seconds": 3.66,
      "text": "Actually, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.53,
      "end_seconds": 324.24,
      "duration_seconds": 5.71,
      "text": "Nothing I've seen today points to an emergency. It looks like Bell's palsy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.73,
      "end_seconds": 350.58,
      "duration_seconds": 18.85,
      "text": "Use eye drops and tape the eye shut at night to protect it. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again in one week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.7,
      "end_seconds": 355.3,
      "duration_seconds": 3.6,
      "text": "Okay, so alright, thanks, take care."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.19,
      "end_seconds": 357.39,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}