{
  "schema_version": "1.0",
  "encounter_id": "02186",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.25,
      "duration_seconds": 3.41,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.32,
      "end_seconds": 10.0,
      "duration_seconds": 4.68,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 17.26,
      "duration_seconds": 5.53,
      "text": "Mainly I've been feeling full quickly. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.17,
      "end_seconds": 22.3,
      "duration_seconds": 3.13,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.13,
      "end_seconds": 28.96,
      "duration_seconds": 5.83,
      "text": "Paracetamol. I take it 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.44,
      "end_seconds": 32.35,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.98,
      "end_seconds": 34.9,
      "duration_seconds": 1.92,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.6,
      "end_seconds": 41.19,
      "duration_seconds": 4.59,
      "text": "Okay, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.77,
      "end_seconds": 49.92,
      "duration_seconds": 6.15,
      "text": "I'd call it mild. And there's indigestion as well, ten days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.57,
      "end_seconds": 56.63,
      "duration_seconds": 3.06,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.19,
      "end_seconds": 62.83,
      "duration_seconds": 4.64,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.25,
      "end_seconds": 75.4,
      "duration_seconds": 3.15,
      "text": "Did you get black stools or vomiting blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.47,
      "end_seconds": 82.5,
      "duration_seconds": 5.03,
      "text": "I haven't had black stools or vomiting blood, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.04,
      "end_seconds": 87.56,
      "duration_seconds": 4.52,
      "text": "Okay, any difficulty swallowing or weight loss at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.53,
      "end_seconds": 93.14,
      "duration_seconds": 3.61,
      "text": "No, no difficulty swallowing or weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.14,
      "end_seconds": 97.51,
      "duration_seconds": 2.37,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.0,
      "end_seconds": 100.05,
      "duration_seconds": 1.05,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.08,
      "end_seconds": 105.3,
      "duration_seconds": 4.22,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.05,
      "end_seconds": 118.55,
      "duration_seconds": 11.5,
      "text": "I have arthritis in my knees. I've never really been one for hospitals. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.52,
      "end_seconds": 125.71,
      "duration_seconds": 6.19,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.93,
      "end_seconds": 144.73,
      "duration_seconds": 4.8,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.54,
      "end_seconds": 149.28,
      "duration_seconds": 2.74,
      "text": "Yes, trimethoprim. I get itching."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.13,
      "end_seconds": 164.45,
      "duration_seconds": 3.32,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.08,
      "end_seconds": 177.91,
      "duration_seconds": 12.83,
      "text": "Lots of rice, lentils and some fruit. Not much, I mostly stay in these days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.83,
      "end_seconds": 183.3,
      "duration_seconds": 2.47,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.88,
      "end_seconds": 186.57,
      "duration_seconds": 1.69,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.24,
      "end_seconds": 208.24,
      "duration_seconds": 5.0,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.19,
      "end_seconds": 216.37,
      "duration_seconds": 2.18,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.66,
      "end_seconds": 257.3,
      "duration_seconds": 30.64,
      "text": "Okay, so my impression is this: It's hard to say. A possible stomach ulcer from anti-inflammatory tablets is one possibility and reflux another, and I'd rather not commit yet. Let's book a blood count to look into dyspepsia. The treatment will be omeprazole, 20 milligrams, once a day, eight weeks. You take it by mouth. That's for stomach ulcer. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.9,
      "end_seconds": 262.7,
      "duration_seconds": 4.8,
      "text": "Stop the ibuprofen and use paracetamol for the knee pain instead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.11,
      "end_seconds": 267.6,
      "duration_seconds": 4.49,
      "text": "I see, go ahead. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.48,
      "end_seconds": 269.18,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.08,
      "end_seconds": 276.59,
      "duration_seconds": 5.51,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.62,
      "end_seconds": 291.58,
      "duration_seconds": 9.96,
      "text": "So, you know, I take the omeprazole, 20 milligrams, once a day and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.92,
      "end_seconds": 297.67,
      "duration_seconds": 4.75,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.31,
      "end_seconds": 303.31,
      "duration_seconds": 4.0,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}