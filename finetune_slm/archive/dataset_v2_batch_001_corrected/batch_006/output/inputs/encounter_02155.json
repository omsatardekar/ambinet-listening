{
  "schema_version": "1.0",
  "encounter_id": "02155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 6.17,
      "duration_seconds": 5.42,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.27,
      "end_seconds": 11.76,
      "duration_seconds": 4.49,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.24,
      "end_seconds": 25.12,
      "duration_seconds": 11.88,
      "text": "Hmm, I've been feeling faint, and I wanted to get it checked. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.34,
      "end_seconds": 30.35,
      "duration_seconds": 4.01,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.18,
      "end_seconds": 39.06,
      "duration_seconds": 7.88,
      "text": "For six months, I'd say. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.16,
      "end_seconds": 42.94,
      "duration_seconds": 2.78,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.81,
      "end_seconds": 45.27,
      "duration_seconds": 1.46,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.21,
      "end_seconds": 48.37,
      "duration_seconds": 2.16,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.09,
      "end_seconds": 51.37,
      "duration_seconds": 2.28,
      "text": "Lying down helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.4,
      "end_seconds": 54.77,
      "duration_seconds": 2.37,
      "text": "Any being confused as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.45,
      "end_seconds": 58.41,
      "duration_seconds": 2.96,
      "text": "Yes, for about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.78,
      "end_seconds": 63.26,
      "duration_seconds": 3.48,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.81,
      "end_seconds": 66.39,
      "duration_seconds": 1.58,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.21,
      "end_seconds": 71.24,
      "duration_seconds": 3.03,
      "text": "And what about fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.25,
      "end_seconds": 76.67,
      "duration_seconds": 3.42,
      "text": "Well, no, no fever or chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.12,
      "end_seconds": 81.51,
      "duration_seconds": 3.39,
      "text": "Alright, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.32,
      "end_seconds": 87.32,
      "duration_seconds": 4.0,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.56,
      "end_seconds": 90.12,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.29,
      "end_seconds": 92.79,
      "duration_seconds": 1.5,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.5,
      "end_seconds": 96.92,
      "duration_seconds": 2.42,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.99,
      "end_seconds": 101.14,
      "duration_seconds": 2.15,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.13,
      "end_seconds": 118.32,
      "duration_seconds": 3.19,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.22,
      "end_seconds": 130.07,
      "duration_seconds": 9.85,
      "text": "I work in accounts at a hospital. I walk the dog every morning. My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.88,
      "end_seconds": 132.89,
      "duration_seconds": 2.01,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.8,
      "end_seconds": 140.49,
      "duration_seconds": 6.69,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.32,
      "end_seconds": 147.72,
      "duration_seconds": 2.4,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.67,
      "end_seconds": 156.2,
      "duration_seconds": 6.53,
      "text": "Apixaban. I take it 5 milligrams, twice a day. Alcohol every day, daily."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.95,
      "end_seconds": 161.33,
      "duration_seconds": 4.38,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.38,
      "end_seconds": 166.36,
      "duration_seconds": 3.98,
      "text": "Mm, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.9,
      "end_seconds": 183.2,
      "duration_seconds": 3.3,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.73,
      "end_seconds": 198.79,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.92,
      "end_seconds": 228.6,
      "duration_seconds": 8.68,
      "text": "Okay: oxygen saturation is 98 percent, pulse 107, respiratory rate 17, temp 36.7 degrees, BP is 98 over 59."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.43,
      "end_seconds": 235.13,
      "duration_seconds": 4.7,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.27,
      "end_seconds": 237.97,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.02,
      "end_seconds": 254.14,
      "duration_seconds": 6.12,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.98,
      "end_seconds": 261.05,
      "duration_seconds": 2.07,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.05,
      "end_seconds": 287.21,
      "duration_seconds": 8.16,
      "text": "Right, here's what I'm thinking. This is probably a bleed from enlarged veins in the gullet in liver disease."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.07,
      "end_seconds": 335.03,
      "duration_seconds": 28.96,
      "text": "We should do an urgent endoscopy for variceal bleed. It's a routine test and it'll give us a much clearer picture. I'd like you to take terlipressin, 2 milligrams, now, single dose. It's for variceal bleeding. You are going straight to resus, I am starting two drips. We'll refer you to the emergency team. I'd like to see you again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.28,
      "end_seconds": 341.26,
      "duration_seconds": 4.98,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}