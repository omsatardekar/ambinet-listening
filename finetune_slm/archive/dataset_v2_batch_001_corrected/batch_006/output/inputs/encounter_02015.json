{
  "schema_version": "1.0",
  "encounter_id": "02015",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 6.3,
      "duration_seconds": 5.71,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 11.94,
      "duration_seconds": 3.55,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.86,
      "end_seconds": 17.76,
      "duration_seconds": 4.9,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.47,
      "end_seconds": 28.41,
      "duration_seconds": 8.94,
      "text": "Uh, uh, so the thing is, I've got electric shock pains in my cheek."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.32,
      "end_seconds": 33.01,
      "duration_seconds": 2.69,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 34.86,
      "end_seconds": 51.23,
      "duration_seconds": 16.37,
      "text": "well, she takes bisoprolol, 2.5 milligrams, once a day uh, it's Eltroxin, 100 micrograms, every morning for my thyroid, doctor mm, she is on paracetamol, when needed, I give it to her"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.76,
      "end_seconds": 54.83,
      "duration_seconds": 2.07,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 56.01,
      "end_seconds": 57.42,
      "duration_seconds": 1.41,
      "text": "it's 1 gram"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.32,
      "end_seconds": 62.15,
      "duration_seconds": 2.83,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.83,
      "end_seconds": 65.74,
      "duration_seconds": 1.91,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.19,
      "end_seconds": 81.23,
      "duration_seconds": 2.04,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.04,
      "end_seconds": 90.06,
      "duration_seconds": 7.02,
      "text": "probably about four days. Yeah. My neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 99.14,
      "duration_seconds": 8.16,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.19,
      "end_seconds": 121.92,
      "duration_seconds": 21.73,
      "text": "Hmm, I notice it more with chewing. Severe, really. I didn't wanna bother you but it it keeps coming back. I've, I've had being afraid to eat too, for about three months. And pain lasting seconds as well, since Monday. About pain lasting seconds, Severe, really."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.65,
      "end_seconds": 126.04,
      "duration_seconds": 2.39,
      "text": "So, what about hearing loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.46,
      "end_seconds": 129.61,
      "duration_seconds": 2.15,
      "text": "No, no hearing loss."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.61,
      "end_seconds": 133.96,
      "duration_seconds": 3.35,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.17,
      "end_seconds": 136.7,
      "duration_seconds": 1.53,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.46,
      "end_seconds": 141.21,
      "duration_seconds": 3.75,
      "text": "Right, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.07,
      "end_seconds": 144.09,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.41,
      "end_seconds": 159.29,
      "duration_seconds": 2.88,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.14,
      "end_seconds": 179.05,
      "duration_seconds": 17.91,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day. My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.35,
      "end_seconds": 182.52,
      "duration_seconds": 2.17,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.76,
      "end_seconds": 196.77,
      "duration_seconds": 13.01,
      "text": "I've had an irregular heartbeat for two years now. I have an underactive thyroid. Work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.46,
      "end_seconds": 203.5,
      "duration_seconds": 5.04,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.41,
      "end_seconds": 212.55,
      "duration_seconds": 7.14,
      "text": "years back I got a rash from erythromycin, so I stay away from it now"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.16,
      "end_seconds": 217.74,
      "duration_seconds": 3.58,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.04,
      "end_seconds": 226.54,
      "duration_seconds": 2.5,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.45,
      "end_seconds": 244.7,
      "duration_seconds": 7.25,
      "text": "okay: respiratory rate 14, pulse 65. And pressure 108 over 68, oxygen saturation is 99 percent"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.65,
      "end_seconds": 250.43,
      "duration_seconds": 3.78,
      "text": "Right, let's have a a proper look at you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.49,
      "end_seconds": 252.67,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.43,
      "end_seconds": 275.58,
      "duration_seconds": 6.15,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.1,
      "end_seconds": 294.14,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.02,
      "end_seconds": 309.01,
      "duration_seconds": 10.99,
      "text": "please sit back down so, based on the history and the examination, the most likely explanation is trigeminal neuralgia i'd also keep a dental problem in mind"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.87,
      "end_seconds": 314.9,
      "duration_seconds": 2.03,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.91,
      "end_seconds": 334.12,
      "duration_seconds": 17.21,
      "text": "It's reasonable to be concerned, but right now trigeminal neuralgia is my leading thought, not anything worse. Just to be sure I understood. You've had electric shock pains in your cheek for about four days, severe, and no hearing loss."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.37,
      "end_seconds": 338.14,
      "duration_seconds": 2.77,
      "text": "mm, uh, that's right"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.1,
      "end_seconds": 355.84,
      "duration_seconds": 15.74,
      "text": "I'm going to order an MRI scan of the head, for facial pain. You'll be taking carbamazepine, 100 milligrams, twice a day, titrate. That's for nerve pain. Avoid known triggers and eat soft foods when it flares."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.39,
      "end_seconds": 367.65,
      "duration_seconds": 11.26,
      "text": "I see, go ahead. A short walk every day, even twenty minutes, will help more than you'd think. I think the neurology clinic should see you too."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.48,
      "end_seconds": 370.88,
      "duration_seconds": 2.4,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.46,
      "end_seconds": 379.65,
      "duration_seconds": 7.19,
      "text": "if the symptoms get worse, or you feel really unwell, please come to the emergency department"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.05,
      "end_seconds": 385.26,
      "duration_seconds": 4.21,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.93,
      "end_seconds": 392.75,
      "duration_seconds": 5.82,
      "text": "I'd like you back in four weeks. Does all of that that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.74,
      "end_seconds": 398.15,
      "duration_seconds": 4.41,
      "text": "Um, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.82,
      "end_seconds": 400.21,
      "duration_seconds": 1.39,
      "text": "Look after yourself."
    }
  ]
}