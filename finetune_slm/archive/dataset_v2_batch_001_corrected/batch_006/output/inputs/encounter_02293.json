      "role": "DOCTOR",
      "start_seconds": 200.97,
      "end_seconds": 211.17,
      "duration_seconds": 10.2,
      "text": "okay: pulse is 82 beats a minute BP is 120 over 82 temperature is 36.4 degrees saturation 97 percent respiratory rate 14."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.73,
      "end_seconds": 246.36,
      "duration_seconds": 16.63,
      "text": "Listening to the whole story this is probably post-viral symptoms after COVID. Let me repeat that back to make sure. You've had breathlessness months after the infection for four weeks and no coughing up blood or leg swelling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.25,
      "end_seconds": 250.44,
      "duration_seconds": 2.19,
      "text": "Yes, you've got it."
