      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 260.79,
      "duration_seconds": 9.53,
      "text": "I think blood tests makes sense here, for post-viral fatigue i think a chest X-ray makes sense here, for persistent breathlessness"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.97,
      "end_seconds": 264.45,
      "duration_seconds": 2.48,
      "text": "Mm, that's fine with me."
