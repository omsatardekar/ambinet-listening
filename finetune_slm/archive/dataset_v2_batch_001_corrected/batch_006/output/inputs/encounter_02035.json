{
  "schema_version": "1.0",
  "encounter_id": "02035",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 2.9,
      "duration_seconds": 1.66,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.01,
      "end_seconds": 9.46,
      "duration_seconds": 5.45,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.81,
      "end_seconds": 17.96,
      "duration_seconds": 7.15,
      "text": "Honestly, it's a lump in my left breast, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.97,
      "end_seconds": 21.81,
      "duration_seconds": 2.84,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.41,
      "end_seconds": 33.13,
      "duration_seconds": 10.72,
      "text": "I'd say about four days. Actually, no, closer to five days. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.35,
      "end_seconds": 34.05,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.58,
      "end_seconds": 39.71,
      "duration_seconds": 4.13,
      "text": "I've also had slight tenderness, for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.91,
      "end_seconds": 53.69,
      "duration_seconds": 1.78,
      "text": "What about skin dimpling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.38,
      "end_seconds": 58.7,
      "duration_seconds": 3.32,
      "text": "No, I haven't had any skin dimpling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.09,
      "end_seconds": 66.07,
      "duration_seconds": 6.98,
      "text": "Mm, okay. Any weight loss, lump under the arm or nipple discharge at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.02,
      "end_seconds": 69.51,
      "duration_seconds": 2.49,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.72,
      "end_seconds": 78.51,
      "duration_seconds": 3.79,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.28,
      "end_seconds": 84.08,
      "duration_seconds": 3.8,
      "text": "I mean, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.87,
      "end_seconds": 89.88,
      "duration_seconds": 4.01,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.95,
      "end_seconds": 102.78,
      "duration_seconds": 10.83,
      "text": "I swim twice a week. No, I share a house with my brother. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.61,
      "end_seconds": 126.49,
      "duration_seconds": 4.88,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.37,
      "end_seconds": 131.64,
      "duration_seconds": 3.27,
      "text": "Arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.52,
      "end_seconds": 135.89,
      "duration_seconds": 3.37,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.77,
      "end_seconds": 148.53,
      "duration_seconds": 11.76,
      "text": "I had my appendix taken out when I was in my twenties. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.21,
      "end_seconds": 171.69,
      "duration_seconds": 4.48,
      "text": "So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.95,
      "end_seconds": 176.79,
      "duration_seconds": 3.84,
      "text": "Oh, it's paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.45,
      "end_seconds": 180.7,
      "duration_seconds": 3.25,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.79,
      "end_seconds": 192.54,
      "duration_seconds": 2.75,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.84,
      "end_seconds": 218.28,
      "duration_seconds": 9.44,
      "text": "Okay: respiratory rate 18, BP is 118 over 73, saturation 98 percent, temp 36.5 degrees, heart rate 81."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.89,
      "end_seconds": 222.92,
      "duration_seconds": 2.03,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.88,
      "end_seconds": 225.14,
      "duration_seconds": 1.26,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.04,
      "end_seconds": 250.43,
      "duration_seconds": 9.39,
      "text": "There is a firm, mobile, round lump about two centimetres in the upper outer part and no lumps under the arm."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.57,
      "end_seconds": 264.76,
      "duration_seconds": 10.19,
      "text": "Please sit back down. Having listened and examined, it points towards a breast lump needing triple assessment. I'd also keep a benign fibroadenoma in mind."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.76,
      "end_seconds": 268.71,
      "duration_seconds": 1.95,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.68,
      "end_seconds": 286.27,
      "duration_seconds": 15.59,
      "text": "It's reasonable to be concerned, but right now a breast lump needing triple assessment is my leading thought, not anything worse. I'm going to order a mammogram and ultrasound, for breast lump."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.03,
      "end_seconds": 289.76,
      "duration_seconds": 2.73,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.31,
      "end_seconds": 303.46,
      "duration_seconds": 12.15,
      "text": "This does not mean cancer, but we do arrange a specialist one-stop clinic to be sure. Let's plan a check after the clinic. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.23,
      "end_seconds": 306.55,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    }
  ]
}