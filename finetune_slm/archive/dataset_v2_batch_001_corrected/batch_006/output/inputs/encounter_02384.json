    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.21,
      "end_seconds": 77.12,
      "duration_seconds": 3.91,
      "text": "tell me about any past illnesses or ongoing conditions"
