      "role": "DOCTOR",
      "start_seconds": 191.48,
      "end_seconds": 195.19,
      "duration_seconds": 3.71,
      "text": "hm okay any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.14,
      "end_seconds": 198.12,
      "duration_seconds": 1.98,
      "text": "no problems with breathing"
