      "role": "DOCTOR",
      "start_seconds": 181.04,
      "end_seconds": 185.43,
      "duration_seconds": 4.39,
      "text": "A few quick ones: confusion, vomiting blood or itching?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.29,
      "end_seconds": 191.09,
      "duration_seconds": 4.8,
      "text": "actually um no no confusion vomiting blood or itching"
