      "start_seconds": 0.7,
      "end_seconds": 7.05,
      "duration_seconds": 6.35,
      "text": "doctor um hi where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.86,
      "end_seconds": 16.43,
      "duration_seconds": 3.57,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.02,
      "end_seconds": 28.72,
      "duration_seconds": 10.7,
      "text": "I wanted to get yellow eyes looked at. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.47,
      "end_seconds": 35.46,
      "duration_seconds": 5.99,
      "text": "how long has this been bothering you? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.76,
      "end_seconds": 40.4,
      "duration_seconds": 3.64,
      "text": "Mm, for four weeks, I'd say."
