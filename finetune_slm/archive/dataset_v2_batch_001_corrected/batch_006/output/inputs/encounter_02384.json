      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.0,
      "end_seconds": 72.02,
      "duration_seconds": 8.02,
      "text": "mm, I had a similar thing about six months ago it went away"
