      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.68,
      "end_seconds": 57.0,
      "duration_seconds": 10.32,
      "text": "Dark urine goes along with it, most of the time. The Dark urine? That's been for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.59,
      "end_seconds": 62.58,
      "duration_seconds": 4.99,
      "text": "Have you had yellow eyes before, or is this the first time?"
