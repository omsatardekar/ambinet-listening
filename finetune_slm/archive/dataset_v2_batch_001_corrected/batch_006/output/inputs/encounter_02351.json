  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.47,
      "duration_seconds": 2.82,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.42,
      "end_seconds": 8.41,
      "duration_seconds": 3.99,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 23.61,
      "duration_seconds": 9.62,
      "text": "Mainly pain in my back and hips. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.07,
      "end_seconds": 31.83,
      "duration_seconds": 6.76,
      "text": "What's the timeline when did it begin? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.52,
      "end_seconds": 40.67,
      "duration_seconds": 8.15,
      "text": "it's been two months now work has been very busy so so I kept ignoring it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.44,
      "end_seconds": 48.35,
      "duration_seconds": 2.91,
      "text": "does anything set it it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.21,
      "end_seconds": 54.19,
      "duration_seconds": 1.98,
      "text": "it's worse with moving"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.8,
      "end_seconds": 58.54,
      "duration_seconds": 2.74,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.15,
      "end_seconds": 65.24,
      "duration_seconds": 5.09,
      "text": "Maybe a a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.45,
      "end_seconds": 87.6,
      "duration_seconds": 5.15,
      "text": "okay, and what about shortness of breath, confusion or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.57,
      "end_seconds": 92.44,
      "duration_seconds": 2.87,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.37,
      "end_seconds": 95.35,
      "duration_seconds": 1.98,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.26,
      "end_seconds": 99.51,
      "duration_seconds": 2.25,
      "text": "Bowels are regular nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.97,
      "end_seconds": 102.39,
      "duration_seconds": 1.42,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.19,
      "end_seconds": 107.54,
      "duration_seconds": 3.35,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.19,
      "end_seconds": 112.18,
      "duration_seconds": 2.99,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.83,
      "end_seconds": 117.9,
      "duration_seconds": 5.07,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.66,
      "end_seconds": 127.83,
      "duration_seconds": 2.17,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.52,
      "end_seconds": 139.43,
      "duration_seconds": 9.91,
      "text": "I take thyroxine, 75 micrograms, every morning for my thyroid it's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.26,
      "end_seconds": 158.0,
      "duration_seconds": 3.74,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.03,
      "end_seconds": 162.34,
      "duration_seconds": 2.31,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.66,
      "end_seconds": 171.47,
      "duration_seconds": 7.81,
      "text": "Mm-hmm. Alright an underactive thyroid that matches what I have here. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.35,
      "end_seconds": 174.41,
      "duration_seconds": 2.06,
      "text": "no not at all"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.69,
      "end_seconds": 178.23,
      "duration_seconds": 2.54,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.66,
      "end_seconds": 183.83,
      "duration_seconds": 4.17,
      "text": "Trimethoprim. I come out in... well, a rash"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.18,
      "end_seconds": 187.93,
      "duration_seconds": 2.75,
      "text": "Time for your numbers if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.58,
      "end_seconds": 199.01,
      "duration_seconds": 2.43,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.71,
      "end_seconds": 225.87,
      "duration_seconds": 11.16,
      "text": "okay: pulse is 75 beats a minute, pressure 128 over 75, oxygen saturation is 99 percent, temp 36.7 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.81,
      "end_seconds": 229.38,
      "duration_seconds": 1.57,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.99,
      "end_seconds": 232.92,
      "duration_seconds": 2.93,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.14,
      "end_seconds": 238.13,
      "duration_seconds": 3.99,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 241.88,
      "duration_seconds": 2.02,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.9,
      "end_seconds": 253.86,
      "duration_seconds": 3.96,
      "text": "your tummy is soft and you look comfortable and thin"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.08,
      "end_seconds": 261.09,
      "duration_seconds": 2.01,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 312.24,
      "duration_seconds": 32.58,
      "text": "Let me tell you where I've got to. I think we're dealing with cancer pain needing better control at this stage. I'm prescribing morphine sulfate modified-release 20 milligrams twice a day long term. That should help with cancer pain. Take the long-acting tablet regularly and the liquid for breakthrough pain. We'll refer you to the palliative care team. We'll catch up in one week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.91,
      "end_seconds": 315.38,
      "duration_seconds": 1.47,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.15,
      "end_seconds": 317.36,
      "duration_seconds": 1.21,
      "text": "look after yourself"
    }
  ]
}