{
  "schema_version": "1.0",
  "encounter_id": "02399",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.18,
      "duration_seconds": 4.15,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.82,
      "end_seconds": 11.07,
      "duration_seconds": 5.25,
      "text": "Right, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 26.87,
      "duration_seconds": 11.85,
      "text": "I've been coughing up pink frothy sputum, and I wanted to get it checked. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.88,
      "end_seconds": 32.02,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.57,
      "end_seconds": 47.13,
      "duration_seconds": 14.56,
      "text": "It's been two days, I'm fairly sure. I've been reading about it online and it worried me. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.06,
      "end_seconds": 51.54,
      "duration_seconds": 3.48,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.61,
      "end_seconds": 61.91,
      "duration_seconds": 8.3,
      "text": "Maybe a seven out of ten on a bad day. Erm, and I've been sweating as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.61,
      "end_seconds": 81.88,
      "duration_seconds": 3.27,
      "text": "And what about wheeze, calf pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.17,
      "end_seconds": 87.04,
      "duration_seconds": 3.87,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.87,
      "end_seconds": 89.95,
      "duration_seconds": 2.08,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.18,
      "end_seconds": 93.12,
      "duration_seconds": 1.94,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.68,
      "end_seconds": 98.42,
      "duration_seconds": 3.74,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.14,
      "end_seconds": 100.67,
      "duration_seconds": 1.53,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.99,
      "end_seconds": 114.36,
      "duration_seconds": 1.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.83,
      "end_seconds": 121.54,
      "duration_seconds": 2.71,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 124.83,
      "duration_seconds": 2.58,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.6,
      "end_seconds": 129.48,
      "duration_seconds": 3.88,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.3,
      "end_seconds": 132.81,
      "duration_seconds": 2.51,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.76,
      "end_seconds": 137.07,
      "duration_seconds": 3.31,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.63,
      "end_seconds": 142.12,
      "duration_seconds": 3.49,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.23,
      "end_seconds": 147.1,
      "duration_seconds": 3.87,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.03,
      "end_seconds": 154.65,
      "duration_seconds": 5.62,
      "text": "Ah. Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.79,
      "end_seconds": 168.81,
      "duration_seconds": 2.02,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.77,
      "end_seconds": 174.28,
      "duration_seconds": 3.51,
      "text": "It's valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.74,
      "end_seconds": 178.27,
      "duration_seconds": 2.53,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.52,
      "end_seconds": 186.78,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.71,
      "end_seconds": 215.82,
      "duration_seconds": 8.11,
      "text": "Okay: saturation 91 percent, temp 37.2 degrees, BP is 142 over 85, respiratory rate 26, pulse 89."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.9,
      "end_seconds": 219.51,
      "duration_seconds": 2.61,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.85,
      "end_seconds": 224.63,
      "duration_seconds": 3.78,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.3,
      "end_seconds": 250.58,
      "duration_seconds": 7.28,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.82,
      "end_seconds": 264.71,
      "duration_seconds": 10.89,
      "text": "Please sit back down. Right, here's what I'm thinking. I can't pin this down yet. We're looking at acute pulmonary oedema or a severe chest infection."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.44,
      "end_seconds": 272.61,
      "duration_seconds": 3.17,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.71,
      "end_seconds": 298.55,
      "duration_seconds": 23.84,
      "text": "I understand the worry. At the moment I'd say it's acute pulmonary oedema, and we'll know more once the blood tests is back. I think blood tests makes sense here, for pulmonary oedema. I'm prescribing furosemide, 40 milligrams, once now, single dose. It's for fluid on the lungs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.45,
      "end_seconds": 302.01,
      "duration_seconds": 1.56,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.55,
      "end_seconds": 312.13,
      "duration_seconds": 8.58,
      "text": "Sit upright, I am giving oxygen and a water tablet injection now. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.21,
      "end_seconds": 315.12,
      "duration_seconds": 1.91,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.62,
      "end_seconds": 319.37,
      "duration_seconds": 2.75,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.15,
      "end_seconds": 322.3,
      "duration_seconds": 2.15,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.01,
      "end_seconds": 324.36,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}