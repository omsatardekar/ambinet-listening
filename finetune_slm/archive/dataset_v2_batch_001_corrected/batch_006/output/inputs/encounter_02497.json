    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.97,
      "end_seconds": 178.1,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.23,
      "end_seconds": 198.13,
      "duration_seconds": 3.9,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.53,
      "end_seconds": 204.18,
      "duration_seconds": 4.65,
      "text": "Allopurinol. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.82,
      "end_seconds": 208.45,
      "duration_seconds": 3.63,
      "text": "Right, how long has that that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.53,
      "end_seconds": 220.93,
      "duration_seconds": 10.4,
      "text": "Nearly five years now. I'm on pantoprazole, 40 milligrams, before breakfast. Though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.67,
      "end_seconds": 238.0,
      "duration_seconds": 3.33,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.72,
      "end_seconds": 241.18,
      "duration_seconds": 2.46,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.3,
      "end_seconds": 246.21,
      "duration_seconds": 3.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.81,
      "end_seconds": 251.16,
      "duration_seconds": 3.35,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.07,
      "end_seconds": 261.82,
      "duration_seconds": 5.75,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.56,
      "end_seconds": 272.07,
      "duration_seconds": 8.51,
      "text": "I gave up cigarettes last spring. I live with my elderly mother. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.68,
      "end_seconds": 277.3,
      "duration_seconds": 3.62,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.32,
      "end_seconds": 281.93,
      "duration_seconds": 3.61,
      "text": "I have gout, for about a year."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.6,
      "end_seconds": 284.51,
      "duration_seconds": 0.91,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.02,
      "end_seconds": 293.84,
      "duration_seconds": 7.82,
      "text": "I've had acid reflux, yes. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.35,
      "end_seconds": 311.59,
      "duration_seconds": 16.24,
      "text": "alright, gout, that matches what I have here okay, so my impression is this: My working impression is possible ovarian torsion. Appendicitis is also on my list i'd like to arrange a pregnancy test for pelvic pain"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 312.92,
      "end_seconds": 317.13,
      "duration_seconds": 4.21,
      "text": "I can book that for Tuesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.18,
      "end_seconds": 331.55,
      "duration_seconds": 13.37,
      "text": "you need an emergency scan and probably surgery today. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.2,
      "end_seconds": 339.74,
      "duration_seconds": 4.54,
      "text": "Hmm, um, I know what to watch for."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.18,
      "end_seconds": 350.78,
      "duration_seconds": 5.6,
      "text": "I'd like to see you again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.7,
      "end_seconds": 355.52,
      "duration_seconds": 2.82,
      "text": "Great, thank you for your help."
    },
