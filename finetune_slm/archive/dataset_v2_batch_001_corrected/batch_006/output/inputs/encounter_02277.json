{
  "schema_version": "1.0",
  "encounter_id": "02277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 6.15,
      "duration_seconds": 5.62,
      "text": "Well, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.08,
      "end_seconds": 11.72,
      "duration_seconds": 3.64,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.33,
      "end_seconds": 25.53,
      "duration_seconds": 12.2,
      "text": "Hmm, um, doctor, I'm just here to help with the details. We came because of burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.79,
      "end_seconds": 28.34,
      "duration_seconds": 1.55,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.4,
      "end_seconds": 32.29,
      "duration_seconds": 2.89,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 32.94,
      "end_seconds": 36.62,
      "duration_seconds": 3.68,
      "text": "It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.42,
      "end_seconds": 43.9,
      "duration_seconds": 4.48,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.47,
      "end_seconds": 48.35,
      "duration_seconds": 2.88,
      "text": "I suppose so, uh, yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.97,
      "end_seconds": 59.54,
      "duration_seconds": 9.57,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.43,
      "end_seconds": 65.93,
      "duration_seconds": 5.5,
      "text": "I'd say every other day. An empty stomach definitely sets it off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.84,
      "end_seconds": 74.13,
      "duration_seconds": 7.29,
      "text": "Mm, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 74.23,
      "end_seconds": 81.22,
      "duration_seconds": 6.99,
      "text": "Tell the doctor about the other thing, um, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.8,
      "end_seconds": 86.52,
      "duration_seconds": 4.72,
      "text": "Sorry, what was I saying, I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.03,
      "end_seconds": 95.79,
      "duration_seconds": 3.76,
      "text": "What about pain at night, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.85,
      "end_seconds": 118.65,
      "duration_seconds": 20.8,
      "text": "Yes, for about a month. Let me think, I've also been feeling full quickly, since Monday. And there's indigestion as well, one week now. Uh, about indigestion, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 119.67,
      "end_seconds": 130.92,
      "duration_seconds": 11.25,
      "text": "Okay, so the vitals from earlier. Pressure 113 over 75, oxygen saturation is 97 percent. Pulse 68, respiratory rate 16, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.5,
      "end_seconds": 132.2,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.19,
      "end_seconds": 137.97,
      "duration_seconds": 2.78,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.2,
      "end_seconds": 141.47,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.04,
      "end_seconds": 164.87,
      "duration_seconds": 4.83,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.77,
      "end_seconds": 169.6,
      "duration_seconds": 1.83,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.5,
      "end_seconds": 185.83,
      "duration_seconds": 4.33,
      "text": "Did you get difficulty swallowing, weight loss or vomiting blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.58,
      "end_seconds": 191.63,
      "duration_seconds": 4.05,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.51,
      "end_seconds": 195.87,
      "duration_seconds": 2.36,
      "text": "Okay, nothing like black stools?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.49,
      "end_seconds": 201.31,
      "duration_seconds": 3.82,
      "text": "Not that I've noticed, no black stools."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.85,
      "end_seconds": 206.05,
      "duration_seconds": 3.2,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.41,
      "end_seconds": 208.87,
      "duration_seconds": 1.46,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.29,
      "end_seconds": 214.49,
      "duration_seconds": 4.2,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.15,
      "end_seconds": 222.22,
      "duration_seconds": 7.07,
      "text": "Mm, I've had arthritis in my knees for about ten years now. I've got depression."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.5,
      "end_seconds": 231.92,
      "duration_seconds": 8.42,
      "text": "Mm-hmm. Yes, depression is known to us, good to have that clear. Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.3,
      "end_seconds": 236.63,
      "duration_seconds": 3.33,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.51,
      "end_seconds": 241.29,
      "duration_seconds": 2.78,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.6,
      "end_seconds": 247.11,
      "duration_seconds": 4.51,
      "text": "My father had bowel cancer. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.03,
      "end_seconds": 250.53,
      "duration_seconds": 2.5,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.08,
      "end_seconds": 253.95,
      "duration_seconds": 1.87,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 255.06,
      "end_seconds": 261.23,
      "duration_seconds": 6.17,
      "text": "I'm not sure that's right. I seem to recall a problem with amoxicillin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.78,
      "end_seconds": 264.24,
      "duration_seconds": 2.46,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.97,
      "end_seconds": 268.42,
      "duration_seconds": 2.45,
      "text": "Okay, I'll note both of those."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.58,
      "end_seconds": 283.21,
      "duration_seconds": 1.63,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.27,
      "end_seconds": 288.43,
      "duration_seconds": 4.16,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.7,
      "end_seconds": 292.13,
      "duration_seconds": 2.43,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.18,
      "end_seconds": 301.89,
      "duration_seconds": 7.71,
      "text": "It's a... um, uh, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.93,
      "end_seconds": 305.45,
      "duration_seconds": 2.52,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.18,
      "end_seconds": 324.7,
      "duration_seconds": 18.52,
      "text": "For the knee pain, I believe. My wife sets them out for me, I just take what I'm given. It's fluoxetine, 20 milligrams, every morning. It's ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.05,
      "end_seconds": 328.31,
      "duration_seconds": 2.26,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.04,
      "end_seconds": 330.61,
      "duration_seconds": 1.57,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.53,
      "end_seconds": 366.12,
      "duration_seconds": 32.59,
      "text": "Right, here's what I'm thinking. I'm honestly not certain yet. It could be a possible stomach ulcer from anti-inflammatory tablets, or it might be reflux. We should do a stool test for helicobacter for dyspepsia. I'm sending you for a blood count because of dyspepsia. What I'm giving you is omeprazole, 20 milligrams, once a day, eight weeks. You take it by mouth. It's for stomach ulcer."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.9,
      "end_seconds": 369.63,
      "duration_seconds": 2.73,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.19,
      "end_seconds": 376.82,
      "duration_seconds": 6.63,
      "text": "Stop the ibuprofen and use paracetamol for the knee pain instead. See me again in six weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.63,
      "end_seconds": 381.7,
      "duration_seconds": 3.07,
      "text": "Right, good, I'll return then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.89,
      "end_seconds": 387.24,
      "duration_seconds": 4.35,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.09,
      "end_seconds": 397.28,
      "duration_seconds": 9.19,
      "text": "So, I take the omeprazole, 20 milligrams, once a day and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.49,
      "end_seconds": 407.77,
      "duration_seconds": 5.28,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.39,
      "end_seconds": 410.46,
      "duration_seconds": 2.07,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.66,
      "end_seconds": 412.87,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}