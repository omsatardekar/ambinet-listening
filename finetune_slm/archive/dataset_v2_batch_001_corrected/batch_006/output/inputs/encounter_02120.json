{
  "schema_version": "1.0",
  "encounter_id": "02120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.22,
      "end_seconds": 3.7,
      "duration_seconds": 2.48,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.92,
      "end_seconds": 9.62,
      "duration_seconds": 4.7,
      "text": "Actually, you know, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.14,
      "end_seconds": 14.85,
      "duration_seconds": 3.71,
      "text": "Alright, is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.37,
      "end_seconds": 20.83,
      "duration_seconds": 5.46,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.06,
      "end_seconds": 23.52,
      "duration_seconds": 1.46,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.6,
      "end_seconds": 36.04,
      "duration_seconds": 11.44,
      "text": "Oh, uh, mainly a fever for two weeks. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.74,
      "end_seconds": 38.85,
      "duration_seconds": 2.11,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.84,
      "end_seconds": 43.5,
      "duration_seconds": 2.66,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.35,
      "end_seconds": 47.9,
      "duration_seconds": 3.55,
      "text": "Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.39,
      "end_seconds": 50.52,
      "duration_seconds": 1.13,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.52,
      "end_seconds": 54.9,
      "duration_seconds": 3.38,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.42,
      "end_seconds": 66.9,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.16,
      "end_seconds": 87.96,
      "duration_seconds": 7.8,
      "text": "Okay: temperature is 38.9 degrees, blood pressure 112 over 70, heart rate 102, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.5,
      "end_seconds": 91.09,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.62,
      "end_seconds": 95.49,
      "duration_seconds": 2.87,
      "text": "Alright, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.58,
      "end_seconds": 100.68,
      "duration_seconds": 3.1,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.49,
      "end_seconds": 118.26,
      "duration_seconds": 1.77,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.82,
      "end_seconds": 121.91,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.4,
      "end_seconds": 148.7,
      "duration_seconds": 8.3,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.59,
      "end_seconds": 159.89,
      "duration_seconds": 6.3,
      "text": "So, please sit back down. Any weight loss, chest pain or cough at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.23,
      "end_seconds": 163.92,
      "duration_seconds": 2.69,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.45,
      "end_seconds": 168.43,
      "duration_seconds": 2.98,
      "text": "So, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.33,
      "end_seconds": 170.39,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.38,
      "end_seconds": 176.91,
      "duration_seconds": 4.53,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.23,
      "end_seconds": 181.51,
      "duration_seconds": 3.28,
      "text": "Yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.83,
      "end_seconds": 195.33,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.94,
      "end_seconds": 199.04,
      "duration_seconds": 2.1,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.96,
      "end_seconds": 217.48,
      "duration_seconds": 3.52,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.44,
      "end_seconds": 224.15,
      "duration_seconds": 1.71,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.15,
      "end_seconds": 241.17,
      "duration_seconds": 3.02,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.75,
      "end_seconds": 243.85,
      "duration_seconds": 1.1,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.92,
      "end_seconds": 250.79,
      "duration_seconds": 5.87,
      "text": "Alright, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.68,
      "end_seconds": 263.6,
      "duration_seconds": 9.92,
      "text": "No, I share a house with my brother. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.4,
      "end_seconds": 276.16,
      "duration_seconds": 10.76,
      "text": "So where does that leave us? I can't pin this down yet. We're looking at possible infective endocarditis or a viral illness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.5,
      "end_seconds": 280.41,
      "duration_seconds": 2.91,
      "text": "Uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.1,
      "end_seconds": 316.51,
      "duration_seconds": 35.41,
      "text": "I understand the worry. At the moment I'd say it's possible infective endocarditis, and we'll know more once the blood cultures is back. Let's book blood cultures to look into possible endocarditis. The result will help us decide whether anything more is needed. You need admission today for blood cultures and a heart scan. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.75,
      "end_seconds": 323.49,
      "duration_seconds": 5.74,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.29,
      "end_seconds": 327.81,
      "duration_seconds": 2.52,
      "text": "Ah, that's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.24,
      "end_seconds": 335.4,
      "duration_seconds": 6.16,
      "text": "I'll want another look straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.42,
      "end_seconds": 343.92,
      "duration_seconds": 4.5,
      "text": "Let me think, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.47,
      "end_seconds": 345.71,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}