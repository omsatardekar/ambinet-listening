  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 4.72,
      "duration_seconds": 3.73,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.31,
      "end_seconds": 7.55,
      "duration_seconds": 1.24,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.38,
      "end_seconds": 13.88,
      "duration_seconds": 2.5,
      "text": "what's the the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.78,
      "end_seconds": 25.64,
      "duration_seconds": 9.86,
      "text": "It's a feeling of something stuck in my throat. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.25,
      "end_seconds": 31.43,
      "duration_seconds": 3.18,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.81,
      "end_seconds": 41.5,
      "duration_seconds": 6.69,
      "text": "for four weeks, I'd say sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.24,
      "end_seconds": 46.35,
      "duration_seconds": 3.11,
      "text": "Is it it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.04,
      "end_seconds": 48.19,
      "duration_seconds": 1.15,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.09,
      "end_seconds": 56.02,
      "duration_seconds": 3.93,
      "text": "Any a sharp scratch when swallowing as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.88,
      "end_seconds": 64.41,
      "duration_seconds": 7.53,
      "text": "Yes, I have. With sharp scratch when swallowing, it's worse with swallowing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.05,
      "end_seconds": 74.48,
      "duration_seconds": 8.43,
      "text": "So, have you had a feeling of something stuck in your throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.49,
      "end_seconds": 81.71,
      "duration_seconds": 6.22,
      "text": "a bit, about six months ago. It settled by itself back then"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.87,
      "end_seconds": 88.23,
      "duration_seconds": 5.36,
      "text": "So, any drooling, blood, neck swelling or difficulty breathing at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.02,
      "end_seconds": 92.88,
      "duration_seconds": 3.86,
      "text": "Yeah, no, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.19,
      "end_seconds": 96.16,
      "duration_seconds": 2.97,
      "text": "Understood. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.82,
      "end_seconds": 99.01,
      "duration_seconds": 1.19,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.82,
      "end_seconds": 102.17,
      "duration_seconds": 2.35,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.26,
      "end_seconds": 110.34,
      "duration_seconds": 7.08,
      "text": "sorry, what was I saying, that's normal as far as I know"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.47,
      "end_seconds": 129.4,
      "duration_seconds": 2.93,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.94,
      "end_seconds": 132.17,
      "duration_seconds": 2.23,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.84,
      "end_seconds": 135.1,
      "duration_seconds": 2.26,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.87,
      "end_seconds": 141.29,
      "duration_seconds": 4.42,
      "text": "No, you know, I don't take any tablets."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.68,
      "end_seconds": 158.48,
      "duration_seconds": 2.8,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 166.6,
      "duration_seconds": 3.74,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.49,
      "end_seconds": 168.94,
      "duration_seconds": 1.45,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.64,
      "end_seconds": 172.64,
      "duration_seconds": 3.0,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 175.15,
      "duration_seconds": 1.43,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.46,
      "end_seconds": 179.96,
      "duration_seconds": 3.5,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.67,
      "end_seconds": 184.44,
      "duration_seconds": 3.77,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.65,
      "end_seconds": 187.49,
      "duration_seconds": 1.84,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.68,
      "end_seconds": 192.9,
      "duration_seconds": 4.22,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.7,
      "end_seconds": 196.57,
      "duration_seconds": 2.87,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.46,
      "end_seconds": 201.55,
      "duration_seconds": 3.09,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.5,
      "end_seconds": 215.91,
      "duration_seconds": 2.41,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.17,
      "end_seconds": 239.16,
      "duration_seconds": 5.99,
      "text": "Okay: temperature 36.7, saturation 99 percent, pulse 81, BP is 115 over 76."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.51,
      "end_seconds": 245.55,
      "duration_seconds": 4.04,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.39,
      "end_seconds": 250.32,
      "duration_seconds": 2.93,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.09,
      "end_seconds": 267.34,
      "duration_seconds": 5.25,
      "text": "I can't see anything in the throat and the neck is not tender."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.98,
      "end_seconds": 274.38,
      "duration_seconds": 2.4,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.86,
      "end_seconds": 296.3,
      "duration_seconds": 11.44,
      "text": "From what you've told me and what I found, this is probably a possible fish bone scratch or lodged bone. Another possibility is a pharyngeal scratch."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.04,
      "end_seconds": 301.24,
      "duration_seconds": 3.2,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.38,
      "end_seconds": 323.43,
      "duration_seconds": 21.05,
      "text": "nothing I've seen today points to an emergency it looks like a possible fish bone scratch or lodged bone, but I'd like to confirm i'll request a neck X-ray, it'll help with foreign body sensation i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.67,
      "end_seconds": 328.88,
      "duration_seconds": 4.21,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
