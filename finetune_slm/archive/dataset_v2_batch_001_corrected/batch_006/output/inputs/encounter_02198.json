{
  "schema_version": "1.0",
  "encounter_id": "02198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.32,
      "duration_seconds": 3.1,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 11.77,
      "duration_seconds": 4.14,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.37,
      "end_seconds": 22.84,
      "duration_seconds": 10.47,
      "text": "It's breathlessness months after the infection, mostly. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.75,
      "end_seconds": 26.92,
      "duration_seconds": 3.17,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.22,
      "end_seconds": 33.4,
      "duration_seconds": 5.18,
      "text": "Mm, um, it's been about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.91,
      "end_seconds": 43.33,
      "duration_seconds": 9.42,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.04,
      "end_seconds": 67.63,
      "duration_seconds": 22.59,
      "text": "Yeah, it's all the time. It feels moderate to me. I'd rather know what's going on than keep guessing. There's a racing heart on standing as well. Erm, you know, with racing heart on standing, I notice it more with standing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.05,
      "end_seconds": 71.89,
      "duration_seconds": 2.84,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.65,
      "end_seconds": 80.88,
      "duration_seconds": 8.23,
      "text": "Years back I got a rash from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.82,
      "end_seconds": 84.02,
      "duration_seconds": 2.2,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.16,
      "end_seconds": 89.8,
      "duration_seconds": 4.64,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.52,
      "end_seconds": 94.97,
      "duration_seconds": 3.45,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.07,
      "end_seconds": 99.2,
      "duration_seconds": 3.13,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.04,
      "end_seconds": 103.28,
      "duration_seconds": 3.24,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.45,
      "end_seconds": 111.96,
      "duration_seconds": 4.51,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.01,
      "end_seconds": 136.99,
      "duration_seconds": 7.98,
      "text": "Has anyone ever diagnosed you with something? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.86,
      "end_seconds": 139.14,
      "duration_seconds": 1.28,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.1,
      "end_seconds": 158.0,
      "duration_seconds": 3.9,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.43,
      "end_seconds": 162.5,
      "duration_seconds": 3.07,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.47,
      "end_seconds": 167.5,
      "duration_seconds": 4.03,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.55,
      "end_seconds": 175.97,
      "duration_seconds": 7.42,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.4,
      "end_seconds": 181.0,
      "duration_seconds": 3.6,
      "text": "Did you get leg swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.47,
      "end_seconds": 187.5,
      "duration_seconds": 5.03,
      "text": "No leg swelling or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.91,
      "end_seconds": 191.66,
      "duration_seconds": 2.75,
      "text": "Have you noticed chest pain or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.94,
      "end_seconds": 199.09,
      "duration_seconds": 6.15,
      "text": "Sorry, what was I saying, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.37,
      "end_seconds": 201.71,
      "duration_seconds": 1.34,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.98,
      "end_seconds": 207.0,
      "duration_seconds": 4.02,
      "text": "Oh, you know, no, that's all normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.5,
      "end_seconds": 211.43,
      "duration_seconds": 2.93,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.58,
      "end_seconds": 226.75,
      "duration_seconds": 2.17,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.09,
      "end_seconds": 256.7,
      "duration_seconds": 12.61,
      "text": "Okay: BP is 119 over 69, SpO2 98 percent on room air, pulse is 74 beats a minute, respiratory rate 15, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.4,
      "end_seconds": 260.1,
      "duration_seconds": 1.7,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 265.34,
      "duration_seconds": 4.17,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.27,
      "end_seconds": 270.52,
      "duration_seconds": 3.25,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.49,
      "end_seconds": 274.07,
      "duration_seconds": 1.58,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.96,
      "end_seconds": 278.16,
      "duration_seconds": 2.2,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.48,
      "end_seconds": 297.26,
      "duration_seconds": 5.78,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.39,
      "end_seconds": 303.11,
      "duration_seconds": 1.72,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.63,
      "end_seconds": 329.42,
      "duration_seconds": 7.79,
      "text": "Let me tell you where I've got to. I think we're dealing with post-viral symptoms after COVID at this stage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.07,
      "end_seconds": 334.11,
      "duration_seconds": 3.04,
      "text": "Right, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.27,
      "end_seconds": 348.02,
      "duration_seconds": 12.75,
      "text": "Nothing I've seen today points to an emergency. It looks like post-viral symptoms after COVID. Pace your activity and increase it slowly each week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.58,
      "end_seconds": 358.63,
      "duration_seconds": 5.05,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.31,
      "end_seconds": 363.65,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}