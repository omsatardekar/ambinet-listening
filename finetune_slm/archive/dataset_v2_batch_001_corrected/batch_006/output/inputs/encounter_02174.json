{
  "schema_version": "1.0",
  "encounter_id": "02174",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 2.57,
      "duration_seconds": 1.6,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.16,
      "end_seconds": 7.89,
      "duration_seconds": 3.73,
      "text": "of course, leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.63,
      "end_seconds": 14.51,
      "duration_seconds": 4.88,
      "text": "I've been dealing with burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.69,
      "end_seconds": 20.01,
      "duration_seconds": 4.32,
      "text": "right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.86,
      "end_seconds": 30.85,
      "duration_seconds": 9.99,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.69,
      "end_seconds": 35.2,
      "duration_seconds": 2.51,
      "text": "okay, is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.22,
      "end_seconds": 39.48,
      "duration_seconds": 3.26,
      "text": "It's worse with an empty stomach."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.01,
      "end_seconds": 40.71,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.57,
      "end_seconds": 53.81,
      "duration_seconds": 12.24,
      "text": "hmm, and there's indigestion as well, six months now. And pain at night, too. I mean, about pain at night, mostly mild"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.26,
      "end_seconds": 63.2,
      "duration_seconds": 7.94,
      "text": "Have you had burning pain in the upper tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.9,
      "end_seconds": 72.0,
      "duration_seconds": 8.1,
      "text": "Actually, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.17,
      "end_seconds": 75.74,
      "duration_seconds": 2.57,
      "text": "okay, I'll do your observations first"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.26,
      "end_seconds": 91.24,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 115.42,
      "duration_seconds": 5.79,
      "text": "Okay: heart rate 81, BP is 122 over 82, temperature 37.0."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.11,
      "end_seconds": 118.58,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.69,
      "end_seconds": 123.32,
      "duration_seconds": 3.63,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.47,
      "end_seconds": 129.27,
      "duration_seconds": 3.8,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.86,
      "end_seconds": 132.5,
      "duration_seconds": 1.64,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.11,
      "end_seconds": 135.39,
      "duration_seconds": 1.28,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.67,
      "end_seconds": 155.0,
      "duration_seconds": 4.33,
      "text": "your upper tummy is tender in the middle with no guarding"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.16,
      "end_seconds": 167.46,
      "duration_seconds": 8.3,
      "text": "Thank you, you can get dressed. So, have you noticed weight loss, difficulty swallowing, vomiting blood or black stools?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.33,
      "end_seconds": 180.2,
      "duration_seconds": 7.87,
      "text": "I haven't had weight loss, difficulty swallowing, vomiting blood or black stools, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.22,
      "end_seconds": 185.58,
      "duration_seconds": 4.36,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.83,
      "end_seconds": 192.42,
      "duration_seconds": 5.59,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.16,
      "end_seconds": 197.18,
      "duration_seconds": 3.02,
      "text": "right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.13,
      "end_seconds": 201.71,
      "duration_seconds": 3.58,
      "text": "Ah, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.66,
      "end_seconds": 212.19,
      "duration_seconds": 2.53,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.01,
      "end_seconds": 216.97,
      "duration_seconds": 3.96,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 220.16,
      "duration_seconds": 2.5,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.94,
      "end_seconds": 226.22,
      "duration_seconds": 4.28,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.93,
      "end_seconds": 228.62,
      "duration_seconds": 1.69,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.39,
      "end_seconds": 231.98,
      "duration_seconds": 2.59,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.67,
      "end_seconds": 236.82,
      "duration_seconds": 3.15,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.46,
      "end_seconds": 247.16,
      "duration_seconds": 8.7,
      "text": "Erm, yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.84,
      "end_seconds": 252.77,
      "duration_seconds": 3.93,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.23,
      "end_seconds": 258.32,
      "duration_seconds": 4.09,
      "text": "no, um, nothing I can think of"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.76,
      "end_seconds": 272.31,
      "duration_seconds": 2.55,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.64,
      "end_seconds": 279.54,
      "duration_seconds": 5.9,
      "text": "Sorry, what was I saying, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.06,
      "end_seconds": 300.58,
      "duration_seconds": 9.52,
      "text": "Okay, thinking it through, it fits best with a possible stomach ulcer from anti-inflammatory tablets. Another possibility is reflux."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.34,
      "end_seconds": 304.42,
      "duration_seconds": 2.08,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.28,
      "end_seconds": 332.36,
      "duration_seconds": 26.08,
      "text": "I can't promise yet, but most people with a possible stomach ulcer from anti-inflammatory tablets do well once it's treated properly. I'd like to arrange a stool test for helicobacter for dyspepsia. I'd like to arrange a blood count for dyspepsia. I'm going to put you on omeprazole, 20 milligrams, once a day, eight weeks. That's for stomach ulcer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.29,
      "end_seconds": 341.77,
      "duration_seconds": 7.48,
      "text": "sorry, what was I saying, alright, I'll pick it it up today"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.7,
      "end_seconds": 363.44,
      "duration_seconds": 20.74,
      "text": "Stop the ibuprofen and use paracetamol for the knee pain instead. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's plan a check in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.76,
      "end_seconds": 366.38,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.52,
      "end_seconds": 372.78,
      "duration_seconds": 1.26,
      "text": "Look after yourself."
    }
  ]
}