{
  "schema_version": "1.0",
  "encounter_id": "02359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 7.02,
      "duration_seconds": 5.97,
      "text": "doctor, hi, where would you like me to to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.78,
      "end_seconds": 13.24,
      "duration_seconds": 4.46,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.44,
      "end_seconds": 18.54,
      "duration_seconds": 4.1,
      "text": "so the thing is, I've got yellow eyes"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.47,
      "end_seconds": 26.82,
      "duration_seconds": 3.35,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.33,
      "end_seconds": 42.37,
      "duration_seconds": 14.04,
      "text": "Well, it's been two months now. I looked a few things up online, and that probably didn't help. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.11,
      "end_seconds": 47.7,
      "duration_seconds": 2.59,
      "text": "Okay, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.26,
      "end_seconds": 55.3,
      "duration_seconds": 6.04,
      "text": "Pale stools goes along with it, uh, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.86,
      "end_seconds": 58.01,
      "duration_seconds": 2.15,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.15,
      "end_seconds": 60.86,
      "duration_seconds": 1.71,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.54,
      "end_seconds": 67.99,
      "duration_seconds": 5.45,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.5,
      "end_seconds": 77.44,
      "duration_seconds": 8.94,
      "text": "About a three out of ten. It's all the time. The pale stools? That's been for about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.51,
      "end_seconds": 88.26,
      "duration_seconds": 1.75,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.29,
      "end_seconds": 94.5,
      "duration_seconds": 4.21,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.07,
      "end_seconds": 98.35,
      "duration_seconds": 2.28,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.38,
      "end_seconds": 104.85,
      "duration_seconds": 4.47,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 108.59,
      "duration_seconds": 2.05,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.06,
      "end_seconds": 113.87,
      "duration_seconds": 3.81,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.22,
      "end_seconds": 119.21,
      "duration_seconds": 3.99,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.98,
      "end_seconds": 122.58,
      "duration_seconds": 2.6,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.79,
      "end_seconds": 126.61,
      "duration_seconds": 2.82,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.23,
      "end_seconds": 128.87,
      "duration_seconds": 1.64,
      "text": "yes, heart failure"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.29,
      "end_seconds": 140.44,
      "duration_seconds": 10.15,
      "text": "Yes, heart failure is known to us, good to have that clear. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.25,
      "end_seconds": 146.53,
      "duration_seconds": 5.28,
      "text": "It's spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.45,
      "end_seconds": 165.68,
      "duration_seconds": 3.23,
      "text": "And And high fever, any of that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.64,
      "end_seconds": 173.1,
      "duration_seconds": 5.46,
      "text": "I mean, um, not at all, no high fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.77,
      "end_seconds": 178.7,
      "duration_seconds": 3.93,
      "text": "Did you get confusion, vomiting blood or itching?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.32,
      "end_seconds": 183.1,
      "duration_seconds": 2.78,
      "text": "nope, nothing like that that"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.31,
      "end_seconds": 187.38,
      "duration_seconds": 4.07,
      "text": "I follow. On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.15,
      "end_seconds": 189.54,
      "duration_seconds": 1.39,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.32,
      "end_seconds": 193.28,
      "duration_seconds": 2.96,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.42,
      "end_seconds": 206.2,
      "duration_seconds": 2.78,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.4,
      "end_seconds": 228.38,
      "duration_seconds": 4.98,
      "text": "Okay: pulse 81, pressure 114 over 70, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.36,
      "end_seconds": 230.92,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.96,
      "end_seconds": 235.19,
      "duration_seconds": 2.23,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.86,
      "end_seconds": 241.8,
      "duration_seconds": 4.94,
      "text": "Alright, over here please and I'll take a a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.68,
      "end_seconds": 245.21,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.88,
      "end_seconds": 261.08,
      "duration_seconds": 6.2,
      "text": "The whites of the eyes are yellow and the liver edge is tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.62,
      "end_seconds": 286.93,
      "duration_seconds": 20.31,
      "text": "You can relax now. Putting it all together, it fits best with acute hepatitis, possibly hepatitis A after travel. I wanna be honest that this is an impression, not a final answer. It could also be a gallstone blockage, so we'll keep that open."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.89,
      "end_seconds": 290.65,
      "duration_seconds": 2.76,
      "text": "Oh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.14,
      "end_seconds": 302.07,
      "duration_seconds": 9.93,
      "text": "nothing I've seen today points to an emergency it looks like acute hepatitis, possibly hepatitis A after travel, but I'd like to confirm"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.76,
      "end_seconds": 329.84,
      "duration_seconds": 20.08,
      "text": "I want a hepatitis screen done, that's for jaundice. Rest, avoid alcohol and wash your hands carefully, as it can spread. Don't skip meals, and try to eat smaller portions more often through the day. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.34,
      "end_seconds": 335.55,
      "duration_seconds": 3.21,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.06,
      "end_seconds": 337.49,
      "duration_seconds": 1.43,
      "text": "See you soon."
    }
  ]
}