{
  "schema_version": "1.0",
  "encounter_id": "02276",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 3.32,
      "duration_seconds": 2.08,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.35,
      "end_seconds": 8.49,
      "duration_seconds": 4.14,
      "text": "Let me think, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 12.42,
      "duration_seconds": 2.4,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.96,
      "end_seconds": 25.66,
      "duration_seconds": 11.7,
      "text": "Yeah, it's vomiting large amounts of fresh blood. I don't know what's causing it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.8,
      "end_seconds": 28.86,
      "duration_seconds": 2.06,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.4,
      "end_seconds": 42.21,
      "duration_seconds": 11.81,
      "text": "Let me think, um, I'm on hydrocortisone cream, when needed. It's, It's metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 42.78,
      "end_seconds": 47.22,
      "duration_seconds": 4.44,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.26,
      "end_seconds": 53.63,
      "duration_seconds": 4.37,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.98,
      "end_seconds": 59.55,
      "duration_seconds": 4.57,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.08,
      "end_seconds": 63.06,
      "duration_seconds": 2.98,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.33,
      "end_seconds": 70.01,
      "duration_seconds": 5.68,
      "text": "Actually, you know, it's been going on for ten days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.84,
      "end_seconds": 73.48,
      "duration_seconds": 2.64,
      "text": "Right, how frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.37,
      "end_seconds": 77.92,
      "duration_seconds": 2.55,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.78,
      "end_seconds": 82.05,
      "duration_seconds": 3.27,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.77,
      "end_seconds": 94.48,
      "duration_seconds": 11.71,
      "text": "Being confused goes along with it, uh, most of the time. And there's a swollen tummy as well, about two weeks now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.69,
      "end_seconds": 99.4,
      "duration_seconds": 3.71,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.42,
      "end_seconds": 110.09,
      "duration_seconds": 9.67,
      "text": "It feels severe to me. Mm, the being confused? That's been since this morning. With being confused, mostly mild."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.74,
      "end_seconds": 113.9,
      "duration_seconds": 3.16,
      "text": "Have you noticed chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.01,
      "end_seconds": 120.5,
      "duration_seconds": 5.49,
      "text": "Uh, no chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.08,
      "end_seconds": 123.6,
      "duration_seconds": 2.52,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.39,
      "end_seconds": 128.7,
      "duration_seconds": 4.31,
      "text": "I mean, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.55,
      "end_seconds": 133.15,
      "duration_seconds": 2.6,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.08,
      "end_seconds": 135.82,
      "duration_seconds": 1.74,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.92,
      "end_seconds": 145.14,
      "duration_seconds": 1.22,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 148.61,
      "duration_seconds": 2.77,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.26,
      "end_seconds": 151.62,
      "duration_seconds": 1.36,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.5,
      "end_seconds": 157.46,
      "duration_seconds": 3.96,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.2,
      "end_seconds": 161.15,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.09,
      "end_seconds": 167.26,
      "duration_seconds": 4.17,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.83,
      "end_seconds": 170.21,
      "duration_seconds": 2.38,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.66,
      "end_seconds": 175.77,
      "duration_seconds": 4.11,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.93,
      "end_seconds": 179.0,
      "duration_seconds": 2.07,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.98,
      "end_seconds": 186.51,
      "duration_seconds": 5.53,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.51,
      "end_seconds": 191.82,
      "duration_seconds": 4.31,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.35,
      "end_seconds": 199.91,
      "duration_seconds": 6.56,
      "text": "Hmm, my brother has epilepsy. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.64,
      "end_seconds": 203.3,
      "duration_seconds": 2.66,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.6,
      "end_seconds": 219.82,
      "duration_seconds": 13.22,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.32,
      "end_seconds": 227.75,
      "duration_seconds": 2.43,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.4,
      "end_seconds": 238.29,
      "duration_seconds": 9.89,
      "text": "Eczema, for five years. Hmm, I've had diabetes, yes. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.2,
      "end_seconds": 244.71,
      "duration_seconds": 5.51,
      "text": "Understood. Okay, I can see eczema in your file as well."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 262.62,
      "end_seconds": 270.04,
      "duration_seconds": 7.42,
      "text": "Here are the numbers, doctor. Heart rate 105, temperature is 36.5 degrees, blood pressure 92 over 58."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.75,
      "end_seconds": 271.82,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.56,
      "end_seconds": 276.86,
      "duration_seconds": 3.3,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.42,
      "end_seconds": 279.69,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.11,
      "end_seconds": 300.22,
      "duration_seconds": 6.11,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.6,
      "end_seconds": 326.86,
      "duration_seconds": 21.26,
      "text": "You can relax now. Right, here's what I'm thinking. It points towards a bleed from enlarged veins in the gullet in liver disease. The reason I say that is that your story and my examination fit together. It could also be a bleeding ulcer, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.88,
      "end_seconds": 331.03,
      "duration_seconds": 3.15,
      "text": "Uh, will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.91,
      "end_seconds": 343.72,
      "duration_seconds": 10.81,
      "text": "Nothing I've seen today points to an emergency. It looks like a bleed from enlarged veins in the gullet in liver disease, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.65,
      "end_seconds": 358.94,
      "duration_seconds": 3.29,
      "text": "Let's get urgent blood tests, for major bleed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.85,
      "end_seconds": 362.78,
      "duration_seconds": 2.93,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.87,
      "end_seconds": 396.23,
      "duration_seconds": 31.36,
      "text": "I'm going to order an urgent endoscopy, for variceal bleed. I'd like you to take terlipressin, 2 milligrams, now, single dose. That should help with variceal bleeding. You are going straight to resus, I am starting two drips. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.13,
      "end_seconds": 404.21,
      "duration_seconds": 6.08,
      "text": "So, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.3,
      "end_seconds": 414.4,
      "duration_seconds": 9.1,
      "text": "So, I take the terlipressin, 2 milligrams, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.65,
      "end_seconds": 420.05,
      "duration_seconds": 4.4,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 422.01,
      "end_seconds": 424.27,
      "duration_seconds": 2.26,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}