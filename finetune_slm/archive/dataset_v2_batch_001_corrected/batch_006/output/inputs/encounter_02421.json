{
  "schema_version": "1.0",
  "encounter_id": "02421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 6.69,
      "duration_seconds": 5.44,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.07,
      "end_seconds": 15.15,
      "duration_seconds": 4.08,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.26,
      "end_seconds": 19.48,
      "duration_seconds": 3.22,
      "text": "I've been dealing with no symptoms."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.21,
      "end_seconds": 24.45,
      "duration_seconds": 3.24,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 30.22,
      "duration_seconds": 5.18,
      "text": "It's been five days now. And being a little overweight, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.5,
      "end_seconds": 33.39,
      "duration_seconds": 2.89,
      "text": "Yes, carry on. What about blurred vision?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.04,
      "end_seconds": 35.87,
      "duration_seconds": 1.83,
      "text": "No. No blurred vision."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.67,
      "end_seconds": 40.39,
      "duration_seconds": 3.72,
      "text": "Have you noticed thirst, frequent urination or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.97,
      "end_seconds": 47.82,
      "duration_seconds": 5.85,
      "text": "I haven't had thirst, frequent urination or weight loss, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.41,
      "end_seconds": 50.77,
      "duration_seconds": 2.36,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.59,
      "end_seconds": 54.73,
      "duration_seconds": 2.14,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.47,
      "end_seconds": 59.77,
      "duration_seconds": 4.3,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.62,
      "end_seconds": 66.06,
      "duration_seconds": 5.44,
      "text": "I have anxiety, for nearly five years. I have epilepsy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.03,
      "end_seconds": 74.72,
      "duration_seconds": 4.69,
      "text": "Yes. Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 80.09,
      "duration_seconds": 3.42,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.98,
      "end_seconds": 83.64,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.88,
      "end_seconds": 89.52,
      "duration_seconds": 2.64,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.11,
      "end_seconds": 91.48,
      "duration_seconds": 1.37,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.19,
      "end_seconds": 95.45,
      "duration_seconds": 3.26,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.73,
      "end_seconds": 101.03,
      "duration_seconds": 4.3,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.2,
      "end_seconds": 104.87,
      "duration_seconds": 2.67,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.95,
      "end_seconds": 108.41,
      "duration_seconds": 2.46,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.15,
      "end_seconds": 114.19,
      "duration_seconds": 4.04,
      "text": "It's carbamazepine, 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.46,
      "end_seconds": 129.99,
      "duration_seconds": 3.53,
      "text": "So, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.45,
      "end_seconds": 136.64,
      "duration_seconds": 5.19,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.39,
      "end_seconds": 141.95,
      "duration_seconds": 3.56,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.11,
      "end_seconds": 155.17,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.3,
      "end_seconds": 186.71,
      "duration_seconds": 16.41,
      "text": "Okay: pulse is 80 beats a minute, height 158 centimetres, BMI works out to 22.8, respiratory rate 15, weight 57 kilos, oxygen saturation is 97 percent, blood pressure 124 over 69."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.46,
      "end_seconds": 189.94,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.74,
      "end_seconds": 194.29,
      "duration_seconds": 3.55,
      "text": "Okay, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.31,
      "end_seconds": 199.06,
      "duration_seconds": 3.75,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.53,
      "end_seconds": 202.89,
      "duration_seconds": 2.36,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.08,
      "end_seconds": 214.36,
      "duration_seconds": 3.28,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.93,
      "end_seconds": 222.84,
      "duration_seconds": 2.91,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.19,
      "end_seconds": 245.34,
      "duration_seconds": 4.15,
      "text": "So where does that leave us? It points towards prediabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.43,
      "end_seconds": 252.34,
      "duration_seconds": 1.91,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.53,
      "end_seconds": 261.33,
      "duration_seconds": 7.8,
      "text": "Nothing I've seen today points to an emergency. It looks like prediabetes, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.11,
      "end_seconds": 273.42,
      "duration_seconds": 4.31,
      "text": "I'm sending you for a repeat HbA1c because of prediabetes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.52,
      "end_seconds": 282.46,
      "duration_seconds": 4.94,
      "text": "We have a slot Wednesday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.92,
      "end_seconds": 298.08,
      "duration_seconds": 14.16,
      "text": "Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. I'd like you to see the diabetes prevention programme as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.72,
      "end_seconds": 302.3,
      "duration_seconds": 2.58,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.24,
      "end_seconds": 310.91,
      "duration_seconds": 7.67,
      "text": "We'll catch up in six months. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.58,
      "end_seconds": 315.85,
      "duration_seconds": 3.27,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.9,
      "end_seconds": 319.22,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}