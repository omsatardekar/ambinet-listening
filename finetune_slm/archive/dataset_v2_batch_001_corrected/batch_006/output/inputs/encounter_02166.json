{
  "schema_version": "1.0",
  "encounter_id": "02166",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.22,
      "duration_seconds": 4.31,
      "text": "Okay, so morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.2,
      "end_seconds": 12.68,
      "duration_seconds": 5.48,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.28,
      "end_seconds": 17.53,
      "duration_seconds": 3.25,
      "text": "I've been dealing with dark urine."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.45,
      "end_seconds": 21.38,
      "duration_seconds": 2.93,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.36,
      "end_seconds": 39.98,
      "duration_seconds": 14.62,
      "text": "it's been going on for about four days. I wasn't sure whether to come in at all, to be honest. Let me think, I've been feeling sick too"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.91,
      "end_seconds": 47.12,
      "duration_seconds": 5.21,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.06,
      "end_seconds": 50.01,
      "duration_seconds": 1.95,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.98,
      "end_seconds": 52.95,
      "duration_seconds": 1.97,
      "text": "Any high fever or confusion?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.9,
      "end_seconds": 60.54,
      "duration_seconds": 5.64,
      "text": "hmm, no high fever or confusion, none of it"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.85,
      "end_seconds": 66.46,
      "duration_seconds": 5.61,
      "text": "Hm, okay. So, a few quick ones: itching or vomiting blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.34,
      "end_seconds": 70.6,
      "duration_seconds": 3.26,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.35,
      "end_seconds": 79.03,
      "duration_seconds": 3.68,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.57,
      "end_seconds": 82.25,
      "duration_seconds": 1.68,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.35,
      "end_seconds": 88.36,
      "duration_seconds": 4.01,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.96,
      "end_seconds": 91.31,
      "duration_seconds": 2.35,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.28,
      "end_seconds": 111.2,
      "duration_seconds": 2.92,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.59,
      "end_seconds": 121.51,
      "duration_seconds": 8.92,
      "text": "I mean, uh, yes, I had a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.08,
      "end_seconds": 124.14,
      "duration_seconds": 2.06,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.48,
      "end_seconds": 134.96,
      "duration_seconds": 4.48,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.21,
      "end_seconds": 143.93,
      "duration_seconds": 3.72,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.87,
      "end_seconds": 148.62,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.2,
      "end_seconds": 152.47,
      "duration_seconds": 3.27,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.61,
      "end_seconds": 158.5,
      "duration_seconds": 4.89,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.82,
      "end_seconds": 163.03,
      "duration_seconds": 3.21,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.81,
      "end_seconds": 167.14,
      "duration_seconds": 2.33,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.58,
      "end_seconds": 172.11,
      "duration_seconds": 3.53,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.84,
      "end_seconds": 175.53,
      "duration_seconds": 1.69,
      "text": "Thyroxine, every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.08,
      "end_seconds": 179.5,
      "duration_seconds": 2.42,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.82,
      "end_seconds": 182.42,
      "duration_seconds": 1.6,
      "text": "It's 75 micrograms."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.69,
      "end_seconds": 190.55,
      "duration_seconds": 2.86,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.73,
      "end_seconds": 193.43,
      "duration_seconds": 1.7,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.22,
      "end_seconds": 198.34,
      "duration_seconds": 4.12,
      "text": "right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.22,
      "end_seconds": 208.47,
      "duration_seconds": 6.25,
      "text": "I've, I've had an underactive thyroid for nearly five years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.57,
      "end_seconds": 214.62,
      "duration_seconds": 5.05,
      "text": "okay, go on. I'll just record a a few vital signs"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.06,
      "end_seconds": 225.5,
      "duration_seconds": 3.44,
      "text": "Right, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.71,
      "end_seconds": 253.06,
      "duration_seconds": 9.35,
      "text": "Okay: SpO2 97 percent on room air, BP is 116 over 70, temp 37.0 degrees. And heart rate 82."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.32,
      "end_seconds": 255.94,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.19,
      "end_seconds": 263.81,
      "duration_seconds": 3.62,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.51,
      "end_seconds": 268.82,
      "duration_seconds": 3.31,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.39,
      "end_seconds": 272.96,
      "duration_seconds": 2.57,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.95,
      "end_seconds": 298.08,
      "duration_seconds": 6.13,
      "text": "the whites of the eyes are yellow and the liver edge is tender"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.35,
      "end_seconds": 317.83,
      "duration_seconds": 2.48,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.22,
      "end_seconds": 336.55,
      "duration_seconds": 13.33,
      "text": "That's all I needed to check. So where does that leave us? The most likely explanation is acute hepatitis, possibly hepatitis A after travel. A gallstone blockage is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.56,
      "end_seconds": 340.62,
      "duration_seconds": 2.06,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.89,
      "end_seconds": 360.95,
      "duration_seconds": 16.06,
      "text": "Nothing I've seen today points to an emergency. It looks like acute hepatitis, possibly hepatitis A after travel. Just to be sure I understood. You've had dark urine for about four days, and no vomiting blood or confusion."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.13,
      "end_seconds": 364.67,
      "duration_seconds": 2.54,
      "text": "Mm, yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.21,
      "end_seconds": 388.33,
      "duration_seconds": 9.12,
      "text": "rest, avoid alcohol and wash your hands carefully, as it can spread. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.06,
      "end_seconds": 392.68,
      "duration_seconds": 3.62,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.29,
      "end_seconds": 399.71,
      "duration_seconds": 1.42,
      "text": "Look after yourself."
    }
  ]
}