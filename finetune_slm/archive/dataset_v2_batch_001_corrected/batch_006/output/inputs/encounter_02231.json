  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 2.27,
      "duration_seconds": 1.75,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.19,
      "end_seconds": 7.25,
      "duration_seconds": 4.06,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.07,
      "end_seconds": 28.11,
      "duration_seconds": 19.04,
      "text": "Well, uh, I've been having sudden severe pain on the right side of my pelvis. I'm hoping you can tell me something definite. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.49,
      "end_seconds": 31.64,
      "duration_seconds": 2.15,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.85,
      "end_seconds": 35.45,
      "duration_seconds": 2.6,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.83,
      "end_seconds": 39.07,
      "duration_seconds": 3.24,
      "text": "Mm, okay. Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.84,
      "end_seconds": 44.37,
      "duration_seconds": 4.53,
      "text": "It usually comes with pain that comes in waves."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.67,
      "end_seconds": 59.75,
      "duration_seconds": 2.08,
      "text": "Any discharge or missed period?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.0,
      "end_seconds": 66.05,
      "duration_seconds": 5.05,
      "text": "erm, I haven't had discharge or missed period, no"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.05,
      "end_seconds": 73.15,
      "duration_seconds": 5.1,
      "text": "Let me check a few things. Any vaginal bleeding or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.42,
      "end_seconds": 78.35,
      "duration_seconds": 3.93,
      "text": "No, um, no vaginal bleeding or fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.04,
      "end_seconds": 83.26,
      "duration_seconds": 3.22,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.87,
      "end_seconds": 90.05,
      "duration_seconds": 5.18,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.58,
      "end_seconds": 92.88,
      "duration_seconds": 1.3,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.88,
      "end_seconds": 95.83,
      "duration_seconds": 1.95,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.59,
      "end_seconds": 101.83,
      "duration_seconds": 5.24,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.41,
      "end_seconds": 114.29,
      "duration_seconds": 11.88,
      "text": "I only drink at family occasions. My husband and I live above the shop. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.38,
      "end_seconds": 120.0,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.71,
      "end_seconds": 130.39,
      "duration_seconds": 8.68,
      "text": "I've had epilepsy for about a year now i have an irregular heartbeat, for about a year"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.1,
      "end_seconds": 143.02,
      "duration_seconds": 11.92,
      "text": "understood right, so epilepsy and an irregular heartbeat are already on your record we'll keep that in mind today which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.45,
      "end_seconds": 161.68,
      "duration_seconds": 16.23,
      "text": "Levetiracetam. I take it 500 milligrams, twice a day for the seizures. I take something called apix... apixaban, 5 milligrams, maybe, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.6,
      "end_seconds": 167.1,
      "duration_seconds": 4.5,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.51,
      "end_seconds": 170.65,
      "duration_seconds": 2.14,
      "text": "no, it's at home"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.28,
      "end_seconds": 175.82,
      "duration_seconds": 4.54,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.84,
      "end_seconds": 178.41,
      "duration_seconds": 1.57,
      "text": "Yes, grass pollen."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.3,
      "end_seconds": 189.81,
      "duration_seconds": 2.51,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.39,
      "end_seconds": 205.59,
      "duration_seconds": 2.2,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.69,
      "end_seconds": 225.59,
      "duration_seconds": 6.9,
      "text": "Okay: pulse is 112 beats a minute, BP is 125 over 75, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.81,
      "end_seconds": 228.44,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.27,
      "end_seconds": 233.16,
      "duration_seconds": 3.89,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.84,
      "end_seconds": 238.42,
      "duration_seconds": 2.58,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.34,
      "end_seconds": 241.53,
      "duration_seconds": 2.19,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.37,
      "end_seconds": 254.71,
      "duration_seconds": 5.34,
      "text": "You are in severe pain with a tender mass low on the right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.25,
      "end_seconds": 260.15,
      "duration_seconds": 2.9,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.06,
      "end_seconds": 306.98,
      "duration_seconds": 35.92,
      "text": "okay, so my impression is this: The most likely explanation is possible ovarian torsion a ruptured cyst is also on my list i'd like to arrange a pregnancy test for pelvic pain i'm sending you for an urgent pelvic ultrasound because of possible torsion you need an emergency scan and probably surgery today and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.58,
      "end_seconds": 310.73,
      "duration_seconds": 3.15,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.82,
      "end_seconds": 315.89,
      "duration_seconds": 3.07,
      "text": "no, that's all thanks a lot"
    }
  ]
