{
  "schema_version": "1.0",
  "encounter_id": "02327",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 6.61,
      "duration_seconds": 5.9,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.49,
      "end_seconds": 11.81,
      "duration_seconds": 4.32,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.19,
      "end_seconds": 18.35,
      "duration_seconds": 5.16,
      "text": "Doctor, um, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.73,
      "end_seconds": 24.15,
      "duration_seconds": 4.42,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.4,
      "end_seconds": 29.72,
      "duration_seconds": 4.32,
      "text": "Doctor, it's no symptoms. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.41,
      "end_seconds": 34.77,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.71,
      "end_seconds": 39.32,
      "duration_seconds": 2.61,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.81,
      "end_seconds": 43.29,
      "duration_seconds": 2.48,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.89,
      "end_seconds": 64.27,
      "duration_seconds": 20.38,
      "text": "It's mild, honestly. I've also had a high blood sugar on a routine test, for three days. As for being a little overweight, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.06,
      "end_seconds": 71.65,
      "duration_seconds": 5.59,
      "text": "Have you had no symptoms before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.26,
      "end_seconds": 79.03,
      "duration_seconds": 5.77,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.84,
      "end_seconds": 83.46,
      "duration_seconds": 3.62,
      "text": "A few quick ones: frequent urination or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.08,
      "end_seconds": 87.85,
      "duration_seconds": 2.77,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.19,
      "end_seconds": 91.46,
      "duration_seconds": 2.27,
      "text": "Any thirst or blurred vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.26,
      "end_seconds": 95.57,
      "duration_seconds": 3.31,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.99,
      "end_seconds": 99.73,
      "duration_seconds": 2.74,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.28,
      "end_seconds": 103.76,
      "duration_seconds": 2.48,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.9,
      "end_seconds": 108.36,
      "duration_seconds": 3.46,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.16,
      "end_seconds": 112.58,
      "duration_seconds": 2.42,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.4,
      "end_seconds": 119.37,
      "duration_seconds": 4.97,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 120.13,
      "end_seconds": 135.27,
      "duration_seconds": 15.14,
      "text": "He is on sumatriptan, 50 milligrams, when needed for my migraines, I give it to him. He is on hydrocortisone cream, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.21,
      "end_seconds": 146.27,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.31,
      "end_seconds": 154.47,
      "duration_seconds": 6.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 159.98,
      "duration_seconds": 3.55,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.87,
      "end_seconds": 164.79,
      "duration_seconds": 2.92,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.11,
      "end_seconds": 171.08,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.21,
      "end_seconds": 182.99,
      "duration_seconds": 10.78,
      "text": "I have migraines. I wasn't sure whether to come in at all, to be honest. Eczema, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.54,
      "end_seconds": 190.83,
      "duration_seconds": 6.29,
      "text": "Okay, I can see migraines in your file as well. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.88,
      "end_seconds": 202.56,
      "duration_seconds": 9.68,
      "text": "I had a meniscus repair on my knee four years ago. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 211.28,
      "duration_seconds": 7.72,
      "text": "Any allergies to tablets, food or anything in the environment? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.2,
      "end_seconds": 215.46,
      "duration_seconds": 3.26,
      "text": "I'm allergic to amoxicillin, I get hives."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.65,
      "end_seconds": 220.47,
      "duration_seconds": 3.82,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.51,
      "end_seconds": 230.2,
      "duration_seconds": 4.69,
      "text": "My mother had a stroke. My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.29,
      "end_seconds": 234.69,
      "duration_seconds": 3.4,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.72,
      "end_seconds": 248.22,
      "duration_seconds": 2.5,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.23,
      "end_seconds": 271.57,
      "duration_seconds": 13.34,
      "text": "Okay: heart rate 79, temperature 36.6, BP is 110 over 81. And weight 92 kilos, SpO2 97 percent on room air, BMI works out to 29.4, height 177 centimetres."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.61,
      "end_seconds": 276.87,
      "duration_seconds": 4.26,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.98,
      "end_seconds": 279.52,
      "duration_seconds": 1.54,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.34,
      "end_seconds": 282.75,
      "duration_seconds": 1.41,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.94,
      "end_seconds": 302.68,
      "duration_seconds": 3.74,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.31,
      "end_seconds": 308.99,
      "duration_seconds": 2.68,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.01,
      "end_seconds": 337.0,
      "duration_seconds": 17.99,
      "text": "I'm going to order a repeat HbA1c, for prediabetes. Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. Book a review in six months. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.91,
      "end_seconds": 342.11,
      "duration_seconds": 3.2,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.78,
      "end_seconds": 345.07,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}