{
  "schema_version": "1.0",
  "encounter_id": "02217",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 6.69,
      "duration_seconds": 6.18,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.67,
      "end_seconds": 13.32,
      "duration_seconds": 4.65,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.92,
      "end_seconds": 20.95,
      "duration_seconds": 6.03,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.96,
      "end_seconds": 26.61,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.69,
      "end_seconds": 34.67,
      "duration_seconds": 5.98,
      "text": "She's been having a back that has got shorter, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.65,
      "end_seconds": 43.26,
      "duration_seconds": 6.61,
      "text": "What do you take on a normal day? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.82,
      "end_seconds": 53.03,
      "duration_seconds": 8.21,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.67,
      "end_seconds": 59.57,
      "duration_seconds": 2.9,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.48,
      "end_seconds": 77.68,
      "duration_seconds": 16.2,
      "text": "For my bones, I believe. My husband sets them out for me, I just take what I'm given. Metoprolol. I take it 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.39,
      "end_seconds": 82.88,
      "duration_seconds": 4.49,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.92,
      "end_seconds": 89.29,
      "duration_seconds": 5.37,
      "text": "Sorry, what was I saying, no, it's at home."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.0,
      "end_seconds": 91.8,
      "duration_seconds": 1.8,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.32,
      "end_seconds": 102.5,
      "duration_seconds": 10.18,
      "text": "I'm not sure when it began, um, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.99,
      "end_seconds": 105.89,
      "duration_seconds": 2.9,
      "text": "I follow. Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.06,
      "end_seconds": 122.82,
      "duration_seconds": 15.76,
      "text": "Sorry, what was I saying, it usually comes with a dull ache in my back. Okay, so the dull ache in my back? That's been for about four days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.36,
      "end_seconds": 127.24,
      "duration_seconds": 2.88,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.05,
      "end_seconds": 133.28,
      "duration_seconds": 5.23,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.91,
      "end_seconds": 138.55,
      "duration_seconds": 4.64,
      "text": "Did you get numbness, fever, bladder problems or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.98,
      "end_seconds": 160.72,
      "duration_seconds": 17.74,
      "text": "So, no, no numbness, no fever, no bladder problems. I did have a wrist broken in a slip at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.35,
      "end_seconds": 165.97,
      "duration_seconds": 3.62,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.62,
      "end_seconds": 169.41,
      "duration_seconds": 1.79,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.28,
      "end_seconds": 174.28,
      "duration_seconds": 3.0,
      "text": "Alright, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.37,
      "end_seconds": 182.24,
      "duration_seconds": 3.87,
      "text": "Yeah, um, no, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.92,
      "end_seconds": 186.52,
      "duration_seconds": 2.6,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.34,
      "end_seconds": 190.97,
      "duration_seconds": 3.63,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 192.87,
      "end_seconds": 200.66,
      "duration_seconds": 7.79,
      "text": "Hold on, doctor, I think she reacted to amoxicillin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.95,
      "end_seconds": 205.06,
      "duration_seconds": 3.11,
      "text": "Right, I don't remember that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.82,
      "end_seconds": 209.02,
      "duration_seconds": 3.2,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.16,
      "end_seconds": 219.59,
      "duration_seconds": 2.43,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.04,
      "end_seconds": 229.23,
      "duration_seconds": 8.19,
      "text": "I've had thin bones for nearly five years now. Yes, acid reflux. I have heart disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.01,
      "end_seconds": 238.61,
      "duration_seconds": 8.6,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.27,
      "end_seconds": 244.65,
      "duration_seconds": 4.38,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.49,
      "end_seconds": 247.87,
      "duration_seconds": 1.38,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.44,
      "end_seconds": 253.55,
      "duration_seconds": 4.11,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 257.18,
      "duration_seconds": 2.13,
      "text": "So, how are your meals?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.59,
      "end_seconds": 262.48,
      "duration_seconds": 3.89,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.27,
      "end_seconds": 266.6,
      "duration_seconds": 2.33,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.11,
      "end_seconds": 279.15,
      "duration_seconds": 3.04,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.51,
      "end_seconds": 312.87,
      "duration_seconds": 12.36,
      "text": "Okay: temperature 36.8, SpO2 98 percent on room air, heart rate 69, weight 54 kilos, height 170 centimetres, BP is 128 over 70."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.34,
      "end_seconds": 319.63,
      "duration_seconds": 4.29,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.46,
      "end_seconds": 321.16,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.03,
      "end_seconds": 323.44,
      "duration_seconds": 1.41,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.15,
      "end_seconds": 340.86,
      "duration_seconds": 7.71,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.56,
      "end_seconds": 346.69,
      "duration_seconds": 2.13,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.4,
      "end_seconds": 373.47,
      "duration_seconds": 11.07,
      "text": "So where does that leave us? It fits best with osteoporosis with a fragility fracture. Vitamin D deficiency is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.07,
      "end_seconds": 377.25,
      "duration_seconds": 2.18,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.35,
      "end_seconds": 399.92,
      "duration_seconds": 20.57,
      "text": "I understand the worry. At the moment I'd say it's osteoporosis with a fragility fracture, and we'll know more once the a bone density scan is back. Let me just check I've got this right. You've had a back that has got shorter, and no bladder problems or weight loss."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.89,
      "end_seconds": 404.02,
      "duration_seconds": 2.13,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.51,
      "end_seconds": 414.99,
      "duration_seconds": 9.48,
      "text": "I'm going to order a bone density scan, for osteoporosis. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.68,
      "end_seconds": 420.4,
      "duration_seconds": 3.72,
      "text": "I mean, how long will it take?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.0,
      "end_seconds": 425.76,
      "duration_seconds": 3.76,
      "text": "I'll request blood tests, it'll help with osteoporosis."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.72,
      "end_seconds": 429.87,
      "duration_seconds": 3.15,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.9,
      "end_seconds": 458.21,
      "duration_seconds": 22.31,
      "text": "Take the tablet with a full glass of water, and stay upright for thirty minutes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you in three months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 459.74,
      "end_seconds": 463.81,
      "duration_seconds": 4.07,
      "text": "Let me think, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.15,
      "end_seconds": 466.37,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}