  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.18,
      "duration_seconds": 3.49,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 10.31,
      "duration_seconds": 4.17,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.38,
      "end_seconds": 19.05,
      "duration_seconds": 6.67,
      "text": "So, So the thing is, I've got a back that has got shorter."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 23.97,
      "duration_seconds": 3.15,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.63,
      "end_seconds": 39.02,
      "duration_seconds": 2.39,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.79,
      "end_seconds": 71.49,
      "duration_seconds": 12.7,
      "text": "Okay: heart rate 68, temperature 36.6, blood pressure 126 over 82. And BMI works out to 28.7, height 183 centimetres, weight 96 kilos, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.94,
      "end_seconds": 74.49,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.34,
      "end_seconds": 80.79,
      "duration_seconds": 5.45,
      "text": "I'll explain what these mean in a moment. Alright, when did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.44,
      "end_seconds": 87.91,
      "duration_seconds": 5.47,
      "text": "Five days, I think... sorry, two days, I got that wrong."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.66,
      "end_seconds": 91.85,
      "duration_seconds": 3.19,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.34,
      "end_seconds": 94.46,
      "duration_seconds": 1.12,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.33,
      "end_seconds": 99.91,
      "duration_seconds": 3.58,
      "text": "Did you get fever, weight loss or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.64,
      "end_seconds": 106.02,
      "duration_seconds": 5.38,
      "text": "I, I haven't had fever, weight loss or numbness, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.34,
      "end_seconds": 114.1,
      "duration_seconds": 3.76,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.84,
      "end_seconds": 118.05,
      "duration_seconds": 3.21,
      "text": "No, um, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.13,
      "end_seconds": 122.99,
      "duration_seconds": 2.86,
      "text": "Right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.98,
      "end_seconds": 130.39,
      "duration_seconds": 5.41,
      "text": "Let me think, you know, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 151.31,
      "duration_seconds": 4.98,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.24,
      "end_seconds": 155.99,
      "duration_seconds": 2.75,
      "text": "Erm, no allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.46,
      "end_seconds": 161.97,
      "duration_seconds": 4.51,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 164.82,
      "duration_seconds": 1.65,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.0,
      "end_seconds": 182.26,
      "duration_seconds": 2.26,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.15,
      "end_seconds": 188.57,
      "duration_seconds": 4.42,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.26,
      "end_seconds": 192.6,
      "duration_seconds": 2.34,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.49,
      "end_seconds": 200.18,
      "duration_seconds": 3.69,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.52,
      "end_seconds": 219.05,
      "duration_seconds": 2.53,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.35,
      "end_seconds": 223.39,
      "duration_seconds": 3.04,
      "text": "Mm, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.9,
      "end_seconds": 228.17,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.89,
      "end_seconds": 229.78,
      "duration_seconds": 0.89,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.02,
      "end_seconds": 234.7,
      "duration_seconds": 3.68,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.09,
      "end_seconds": 251.2,
      "duration_seconds": 7.11,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.79,
      "end_seconds": 264.82,
      "duration_seconds": 8.03,
      "text": "Good, you can sit up again. Okay, thinking it through, it fits best with osteoporosis with a fragility fracture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.46,
      "end_seconds": 269.15,
      "duration_seconds": 3.69,
      "text": "Oh, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.64,
      "end_seconds": 276.88,
      "duration_seconds": 6.24,
      "text": "Nothing I've seen today points to an emergency. It looks like osteoporosis with a fragility fracture."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.33,
      "end_seconds": 300.91,
      "duration_seconds": 9.58,
      "text": "Take the tablet with a full glass of water, and stay upright for thirty minutes. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.01,
      "end_seconds": 304.86,
      "duration_seconds": 2.85,
      "text": "I think I understand everything. Thanks."
    }
  ]
}