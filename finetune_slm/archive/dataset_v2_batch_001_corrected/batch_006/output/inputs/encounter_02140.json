{
  "schema_version": "1.0",
  "encounter_id": "02140",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.02,
      "duration_seconds": 3.65,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 10.87,
      "duration_seconds": 4.27,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.11,
      "end_seconds": 15.64,
      "duration_seconds": 3.53,
      "text": "I've been dealing with a low fever."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.21,
      "end_seconds": 21.45,
      "duration_seconds": 5.24,
      "text": "can I check a a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.14,
      "end_seconds": 30.2,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.72,
      "end_seconds": 56.67,
      "duration_seconds": 6.95,
      "text": "Okay: BP is 124 over 66, oxygen saturation is 97 percent, respiratory rate 16. And pulse 96."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.42,
      "end_seconds": 81.16,
      "duration_seconds": 6.74,
      "text": "How many days or weeks has it been? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.89,
      "end_seconds": 88.12,
      "duration_seconds": 5.23,
      "text": "I'd say four weeks. Actually, no, closer to one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.97,
      "end_seconds": 92.67,
      "duration_seconds": 3.7,
      "text": "Right, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.99,
      "end_seconds": 101.96,
      "duration_seconds": 7.97,
      "text": "About a five out of ten. I've also had constipation then loose stools, since last night."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.67,
      "end_seconds": 111.24,
      "duration_seconds": 4.57,
      "text": "Has there been pain in the lower left tummy too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.1,
      "end_seconds": 114.63,
      "duration_seconds": 1.53,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.93,
      "end_seconds": 121.99,
      "duration_seconds": 6.06,
      "text": "Have you had a low fever before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.35,
      "end_seconds": 130.18,
      "duration_seconds": 6.83,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.14,
      "end_seconds": 138.14,
      "duration_seconds": 6.0,
      "text": "a few quick ones: urinary symptoms, weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.88,
      "end_seconds": 141.08,
      "duration_seconds": 2.2,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.05,
      "end_seconds": 144.4,
      "duration_seconds": 1.35,
      "text": "Nothing like vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.34,
      "end_seconds": 147.96,
      "duration_seconds": 1.62,
      "text": "Nope, no vomiting."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.74,
      "end_seconds": 152.65,
      "duration_seconds": 3.91,
      "text": "alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.54,
      "end_seconds": 157.34,
      "duration_seconds": 2.8,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.38,
      "end_seconds": 179.14,
      "duration_seconds": 4.76,
      "text": "So, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.1,
      "end_seconds": 182.42,
      "duration_seconds": 2.32,
      "text": "my mother had a stroke"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.57,
      "end_seconds": 188.83,
      "duration_seconds": 5.26,
      "text": "Alright, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.84,
      "end_seconds": 210.15,
      "duration_seconds": 19.31,
      "text": "I used to drink heavily but I stopped four years ago. I have about eight cigarettes in a day. I'm a plumber, lots of bending and kneeling. I walk the dog every morning. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.63,
      "end_seconds": 217.66,
      "duration_seconds": 4.03,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.58,
      "end_seconds": 235.28,
      "duration_seconds": 12.7,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain. My family kept telling me to get it checked. It's apixaban, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.38,
      "end_seconds": 239.7,
      "duration_seconds": 2.32,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.16,
      "end_seconds": 251.63,
      "duration_seconds": 7.47,
      "text": "5 milligrams, I think that's what's on the box. Naproxen I don't take anymore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.49,
      "end_seconds": 256.89,
      "duration_seconds": 4.4,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.83,
      "end_seconds": 261.25,
      "duration_seconds": 2.42,
      "text": "Yes, I'm allergic to nickel."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.94,
      "end_seconds": 266.22,
      "duration_seconds": 4.28,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.82,
      "end_seconds": 270.46,
      "duration_seconds": 2.64,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.36,
      "end_seconds": 277.23,
      "duration_seconds": 2.87,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.04,
      "end_seconds": 280.89,
      "duration_seconds": 2.85,
      "text": "I've had an irregular heartbeat, yes"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.86,
      "end_seconds": 289.46,
      "duration_seconds": 7.6,
      "text": "alright, arthritis in your knees and an irregular heartbeat, that matches what I have here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.89,
      "end_seconds": 296.0,
      "duration_seconds": 4.11,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.64,
      "end_seconds": 307.39,
      "duration_seconds": 1.75,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.4,
      "end_seconds": 309.86,
      "duration_seconds": 1.46,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.06,
      "end_seconds": 328.32,
      "duration_seconds": 5.26,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.28,
      "end_seconds": 331.5,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.13,
      "end_seconds": 348.24,
      "duration_seconds": 12.11,
      "text": "okay, that's enough for me. Let me tell you where I've got to. It points towards acute diverticulitis. A bowel tumour is also on my list"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.01,
      "end_seconds": 353.89,
      "duration_seconds": 3.88,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.96,
      "end_seconds": 379.28,
      "duration_seconds": 24.32,
      "text": "I understand the worry. At the moment I'd say it's acute diverticulitis, and we'll know more once the a CT scan is back. I'm going to order a CT scan, for left iliac fossa pain. I'll start you on co-amoxiclav, 625 milligrams, three times a day, five days. That's for diverticulitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.87,
      "end_seconds": 382.1,
      "duration_seconds": 1.23,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.96,
      "end_seconds": 404.79,
      "duration_seconds": 16.83,
      "text": "Drink plenty and start with a light diet. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.9,
      "end_seconds": 406.95,
      "duration_seconds": 1.05,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.78,
      "end_seconds": 411.93,
      "duration_seconds": 3.15,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.67,
      "end_seconds": 415.76,
      "duration_seconds": 2.09,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.04,
      "end_seconds": 418.46,
      "duration_seconds": 1.42,
      "text": "look after yourself"
    }
  ]
}