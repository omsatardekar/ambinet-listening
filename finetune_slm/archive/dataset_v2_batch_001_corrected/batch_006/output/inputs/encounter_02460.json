    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 85.6,
      "duration_seconds": 1.95,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.25,
      "end_seconds": 90.27,
      "duration_seconds": 4.02,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.91,
      "end_seconds": 94.29,
      "duration_seconds": 3.38,
      "text": "Has anyone ever diagnosed you with something?"
