    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.69,
      "end_seconds": 57.28,
      "duration_seconds": 9.59,
      "text": "I'd say mild. Erm, there was not listening at school, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.29,
      "end_seconds": 72.43,
      "duration_seconds": 2.14,
      "text": "Okay, how are your meals?"
