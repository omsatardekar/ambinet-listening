{
  "schema_version": "1.0",
  "encounter_id": "02193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 3.09,
      "duration_seconds": 2.44,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.94,
      "end_seconds": 10.41,
      "duration_seconds": 5.47,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.35,
      "end_seconds": 17.7,
      "duration_seconds": 5.35,
      "text": "Yes, that's no problem at all. Please sit. Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 18.48,
      "end_seconds": 24.17,
      "duration_seconds": 5.69,
      "text": "We came because of itchy red patches that have gone crusty."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.55,
      "end_seconds": 27.15,
      "duration_seconds": 1.6,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.23,
      "end_seconds": 37.15,
      "duration_seconds": 8.92,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.05,
      "end_seconds": 47.54,
      "duration_seconds": 8.49,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.07,
      "end_seconds": 57.46,
      "duration_seconds": 9.39,
      "text": "So, pretty moderate, if I'm being honest. It happens on and off. Oh, and being irritable."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.79,
      "end_seconds": 66.3,
      "duration_seconds": 7.51,
      "text": "Have you had itchy red patches that have gone crusty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.42,
      "end_seconds": 73.46,
      "duration_seconds": 6.04,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.35,
      "end_seconds": 79.46,
      "duration_seconds": 4.11,
      "text": "So, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.11,
      "end_seconds": 84.44,
      "duration_seconds": 4.33,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.97,
      "end_seconds": 100.38,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.9,
      "end_seconds": 113.21,
      "duration_seconds": 11.31,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.28,
      "end_seconds": 117.62,
      "duration_seconds": 2.34,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 122.58,
      "end_seconds": 134.92,
      "duration_seconds": 12.34,
      "text": "It's hydrocortisone cream, when needed, doctor. She is on aspirin, 75 milligrams, once a day, I give it to her. She takes simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.14,
      "end_seconds": 139.01,
      "duration_seconds": 2.87,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 140.35,
      "end_seconds": 141.63,
      "duration_seconds": 1.28,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.87,
      "end_seconds": 142.7,
      "duration_seconds": 0.83,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 144.67,
      "end_seconds": 150.72,
      "duration_seconds": 6.05,
      "text": "She takes paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.61,
      "end_seconds": 155.91,
      "duration_seconds": 4.3,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.6,
      "end_seconds": 160.53,
      "duration_seconds": 3.93,
      "text": "Yeah, I have eczema, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.08,
      "end_seconds": 162.98,
      "duration_seconds": 0.9,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.44,
      "end_seconds": 185.25,
      "duration_seconds": 18.81,
      "text": "I've had heart disease for about a year now. I mean, I've had high cholesterol for nearly five years now. I've, I've had arthritis in my knees for nearly five years now. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.78,
      "end_seconds": 194.84,
      "duration_seconds": 9.06,
      "text": "Ah. Yes, heart disease is known to us, good to have that clear. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.19,
      "end_seconds": 207.72,
      "duration_seconds": 11.53,
      "text": "Nothing, I'm teetotal. I've never touched a cigarette. I walk the dog every morning. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.33,
      "end_seconds": 230.67,
      "duration_seconds": 4.34,
      "text": "Okay, any drowsiness, eating poorly, blisters or high fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.72,
      "end_seconds": 244.06,
      "duration_seconds": 12.34,
      "text": "No, no drowsiness, no eating poorly, no blisters. I did have scratching at night at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.88,
      "end_seconds": 250.0,
      "duration_seconds": 4.12,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.55,
      "end_seconds": 253.23,
      "duration_seconds": 1.68,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.82,
      "end_seconds": 258.06,
      "duration_seconds": 3.24,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.94,
      "end_seconds": 273.77,
      "duration_seconds": 2.83,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 302.83,
      "duration_seconds": 8.28,
      "text": "Okay: temperature is 36.7 degrees, SpO2 97 percent on room air, blood pressure 123 over 80, pulse 76."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.16,
      "end_seconds": 306.12,
      "duration_seconds": 1.96,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.22,
      "end_seconds": 327.65,
      "duration_seconds": 19.43,
      "text": "We'll look at it together shortly. Let me tell you where I've got to. This is probably eczema with a bacterial skin infection. Herpes simplex eczema is also on my list. For this, flucloxacillin, 250 milligrams, four times a day, seven days. That's for infected eczema."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.64,
      "end_seconds": 333.5,
      "duration_seconds": 4.86,
      "text": "Mm, alright. Should I have a skin swab as well?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.56,
      "end_seconds": 344.07,
      "duration_seconds": 8.51,
      "text": "So, I wouldn't order it today. If anything changes, we'll reconsider. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 344.98,
      "end_seconds": 348.07,
      "duration_seconds": 3.09,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.93,
      "end_seconds": 351.52,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}