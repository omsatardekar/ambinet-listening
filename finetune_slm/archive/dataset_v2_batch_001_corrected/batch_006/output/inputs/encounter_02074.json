{
  "schema_version": "1.0",
  "encounter_id": "02074",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 4.9,
      "duration_seconds": 3.69,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.94,
      "end_seconds": 9.78,
      "duration_seconds": 2.84,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.0,
      "end_seconds": 12.61,
      "duration_seconds": 1.61,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.08,
      "end_seconds": 20.17,
      "duration_seconds": 6.09,
      "text": "Doctor, you know, it's cold feet. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.13,
      "end_seconds": 25.2,
      "duration_seconds": 4.07,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.51,
      "end_seconds": 36.55,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.91,
      "end_seconds": 63.92,
      "duration_seconds": 9.01,
      "text": "Okay: oxygen saturation is 99 percent, temperature 36.6, blood pressure 115 over 81. And pulse is 79 beats a minute."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.16,
      "end_seconds": 66.55,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.21,
      "end_seconds": 71.96,
      "duration_seconds": 4.75,
      "text": "I'll come back to the numbers. When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.6,
      "end_seconds": 80.24,
      "duration_seconds": 6.64,
      "text": "For two weeks, I'd say. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.68,
      "end_seconds": 84.61,
      "duration_seconds": 2.93,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.83,
      "end_seconds": 87.82,
      "duration_seconds": 1.99,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.66,
      "end_seconds": 93.27,
      "duration_seconds": 4.61,
      "text": "What about a slow-healing toe sore, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.32,
      "end_seconds": 96.46,
      "duration_seconds": 1.14,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.74,
      "end_seconds": 102.24,
      "duration_seconds": 4.5,
      "text": "A few quick ones: chest pain, fever or pain at rest?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.31,
      "end_seconds": 109.35,
      "duration_seconds": 5.04,
      "text": "No, no chest pain, fever or pain at rest."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.68,
      "end_seconds": 111.35,
      "duration_seconds": 1.67,
      "text": "Yes. Any back pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.27,
      "end_seconds": 116.13,
      "duration_seconds": 3.86,
      "text": "Not that I've noticed, no back pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.22,
      "end_seconds": 122.65,
      "duration_seconds": 4.43,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.8,
      "end_seconds": 128.95,
      "duration_seconds": 2.15,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.02,
      "end_seconds": 133.52,
      "duration_seconds": 2.5,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.11,
      "end_seconds": 137.65,
      "duration_seconds": 2.54,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.59,
      "end_seconds": 154.59,
      "duration_seconds": 5.0,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.67,
      "end_seconds": 158.68,
      "duration_seconds": 3.01,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.98,
      "end_seconds": 179.78,
      "duration_seconds": 2.8,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.13,
      "end_seconds": 194.08,
      "duration_seconds": 12.95,
      "text": "I'm a bus driver, so I sit for long hours. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.34,
      "end_seconds": 199.0,
      "duration_seconds": 3.66,
      "text": "So, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.83,
      "end_seconds": 202.46,
      "duration_seconds": 1.63,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 208.04,
      "duration_seconds": 4.61,
      "text": "So, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.95,
      "end_seconds": 213.87,
      "duration_seconds": 3.92,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.56,
      "end_seconds": 217.62,
      "duration_seconds": 2.06,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.64,
      "end_seconds": 225.01,
      "duration_seconds": 4.37,
      "text": "No, um, I've never been operated on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.9,
      "end_seconds": 228.9,
      "duration_seconds": 2.0,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.21,
      "end_seconds": 232.26,
      "duration_seconds": 2.05,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.61,
      "end_seconds": 251.22,
      "duration_seconds": 6.61,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.33,
      "end_seconds": 257.22,
      "duration_seconds": 2.89,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.87,
      "end_seconds": 288.4,
      "duration_seconds": 12.53,
      "text": "So where does that leave us? It's hard to say. Peripheral arterial disease is one possibility and a nerve problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.93,
      "end_seconds": 291.16,
      "duration_seconds": 2.23,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.26,
      "end_seconds": 308.66,
      "duration_seconds": 15.4,
      "text": "Nothing I've seen today points to an emergency. It looks like peripheral arterial disease. I think the vascular clinic should see you too. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.23,
      "end_seconds": 310.93,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.7,
      "end_seconds": 317.5,
      "duration_seconds": 4.8,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.87,
      "end_seconds": 321.62,
      "duration_seconds": 2.75,
      "text": "Right, alright, thanks, take care."
    }
  ]
}