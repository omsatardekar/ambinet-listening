{
  "schema_version": "1.0",
  "encounter_id": "02149",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 5.81,
      "duration_seconds": 4.98,
      "text": "Erm, uh, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.64,
      "end_seconds": 11.01,
      "duration_seconds": 4.37,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.76,
      "end_seconds": 14.72,
      "duration_seconds": 2.96,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 23.33,
      "duration_seconds": 4.13,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.74,
      "end_seconds": 32.93,
      "duration_seconds": 5.19,
      "text": "I'm here because of a hot red swollen big toe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 37.75,
      "duration_seconds": 2.9,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.36,
      "end_seconds": 41.23,
      "duration_seconds": 2.87,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.68,
      "end_seconds": 53.19,
      "duration_seconds": 10.51,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.47,
      "end_seconds": 71.18,
      "duration_seconds": 16.71,
      "text": "Ice helps a bit. Touch definitely sets it off. Oh, and pain that woke me. That's been about the same, three days. About pain that woke me, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 94.29,
      "duration_seconds": 4.19,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.9,
      "end_seconds": 98.41,
      "duration_seconds": 2.51,
      "text": "Gout, for nearly five years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.11,
      "end_seconds": 106.31,
      "duration_seconds": 6.2,
      "text": "Okay, I can see gout in your file as well. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.16,
      "end_seconds": 111.65,
      "duration_seconds": 3.49,
      "text": "Febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.62,
      "end_seconds": 115.16,
      "duration_seconds": 2.54,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.7,
      "end_seconds": 117.19,
      "duration_seconds": 1.49,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.9,
      "end_seconds": 120.84,
      "duration_seconds": 2.94,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.51,
      "end_seconds": 126.34,
      "duration_seconds": 4.83,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.18,
      "end_seconds": 130.1,
      "duration_seconds": 2.92,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.01,
      "end_seconds": 146.03,
      "duration_seconds": 15.02,
      "text": "Nothing, I'm teetotal. No, I've never smoked in my life. I do a yoga class on Thursdays. I work in accounts at a hospital. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.81,
      "end_seconds": 152.43,
      "duration_seconds": 4.62,
      "text": "So, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.25,
      "end_seconds": 158.15,
      "duration_seconds": 3.9,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.8,
      "end_seconds": 163.26,
      "duration_seconds": 3.46,
      "text": "A few quick ones: rash, fever or injury?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.15,
      "end_seconds": 169.76,
      "duration_seconds": 4.61,
      "text": "I haven't had rash, fever or injury, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.72,
      "end_seconds": 172.79,
      "duration_seconds": 2.07,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.03,
      "end_seconds": 175.69,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.57,
      "end_seconds": 186.53,
      "duration_seconds": 1.96,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.39,
      "end_seconds": 200.25,
      "duration_seconds": 2.86,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.44,
      "end_seconds": 227.02,
      "duration_seconds": 7.58,
      "text": "Okay: saturation 97 percent, temperature 36.5, respiratory rate 17, blood pressure 110 over 72, heart rate 77."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.31,
      "end_seconds": 230.42,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.43,
      "end_seconds": 239.01,
      "duration_seconds": 1.58,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.18,
      "end_seconds": 242.64,
      "duration_seconds": 2.46,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.18,
      "end_seconds": 263.72,
      "duration_seconds": 5.54,
      "text": "The big toe joint is red, hot, swollen and exquisitely tender."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.87,
      "end_seconds": 285.68,
      "duration_seconds": 17.81,
      "text": "You can relax now. I'll request a uric acid blood test, it'll help with gout. I'd like to arrange kidney function tests for gout treatment. I'd like you to take naproxen, 500 milligrams, twice a day with food, five days. It's for gout flare."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.38,
      "end_seconds": 287.85,
      "duration_seconds": 1.47,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.51,
      "end_seconds": 296.64,
      "duration_seconds": 7.13,
      "text": "Rest the foot, ice it, and drink plenty of water; limit beer and red meat."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.21,
      "end_seconds": 305.48,
      "duration_seconds": 8.27,
      "text": "I see, go ahead. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.48,
      "end_seconds": 309.09,
      "duration_seconds": 2.61,
      "text": "Well, thank you, that's clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.05,
      "end_seconds": 316.1,
      "duration_seconds": 6.05,
      "text": "Come back in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.77,
      "end_seconds": 320.68,
      "duration_seconds": 2.91,
      "text": "So, thank you, doctor, goodbye."
    }
  ]
}