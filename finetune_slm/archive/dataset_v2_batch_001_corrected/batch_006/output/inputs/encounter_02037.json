{
  "schema_version": "1.0",
  "encounter_id": "02037",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 6.56,
      "duration_seconds": 5.49,
      "text": "Well, you know, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.98,
      "end_seconds": 15.21,
      "duration_seconds": 4.23,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.22,
      "end_seconds": 21.5,
      "duration_seconds": 5.28,
      "text": "So, um, I've been getting puffed climbing stairs, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.9,
      "end_seconds": 25.89,
      "duration_seconds": 2.99,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.7,
      "end_seconds": 28.25,
      "duration_seconds": 1.55,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.15,
      "end_seconds": 38.99,
      "duration_seconds": 8.84,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.68,
      "end_seconds": 64.96,
      "duration_seconds": 24.28,
      "text": "Hmm, only resting, and it's not much. Maybe a three out of ten on a bad day. My neighbour said I should get it looked at. There was a bit of a cough with exercise, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.14,
      "end_seconds": 74.18,
      "duration_seconds": 5.04,
      "text": "Have you been getting puffed climbing stairs at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.63,
      "end_seconds": 81.72,
      "duration_seconds": 6.09,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.35,
      "end_seconds": 87.21,
      "duration_seconds": 4.86,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.17,
      "end_seconds": 90.01,
      "duration_seconds": 1.84,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.67,
      "end_seconds": 105.59,
      "duration_seconds": 2.92,
      "text": "Okay, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.43,
      "end_seconds": 111.9,
      "duration_seconds": 5.47,
      "text": "Let me think, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.68,
      "end_seconds": 132.58,
      "duration_seconds": 4.9,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.64,
      "end_seconds": 138.69,
      "duration_seconds": 4.05,
      "text": "Not to my knowledge, you know, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.49,
      "end_seconds": 146.77,
      "duration_seconds": 3.28,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.37,
      "end_seconds": 151.88,
      "duration_seconds": 3.51,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.78,
      "end_seconds": 156.96,
      "duration_seconds": 4.18,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.5,
      "end_seconds": 164.58,
      "duration_seconds": 4.08,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.93,
      "end_seconds": 167.5,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.57,
      "end_seconds": 171.48,
      "duration_seconds": 2.91,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.27,
      "end_seconds": 177.49,
      "duration_seconds": 4.22,
      "text": "Have you had any chest pain, fainting or wheeze?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.09,
      "end_seconds": 183.16,
      "duration_seconds": 5.07,
      "text": "No chest pain, fainting or wheeze, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.23,
      "end_seconds": 187.14,
      "duration_seconds": 1.91,
      "text": "Any sign of palpitations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.68,
      "end_seconds": 193.45,
      "duration_seconds": 1.77,
      "text": "Definitely no palpitations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.46,
      "end_seconds": 198.47,
      "duration_seconds": 3.01,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 200.4,
      "duration_seconds": 1.09,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 205.98,
      "duration_seconds": 3.6,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.21,
      "end_seconds": 221.51,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.22,
      "end_seconds": 243.44,
      "duration_seconds": 9.22,
      "text": "Okay: respiratory rate 15, temp 36.7 degrees. And heart rate 67, BP is 113 over 81, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.07,
      "end_seconds": 246.86,
      "duration_seconds": 1.79,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.04,
      "end_seconds": 254.11,
      "duration_seconds": 3.07,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.63,
      "end_seconds": 259.83,
      "duration_seconds": 4.2,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.05,
      "end_seconds": 262.95,
      "duration_seconds": 1.9,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.84,
      "end_seconds": 267.34,
      "duration_seconds": 2.5,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.13,
      "end_seconds": 290.4,
      "duration_seconds": 7.27,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.82,
      "end_seconds": 307.52,
      "duration_seconds": 12.7,
      "text": "You can sit up now. Okay, so my impression is this: I don't have a clear answer today: breathlessness from low fitness is possible, and so is mild asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.21,
      "end_seconds": 311.58,
      "duration_seconds": 3.37,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.19,
      "end_seconds": 319.94,
      "duration_seconds": 7.75,
      "text": "It's reasonable to be concerned, but right now breathlessness from low fitness is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.91,
      "end_seconds": 334.78,
      "duration_seconds": 4.87,
      "text": "A peak flow is what I'd like next, for exertional cough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 335.5,
      "end_seconds": 338.59,
      "duration_seconds": 3.09,
      "text": "The earliest is Friday, 11:30 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.52,
      "end_seconds": 340.49,
      "duration_seconds": 0.97,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.9,
      "end_seconds": 351.47,
      "duration_seconds": 9.57,
      "text": "Build up to thirty minutes of brisk walking five days a week. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.12,
      "end_seconds": 359.4,
      "duration_seconds": 3.28,
      "text": "Okay, you know, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.01,
      "end_seconds": 366.71,
      "duration_seconds": 5.7,
      "text": "I'd like you back in eight weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.24,
      "end_seconds": 369.14,
      "duration_seconds": 1.9,
      "text": "That's clear, thanks."
    }
  ]
}