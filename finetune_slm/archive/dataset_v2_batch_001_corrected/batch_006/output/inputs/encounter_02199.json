{
  "schema_version": "1.0",
  "encounter_id": "02199",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.34,
      "duration_seconds": 4.08,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 10.72,
      "duration_seconds": 4.3,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.28,
      "end_seconds": 17.89,
      "duration_seconds": 5.61,
      "text": "I wanted to get a back that has got shorter looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.71,
      "end_seconds": 22.57,
      "duration_seconds": 2.86,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.64,
      "end_seconds": 28.45,
      "duration_seconds": 3.81,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.54,
      "end_seconds": 33.99,
      "duration_seconds": 3.45,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.01,
      "end_seconds": 36.74,
      "duration_seconds": 1.73,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.64,
      "end_seconds": 41.84,
      "duration_seconds": 3.2,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.71,
      "end_seconds": 67.01,
      "duration_seconds": 23.3,
      "text": "A wrist broken in a slip goes along with it, most of the time. And there's a dull ache in my back as well, three weeks now. As for dull ache in my back, a eight out of ten, I suppose. It's on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.77,
      "end_seconds": 73.28,
      "duration_seconds": 4.51,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.54,
      "end_seconds": 83.7,
      "duration_seconds": 9.16,
      "text": "I have thin bones, for five years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.95,
      "end_seconds": 87.47,
      "duration_seconds": 2.52,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.47,
      "end_seconds": 92.36,
      "duration_seconds": 3.89,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.4,
      "end_seconds": 96.37,
      "duration_seconds": 2.97,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.68,
      "end_seconds": 100.87,
      "duration_seconds": 3.19,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.62,
      "end_seconds": 104.84,
      "duration_seconds": 2.22,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.01,
      "end_seconds": 110.09,
      "duration_seconds": 4.08,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.03,
      "end_seconds": 116.9,
      "duration_seconds": 4.87,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.12,
      "end_seconds": 120.29,
      "duration_seconds": 2.17,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.69,
      "end_seconds": 133.3,
      "duration_seconds": 4.61,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.24,
      "end_seconds": 140.25,
      "duration_seconds": 5.01,
      "text": "Um, I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.42,
      "end_seconds": 142.65,
      "duration_seconds": 1.23,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.49,
      "end_seconds": 146.83,
      "duration_seconds": 3.34,
      "text": "Yeah, not at all, no fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.27,
      "end_seconds": 152.45,
      "duration_seconds": 4.18,
      "text": "A few quick ones: weight loss, bladder problems or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.46,
      "end_seconds": 159.27,
      "duration_seconds": 5.81,
      "text": "No weight loss, bladder problems or numbness, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.21,
      "end_seconds": 163.11,
      "duration_seconds": 2.9,
      "text": "Alright, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.62,
      "end_seconds": 166.44,
      "duration_seconds": 1.82,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.08,
      "end_seconds": 168.69,
      "duration_seconds": 1.61,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.12,
      "end_seconds": 171.63,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.68,
      "end_seconds": 181.15,
      "duration_seconds": 2.47,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.62,
      "end_seconds": 191.97,
      "duration_seconds": 3.35,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.01,
      "end_seconds": 219.68,
      "duration_seconds": 12.67,
      "text": "Okay: height 154 centimetres, oxygen saturation is 97 percent, BMI works out to 37.1. And pressure 127 over 77, pulse is 70 beats a minute, weight 88 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.51,
      "end_seconds": 222.2,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.42,
      "end_seconds": 227.53,
      "duration_seconds": 4.11,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.47,
      "end_seconds": 232.25,
      "duration_seconds": 2.78,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.09,
      "end_seconds": 236.23,
      "duration_seconds": 2.14,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.53,
      "end_seconds": 250.59,
      "duration_seconds": 7.06,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.57,
      "end_seconds": 260.82,
      "duration_seconds": 1.25,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.22,
      "end_seconds": 267.94,
      "duration_seconds": 4.72,
      "text": "Please sit back down. Let's get blood tests, for osteoporosis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 269.3,
      "end_seconds": 271.94,
      "duration_seconds": 2.64,
      "text": "The earliest is Tuesday, 11:30 am."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.64,
      "end_seconds": 276.15,
      "duration_seconds": 2.51,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.18,
      "end_seconds": 297.9,
      "duration_seconds": 19.72,
      "text": "I want a bone density scan done, that's for osteoporosis. Take the tablet with a full glass of water, and stay upright for thirty minutes. Please take the tablets with food so they don't upset your stomach. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.67,
      "end_seconds": 303.59,
      "duration_seconds": 3.92,
      "text": "Um, I think I understand everything. Thanks."
    }
  ]
}