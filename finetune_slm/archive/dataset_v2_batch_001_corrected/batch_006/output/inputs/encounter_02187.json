{
  "schema_version": "1.0",
  "encounter_id": "02187",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 6.43,
      "duration_seconds": 5.78,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 12.87,
      "duration_seconds": 4.81,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.49,
      "end_seconds": 22.47,
      "duration_seconds": 4.98,
      "text": "I'm here because of a fever for two weeks"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.75,
      "end_seconds": 25.37,
      "duration_seconds": 1.62,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.4,
      "end_seconds": 31.11,
      "duration_seconds": 3.71,
      "text": "I mean, for two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 35.83,
      "duration_seconds": 2.73,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.54,
      "end_seconds": 39.99,
      "duration_seconds": 2.45,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.8,
      "end_seconds": 44.9,
      "duration_seconds": 4.1,
      "text": "So, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.41,
      "end_seconds": 50.81,
      "duration_seconds": 4.4,
      "text": "yeah, about a five out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.81,
      "end_seconds": 59.66,
      "duration_seconds": 2.85,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.03,
      "end_seconds": 77.74,
      "duration_seconds": 16.71,
      "text": "Night sweats goes along with it, uh, most of the time. Well, the Night sweats? That's been for three weeks. Hmm, um, about Night sweats, it feels severe to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.03,
      "end_seconds": 78.73,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.72,
      "end_seconds": 90.42,
      "duration_seconds": 6.7,
      "text": "Oh, and tiredness. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.83,
      "end_seconds": 110.73,
      "duration_seconds": 2.9,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.75,
      "end_seconds": 115.43,
      "duration_seconds": 3.68,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.59,
      "end_seconds": 131.88,
      "duration_seconds": 2.29,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.58,
      "end_seconds": 135.07,
      "duration_seconds": 2.49,
      "text": "Migraines, for two years"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.38,
      "end_seconds": 144.32,
      "duration_seconds": 7.94,
      "text": "Okay, I can see migraines in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.93,
      "end_seconds": 150.92,
      "duration_seconds": 5.99,
      "text": "Sumatriptan. I take it 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 159.17,
      "duration_seconds": 2.99,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.06,
      "end_seconds": 163.09,
      "duration_seconds": 2.03,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.16,
      "end_seconds": 169.15,
      "duration_seconds": 4.99,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.73,
      "end_seconds": 183.13,
      "duration_seconds": 13.4,
      "text": "I retired from the post office two years ago. No, I share a house with my brother. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.75,
      "end_seconds": 188.0,
      "duration_seconds": 4.25,
      "text": "Did you get cough, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.51,
      "end_seconds": 194.34,
      "duration_seconds": 5.83,
      "text": "no cough, chest pain or weight loss, none of it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.02,
      "end_seconds": 199.41,
      "duration_seconds": 3.39,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.15,
      "end_seconds": 201.84,
      "duration_seconds": 1.69,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.44,
      "end_seconds": 206.37,
      "duration_seconds": 2.93,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.0,
      "end_seconds": 222.53,
      "duration_seconds": 2.53,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.57,
      "end_seconds": 252.83,
      "duration_seconds": 9.26,
      "text": "Okay: BP is 111 over 80, heart rate 108, respiratory rate 21, temp 38.0 degrees, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.63,
      "end_seconds": 258.57,
      "duration_seconds": 3.94,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 260.82,
      "duration_seconds": 1.41,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.65,
      "end_seconds": 278.03,
      "duration_seconds": 9.38,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.71,
      "end_seconds": 301.3,
      "duration_seconds": 17.59,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. I'd lean towards possible infective endocarditis. Stop me if I've got anything wrong. You've had a fever for two weeks for two days, and no chest pain or cough."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.47,
      "end_seconds": 304.07,
      "duration_seconds": 1.6,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.69,
      "end_seconds": 324.76,
      "duration_seconds": 19.07,
      "text": "I'm sending you for blood tests because of prolonged fever. You need admission today for blood cultures and a heart scan. I'd like you to see the cardiology team as well, and I'll write the referral. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.5,
      "end_seconds": 327.02,
      "duration_seconds": 1.52,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.88,
      "end_seconds": 336.72,
      "duration_seconds": 7.84,
      "text": "Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.37,
      "end_seconds": 340.08,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.17,
      "end_seconds": 342.77,
      "duration_seconds": 1.6,
      "text": "Have a good day."
    }
  ]
}