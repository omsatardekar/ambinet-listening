{
  "schema_version": "1.0",
  "encounter_id": "02224",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 3.87,
      "duration_seconds": 3.29,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.58,
      "end_seconds": 9.1,
      "duration_seconds": 4.52,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.09,
      "end_seconds": 16.5,
      "duration_seconds": 5.41,
      "text": "I'm here because of a chronic cough with lots of phlegm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.87,
      "end_seconds": 20.64,
      "duration_seconds": 2.77,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.21,
      "end_seconds": 25.76,
      "duration_seconds": 3.55,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 35.93,
      "duration_seconds": 8.78,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.37,
      "end_seconds": 42.99,
      "duration_seconds": 5.62,
      "text": "I'd say every other day. I get some relief from chest physio."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.03,
      "end_seconds": 49.63,
      "duration_seconds": 1.6,
      "text": "Any tiredness as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.27,
      "end_seconds": 54.42,
      "duration_seconds": 3.15,
      "text": "Yeah. About a week, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.81,
      "end_seconds": 58.62,
      "duration_seconds": 2.81,
      "text": "Have you been getting out of breath?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.22,
      "end_seconds": 70.78,
      "duration_seconds": 11.56,
      "text": "Yes, about the same, two weeks. With getting out of breath, I'd give it a four, out of ten. Honestly, on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.94,
      "end_seconds": 91.97,
      "duration_seconds": 5.03,
      "text": "Have you noticed fever, weight loss, chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.43,
      "end_seconds": 100.63,
      "duration_seconds": 7.2,
      "text": "I haven't had fever, weight loss, chest pain or coughing up blood, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.38,
      "end_seconds": 105.45,
      "duration_seconds": 3.07,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.49,
      "end_seconds": 107.92,
      "duration_seconds": 1.43,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.48,
      "end_seconds": 110.64,
      "duration_seconds": 2.16,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.71,
      "end_seconds": 114.52,
      "duration_seconds": 2.81,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.76,
      "end_seconds": 121.48,
      "duration_seconds": 2.72,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.07,
      "end_seconds": 126.78,
      "duration_seconds": 3.71,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.84,
      "end_seconds": 131.58,
      "duration_seconds": 2.74,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.2,
      "end_seconds": 135.56,
      "duration_seconds": 3.36,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.76,
      "end_seconds": 142.63,
      "duration_seconds": 5.87,
      "text": "I follow. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.57,
      "end_seconds": 153.65,
      "duration_seconds": 9.08,
      "text": "I'm a hairdresser, on my feet all day. I do a yoga class on Thursdays. My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.57,
      "end_seconds": 160.88,
      "duration_seconds": 2.31,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.84,
      "end_seconds": 168.21,
      "duration_seconds": 5.37,
      "text": "Oh, I take naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.4,
      "end_seconds": 172.38,
      "duration_seconds": 2.98,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.28,
      "end_seconds": 174.69,
      "duration_seconds": 1.41,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.08,
      "end_seconds": 179.98,
      "duration_seconds": 4.9,
      "text": "Yes, carry on. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.86,
      "end_seconds": 191.03,
      "duration_seconds": 9.17,
      "text": "I had a reaction to amoxicillin when I was younger, hives, and I've avoided it since."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.84,
      "end_seconds": 211.89,
      "duration_seconds": 3.05,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.19,
      "end_seconds": 224.74,
      "duration_seconds": 2.55,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.95,
      "end_seconds": 249.46,
      "duration_seconds": 12.51,
      "text": "Okay: pulse is 69 beats a minute, blood pressure 124 over 82. And respiratory rate 18, temp 36.6 degrees, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 257.51,
      "duration_seconds": 5.44,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.43,
      "end_seconds": 276.49,
      "duration_seconds": 1.06,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.76,
      "end_seconds": 279.21,
      "duration_seconds": 1.45,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.51,
      "end_seconds": 294.16,
      "duration_seconds": 5.65,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.0,
      "end_seconds": 295.99,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.32,
      "end_seconds": 330.22,
      "duration_seconds": 30.9,
      "text": "You can sit up now. Okay, thinking it through, this looks most like a flare of bronchiectasis. We shouldn't forget a chest infection. Let's get a chest X-ray, for bronchiectasis flare. What I'm giving you is clarithromycin, 500 milligrams, twice a day, fourteen days. You take it by mouth. That should help with bronchiectasis flare. Keep up your airway clearance exercises twice a day. I'm going to send a referral to the respiratory clinic."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.95,
      "end_seconds": 337.78,
      "duration_seconds": 5.83,
      "text": "I'd like you back in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.79,
      "end_seconds": 341.85,
      "duration_seconds": 3.06,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.13,
      "end_seconds": 344.44,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}