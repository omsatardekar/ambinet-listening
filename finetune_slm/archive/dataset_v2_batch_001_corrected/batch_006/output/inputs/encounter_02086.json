{
  "schema_version": "1.0",
  "encounter_id": "02086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 8.25,
      "duration_seconds": 6.87,
      "text": "Alright, hello, good to see you. Please sit. Did you find the place alright?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.64,
      "end_seconds": 16.09,
      "duration_seconds": 6.45,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.83,
      "end_seconds": 19.71,
      "duration_seconds": 1.88,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.02,
      "end_seconds": 24.42,
      "duration_seconds": 3.4,
      "text": "Well, I've been having constant worrying."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.58,
      "end_seconds": 28.73,
      "duration_seconds": 3.15,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.39,
      "end_seconds": 50.95,
      "duration_seconds": 17.56,
      "text": "About... well, ten days. I'd rather not end up on lots of tablets if I can avoid it. Yeah, um, there was a tight chest, yes, but that went away."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.4,
      "end_seconds": 68.31,
      "duration_seconds": 6.91,
      "text": "tell me about any past illnesses or ongoing conditions. I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.15,
      "end_seconds": 80.61,
      "duration_seconds": 11.46,
      "text": "yes, an underactive thyroid actually, you know, I have arthritis in my knees, for about a year yes, heart failure"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.58,
      "end_seconds": 92.05,
      "duration_seconds": 9.47,
      "text": "Alright, an underactive thyroid and arthritis in your knees, that matches what I have here. A A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.05,
      "end_seconds": 106.2,
      "duration_seconds": 12.15,
      "text": "I live with my elderly mother. Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.64,
      "end_seconds": 128.07,
      "duration_seconds": 3.43,
      "text": "Right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.68,
      "end_seconds": 133.27,
      "duration_seconds": 4.59,
      "text": "Well, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.96,
      "end_seconds": 141.92,
      "duration_seconds": 6.96,
      "text": "are you taking anything regularly, including from the pharmacy? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 158.18,
      "duration_seconds": 15.68,
      "text": "Erm, uh, it's Eltroxin, 100 micrograms, every morning. I'm on paracetamol, 650 milligrams, when needed for the knee pain. I take carvedilol, 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.77,
      "end_seconds": 162.68,
      "duration_seconds": 2.91,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.43,
      "end_seconds": 169.5,
      "duration_seconds": 2.07,
      "text": "about about a year"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.47,
      "end_seconds": 177.3,
      "duration_seconds": 6.83,
      "text": "Let me check a few things. Any chest pain on exertion or drinking more?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.19,
      "end_seconds": 185.24,
      "duration_seconds": 4.05,
      "text": "No, uh, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.25,
      "end_seconds": 194.96,
      "duration_seconds": 5.71,
      "text": "Alright, have you had any weight loss or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.51,
      "end_seconds": 199.96,
      "duration_seconds": 4.45,
      "text": "no, uh, none of those at all"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.25,
      "end_seconds": 205.68,
      "duration_seconds": 5.43,
      "text": "Mm, okay. Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.55,
      "end_seconds": 208.34,
      "duration_seconds": 1.79,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.25,
      "end_seconds": 210.81,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.61,
      "end_seconds": 213.3,
      "duration_seconds": 1.69,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.44,
      "end_seconds": 218.01,
      "duration_seconds": 3.57,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.05,
      "end_seconds": 231.05,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.82,
      "end_seconds": 253.45,
      "duration_seconds": 8.63,
      "text": "Okay: temp 36.9 degrees, SpO2 99 percent on room air, pulse 68, pressure 111 over 78."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 258.76,
      "duration_seconds": 3.71,
      "text": "Could you come over to the the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.55,
      "end_seconds": 271.25,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.52,
      "end_seconds": 273.74,
      "duration_seconds": 1.22,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.18,
      "end_seconds": 295.55,
      "duration_seconds": 5.37,
      "text": "Your heart sounds are normal and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.73,
      "end_seconds": 314.38,
      "duration_seconds": 13.65,
      "text": "Good, you can sit up again. So, based on the history and the examination, I'm honestly not certain yet. It could be generalised anxiety, or it might be an overactive thyroid."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.38,
      "end_seconds": 320.31,
      "duration_seconds": 3.93,
      "text": "Is it dangerous, you know, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.67,
      "end_seconds": 336.71,
      "duration_seconds": 15.04,
      "text": "I understand the worry. At the moment I'd say it's generalised anxiety, and we'll watch how it goes. Today I'm not changing anything. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.56,
      "end_seconds": 343.0,
      "duration_seconds": 4.44,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}