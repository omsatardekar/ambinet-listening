{
  "schema_version": "1.0",
  "encounter_id": "02405",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.78,
      "duration_seconds": 3.13,
      "text": "morning, doctor lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.39,
      "end_seconds": 12.54,
      "duration_seconds": 5.15,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.42,
      "end_seconds": 19.67,
      "duration_seconds": 5.25,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.6,
      "end_seconds": 25.21,
      "duration_seconds": 3.61,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.01,
      "end_seconds": 32.64,
      "duration_seconds": 6.63,
      "text": "Oh, honestly, it's being very breathless, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.37,
      "end_seconds": 40.56,
      "duration_seconds": 3.19,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.26,
      "end_seconds": 50.99,
      "duration_seconds": 7.73,
      "text": "ah, I'd say about three months actually, no, closer to about a month"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.94,
      "end_seconds": 54.17,
      "duration_seconds": 2.23,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.03,
      "end_seconds": 58.74,
      "duration_seconds": 2.71,
      "text": "Lying flat definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.06,
      "end_seconds": 61.68,
      "duration_seconds": 2.62,
      "text": "I follow. Does anything help it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.58,
      "end_seconds": 66.76,
      "duration_seconds": 3.18,
      "text": "it settles a little with sitting up"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.4,
      "end_seconds": 71.39,
      "duration_seconds": 2.99,
      "text": "How much does it it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.6,
      "end_seconds": 77.2,
      "duration_seconds": 4.6,
      "text": "Okay, so pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.39,
      "end_seconds": 80.78,
      "duration_seconds": 2.39,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.38,
      "end_seconds": 90.55,
      "duration_seconds": 5.17,
      "text": "it happens every other day yeah, I've also been sweating"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.19,
      "end_seconds": 94.68,
      "duration_seconds": 3.49,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.08,
      "end_seconds": 110.66,
      "duration_seconds": 2.58,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.14,
      "end_seconds": 133.05,
      "duration_seconds": 8.91,
      "text": "Okay: BP is 141 over 87, respiratory rate 26, saturation 91 percent. And pulse is 93 beats a minute."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.81,
      "end_seconds": 138.37,
      "duration_seconds": 3.56,
      "text": "Now I'm gonna do a short physical check."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.69,
      "end_seconds": 149.72,
      "duration_seconds": 1.03,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.93,
      "end_seconds": 153.37,
      "duration_seconds": 2.44,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.79,
      "end_seconds": 170.09,
      "duration_seconds": 7.3,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.36,
      "end_seconds": 178.06,
      "duration_seconds": 5.7,
      "text": "you can relax now have you noticed wheeze, calf pain or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.13,
      "end_seconds": 183.02,
      "duration_seconds": 2.89,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.87,
      "end_seconds": 186.83,
      "duration_seconds": 2.96,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.46,
      "end_seconds": 188.84,
      "duration_seconds": 1.38,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.55,
      "end_seconds": 210.71,
      "duration_seconds": 4.16,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.66,
      "end_seconds": 220.37,
      "duration_seconds": 5.71,
      "text": "Heart failure, for about ten years. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.2,
      "end_seconds": 227.28,
      "duration_seconds": 5.08,
      "text": "Alright, high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.89,
      "end_seconds": 242.3,
      "duration_seconds": 1.41,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.66,
      "end_seconds": 247.45,
      "duration_seconds": 3.79,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.66,
      "end_seconds": 254.07,
      "duration_seconds": 1.41,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.27,
      "end_seconds": 258.12,
      "duration_seconds": 2.85,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.79,
      "end_seconds": 260.68,
      "duration_seconds": 1.89,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.42,
      "end_seconds": 266.22,
      "duration_seconds": 3.8,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.17,
      "end_seconds": 269.28,
      "duration_seconds": 2.11,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.88,
      "end_seconds": 273.81,
      "duration_seconds": 3.93,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.61,
      "end_seconds": 277.02,
      "duration_seconds": 2.41,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.34,
      "end_seconds": 282.42,
      "duration_seconds": 4.08,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.87,
      "end_seconds": 289.54,
      "duration_seconds": 3.67,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 291.53,
      "end_seconds": 296.49,
      "duration_seconds": 4.96,
      "text": "She takes spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.55,
      "end_seconds": 300.5,
      "duration_seconds": 2.95,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.53,
      "end_seconds": 310.53,
      "duration_seconds": 8.0,
      "text": "About three months now she is on ramipril, 5 milligrams, every morning, I give it to her"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.43,
      "end_seconds": 319.84,
      "duration_seconds": 8.41,
      "text": "Okay, so my impression is this: I'd lean towards acute pulmonary oedema. I'd also keep a severe chest infection in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.93,
      "end_seconds": 325.08,
      "duration_seconds": 4.15,
      "text": "okay, so I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.26,
      "end_seconds": 347.58,
      "duration_seconds": 21.32,
      "text": "I understand the worry. At the moment I'd say it's acute pulmonary oedema, and we'll know more once the blood tests is back. I want blood tests done, that's for pulmonary oedema. The result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.09,
      "end_seconds": 350.43,
      "duration_seconds": 1.34,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.85,
      "end_seconds": 360.16,
      "duration_seconds": 5.31,
      "text": "I think a chest X-ray makes sense here, for pulmonary oedema"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.24,
      "end_seconds": 362.61,
      "duration_seconds": 1.37,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.31,
      "end_seconds": 371.27,
      "duration_seconds": 7.96,
      "text": "Sit upright, I am giving oxygen and a water tablet injection now. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.4,
      "end_seconds": 373.1,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.03,
      "end_seconds": 379.05,
      "duration_seconds": 5.02,
      "text": "Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.97,
      "end_seconds": 383.4,
      "duration_seconds": 2.43,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.02,
      "end_seconds": 385.4,
      "duration_seconds": 1.38,
      "text": "All the best."
    }
  ]
}