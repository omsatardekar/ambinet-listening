      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.26,
      "end_seconds": 294.22,
      "duration_seconds": 9.96,
      "text": "Right, here's what I'm thinking. I'm honestly not certain yet. It could be allergic conjunctivitis, or it might be infective conjunctivitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.08,
      "end_seconds": 298.08,
      "duration_seconds": 2.0,
      "text": "is this serious, doctor?"
    },
