      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.27,
      "end_seconds": 213.89,
      "duration_seconds": 11.62,
      "text": "I grab fast food at lunch most days. I'm a hairdresser, on my feet all day. My husband and I live above the shop."
