      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.67,
      "end_seconds": 269.19,
      "duration_seconds": 2.52,
      "text": "okay, that's enough for me"
