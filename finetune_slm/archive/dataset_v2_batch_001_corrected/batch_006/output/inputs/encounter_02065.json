{
  "schema_version": "1.0",
  "encounter_id": "02065",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.78,
      "duration_seconds": 4.63,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 12.29,
      "duration_seconds": 4.57,
      "text": "Alright, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.1,
      "end_seconds": 26.12,
      "duration_seconds": 12.02,
      "text": "It's brain fog. I thought I'd wait, uh, but it hasn't gone. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.13,
      "end_seconds": 31.38,
      "duration_seconds": 3.25,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.92,
      "end_seconds": 45.71,
      "duration_seconds": 12.79,
      "text": "Pretty severe, if I'm being honest. I've also had extreme tiredness, for two months. I've also had breathlessness months after the infection, for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.72,
      "end_seconds": 52.49,
      "duration_seconds": 2.77,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.65,
      "end_seconds": 65.49,
      "duration_seconds": 11.84,
      "text": "Pretty severe, if I'm being honest. Actually, there was a racing heart on standing, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.31,
      "end_seconds": 71.57,
      "duration_seconds": 5.26,
      "text": "any chest pain, coughing up blood or leg swelling at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.47,
      "end_seconds": 79.2,
      "duration_seconds": 5.73,
      "text": "no, no chest pain, coughing up blood or leg swelling"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.11,
      "end_seconds": 84.16,
      "duration_seconds": 3.05,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.72,
      "end_seconds": 87.38,
      "duration_seconds": 1.66,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.66,
      "end_seconds": 92.71,
      "duration_seconds": 2.05,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.22,
      "end_seconds": 97.94,
      "duration_seconds": 3.72,
      "text": "No, you know, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.88,
      "end_seconds": 102.26,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.96,
      "end_seconds": 116.17,
      "duration_seconds": 13.21,
      "text": "I take ramipril, 5 milligrams, every morning. I do miss it now and then, to be fair. Clopidogrel. I take it once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.41,
      "end_seconds": 119.56,
      "duration_seconds": 2.15,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.71,
      "end_seconds": 122.34,
      "duration_seconds": 1.63,
      "text": "it's 75 milligrams"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.5,
      "end_seconds": 128.46,
      "duration_seconds": 1.96,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.1,
      "end_seconds": 132.28,
      "duration_seconds": 3.18,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.57,
      "end_seconds": 134.9,
      "duration_seconds": 1.33,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.77,
      "end_seconds": 138.7,
      "duration_seconds": 2.93,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.77,
      "end_seconds": 142.6,
      "duration_seconds": 2.83,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.9,
      "end_seconds": 147.88,
      "duration_seconds": 3.98,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.87,
      "end_seconds": 151.59,
      "duration_seconds": 2.72,
      "text": "right, is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.56,
      "end_seconds": 158.3,
      "duration_seconds": 4.74,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.09,
      "end_seconds": 166.02,
      "duration_seconds": 2.93,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.71,
      "end_seconds": 171.22,
      "duration_seconds": 3.51,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.6,
      "end_seconds": 177.94,
      "duration_seconds": 5.34,
      "text": "so, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.86,
      "end_seconds": 185.98,
      "duration_seconds": 7.12,
      "text": "I have thin bones, for nearly five years. High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.96,
      "end_seconds": 188.9,
      "duration_seconds": 1.94,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.6,
      "end_seconds": 193.32,
      "duration_seconds": 3.72,
      "text": "I have heart disease, for five years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.77,
      "end_seconds": 201.27,
      "duration_seconds": 6.5,
      "text": "Yes, high blood pressure and heart disease are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.82,
      "end_seconds": 214.55,
      "duration_seconds": 4.73,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.24,
      "end_seconds": 219.74,
      "duration_seconds": 3.5,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.43,
      "end_seconds": 226.22,
      "duration_seconds": 3.79,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.55,
      "end_seconds": 240.32,
      "duration_seconds": 2.77,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.83,
      "end_seconds": 269.02,
      "duration_seconds": 12.19,
      "text": "Okay: respiratory rate 17, heart rate 71, saturation 99 percent. And pressure 122 over 70, temperature is 36.4 degrees, height 184 centimetres, weight 80 kilos."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.18,
      "end_seconds": 275.02,
      "duration_seconds": 1.84,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.96,
      "end_seconds": 278.38,
      "duration_seconds": 2.42,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.6,
      "end_seconds": 284.27,
      "duration_seconds": 4.67,
      "text": "I'll examine you in a a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.4,
      "end_seconds": 288.3,
      "duration_seconds": 2.9,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.86,
      "end_seconds": 307.73,
      "duration_seconds": 5.87,
      "text": "your oxygen is normal at rest and after walking and your chest is clear"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.34,
      "end_seconds": 315.81,
      "duration_seconds": 2.47,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.9,
      "end_seconds": 337.18,
      "duration_seconds": 14.28,
      "text": "okay, thinking it through, I'd lean towards post-viral symptoms after COVID. The reason I say that is that your story and my examination fit together. A thyroid problem is still possible"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.2,
      "end_seconds": 344.44,
      "duration_seconds": 5.24,
      "text": "Mm, um, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.35,
      "end_seconds": 354.25,
      "duration_seconds": 7.9,
      "text": "I can't promise yet, but most people with post-viral symptoms after COVID do well once it's treated properly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.55,
      "end_seconds": 370.5,
      "duration_seconds": 3.95,
      "text": "Let's book blood tests to look into post-viral fatigue."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 375.18,
      "end_seconds": 377.58,
      "duration_seconds": 2.4,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.4,
      "end_seconds": 404.94,
      "duration_seconds": 26.54,
      "text": "Let's book a chest X-ray to look into persistent breathlessness. Pace your activity and increase it slowly each week. If you smoke, this is a good moment to think about stopping, and we can help you with that. Do get help quickly if the symptoms get worse. Let's review you in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.53,
      "end_seconds": 411.56,
      "duration_seconds": 5.03,
      "text": "Let me think, no, that's all. Thanks a lot."
    }
  ]
}