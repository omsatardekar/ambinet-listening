{
  "schema_version": "1.0",
  "encounter_id": "02084",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.27,
      "end_seconds": 7.12,
      "duration_seconds": 5.85,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 12.4,
      "duration_seconds": 4.17,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.48,
      "end_seconds": 17.55,
      "duration_seconds": 4.07,
      "text": "It's spots on my forehead and chin, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.28,
      "end_seconds": 21.33,
      "duration_seconds": 2.05,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.12,
      "end_seconds": 24.77,
      "duration_seconds": 2.65,
      "text": "Nothing regular, uh, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.29,
      "end_seconds": 28.52,
      "duration_seconds": 3.23,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.03,
      "end_seconds": 32.52,
      "duration_seconds": 3.49,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.12,
      "end_seconds": 42.7,
      "duration_seconds": 9.58,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.69,
      "end_seconds": 58.25,
      "duration_seconds": 13.56,
      "text": "Moderate, I'd say. It's worse with before periods. I'm hoping you can tell me something definite. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.22,
      "end_seconds": 63.13,
      "duration_seconds": 2.91,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.58,
      "end_seconds": 81.25,
      "duration_seconds": 16.67,
      "text": "Oily skin goes along with it, most of the time. As for few blackheads, I honestly can't say when that began. It might have been last month or the month before"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.67,
      "end_seconds": 84.03,
      "duration_seconds": 1.36,
      "text": "Any irregular periods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.76,
      "end_seconds": 87.82,
      "duration_seconds": 2.06,
      "text": "No irregular periods, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.75,
      "end_seconds": 94.5,
      "duration_seconds": 4.75,
      "text": "a few quick ones: painful cysts, scarring or low mood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.78,
      "end_seconds": 103.93,
      "duration_seconds": 4.15,
      "text": "no, you know, not a single one"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.35,
      "end_seconds": 107.38,
      "duration_seconds": 2.03,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.69,
      "end_seconds": 110.26,
      "duration_seconds": 1.57,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.32,
      "end_seconds": 116.34,
      "duration_seconds": 4.02,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.45,
      "end_seconds": 120.34,
      "duration_seconds": 2.89,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.55,
      "end_seconds": 136.42,
      "duration_seconds": 2.87,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.52,
      "end_seconds": 154.13,
      "duration_seconds": 16.61,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I swim twice a week. I'm a plumber, lots of bending and kneeling. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.65,
      "end_seconds": 159.31,
      "duration_seconds": 3.66,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.04,
      "end_seconds": 162.83,
      "duration_seconds": 2.79,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.35,
      "end_seconds": 168.7,
      "duration_seconds": 4.35,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.59,
      "end_seconds": 172.37,
      "duration_seconds": 2.78,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.97,
      "end_seconds": 176.55,
      "duration_seconds": 3.58,
      "text": "Okay, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.1,
      "end_seconds": 185.61,
      "duration_seconds": 5.51,
      "text": "Erm, uh, I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.37,
      "end_seconds": 189.99,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.53,
      "end_seconds": 195.63,
      "duration_seconds": 5.1,
      "text": "Uh, I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.53,
      "end_seconds": 203.84,
      "duration_seconds": 7.31,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 205.15,
      "end_seconds": 217.14,
      "duration_seconds": 11.99,
      "text": "doctor, I've got the readings for you temperature is 36.8 degrees, blood pressure 112 over 80, saturation 99 percent pulse is 81 beats a a minute"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.91,
      "end_seconds": 220.38,
      "duration_seconds": 1.47,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.78,
      "end_seconds": 234.16,
      "duration_seconds": 4.38,
      "text": "Putting together what you've described, this is probably mild acne."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.19,
      "end_seconds": 239.41,
      "duration_seconds": 3.22,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.31,
      "end_seconds": 246.5,
      "duration_seconds": 5.19,
      "text": "nothing I've seen today points to an emergency it looks like mild acne"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.14,
      "end_seconds": 263.87,
      "duration_seconds": 7.73,
      "text": "I'm gonna put you on benzoyl peroxide gel, 5%, once a day, eight weeks. That's for acne."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.74,
      "end_seconds": 267.61,
      "duration_seconds": 2.87,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.5,
      "end_seconds": 282.48,
      "duration_seconds": 13.98,
      "text": "Wash gently twice a day and don't squeeze the spots. We'll catch up in eight weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.32,
      "end_seconds": 293.76,
      "duration_seconds": 9.44,
      "text": "So, I take the benzoyl peroxide gel, 5%, once a day and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.84,
      "end_seconds": 298.6,
      "duration_seconds": 3.76,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.3,
      "end_seconds": 304.32,
      "duration_seconds": 4.02,
      "text": "Mm, um, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.02,
      "end_seconds": 307.81,
      "duration_seconds": 1.79,
      "text": "have a good day"
    }
  ]
}