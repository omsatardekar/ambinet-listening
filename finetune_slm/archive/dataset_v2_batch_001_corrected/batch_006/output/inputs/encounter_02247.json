{
  "schema_version": "1.0",
  "encounter_id": "02247",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 5.96,
      "duration_seconds": 5.29,
      "text": "Doctor? Hello, uh, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 11.89,
      "duration_seconds": 4.52,
      "text": "Okay, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.92,
      "end_seconds": 19.77,
      "duration_seconds": 5.85,
      "text": "Well, um, I've been having my face drooping on the right."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.54,
      "end_seconds": 24.06,
      "duration_seconds": 3.52,
      "text": "Alright, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.64,
      "end_seconds": 28.08,
      "duration_seconds": 3.44,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.24,
      "end_seconds": 48.31,
      "duration_seconds": 3.07,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.31,
      "end_seconds": 58.51,
      "duration_seconds": 8.2,
      "text": "About... well, about a month. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.8,
      "end_seconds": 62.64,
      "duration_seconds": 3.84,
      "text": "Ah. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.5,
      "end_seconds": 67.2,
      "duration_seconds": 2.7,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.35,
      "end_seconds": 87.73,
      "duration_seconds": 6.38,
      "text": "Let me check a few things. Any rash in the ear, headache or slurred speech?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.37,
      "end_seconds": 91.16,
      "duration_seconds": 2.79,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.77,
      "end_seconds": 97.24,
      "duration_seconds": 4.47,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.12,
      "end_seconds": 101.05,
      "duration_seconds": 2.93,
      "text": "Um, no, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 106.32,
      "duration_seconds": 4.75,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.84,
      "end_seconds": 113.91,
      "duration_seconds": 3.07,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.85,
      "end_seconds": 126.41,
      "duration_seconds": 3.56,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.09,
      "end_seconds": 135.58,
      "duration_seconds": 3.49,
      "text": "Actually, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.13,
      "end_seconds": 138.06,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.4,
      "end_seconds": 142.27,
      "duration_seconds": 2.87,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.83,
      "end_seconds": 149.04,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.8,
      "end_seconds": 154.86,
      "duration_seconds": 4.06,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.05,
      "end_seconds": 157.22,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.87,
      "end_seconds": 161.93,
      "duration_seconds": 3.06,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.84,
      "end_seconds": 168.27,
      "duration_seconds": 4.43,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.38,
      "end_seconds": 178.61,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.74,
      "end_seconds": 204.44,
      "duration_seconds": 8.7,
      "text": "Okay: pressure 124 over 75, pulse 70. And temp 36.5 degrees, oxygen saturation is 98 percent, respiratory rate 16."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.76,
      "end_seconds": 209.29,
      "duration_seconds": 3.53,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.01,
      "end_seconds": 213.0,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.82,
      "end_seconds": 237.05,
      "duration_seconds": 8.23,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.07,
      "end_seconds": 241.91,
      "duration_seconds": 1.84,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.99,
      "end_seconds": 268.26,
      "duration_seconds": 9.27,
      "text": "Taking everything into account, it's hard to say. Bell's palsy is one possibility and a stroke another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.85,
      "end_seconds": 270.81,
      "duration_seconds": 1.96,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.46,
      "end_seconds": 298.48,
      "duration_seconds": 27.02,
      "text": "I understand the worry. At the moment I'd say it's Bell's palsy, and we'll watch how it goes. You'll be taking prednisolone, 50 milligrams, once a day, ten days. That's for Bell's palsy. Use eye drops and tape the eye shut at night to protect it. One warning sign to remember: you get weakness in an arm or leg. In that case don't wait."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.32,
      "end_seconds": 301.04,
      "duration_seconds": 1.72,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.85,
      "end_seconds": 309.0,
      "duration_seconds": 6.15,
      "text": "Please come and see me in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.29,
      "end_seconds": 312.75,
      "duration_seconds": 2.46,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.84,
      "end_seconds": 315.12,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}