{
  "schema_version": "1.0",
  "encounter_id": "02122",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.18,
      "duration_seconds": 2.8,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.74,
      "end_seconds": 8.66,
      "duration_seconds": 3.92,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.33,
      "end_seconds": 22.11,
      "duration_seconds": 11.78,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. It's a back that has got shorter, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.96,
      "end_seconds": 25.36,
      "duration_seconds": 2.4,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.34,
      "end_seconds": 30.67,
      "duration_seconds": 3.33,
      "text": "I take alendronate, once a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.03,
      "end_seconds": 37.33,
      "duration_seconds": 2.3,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.03,
      "end_seconds": 43.38,
      "duration_seconds": 4.35,
      "text": "70 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.44,
      "end_seconds": 48.86,
      "duration_seconds": 3.42,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.78,
      "end_seconds": 61.09,
      "duration_seconds": 11.31,
      "text": "About nearly five years. I'm on glibenclamide, 5 milligrams, before breakfast. Escitalopram. I take it 10 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.7,
      "end_seconds": 66.51,
      "duration_seconds": 4.81,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.43,
      "end_seconds": 71.1,
      "duration_seconds": 2.67,
      "text": "Actually, no, it's at home."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.63,
      "end_seconds": 73.0,
      "duration_seconds": 1.37,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.99,
      "end_seconds": 84.6,
      "duration_seconds": 10.61,
      "text": "I've had it since Monday oh, and a wrist broken in a slip oh, and a dull ache in my back"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.15,
      "end_seconds": 88.55,
      "duration_seconds": 2.4,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.65,
      "end_seconds": 92.2,
      "duration_seconds": 1.55,
      "text": "nope, no fever"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 94.61,
      "end_seconds": 99.54,
      "duration_seconds": 4.93,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.07,
      "end_seconds": 107.69,
      "duration_seconds": 6.62,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.74,
      "end_seconds": 117.99,
      "duration_seconds": 8.25,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about bladder problems, weight loss or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.44,
      "end_seconds": 122.71,
      "duration_seconds": 3.27,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.18,
      "end_seconds": 125.83,
      "duration_seconds": 1.65,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.26,
      "end_seconds": 128.2,
      "duration_seconds": 0.94,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.47,
      "end_seconds": 134.34,
      "duration_seconds": 2.87,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.98,
      "end_seconds": 137.57,
      "duration_seconds": 1.59,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.46,
      "end_seconds": 148.82,
      "duration_seconds": 3.36,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.12,
      "end_seconds": 155.0,
      "duration_seconds": 4.88,
      "text": "my father has Parkinson's disease my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.14,
      "end_seconds": 158.74,
      "duration_seconds": 2.6,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.29,
      "end_seconds": 174.23,
      "duration_seconds": 13.94,
      "text": "I have thin bones, for two years. I have diabetes, for five years. My family kept telling me to get it checked. I have depression"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.69,
      "end_seconds": 184.75,
      "duration_seconds": 9.06,
      "text": "Alright, depression, that matches what I have here. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.42,
      "end_seconds": 189.27,
      "duration_seconds": 3.85,
      "text": "Not to my knowledge, you know, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 189.95,
      "end_seconds": 196.8,
      "duration_seconds": 6.85,
      "text": "hold on, doctor, I think she reacted to to amoxicillin once i'm not certain, though"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.91,
      "end_seconds": 200.74,
      "duration_seconds": 2.83,
      "text": "really? I don't think so"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 208.06,
      "duration_seconds": 5.35,
      "text": "Okay, I'll note both of those. Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.38,
      "end_seconds": 211.33,
      "duration_seconds": 1.95,
      "text": "No, um, never."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.78,
      "end_seconds": 215.21,
      "duration_seconds": 2.43,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.06,
      "end_seconds": 219.46,
      "duration_seconds": 2.4,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.1,
      "end_seconds": 223.06,
      "duration_seconds": 2.96,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.0,
      "end_seconds": 228.44,
      "duration_seconds": 4.44,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.02,
      "end_seconds": 232.45,
      "duration_seconds": 3.43,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.79,
      "end_seconds": 242.02,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.24,
      "end_seconds": 262.73,
      "duration_seconds": 8.49,
      "text": "Okay: heart rate 77, temp 36.4 degrees, BP is 124 over 69. And respiratory rate 16."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.97,
      "end_seconds": 265.42,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.58,
      "end_seconds": 269.74,
      "duration_seconds": 3.16,
      "text": "That's fine, I'll explain it it soon."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.03,
      "end_seconds": 273.4,
      "duration_seconds": 2.37,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.6,
      "end_seconds": 276.18,
      "duration_seconds": 1.58,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.67,
      "end_seconds": 299.75,
      "duration_seconds": 7.08,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.74,
      "end_seconds": 307.57,
      "duration_seconds": 1.83,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.23,
      "end_seconds": 342.14,
      "duration_seconds": 16.91,
      "text": "so, based on the history and the examination, it it points towards osteoporosis with a fragility fracture that's my thinking for now, and it may change as we learn more. Vitamin D deficiency is still possible"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.82,
      "end_seconds": 346.61,
      "duration_seconds": 3.79,
      "text": "uh, uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.73,
      "end_seconds": 361.95,
      "duration_seconds": 12.22,
      "text": "I understand the worry. At the moment I'd say it's osteoporosis with a fragility fracture, and we'll know more once the a bone density scan is back."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.92,
      "end_seconds": 389.28,
      "duration_seconds": 13.36,
      "text": "let's get a bone density scan, for osteoporosis and please bring the latest prescription or the medicine boxes to the next visit, so so we can settle the dose"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.55,
      "end_seconds": 392.21,
      "duration_seconds": 1.66,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.08,
      "end_seconds": 398.94,
      "duration_seconds": 5.86,
      "text": "we'll catch up in three months that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.2,
      "end_seconds": 404.02,
      "duration_seconds": 3.82,
      "text": "no, you know, that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.62,
      "end_seconds": 407.24,
      "duration_seconds": 1.62,
      "text": "Have a good day."
    }
  ]
}