{
  "schema_version": "1.0",
  "encounter_id": "02018",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 3.84,
      "duration_seconds": 2.9,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.62,
      "end_seconds": 8.61,
      "duration_seconds": 3.99,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.28,
      "end_seconds": 18.67,
      "duration_seconds": 5.39,
      "text": "Mainly I've been getting puffed climbing stairs. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.66,
      "end_seconds": 25.74,
      "duration_seconds": 5.08,
      "text": "tell me your medicines, please. I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 31.43,
      "duration_seconds": 3.98,
      "text": "I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.06,
      "end_seconds": 36.33,
      "duration_seconds": 3.27,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.12,
      "end_seconds": 40.36,
      "duration_seconds": 3.24,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.92,
      "end_seconds": 51.47,
      "duration_seconds": 9.55,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.25,
      "end_seconds": 64.46,
      "duration_seconds": 10.21,
      "text": "Maybe a six out of ten on a bad day. I'd say a couple of times a week. It's worse with stairs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.09,
      "end_seconds": 67.65,
      "duration_seconds": 2.56,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.52,
      "end_seconds": 77.49,
      "duration_seconds": 8.97,
      "text": "Okay, so when it starts I tend to get a bit of a cough with exercise as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.28,
      "end_seconds": 83.43,
      "duration_seconds": 4.15,
      "text": "Have you had any fainting, chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.41,
      "end_seconds": 89.52,
      "duration_seconds": 2.11,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.5,
      "end_seconds": 92.57,
      "duration_seconds": 2.07,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.68,
      "end_seconds": 98.13,
      "duration_seconds": 2.45,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.64,
      "end_seconds": 104.06,
      "duration_seconds": 2.42,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.91,
      "end_seconds": 108.41,
      "duration_seconds": 2.5,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.53,
      "end_seconds": 118.47,
      "duration_seconds": 8.94,
      "text": "I follow okay, I can see thin bones in your file as well have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.65,
      "end_seconds": 123.94,
      "duration_seconds": 4.29,
      "text": "No, um, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.47,
      "end_seconds": 138.09,
      "duration_seconds": 1.62,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.9,
      "end_seconds": 141.23,
      "duration_seconds": 2.33,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.87,
      "end_seconds": 143.73,
      "duration_seconds": 1.86,
      "text": "And And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.35,
      "end_seconds": 148.01,
      "duration_seconds": 3.66,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.3,
      "end_seconds": 151.27,
      "duration_seconds": 1.97,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 156.66,
      "duration_seconds": 4.49,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.74,
      "end_seconds": 168.5,
      "duration_seconds": 2.76,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.98,
      "end_seconds": 176.97,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.26,
      "end_seconds": 198.13,
      "duration_seconds": 9.87,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 17, pressure 119 over 80. And And pulse is 64 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.96,
      "end_seconds": 204.27,
      "duration_seconds": 4.31,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.26,
      "end_seconds": 223.69,
      "duration_seconds": 1.43,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.8,
      "end_seconds": 227.48,
      "duration_seconds": 2.68,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.68,
      "end_seconds": 242.9,
      "duration_seconds": 7.22,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.33,
      "end_seconds": 245.41,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.48,
      "end_seconds": 253.69,
      "duration_seconds": 3.21,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.47,
      "end_seconds": 275.06,
      "duration_seconds": 5.59,
      "text": "okay, thinking it through, this looks most like breathlessness from low fitness"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.97,
      "end_seconds": 280.58,
      "duration_seconds": 3.61,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.09,
      "end_seconds": 298.69,
      "duration_seconds": 16.6,
      "text": "Nothing I've seen today points to an emergency. It looks like breathlessness from low fitness, but I'd like to confirm. We should do a peak flow for exertional cough. Build up to thirty minutes of brisk walking five days a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.27,
      "end_seconds": 320.42,
      "duration_seconds": 21.15,
      "text": "yes make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest if the symptoms get worse, that's the point to come in urgently come back in eight weeks that's all from me any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.0,
      "end_seconds": 323.78,
      "duration_seconds": 2.78,
      "text": "Ah, thank you, doctor, goodbye."
    }
  ]
}