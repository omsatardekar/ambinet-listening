{
  "schema_version": "1.0",
  "encounter_id": "02333",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.89,
      "end_seconds": 8.57,
      "duration_seconds": 7.68,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.79,
      "end_seconds": 13.76,
      "duration_seconds": 3.97,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.04,
      "end_seconds": 20.91,
      "duration_seconds": 5.87,
      "text": "Good morning, um, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 25.49,
      "duration_seconds": 3.59,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.31,
      "end_seconds": 31.54,
      "duration_seconds": 5.23,
      "text": "Let me think, um, we came because of no symptoms."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.4,
      "end_seconds": 34.73,
      "duration_seconds": 2.33,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.75,
      "end_seconds": 39.93,
      "duration_seconds": 3.18,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.79,
      "end_seconds": 45.91,
      "duration_seconds": 4.12,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.9,
      "end_seconds": 52.79,
      "duration_seconds": 4.89,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.58,
      "end_seconds": 54.71,
      "duration_seconds": 1.13,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.62,
      "end_seconds": 59.93,
      "duration_seconds": 4.31,
      "text": "So, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.54,
      "end_seconds": 63.07,
      "duration_seconds": 1.53,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.01,
      "end_seconds": 73.0,
      "duration_seconds": 8.99,
      "text": "Oh, you know, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 73.1,
      "end_seconds": 81.42,
      "duration_seconds": 8.32,
      "text": "Yeah, uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.44,
      "end_seconds": 85.33,
      "duration_seconds": 2.89,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.2,
      "end_seconds": 94.68,
      "duration_seconds": 5.48,
      "text": "Okay, have you had a high blood sugar on a routine test?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.5,
      "end_seconds": 100.64,
      "duration_seconds": 4.14,
      "text": "So, yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 102.23,
      "end_seconds": 105.15,
      "duration_seconds": 2.92,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.66,
      "end_seconds": 109.4,
      "duration_seconds": 3.74,
      "text": "Did you get weight loss, frequent urination or thirst?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.78,
      "end_seconds": 127.56,
      "duration_seconds": 14.78,
      "text": "No, no weight loss, no frequent urination, no thirst. I did have being a little overweight at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.85,
      "end_seconds": 131.55,
      "duration_seconds": 2.7,
      "text": "Have you had any blurred vision?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 132.38,
      "end_seconds": 134.63,
      "duration_seconds": 2.25,
      "text": "Definitely no blurred vision."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.49,
      "end_seconds": 137.95,
      "duration_seconds": 2.46,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.53,
      "end_seconds": 141.23,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.74,
      "end_seconds": 147.56,
      "duration_seconds": 4.82,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.26,
      "end_seconds": 151.26,
      "duration_seconds": 3.0,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.7,
      "end_seconds": 168.03,
      "duration_seconds": 3.33,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.75,
      "end_seconds": 176.37,
      "duration_seconds": 7.62,
      "text": "Okay, so I take propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 177.41,
      "end_seconds": 186.93,
      "duration_seconds": 9.52,
      "text": "Erm, it's meant to be twice a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.97,
      "end_seconds": 193.8,
      "duration_seconds": 3.83,
      "text": "Escitalopram. I take it once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.44,
      "end_seconds": 197.91,
      "duration_seconds": 2.47,
      "text": "So, and what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.24,
      "end_seconds": 207.09,
      "duration_seconds": 7.85,
      "text": "10 milligrams, I think that's what's on the box. I take aspirin, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.3,
      "end_seconds": 210.58,
      "duration_seconds": 2.28,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.53,
      "end_seconds": 212.67,
      "duration_seconds": 1.14,
      "text": "75 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.69,
      "end_seconds": 215.59,
      "duration_seconds": 1.9,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.6,
      "end_seconds": 219.45,
      "duration_seconds": 1.85,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.8,
      "end_seconds": 222.04,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.32,
      "end_seconds": 227.51,
      "duration_seconds": 1.19,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.19,
      "end_seconds": 231.37,
      "duration_seconds": 1.18,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.17,
      "end_seconds": 235.98,
      "duration_seconds": 3.81,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.72,
      "end_seconds": 238.68,
      "duration_seconds": 1.96,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.35,
      "end_seconds": 244.45,
      "duration_seconds": 4.1,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.58,
      "end_seconds": 247.55,
      "duration_seconds": 1.97,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.5,
      "end_seconds": 254.55,
      "duration_seconds": 6.05,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.79,
      "end_seconds": 275.22,
      "duration_seconds": 3.43,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.88,
      "end_seconds": 278.96,
      "duration_seconds": 3.08,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.94,
      "end_seconds": 284.31,
      "duration_seconds": 4.37,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.23,
      "end_seconds": 287.63,
      "duration_seconds": 2.4,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 288.44,
      "end_seconds": 298.37,
      "duration_seconds": 9.93,
      "text": "Actually, I remember she had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 300.08,
      "end_seconds": 302.83,
      "duration_seconds": 2.75,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.09,
      "end_seconds": 313.99,
      "duration_seconds": 6.9,
      "text": "Okay, I'll note both of those. Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.05,
      "end_seconds": 329.82,
      "duration_seconds": 14.77,
      "text": "Migraines, for about a year. It's a relief to finally sit down and talk about it. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.63,
      "end_seconds": 332.33,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.92,
      "end_seconds": 351.3,
      "duration_seconds": 17.38,
      "text": "I've had anxiety for five years now. I've been putting this off for weeks. I told my wife I'd come today. I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.12,
      "end_seconds": 358.7,
      "duration_seconds": 5.58,
      "text": "Okay, I can see migraines and anxiety in your file as well."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 359.32,
      "end_seconds": 367.02,
      "duration_seconds": 7.7,
      "text": "Here are the numbers, doctor. Pulse is 73 beats a minute, blood pressure 126 over 82, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.55,
      "end_seconds": 369.03,
      "duration_seconds": 1.48,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.01,
      "end_seconds": 375.67,
      "duration_seconds": 3.66,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.04,
      "end_seconds": 378.34,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.22,
      "end_seconds": 396.46,
      "duration_seconds": 3.24,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 397.12,
      "end_seconds": 398.21,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.3,
      "end_seconds": 410.04,
      "duration_seconds": 6.74,
      "text": "Good, you can sit up again. Okay, thinking it through, this looks most like prediabetes."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.38,
      "end_seconds": 414.91,
      "duration_seconds": 3.53,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.0,
      "end_seconds": 441.47,
      "duration_seconds": 25.47,
      "text": "Nothing I've seen today points to an emergency. It looks like prediabetes, but I'd like to confirm. I'll request a repeat HbA1c, it'll help with prediabetes. Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 442.65,
      "end_seconds": 444.89,
      "duration_seconds": 2.24,
      "text": "I, I'll remember that."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.91,
      "end_seconds": 450.48,
      "duration_seconds": 3.57,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 451.73,
      "end_seconds": 455.11,
      "duration_seconds": 3.38,
      "text": "So, thank you, doctor, goodbye."
    }
  ]
}