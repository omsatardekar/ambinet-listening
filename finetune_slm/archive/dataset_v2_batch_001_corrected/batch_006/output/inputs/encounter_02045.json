{
  "schema_version": "1.0",
  "encounter_id": "02045",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 3.6,
      "duration_seconds": 2.84,
      "text": "morning, doctor lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.66,
      "end_seconds": 9.38,
      "duration_seconds": 4.72,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.42,
      "end_seconds": 18.65,
      "duration_seconds": 5.23,
      "text": "So, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.58,
      "end_seconds": 25.16,
      "duration_seconds": 4.58,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.77,
      "end_seconds": 30.38,
      "duration_seconds": 3.61,
      "text": "He's been turning the television up, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.28,
      "end_seconds": 34.55,
      "duration_seconds": 2.27,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.24,
      "end_seconds": 39.12,
      "duration_seconds": 3.88,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.14,
      "end_seconds": 43.08,
      "duration_seconds": 2.94,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.74,
      "end_seconds": 51.31,
      "duration_seconds": 6.57,
      "text": "well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.83,
      "end_seconds": 58.45,
      "duration_seconds": 5.62,
      "text": "take your time mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.47,
      "end_seconds": 60.93,
      "duration_seconds": 1.46,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.78,
      "end_seconds": 67.8,
      "duration_seconds": 6.02,
      "text": "Yeah, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 67.9,
      "end_seconds": 74.99,
      "duration_seconds": 7.09,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.02,
      "end_seconds": 78.48,
      "duration_seconds": 2.46,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.95,
      "end_seconds": 85.29,
      "duration_seconds": 5.34,
      "text": "I've had not listening at school too, for three days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.97,
      "end_seconds": 97.19,
      "duration_seconds": 6.22,
      "text": "Right, have you been turning the television up at any time before this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.26,
      "end_seconds": 103.93,
      "duration_seconds": 4.67,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.91,
      "end_seconds": 121.69,
      "duration_seconds": 4.78,
      "text": "Have you had any ear pain, discharge, dizziness or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.16,
      "end_seconds": 137.22,
      "duration_seconds": 14.06,
      "text": "No, no ear pain, no discharge, no dizziness. I did have a cold that won't go at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.62,
      "end_seconds": 143.48,
      "duration_seconds": 4.86,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.08,
      "end_seconds": 146.87,
      "duration_seconds": 1.79,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.42,
      "end_seconds": 151.97,
      "duration_seconds": 3.55,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.7,
      "end_seconds": 162.22,
      "duration_seconds": 8.52,
      "text": "It's Thyronorm, 50 micrograms, every morning. It's, It's sodium valproate, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.23,
      "end_seconds": 170.77,
      "duration_seconds": 4.54,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.29,
      "end_seconds": 175.73,
      "duration_seconds": 3.44,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.56,
      "end_seconds": 179.51,
      "duration_seconds": 2.95,
      "text": "Okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.62,
      "end_seconds": 189.0,
      "duration_seconds": 8.38,
      "text": "Yeah, I've had an underactive thyroid, yes. I have epilepsy. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.86,
      "end_seconds": 204.08,
      "duration_seconds": 3.22,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.07,
      "end_seconds": 210.72,
      "duration_seconds": 5.65,
      "text": "My mother had a stroke. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.34,
      "end_seconds": 214.64,
      "duration_seconds": 2.3,
      "text": "And And alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.42,
      "end_seconds": 219.18,
      "duration_seconds": 2.76,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.11,
      "end_seconds": 221.46,
      "duration_seconds": 1.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.53,
      "end_seconds": 226.46,
      "duration_seconds": 3.93,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.93,
      "end_seconds": 229.92,
      "duration_seconds": 1.99,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.61,
      "end_seconds": 235.63,
      "duration_seconds": 4.02,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 237.1,
      "end_seconds": 248.86,
      "duration_seconds": 11.76,
      "text": "okay, so the vitals from earlier. Temperature is 36.7 degrees, blood pressure 108 over 80. Pulse is 76 beats a minute, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.09,
      "end_seconds": 251.46,
      "duration_seconds": 1.37,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.75,
      "end_seconds": 256.53,
      "duration_seconds": 2.78,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.45,
      "end_seconds": 259.27,
      "duration_seconds": 1.82,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.87,
      "end_seconds": 262.26,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.22,
      "end_seconds": 277.78,
      "duration_seconds": 4.56,
      "text": "both ear drums look dull and retracted with fluid behind them"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.32,
      "end_seconds": 279.02,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.69,
      "end_seconds": 296.72,
      "duration_seconds": 12.03,
      "text": "you can sit up now from what you've told me and what I found, the most likely explanation is glue ear i can't rule out wax yet"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.96,
      "end_seconds": 299.98,
      "duration_seconds": 2.02,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.91,
      "end_seconds": 314.65,
      "duration_seconds": 13.74,
      "text": "I understand the worry. At the moment I'd say it's glue ear, and we'll know more once the a hearing test is back. We should do a hearing test for reduced hearing."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.45,
      "end_seconds": 318.93,
      "duration_seconds": 2.48,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.67,
      "end_seconds": 346.06,
      "duration_seconds": 25.39,
      "text": "we will watch for three months, and sit him at the front of the class. The ENT clinic would be the right next step, I'll refer you. One warning sign to remember: the symptoms get worse. In that case don't wait. Come back in three months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.07,
      "end_seconds": 350.06,
      "duration_seconds": 2.99,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.83,
      "end_seconds": 352.0,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}