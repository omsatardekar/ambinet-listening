{
  "schema_version": "1.0",
  "encounter_id": "02386",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 7.02,
      "duration_seconds": 6.33,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.83,
      "end_seconds": 12.6,
      "duration_seconds": 3.77,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.26,
      "end_seconds": 22.76,
      "duration_seconds": 8.5,
      "text": "Doctor, I'm just here to help with the details. Doctor, it's a headache. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.54,
      "end_seconds": 26.73,
      "duration_seconds": 3.19,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.16,
      "end_seconds": 35.71,
      "duration_seconds": 7.55,
      "text": "For three weeks, I'd say. I've been feeling sick too, for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.42,
      "end_seconds": 40.06,
      "duration_seconds": 3.64,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.11,
      "end_seconds": 50.61,
      "duration_seconds": 8.5,
      "text": "Maybe a three out of ten on a bad day. There was dizziness, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.6,
      "end_seconds": 57.97,
      "duration_seconds": 2.37,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.2,
      "end_seconds": 73.21,
      "duration_seconds": 2.01,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.58,
      "end_seconds": 93.36,
      "duration_seconds": 8.78,
      "text": "Okay: blood pressure 127 over 78, temperature 36.4, SpO2 98 percent on room air, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.89,
      "end_seconds": 99.4,
      "duration_seconds": 4.51,
      "text": "Right, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.5,
      "end_seconds": 102.49,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.72,
      "end_seconds": 124.8,
      "duration_seconds": 9.08,
      "text": "Your lips are pink but the whole household feels unwell, and the oxygen reading looks normal but cannot be trusted."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.97,
      "end_seconds": 132.5,
      "duration_seconds": 2.53,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.08,
      "end_seconds": 145.83,
      "duration_seconds": 3.75,
      "text": "Have you noticed fever, chest pain or rash?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.09,
      "end_seconds": 151.09,
      "duration_seconds": 2.0,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.58,
      "end_seconds": 157.31,
      "duration_seconds": 2.73,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 160.8,
      "duration_seconds": 2.2,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.93,
      "end_seconds": 164.13,
      "duration_seconds": 2.2,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 165.73,
      "end_seconds": 169.41,
      "duration_seconds": 3.68,
      "text": "She takes atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.48,
      "end_seconds": 171.71,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.75,
      "end_seconds": 175.53,
      "duration_seconds": 1.78,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.7,
      "end_seconds": 180.96,
      "duration_seconds": 4.26,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.93,
      "end_seconds": 187.18,
      "duration_seconds": 4.25,
      "text": "I have high cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.08,
      "end_seconds": 196.59,
      "duration_seconds": 8.51,
      "text": "Alright, high cholesterol, that matches what I have here. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.49,
      "end_seconds": 202.0,
      "duration_seconds": 3.51,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 204.69,
      "duration_seconds": 1.98,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.97,
      "end_seconds": 211.55,
      "duration_seconds": 5.58,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.66,
      "end_seconds": 214.01,
      "duration_seconds": 1.35,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.9,
      "end_seconds": 219.95,
      "duration_seconds": 4.05,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.21,
      "end_seconds": 222.88,
      "duration_seconds": 1.67,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.11,
      "end_seconds": 227.7,
      "duration_seconds": 3.59,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.78,
      "end_seconds": 244.97,
      "duration_seconds": 4.19,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.99,
      "end_seconds": 248.35,
      "duration_seconds": 2.36,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.4,
      "end_seconds": 266.17,
      "duration_seconds": 9.77,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be possible carbon monoxide poisoning, or it might be a viral illness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.01,
      "end_seconds": 269.15,
      "duration_seconds": 2.14,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.19,
      "end_seconds": 302.71,
      "duration_seconds": 31.52,
      "text": "Nothing I've seen today points to an emergency. It looks like possible carbon monoxide poisoning, but I'd like to confirm. I think a carboxyhaemoglobin blood test makes sense here, for possible carbon monoxide poisoning. You'll be taking high-flow oxygen, 15 litres per minute, continuous, until reviewed. It's for carbon monoxide poisoning. Leave the house now, don't use the boiler, and call the gas emergency number."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.55,
      "end_seconds": 309.85,
      "duration_seconds": 6.3,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.1,
      "end_seconds": 316.21,
      "duration_seconds": 2.11,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.53,
      "end_seconds": 321.48,
      "duration_seconds": 3.95,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.25,
      "end_seconds": 326.2,
      "duration_seconds": 3.95,
      "text": "Oh, good, thanks, I'll see you then."
    }
  ]
}