{
  "schema_version": "1.0",
  "encounter_id": "02078",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 7.33,
      "duration_seconds": 6.28,
      "text": "Sorry, what was I saying, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.35,
      "end_seconds": 13.45,
      "duration_seconds": 5.1,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.41,
      "end_seconds": 19.64,
      "duration_seconds": 5.23,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.9,
      "duration_seconds": 3.71,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.76,
      "end_seconds": 27.73,
      "duration_seconds": 2.97,
      "text": "I'm here because of a headache."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.99,
      "end_seconds": 32.0,
      "duration_seconds": 3.01,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.61,
      "end_seconds": 38.49,
      "duration_seconds": 4.88,
      "text": "Um, I've had it for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.01,
      "end_seconds": 42.39,
      "duration_seconds": 3.38,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.74,
      "end_seconds": 48.1,
      "duration_seconds": 2.36,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.9,
      "end_seconds": 51.39,
      "duration_seconds": 2.49,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.23,
      "end_seconds": 77.08,
      "duration_seconds": 23.85,
      "text": "It happens a couple of times a week. I've been feeling sick too. With feeling sick, pretty severe, if I'm being honest. As for being drowsy, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.04,
      "end_seconds": 90.5,
      "duration_seconds": 4.46,
      "text": "Have you had any rash, fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.61,
      "end_seconds": 94.72,
      "duration_seconds": 3.11,
      "text": "Well, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.51,
      "end_seconds": 97.6,
      "duration_seconds": 2.09,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.83,
      "end_seconds": 100.33,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.08,
      "end_seconds": 104.83,
      "duration_seconds": 3.75,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.87,
      "end_seconds": 123.47,
      "duration_seconds": 17.6,
      "text": "I've had an underactive thyroid, yes. I looked a few things up online, and that probably didn't help. I have thin bones, for about a year. An irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.44,
      "end_seconds": 126.33,
      "duration_seconds": 1.89,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.28,
      "end_seconds": 136.37,
      "duration_seconds": 4.09,
      "text": "An enlarged prostate, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.09,
      "end_seconds": 148.03,
      "duration_seconds": 9.94,
      "text": "Yes, an underactive thyroid and thin bones are known to us, good to have that clear. Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.1,
      "end_seconds": 152.96,
      "duration_seconds": 2.86,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.37,
      "end_seconds": 155.62,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.13,
      "end_seconds": 159.45,
      "duration_seconds": 3.32,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.43,
      "end_seconds": 162.75,
      "duration_seconds": 1.32,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.57,
      "end_seconds": 167.69,
      "duration_seconds": 4.12,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.27,
      "end_seconds": 172.61,
      "duration_seconds": 3.34,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.66,
      "end_seconds": 176.85,
      "duration_seconds": 3.19,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.95,
      "end_seconds": 195.65,
      "duration_seconds": 2.7,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.49,
      "end_seconds": 200.31,
      "duration_seconds": 2.82,
      "text": "Well, I've never had an allergy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 201.02,
      "end_seconds": 208.78,
      "duration_seconds": 7.76,
      "text": "Erm, hold on, doctor, I think he reacted to diclofenac once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.49,
      "end_seconds": 212.73,
      "duration_seconds": 2.24,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.32,
      "end_seconds": 219.76,
      "duration_seconds": 6.44,
      "text": "Okay, I'll note both of those. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.55,
      "end_seconds": 229.62,
      "duration_seconds": 8.07,
      "text": "Um, my grandfather had a stroke. Actually, uh, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.66,
      "end_seconds": 234.84,
      "duration_seconds": 3.18,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.81,
      "end_seconds": 240.66,
      "duration_seconds": 3.85,
      "text": "It's Eltroxin, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.25,
      "end_seconds": 246.51,
      "duration_seconds": 2.26,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.3,
      "end_seconds": 251.24,
      "duration_seconds": 3.94,
      "text": "100 micrograms. Alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 254.06,
      "end_seconds": 262.94,
      "duration_seconds": 8.88,
      "text": "Doctor, I think the last prescription for the alendronate was 140 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.31,
      "end_seconds": 267.4,
      "duration_seconds": 3.09,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.07,
      "end_seconds": 277.43,
      "duration_seconds": 8.36,
      "text": "Right, you know, no, I left it at home. I'm on tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.78,
      "end_seconds": 286.33,
      "duration_seconds": 2.55,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.22,
      "end_seconds": 292.48,
      "duration_seconds": 4.26,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.17,
      "end_seconds": 297.02,
      "duration_seconds": 2.85,
      "text": "Alright, I'll do your observations first."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.43,
      "end_seconds": 307.86,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.28,
      "end_seconds": 334.31,
      "duration_seconds": 10.03,
      "text": "Okay: temp 36.7 degrees, pulse is 82 beats a minute, respiratory rate 14, saturation 99 percent, blood pressure 108 over 78."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.33,
      "end_seconds": 340.59,
      "duration_seconds": 4.26,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.43,
      "end_seconds": 345.27,
      "duration_seconds": 2.84,
      "text": "Alright, take a deep breath for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.67,
      "end_seconds": 372.36,
      "duration_seconds": 8.69,
      "text": "Your lips are pink but the whole household feels unwell, and the oxygen reading looks normal but cannot be trusted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.62,
      "end_seconds": 387.84,
      "duration_seconds": 12.22,
      "text": "You can sit up now. So, based on the history and the examination, the most likely explanation is possible carbon monoxide poisoning. A viral illness is still possible."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.94,
      "end_seconds": 393.08,
      "duration_seconds": 2.14,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.26,
      "end_seconds": 413.85,
      "duration_seconds": 19.59,
      "text": "Nothing I've seen today points to an emergency. It looks like possible carbon monoxide poisoning, but I'd like to confirm. So, to recap quickly. You've had a headache for about a month, severe, and no chest pain or fever."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.32,
      "end_seconds": 416.86,
      "duration_seconds": 1.54,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.4,
      "end_seconds": 465.44,
      "duration_seconds": 32.04,
      "text": "I'll request a carboxyhaemoglobin blood test, it'll help with possible carbon monoxide poisoning. I'd like you to take high-flow oxygen, 15 litres per minute, continuous, until reviewed. That should help with carbon monoxide poisoning. Leave the house now, don't use the boiler, and call the gas emergency number. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 466.87,
      "end_seconds": 468.54,
      "duration_seconds": 1.67,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 470.02,
      "end_seconds": 475.77,
      "duration_seconds": 5.75,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 476.39,
      "end_seconds": 477.43,
      "duration_seconds": 1.04,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 478.78,
      "end_seconds": 485.38,
      "duration_seconds": 6.6,
      "text": "I'll want another look straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 485.95,
      "end_seconds": 489.66,
      "duration_seconds": 3.71,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}