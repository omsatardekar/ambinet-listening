{
  "schema_version": "1.0",
  "encounter_id": "02169",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 3.3,
      "duration_seconds": 2.29,
      "text": "good morning, grab a seat"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.85,
      "end_seconds": 5.95,
      "duration_seconds": 1.1,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 9.99,
      "duration_seconds": 3.07,
      "text": "Alright, start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.85,
      "end_seconds": 14.61,
      "duration_seconds": 3.76,
      "text": "I'm here because of not listening at school."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.69,
      "end_seconds": 19.52,
      "duration_seconds": 3.83,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.86,
      "end_seconds": 26.23,
      "duration_seconds": 3.37,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.57,
      "end_seconds": 29.58,
      "duration_seconds": 3.01,
      "text": "Sure. How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.18,
      "end_seconds": 36.25,
      "duration_seconds": 6.07,
      "text": "Mostly severe. Let me think, there's not hearing very well as well."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.89,
      "end_seconds": 50.24,
      "duration_seconds": 2.35,
      "text": "Alright, nothing like ear pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.61,
      "end_seconds": 53.54,
      "duration_seconds": 1.93,
      "text": "Definitely no ear pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.06,
      "end_seconds": 58.54,
      "duration_seconds": 3.48,
      "text": "Have you noticed discharge, fever or dizziness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.13,
      "end_seconds": 63.5,
      "duration_seconds": 4.37,
      "text": "No discharge, fever or dizziness, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.06,
      "end_seconds": 66.88,
      "duration_seconds": 2.82,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.96,
      "end_seconds": 69.59,
      "duration_seconds": 1.63,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.27,
      "end_seconds": 75.03,
      "duration_seconds": 3.76,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.25,
      "end_seconds": 77.73,
      "duration_seconds": 1.48,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.29,
      "end_seconds": 82.18,
      "duration_seconds": 3.89,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.07,
      "end_seconds": 94.07,
      "duration_seconds": 11.0,
      "text": "I grab fast food at lunch most days. My partner and our baby. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.04,
      "end_seconds": 97.99,
      "duration_seconds": 2.95,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.68,
      "end_seconds": 101.13,
      "duration_seconds": 2.45,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 107.12,
      "duration_seconds": 4.16,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.66,
      "end_seconds": 116.89,
      "duration_seconds": 9.23,
      "text": "Propranolol. I take it 40 milligrams, twice a day. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.62,
      "end_seconds": 126.92,
      "duration_seconds": 2.3,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.01,
      "end_seconds": 132.09,
      "duration_seconds": 4.08,
      "text": "I had a varicose vein procedure last year"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.74,
      "end_seconds": 138.12,
      "duration_seconds": 4.38,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.72,
      "end_seconds": 152.26,
      "duration_seconds": 12.54,
      "text": "oh, I've had migraines, yes. I didn't want to make a fuss, you know. I'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.79,
      "end_seconds": 174.56,
      "duration_seconds": 4.77,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.2,
      "end_seconds": 180.72,
      "duration_seconds": 4.52,
      "text": "Mm, uh, yes, erythromycin. I get a rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.94,
      "end_seconds": 187.55,
      "duration_seconds": 3.61,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.24,
      "end_seconds": 202.25,
      "duration_seconds": 3.01,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.49,
      "end_seconds": 224.41,
      "duration_seconds": 7.92,
      "text": "Okay: pressure 115 over 72, SpO2 98 percent on room air, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.85,
      "end_seconds": 227.26,
      "duration_seconds": 1.41,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.39,
      "end_seconds": 232.41,
      "duration_seconds": 4.02,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.47,
      "end_seconds": 235.89,
      "duration_seconds": 2.42,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.85,
      "end_seconds": 239.08,
      "duration_seconds": 2.23,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.03,
      "end_seconds": 256.52,
      "duration_seconds": 4.49,
      "text": "Both ear drums look dull and retracted with fluid behind them."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.78,
      "end_seconds": 267.44,
      "duration_seconds": 6.66,
      "text": "Thank you, you can get dressed. Right, here's what I'm thinking. This is probably glue ear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.21,
      "end_seconds": 292.87,
      "duration_seconds": 13.66,
      "text": "We will watch for three months, and sit him at the front of the class. I'd like to see you again in three months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.02,
      "end_seconds": 298.14,
      "duration_seconds": 4.12,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.67,
      "end_seconds": 301.13,
      "duration_seconds": 1.46,
      "text": "Take care now."
    }
  ]
}