      "role": "DOCTOR",
      "start_seconds": 227.08,
      "end_seconds": 235.65,
      "duration_seconds": 8.57,
      "text": "Okay: BP is 109 over 74, temperature 38.9, SpO2 96 percent on room air, pulse is 105 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.52,
      "end_seconds": 239.56,
      "duration_seconds": 3.04,
      "text": "Is that alright, uh, doctor?"
