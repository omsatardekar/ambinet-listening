      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.17,
      "end_seconds": 249.72,
      "duration_seconds": 4.55,
      "text": "alright, over here please and I'll take a look"
