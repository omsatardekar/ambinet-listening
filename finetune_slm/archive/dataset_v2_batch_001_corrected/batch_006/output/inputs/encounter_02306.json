      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.27,
      "end_seconds": 243.12,
      "duration_seconds": 2.85,
      "text": "I'll come back to the numbers."
