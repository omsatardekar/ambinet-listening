      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.95,
      "end_seconds": 116.99,
      "duration_seconds": 4.04,
      "text": "Right, uh, my grandfather had a stroke."
