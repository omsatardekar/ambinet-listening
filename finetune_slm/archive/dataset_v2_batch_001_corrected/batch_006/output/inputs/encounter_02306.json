      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.65,
      "end_seconds": 146.51,
      "duration_seconds": 14.86,
      "text": "I only drink at family occasions. I've never touched a cigarette. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
