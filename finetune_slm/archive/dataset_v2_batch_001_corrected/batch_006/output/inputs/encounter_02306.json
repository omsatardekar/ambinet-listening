      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.93,
      "end_seconds": 327.15,
      "duration_seconds": 14.22,
      "text": "you need admission today for blood cultures and a heart scan i'm not ordering blood tests today if things carry on in a month, we'll consider it let's plan a check straight away"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.89,
      "end_seconds": 330.05,
      "duration_seconds": 2.16,
      "text": "Good, I'll return then."
    },
