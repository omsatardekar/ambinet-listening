      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.65,
      "end_seconds": 188.11,
      "duration_seconds": 5.46,
      "text": "No, um, no weight loss, cough or chest pain."
