{
  "schema_version": "1.0",
  "encounter_id": "02125",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 4.24,
      "duration_seconds": 3.22,
      "text": "Okay, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.32,
      "end_seconds": 8.18,
      "duration_seconds": 2.86,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.23,
      "end_seconds": 14.52,
      "duration_seconds": 4.29,
      "text": "Well, I've been having a fever for two weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.15,
      "end_seconds": 18.53,
      "duration_seconds": 2.38,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.03,
      "end_seconds": 23.45,
      "duration_seconds": 3.42,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.15,
      "end_seconds": 32.86,
      "duration_seconds": 7.71,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.2,
      "end_seconds": 39.27,
      "duration_seconds": 5.07,
      "text": "It feels severe to me. It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.8,
      "end_seconds": 43.47,
      "duration_seconds": 2.67,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.62,
      "end_seconds": 58.66,
      "duration_seconds": 14.04,
      "text": "Okay, so it usually comes with small painful spots on my fingers. The small painful spots on my fingers? That's been for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.08,
      "end_seconds": 63.18,
      "duration_seconds": 4.1,
      "text": "I see, go ahead. Has there been tiredness too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.37,
      "end_seconds": 68.07,
      "duration_seconds": 3.7,
      "text": "Yeah. Two days, uh, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.51,
      "end_seconds": 73.61,
      "duration_seconds": 4.1,
      "text": "Have you had any cough, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.83,
      "end_seconds": 79.97,
      "duration_seconds": 5.14,
      "text": "I haven't had cough, chest pain or weight loss, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.92,
      "end_seconds": 84.73,
      "duration_seconds": 2.81,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.59,
      "end_seconds": 89.84,
      "duration_seconds": 3.25,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.47,
      "end_seconds": 94.3,
      "duration_seconds": 2.83,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.59,
      "end_seconds": 99.99,
      "duration_seconds": 1.4,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.06,
      "end_seconds": 104.51,
      "duration_seconds": 2.45,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.88,
      "end_seconds": 112.96,
      "duration_seconds": 2.08,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.46,
      "end_seconds": 127.51,
      "duration_seconds": 3.05,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.42,
      "end_seconds": 131.94,
      "duration_seconds": 2.52,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.95,
      "end_seconds": 137.33,
      "duration_seconds": 3.38,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.93,
      "end_seconds": 145.33,
      "duration_seconds": 6.4,
      "text": "Bisoprolol. I take it 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.99,
      "end_seconds": 148.99,
      "duration_seconds": 2.0,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.86,
      "end_seconds": 151.83,
      "duration_seconds": 1.97,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.71,
      "end_seconds": 156.4,
      "duration_seconds": 3.69,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.91,
      "end_seconds": 174.65,
      "duration_seconds": 13.74,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. Not much, I mostly stay in these days. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 197.18,
      "duration_seconds": 4.34,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.97,
      "end_seconds": 202.75,
      "duration_seconds": 4.78,
      "text": "Hmm, um, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.01,
      "end_seconds": 209.37,
      "duration_seconds": 4.36,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.21,
      "end_seconds": 211.92,
      "duration_seconds": 1.71,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.62,
      "end_seconds": 236.77,
      "duration_seconds": 8.15,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 251.43,
      "duration_seconds": 12.6,
      "text": "You can sit up now. Taking everything into account, this looks most like possible infective endocarditis. It could also be a viral illness, so we'll keep that open."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.4,
      "end_seconds": 277.63,
      "duration_seconds": 7.23,
      "text": "Let's book blood cultures to look into possible endocarditis. I'd like to arrange an echocardiogram for new murmur."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.55,
      "end_seconds": 281.64,
      "duration_seconds": 2.09,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.08,
      "end_seconds": 303.94,
      "duration_seconds": 20.86,
      "text": "You need admission today for blood cultures and a heart scan. If you smoke, this is a good moment to think about stopping, and we can help you with that. One warning sign to remember: the symptoms get worse. In that case don't wait. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.93,
      "end_seconds": 305.63,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.53,
      "end_seconds": 309.88,
      "duration_seconds": 2.35,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.37,
      "end_seconds": 313.07,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    }
  ]
}