{
  "schema_version": "1.0",
  "encounter_id": "02011",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.02,
      "duration_seconds": 3.46,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 9.91,
      "duration_seconds": 4.7,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.0,
      "end_seconds": 26.66,
      "duration_seconds": 15.66,
      "text": "It's my face drooping on the right. I thought I'd wait, but it hasn't gone. I kept putting it off, which I know isn't sensible. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.59,
      "end_seconds": 31.02,
      "duration_seconds": 2.43,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.41,
      "end_seconds": 34.94,
      "duration_seconds": 2.53,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.84,
      "end_seconds": 38.66,
      "duration_seconds": 2.82,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.51,
      "end_seconds": 53.58,
      "duration_seconds": 13.07,
      "text": "Moderate, really. As for funny taste, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.88,
      "end_seconds": 54.97,
      "duration_seconds": 1.09,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.24,
      "end_seconds": 73.43,
      "duration_seconds": 2.19,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.2,
      "end_seconds": 89.2,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.32,
      "end_seconds": 108.1,
      "duration_seconds": 8.78,
      "text": "Okay: pressure 116 over 71, pulse is 69 beats a minute, temperature 36.7, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.12,
      "end_seconds": 111.81,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.42,
      "end_seconds": 115.6,
      "duration_seconds": 3.18,
      "text": "Alright, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.37,
      "end_seconds": 121.08,
      "duration_seconds": 3.71,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.14,
      "end_seconds": 124.16,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 127.33,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.55,
      "end_seconds": 143.17,
      "duration_seconds": 7.62,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.11,
      "end_seconds": 153.58,
      "duration_seconds": 6.47,
      "text": "That's all I needed to check. Have you had any weakness in the arm or leg?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.47,
      "end_seconds": 159.19,
      "duration_seconds": 3.72,
      "text": "Definitely no weakness in the arm or leg."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.38,
      "end_seconds": 164.3,
      "duration_seconds": 3.92,
      "text": "Any rash in the ear, slurred speech or headache?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.9,
      "end_seconds": 170.03,
      "duration_seconds": 5.13,
      "text": "No, no rash in the ear, slurred speech or headache."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.71,
      "end_seconds": 172.7,
      "duration_seconds": 1.99,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.29,
      "end_seconds": 175.46,
      "duration_seconds": 2.17,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.22,
      "end_seconds": 181.06,
      "duration_seconds": 3.84,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.81,
      "end_seconds": 185.17,
      "duration_seconds": 2.36,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.45,
      "end_seconds": 188.83,
      "duration_seconds": 2.38,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.46,
      "end_seconds": 190.67,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.84,
      "end_seconds": 196.14,
      "duration_seconds": 4.3,
      "text": "Alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.59,
      "end_seconds": 200.24,
      "duration_seconds": 2.65,
      "text": "Right, my son has asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.33,
      "end_seconds": 208.15,
      "duration_seconds": 5.82,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.94,
      "end_seconds": 215.12,
      "duration_seconds": 2.18,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.43,
      "end_seconds": 237.94,
      "duration_seconds": 4.51,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.19,
      "end_seconds": 246.1,
      "duration_seconds": 2.91,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.48,
      "end_seconds": 264.82,
      "duration_seconds": 3.34,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.91,
      "end_seconds": 288.63,
      "duration_seconds": 22.72,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. No, I share a house with my brother. Yes, I work in a bakery, early starts. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.27,
      "end_seconds": 292.68,
      "duration_seconds": 3.41,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.77,
      "end_seconds": 297.74,
      "duration_seconds": 3.97,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.64,
      "end_seconds": 303.21,
      "duration_seconds": 4.57,
      "text": "So where does that leave us? It points towards Bell's palsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.87,
      "end_seconds": 307.57,
      "duration_seconds": 2.7,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.79,
      "end_seconds": 331.3,
      "duration_seconds": 22.51,
      "text": "Nothing I've seen today points to an emergency. It looks like Bell's palsy. I'm prescribing prednisolone, 50 milligrams, once a day, ten days. That should help with Bell's palsy. Use eye drops and tape the eye shut at night to protect it. Please come and see me in one week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.28,
      "end_seconds": 335.55,
      "duration_seconds": 3.27,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.73,
      "end_seconds": 340.15,
      "duration_seconds": 3.42,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.86,
      "end_seconds": 345.9,
      "duration_seconds": 5.04,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.63,
      "end_seconds": 348.56,
      "duration_seconds": 1.93,
      "text": "Have a good day."
    }
  ]
}