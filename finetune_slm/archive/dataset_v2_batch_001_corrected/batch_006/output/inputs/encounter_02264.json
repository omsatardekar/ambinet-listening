  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 2.93,
      "duration_seconds": 1.96,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.02,
      "end_seconds": 7.68,
      "duration_seconds": 3.66,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.89,
      "end_seconds": 15.57,
      "duration_seconds": 6.68,
      "text": "Okay, so morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.26,
      "end_seconds": 19.29,
      "duration_seconds": 3.03,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.19,
      "end_seconds": 25.31,
      "duration_seconds": 5.12,
      "text": "She's been having pain going up to the tummy, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.41,
      "end_seconds": 30.83,
      "duration_seconds": 3.42,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.7,
      "end_seconds": 34.72,
      "duration_seconds": 2.02,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.78,
      "end_seconds": 40.95,
      "duration_seconds": 4.17,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.57,
      "end_seconds": 43.3,
      "duration_seconds": 1.73,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.42,
      "end_seconds": 49.83,
      "duration_seconds": 2.41,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.16,
      "end_seconds": 58.58,
      "duration_seconds": 7.42,
      "text": "Sudden severe pain in the left testicle goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.09,
      "end_seconds": 61.39,
      "duration_seconds": 2.3,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.16,
      "end_seconds": 72.69,
      "duration_seconds": 9.53,
      "text": "Yes, I have. Mm, uh, with feeling sick, honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.44,
      "end_seconds": 87.73,
      "duration_seconds": 4.29,
      "text": "Have you had burning when passing urine, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.62,
      "end_seconds": 94.05,
      "duration_seconds": 4.43,
      "text": "Not at all, no burning when passing urine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.53,
      "end_seconds": 98.96,
      "duration_seconds": 3.43,
      "text": "So, did you get discharge, injury or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.63,
      "end_seconds": 105.29,
      "duration_seconds": 4.66,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.25,
      "end_seconds": 109.53,
      "duration_seconds": 2.28,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.71,
      "end_seconds": 111.77,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 115.82,
      "duration_seconds": 2.73,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.51,
      "end_seconds": 121.89,
      "duration_seconds": 5.38,
      "text": "Oh, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.6,
      "end_seconds": 126.33,
      "duration_seconds": 2.73,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.72,
      "end_seconds": 136.93,
      "duration_seconds": 6.21,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.3,
      "end_seconds": 151.3,
      "duration_seconds": 4.0,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.67,
      "end_seconds": 166.86,
      "duration_seconds": 12.19,
      "text": "I work in accounts at a hospital. No, I share a house with my brother. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.6,
      "end_seconds": 172.34,
      "duration_seconds": 4.74,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.02,
      "end_seconds": 177.99,
      "duration_seconds": 4.97,
      "text": "No, you know, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.68,
      "end_seconds": 182.42,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.52,
      "end_seconds": 186.29,
      "duration_seconds": 2.77,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.35,
      "end_seconds": 191.87,
      "duration_seconds": 3.52,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.24,
      "end_seconds": 204.48,
      "duration_seconds": 11.24,
      "text": "Bisoprolol. I take it 2.5 milligrams, once a day. Okay, so I used to take metoprolol, but I stopped it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.75,
      "end_seconds": 220.5,
      "duration_seconds": 2.75,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.66,
      "end_seconds": 233.1,
      "duration_seconds": 2.44,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.29,
      "end_seconds": 258.02,
      "duration_seconds": 9.73,
      "text": "Okay: temp 36.6 degrees, respiratory rate 16, saturation 99 percent, BP is 108 over 73, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.0,
      "end_seconds": 262.03,
      "duration_seconds": 2.03,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.11,
      "end_seconds": 265.76,
      "duration_seconds": 1.65,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.2,
      "end_seconds": 269.52,
      "duration_seconds": 2.32,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.12,
      "end_seconds": 287.62,
      "duration_seconds": 8.5,
      "text": "The left testicle is high, swollen and extremely tender, and the reflex on that side is missing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.56,
      "end_seconds": 300.76,
      "duration_seconds": 8.2,
      "text": "Please sit back down. Let me tell you where I've got to. It fits best with testicular torsion needing emergency surgery."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.26,
      "end_seconds": 303.5,
      "duration_seconds": 2.24,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.68,
      "end_seconds": 317.66,
      "duration_seconds": 12.98,
      "text": "It's reasonable to be concerned, but right now testicular torsion needing emergency surgery is my leading thought, not anything worse. Let's get an urgent scrotal ultrasound, for testicular pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.04,
      "end_seconds": 324.0,
      "duration_seconds": 1.96,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.36,
      "end_seconds": 333.8,
      "duration_seconds": 4.44,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.49,
      "end_seconds": 338.86,
      "duration_seconds": 3.37,
      "text": "Ah, thank you, doctor, goodbye."
    }
  ]
