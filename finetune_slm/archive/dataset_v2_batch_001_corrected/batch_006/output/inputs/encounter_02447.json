{
  "schema_version": "1.0",
  "encounter_id": "02447",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 4.33,
      "duration_seconds": 3.6,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.94,
      "end_seconds": 9.98,
      "duration_seconds": 5.04,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.85,
      "end_seconds": 18.21,
      "duration_seconds": 6.36,
      "text": "Um, so... pain going up to the tummy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.82,
      "end_seconds": 22.67,
      "duration_seconds": 2.85,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.6,
      "end_seconds": 26.36,
      "duration_seconds": 2.76,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.33,
      "end_seconds": 38.85,
      "duration_seconds": 10.52,
      "text": "so, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.73,
      "end_seconds": 60.19,
      "duration_seconds": 19.46,
      "text": "Sorry, uh, what was I saying, it feels mild to me. I'd say a few times a day. I've been reading about it online and it worried me. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.7,
      "end_seconds": 75.1,
      "duration_seconds": 2.4,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.47,
      "end_seconds": 85.18,
      "duration_seconds": 2.71,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.67,
      "end_seconds": 110.2,
      "duration_seconds": 9.53,
      "text": "Okay: oxygen saturation is 98 percent, temperature is 36.4 degrees, heart rate 81. And pressure 118 over 75."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.11,
      "end_seconds": 114.09,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.98,
      "end_seconds": 118.19,
      "duration_seconds": 3.21,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.0,
      "end_seconds": 123.63,
      "duration_seconds": 2.63,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.0,
      "end_seconds": 128.1,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.04,
      "end_seconds": 143.27,
      "duration_seconds": 7.23,
      "text": "The left testicle is high, swollen and extremely tender, and the reflex on that side is missing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.54,
      "end_seconds": 146.05,
      "duration_seconds": 1.51,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.08,
      "end_seconds": 153.61,
      "duration_seconds": 4.53,
      "text": "All finished, thank you. Have you noticed discharge or injury?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.76,
      "end_seconds": 157.14,
      "duration_seconds": 2.38,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.31,
      "end_seconds": 160.47,
      "duration_seconds": 2.16,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.62,
      "end_seconds": 163.16,
      "duration_seconds": 1.54,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.01,
      "end_seconds": 167.62,
      "duration_seconds": 3.61,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.12,
      "end_seconds": 171.33,
      "duration_seconds": 2.21,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.95,
      "end_seconds": 183.99,
      "duration_seconds": 2.04,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.89,
      "end_seconds": 188.77,
      "duration_seconds": 3.88,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.63,
      "end_seconds": 192.65,
      "duration_seconds": 2.02,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.2,
      "end_seconds": 197.49,
      "duration_seconds": 3.29,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.28,
      "end_seconds": 206.04,
      "duration_seconds": 6.76,
      "text": "Okay, which medicines do you take at the moment? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.0,
      "end_seconds": 210.9,
      "duration_seconds": 3.9,
      "text": "It's levetiracetam, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.15,
      "end_seconds": 214.89,
      "duration_seconds": 2.74,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.36,
      "end_seconds": 217.76,
      "duration_seconds": 1.4,
      "text": "I have epilepsy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.49,
      "end_seconds": 220.58,
      "duration_seconds": 2.09,
      "text": "Right, right. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.89,
      "end_seconds": 224.88,
      "duration_seconds": 2.99,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.55,
      "end_seconds": 229.77,
      "duration_seconds": 4.22,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.71,
      "end_seconds": 233.11,
      "duration_seconds": 1.4,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.29,
      "end_seconds": 262.08,
      "duration_seconds": 13.79,
      "text": "Right, here's what I'm thinking. This is probably testicular torsion needing emergency surgery. So, to recap quickly. You've had pain going up to the tummy for three days, mild, and no fever or injury."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.15,
      "end_seconds": 263.85,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.09,
      "end_seconds": 311.92,
      "duration_seconds": 33.83,
      "text": "We should do an urgent surgical exploration for possible torsion. That will help us see what's going on underneath and decide the next step. I think an urgent scrotal ultrasound makes sense here, for testicular pain. It's a routine test and it'll give us a much clearer picture. Do not eat or drink, you are going to theatre now. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.65,
      "end_seconds": 316.85,
      "duration_seconds": 3.2,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.06,
      "end_seconds": 318.76,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.43,
      "end_seconds": 322.06,
      "duration_seconds": 2.63,
      "text": "that's all from me any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.04,
      "end_seconds": 330.29,
      "duration_seconds": 6.25,
      "text": "Sorry, what was I saying, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.68,
      "end_seconds": 333.02,
      "duration_seconds": 1.34,
      "text": "see you soon"
    }
  ]
}