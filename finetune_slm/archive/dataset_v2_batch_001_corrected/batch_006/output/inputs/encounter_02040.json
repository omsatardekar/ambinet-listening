{
  "schema_version": "1.0",
  "encounter_id": "02040",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 6.22,
      "duration_seconds": 5.1,
      "text": "Actually, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.06,
      "end_seconds": 11.28,
      "duration_seconds": 4.22,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.68,
      "end_seconds": 21.44,
      "duration_seconds": 8.76,
      "text": "Mainly cramping in my calves when I walk. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.17,
      "end_seconds": 28.41,
      "duration_seconds": 3.24,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.23,
      "end_seconds": 34.4,
      "duration_seconds": 4.17,
      "text": "It's been about three months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.37,
      "end_seconds": 41.95,
      "duration_seconds": 5.58,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.95,
      "end_seconds": 53.9,
      "duration_seconds": 10.95,
      "text": "I, I get some relief from stopping. I'd say moderate. It's worse with walking. And a slow-healing toe sore, too"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.76,
      "end_seconds": 63.16,
      "duration_seconds": 7.4,
      "text": "Have you had cramping in your calves when you walk before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 70.5,
      "duration_seconds": 5.53,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.44,
      "end_seconds": 89.72,
      "duration_seconds": 2.28,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.63,
      "end_seconds": 93.14,
      "duration_seconds": 1.51,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.17,
      "end_seconds": 97.02,
      "duration_seconds": 1.85,
      "text": "Alright, what about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.83,
      "end_seconds": 99.3,
      "duration_seconds": 1.47,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.69,
      "end_seconds": 101.99,
      "duration_seconds": 1.3,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.99,
      "end_seconds": 107.34,
      "duration_seconds": 4.35,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.1,
      "end_seconds": 110.39,
      "duration_seconds": 2.29,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.94,
      "end_seconds": 114.94,
      "duration_seconds": 4.0,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.31,
      "end_seconds": 118.0,
      "duration_seconds": 1.69,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.46,
      "end_seconds": 125.99,
      "duration_seconds": 2.53,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.75,
      "end_seconds": 130.62,
      "duration_seconds": 3.87,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.67,
      "end_seconds": 135.23,
      "duration_seconds": 2.56,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.17,
      "end_seconds": 139.75,
      "duration_seconds": 2.58,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.12,
      "end_seconds": 144.03,
      "duration_seconds": 2.91,
      "text": "it's Glycomet, twice a day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.91,
      "end_seconds": 147.39,
      "duration_seconds": 2.48,
      "text": "And And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.39,
      "end_seconds": 155.9,
      "duration_seconds": 6.51,
      "text": "it's 500 milligrams i was on gliclazide before i stopped taking it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.31,
      "end_seconds": 176.26,
      "duration_seconds": 5.95,
      "text": "So, did you get back pain, pain at rest or chest pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.01,
      "end_seconds": 185.01,
      "duration_seconds": 7.0,
      "text": "I haven't had back pain, pain at rest or chest pain, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.83,
      "end_seconds": 189.31,
      "duration_seconds": 2.48,
      "text": "and fever, any of that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.4,
      "end_seconds": 197.69,
      "duration_seconds": 2.29,
      "text": "no, none, no fever"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.22,
      "end_seconds": 200.71,
      "duration_seconds": 2.49,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.38,
      "end_seconds": 205.1,
      "duration_seconds": 2.72,
      "text": "right, no, that's all fine"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.14,
      "end_seconds": 208.48,
      "duration_seconds": 1.34,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.09,
      "end_seconds": 211.14,
      "duration_seconds": 2.05,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.66,
      "end_seconds": 216.26,
      "duration_seconds": 2.6,
      "text": "okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.21,
      "end_seconds": 220.16,
      "duration_seconds": 1.95,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.78,
      "end_seconds": 235.12,
      "duration_seconds": 6.34,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.19,
      "end_seconds": 240.1,
      "duration_seconds": 1.91,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.91,
      "end_seconds": 260.84,
      "duration_seconds": 7.93,
      "text": "okay, thinking it through, this is probably peripheral arterial disease i'm gonna order an ankle-brachial index, for claudication"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 262.06,
      "end_seconds": 264.49,
      "duration_seconds": 2.43,
      "text": "the earliest is Thursday, 2 pm"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.95,
      "end_seconds": 266.85,
      "duration_seconds": 0.9,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.08,
      "end_seconds": 294.13,
      "duration_seconds": 26.05,
      "text": "A cholesterol test is what I'd like next, for arterial disease. I'd like you to take clopidogrel, 75 milligrams, once a day, long term. You take it by mouth. It's for arterial disease. The pharmacy will go through the details again when you pick it up. We'll catch up in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.21,
      "end_seconds": 298.42,
      "duration_seconds": 3.21,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.27,
      "end_seconds": 300.85,
      "duration_seconds": 1.58,
      "text": "Have a good day."
    }
  ]
}