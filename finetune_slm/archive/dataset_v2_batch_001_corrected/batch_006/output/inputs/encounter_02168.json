{
  "schema_version": "1.0",
  "encounter_id": "02168",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 3.8,
      "duration_seconds": 3.11,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.3,
      "end_seconds": 8.94,
      "duration_seconds": 3.64,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.43,
      "end_seconds": 19.42,
      "duration_seconds": 4.99,
      "text": "I've been dealing with my face drooping on the right."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.08,
      "end_seconds": 22.33,
      "duration_seconds": 1.25,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.41,
      "end_seconds": 26.66,
      "duration_seconds": 3.25,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 31.44,
      "duration_seconds": 4.19,
      "text": "So, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.17,
      "end_seconds": 34.37,
      "duration_seconds": 1.2,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.08,
      "end_seconds": 41.26,
      "duration_seconds": 6.18,
      "text": "Any slurred speech, weakness in the arm or leg, headache or rash in the ear?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.19,
      "end_seconds": 51.93,
      "duration_seconds": 8.74,
      "text": "No slurred speech, weakness in the arm or leg, headache or rash in the ear, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.23,
      "end_seconds": 55.61,
      "duration_seconds": 2.38,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.69,
      "end_seconds": 59.19,
      "duration_seconds": 1.5,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.46,
      "end_seconds": 76.16,
      "duration_seconds": 3.7,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.65,
      "end_seconds": 83.65,
      "duration_seconds": 4.0,
      "text": "It's thyroxine, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.2,
      "end_seconds": 86.27,
      "duration_seconds": 2.07,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.98,
      "end_seconds": 91.83,
      "duration_seconds": 4.85,
      "text": "75 micrograms, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 100.91,
      "duration_seconds": 4.2,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.92,
      "end_seconds": 105.78,
      "duration_seconds": 2.86,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.53,
      "end_seconds": 110.41,
      "duration_seconds": 2.88,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.55,
      "end_seconds": 116.29,
      "duration_seconds": 4.74,
      "text": "I've had an underactive thyroid for about a year now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.76,
      "end_seconds": 131.73,
      "duration_seconds": 1.97,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.84,
      "end_seconds": 141.44,
      "duration_seconds": 3.6,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.62,
      "end_seconds": 147.26,
      "duration_seconds": 4.64,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.21,
      "end_seconds": 151.22,
      "duration_seconds": 3.01,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.04,
      "end_seconds": 161.17,
      "duration_seconds": 2.13,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.87,
      "end_seconds": 165.16,
      "duration_seconds": 2.29,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.85,
      "end_seconds": 168.06,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.61,
      "end_seconds": 174.04,
      "duration_seconds": 4.43,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.64,
      "end_seconds": 180.98,
      "duration_seconds": 3.34,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.98,
      "end_seconds": 191.52,
      "duration_seconds": 2.54,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.96,
      "end_seconds": 214.6,
      "duration_seconds": 6.64,
      "text": "Okay: temp 36.9 degrees, heart rate 77, BP is 113 over 79."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.96,
      "end_seconds": 218.0,
      "duration_seconds": 2.04,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.81,
      "end_seconds": 221.03,
      "duration_seconds": 2.22,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.69,
      "end_seconds": 226.23,
      "duration_seconds": 3.54,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.58,
      "end_seconds": 241.71,
      "duration_seconds": 1.13,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.5,
      "end_seconds": 245.91,
      "duration_seconds": 2.41,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.8,
      "end_seconds": 268.3,
      "duration_seconds": 8.5,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.11,
      "end_seconds": 293.8,
      "duration_seconds": 19.69,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. The most likely explanation is Bell's palsy. Let me just check I've got this right. You've had your face drooping on the right, since yesterday, severe, and no slurred speech or rash in the ear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.48,
      "end_seconds": 297.06,
      "duration_seconds": 1.58,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.9,
      "end_seconds": 330.75,
      "duration_seconds": 31.85,
      "text": "We'll begin with prednisolone, 50 milligrams, once a day, ten days. It's for Bell's palsy. The pharmacy will go through the details again when you pick it up. Use eye drops and tape the eye shut at night to protect it. Please don't wait if you get weakness in an arm or leg. That's when to be seen urgently. Book a review in one week. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.22,
      "end_seconds": 334.71,
      "duration_seconds": 2.49,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.3,
      "end_seconds": 336.68,
      "duration_seconds": 1.38,
      "text": "Look after yourself."
    }
  ]
}