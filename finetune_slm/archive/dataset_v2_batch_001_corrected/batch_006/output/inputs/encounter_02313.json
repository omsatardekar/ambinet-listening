{
  "schema_version": "1.0",
  "encounter_id": "02313",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 6.86,
      "duration_seconds": 5.48,
      "text": "good morning. I've just opened your notes. You came on your own today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.53,
      "end_seconds": 11.82,
      "duration_seconds": 3.29,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.05,
      "end_seconds": 19.73,
      "duration_seconds": 2.68,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.44,
      "end_seconds": 30.12,
      "duration_seconds": 9.68,
      "text": "mainly burning pain in the upper tummy there's a couple of other things, um, but that's the main one"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.79,
      "end_seconds": 34.97,
      "duration_seconds": 3.18,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.86,
      "end_seconds": 39.49,
      "duration_seconds": 2.63,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.8,
      "end_seconds": 43.33,
      "duration_seconds": 2.53,
      "text": "what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.91,
      "end_seconds": 51.84,
      "duration_seconds": 6.93,
      "text": "It's worse with an empty stomach. I've also been feeling full quickly, for ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.99,
      "end_seconds": 73.82,
      "duration_seconds": 6.83,
      "text": "Let me check a few things. Any black stools, difficulty swallowing or weight loss?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.58,
      "end_seconds": 81.46,
      "duration_seconds": 2.88,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.9,
      "end_seconds": 86.41,
      "duration_seconds": 3.51,
      "text": "Have you had vomiting blood, by any chance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.72,
      "end_seconds": 93.74,
      "duration_seconds": 2.02,
      "text": "No, no vomiting blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.93,
      "end_seconds": 97.17,
      "duration_seconds": 2.24,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.85,
      "end_seconds": 101.87,
      "duration_seconds": 4.02,
      "text": "right, um, no, that's all fine"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.18,
      "end_seconds": 105.19,
      "duration_seconds": 2.01,
      "text": "okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.96,
      "end_seconds": 108.83,
      "duration_seconds": 2.87,
      "text": "Mm, no, not at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.65,
      "end_seconds": 112.97,
      "duration_seconds": 3.32,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.54,
      "end_seconds": 120.63,
      "duration_seconds": 3.09,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.1,
      "end_seconds": 129.38,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.41,
      "end_seconds": 133.81,
      "duration_seconds": 3.4,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.44,
      "end_seconds": 138.53,
      "duration_seconds": 3.09,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.09,
      "end_seconds": 143.31,
      "duration_seconds": 3.22,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.37,
      "end_seconds": 159.02,
      "duration_seconds": 3.65,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.59,
      "end_seconds": 163.46,
      "duration_seconds": 2.87,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.15,
      "end_seconds": 167.11,
      "duration_seconds": 2.96,
      "text": "So, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.97,
      "end_seconds": 172.61,
      "duration_seconds": 4.64,
      "text": "Yeah, I'm on ibuprofen, three times a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.66,
      "end_seconds": 177.39,
      "duration_seconds": 2.73,
      "text": "and and what strength is that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.93,
      "end_seconds": 179.28,
      "duration_seconds": 1.35,
      "text": "It's 400 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.85,
      "end_seconds": 182.82,
      "duration_seconds": 2.97,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.38,
      "end_seconds": 185.86,
      "duration_seconds": 2.48,
      "text": "my mother had a stroke"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.72,
      "end_seconds": 191.59,
      "duration_seconds": 4.87,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.64,
      "end_seconds": 204.94,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.25,
      "end_seconds": 234.62,
      "duration_seconds": 8.37,
      "text": "Okay: temp 36.7 degrees, SpO2 99 percent on room air, heart rate 81, BP is 121 over 81."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.52,
      "end_seconds": 237.97,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.28,
      "end_seconds": 243.11,
      "duration_seconds": 3.83,
      "text": "so, don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.81,
      "end_seconds": 250.12,
      "duration_seconds": 4.31,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.05,
      "end_seconds": 254.3,
      "duration_seconds": 2.25,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.02,
      "end_seconds": 269.43,
      "duration_seconds": 4.41,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.73,
      "end_seconds": 289.6,
      "duration_seconds": 14.87,
      "text": "Please sit back down. From what you've told me and what I found, I'd lean towards a possible stomach ulcer from anti-inflammatory tablets. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.52,
      "end_seconds": 328.3,
      "duration_seconds": 24.78,
      "text": "Let's get a stool test for helicobacter, for dyspepsia. We'll begin with omeprazole, 20 milligrams, once a day, eight weeks. You take it by mouth. It's for stomach ulcer. Stop the ibuprofen and use paracetamol for the knee pain instead. See me again in six weeks. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.36,
      "end_seconds": 339.13,
      "duration_seconds": 9.77,
      "text": "So, I take the omeprazole, 20 milligrams, once a day and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.43,
      "end_seconds": 348.6,
      "duration_seconds": 6.17,
      "text": "Yes, exactly right. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.49,
      "end_seconds": 353.5,
      "duration_seconds": 3.01,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.43,
      "end_seconds": 358.84,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
}