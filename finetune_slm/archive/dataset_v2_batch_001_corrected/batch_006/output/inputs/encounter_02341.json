{
  "schema_version": "1.0",
  "encounter_id": "02341",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 5.75,
      "duration_seconds": 4.58,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.13,
      "end_seconds": 8.38,
      "duration_seconds": 1.25,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.77,
      "end_seconds": 12.45,
      "duration_seconds": 2.68,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.25,
      "end_seconds": 19.86,
      "duration_seconds": 5.61,
      "text": "Um, so... being very breathless. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.18,
      "end_seconds": 25.28,
      "duration_seconds": 4.1,
      "text": "So, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.0,
      "end_seconds": 29.76,
      "duration_seconds": 3.76,
      "text": "Oh, for about four days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.18,
      "end_seconds": 36.57,
      "duration_seconds": 5.39,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.53,
      "end_seconds": 62.55,
      "duration_seconds": 25.02,
      "text": "Lying flat definitely sets it off. I'd give it a five, you know, out of ten. As for pounding heart, I honestly can't say when that began. It might have been last month or the month before. Okay, so I'd been sweating, but that went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.72,
      "end_seconds": 66.0,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.31,
      "end_seconds": 70.59,
      "duration_seconds": 3.28,
      "text": "I take metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.37,
      "end_seconds": 75.36,
      "duration_seconds": 2.99,
      "text": "Right, do you know the dose?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.81,
      "end_seconds": 86.37,
      "duration_seconds": 9.56,
      "text": "50 milligrams. Atorvastatin, 20 milligrams, at night for my cholesterol. Glimepiride. I take it 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.27,
      "end_seconds": 89.41,
      "duration_seconds": 2.14,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.0,
      "end_seconds": 99.46,
      "duration_seconds": 8.46,
      "text": "Right, you know, yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.57,
      "end_seconds": 111.88,
      "duration_seconds": 4.31,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.65,
      "end_seconds": 117.37,
      "duration_seconds": 3.72,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 123.75,
      "duration_seconds": 4.64,
      "text": "So, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.65,
      "end_seconds": 146.41,
      "duration_seconds": 20.76,
      "text": "Erm, yes, high blood pressure. I told myself I'd wait and see, and here I am. I kept putting it off, which I know isn't sensible. Yes, heart failure. I've had high cholesterol for five years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.25,
      "end_seconds": 148.62,
      "duration_seconds": 1.37,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.45,
      "end_seconds": 152.55,
      "duration_seconds": 2.1,
      "text": "Diabetes, for five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.63,
      "end_seconds": 160.05,
      "duration_seconds": 5.42,
      "text": "Alright, diabetes, that matches what I have here. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.18,
      "end_seconds": 162.76,
      "duration_seconds": 1.58,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.73,
      "end_seconds": 166.31,
      "duration_seconds": 2.58,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.16,
      "end_seconds": 172.47,
      "duration_seconds": 4.31,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.98,
      "end_seconds": 176.6,
      "duration_seconds": 2.62,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.05,
      "end_seconds": 182.31,
      "duration_seconds": 4.26,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.33,
      "end_seconds": 185.31,
      "duration_seconds": 1.98,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.13,
      "end_seconds": 192.0,
      "duration_seconds": 2.87,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.21,
      "end_seconds": 207.51,
      "duration_seconds": 3.3,
      "text": "Any fever, calf pain or wheeze at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.47,
      "end_seconds": 212.38,
      "duration_seconds": 3.91,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.51,
      "end_seconds": 222.4,
      "duration_seconds": 3.89,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.55,
      "end_seconds": 226.59,
      "duration_seconds": 3.04,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.5,
      "end_seconds": 231.76,
      "duration_seconds": 3.26,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.93,
      "end_seconds": 237.2,
      "duration_seconds": 4.27,
      "text": "Well, you know, no weakness or anything."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.87,
      "end_seconds": 242.01,
      "duration_seconds": 3.14,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 258.09,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.61,
      "end_seconds": 280.86,
      "duration_seconds": 10.25,
      "text": "Okay: temp 37.2 degrees, pressure 128 over 89, oxygen saturation is 90 percent, pulse is 92 beats a minute, respiratory rate 26."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.66,
      "end_seconds": 285.03,
      "duration_seconds": 2.37,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.81,
      "end_seconds": 289.79,
      "duration_seconds": 2.98,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.57,
      "end_seconds": 304.06,
      "duration_seconds": 6.49,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.41,
      "end_seconds": 309.88,
      "duration_seconds": 2.47,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.4,
      "end_seconds": 343.36,
      "duration_seconds": 22.96,
      "text": "Having listened and examined, I think we're dealing with acute pulmonary oedema at this stage. It could also be a severe chest infection, so we'll keep that open. Let me just check I've got this right. You've had being very breathless for about four days, and no wheeze or calf pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.47,
      "end_seconds": 345.17,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.14,
      "end_seconds": 375.29,
      "duration_seconds": 28.15,
      "text": "Blood tests is what I'd like next, for pulmonary oedema. Let's get a chest X-ray, for pulmonary oedema. An ECG is what I'd like next, for pulmonary oedema. I'm prescribing furosemide, 40 milligrams, once now, single dose. It's for fluid on the lungs. Sit upright, I am giving oxygen and a water tablet injection now. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.13,
      "end_seconds": 384.69,
      "duration_seconds": 7.56,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.47,
      "end_seconds": 387.1,
      "duration_seconds": 1.63,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.74,
      "end_seconds": 391.16,
      "duration_seconds": 3.42,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.89,
      "end_seconds": 399.48,
      "duration_seconds": 3.59,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.1,
      "end_seconds": 402.9,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}