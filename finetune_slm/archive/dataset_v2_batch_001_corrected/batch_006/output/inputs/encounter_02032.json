      "role": "DOCTOR",
      "start_seconds": 35.7,
      "end_seconds": 38.03,
      "duration_seconds": 2.33,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.69,
      "end_seconds": 57.29,
      "duration_seconds": 17.6,
      "text": "when it starts I tend to get a high blood sugar on a routine test as well. Sorry, what was I saying, the high blood sugar on a routine test? That's been for about three months"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.06,
      "end_seconds": 59.98,
      "duration_seconds": 1.92,
