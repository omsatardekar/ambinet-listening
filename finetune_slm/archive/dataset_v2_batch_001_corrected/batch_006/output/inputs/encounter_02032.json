      "start_seconds": 1.31,
      "end_seconds": 7.99,
      "duration_seconds": 6.68,
      "text": "Hello, take a seat, I'll be with you in a second. What's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.79,
      "end_seconds": 13.08,
      "duration_seconds": 3.29,
      "text": "I'm, I'm here cos of no symptoms"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.29,
      "end_seconds": 17.24,
      "duration_seconds": 2.95,
      "text": "What's the timeline, when did it begin?"
    },
