    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.98,
      "end_seconds": 125.01,
      "duration_seconds": 5.03,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.09,
      "end_seconds": 132.88,
      "duration_seconds": 2.79,
      "text": "Before we go further, any allergies?"
