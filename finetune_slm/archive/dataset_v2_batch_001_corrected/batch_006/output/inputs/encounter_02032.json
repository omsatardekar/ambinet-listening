      "role": "PATIENT",
      "start_seconds": 61.79,
      "end_seconds": 64.96,
      "duration_seconds": 3.17,
      "text": "I haven't noticed any frequent urination."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.91,
      "end_seconds": 69.14,
      "duration_seconds": 3.23,
      "text": "and what about blurred vision or thirst?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.16,
      "end_seconds": 73.22,
      "duration_seconds": 3.06,
      "text": "No, no blurred vision or thirst."
