      "role": "DOCTOR",
      "start_seconds": 81.92,
      "end_seconds": 84.69,
      "duration_seconds": 2.77,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.73,
      "end_seconds": 88.87,
      "duration_seconds": 2.14,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.48,
      "end_seconds": 94.26,
      "duration_seconds": 3.78,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.55,
      "end_seconds": 98.14,
      "duration_seconds": 2.59,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.81,
      "end_seconds": 110.68,
      "duration_seconds": 2.87,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.34,
      "end_seconds": 115.73,
      "duration_seconds": 4.39,
      "text": "I'm on febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.13,
      "end_seconds": 119.23,
      "duration_seconds": 2.1,
      "text": "Any surgery in the past?"
