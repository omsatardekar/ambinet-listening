    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.47,
      "end_seconds": 78.37,
      "duration_seconds": 3.9,
      "text": "Anything on the skin I should know about?"
