{
  "schema_version": "1.0",
  "encounter_id": "02390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 4.32,
      "duration_seconds": 3.81,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.33,
      "end_seconds": 9.68,
      "duration_seconds": 4.35,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.07,
      "end_seconds": 14.53,
      "duration_seconds": 3.46,
      "text": "It's a bump on the head, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.66,
      "end_seconds": 18.45,
      "duration_seconds": 2.79,
      "text": "Okay, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.08,
      "end_seconds": 36.09,
      "duration_seconds": 15.01,
      "text": "I've had it for about a week. I looked a few things up online, and that probably didn't help. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.58,
      "end_seconds": 40.41,
      "duration_seconds": 2.83,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.49,
      "end_seconds": 45.64,
      "duration_seconds": 4.15,
      "text": "Only a cold pack, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.74,
      "end_seconds": 61.28,
      "duration_seconds": 4.54,
      "text": "a a few quick ones: fit or loss of consciousness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.86,
      "end_seconds": 66.62,
      "duration_seconds": 3.76,
      "text": "No, no fit or loss of consciousness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.15,
      "end_seconds": 70.77,
      "duration_seconds": 2.62,
      "text": "any drowsiness or vomiting at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.69,
      "end_seconds": 76.12,
      "duration_seconds": 3.43,
      "text": "Ah, no, no drowsiness or vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.26,
      "end_seconds": 79.74,
      "duration_seconds": 2.48,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.8,
      "end_seconds": 82.53,
      "duration_seconds": 1.73,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.15,
      "end_seconds": 89.47,
      "duration_seconds": 2.32,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.77,
      "end_seconds": 95.9,
      "duration_seconds": 5.13,
      "text": "Oh, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.62,
      "end_seconds": 100.12,
      "duration_seconds": 3.5,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 106.49,
      "duration_seconds": 2.54,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.39,
      "end_seconds": 109.33,
      "duration_seconds": 1.94,
      "text": "Yes. So, any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 114.83,
      "duration_seconds": 3.42,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.67,
      "end_seconds": 117.66,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.74,
      "end_seconds": 125.7,
      "duration_seconds": 3.96,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.4,
      "end_seconds": 130.83,
      "duration_seconds": 3.43,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.46,
      "end_seconds": 136.42,
      "duration_seconds": 3.96,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.34,
      "end_seconds": 147.2,
      "duration_seconds": 2.86,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.61,
      "end_seconds": 151.07,
      "duration_seconds": 2.46,
      "text": "No surgery, uh, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.09,
      "end_seconds": 156.07,
      "duration_seconds": 2.98,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.34,
      "end_seconds": 169.55,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.21,
      "end_seconds": 191.84,
      "duration_seconds": 11.63,
      "text": "Okay: temperature is 36.6 degrees, SpO2 99 percent on room air. And BP is 116 over 69, pulse is 83 beats a minute, respiratory rate 18."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.53,
      "end_seconds": 197.2,
      "duration_seconds": 2.67,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.48,
      "end_seconds": 200.67,
      "duration_seconds": 2.19,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 224.03,
      "duration_seconds": 7.43,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 230.85,
      "duration_seconds": 2.91,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.72,
      "end_seconds": 253.95,
      "duration_seconds": 13.23,
      "text": "Putting it all together, my working impression is a minor head bump with no worrying signs. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.54,
      "end_seconds": 256.04,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.01,
      "end_seconds": 276.4,
      "duration_seconds": 18.39,
      "text": "Nothing I've seen today points to to an emergency. It looks like a minor head bump with no worrying signs. Just to be sure I understood. You've had a bump on the head for about a week, and no loss of consciousness or vomiting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.49,
      "end_seconds": 280.63,
      "duration_seconds": 2.14,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.93,
      "end_seconds": 301.3,
      "duration_seconds": 6.37,
      "text": "Watch him for the next twenty-four hours and give paracetamol if he is sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.51,
      "end_seconds": 310.15,
      "duration_seconds": 8.64,
      "text": "Ah. One warning sign to remember: he vomits repeatedly, becomes drowsy or has a fit. In that case don't wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.46,
      "end_seconds": 313.11,
      "duration_seconds": 1.65,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.05,
      "end_seconds": 324.25,
      "duration_seconds": 10.2,
      "text": "see me again if any vomiting or drowsiness can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.75,
      "end_seconds": 331.74,
      "duration_seconds": 5.99,
      "text": "So, I come back if any vomiting or drowsiness. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.69,
      "end_seconds": 337.01,
      "duration_seconds": 4.32,
      "text": "okay, yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.5,
      "end_seconds": 340.55,
      "duration_seconds": 2.05,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.51,
      "end_seconds": 345.72,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}