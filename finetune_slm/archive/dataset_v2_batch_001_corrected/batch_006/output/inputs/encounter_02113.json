{
  "schema_version": "1.0",
  "encounter_id": "02113",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 4.03,
      "duration_seconds": 2.65,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.02,
      "end_seconds": 8.14,
      "duration_seconds": 3.12,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.81,
      "end_seconds": 12.63,
      "duration_seconds": 2.82,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 28.85,
      "duration_seconds": 14.48,
      "text": "yeah, it's sudden severe pain on the right side of my pelvis i don't know what's causing it i didn't wanna bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.78,
      "end_seconds": 34.02,
      "duration_seconds": 3.24,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.53,
      "end_seconds": 36.39,
      "duration_seconds": 1.86,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.77,
      "end_seconds": 39.57,
      "duration_seconds": 2.8,
      "text": "Hm, okay. Have you had vomiting?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.05,
      "end_seconds": 57.91,
      "duration_seconds": 12.86,
      "text": "Yes, for three days. As for feeling faint, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.94,
      "end_seconds": 62.78,
      "duration_seconds": 2.84,
      "text": "so, how frequently does it it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.83,
      "end_seconds": 68.87,
      "duration_seconds": 4.04,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.08,
      "end_seconds": 78.7,
      "duration_seconds": 9.62,
      "text": "yes. Have you had sudden severe pain on the right side of your pelvis before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.72,
      "end_seconds": 89.4,
      "duration_seconds": 9.68,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 95.14,
      "duration_seconds": 4.16,
      "text": "Any vaginal bleeding, discharge, missed period or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.81,
      "end_seconds": 102.01,
      "duration_seconds": 6.2,
      "text": "um, no vaginal bleeding, discharge, missed period or fever, none of it"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.36,
      "end_seconds": 105.74,
      "duration_seconds": 2.38,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.55,
      "end_seconds": 112.7,
      "duration_seconds": 2.15,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.43,
      "end_seconds": 117.85,
      "duration_seconds": 3.42,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.56,
      "end_seconds": 122.37,
      "duration_seconds": 3.81,
      "text": "I mean, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.4,
      "end_seconds": 126.09,
      "duration_seconds": 2.69,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.69,
      "end_seconds": 130.83,
      "duration_seconds": 3.14,
      "text": "An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.52,
      "end_seconds": 137.63,
      "duration_seconds": 6.11,
      "text": "Mm, okay. Okay, I can see an underactive thyroid in your file as well."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.78,
      "end_seconds": 157.26,
      "duration_seconds": 6.48,
      "text": "tell me your medicines, please it helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.63,
      "end_seconds": 162.73,
      "duration_seconds": 4.1,
      "text": "I take thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.65,
      "end_seconds": 171.79,
      "duration_seconds": 3.14,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.47,
      "end_seconds": 187.53,
      "duration_seconds": 14.06,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 190.35,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.18,
      "end_seconds": 192.22,
      "duration_seconds": 1.04,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.37,
      "end_seconds": 198.09,
      "duration_seconds": 4.72,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.72,
      "end_seconds": 201.92,
      "duration_seconds": 3.2,
      "text": "yes, naproxen. I get a rash"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.53,
      "end_seconds": 206.1,
      "duration_seconds": 2.57,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.54,
      "end_seconds": 219.1,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.19,
      "end_seconds": 236.6,
      "duration_seconds": 5.41,
      "text": "okay: pressure 120 over 79, pulse is 116 beats a minute"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.59,
      "end_seconds": 244.01,
      "duration_seconds": 4.42,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.9,
      "end_seconds": 248.8,
      "duration_seconds": 2.9,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.85,
      "end_seconds": 272.01,
      "duration_seconds": 5.16,
      "text": "You are in severe pain with a tender mass low on the right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.07,
      "end_seconds": 279.94,
      "duration_seconds": 2.87,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.88,
      "end_seconds": 302.2,
      "duration_seconds": 6.32,
      "text": "From what you've told me and what I found, this is probably possible ovarian torsion."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.85,
      "end_seconds": 306.75,
      "duration_seconds": 2.9,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.5,
      "end_seconds": 314.94,
      "duration_seconds": 7.44,
      "text": "It's reasonable to be concerned, but right now possible ovarian torsion is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.75,
      "end_seconds": 355.41,
      "duration_seconds": 24.66,
      "text": "I'm going to order a pregnancy test, for pelvic pain. That will help us see what's going on underneath and decide the next step. You need an emergency scan and probably surgery today. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.03,
      "end_seconds": 360.51,
      "duration_seconds": 3.48,
      "text": "well, no, that's all thanks a lot"
    }
  ]
}