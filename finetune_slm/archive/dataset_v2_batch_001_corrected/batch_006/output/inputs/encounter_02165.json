  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 2.99,
      "duration_seconds": 1.68,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.19,
      "end_seconds": 5.15,
      "duration_seconds": 0.96,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 8.29,
      "duration_seconds": 1.74,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.83,
      "end_seconds": 13.95,
      "duration_seconds": 4.12,
      "text": "I've been dealing with breathlessness months after the infection."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.52,
      "end_seconds": 17.88,
      "duration_seconds": 3.36,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.71,
      "end_seconds": 22.4,
      "duration_seconds": 2.69,
      "text": "I've had it since last weekend."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.91,
      "end_seconds": 27.81,
      "duration_seconds": 4.9,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.17,
      "end_seconds": 39.3,
      "duration_seconds": 10.13,
      "text": "Honestly, every other day. It's severe, honestly. Let me think, I've had a racing heart on standing too, for three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.46,
      "end_seconds": 44.66,
      "duration_seconds": 4.2,
      "text": "Have you had any fever, chest pain or leg swelling?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.61,
      "end_seconds": 52.9,
      "duration_seconds": 6.29,
      "text": "Sorry, what was I saying, no, no fever, chest pain or leg swelling."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.72,
      "end_seconds": 57.07,
      "duration_seconds": 3.35,
      "text": "Has there been any coughing up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 63.58,
      "duration_seconds": 3.2,
      "text": "I haven't noticed any coughing up blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.63,
      "end_seconds": 67.87,
      "duration_seconds": 2.24,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.81,
      "end_seconds": 73.9,
      "duration_seconds": 5.09,
      "text": "Let me think, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.68,
      "end_seconds": 81.28,
      "duration_seconds": 3.6,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.28,
      "end_seconds": 83.35,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.37,
      "end_seconds": 87.18,
      "duration_seconds": 2.81,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.48,
      "end_seconds": 90.64,
      "duration_seconds": 2.16,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.83,
      "end_seconds": 109.48,
      "duration_seconds": 3.65,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.29,
      "end_seconds": 113.4,
      "duration_seconds": 3.11,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.56,
      "end_seconds": 118.62,
      "duration_seconds": 4.06,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.64,
      "end_seconds": 133.84,
      "duration_seconds": 14.2,
      "text": "I drink a lot of tea and snack through the day. I retired from the post office two years ago. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.01,
      "end_seconds": 152.08,
      "duration_seconds": 5.07,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.2,
      "end_seconds": 157.08,
      "duration_seconds": 3.88,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.81,
      "end_seconds": 159.03,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.92,
      "end_seconds": 163.29,
      "duration_seconds": 3.37,
      "text": "Erm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.16,
      "end_seconds": 166.51,
      "duration_seconds": 2.35,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.9,
      "end_seconds": 175.02,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.34,
      "end_seconds": 200.05,
      "duration_seconds": 15.71,
      "text": "Okay: pulse 64, temperature is 36.7 degrees, blood pressure 113 over 79, oxygen saturation is 97 percent, respiratory rate 18, BMI works out to 24.9, height 170 centimetres, weight 72 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.07,
      "end_seconds": 203.12,
      "duration_seconds": 2.05,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.19,
      "end_seconds": 206.7,
      "duration_seconds": 2.51,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 213.14,
      "duration_seconds": 4.38,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.09,
      "end_seconds": 232.95,
      "duration_seconds": 2.86,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.03,
      "end_seconds": 236.2,
      "duration_seconds": 2.17,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.79,
      "end_seconds": 257.18,
      "duration_seconds": 6.39,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.3,
      "end_seconds": 267.17,
      "duration_seconds": 7.87,
      "text": "That's all I needed to check. Taking everything into account, my working impression is post-viral symptoms after COVID."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.18,
      "end_seconds": 287.03,
      "duration_seconds": 4.85,
      "text": "I'll request a chest X-ray, it'll help with persistent breathlessness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.99,
      "end_seconds": 290.68,
      "duration_seconds": 2.69,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.28,
      "end_seconds": 309.58,
      "duration_seconds": 18.3,
      "text": "Let's get blood tests, for post-viral fatigue. Pace your activity and increase it slowly each week. Let's get you seen by the post-COVID clinic, I'll arrange the letter. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.88,
      "end_seconds": 314.23,
      "duration_seconds": 3.35,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.3,
      "end_seconds": 319.43,
      "duration_seconds": 3.13,
      "text": "Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.29,
      "end_seconds": 323.93,
      "duration_seconds": 2.64,
      "text": "Yeah, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.52,
      "end_seconds": 327.38,
      "duration_seconds": 2.86,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.56,
      "end_seconds": 332.59,
      "duration_seconds": 4.03,
      "text": "Good, uh, thanks, I'll see you then."
    }
  ]
