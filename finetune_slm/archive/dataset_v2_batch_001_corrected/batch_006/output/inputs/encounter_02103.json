{
  "schema_version": "1.0",
  "encounter_id": "02103",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 4.96,
      "duration_seconds": 4.39,
      "text": "Uh, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 11.68,
      "duration_seconds": 4.64,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.71,
      "end_seconds": 21.09,
      "duration_seconds": 7.38,
      "text": "It's a nosebleed that won't stop. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.8,
      "end_seconds": 25.48,
      "duration_seconds": 2.68,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.78,
      "end_seconds": 36.8,
      "duration_seconds": 2.02,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.62,
      "end_seconds": 65.36,
      "duration_seconds": 10.74,
      "text": "Okay: temp 36.9 degrees, respiratory rate 17, saturation 98 percent, pulse 75, pressure 116 over 71. Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.32,
      "end_seconds": 69.8,
      "duration_seconds": 2.48,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 80.41,
      "duration_seconds": 10.11,
      "text": "Okay, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.85,
      "end_seconds": 93.16,
      "duration_seconds": 8.31,
      "text": "I'd say severe. Pinching helps a bit. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.11,
      "end_seconds": 96.17,
      "duration_seconds": 2.06,
      "text": "Have you been feeling lightheaded?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.12,
      "end_seconds": 101.97,
      "duration_seconds": 3.85,
      "text": "Right, yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.35,
      "end_seconds": 124.36,
      "duration_seconds": 5.01,
      "text": "Have you noticed easy bruising, head injury or black stools?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.88,
      "end_seconds": 133.58,
      "duration_seconds": 5.7,
      "text": "I haven't had easy bruising, head injury or black stools, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.64,
      "end_seconds": 137.63,
      "duration_seconds": 1.99,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.59,
      "end_seconds": 141.23,
      "duration_seconds": 2.64,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.33,
      "end_seconds": 148.54,
      "duration_seconds": 3.21,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.7,
      "end_seconds": 175.23,
      "duration_seconds": 25.53,
      "text": "I take metoprolol, 50 milligrams, twice a day. I take thyroxine, 75 micrograms, every morning. A blood thinner, 5 milligrams, twice a day. I looked a few things up online, and that probably didn't help. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.32,
      "end_seconds": 180.49,
      "duration_seconds": 3.17,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.43,
      "end_seconds": 188.45,
      "duration_seconds": 7.02,
      "text": "An irregular heartbeat, for two years. I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.94,
      "end_seconds": 192.82,
      "duration_seconds": 2.88,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.8,
      "end_seconds": 196.89,
      "duration_seconds": 2.09,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.98,
      "end_seconds": 209.79,
      "duration_seconds": 2.81,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.32,
      "end_seconds": 223.24,
      "duration_seconds": 11.92,
      "text": "I drink a lot of tea and snack through the day. I walk the dog every morning. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.43,
      "end_seconds": 228.45,
      "duration_seconds": 4.02,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.92,
      "end_seconds": 249.07,
      "duration_seconds": 2.15,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.65,
      "end_seconds": 253.02,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.25,
      "end_seconds": 272.79,
      "duration_seconds": 7.54,
      "text": "There is a bleeding point on the front of the septum and the nose has been dry."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.76,
      "end_seconds": 277.97,
      "duration_seconds": 2.21,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.1,
      "end_seconds": 298.95,
      "duration_seconds": 11.85,
      "text": "Okay, thinking it through, I'd lean towards an anterior nosebleed on a blood thinner. I'm sending you for a clotting test because of epistaxis on anticoagulant."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 299.45,
      "end_seconds": 301.91,
      "duration_seconds": 2.46,
      "text": "The earliest is Monday, 10 am."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.59,
      "end_seconds": 319.63,
      "duration_seconds": 16.04,
      "text": "Lean forward and pinch the soft part of the nose for fifteen minutes; I will cauterise the point. I'd like you back in one week. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.34,
      "end_seconds": 324.56,
      "duration_seconds": 3.22,
      "text": "Great, thank you for your help."
    }
  ]
}