    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.57,
      "end_seconds": 238.64,
      "duration_seconds": 3.07,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.6,
      "end_seconds": 242.34,
      "duration_seconds": 2.74,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.25,
      "end_seconds": 251.5,
      "duration_seconds": 8.25,
      "text": "Do you have any medical conditions I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.99,
      "end_seconds": 254.64,
      "duration_seconds": 1.65,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.37,
      "end_seconds": 261.22,
      "duration_seconds": 4.85,
      "text": "okay, thinking it through, this looks most like acute pulmonary oedema"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.01,
      "end_seconds": 292.38,
      "duration_seconds": 12.37,
      "text": "I'm gonna order a chest X-ray, for pulmonary oedema. For this, furosemide, 40 milligrams, once now, single dose. That's for fluid on the lungs"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.42,
      "end_seconds": 297.59,
      "duration_seconds": 3.17,
      "text": "is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.91,
      "end_seconds": 313.9,
      "duration_seconds": 11.99,
      "text": "Sit upright I am giving oxygen and a water tablet injection now. See me again straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.71,
      "end_seconds": 318.3,
      "duration_seconds": 3.59,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.39,
