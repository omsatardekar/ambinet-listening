    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.3,
      "end_seconds": 163.24,
      "duration_seconds": 0.94,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.45,
      "end_seconds": 169.83,
      "duration_seconds": 5.38,
      "text": "Right have you noticed any weakness or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.48,
      "end_seconds": 173.71,
      "duration_seconds": 2.23,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.78,
      "end_seconds": 179.44,
      "duration_seconds": 3.66,
      "text": "let me ask about allergies anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.12,
      "end_seconds": 182.21,
      "duration_seconds": 2.09,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.37,
      "end_seconds": 186.21,
      "duration_seconds": 2.84,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.02,
      "end_seconds": 189.65,
      "duration_seconds": 1.63,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 192.83,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.77,
      "end_seconds": 197.55,
      "duration_seconds": 2.78,
      "text": "no surgery, you know, no"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.3,
      "end_seconds": 208.92,
      "duration_seconds": 1.62,
      "text": "and and your job?"
