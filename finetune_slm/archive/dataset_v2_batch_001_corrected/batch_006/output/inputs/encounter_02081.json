      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.16,
      "end_seconds": 35.04,
      "duration_seconds": 7.88,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.56,
      "end_seconds": 44.31,
      "duration_seconds": 5.75,
      "text": "It's worse with lying flat. Only sitting up, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.57,
      "end_seconds": 63.85,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.77,
      "end_seconds": 74.43,
      "duration_seconds": 2.66,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 103.94,
      "duration_seconds": 10.13,
      "text": "okay: pulse 101, height 159 centimetres. And BMI works out to 26.5, temperature 37.5, pressure 129 over 88, weight 67 kilos"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.0,
      "end_seconds": 108.07,
      "duration_seconds": 3.07,
      "text": "okay, time for me to examine you"
