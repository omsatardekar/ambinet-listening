    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.23,
      "end_seconds": 222.01,
      "duration_seconds": 3.78,
      "text": "No, I share a house with my brother."
