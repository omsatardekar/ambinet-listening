    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.97,
      "end_seconds": 214.34,
      "duration_seconds": 3.37,
      "text": "I work in accounts at a hospital."
