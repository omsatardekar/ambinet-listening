      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.96,
      "end_seconds": 110.38,
      "duration_seconds": 1.42,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.06,
      "end_seconds": 133.81,
      "duration_seconds": 6.75,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.63,
      "end_seconds": 141.53,
      "duration_seconds": 4.9,
      "text": "all finished, thank you any wheeze or fever at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.04,
      "end_seconds": 146.05,
      "duration_seconds": 3.01,
      "text": "No none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.38,
      "end_seconds": 150.45,
      "duration_seconds": 3.07,
      "text": "so, has there been any calf pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.2,
      "end_seconds": 155.87,
      "duration_seconds": 3.67,
      "text": "no, I haven't had any calf pain"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.79,
      "end_seconds": 161.08,
      "duration_seconds": 3.29,
      "text": "Anything on the skin I should know about?"
