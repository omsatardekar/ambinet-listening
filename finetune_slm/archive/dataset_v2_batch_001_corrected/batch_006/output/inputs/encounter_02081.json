    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.0,
      "end_seconds": 217.31,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
