{
  "schema_version": "1.0",
  "encounter_id": "02290",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.12,
      "duration_seconds": 4.44,
      "text": "Erm, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.76,
      "end_seconds": 14.47,
      "duration_seconds": 3.71,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.02,
      "end_seconds": 25.65,
      "duration_seconds": 9.63,
      "text": "Honestly, uh, it's a high fever and shivers, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.6,
      "end_seconds": 30.11,
      "duration_seconds": 2.51,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.81,
      "end_seconds": 39.79,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.74,
      "end_seconds": 67.32,
      "duration_seconds": 10.58,
      "text": "Okay: pulse 92, respiratory rate 16, temperature is 36.6 degrees, blood pressure 94 over 64, saturation 97 percent. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.26,
      "end_seconds": 72.15,
      "duration_seconds": 3.89,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.91,
      "end_seconds": 80.16,
      "duration_seconds": 3.25,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.22,
      "end_seconds": 99.31,
      "duration_seconds": 17.09,
      "text": "Severe pain goes along with it, you know, most of the time. So, and I've been feeling very unwell as well. The, The severe pain? That's been for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.53,
      "end_seconds": 107.17,
      "duration_seconds": 6.64,
      "text": "Have you had a high fever and shivers before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.26,
      "end_seconds": 117.39,
      "duration_seconds": 8.13,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.39,
      "end_seconds": 123.8,
      "duration_seconds": 4.41,
      "text": "Let me check a few things. Any recent cut or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.71,
      "end_seconds": 129.47,
      "duration_seconds": 3.76,
      "text": "Actually, no, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.12,
      "end_seconds": 131.5,
      "duration_seconds": 1.38,
      "text": "How about diarrhoea?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.09,
      "end_seconds": 138.63,
      "duration_seconds": 5.54,
      "text": "Sorry, what was I saying, not at all, no diarrhoea."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.17,
      "end_seconds": 142.41,
      "duration_seconds": 3.24,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.87,
      "end_seconds": 146.04,
      "duration_seconds": 2.17,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.06,
      "end_seconds": 151.02,
      "duration_seconds": 3.96,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.55,
      "end_seconds": 155.24,
      "duration_seconds": 2.69,
      "text": "Well, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.0,
      "end_seconds": 157.99,
      "duration_seconds": 1.99,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.7,
      "end_seconds": 169.64,
      "duration_seconds": 10.94,
      "text": "Just my appendix taken out, when I was in my twenties. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.16,
      "end_seconds": 173.71,
      "duration_seconds": 2.55,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.75,
      "end_seconds": 176.64,
      "duration_seconds": 1.89,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 187.0,
      "duration_seconds": 1.29,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.61,
      "end_seconds": 190.41,
      "duration_seconds": 2.8,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.15,
      "end_seconds": 193.73,
      "duration_seconds": 1.58,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.24,
      "end_seconds": 201.88,
      "duration_seconds": 6.64,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.88,
      "end_seconds": 207.81,
      "duration_seconds": 3.93,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.94,
      "end_seconds": 212.7,
      "duration_seconds": 3.76,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.0,
      "end_seconds": 217.31,
      "duration_seconds": 3.31,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.65,
      "end_seconds": 222.87,
      "duration_seconds": 4.22,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.02,
      "end_seconds": 235.9,
      "duration_seconds": 2.88,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.88,
      "end_seconds": 239.31,
      "duration_seconds": 2.43,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.99,
      "end_seconds": 250.05,
      "duration_seconds": 9.06,
      "text": "Yes, diabetes is known to us, good to have that clear. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.35,
      "end_seconds": 256.86,
      "duration_seconds": 5.51,
      "text": "Yes, diclofenac, it gives me swelling of my lips."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.11,
      "end_seconds": 262.64,
      "duration_seconds": 3.53,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.59,
      "end_seconds": 266.68,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.79,
      "end_seconds": 282.31,
      "duration_seconds": 7.52,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.79,
      "end_seconds": 299.86,
      "duration_seconds": 12.07,
      "text": "You can sit up now. From what you've told me and what I found, the most likely explanation is a possible necrotising soft tissue infection."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.03,
      "end_seconds": 319.6,
      "duration_seconds": 9.57,
      "text": "I want an urgent surgical review done, that's for possible necrotising infection. You need emergency surgery and intravenous antibiotics, we are going now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.15,
      "end_seconds": 331.38,
      "duration_seconds": 11.23,
      "text": "Ah. I'll also refer you to the surgical team. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.76,
      "end_seconds": 334.46,
      "duration_seconds": 1.7,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.41,
      "end_seconds": 341.62,
      "duration_seconds": 6.21,
      "text": "Book a review straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.24,
      "end_seconds": 345.6,
      "duration_seconds": 2.36,
      "text": "Thank you, that's helpful."
    }
  ]
}