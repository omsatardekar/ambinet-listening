{
  "schema_version": "1.0",
  "encounter_id": "02121",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.92,
      "duration_seconds": 3.53,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.56,
      "duration_seconds": 3.74,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.07,
      "end_seconds": 20.17,
      "duration_seconds": 5.1,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.64,
      "end_seconds": 25.59,
      "duration_seconds": 3.95,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.93,
      "end_seconds": 33.1,
      "duration_seconds": 6.17,
      "text": "Doctor, it's pain in the lower left tummy. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.67,
      "end_seconds": 40.1,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.89,
      "end_seconds": 44.96,
      "duration_seconds": 3.07,
      "text": "It's been about two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.55,
      "end_seconds": 48.66,
      "duration_seconds": 3.11,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.84,
      "end_seconds": 54.35,
      "duration_seconds": 4.51,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.88,
      "end_seconds": 57.48,
      "duration_seconds": 1.6,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.63,
      "end_seconds": 62.1,
      "duration_seconds": 3.47,
      "text": "Yes, moving. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.09,
      "end_seconds": 66.96,
      "duration_seconds": 2.87,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.38,
      "end_seconds": 75.35,
      "duration_seconds": 6.97,
      "text": "Honestly, every other day. And there's constipation then loose stools as well, two months now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.99,
      "end_seconds": 78.03,
      "duration_seconds": 2.04,
      "text": "Have you been feeling bloated?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.79,
      "end_seconds": 82.1,
      "duration_seconds": 2.31,
      "text": "Yes, for three days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.51,
      "end_seconds": 86.29,
      "duration_seconds": 2.78,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.89,
      "end_seconds": 89.91,
      "duration_seconds": 3.02,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 94.49,
      "duration_seconds": 2.78,
      "text": "Any a low fever as well?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.55,
      "end_seconds": 99.9,
      "duration_seconds": 3.35,
      "text": "Yes, about the same, six months."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.65,
      "end_seconds": 104.48,
      "duration_seconds": 2.83,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 109.79,
      "duration_seconds": 3.32,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.57,
      "end_seconds": 118.49,
      "duration_seconds": 6.92,
      "text": "Have you had pain in the lower left tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.92,
      "end_seconds": 125.15,
      "duration_seconds": 5.23,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.21,
      "end_seconds": 129.37,
      "duration_seconds": 3.16,
      "text": "Alright, any urinary symptoms or weight loss?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.92,
      "end_seconds": 134.59,
      "duration_seconds": 4.67,
      "text": "No urinary symptoms or weight loss, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.39,
      "end_seconds": 138.17,
      "duration_seconds": 2.78,
      "text": "Any blood in the stool or vomiting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.21,
      "end_seconds": 142.13,
      "duration_seconds": 1.92,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.0,
      "end_seconds": 146.99,
      "duration_seconds": 3.99,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.69,
      "end_seconds": 150.28,
      "duration_seconds": 1.59,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.8,
      "end_seconds": 154.63,
      "duration_seconds": 2.83,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.63,
      "end_seconds": 157.68,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.93,
      "end_seconds": 161.62,
      "duration_seconds": 2.69,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.25,
      "end_seconds": 166.08,
      "duration_seconds": 3.83,
      "text": "Yes, milk, it gives me a rash."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.61,
      "end_seconds": 168.37,
      "duration_seconds": 1.76,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.46,
      "end_seconds": 171.28,
      "duration_seconds": 1.82,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.98,
      "end_seconds": 174.29,
      "duration_seconds": 1.31,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.73,
      "end_seconds": 179.83,
      "duration_seconds": 4.1,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.29,
      "end_seconds": 183.42,
      "duration_seconds": 2.13,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.02,
      "end_seconds": 189.32,
      "duration_seconds": 4.3,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.14,
      "end_seconds": 194.4,
      "duration_seconds": 4.26,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.33,
      "end_seconds": 198.99,
      "duration_seconds": 3.66,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.55,
      "end_seconds": 217.7,
      "duration_seconds": 3.15,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.79,
      "end_seconds": 221.06,
      "duration_seconds": 2.27,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.84,
      "end_seconds": 230.05,
      "duration_seconds": 4.21,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.83,
      "end_seconds": 250.27,
      "duration_seconds": 19.44,
      "text": "Mm, I've got high blood pressure. I did try to ignore it for a while. It's a relief to finally sit down and talk about it. Oh, I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.72,
      "end_seconds": 253.14,
      "duration_seconds": 1.42,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.72,
      "end_seconds": 262.39,
      "duration_seconds": 8.67,
      "text": "I have low haemoglobin. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.51,
      "end_seconds": 271.29,
      "duration_seconds": 7.78,
      "text": "Understood. Yes, low haemoglobin is known to us, good to have that clear. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.01,
      "end_seconds": 277.52,
      "duration_seconds": 5.51,
      "text": "It's something called lisi... lisinopril, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.28,
      "end_seconds": 284.17,
      "duration_seconds": 4.89,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.98,
      "end_seconds": 300.58,
      "duration_seconds": 10.6,
      "text": "Okay, so not with me. I'll bring it next time. Okay, so it's paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 301.53,
      "end_seconds": 310.66,
      "duration_seconds": 9.13,
      "text": "Doctor, I think the last prescription for the paracetamol was 1300 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.72,
      "end_seconds": 316.64,
      "duration_seconds": 4.92,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.44,
      "end_seconds": 326.84,
      "duration_seconds": 8.4,
      "text": "No, I left it at home. I take iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.35,
      "end_seconds": 331.17,
      "duration_seconds": 2.82,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.79,
      "end_seconds": 333.63,
      "duration_seconds": 1.84,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.18,
      "end_seconds": 345.68,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.99,
      "end_seconds": 349.46,
      "duration_seconds": 1.47,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.94,
      "end_seconds": 353.97,
      "duration_seconds": 3.03,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.33,
      "end_seconds": 363.01,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.75,
      "end_seconds": 384.65,
      "duration_seconds": 4.9,
      "text": "Okay: temperature 38.0, pressure 126 over 69, heart rate 101."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.47,
      "end_seconds": 390.95,
      "duration_seconds": 3.48,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.22,
      "end_seconds": 392.92,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.53,
      "end_seconds": 397.29,
      "duration_seconds": 2.76,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.96,
      "end_seconds": 413.84,
      "duration_seconds": 4.88,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.72,
      "end_seconds": 415.42,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.68,
      "end_seconds": 421.38,
      "duration_seconds": 1.7,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.88,
      "end_seconds": 443.37,
      "duration_seconds": 12.49,
      "text": "Taking everything into account, it fits best with acute diverticulitis. We shouldn't forget a bowel tumour. I think blood tests makes sense here, for abdominal pain."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.29,
      "end_seconds": 446.78,
      "duration_seconds": 2.49,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.44,
      "end_seconds": 471.71,
      "duration_seconds": 24.27,
      "text": "Let's book a CT scan to look into left iliac fossa pain. The treatment will be co-amoxiclav, 625 milligrams, three times a day, five days. It's for diverticulitis. Drink plenty and start with a light diet. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 473.22,
      "end_seconds": 474.27,
      "duration_seconds": 1.05,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.93,
      "end_seconds": 484.71,
      "duration_seconds": 4.78,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 485.51,
      "end_seconds": 486.42,
      "duration_seconds": 0.91,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.54,
      "end_seconds": 491.7,
      "duration_seconds": 4.16,
      "text": "I'd like to see you again in one week."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 493.6,
      "end_seconds": 495.4,
      "duration_seconds": 1.8,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 496.08,
      "end_seconds": 499.59,
      "duration_seconds": 3.51,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0077",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 500.33,
      "end_seconds": 501.97,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0078",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 503.85,
      "end_seconds": 505.07,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}