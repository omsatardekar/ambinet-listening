{
  "schema_version": "1.0",
  "encounter_id": "02222",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.11,
      "duration_seconds": 5.84,
      "text": "Hi, you know, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 12.04,
      "duration_seconds": 4.42,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.62,
      "end_seconds": 17.07,
      "duration_seconds": 3.45,
      "text": "Well, I've been having swelling within hours."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.17,
      "end_seconds": 21.27,
      "duration_seconds": 3.1,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.68,
      "end_seconds": 26.96,
      "duration_seconds": 4.28,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.21,
      "end_seconds": 30.23,
      "duration_seconds": 2.02,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.1,
      "end_seconds": 34.03,
      "duration_seconds": 1.93,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.46,
      "end_seconds": 38.02,
      "duration_seconds": 2.56,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.41,
      "end_seconds": 50.76,
      "duration_seconds": 11.35,
      "text": "Moderate, I'd say. There's not being able to straighten it fully as well. About not being able to straighten it fully, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.61,
      "end_seconds": 65.84,
      "duration_seconds": 3.23,
      "text": "Any numbness or calf pain at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.7,
      "end_seconds": 70.62,
      "duration_seconds": 3.92,
      "text": "Actually, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.37,
      "end_seconds": 73.49,
      "duration_seconds": 2.12,
      "text": "Any fever or locked knee?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.63,
      "end_seconds": 78.63,
      "duration_seconds": 4.0,
      "text": "No fever or locked knee, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.22,
      "end_seconds": 82.78,
      "duration_seconds": 2.56,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.15,
      "end_seconds": 89.07,
      "duration_seconds": 1.92,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.04,
      "end_seconds": 93.76,
      "duration_seconds": 2.72,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.67,
      "end_seconds": 96.14,
      "duration_seconds": 1.47,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.16,
      "end_seconds": 101.53,
      "duration_seconds": 3.37,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.63,
      "end_seconds": 110.19,
      "duration_seconds": 4.56,
      "text": "I'm on metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.91,
      "end_seconds": 113.96,
      "duration_seconds": 3.05,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.9,
      "end_seconds": 118.73,
      "duration_seconds": 1.83,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.13,
      "end_seconds": 140.43,
      "duration_seconds": 3.3,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.86,
      "end_seconds": 143.73,
      "duration_seconds": 1.87,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.15,
      "end_seconds": 147.32,
      "duration_seconds": 2.17,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.83,
      "end_seconds": 151.57,
      "duration_seconds": 3.74,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.32,
      "end_seconds": 156.08,
      "duration_seconds": 2.76,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.23,
      "end_seconds": 161.56,
      "duration_seconds": 4.33,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.36,
      "end_seconds": 165.46,
      "duration_seconds": 3.1,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.26,
      "end_seconds": 170.44,
      "duration_seconds": 3.18,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.38,
      "end_seconds": 174.34,
      "duration_seconds": 2.96,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.13,
      "end_seconds": 176.67,
      "duration_seconds": 1.54,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.33,
      "end_seconds": 180.44,
      "duration_seconds": 3.11,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.65,
      "end_seconds": 191.17,
      "duration_seconds": 2.52,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.58,
      "end_seconds": 210.35,
      "duration_seconds": 7.77,
      "text": "Okay: saturation 99 percent, pressure 112 over 69, pulse 68, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.19,
      "end_seconds": 217.11,
      "duration_seconds": 3.92,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.91,
      "end_seconds": 221.2,
      "duration_seconds": 3.29,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.32,
      "end_seconds": 246.14,
      "duration_seconds": 7.82,
      "text": "The knee is swollen and when I pull the shin forwards it moves more than the other side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 252.34,
      "duration_seconds": 1.97,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.53,
      "end_seconds": 281.09,
      "duration_seconds": 12.56,
      "text": "Let me tell you where I've got to. It's hard to say. A likely anterior cruciate ligament tear is one possibility and a meniscal tear another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.47,
      "end_seconds": 285.74,
      "duration_seconds": 3.27,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.82,
      "end_seconds": 316.82,
      "duration_seconds": 29.0,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely anterior cruciate ligament tear, but I'd like to confirm. We should do an X-ray of the knee for knee injury. Let's get an MRI of the knee, for knee injury. Rest, ice and elevation, and use crutches until the scan. We'll catch up after the scan. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.81,
      "end_seconds": 320.54,
      "duration_seconds": 2.73,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.59,
      "end_seconds": 322.95,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    }
  ]
}