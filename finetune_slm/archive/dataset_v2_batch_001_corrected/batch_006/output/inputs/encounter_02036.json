{
  "schema_version": "1.0",
  "encounter_id": "02036",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 8.63,
      "duration_seconds": 7.47,
      "text": "Mm, doctor, hi, where would you like me to to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.54,
      "end_seconds": 15.56,
      "duration_seconds": 4.02,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.18,
      "end_seconds": 27.08,
      "duration_seconds": 6.9,
      "text": "Doctor, it's spots on my forehead and chin. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.77,
      "end_seconds": 30.55,
      "duration_seconds": 2.78,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.77,
      "end_seconds": 41.47,
      "duration_seconds": 2.7,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.54,
      "end_seconds": 79.0,
      "duration_seconds": 18.46,
      "text": "Okay: temperature is 36.4 degrees, saturation 97 percent, weight 81 kilos. And height 154 centimetres, BMI works out to 34.2, BP is 125 over 77, heart rate 81. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.38,
      "end_seconds": 84.31,
      "duration_seconds": 3.93,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.51,
      "end_seconds": 88.47,
      "duration_seconds": 2.96,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.44,
      "end_seconds": 91.5,
      "duration_seconds": 1.06,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.62,
      "end_seconds": 97.02,
      "duration_seconds": 2.4,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.61,
      "end_seconds": 121.15,
      "duration_seconds": 22.54,
      "text": "Before periods and stress definitely sets it off. I mean, as for few blackheads, I honestly can't say when that began. It might have been last month or the month before. I've had oily skin too, for about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.23,
      "end_seconds": 137.85,
      "duration_seconds": 2.62,
      "text": "Has there been any painful cysts?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.0,
      "end_seconds": 143.17,
      "duration_seconds": 4.17,
      "text": "Erm, not at all, no painful cysts."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.47,
      "end_seconds": 149.3,
      "duration_seconds": 4.83,
      "text": "A few quick ones: irregular periods, low mood or scarring?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.34,
      "end_seconds": 155.92,
      "duration_seconds": 5.58,
      "text": "no, uh, no irregular periods, low mood or scarring"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.82,
      "end_seconds": 161.39,
      "duration_seconds": 4.57,
      "text": "alright, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.35,
      "end_seconds": 165.62,
      "duration_seconds": 2.27,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.95,
      "end_seconds": 170.87,
      "duration_seconds": 3.92,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.87,
      "end_seconds": 183.07,
      "duration_seconds": 10.2,
      "text": "I'm on febuxostat, 80 milligrams, once a day. I take Eltroxin, 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.62,
      "end_seconds": 187.9,
      "duration_seconds": 4.28,
      "text": "Sure. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.85,
      "end_seconds": 192.36,
      "duration_seconds": 2.51,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.68,
      "end_seconds": 198.52,
      "duration_seconds": 4.84,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.44,
      "end_seconds": 214.74,
      "duration_seconds": 15.3,
      "text": "I smoke roughly a pack every two days. I hardly move around during the day. My husband and I live above the shop. I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.89,
      "end_seconds": 223.52,
      "duration_seconds": 3.63,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.38,
      "end_seconds": 229.9,
      "duration_seconds": 5.52,
      "text": "hmm, you know, no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.91,
      "end_seconds": 243.26,
      "duration_seconds": 1.35,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.43,
      "end_seconds": 250.49,
      "duration_seconds": 3.06,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.16,
      "end_seconds": 253.17,
      "duration_seconds": 2.01,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.98,
      "end_seconds": 269.19,
      "duration_seconds": 14.21,
      "text": "Yes, gout. I'd rather not end up on lots of tablets if I can avoid it. I've had an underactive thyroid, yes. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 277.79,
      "duration_seconds": 5.7,
      "text": "okay, go on alright, an underactive thyroid, that matches what I have here"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.24,
      "end_seconds": 281.3,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.46,
      "end_seconds": 283.43,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.51,
      "end_seconds": 287.48,
      "duration_seconds": 2.97,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.7,
      "end_seconds": 309.49,
      "duration_seconds": 5.79,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.88,
      "end_seconds": 313.86,
      "duration_seconds": 1.98,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.16,
      "end_seconds": 339.27,
      "duration_seconds": 11.11,
      "text": "so where does that leave us? This looks most like mild acne. I want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.16,
      "end_seconds": 343.34,
      "duration_seconds": 3.18,
      "text": "is there something to to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.35,
      "end_seconds": 367.32,
      "duration_seconds": 21.97,
      "text": "I understand the worry. At the moment I'd say it's mild acne, and we'll watch how it goes. I'm prescribing benzoyl peroxide gel, 5%, once a day, eight weeks. That's for acne. It's a commonly used medicine and most people tolerate it well. Wash gently twice a day and don't squeeze the spots."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.52,
      "end_seconds": 373.89,
      "duration_seconds": 6.37,
      "text": "Sure. See me again in eight weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.98,
      "end_seconds": 377.93,
      "duration_seconds": 2.95,
      "text": "Erm, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.02,
      "end_seconds": 381.65,
      "duration_seconds": 1.63,
      "text": "have a good day"
    }
  ]
}