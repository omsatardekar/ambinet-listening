{
  "schema_version": "1.0",
  "encounter_id": "02108",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 6.95,
      "duration_seconds": 6.38,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 13.03,
      "duration_seconds": 4.78,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.13,
      "end_seconds": 23.47,
      "duration_seconds": 8.34,
      "text": "Well, I've been having a shaky feeling in my hands. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.56,
      "end_seconds": 27.95,
      "duration_seconds": 3.39,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.51,
      "end_seconds": 30.42,
      "duration_seconds": 1.91,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.93,
      "end_seconds": 35.9,
      "duration_seconds": 4.97,
      "text": "Sure. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.2,
      "end_seconds": 40.87,
      "duration_seconds": 3.67,
      "text": "I'd say all the time. Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.68,
      "end_seconds": 45.14,
      "duration_seconds": 2.46,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.1,
      "end_seconds": 56.71,
      "duration_seconds": 9.61,
      "text": "Sweaty palms goes along with it, most of the time. The, The sweaty palms? That's been for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.09,
      "end_seconds": 61.56,
      "duration_seconds": 3.47,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.87,
      "end_seconds": 65.52,
      "duration_seconds": 2.65,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.55,
      "end_seconds": 81.15,
      "duration_seconds": 13.6,
      "text": "Okay, so the vitals from earlier. Heart rate 85, weight 66 kilos, blood pressure 112 over 75, height 179 centimetres, saturation 97 percent, temp 36.7 degrees, respiratory rate 17."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.18,
      "end_seconds": 87.15,
      "duration_seconds": 0.97,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.13,
      "end_seconds": 93.25,
      "duration_seconds": 3.12,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.33,
      "end_seconds": 95.52,
      "duration_seconds": 1.19,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.96,
      "end_seconds": 115.34,
      "duration_seconds": 6.38,
      "text": "There is a fine, fast tremor that goes away when the hands are resting."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.31,
      "end_seconds": 122.75,
      "duration_seconds": 2.44,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.21,
      "end_seconds": 135.17,
      "duration_seconds": 1.96,
      "text": "Any palpitations or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.76,
      "end_seconds": 139.51,
      "duration_seconds": 2.75,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.75,
      "end_seconds": 143.39,
      "duration_seconds": 3.64,
      "text": "Yes. Have you had any fainting or weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.21,
      "end_seconds": 148.04,
      "duration_seconds": 3.83,
      "text": "No fainting or weakness, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.79,
      "end_seconds": 153.86,
      "duration_seconds": 4.07,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.43,
      "end_seconds": 161.4,
      "duration_seconds": 4.97,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.3,
      "end_seconds": 165.58,
      "duration_seconds": 2.28,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.25,
      "end_seconds": 170.79,
      "duration_seconds": 3.54,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 190.24,
      "duration_seconds": 4.22,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.38,
      "end_seconds": 193.51,
      "duration_seconds": 2.13,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.93,
      "end_seconds": 199.39,
      "duration_seconds": 4.46,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.27,
      "end_seconds": 215.51,
      "duration_seconds": 14.24,
      "text": "I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.8,
      "end_seconds": 218.8,
      "duration_seconds": 2.0,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.41,
      "end_seconds": 222.52,
      "duration_seconds": 3.11,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.39,
      "end_seconds": 227.19,
      "duration_seconds": 3.8,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.54,
      "end_seconds": 230.02,
      "duration_seconds": 1.48,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.22,
      "end_seconds": 246.52,
      "duration_seconds": 6.3,
      "text": "Okay, thinking it through, my working impression is an anxiety or caffeine-related tremor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.64,
      "end_seconds": 255.61,
      "duration_seconds": 3.97,
      "text": "Ah, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.66,
      "end_seconds": 265.33,
      "duration_seconds": 8.67,
      "text": "It's reasonable to be concerned, but right now an anxiety or caffeine-related tremor is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.9,
      "end_seconds": 293.26,
      "duration_seconds": 12.36,
      "text": "I'd like to arrange a thyroid test for tremor. Cut down caffeine and try slow breathing when it starts. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.77,
      "end_seconds": 296.16,
      "duration_seconds": 2.39,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.81,
      "end_seconds": 299.48,
      "duration_seconds": 2.67,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.33,
      "end_seconds": 301.96,
      "duration_seconds": 1.63,
      "text": "That's clear, thanks."
    }
  ]
}