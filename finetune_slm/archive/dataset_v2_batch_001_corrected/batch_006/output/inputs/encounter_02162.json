{
  "schema_version": "1.0",
  "encounter_id": "02162",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.71,
      "duration_seconds": 3.8,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.43,
      "end_seconds": 14.26,
      "duration_seconds": 3.83,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.39,
      "end_seconds": 22.41,
      "duration_seconds": 7.02,
      "text": "I've been getting puffed climbing stairs, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.2,
      "end_seconds": 24.66,
      "duration_seconds": 1.46,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.55,
      "end_seconds": 28.64,
      "duration_seconds": 2.09,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.07,
      "end_seconds": 40.01,
      "duration_seconds": 10.94,
      "text": "Yes, carry on. Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.87,
      "end_seconds": 68.35,
      "duration_seconds": 26.48,
      "text": "Sorry, what was I saying, I notice it more with stairs. About a six out of ten. Oh, and a bit of a cough with exercise. About bit of a cough with exercise, I notice it more with running. I've also been feeling unfit, for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.05,
      "end_seconds": 73.32,
      "duration_seconds": 4.27,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.98,
      "end_seconds": 78.13,
      "duration_seconds": 4.15,
      "text": "Arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.74,
      "end_seconds": 83.9,
      "duration_seconds": 4.16,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.04,
      "end_seconds": 88.56,
      "duration_seconds": 3.52,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 92.1,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.81,
      "end_seconds": 97.13,
      "duration_seconds": 4.32,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.83,
      "end_seconds": 102.08,
      "duration_seconds": 3.25,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.61,
      "end_seconds": 105.81,
      "duration_seconds": 3.2,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.97,
      "end_seconds": 110.36,
      "duration_seconds": 3.39,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.87,
      "end_seconds": 114.58,
      "duration_seconds": 3.71,
      "text": "Um, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.43,
      "end_seconds": 120.82,
      "duration_seconds": 4.39,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.4,
      "end_seconds": 126.51,
      "duration_seconds": 5.11,
      "text": "Not currently, but as a youngster naproxen gave me a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.44,
      "end_seconds": 128.82,
      "duration_seconds": 1.38,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.84,
      "end_seconds": 132.83,
      "duration_seconds": 2.99,
      "text": "No, you know, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.5,
      "end_seconds": 137.68,
      "duration_seconds": 3.18,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.73,
      "end_seconds": 142.32,
      "duration_seconds": 2.59,
      "text": "Paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.33,
      "end_seconds": 145.63,
      "duration_seconds": 1.3,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.06,
      "end_seconds": 149.22,
      "duration_seconds": 2.16,
      "text": "Nope, no chest pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.81,
      "end_seconds": 153.16,
      "duration_seconds": 3.35,
      "text": "Have you had any fainting, wheeze or palpitations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.32,
      "end_seconds": 162.24,
      "duration_seconds": 2.92,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.54,
      "end_seconds": 168.13,
      "duration_seconds": 4.59,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.08,
      "end_seconds": 171.5,
      "duration_seconds": 1.42,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.27,
      "end_seconds": 176.58,
      "duration_seconds": 4.31,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.2,
      "end_seconds": 178.73,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.97,
      "end_seconds": 191.36,
      "duration_seconds": 2.39,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.91,
      "end_seconds": 201.03,
      "duration_seconds": 2.12,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.08,
      "end_seconds": 236.28,
      "duration_seconds": 16.2,
      "text": "Okay: height 184 centimetres, temperature is 36.6 degrees. And pressure 110 over 74, BMI works out to 22.4, pulse 86, SpO2 97 percent on room air, respiratory rate 14, weight 76 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.7,
      "end_seconds": 239.07,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.69,
      "end_seconds": 243.38,
      "duration_seconds": 2.69,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.21,
      "end_seconds": 249.83,
      "duration_seconds": 3.62,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.8,
      "end_seconds": 254.09,
      "duration_seconds": 2.29,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.59,
      "end_seconds": 276.39,
      "duration_seconds": 6.8,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.58,
      "end_seconds": 282.29,
      "duration_seconds": 1.71,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.69,
      "end_seconds": 305.93,
      "duration_seconds": 8.24,
      "text": "Let me tell you where I've got to. My working impression is breathlessness from low fitness. Mild asthma is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.28,
      "end_seconds": 324.45,
      "duration_seconds": 10.17,
      "text": "I'm sending you for a peak flow because of exertional cough. Build up to thirty minutes of brisk walking five days a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.92,
      "end_seconds": 332.26,
      "duration_seconds": 7.34,
      "text": "Yes, carry on. I'd like you back in eight weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.82,
      "end_seconds": 336.98,
      "duration_seconds": 3.16,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}