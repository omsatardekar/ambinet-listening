{
  "schema_version": "1.0",
  "encounter_id": "02152",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.68,
      "duration_seconds": 3.93,
      "text": "So, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 9.96,
      "duration_seconds": 3.96,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.2,
      "end_seconds": 15.43,
      "duration_seconds": 4.23,
      "text": "So, I've been getting puffed climbing stairs, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.48,
      "end_seconds": 19.64,
      "duration_seconds": 3.16,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.49,
      "end_seconds": 23.26,
      "duration_seconds": 2.77,
      "text": "For two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.53,
      "end_seconds": 37.25,
      "duration_seconds": 12.72,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.57,
      "end_seconds": 44.39,
      "duration_seconds": 5.82,
      "text": "It happens every other day. Resting helps a bit. Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.19,
      "end_seconds": 51.51,
      "duration_seconds": 2.32,
      "text": "Have you been feeling unfit?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.33,
      "end_seconds": 54.37,
      "duration_seconds": 1.04,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 58.25,
      "duration_seconds": 3.27,
      "text": "And what about wheeze, fainting or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.51,
      "end_seconds": 65.36,
      "duration_seconds": 2.85,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.28,
      "end_seconds": 68.56,
      "duration_seconds": 2.28,
      "text": "Any sign of chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 72.88,
      "duration_seconds": 2.63,
      "text": "No, none, no chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.05,
      "end_seconds": 77.34,
      "duration_seconds": 3.29,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.07,
      "end_seconds": 85.93,
      "duration_seconds": 2.86,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.77,
      "end_seconds": 89.41,
      "duration_seconds": 2.64,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.17,
      "end_seconds": 91.63,
      "duration_seconds": 1.46,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.69,
      "end_seconds": 95.98,
      "duration_seconds": 3.29,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.8,
      "end_seconds": 99.34,
      "duration_seconds": 1.54,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.72,
      "end_seconds": 120.22,
      "duration_seconds": 4.5,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.79,
      "end_seconds": 125.62,
      "duration_seconds": 3.83,
      "text": "Right, you know, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.48,
      "end_seconds": 128.89,
      "duration_seconds": 1.41,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.88,
      "end_seconds": 131.9,
      "duration_seconds": 1.02,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.53,
      "end_seconds": 138.34,
      "duration_seconds": 4.81,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.41,
      "end_seconds": 141.8,
      "duration_seconds": 2.39,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.65,
      "end_seconds": 158.49,
      "duration_seconds": 2.84,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.75,
      "end_seconds": 170.88,
      "duration_seconds": 11.13,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. My husband and I live above the shop. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.41,
      "end_seconds": 173.35,
      "duration_seconds": 1.94,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.05,
      "end_seconds": 176.51,
      "duration_seconds": 2.46,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.52,
      "end_seconds": 193.51,
      "duration_seconds": 3.99,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.36,
      "end_seconds": 206.34,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.26,
      "end_seconds": 232.67,
      "duration_seconds": 12.41,
      "text": "Okay: pulse is 75 beats a minute, pressure 127 over 79, respiratory rate 15. And temperature is 36.9 degrees, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.13,
      "end_seconds": 235.54,
      "duration_seconds": 1.41,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.05,
      "end_seconds": 238.1,
      "duration_seconds": 2.05,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.8,
      "end_seconds": 242.14,
      "duration_seconds": 2.34,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.42,
      "end_seconds": 245.1,
      "duration_seconds": 1.68,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.21,
      "end_seconds": 269.28,
      "duration_seconds": 7.07,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.14,
      "end_seconds": 281.4,
      "duration_seconds": 7.26,
      "text": "You can sit up now. Taking everything into account, it fits best with breathlessness from low fitness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.34,
      "end_seconds": 285.52,
      "duration_seconds": 2.18,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.18,
      "end_seconds": 305.82,
      "duration_seconds": 19.64,
      "text": "Nothing I've seen today points to an emergency. It looks like breathlessness from low fitness, but I'd like to confirm. Let me repeat that back to make sure. You've been getting puffed climbing stairs for two weeks, severe, and no fainting or wheeze."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.52,
      "end_seconds": 309.7,
      "duration_seconds": 2.18,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.14,
      "end_seconds": 323.4,
      "duration_seconds": 5.26,
      "text": "I think a peak flow makes sense here, for exertional cough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.71,
      "end_seconds": 325.73,
      "duration_seconds": 1.02,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.56,
      "end_seconds": 345.46,
      "duration_seconds": 18.9,
      "text": "Build up to thirty minutes of brisk walking five days a week. Cut down on salt and fried food for now, it really does make a difference. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.97,
      "end_seconds": 350.48,
      "duration_seconds": 3.51,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}