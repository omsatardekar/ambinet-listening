{
  "schema_version": "1.0",
  "encounter_id": "02357",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 3.41,
      "duration_seconds": 2.28,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.68,
      "end_seconds": 10.06,
      "duration_seconds": 3.38,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.08,
      "end_seconds": 13.58,
      "duration_seconds": 2.5,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.41,
      "end_seconds": 21.49,
      "duration_seconds": 7.08,
      "text": "Doctor, it's a chronic cough with lots of phlegm. That's what we're worried about."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.36,
      "end_seconds": 30.45,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.1,
      "end_seconds": 35.79,
      "duration_seconds": 4.69,
      "text": "Um, for about four days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.95,
      "end_seconds": 39.4,
      "duration_seconds": 2.45,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.91,
      "end_seconds": 43.81,
      "duration_seconds": 2.9,
      "text": "Mornings definitely sets it off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.73,
      "end_seconds": 49.65,
      "duration_seconds": 3.92,
      "text": "Right, has there been green phlegm lately too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.23,
      "end_seconds": 66.04,
      "duration_seconds": 14.81,
      "text": "Yes, you know, that started yesterday. I've, I've also been getting out of breath, for four weeks. Well, there was tiredness, yes, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.03,
      "end_seconds": 71.41,
      "duration_seconds": 4.38,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.77,
      "end_seconds": 79.53,
      "duration_seconds": 6.76,
      "text": "Oh, it's escitalopram, 10 milligrams, once a day for the anxiety, doctor."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.24,
      "end_seconds": 82.83,
      "duration_seconds": 2.59,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 84.07,
      "end_seconds": 90.51,
      "duration_seconds": 6.44,
      "text": "For six months. Hmm, um, he takes fluoxetine, every morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.32,
      "end_seconds": 94.03,
      "duration_seconds": 2.71,
      "text": "Right, and what strength is that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 96.12,
      "end_seconds": 100.45,
      "duration_seconds": 4.33,
      "text": "20 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.53,
      "end_seconds": 104.28,
      "duration_seconds": 2.75,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.6,
      "end_seconds": 110.56,
      "duration_seconds": 4.96,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.5,
      "end_seconds": 116.95,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.97,
      "end_seconds": 121.93,
      "duration_seconds": 3.96,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.12,
      "end_seconds": 127.33,
      "duration_seconds": 4.21,
      "text": "So, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.86,
      "end_seconds": 132.04,
      "duration_seconds": 3.18,
      "text": "I've got anxiety. I've got depression."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.77,
      "end_seconds": 138.58,
      "duration_seconds": 4.81,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.88,
      "end_seconds": 153.6,
      "duration_seconds": 13.72,
      "text": "Hmm, um, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.78,
      "end_seconds": 168.72,
      "duration_seconds": 4.94,
      "text": "And what about chest pain, weight loss or coughing up blood?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.38,
      "end_seconds": 173.43,
      "duration_seconds": 4.05,
      "text": "Let me think, nope, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.86,
      "end_seconds": 176.85,
      "duration_seconds": 1.99,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.68,
      "end_seconds": 179.53,
      "duration_seconds": 1.85,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.38,
      "end_seconds": 186.1,
      "duration_seconds": 5.72,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.72,
      "end_seconds": 193.7,
      "duration_seconds": 6.98,
      "text": "Yeah, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.78,
      "end_seconds": 203.59,
      "duration_seconds": 8.81,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.25,
      "end_seconds": 207.14,
      "duration_seconds": 1.89,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 215.12,
      "end_seconds": 233.05,
      "duration_seconds": 17.93,
      "text": "Doctor, I've got the readings for you. BMI works out to 38.5, oxygen saturation is 99 percent, weight 96 kilos, heart rate 72, height 158 centimetres, respiratory rate 14, BP is 125 over 79, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.69,
      "end_seconds": 235.39,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 238.87,
      "duration_seconds": 2.18,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.01,
      "end_seconds": 241.43,
      "duration_seconds": 1.42,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.96,
      "end_seconds": 257.84,
      "duration_seconds": 5.88,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.83,
      "end_seconds": 265.85,
      "duration_seconds": 3.02,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.34,
      "end_seconds": 302.16,
      "duration_seconds": 21.82,
      "text": "From what you've told me and what I found, this looks most like a flare of bronchiectasis. That's my thinking for now, and it may change as we learn more. A chest infection is still possible. Keep up your airway clearance exercises twice a day. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 303.46,
      "end_seconds": 305.71,
      "duration_seconds": 2.25,
      "text": "Alright, thanks, take care."
    }
  ]
}