{
  "schema_version": "1.0",
  "encounter_id": "02029",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 5.46,
      "duration_seconds": 4.66,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.95,
      "end_seconds": 11.58,
      "duration_seconds": 4.63,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.14,
      "end_seconds": 14.88,
      "duration_seconds": 2.74,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.49,
      "end_seconds": 18.62,
      "duration_seconds": 3.13,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.2,
      "end_seconds": 23.36,
      "duration_seconds": 3.16,
      "text": "We came because of very heavy periods."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.77,
      "end_seconds": 28.93,
      "duration_seconds": 4.16,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.37,
      "end_seconds": 38.45,
      "duration_seconds": 2.08,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.66,
      "end_seconds": 63.62,
      "duration_seconds": 6.96,
      "text": "Okay: BP is 118 over 85, pulse 121, saturation 97 percent. And temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.16,
      "end_seconds": 66.64,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.16,
      "end_seconds": 72.12,
      "duration_seconds": 4.96,
      "text": "We'll look at it together shortly. What eases it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.67,
      "end_seconds": 83.81,
      "duration_seconds": 10.14,
      "text": "I mean, I get some relief from double protection. Dizziness was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.9,
      "end_seconds": 87.29,
      "duration_seconds": 1.39,
      "text": "What about fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.28,
      "end_seconds": 91.11,
      "duration_seconds": 2.83,
      "text": "Not that I've noticed, no fainting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.42,
      "end_seconds": 96.27,
      "duration_seconds": 3.85,
      "text": "Right, have you had any weight loss or pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.01,
      "end_seconds": 101.42,
      "duration_seconds": 4.41,
      "text": "I haven't had weight loss or pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.26,
      "end_seconds": 105.01,
      "duration_seconds": 2.75,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.72,
      "end_seconds": 108.65,
      "duration_seconds": 1.93,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.48,
      "end_seconds": 112.91,
      "duration_seconds": 2.43,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.21,
      "end_seconds": 117.71,
      "duration_seconds": 3.5,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.65,
      "end_seconds": 135.03,
      "duration_seconds": 3.38,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.24,
      "end_seconds": 141.99,
      "duration_seconds": 5.75,
      "text": "Hmm, you know, I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.51,
      "end_seconds": 148.79,
      "duration_seconds": 3.28,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.75,
      "end_seconds": 151.98,
      "duration_seconds": 2.23,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.6,
      "end_seconds": 164.11,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.33,
      "end_seconds": 167.1,
      "duration_seconds": 1.77,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.32,
      "end_seconds": 174.55,
      "duration_seconds": 2.23,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.31,
      "end_seconds": 180.32,
      "duration_seconds": 5.01,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.47,
      "end_seconds": 183.88,
      "duration_seconds": 2.41,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.96,
      "end_seconds": 189.8,
      "duration_seconds": 3.84,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.02,
      "end_seconds": 193.17,
      "duration_seconds": 2.15,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.93,
      "end_seconds": 197.62,
      "duration_seconds": 2.69,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.59,
      "end_seconds": 203.06,
      "duration_seconds": 4.47,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.58,
      "end_seconds": 207.61,
      "duration_seconds": 3.03,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 215.89,
      "duration_seconds": 4.72,
      "text": "Right, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.81,
      "end_seconds": 219.87,
      "duration_seconds": 2.06,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.83,
      "end_seconds": 227.96,
      "duration_seconds": 6.13,
      "text": "Yes, heart disease is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.54,
      "end_seconds": 233.99,
      "duration_seconds": 4.45,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.12,
      "end_seconds": 237.3,
      "duration_seconds": 2.18,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.33,
      "end_seconds": 253.09,
      "duration_seconds": 4.76,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.89,
      "end_seconds": 259.7,
      "duration_seconds": 1.81,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.17,
      "end_seconds": 287.23,
      "duration_seconds": 15.06,
      "text": "So, based on the history and the examination, the most likely explanation is heavy periods with iron deficiency. I want to be honest that this is an impression, not a final answer. Another possibility is fibroids."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.48,
      "end_seconds": 290.5,
      "duration_seconds": 2.02,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.67,
      "end_seconds": 317.24,
      "duration_seconds": 22.57,
      "text": "It's reasonable to be concerned, but right now heavy periods with iron deficiency is my leading thought, not anything worse. Let's book a ferritin level to look into heavy periods. Let's book a blood count to look into heavy periods. I'll request a pelvic ultrasound, it'll help with heavy periods."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.92,
      "end_seconds": 338.1,
      "duration_seconds": 20.18,
      "text": "I'm going to put you on ferrous sulfate, 200 milligrams, once a day, three months. It's for iron deficiency. The pharmacy will go through the details again when you pick it up. For this, tranexamic acid, 1 gram, three times a day, during periods. That's for heavy periods."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.12,
      "end_seconds": 341.53,
      "duration_seconds": 2.41,
      "text": "Okay, uh, I understand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.22,
      "end_seconds": 349.63,
      "duration_seconds": 7.41,
      "text": "Keep a pad count diary. We'll catch up after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.25,
      "end_seconds": 352.87,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    }
  ]
}