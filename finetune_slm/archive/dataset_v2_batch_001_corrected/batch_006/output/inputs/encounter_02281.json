{
  "schema_version": "1.0",
  "encounter_id": "02281",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 2.16,
      "duration_seconds": 1.56,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.27,
      "end_seconds": 7.64,
      "duration_seconds": 4.37,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.03,
      "end_seconds": 15.52,
      "duration_seconds": 2.49,
      "text": "It's, It's yellow crusts, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.74,
      "end_seconds": 20.16,
      "duration_seconds": 3.42,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.97,
      "end_seconds": 24.29,
      "duration_seconds": 2.32,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.66,
      "end_seconds": 28.91,
      "duration_seconds": 3.25,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.38,
      "end_seconds": 31.89,
      "duration_seconds": 1.51,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.84,
      "end_seconds": 37.26,
      "duration_seconds": 4.42,
      "text": "What about scratching at night, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.32,
      "end_seconds": 42.79,
      "duration_seconds": 3.47,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.2,
      "end_seconds": 48.14,
      "duration_seconds": 3.94,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.75,
      "end_seconds": 56.33,
      "duration_seconds": 6.58,
      "text": "Oh, uh, maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.69,
      "end_seconds": 57.39,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.81,
      "end_seconds": 69.19,
      "duration_seconds": 4.38,
      "text": "Have you noticed high fever, eating poorly or blisters?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.79,
      "end_seconds": 76.32,
      "duration_seconds": 5.53,
      "text": "Right, no high fever, eating poorly or blisters, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.07,
      "end_seconds": 80.54,
      "duration_seconds": 2.47,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.35,
      "end_seconds": 86.04,
      "duration_seconds": 3.69,
      "text": "Ah, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.65,
      "end_seconds": 88.88,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.82,
      "end_seconds": 93.27,
      "duration_seconds": 3.45,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.0,
      "end_seconds": 106.39,
      "duration_seconds": 5.39,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.94,
      "end_seconds": 119.23,
      "duration_seconds": 11.29,
      "text": "I'm a bus driver, so I sit for long hours. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.25,
      "end_seconds": 124.39,
      "duration_seconds": 4.14,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.67,
      "end_seconds": 127.69,
      "duration_seconds": 2.02,
      "text": "Eczema, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 141.32,
      "duration_seconds": 4.89,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.06,
      "end_seconds": 145.8,
      "duration_seconds": 2.74,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.39,
      "end_seconds": 165.77,
      "duration_seconds": 3.38,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.81,
      "end_seconds": 177.15,
      "duration_seconds": 9.34,
      "text": "Uh, I take hydrocortisone cream, when needed for the eczema. I'm on a moisturiser, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.86,
      "end_seconds": 181.92,
      "duration_seconds": 3.06,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.17,
      "end_seconds": 196.01,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.68,
      "end_seconds": 220.56,
      "duration_seconds": 8.88,
      "text": "Okay: temperature 36.9, pulse is 86 beats a minute, blood pressure 112 over 75, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.27,
      "end_seconds": 225.69,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.05,
      "end_seconds": 229.65,
      "duration_seconds": 2.6,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.66,
      "end_seconds": 235.89,
      "duration_seconds": 4.23,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.53,
      "end_seconds": 240.39,
      "duration_seconds": 2.86,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.27,
      "end_seconds": 257.88,
      "duration_seconds": 5.61,
      "text": "The eczema patches on the arms have yellow crusts and weeping areas."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.48,
      "end_seconds": 259.52,
      "duration_seconds": 1.04,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.24,
      "end_seconds": 273.54,
      "duration_seconds": 11.3,
      "text": "You can relax now. From what you've told me and what I found, the most likely explanation is eczema with a bacterial skin infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.53,
      "end_seconds": 277.79,
      "duration_seconds": 2.26,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.25,
      "end_seconds": 298.35,
      "duration_seconds": 19.1,
      "text": "I can't promise yet, but most people with eczema with a bacterial skin infection do well once it's treated properly. I think a skin swab makes sense here, for infected eczema. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.17,
      "end_seconds": 303.56,
      "duration_seconds": 3.39,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.1,
      "end_seconds": 316.52,
      "duration_seconds": 12.42,
      "text": "The treatment will be flucloxacillin, 250 milligrams, four times a day, seven days. It's for infected eczema. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.17,
      "end_seconds": 319.97,
      "duration_seconds": 2.8,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.3,
      "end_seconds": 329.48,
      "duration_seconds": 8.18,
      "text": "Keep the nails short and keep using the moisturiser. Let's review you in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.18,
      "end_seconds": 333.36,
      "duration_seconds": 3.18,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}