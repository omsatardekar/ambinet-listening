{
  "schema_version": "1.0",
  "encounter_id": "02054",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 4.75,
      "duration_seconds": 3.44,
      "text": "Oh, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.8,
      "end_seconds": 15.7,
      "duration_seconds": 4.9,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.62,
      "end_seconds": 24.2,
      "duration_seconds": 7.58,
      "text": "Honestly, it's a bump on the head, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.77,
      "end_seconds": 27.67,
      "duration_seconds": 2.9,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.3,
      "end_seconds": 38.33,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.9,
      "end_seconds": 61.58,
      "duration_seconds": 5.68,
      "text": "Okay: heart rate 66, blood pressure 113 over 75, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.28,
      "end_seconds": 63.93,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.6,
      "end_seconds": 72.59,
      "duration_seconds": 5.99,
      "text": "Don't worry, we'll discuss it in a second. Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.2,
      "end_seconds": 75.53,
      "duration_seconds": 2.33,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.92,
      "end_seconds": 80.62,
      "duration_seconds": 3.7,
      "text": "Okay, what do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 90.58,
      "duration_seconds": 8.57,
      "text": "A cold pack helps a bit. And there's a little tearfulness afterwards as well, about a month now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.0,
      "end_seconds": 97.51,
      "duration_seconds": 6.51,
      "text": "Yes, carry on. Let me check a few things. Any vomiting or fit?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.27,
      "end_seconds": 102.28,
      "duration_seconds": 4.01,
      "text": "No vomiting or fit, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.91,
      "end_seconds": 109.22,
      "duration_seconds": 5.31,
      "text": "Let me check a few things. Any drowsiness or loss of consciousness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.78,
      "end_seconds": 114.15,
      "duration_seconds": 4.37,
      "text": "Um, no, no drowsiness or loss of consciousness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.38,
      "end_seconds": 117.41,
      "duration_seconds": 2.03,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.39,
      "end_seconds": 121.05,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.36,
      "end_seconds": 126.75,
      "duration_seconds": 4.39,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.17,
      "end_seconds": 136.44,
      "duration_seconds": 8.27,
      "text": "Sorry, what was I saying, yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.23,
      "end_seconds": 140.14,
      "duration_seconds": 2.91,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.14,
      "end_seconds": 147.28,
      "duration_seconds": 6.14,
      "text": "So, it's gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.51,
      "end_seconds": 162.05,
      "duration_seconds": 2.54,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.5,
      "end_seconds": 167.68,
      "duration_seconds": 4.18,
      "text": "Um, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.77,
      "end_seconds": 177.71,
      "duration_seconds": 3.94,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.54,
      "end_seconds": 188.39,
      "duration_seconds": 9.85,
      "text": "I mean, um, I've had diabetes for five years now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.53,
      "end_seconds": 208.39,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.56,
      "end_seconds": 217.05,
      "duration_seconds": 2.49,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.7,
      "end_seconds": 221.84,
      "duration_seconds": 3.14,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.36,
      "end_seconds": 227.19,
      "duration_seconds": 3.83,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.35,
      "end_seconds": 231.97,
      "duration_seconds": 3.62,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.79,
      "end_seconds": 233.7,
      "duration_seconds": 0.91,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.83,
      "end_seconds": 236.09,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.17,
      "end_seconds": 256.63,
      "duration_seconds": 8.46,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.14,
      "end_seconds": 261.87,
      "duration_seconds": 2.73,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.96,
      "end_seconds": 297.06,
      "duration_seconds": 18.1,
      "text": "Okay, thinking it through, it fits best with a minor head bump with no worrying signs. Just to be sure I understood. You've had a bump on the head for two days, and no loss of consciousness or drowsiness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.72,
      "end_seconds": 298.42,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.68,
      "end_seconds": 320.7,
      "duration_seconds": 21.02,
      "text": "Watch him for the next twenty-four hours and give paracetamol if he is sore. Do get help quickly if he vomits repeatedly, becomes drowsy or has a fit. Come back if any vomiting or drowsiness. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.08,
      "end_seconds": 325.98,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}