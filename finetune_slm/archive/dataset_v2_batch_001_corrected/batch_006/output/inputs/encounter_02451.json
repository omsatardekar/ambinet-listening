{
  "schema_version": "1.0",
  "encounter_id": "02451",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 3.71,
      "duration_seconds": 3.17,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.43,
      "end_seconds": 9.62,
      "duration_seconds": 5.19,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.22,
      "end_seconds": 28.61,
      "duration_seconds": 17.39,
      "text": "It's itchy red patches that have gone crusty. I thought I'd wait, but it hasn't gone. It's a relief to finally sit down and talk about it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.47,
      "end_seconds": 33.82,
      "duration_seconds": 3.35,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.7,
      "end_seconds": 38.67,
      "duration_seconds": 2.97,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.69,
      "end_seconds": 42.24,
      "duration_seconds": 2.55,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.13,
      "end_seconds": 46.76,
      "duration_seconds": 3.63,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.21,
      "end_seconds": 50.82,
      "duration_seconds": 2.61,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.92,
      "end_seconds": 54.33,
      "duration_seconds": 2.41,
      "text": "Yes, I'm allergic to tramadol."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.78,
      "end_seconds": 58.29,
      "duration_seconds": 2.51,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.23,
      "end_seconds": 70.09,
      "duration_seconds": 9.86,
      "text": "Hydrocortisone cream, when needed sorry, I know I'm rambling a bit i'm on rosuvastatin, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.93,
      "end_seconds": 73.01,
      "duration_seconds": 2.08,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.28,
      "end_seconds": 78.43,
      "duration_seconds": 4.15,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.57,
      "end_seconds": 86.78,
      "duration_seconds": 1.21,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.83,
      "end_seconds": 93.68,
      "duration_seconds": 2.85,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.07,
      "end_seconds": 98.83,
      "duration_seconds": 3.76,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.42,
      "end_seconds": 102.71,
      "duration_seconds": 3.29,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.13,
      "end_seconds": 105.6,
      "duration_seconds": 1.47,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.59,
      "end_seconds": 109.92,
      "duration_seconds": 3.33,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.67,
      "end_seconds": 114.63,
      "duration_seconds": 2.96,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.88,
      "end_seconds": 119.97,
      "duration_seconds": 1.09,
      "text": "Yes, eczema."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.99,
      "end_seconds": 122.36,
      "duration_seconds": 1.37,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.98,
      "end_seconds": 126.23,
      "duration_seconds": 3.25,
      "text": "High cholesterol, for nearly five years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.57,
      "end_seconds": 131.62,
      "duration_seconds": 4.05,
      "text": "Have you noticed blisters, eating poorly or drowsiness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.2,
      "end_seconds": 135.37,
      "duration_seconds": 2.17,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.54,
      "end_seconds": 139.83,
      "duration_seconds": 3.29,
      "text": "So, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.54,
      "end_seconds": 141.91,
      "duration_seconds": 1.37,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.53,
      "end_seconds": 163.01,
      "duration_seconds": 2.48,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.96,
      "end_seconds": 174.08,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.5,
      "end_seconds": 189.95,
      "duration_seconds": 6.45,
      "text": "Okay: respiratory rate 16, pressure 115 over 75, temp 36.7 degrees. And pulse 80."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.17,
      "end_seconds": 195.94,
      "duration_seconds": 3.77,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.65,
      "end_seconds": 198.08,
      "duration_seconds": 1.43,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.56,
      "end_seconds": 201.26,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.41,
      "end_seconds": 223.6,
      "duration_seconds": 5.19,
      "text": "The eczema patches on the arms have yellow crusts and weeping areas."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.0,
      "end_seconds": 228.13,
      "duration_seconds": 2.13,
      "text": "Alright, you can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.43,
      "end_seconds": 252.47,
      "duration_seconds": 7.04,
      "text": "Let me tell you where I've got to. I'd lean towards eczema with a bacterial skin infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.27,
      "end_seconds": 257.04,
      "duration_seconds": 2.77,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.2,
      "end_seconds": 266.37,
      "duration_seconds": 8.17,
      "text": "Nothing I've seen today points to an emergency. It looks like eczema with a bacterial skin infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.56,
      "end_seconds": 295.69,
      "duration_seconds": 14.13,
      "text": "I'd like you to take flucloxacillin, 250 milligrams, four times a day, seven days. It's for infected eczema. Let's review you in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.86,
      "end_seconds": 300.22,
      "duration_seconds": 3.36,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.63,
      "end_seconds": 304.89,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
}