{
  "schema_version": "1.0",
  "encounter_id": "02176",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.26,
      "duration_seconds": 5.06,
      "text": "Let me think, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.1,
      "end_seconds": 12.35,
      "duration_seconds": 4.25,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 24.97,
      "duration_seconds": 10.88,
      "text": "so the thing is, I've got a high temperature i didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.28,
      "end_seconds": 48.08,
      "duration_seconds": 4.8,
      "text": "Since when exactly? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.8,
      "end_seconds": 57.45,
      "duration_seconds": 8.65,
      "text": "I've had it for ten days. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.72,
      "end_seconds": 63.69,
      "duration_seconds": 5.97,
      "text": "yes, carry on is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.81,
      "end_seconds": 70.81,
      "duration_seconds": 2.0,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.88,
      "end_seconds": 75.43,
      "duration_seconds": 3.55,
      "text": "and what about chest pain or recent infection?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.5,
      "end_seconds": 83.29,
      "duration_seconds": 4.79,
      "text": "Mm, I haven't had chest pain or recent infection, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.11,
      "end_seconds": 87.16,
      "duration_seconds": 2.05,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.78,
      "end_seconds": 90.28,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.84,
      "end_seconds": 95.12,
      "duration_seconds": 3.28,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.08,
      "end_seconds": 99.47,
      "duration_seconds": 2.39,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.77,
      "end_seconds": 114.44,
      "duration_seconds": 4.67,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.16,
      "end_seconds": 118.63,
      "duration_seconds": 2.47,
      "text": "Yes, wheat. I get bloating."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.23,
      "end_seconds": 121.92,
      "duration_seconds": 2.69,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.12,
      "end_seconds": 131.07,
      "duration_seconds": 7.95,
      "text": "yes, an irregular heartbeat. I told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.18,
      "end_seconds": 136.05,
      "duration_seconds": 3.87,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.23,
      "end_seconds": 140.7,
      "duration_seconds": 3.47,
      "text": "Bisoprolol, 2.5 milligrams, once a day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.99,
      "end_seconds": 142.85,
      "duration_seconds": 1.86,
      "text": "Sure. What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.09,
      "end_seconds": 148.52,
      "duration_seconds": 4.43,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.52,
      "end_seconds": 151.42,
      "duration_seconds": 1.9,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.05,
      "end_seconds": 155.57,
      "duration_seconds": 2.52,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.52,
      "end_seconds": 163.07,
      "duration_seconds": 3.55,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.36,
      "end_seconds": 168.14,
      "duration_seconds": 3.78,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.8,
      "end_seconds": 173.86,
      "duration_seconds": 3.06,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.9,
      "end_seconds": 176.76,
      "duration_seconds": 1.86,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.65,
      "end_seconds": 199.76,
      "duration_seconds": 7.11,
      "text": "you are hot, shaking, and and your pulse is over one hundred and forty and irregular"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.63,
      "end_seconds": 206.36,
      "duration_seconds": 1.73,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.94,
      "end_seconds": 225.17,
      "duration_seconds": 8.23,
      "text": "So, based on the history and the examination, I think we're dealing with a thyroid storm at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.6,
      "end_seconds": 230.47,
      "duration_seconds": 3.87,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.77,
      "end_seconds": 248.58,
      "duration_seconds": 16.81,
      "text": "Nothing I've seen today points to an emergency. It looks like a thyroid storm, but I'd like to confirm. Stop me if I've got anything wrong. You've had a high temperature for ten days, and no chest pain or recent infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.53,
      "end_seconds": 252.49,
      "duration_seconds": 1.96,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.0,
      "end_seconds": 271.6,
      "duration_seconds": 3.6,
      "text": "We should do an ECG for fast heart rhythm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 273.08,
      "end_seconds": 275.7,
      "duration_seconds": 2.62,
      "text": "The earliest is Tuesday, 9 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.79,
      "end_seconds": 279.41,
      "duration_seconds": 2.62,
      "text": "Tuesday, that works for me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.95,
      "end_seconds": 295.4,
      "duration_seconds": 11.45,
      "text": "This is an emergency, you will be treated in high dependency. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.46,
      "end_seconds": 301.39,
      "duration_seconds": 3.93,
      "text": "Erm, uh, sure, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.78,
      "end_seconds": 308.67,
      "duration_seconds": 5.89,
      "text": "let's plan a check straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.71,
      "end_seconds": 311.78,
      "duration_seconds": 2.07,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}