{
  "schema_version": "1.0",
  "encounter_id": "02315",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 3.76,
      "duration_seconds": 2.97,
      "text": "Okay, good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.72,
      "end_seconds": 6.9,
      "duration_seconds": 1.18,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.9,
      "end_seconds": 11.57,
      "duration_seconds": 2.67,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.07,
      "end_seconds": 19.61,
      "duration_seconds": 6.54,
      "text": "Honestly, it's pain out of proportion, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.3,
      "end_seconds": 21.59,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.61,
      "end_seconds": 30.61,
      "duration_seconds": 8.0,
      "text": "For five days, I'd say. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.62,
      "end_seconds": 38.1,
      "duration_seconds": 5.48,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.07,
      "end_seconds": 49.75,
      "duration_seconds": 10.68,
      "text": "Moderate, really. It's once or twice a day. I've also had severe pain in the lower leg after a fracture, for three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.19,
      "end_seconds": 68.49,
      "duration_seconds": 3.3,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.48,
      "end_seconds": 73.23,
      "duration_seconds": 2.75,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.89,
      "end_seconds": 76.44,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.19,
      "end_seconds": 88.1,
      "duration_seconds": 9.91,
      "text": "So, I take simvastatin, 20 milligrams, at night for my cholesterol. Strong painkillers. I take it not working."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 104.98,
      "duration_seconds": 2.39,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.15,
      "end_seconds": 108.14,
      "duration_seconds": 1.99,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.86,
      "end_seconds": 113.22,
      "duration_seconds": 3.36,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.24,
      "end_seconds": 117.47,
      "duration_seconds": 2.23,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.5,
      "end_seconds": 122.11,
      "duration_seconds": 2.61,
      "text": "I follow. Alright, are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.16,
      "end_seconds": 126.4,
      "duration_seconds": 3.24,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.44,
      "end_seconds": 132.87,
      "duration_seconds": 4.43,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.05,
      "end_seconds": 137.87,
      "duration_seconds": 3.82,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.51,
      "end_seconds": 140.1,
      "duration_seconds": 1.59,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.6,
      "end_seconds": 143.0,
      "duration_seconds": 2.4,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.11,
      "end_seconds": 154.25,
      "duration_seconds": 4.14,
      "text": "And what about wound infection, chest pain or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.32,
      "end_seconds": 161.16,
      "duration_seconds": 4.84,
      "text": "No wound infection, chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.03,
      "end_seconds": 166.22,
      "duration_seconds": 3.19,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.18,
      "end_seconds": 171.0,
      "duration_seconds": 2.82,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 176.12,
      "duration_seconds": 4.11,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.15,
      "end_seconds": 179.37,
      "duration_seconds": 2.22,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.69,
      "end_seconds": 183.78,
      "duration_seconds": 3.09,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.0,
      "end_seconds": 196.2,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.53,
      "end_seconds": 223.56,
      "duration_seconds": 8.03,
      "text": "Okay: respiratory rate 17, pulse 78, blood pressure 119 over 69. And temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.71,
      "end_seconds": 226.36,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.78,
      "end_seconds": 230.6,
      "duration_seconds": 2.82,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.06,
      "end_seconds": 238.47,
      "duration_seconds": 5.41,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.32,
      "end_seconds": 249.27,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.4,
      "end_seconds": 251.72,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.97,
      "end_seconds": 265.41,
      "duration_seconds": 6.44,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.25,
      "end_seconds": 283.73,
      "duration_seconds": 15.48,
      "text": "Thank you, you can get dressed. Having listened and examined, my working impression is possible compartment syndrome needing urgent surgery. Let's get measuring the pressure in the leg, for possible compartment syndrome."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.59,
      "end_seconds": 285.61,
      "duration_seconds": 1.02,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.7,
      "end_seconds": 296.28,
      "duration_seconds": 9.58,
      "text": "Remove the cast now, you are going to theatre for a decompression. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.96,
      "end_seconds": 301.43,
      "duration_seconds": 4.47,
      "text": "I mean, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.14,
      "end_seconds": 303.81,
      "duration_seconds": 1.67,
      "text": "Have a good day."
    }
  ]
}