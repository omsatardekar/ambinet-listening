{
  "schema_version": "1.0",
  "encounter_id": "02112",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 6.58,
      "duration_seconds": 5.31,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 11.55,
      "duration_seconds": 4.09,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.71,
      "end_seconds": 19.77,
      "duration_seconds": 7.06,
      "text": "Let me think, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.72,
      "end_seconds": 25.18,
      "duration_seconds": 3.46,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.52,
      "end_seconds": 30.98,
      "duration_seconds": 4.46,
      "text": "oh, we came because of a red swollen foot"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.54,
      "end_seconds": 36.65,
      "duration_seconds": 5.11,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.21,
      "end_seconds": 42.48,
      "duration_seconds": 5.27,
      "text": "He takes metformin, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.45,
      "end_seconds": 47.25,
      "duration_seconds": 2.8,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.81,
      "end_seconds": 52.68,
      "duration_seconds": 3.87,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.92,
      "end_seconds": 56.69,
      "duration_seconds": 3.77,
      "text": "Understood. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.26,
      "end_seconds": 64.12,
      "duration_seconds": 6.86,
      "text": "Mild, really. And a smell from the wound as well, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.09,
      "end_seconds": 70.36,
      "duration_seconds": 4.27,
      "text": "so, any an ulcer under the big toe as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.51,
      "end_seconds": 78.46,
      "duration_seconds": 3.95,
      "text": "Yeah, I've had that since last night."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.37,
      "end_seconds": 83.68,
      "duration_seconds": 3.31,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 86.7,
      "duration_seconds": 1.04,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.23,
      "end_seconds": 88.29,
      "duration_seconds": 1.06,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.98,
      "end_seconds": 103.41,
      "duration_seconds": 5.43,
      "text": "Okay, and what about pain in the foot, tracking redness or black skin?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.22,
      "end_seconds": 108.04,
      "duration_seconds": 2.82,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.58,
      "end_seconds": 109.88,
      "duration_seconds": 1.3,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.61,
      "end_seconds": 114.83,
      "duration_seconds": 3.22,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.11,
      "end_seconds": 121.84,
      "duration_seconds": 3.73,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.55,
      "end_seconds": 125.57,
      "duration_seconds": 2.02,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.49,
      "end_seconds": 128.0,
      "duration_seconds": 1.51,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.6,
      "end_seconds": 130.83,
      "duration_seconds": 2.23,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.25,
      "end_seconds": 135.09,
      "duration_seconds": 2.84,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.3,
      "end_seconds": 139.83,
      "duration_seconds": 3.53,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.49,
      "end_seconds": 144.25,
      "duration_seconds": 3.76,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.06,
      "end_seconds": 148.18,
      "duration_seconds": 2.12,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.71,
      "end_seconds": 151.26,
      "duration_seconds": 2.55,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.46,
      "end_seconds": 153.93,
      "duration_seconds": 1.47,
      "text": "I've got diabetes"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.43,
      "end_seconds": 166.83,
      "duration_seconds": 1.4,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.37,
      "end_seconds": 172.17,
      "duration_seconds": 3.8,
      "text": "ah, nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 174.63,
      "duration_seconds": 1.7,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.74,
      "end_seconds": 178.08,
      "duration_seconds": 2.34,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.09,
      "end_seconds": 183.06,
      "duration_seconds": 2.97,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.69,
      "end_seconds": 188.61,
      "duration_seconds": 3.92,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.12,
      "end_seconds": 204.56,
      "duration_seconds": 4.44,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.17,
      "end_seconds": 219.68,
      "duration_seconds": 2.51,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 235.49,
      "duration_seconds": 6.52,
      "text": "Okay: pressure 117 over 78, temperature 38.8, pulse 88. And respiratory rate 22."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.1,
      "end_seconds": 241.08,
      "duration_seconds": 3.98,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.42,
      "end_seconds": 243.39,
      "duration_seconds": 0.97,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 246.9,
      "duration_seconds": 2.47,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.4,
      "end_seconds": 271.85,
      "duration_seconds": 6.45,
      "text": "the ulcer is deep to the fat with surrounding redness and the foot pulses are present"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.08,
      "end_seconds": 312.6,
      "duration_seconds": 35.52,
      "text": "All finished, thank you. Okay, thinking it through, I think we're dealing with an infected diabetic foot ulcer at this stage. I'm sending you for a wound swab because of infected ulcer. We'll begin with co-amoxiclav, 625 milligrams, three times a day, seven days. That's for infected ulcer. Keep the weight off the foot and keep the dressing dry. If it hasn't settled in two weeks, we'd think about an X-ray of the foot, but not now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.52,
      "end_seconds": 321.54,
      "duration_seconds": 8.02,
      "text": "See me again in two days. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.46,
      "end_seconds": 334.99,
      "duration_seconds": 11.53,
      "text": "so, I take the co-amoxiclav, 625 milligrams, three times a day and come back in two days is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.63,
      "end_seconds": 341.83,
      "duration_seconds": 5.2,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.62,
      "end_seconds": 347.96,
      "duration_seconds": 4.34,
      "text": "No, um, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.49,
      "end_seconds": 350.45,
      "duration_seconds": 1.96,
      "text": "Have a good day."
    }
  ]
}