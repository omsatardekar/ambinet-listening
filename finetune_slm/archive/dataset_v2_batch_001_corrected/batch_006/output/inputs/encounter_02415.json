{
  "schema_version": "1.0",
  "encounter_id": "02415",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.29,
      "end_seconds": 5.65,
      "duration_seconds": 4.36,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 10.81,
      "duration_seconds": 4.6,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 16.2,
      "duration_seconds": 4.31,
      "text": "I'm here because of a red swollen foot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.78,
      "end_seconds": 20.27,
      "duration_seconds": 3.49,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.13,
      "end_seconds": 32.18,
      "duration_seconds": 11.05,
      "text": "I'd say moderate. Oh, and a smell from the wound. As for smell from the wound, I'd call it moderate."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.72,
      "end_seconds": 34.75,
      "duration_seconds": 2.03,
      "text": "Have you been feeling shivery?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.36,
      "end_seconds": 38.49,
      "duration_seconds": 2.13,
      "text": "Yes, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.69,
      "end_seconds": 40.04,
      "duration_seconds": 1.35,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.42,
      "end_seconds": 49.76,
      "duration_seconds": 8.34,
      "text": "Hmm, there was an ulcer under the big toe, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 64.56,
      "end_seconds": 72.58,
      "duration_seconds": 8.02,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 95 percent, pulse 88, temperature 38.4, BP is 113 over 71."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.81,
      "end_seconds": 74.73,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.12,
      "end_seconds": 80.96,
      "duration_seconds": 3.84,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.71,
      "end_seconds": 84.85,
      "duration_seconds": 2.14,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.4,
      "end_seconds": 101.78,
      "duration_seconds": 6.38,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.48,
      "end_seconds": 108.66,
      "duration_seconds": 2.18,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.02,
      "end_seconds": 123.29,
      "duration_seconds": 2.27,
      "text": "Any black skin or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.19,
      "end_seconds": 132.52,
      "duration_seconds": 3.33,
      "text": "Uh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.28,
      "end_seconds": 137.53,
      "duration_seconds": 3.25,
      "text": "Any tracking redness or pain in the foot?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.32,
      "end_seconds": 141.96,
      "duration_seconds": 2.64,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.82,
      "end_seconds": 146.5,
      "duration_seconds": 3.68,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.46,
      "end_seconds": 149.44,
      "duration_seconds": 1.98,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.01,
      "end_seconds": 153.45,
      "duration_seconds": 2.44,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.9,
      "end_seconds": 159.8,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.75,
      "end_seconds": 169.14,
      "duration_seconds": 3.39,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.84,
      "end_seconds": 187.71,
      "duration_seconds": 17.87,
      "text": "Glycomet. I take it 500 milligrams, twice a day for my sugar. I looked a few things up online, and that probably didn't help. It's omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.56,
      "end_seconds": 195.58,
      "duration_seconds": 3.02,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.42,
      "end_seconds": 204.89,
      "duration_seconds": 7.47,
      "text": "For two months. Sumatriptan, 50 milligrams, when needed for my migraines. Gliclazide I don't take anymore."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.08,
      "end_seconds": 209.82,
      "duration_seconds": 3.74,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.47,
      "end_seconds": 214.69,
      "duration_seconds": 3.22,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.67,
      "end_seconds": 216.72,
      "duration_seconds": 1.05,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.96,
      "end_seconds": 221.11,
      "duration_seconds": 2.15,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.53,
      "end_seconds": 223.23,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.95,
      "end_seconds": 230.55,
      "duration_seconds": 3.6,
      "text": "I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.8,
      "end_seconds": 242.29,
      "duration_seconds": 10.49,
      "text": "I follow. Right, so acid reflux is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.08,
      "end_seconds": 250.03,
      "duration_seconds": 1.95,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.75,
      "end_seconds": 258.73,
      "duration_seconds": 4.98,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.42,
      "end_seconds": 266.65,
      "duration_seconds": 7.23,
      "text": "Years back I got a rash from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.84,
      "end_seconds": 269.89,
      "duration_seconds": 2.05,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.27,
      "end_seconds": 274.03,
      "duration_seconds": 2.76,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.12,
      "end_seconds": 279.08,
      "duration_seconds": 2.96,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 280.67,
      "end_seconds": 286.14,
      "duration_seconds": 5.47,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.63,
      "end_seconds": 297.01,
      "duration_seconds": 9.38,
      "text": "Right, here's what I'm thinking. It fits best with an infected diabetic foot ulcer. Osteomyelitis is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.59,
      "end_seconds": 303.35,
      "duration_seconds": 4.76,
      "text": "Um, uh, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.19,
      "end_seconds": 312.49,
      "duration_seconds": 8.3,
      "text": "Nothing I've seen today points to an emergency. It looks like an infected diabetic foot ulcer, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.85,
      "end_seconds": 360.66,
      "duration_seconds": 32.81,
      "text": "I'd like to arrange blood tests for infected ulcer. A wound swab is what I'd like next, for infected ulcer. I'd like you to take co-amoxiclav, 625 milligrams, three times a day, seven days. You take it by mouth. It's for infected ulcer. Keep the weight off the foot and keep the dressing dry. See me again in two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.8,
      "end_seconds": 365.41,
      "duration_seconds": 3.61,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.27,
      "end_seconds": 367.46,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
}