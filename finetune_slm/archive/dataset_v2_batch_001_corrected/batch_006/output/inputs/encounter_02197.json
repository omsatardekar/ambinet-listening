{
  "schema_version": "1.0",
  "encounter_id": "02197",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.55,
      "end_seconds": 6.88,
      "duration_seconds": 6.33,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 11.61,
      "duration_seconds": 4.15,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.97,
      "end_seconds": 26.73,
      "duration_seconds": 13.76,
      "text": "Mainly a swollen cheek. There's a couple of other things, but that's the main one. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.78,
      "end_seconds": 30.95,
      "duration_seconds": 3.17,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.69,
      "end_seconds": 35.25,
      "duration_seconds": 3.56,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.72,
      "end_seconds": 40.12,
      "duration_seconds": 2.4,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.74,
      "end_seconds": 50.01,
      "duration_seconds": 8.27,
      "text": "Let me think, you know, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.15,
      "end_seconds": 53.97,
      "duration_seconds": 2.82,
      "text": "Have you had a bad taste?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.39,
      "end_seconds": 67.97,
      "duration_seconds": 12.58,
      "text": "Yes, uh, actually. Erm, and there's a throbbing toothache as well, about a month now. With throbbing toothache, it's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.6,
      "end_seconds": 72.8,
      "duration_seconds": 4.2,
      "text": "Okay, any difficulty swallowing or eye swelling at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.97,
      "end_seconds": 79.21,
      "duration_seconds": 5.24,
      "text": "Well, uh, no, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.91,
      "end_seconds": 84.66,
      "duration_seconds": 4.75,
      "text": "A few quick ones: difficulty opening the mouth or noisy breathing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.28,
      "end_seconds": 95.23,
      "duration_seconds": 9.95,
      "text": "Sorry, what was I saying, no difficulty opening the mouth or noisy breathing, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 99.46,
      "duration_seconds": 2.2,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.75,
      "end_seconds": 104.32,
      "duration_seconds": 3.57,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.84,
      "end_seconds": 107.97,
      "duration_seconds": 2.13,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.0,
      "end_seconds": 113.24,
      "duration_seconds": 4.24,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.96,
      "end_seconds": 116.37,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.01,
      "end_seconds": 122.87,
      "duration_seconds": 5.86,
      "text": "Okay, um, so no, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.44,
      "end_seconds": 138.18,
      "duration_seconds": 2.74,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.55,
      "end_seconds": 148.35,
      "duration_seconds": 8.8,
      "text": "I take propranolol, 40 milligrams, twice a day for the migraine prevention. Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.01,
      "end_seconds": 152.88,
      "duration_seconds": 2.87,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.04,
      "end_seconds": 158.46,
      "duration_seconds": 4.42,
      "text": "I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.37,
      "end_seconds": 161.34,
      "duration_seconds": 0.97,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.57,
      "end_seconds": 175.02,
      "duration_seconds": 1.45,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.41,
      "end_seconds": 182.91,
      "duration_seconds": 6.5,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.93,
      "end_seconds": 187.46,
      "duration_seconds": 2.53,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.49,
      "end_seconds": 193.09,
      "duration_seconds": 3.6,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.94,
      "end_seconds": 198.77,
      "duration_seconds": 2.83,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.47,
      "end_seconds": 204.88,
      "duration_seconds": 4.41,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.59,
      "end_seconds": 207.83,
      "duration_seconds": 2.24,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.42,
      "end_seconds": 214.87,
      "duration_seconds": 5.45,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 219.14,
      "end_seconds": 227.4,
      "duration_seconds": 8.26,
      "text": "Doctor, I've got the readings for you. Respiratory rate 22, blood pressure 126 over 74. Saturation 96 percent, pulse 102."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.49,
      "end_seconds": 230.78,
      "duration_seconds": 1.29,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.97,
      "end_seconds": 235.16,
      "duration_seconds": 2.19,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.29,
      "end_seconds": 239.2,
      "duration_seconds": 2.91,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.32,
      "end_seconds": 257.02,
      "duration_seconds": 5.7,
      "text": "The lower right molar is tender with swollen gum and the cheek is puffy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.96,
      "end_seconds": 273.43,
      "duration_seconds": 10.47,
      "text": "Alright, good, you can sit up again. Let me tell you where I've got to. It fits best with a dental abscess."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.43,
      "end_seconds": 277.85,
      "duration_seconds": 3.42,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 303.85,
      "duration_seconds": 24.19,
      "text": "Nothing I've seen today points to an emergency. It looks like a dental abscess, but I'd like to confirm. I want a dental X-ray done, that's for dental abscess. We'll begin with amoxicillin, 500 milligrams, three times a day, five days. It's for dental abscess. See the dentist today, rinse with warm salt water. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.45,
      "end_seconds": 308.6,
      "duration_seconds": 3.15,
      "text": "Great, thank you for your help."
    }
  ]
}