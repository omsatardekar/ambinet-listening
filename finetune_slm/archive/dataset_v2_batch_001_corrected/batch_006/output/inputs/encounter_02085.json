{
  "schema_version": "1.0",
  "encounter_id": "02085",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 7.26,
      "duration_seconds": 6.16,
      "text": "Let me think, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.8,
      "end_seconds": 13.63,
      "duration_seconds": 4.83,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.61,
      "end_seconds": 23.82,
      "duration_seconds": 8.21,
      "text": "I'm here because of rapidly spreading redness on the thigh. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.5,
      "end_seconds": 26.83,
      "duration_seconds": 2.33,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.5,
      "end_seconds": 35.99,
      "duration_seconds": 7.49,
      "text": "It's been two months, I'm fairly sure. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.01,
      "end_seconds": 54.05,
      "duration_seconds": 5.04,
      "text": "So, have you had any diarrhoea, recent cut or cough?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.1,
      "end_seconds": 61.46,
      "duration_seconds": 2.36,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.49,
      "end_seconds": 65.26,
      "duration_seconds": 2.77,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.55,
      "end_seconds": 72.99,
      "duration_seconds": 6.44,
      "text": "Sorry, um, what was I saying, no, that's all fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.3,
      "end_seconds": 77.43,
      "duration_seconds": 3.13,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.02,
      "end_seconds": 82.46,
      "duration_seconds": 4.44,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.25,
      "end_seconds": 97.49,
      "duration_seconds": 2.24,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.06,
      "end_seconds": 102.96,
      "duration_seconds": 4.9,
      "text": "Ah, I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.73,
      "end_seconds": 106.41,
      "duration_seconds": 2.68,
      "text": "Alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.19,
      "end_seconds": 108.9,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.51,
      "end_seconds": 112.08,
      "duration_seconds": 1.57,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.8,
      "end_seconds": 116.74,
      "duration_seconds": 3.94,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.71,
      "end_seconds": 120.95,
      "duration_seconds": 2.24,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.02,
      "end_seconds": 126.84,
      "duration_seconds": 3.82,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.53,
      "end_seconds": 132.16,
      "duration_seconds": 1.63,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.83,
      "end_seconds": 137.01,
      "duration_seconds": 4.18,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.93,
      "end_seconds": 141.19,
      "duration_seconds": 3.26,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.84,
      "end_seconds": 147.2,
      "duration_seconds": 4.36,
      "text": "Hmm, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.03,
      "end_seconds": 152.53,
      "duration_seconds": 3.5,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.2,
      "end_seconds": 155.6,
      "duration_seconds": 2.4,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.47,
      "end_seconds": 162.83,
      "duration_seconds": 5.36,
      "text": "I see, go ahead. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.37,
      "end_seconds": 170.43,
      "duration_seconds": 7.06,
      "text": "Yes, uh, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 174.98,
      "duration_seconds": 2.78,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.16,
      "end_seconds": 180.3,
      "duration_seconds": 4.14,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.39,
      "end_seconds": 185.56,
      "duration_seconds": 4.17,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.21,
      "end_seconds": 196.17,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.22,
      "end_seconds": 212.61,
      "duration_seconds": 7.39,
      "text": "Okay: heart rate 94, temperature 37.0, blood pressure 101 over 56. And respiratory rate 18."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.57,
      "end_seconds": 220.7,
      "duration_seconds": 5.13,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.39,
      "end_seconds": 223.93,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.98,
      "end_seconds": 227.34,
      "duration_seconds": 2.36,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.33,
      "end_seconds": 249.11,
      "duration_seconds": 7.78,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.2,
      "end_seconds": 256.71,
      "duration_seconds": 2.51,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.72,
      "end_seconds": 276.9,
      "duration_seconds": 6.18,
      "text": "Putting it all together, it fits best with a possible necrotising soft tissue infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.47,
      "end_seconds": 307.5,
      "duration_seconds": 16.03,
      "text": "Let's book an urgent surgical review to look into possible necrotising infection. You need emergency surgery and intravenous antibiotics, we are going now. The surgical team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.39,
      "end_seconds": 310.09,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.93,
      "end_seconds": 318.04,
      "duration_seconds": 6.11,
      "text": "I'd like to see you again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.08,
      "end_seconds": 321.87,
      "duration_seconds": 2.79,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.66,
      "end_seconds": 324.98,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}