{
  "schema_version": "1.0",
  "encounter_id": "02265",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 3.79,
      "duration_seconds": 2.49,
      "text": "Alright, morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.38,
      "end_seconds": 8.65,
      "duration_seconds": 3.27,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.23,
      "end_seconds": 12.48,
      "duration_seconds": 3.25,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.35,
      "end_seconds": 18.28,
      "duration_seconds": 3.93,
      "text": "So, I've been getting puffed climbing stairs, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 20.26,
      "end_seconds": 29.61,
      "duration_seconds": 9.35,
      "text": "Here are the numbers, doctor. Respiratory rate 15, pulse is 83 beats a minute, BP is 110 over 75. Saturation 98 percent."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.83,
      "end_seconds": 31.83,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.6,
      "end_seconds": 48.03,
      "duration_seconds": 3.43,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.68,
      "end_seconds": 52.62,
      "duration_seconds": 2.94,
      "text": "Mm, ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.97,
      "end_seconds": 62.79,
      "duration_seconds": 8.82,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.87,
      "end_seconds": 73.94,
      "duration_seconds": 9.07,
      "text": "It's worse with stairs. Moderate, I'd say. Let me think, I've been feeling unfit too, for six months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 75.59,
      "duration_seconds": 0.86,
      "text": "Any palpitations?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.14,
      "end_seconds": 79.46,
      "duration_seconds": 2.32,
      "text": "I haven't noticed any palpitations."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.98,
      "end_seconds": 83.69,
      "duration_seconds": 3.71,
      "text": "Have you noticed fainting, wheeze or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.3,
      "end_seconds": 89.51,
      "duration_seconds": 5.21,
      "text": "I haven't had fainting, wheeze or chest pain, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.18,
      "end_seconds": 93.92,
      "duration_seconds": 3.74,
      "text": "Alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.93,
      "end_seconds": 98.0,
      "duration_seconds": 2.07,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.06,
      "end_seconds": 106.47,
      "duration_seconds": 3.41,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.42,
      "end_seconds": 109.6,
      "duration_seconds": 2.18,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.26,
      "end_seconds": 114.39,
      "duration_seconds": 3.13,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.05,
      "end_seconds": 118.6,
      "duration_seconds": 2.55,
      "text": "Gout, for about ten years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.37,
      "end_seconds": 120.8,
      "duration_seconds": 1.43,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.48,
      "end_seconds": 123.16,
      "duration_seconds": 1.68,
      "text": "Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.11,
      "end_seconds": 132.8,
      "duration_seconds": 7.69,
      "text": "Hm, okay. Right, so low haemoglobin is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.63,
      "end_seconds": 147.83,
      "duration_seconds": 3.2,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.68,
      "end_seconds": 152.94,
      "duration_seconds": 3.26,
      "text": "Allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.18,
      "end_seconds": 154.49,
      "duration_seconds": 1.31,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.29,
      "end_seconds": 161.49,
      "duration_seconds": 6.2,
      "text": "I'm on iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.58,
      "end_seconds": 168.67,
      "duration_seconds": 5.09,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.5,
      "end_seconds": 173.92,
      "duration_seconds": 3.42,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.62,
      "end_seconds": 178.52,
      "duration_seconds": 3.9,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.29,
      "end_seconds": 183.99,
      "duration_seconds": 3.7,
      "text": "Uh, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.6,
      "end_seconds": 187.24,
      "duration_seconds": 2.64,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.79,
      "end_seconds": 191.54,
      "duration_seconds": 3.75,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.56,
      "end_seconds": 209.5,
      "duration_seconds": 1.94,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.26,
      "end_seconds": 214.55,
      "duration_seconds": 4.29,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.15,
      "end_seconds": 217.02,
      "duration_seconds": 1.87,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.73,
      "end_seconds": 222.45,
      "duration_seconds": 4.72,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.05,
      "end_seconds": 225.62,
      "duration_seconds": 2.57,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.15,
      "end_seconds": 230.46,
      "duration_seconds": 3.31,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.32,
      "end_seconds": 236.34,
      "duration_seconds": 4.02,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 240.07,
      "duration_seconds": 2.42,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.06,
      "end_seconds": 259.34,
      "duration_seconds": 6.28,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.46,
      "end_seconds": 261.59,
      "duration_seconds": 1.13,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.14,
      "end_seconds": 276.07,
      "duration_seconds": 8.93,
      "text": "Okay, that's enough for me. Okay, so my impression is this: It points towards breathlessness from low fitness."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.79,
      "end_seconds": 285.16,
      "duration_seconds": 7.37,
      "text": "Sorry, uh, what was I saying, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.12,
      "end_seconds": 298.47,
      "duration_seconds": 11.35,
      "text": "I understand the worry. At the moment I'd say it's breathlessness from low fitness, and we'll know more once the a peak flow is back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 299.85,
      "end_seconds": 304.04,
      "duration_seconds": 4.19,
      "text": "I've already done a peak flow, it's ready for you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.41,
      "end_seconds": 315.38,
      "duration_seconds": 9.97,
      "text": "Great, that's useful. Build up to thirty minutes of brisk walking five days a week. Let's plan a check in eight weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.85,
      "end_seconds": 319.6,
      "duration_seconds": 2.75,
      "text": "Yeah, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.86,
      "end_seconds": 323.61,
      "duration_seconds": 2.75,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.74,
      "end_seconds": 327.07,
      "duration_seconds": 2.33,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.25,
      "end_seconds": 329.94,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}