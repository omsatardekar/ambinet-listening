{
  "schema_version": "1.0",
  "encounter_id": "02064",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 4.05,
      "duration_seconds": 3.2,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.65,
      "end_seconds": 5.77,
      "duration_seconds": 1.12,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.56,
      "end_seconds": 13.94,
      "duration_seconds": 4.38,
      "text": "Doctor, you know, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.81,
      "end_seconds": 21.63,
      "duration_seconds": 6.82,
      "text": "Yes, that's no problem at all. Please sit. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.79,
      "end_seconds": 27.08,
      "duration_seconds": 4.29,
      "text": "We came because of a lump in my left breast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.24,
      "end_seconds": 31.47,
      "duration_seconds": 3.23,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.03,
      "end_seconds": 47.8,
      "duration_seconds": 14.77,
      "text": "It's been like this since this morning. And the lump being there for a month, too. I've also had slight tenderness, since Friday. As for slight tenderness, moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.92,
      "end_seconds": 56.04,
      "duration_seconds": 7.12,
      "text": "Have you had a lump in your left breast before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.77,
      "end_seconds": 62.36,
      "duration_seconds": 4.59,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.03,
      "end_seconds": 78.61,
      "duration_seconds": 1.58,
      "text": "Nothing like weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.16,
      "end_seconds": 82.53,
      "duration_seconds": 3.37,
      "text": "I haven't noticed any weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.21,
      "end_seconds": 90.66,
      "duration_seconds": 6.45,
      "text": "A few quick ones: lump under the arm, skin dimpling or nipple discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.57,
      "end_seconds": 97.93,
      "duration_seconds": 5.36,
      "text": "No, no lump under the arm, skin dimpling or nipple discharge."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 101.96,
      "duration_seconds": 2.03,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.5,
      "end_seconds": 103.85,
      "duration_seconds": 1.35,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.94,
      "end_seconds": 107.62,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.34,
      "end_seconds": 110.95,
      "duration_seconds": 1.61,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.89,
      "end_seconds": 114.29,
      "duration_seconds": 2.4,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 128.65,
      "duration_seconds": 13.04,
      "text": "Yes, you know, I had a meniscus repair on my knee, four years ago. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.66,
      "end_seconds": 131.57,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 135.93,
      "duration_seconds": 2.8,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.84,
      "end_seconds": 140.56,
      "duration_seconds": 2.72,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.26,
      "end_seconds": 143.97,
      "duration_seconds": 2.71,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.42,
      "end_seconds": 148.02,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.99,
      "end_seconds": 153.73,
      "duration_seconds": 3.74,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.44,
      "end_seconds": 157.7,
      "duration_seconds": 3.26,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.42,
      "end_seconds": 166.76,
      "duration_seconds": 7.34,
      "text": "I have thin bones. Let me think, I've had heart failure for nearly five years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.56,
      "end_seconds": 172.18,
      "duration_seconds": 3.62,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.77,
      "end_seconds": 175.33,
      "duration_seconds": 2.56,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.21,
      "end_seconds": 178.8,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.19,
      "end_seconds": 183.0,
      "duration_seconds": 2.81,
      "text": "So, I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.01,
      "end_seconds": 187.92,
      "duration_seconds": 3.91,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.05,
      "end_seconds": 195.91,
      "duration_seconds": 6.86,
      "text": "It's alendronate, 70 milligrams, once a week. Furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 196.54,
      "end_seconds": 204.6,
      "duration_seconds": 8.06,
      "text": "It's meant to be every morning, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.15,
      "end_seconds": 219.74,
      "duration_seconds": 2.59,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.47,
      "end_seconds": 231.42,
      "duration_seconds": 1.95,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.69,
      "end_seconds": 250.35,
      "duration_seconds": 6.66,
      "text": "Okay: blood pressure 114 over 72, heart rate 69, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.43,
      "end_seconds": 253.8,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.69,
      "end_seconds": 259.87,
      "duration_seconds": 4.18,
      "text": "Okay, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.7,
      "end_seconds": 264.84,
      "duration_seconds": 2.14,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.05,
      "end_seconds": 267.42,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.64,
      "end_seconds": 285.47,
      "duration_seconds": 8.83,
      "text": "There is a firm, mobile, round lump about two centimetres in the upper outer part and no lumps under the arm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.54,
      "end_seconds": 290.3,
      "duration_seconds": 2.76,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.54,
      "end_seconds": 339.29,
      "duration_seconds": 31.75,
      "text": "A mammogram and ultrasound is what I'd like next, for breast lump. I'm going to order a needle biopsy, for breast lump. That will help us see what's going on underneath and decide the next step. This does not mean cancer, but we do arrange a specialist one-stop clinic to be sure. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. See me again after the clinic."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.49,
      "end_seconds": 345.17,
      "duration_seconds": 4.68,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.78,
      "end_seconds": 349.09,
      "duration_seconds": 3.31,
      "text": "Thank you, um, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.9,
      "end_seconds": 352.19,
      "duration_seconds": 1.29,
      "text": "All the best."
    }
  ]
}