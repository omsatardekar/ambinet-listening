{
  "schema_version": "1.0",
  "encounter_id": "02219",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.71,
      "duration_seconds": 4.87,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.44,
      "end_seconds": 11.11,
      "duration_seconds": 3.67,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.05,
      "end_seconds": 18.78,
      "duration_seconds": 5.73,
      "text": "Um, so... hair loss on my shins. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.87,
      "end_seconds": 23.68,
      "duration_seconds": 3.81,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.32,
      "end_seconds": 29.29,
      "duration_seconds": 3.97,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.78,
      "end_seconds": 30.48,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.94,
      "end_seconds": 52.05,
      "duration_seconds": 4.11,
      "text": "Any back pain, fever or pain at rest at all?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.95,
      "end_seconds": 58.15,
      "duration_seconds": 5.2,
      "text": "No back pain, fever or pain at rest, none of it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.43,
      "end_seconds": 62.06,
      "duration_seconds": 3.63,
      "text": "Mm-hmm. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.18,
      "end_seconds": 64.55,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.06,
      "end_seconds": 67.74,
      "duration_seconds": 1.68,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.76,
      "end_seconds": 71.75,
      "duration_seconds": 2.99,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.71,
      "end_seconds": 78.19,
      "duration_seconds": 4.48,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.86,
      "end_seconds": 80.61,
      "duration_seconds": 1.75,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.11,
      "end_seconds": 86.27,
      "duration_seconds": 3.16,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.88,
      "end_seconds": 96.32,
      "duration_seconds": 5.44,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.14,
      "end_seconds": 100.37,
      "duration_seconds": 2.23,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.43,
      "end_seconds": 105.31,
      "duration_seconds": 3.88,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.67,
      "end_seconds": 111.69,
      "duration_seconds": 2.02,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.01,
      "end_seconds": 118.43,
      "duration_seconds": 5.42,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.24,
      "end_seconds": 122.62,
      "duration_seconds": 2.38,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.61,
      "end_seconds": 126.02,
      "duration_seconds": 2.41,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.17,
      "end_seconds": 142.53,
      "duration_seconds": 2.36,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.56,
      "end_seconds": 158.0,
      "duration_seconds": 3.44,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.0,
      "end_seconds": 176.33,
      "duration_seconds": 5.33,
      "text": "Okay: pulse 83, blood pressure 118 over 76, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.43,
      "end_seconds": 179.1,
      "duration_seconds": 1.67,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.24,
      "end_seconds": 182.69,
      "duration_seconds": 2.45,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.51,
      "end_seconds": 187.48,
      "duration_seconds": 1.97,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.79,
      "end_seconds": 190.92,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.78,
      "end_seconds": 212.47,
      "duration_seconds": 6.69,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.04,
      "end_seconds": 232.98,
      "duration_seconds": 14.94,
      "text": "You can sit up now. So where does that leave us? It's hard to say. Peripheral arterial disease is one possibility and a nerve problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.59,
      "end_seconds": 237.83,
      "duration_seconds": 3.24,
      "text": "I mean, will it clear up?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.37,
      "end_seconds": 245.88,
      "duration_seconds": 7.51,
      "text": "It's reasonable to be concerned, but right now peripheral arterial disease is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.94,
      "end_seconds": 263.69,
      "duration_seconds": 4.75,
      "text": "A cholesterol test is what I'd like next, for arterial disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 268.57,
      "end_seconds": 270.84,
      "duration_seconds": 2.27,
      "text": "The earliest is Friday, 10 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.43,
      "end_seconds": 272.42,
      "duration_seconds": 0.99,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.44,
      "end_seconds": 288.98,
      "duration_seconds": 14.54,
      "text": "You'll be taking clopidogrel, 75 milligrams, once a day, long term. That's for arterial disease. I'd like to see you again in four weeks. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.59,
      "end_seconds": 301.2,
      "duration_seconds": 10.61,
      "text": "So, I take the clopidogrel, 75 milligrams, once a day and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.62,
      "end_seconds": 309.15,
      "duration_seconds": 6.53,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.86,
      "end_seconds": 317.69,
      "duration_seconds": 2.83,
      "text": "Great, thank you for your help."
    }
  ]
}