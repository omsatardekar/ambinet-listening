{
  "schema_version": "1.0",
  "encounter_id": "02273",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 4.39,
      "duration_seconds": 3.45,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.66,
      "end_seconds": 11.49,
      "duration_seconds": 3.83,
      "text": "Oh, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.29,
      "end_seconds": 15.08,
      "duration_seconds": 2.79,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.73,
      "end_seconds": 27.39,
      "duration_seconds": 6.66,
      "text": "Well, I've been having yellow eyes. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 32.28,
      "duration_seconds": 2.94,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.9,
      "end_seconds": 45.54,
      "duration_seconds": 11.64,
      "text": "It's been one week now. I did try to ignore it for a while. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.92,
      "end_seconds": 51.09,
      "duration_seconds": 4.17,
      "text": "Alright, and what about high fever, itching or confusion?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.17,
      "end_seconds": 55.85,
      "duration_seconds": 2.68,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.63,
      "end_seconds": 60.77,
      "duration_seconds": 3.14,
      "text": "Alright, has there been any vomiting blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.96,
      "end_seconds": 63.84,
      "duration_seconds": 1.88,
      "text": "No. No vomiting blood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.61,
      "end_seconds": 67.2,
      "duration_seconds": 2.59,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.45,
      "end_seconds": 70.09,
      "duration_seconds": 1.64,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.55,
      "end_seconds": 73.66,
      "duration_seconds": 2.11,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.73,
      "end_seconds": 76.82,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.48,
      "end_seconds": 89.13,
      "duration_seconds": 3.65,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.68,
      "end_seconds": 93.74,
      "duration_seconds": 3.06,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.04,
      "end_seconds": 98.32,
      "duration_seconds": 3.28,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.1,
      "end_seconds": 112.77,
      "duration_seconds": 13.67,
      "text": "I've never touched a cigarette. I walk the dog every morning. My husband and I live above the shop. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.15,
      "end_seconds": 125.52,
      "duration_seconds": 2.37,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.53,
      "end_seconds": 130.24,
      "duration_seconds": 3.71,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.82,
      "end_seconds": 134.58,
      "duration_seconds": 2.76,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.27,
      "end_seconds": 137.41,
      "duration_seconds": 2.14,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.25,
      "end_seconds": 140.8,
      "duration_seconds": 2.55,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.42,
      "end_seconds": 145.89,
      "duration_seconds": 3.47,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.67,
      "end_seconds": 161.42,
      "duration_seconds": 2.75,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.25,
      "end_seconds": 171.76,
      "duration_seconds": 3.51,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.6,
      "end_seconds": 201.62,
      "duration_seconds": 8.02,
      "text": "Okay: oxygen saturation is 98 percent, pressure 114 over 68, temperature 36.8, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.39,
      "end_seconds": 204.3,
      "duration_seconds": 1.91,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.99,
      "end_seconds": 208.52,
      "duration_seconds": 3.53,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.8,
      "end_seconds": 214.84,
      "duration_seconds": 5.04,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.58,
      "end_seconds": 219.66,
      "duration_seconds": 3.08,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.98,
      "end_seconds": 236.1,
      "duration_seconds": 6.12,
      "text": "The whites of the eyes are yellow and the liver edge is tender."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.95,
      "end_seconds": 250.86,
      "duration_seconds": 0.91,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.3,
      "end_seconds": 262.89,
      "duration_seconds": 8.59,
      "text": "Okay, that's enough for me. Taking everything into account, the most likely explanation is acute hepatitis, possibly hepatitis A after travel."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.42,
      "end_seconds": 267.55,
      "duration_seconds": 3.13,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.16,
      "end_seconds": 282.59,
      "duration_seconds": 13.43,
      "text": "Nothing I've seen today points to an emergency. It looks like acute hepatitis, possibly hepatitis A after travel, but I'd like to confirm. We should do a hepatitis screen for jaundice."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.8,
      "end_seconds": 286.48,
      "duration_seconds": 2.68,
      "text": "Yeah, that's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.33,
      "end_seconds": 304.74,
      "duration_seconds": 17.41,
      "text": "I'd like to arrange liver blood tests for jaundice. Rest, avoid alcohol and wash your hands carefully, as it can spread. Cut down on salt and fried food for now, it really does make a difference. Let's review you in one week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.63,
      "end_seconds": 309.88,
      "duration_seconds": 2.25,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.22,
      "end_seconds": 315.6,
      "duration_seconds": 3.38,
      "text": "So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.11,
      "end_seconds": 319.07,
      "duration_seconds": 2.96,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.62,
      "end_seconds": 320.95,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}