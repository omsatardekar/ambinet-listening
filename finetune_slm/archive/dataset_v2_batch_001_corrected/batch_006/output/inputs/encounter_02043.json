{
  "schema_version": "1.0",
  "encounter_id": "02043",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 3.43,
      "duration_seconds": 2.59,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.26,
      "end_seconds": 5.29,
      "duration_seconds": 1.03,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.64,
      "end_seconds": 9.23,
      "duration_seconds": 2.59,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.74,
      "end_seconds": 16.17,
      "duration_seconds": 6.43,
      "text": "Yeah, it's my face drooping on the right. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.71,
      "end_seconds": 20.03,
      "duration_seconds": 3.32,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 30.21,
      "duration_seconds": 3.02,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.41,
      "end_seconds": 60.89,
      "duration_seconds": 9.48,
      "text": "Okay: pulse 81, saturation 98 percent, temperature 36.5, pressure 127 over 69. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.49,
      "end_seconds": 67.68,
      "duration_seconds": 5.19,
      "text": "I'd say one week. Actually, no, closer to three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.0,
      "end_seconds": 73.68,
      "duration_seconds": 2.68,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.66,
      "end_seconds": 78.04,
      "duration_seconds": 2.38,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.55,
      "end_seconds": 82.83,
      "duration_seconds": 3.28,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 98.05,
      "duration_seconds": 14.46,
      "text": "When it starts I tend to get not being able to close my eye as well. As for not being able to close my eye, severe, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.06,
      "end_seconds": 103.03,
      "duration_seconds": 2.97,
      "text": "Have you had headache, by any chance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.82,
      "end_seconds": 108.2,
      "duration_seconds": 3.38,
      "text": "Not at all, um, no headache."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 119.59,
      "duration_seconds": 9.53,
      "text": "Let me check a few things. Any weakness in the arm or leg, slurred speech or rash in the ear?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.09,
      "end_seconds": 125.28,
      "duration_seconds": 4.19,
      "text": "Uh, no, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.82,
      "end_seconds": 128.57,
      "duration_seconds": 2.75,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.55,
      "end_seconds": 130.94,
      "duration_seconds": 1.39,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.0,
      "end_seconds": 144.4,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.94,
      "end_seconds": 149.72,
      "duration_seconds": 1.78,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.24,
      "end_seconds": 154.83,
      "duration_seconds": 3.59,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.24,
      "end_seconds": 157.89,
      "duration_seconds": 1.65,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.75,
      "end_seconds": 172.99,
      "duration_seconds": 3.24,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.54,
      "end_seconds": 178.15,
      "duration_seconds": 4.61,
      "text": "I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.78,
      "end_seconds": 200.01,
      "duration_seconds": 3.23,
      "text": "Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.28,
      "end_seconds": 217.36,
      "duration_seconds": 11.08,
      "text": "I gave up cigarettes last spring. My partner and our baby. I grab fast food at lunch most days. I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.04,
      "end_seconds": 222.22,
      "duration_seconds": 4.18,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.69,
      "end_seconds": 233.18,
      "duration_seconds": 9.49,
      "text": "Okay, so I have thin bones, for nearly five years. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.56,
      "end_seconds": 236.55,
      "duration_seconds": 1.99,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.49,
      "end_seconds": 241.84,
      "duration_seconds": 2.35,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.88,
      "end_seconds": 244.89,
      "duration_seconds": 2.01,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.79,
      "end_seconds": 263.13,
      "duration_seconds": 8.34,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.82,
      "end_seconds": 280.74,
      "duration_seconds": 13.92,
      "text": "You can sit up now. Let me tell you where I've got to. It points towards Bell's palsy. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.76,
      "end_seconds": 284.75,
      "duration_seconds": 2.99,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.44,
      "end_seconds": 294.81,
      "duration_seconds": 6.37,
      "text": "Nothing I've seen today points to an emergency. It looks like Bell's palsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.53,
      "end_seconds": 315.41,
      "duration_seconds": 8.88,
      "text": "There's nothing new for me to start or arrange today. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.18,
      "end_seconds": 319.97,
      "duration_seconds": 2.79,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.29,
      "end_seconds": 322.71,
      "duration_seconds": 1.42,
      "text": "Take care now."
    }
  ]
}