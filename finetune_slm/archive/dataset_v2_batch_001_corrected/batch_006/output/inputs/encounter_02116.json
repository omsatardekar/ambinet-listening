{
  "schema_version": "1.0",
  "encounter_id": "02116",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 4.34,
      "duration_seconds": 3.84,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.56,
      "end_seconds": 11.72,
      "duration_seconds": 4.16,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.33,
      "end_seconds": 17.93,
      "duration_seconds": 5.6,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.82,
      "end_seconds": 24.78,
      "duration_seconds": 4.96,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.73,
      "end_seconds": 30.3,
      "duration_seconds": 4.57,
      "text": "I'm here because of a bump on the head."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.02,
      "end_seconds": 38.52,
      "duration_seconds": 6.5,
      "text": "Alright, what's the timeline, when did it begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.55,
      "end_seconds": 43.48,
      "duration_seconds": 3.93,
      "text": "Yeah, I've had it for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.0,
      "end_seconds": 45.71,
      "duration_seconds": 1.71,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.61,
      "end_seconds": 51.5,
      "duration_seconds": 3.89,
      "text": "Only a cold pack, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 57.62,
      "duration_seconds": 2.64,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.2,
      "end_seconds": 84.82,
      "duration_seconds": 26.62,
      "text": "A little tearfulness afterwards goes along with it, most of the time. As for little tearfulness afterwards, maybe a five out of ten on a bad day. I've had crying straight away too, for three days. Okay, so as for crying straight away, about a eight out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.77,
      "end_seconds": 93.8,
      "duration_seconds": 8.03,
      "text": "Alright, have you had a bump on the head before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.43,
      "end_seconds": 101.96,
      "duration_seconds": 6.53,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.22,
      "end_seconds": 105.63,
      "duration_seconds": 2.41,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.43,
      "end_seconds": 115.8,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.24,
      "end_seconds": 136.5,
      "duration_seconds": 5.26,
      "text": "Okay: pulse is 68 beats a minute, blood pressure 128 over 81."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.61,
      "end_seconds": 143.16,
      "duration_seconds": 4.55,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 146.34,
      "duration_seconds": 1.27,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.91,
      "end_seconds": 161.59,
      "duration_seconds": 7.68,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.25,
      "end_seconds": 166.12,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.07,
      "end_seconds": 188.77,
      "duration_seconds": 4.7,
      "text": "Let me check a few things. Any loss of consciousness or vomiting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.65,
      "end_seconds": 193.15,
      "duration_seconds": 2.5,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.22,
      "end_seconds": 198.19,
      "duration_seconds": 2.97,
      "text": "So, and what about fit or drowsiness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.88,
      "end_seconds": 203.57,
      "duration_seconds": 3.69,
      "text": "I haven't had fit or drowsiness, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.32,
      "end_seconds": 208.5,
      "duration_seconds": 3.18,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.07,
      "end_seconds": 210.64,
      "duration_seconds": 1.57,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.21,
      "end_seconds": 214.5,
      "duration_seconds": 3.29,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.86,
      "end_seconds": 219.69,
      "duration_seconds": 3.83,
      "text": "Ah, I have low haemoglobin, for five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.81,
      "end_seconds": 226.0,
      "duration_seconds": 5.19,
      "text": "Alright, low haemoglobin, that matches what I have here. How about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.52,
      "end_seconds": 230.66,
      "duration_seconds": 4.14,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.26,
      "end_seconds": 233.99,
      "duration_seconds": 1.73,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.39,
      "end_seconds": 237.05,
      "duration_seconds": 1.66,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.48,
      "end_seconds": 241.76,
      "duration_seconds": 3.28,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.5,
      "end_seconds": 247.19,
      "duration_seconds": 4.69,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.72,
      "end_seconds": 250.94,
      "duration_seconds": 3.22,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.95,
      "end_seconds": 255.66,
      "duration_seconds": 2.71,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.53,
      "end_seconds": 260.35,
      "duration_seconds": 3.82,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.98,
      "end_seconds": 265.3,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.26,
      "end_seconds": 288.02,
      "duration_seconds": 3.76,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 293.46,
      "end_seconds": 299.95,
      "duration_seconds": 6.49,
      "text": "She is on iron tablets, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.2,
      "end_seconds": 315.94,
      "duration_seconds": 2.74,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.36,
      "end_seconds": 323.65,
      "duration_seconds": 6.29,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.29,
      "end_seconds": 341.55,
      "duration_seconds": 16.26,
      "text": "Right, here's what I'm thinking. It points towards a minor head bump with no worrying signs. Alright, for now, no new medicines or tests are needed. Alright, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.21,
      "end_seconds": 345.71,
      "duration_seconds": 3.5,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}