{
  "schema_version": "1.0",
  "encounter_id": "02478",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 6.03,
      "duration_seconds": 4.8,
      "text": "Right then, come on in. So, what's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.1,
      "end_seconds": 13.82,
      "duration_seconds": 5.72,
      "text": "Doctor, it's a high temperature. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.53,
      "end_seconds": 16.31,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.4,
      "end_seconds": 29.06,
      "duration_seconds": 11.66,
      "text": "About a week, I think... sorry, about two weeks, I got that wrong. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.59,
      "end_seconds": 31.65,
      "duration_seconds": 2.06,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.12,
      "end_seconds": 47.1,
      "duration_seconds": 2.98,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.39,
      "end_seconds": 68.22,
      "duration_seconds": 5.83,
      "text": "Okay: saturation 98 percent, pulse is 91 beats a minute, pressure 114 over 68."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.19,
      "end_seconds": 71.74,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.6,
      "end_seconds": 78.08,
      "duration_seconds": 4.48,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.61,
      "end_seconds": 84.74,
      "duration_seconds": 4.13,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.7,
      "end_seconds": 88.36,
      "duration_seconds": 2.66,
      "text": "So, I'm just checking this side."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 108.45,
      "duration_seconds": 6.95,
      "text": "You are hot, shaking, and your pulse is over one hundred and forty and irregular."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.96,
      "end_seconds": 114.32,
      "duration_seconds": 2.36,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.55,
      "end_seconds": 135.73,
      "duration_seconds": 5.18,
      "text": "Let me check a few things. Any recent infection or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.4,
      "end_seconds": 142.2,
      "duration_seconds": 4.8,
      "text": "I haven't had recent infection or chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.85,
      "end_seconds": 146.14,
      "duration_seconds": 2.29,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.98,
      "end_seconds": 147.97,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.99,
      "end_seconds": 152.88,
      "duration_seconds": 3.89,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.86,
      "end_seconds": 156.01,
      "duration_seconds": 2.15,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.62,
      "end_seconds": 157.62,
      "duration_seconds": 1.0,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.65,
      "end_seconds": 162.13,
      "duration_seconds": 3.48,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.63,
      "end_seconds": 174.25,
      "duration_seconds": 10.62,
      "text": "Right, yes, heart disease and diabetes are known to us, good to have that clear. Let's run through your medicines. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.76,
      "end_seconds": 180.41,
      "duration_seconds": 4.65,
      "text": "Sitagliptin, 100 milligrams, once a day for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.18,
      "end_seconds": 194.07,
      "duration_seconds": 2.89,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.62,
      "end_seconds": 198.61,
      "duration_seconds": 3.99,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.09,
      "end_seconds": 203.8,
      "duration_seconds": 3.71,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.27,
      "end_seconds": 209.13,
      "duration_seconds": 3.86,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.12,
      "end_seconds": 212.89,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.46,
      "end_seconds": 218.03,
      "duration_seconds": 3.57,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.46,
      "end_seconds": 223.21,
      "duration_seconds": 3.75,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.17,
      "end_seconds": 228.63,
      "duration_seconds": 3.46,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 259.81,
      "duration_seconds": 12.66,
      "text": "Okay, so my impression is this: The most likely explanation is a thyroid storm. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.57,
      "end_seconds": 269.47,
      "duration_seconds": 5.9,
      "text": "Sorry, what was I saying, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.21,
      "end_seconds": 277.02,
      "duration_seconds": 6.81,
      "text": "I can't promise yet, but most people with a thyroid storm do well once it's treated properly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.99,
      "end_seconds": 318.15,
      "duration_seconds": 31.16,
      "text": "Urgent blood tests is what I'd like next, for thyroid storm. That will help us see what's going on underneath and decide the next step. I'd like you to take propranolol, 1 milligrams, now, single dose. It's for thyroid storm. This is an emergency, you will be treated in high dependency. Let's get you seen by the emergency team, I'll arrange the letter. I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.5,
      "end_seconds": 322.14,
      "duration_seconds": 2.64,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.02,
      "end_seconds": 325.1,
      "duration_seconds": 2.08,
      "text": "So, goodbye for now."
    }
  ]
}