{
  "schema_version": "1.0",
  "encounter_id": "02076",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.6,
      "end_seconds": 4.95,
      "duration_seconds": 4.35,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 11.82,
      "duration_seconds": 4.6,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.39,
      "end_seconds": 19.05,
      "duration_seconds": 6.66,
      "text": "Doctor, um, it's constant worrying. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.84,
      "end_seconds": 21.18,
      "duration_seconds": 1.34,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.92,
      "end_seconds": 33.23,
      "duration_seconds": 10.31,
      "text": "Around one week... no wait, it's more like three weeks. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.44,
      "end_seconds": 36.48,
      "duration_seconds": 2.04,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.05,
      "end_seconds": 44.66,
      "duration_seconds": 7.61,
      "text": "Sorry, what was I saying, it usually comes with a tight chest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 46.61,
      "duration_seconds": 1.6,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.67,
      "end_seconds": 54.31,
      "duration_seconds": 6.64,
      "text": "I was feeling on edge at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.24,
      "end_seconds": 58.08,
      "duration_seconds": 1.84,
      "text": "Right, do you smoke?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.88,
      "end_seconds": 63.66,
      "duration_seconds": 3.78,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.74,
      "end_seconds": 66.47,
      "duration_seconds": 1.73,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.32,
      "end_seconds": 70.03,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.1,
      "end_seconds": 73.76,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.56,
      "end_seconds": 78.47,
      "duration_seconds": 2.91,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.83,
      "end_seconds": 85.02,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.19,
      "end_seconds": 89.81,
      "duration_seconds": 3.62,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.48,
      "end_seconds": 95.27,
      "duration_seconds": 4.79,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.13,
      "end_seconds": 104.27,
      "duration_seconds": 7.14,
      "text": "So, yes, eczema. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.78,
      "end_seconds": 116.37,
      "duration_seconds": 10.59,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.82,
      "end_seconds": 122.94,
      "duration_seconds": 5.12,
      "text": "Erm, I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.74,
      "end_seconds": 142.04,
      "duration_seconds": 3.3,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.03,
      "end_seconds": 148.53,
      "duration_seconds": 4.5,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.64,
      "end_seconds": 152.81,
      "duration_seconds": 3.17,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.68,
      "end_seconds": 156.84,
      "duration_seconds": 3.16,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.1,
      "end_seconds": 170.11,
      "duration_seconds": 5.01,
      "text": "Did you get drinking more, weight loss or chest pain on exertion?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.75,
      "end_seconds": 175.73,
      "duration_seconds": 3.98,
      "text": "Hmm, no, not a single one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.34,
      "end_seconds": 181.74,
      "duration_seconds": 4.4,
      "text": "Okay, have you had any thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.35,
      "end_seconds": 186.59,
      "duration_seconds": 3.24,
      "text": "No, no thoughts of harming myself."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.82,
      "end_seconds": 190.18,
      "duration_seconds": 2.36,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.02,
      "end_seconds": 196.68,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.56,
      "end_seconds": 201.54,
      "duration_seconds": 2.98,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.43,
      "end_seconds": 210.24,
      "duration_seconds": 2.81,
      "text": "Right, no, skin's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 210.86,
      "end_seconds": 221.39,
      "duration_seconds": 10.53,
      "text": "Okay, so the vitals from earlier. Weight 84 kilos, temperature 36.5. Height 175 centimetres, pressure 127 over 81, pulse is 72 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.47,
      "end_seconds": 223.81,
      "duration_seconds": 1.34,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.14,
      "end_seconds": 228.93,
      "duration_seconds": 2.79,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.49,
      "end_seconds": 230.63,
      "duration_seconds": 1.14,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.81,
      "end_seconds": 233.28,
      "duration_seconds": 1.47,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.22,
      "end_seconds": 257.93,
      "duration_seconds": 5.71,
      "text": "Your heart sounds are normal and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.58,
      "end_seconds": 265.24,
      "duration_seconds": 1.66,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.79,
      "end_seconds": 291.38,
      "duration_seconds": 7.59,
      "text": "Putting it all together, this looks most like generalised anxiety. I'd also keep an overactive thyroid in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.23,
      "end_seconds": 296.49,
      "duration_seconds": 3.26,
      "text": "Hmm, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.12,
      "end_seconds": 316.68,
      "duration_seconds": 19.56,
      "text": "I understand the worry. At the moment I'd say it's generalised anxiety, and we'll watch how it goes. I don't need to add any tests or treatment at this point. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.76,
      "end_seconds": 321.4,
      "duration_seconds": 3.64,
      "text": "Alright, um, thanks, take care."
    }
  ]
}