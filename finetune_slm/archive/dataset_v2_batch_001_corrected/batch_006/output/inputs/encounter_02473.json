{
  "schema_version": "1.0",
  "encounter_id": "02473",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 5.66,
      "duration_seconds": 4.42,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.35,
      "end_seconds": 11.24,
      "duration_seconds": 3.89,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.13,
      "end_seconds": 19.66,
      "duration_seconds": 6.53,
      "text": "It's dribbling after passing urine. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 24.6,
      "duration_seconds": 4.41,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.49,
      "end_seconds": 41.01,
      "duration_seconds": 14.52,
      "text": "I've had it for one week. I didn't want to make a fuss, you know, you know. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.66,
      "end_seconds": 49.1,
      "duration_seconds": 3.44,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.45,
      "end_seconds": 52.59,
      "duration_seconds": 2.14,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.92,
      "end_seconds": 59.27,
      "duration_seconds": 5.35,
      "text": "What about a feeling of not emptying, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.79,
      "end_seconds": 75.67,
      "duration_seconds": 15.88,
      "text": "Mm, um, yes. Um, as for getting up at night to pass urine, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.88,
      "end_seconds": 83.02,
      "duration_seconds": 6.14,
      "text": "Have you had dribbling after passing urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.57,
      "end_seconds": 88.81,
      "duration_seconds": 5.24,
      "text": "Right, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.62,
      "end_seconds": 95.79,
      "duration_seconds": 5.17,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.33,
      "end_seconds": 102.66,
      "duration_seconds": 2.33,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.95,
      "end_seconds": 105.99,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.93,
      "end_seconds": 109.77,
      "duration_seconds": 1.84,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.85,
      "end_seconds": 130.46,
      "duration_seconds": 4.61,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.85,
      "end_seconds": 145.66,
      "duration_seconds": 13.81,
      "text": "I gave up cigarettes last spring. No, I share a house with my brother. I'm vegetarian and have been for years. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.33,
      "end_seconds": 149.77,
      "duration_seconds": 2.44,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.88,
      "end_seconds": 153.45,
      "duration_seconds": 2.57,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.36,
      "end_seconds": 157.95,
      "duration_seconds": 3.59,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.33,
      "end_seconds": 162.64,
      "duration_seconds": 3.31,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.59,
      "end_seconds": 182.79,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.83,
      "end_seconds": 186.63,
      "duration_seconds": 2.8,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.29,
      "end_seconds": 193.55,
      "duration_seconds": 5.26,
      "text": "Any burning on passing urine, weight loss or back pain at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.62,
      "end_seconds": 203.02,
      "duration_seconds": 8.4,
      "text": "I mean, I haven't had burning on passing urine, weight loss or back pain, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.14,
      "end_seconds": 208.69,
      "duration_seconds": 4.55,
      "text": "Have you had blood in the urine, by any chance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.19,
      "end_seconds": 212.05,
      "duration_seconds": 2.86,
      "text": "No blood in the urine, thankfully."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.11,
      "end_seconds": 216.95,
      "duration_seconds": 3.84,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.13,
      "end_seconds": 220.39,
      "duration_seconds": 2.26,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 224.88,
      "duration_seconds": 3.45,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.58,
      "end_seconds": 227.59,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.76,
      "end_seconds": 231.9,
      "duration_seconds": 3.14,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.76,
      "end_seconds": 247.4,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.25,
      "end_seconds": 264.84,
      "duration_seconds": 4.59,
      "text": "Okay: pressure 112 over 71, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.52,
      "end_seconds": 267.14,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.69,
      "end_seconds": 271.9,
      "duration_seconds": 3.21,
      "text": "Okay, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.68,
      "end_seconds": 277.02,
      "duration_seconds": 2.34,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.65,
      "end_seconds": 279.99,
      "duration_seconds": 1.34,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.24,
      "end_seconds": 294.67,
      "duration_seconds": 4.43,
      "text": "The prostate feels smooth and enlarged with no hard areas."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.02,
      "end_seconds": 300.65,
      "duration_seconds": 1.63,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.87,
      "end_seconds": 338.84,
      "duration_seconds": 26.97,
      "text": "I want kidney function tests done, that's for urinary symptoms. I'd like you to take tamsulosin, 400 micrograms, once a day after food, long term. That's for urinary symptoms. Cut down on caffeine and fluids in the evening. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.92,
      "end_seconds": 343.91,
      "duration_seconds": 2.99,
      "text": "I think I understand everything. Thanks."
    }
  ]
}