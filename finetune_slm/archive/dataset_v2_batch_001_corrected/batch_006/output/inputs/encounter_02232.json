{
  "schema_version": "1.0",
  "encounter_id": "02232",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.64,
      "duration_seconds": 3.78,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.63,
      "end_seconds": 10.62,
      "duration_seconds": 4.99,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.57,
      "end_seconds": 19.66,
      "duration_seconds": 7.09,
      "text": "Uh, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.42,
      "end_seconds": 24.8,
      "duration_seconds": 3.38,
      "text": "Alright, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.64,
      "end_seconds": 32.34,
      "duration_seconds": 5.7,
      "text": "Um, doctor, it's pain at night. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.82,
      "end_seconds": 35.76,
      "duration_seconds": 1.94,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.43,
      "end_seconds": 39.66,
      "duration_seconds": 2.23,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.29,
      "end_seconds": 43.84,
      "duration_seconds": 2.55,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.58,
      "end_seconds": 47.73,
      "duration_seconds": 3.15,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.04,
      "end_seconds": 54.04,
      "duration_seconds": 5.0,
      "text": "What about burning pain in the upper tummy, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.3,
      "end_seconds": 62.77,
      "duration_seconds": 7.47,
      "text": "Yeah. Two months, I'd say. There was indigestion, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.36,
      "end_seconds": 65.88,
      "duration_seconds": 2.52,
      "text": "Did you notice any black stools?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.14,
      "end_seconds": 70.94,
      "duration_seconds": 3.8,
      "text": "Not that I've noticed, no black stools."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.2,
      "end_seconds": 75.58,
      "duration_seconds": 3.38,
      "text": "Any difficulty swallowing, vomiting blood or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.26,
      "end_seconds": 79.03,
      "duration_seconds": 2.77,
      "text": "Right, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.59,
      "end_seconds": 86.08,
      "duration_seconds": 3.49,
      "text": "Okay, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.99,
      "end_seconds": 89.49,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.16,
      "end_seconds": 93.21,
      "duration_seconds": 2.05,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.29,
      "end_seconds": 96.22,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.48,
      "end_seconds": 111.27,
      "duration_seconds": 6.79,
      "text": "Has anyone ever diagnosed you with something? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.32,
      "end_seconds": 117.74,
      "duration_seconds": 5.42,
      "text": "Hmm, I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 127.13,
      "duration_seconds": 7.5,
      "text": "Mm-hmm. Right, so arthritis in your knees is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.92,
      "end_seconds": 144.64,
      "duration_seconds": 2.72,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.61,
      "end_seconds": 156.55,
      "duration_seconds": 10.94,
      "text": "I'm vegetarian and have been for years. Yes, I work in a bakery, early starts. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.27,
      "end_seconds": 162.75,
      "duration_seconds": 4.48,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.82,
      "end_seconds": 167.86,
      "duration_seconds": 3.04,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.79,
      "end_seconds": 191.0,
      "duration_seconds": 5.21,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 192.69,
      "end_seconds": 197.62,
      "duration_seconds": 4.93,
      "text": "Let me think, it's paracetamol, 650 milligrams, when needed, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 199.01,
      "duration_seconds": 0.91,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 200.73,
      "end_seconds": 204.99,
      "duration_seconds": 4.26,
      "text": "It's ibuprofen, 400 milligrams, three times a day, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.93,
      "end_seconds": 211.84,
      "duration_seconds": 2.91,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.66,
      "end_seconds": 221.89,
      "duration_seconds": 2.23,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.21,
      "end_seconds": 243.36,
      "duration_seconds": 10.15,
      "text": "Okay: pulse is 86 beats a minute, oxygen saturation is 97 percent, temperature is 36.8 degrees, blood pressure 112 over 71."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.13,
      "end_seconds": 250.41,
      "duration_seconds": 4.28,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.47,
      "end_seconds": 253.46,
      "duration_seconds": 0.99,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.7,
      "end_seconds": 257.47,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.44,
      "end_seconds": 277.41,
      "duration_seconds": 4.97,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.46,
      "end_seconds": 279.95,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.11,
      "end_seconds": 293.24,
      "duration_seconds": 10.13,
      "text": "All finished, thank you. So where does that leave us? The most likely explanation is a possible stomach ulcer from anti-inflammatory tablets."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.0,
      "end_seconds": 297.85,
      "duration_seconds": 2.85,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.38,
      "end_seconds": 312.56,
      "duration_seconds": 14.18,
      "text": "It's reasonable to be concerned, but right now a possible stomach ulcer from anti-inflammatory tablets is my leading thought, not anything worse. I think a stool test for helicobacter makes sense here, for dyspepsia."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.56,
      "end_seconds": 316.17,
      "duration_seconds": 1.61,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.76,
      "end_seconds": 345.92,
      "duration_seconds": 29.16,
      "text": "A blood count is what I'd like next, for dyspepsia. What I'm giving you is omeprazole, 20 milligrams, once a day, eight weeks. You take it by mouth. That should help with stomach ulcer. Stop the ibuprofen and use paracetamol for the knee pain instead. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like you back in six weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.18,
      "end_seconds": 347.88,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.88,
      "end_seconds": 352.28,
      "duration_seconds": 2.4,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.6,
      "end_seconds": 356.92,
      "duration_seconds": 3.32,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}