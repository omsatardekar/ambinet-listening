{
  "schema_version": "1.0",
  "encounter_id": "02161",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 6.34,
      "duration_seconds": 5.66,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.91,
      "end_seconds": 13.17,
      "duration_seconds": 5.26,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.28,
      "end_seconds": 25.14,
      "duration_seconds": 10.86,
      "text": "So, good morning, doctor. I came along to help out. Hmm, we came because of electric shock pains in my cheek."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.56,
      "end_seconds": 27.91,
      "duration_seconds": 1.35,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.5,
      "end_seconds": 32.05,
      "duration_seconds": 3.55,
      "text": "Right, I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.01,
      "end_seconds": 38.78,
      "duration_seconds": 5.77,
      "text": "Okay, so I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.2,
      "end_seconds": 45.25,
      "duration_seconds": 5.05,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.24,
      "end_seconds": 49.85,
      "duration_seconds": 3.61,
      "text": "Uh, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 54.46,
      "duration_seconds": 2.89,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.8,
      "end_seconds": 64.12,
      "duration_seconds": 7.32,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.76,
      "end_seconds": 71.04,
      "duration_seconds": 6.28,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.55,
      "end_seconds": 75.0,
      "duration_seconds": 3.45,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.72,
      "end_seconds": 78.98,
      "duration_seconds": 2.26,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 87.59,
      "duration_seconds": 7.19,
      "text": "Um, it's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.35,
      "end_seconds": 99.23,
      "duration_seconds": 5.88,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.62,
      "end_seconds": 102.99,
      "duration_seconds": 2.37,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.64,
      "end_seconds": 110.58,
      "duration_seconds": 6.94,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 110.68,
      "end_seconds": 117.2,
      "duration_seconds": 6.52,
      "text": "Uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.03,
      "end_seconds": 123.24,
      "duration_seconds": 4.21,
      "text": "Right, um, I was getting to that!"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.34,
      "end_seconds": 127.48,
      "duration_seconds": 3.14,
      "text": "Alright, any pain lasting seconds as well?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.53,
      "end_seconds": 132.09,
      "duration_seconds": 3.56,
      "text": "Yeah, I've had that since last weekend."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.55,
      "end_seconds": 135.66,
      "duration_seconds": 2.11,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.29,
      "end_seconds": 144.35,
      "duration_seconds": 7.06,
      "text": "Right, it's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.06,
      "end_seconds": 151.65,
      "duration_seconds": 6.59,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.08,
      "end_seconds": 156.74,
      "duration_seconds": 3.66,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 158.18,
      "end_seconds": 161.26,
      "duration_seconds": 3.08,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.93,
      "end_seconds": 165.77,
      "duration_seconds": 2.84,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.6,
      "end_seconds": 177.59,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.48,
      "end_seconds": 199.5,
      "duration_seconds": 7.02,
      "text": "Okay: temperature is 36.9 degrees, blood pressure 109 over 69, respiratory rate 18, pulse 67."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.97,
      "end_seconds": 203.05,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.88,
      "end_seconds": 206.9,
      "duration_seconds": 2.02,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.4,
      "end_seconds": 212.37,
      "duration_seconds": 3.97,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.11,
      "end_seconds": 215.1,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.95,
      "end_seconds": 217.17,
      "duration_seconds": 1.22,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.47,
      "end_seconds": 237.26,
      "duration_seconds": 6.79,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.07,
      "end_seconds": 239.77,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.69,
      "end_seconds": 247.72,
      "duration_seconds": 4.03,
      "text": "Okay, that's enough for me. Any sign of hearing loss?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.03,
      "end_seconds": 257.56,
      "duration_seconds": 8.53,
      "text": "Nope, no hearing loss. I, I had being afraid to eat before. That's settled now, though."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.14,
      "end_seconds": 260.86,
      "duration_seconds": 2.72,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.28,
      "end_seconds": 264.76,
      "duration_seconds": 2.48,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.56,
      "end_seconds": 269.44,
      "duration_seconds": 2.88,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.9,
      "end_seconds": 273.72,
      "duration_seconds": 2.82,
      "text": "I, I move fine otherwise."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.71,
      "end_seconds": 291.06,
      "duration_seconds": 5.35,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.81,
      "end_seconds": 296.62,
      "duration_seconds": 3.81,
      "text": "So, yes, walnuts. I get hives."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.36,
      "end_seconds": 301.76,
      "duration_seconds": 4.4,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.71,
      "end_seconds": 306.22,
      "duration_seconds": 2.51,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.44,
      "end_seconds": 308.51,
      "duration_seconds": 1.07,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.66,
      "end_seconds": 313.83,
      "duration_seconds": 4.17,
      "text": "I've had depression for nearly five years now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.63,
      "end_seconds": 327.52,
      "duration_seconds": 9.89,
      "text": "Right, so depression is already on your record. We'll keep that in mind today. Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.62,
      "end_seconds": 332.81,
      "duration_seconds": 3.19,
      "text": "Mm, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.87,
      "end_seconds": 337.63,
      "duration_seconds": 2.76,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.82,
      "end_seconds": 350.45,
      "duration_seconds": 6.63,
      "text": "I, I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.3,
      "end_seconds": 354.83,
      "duration_seconds": 2.53,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.15,
      "end_seconds": 363.38,
      "duration_seconds": 4.23,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.94,
      "end_seconds": 365.36,
      "duration_seconds": 1.42,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.43,
      "end_seconds": 370.74,
      "duration_seconds": 3.31,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.12,
      "end_seconds": 376.11,
      "duration_seconds": 3.99,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.96,
      "end_seconds": 387.6,
      "duration_seconds": 9.64,
      "text": "Hydrocortisone cream. I take it when needed. It's escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 388.41,
      "end_seconds": 399.59,
      "duration_seconds": 11.18,
      "text": "Doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.49,
      "end_seconds": 405.1,
      "duration_seconds": 3.61,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.85,
      "end_seconds": 414.55,
      "duration_seconds": 8.7,
      "text": "Not with me. I'll bring it next time. Paracetamol. I take it 1 gram, when needed."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.36,
      "end_seconds": 451.85,
      "duration_seconds": 26.49,
      "text": "So, based on the history and the examination, I'd lean towards trigeminal neuralgia. I want to be honest that this is an impression, not a final answer. We shouldn't forget a dental problem. Let me repeat that back to make sure. You've had electric shock pains in your cheek, and no hearing loss."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.72,
      "end_seconds": 454.42,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.91,
      "end_seconds": 461.87,
      "duration_seconds": 5.96,
      "text": "An MRI scan of the head is what I'd like next, for facial pain."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 463.71,
      "end_seconds": 466.37,
      "duration_seconds": 2.66,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 467.95,
      "end_seconds": 487.13,
      "duration_seconds": 19.18,
      "text": "The treatment will be carbamazepine, 100 milligrams, twice a day, titrate. That should help with nerve pain. Avoid known triggers and eat soft foods when it flares. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 492.55,
      "end_seconds": 494.27,
      "duration_seconds": 1.72,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 495.47,
      "end_seconds": 500.57,
      "duration_seconds": 5.1,
      "text": "Come back in four weeks. So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 501.17,
      "end_seconds": 502.81,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 503.57,
      "end_seconds": 504.75,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}