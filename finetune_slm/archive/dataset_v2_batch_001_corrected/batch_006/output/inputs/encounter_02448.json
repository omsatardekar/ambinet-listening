{
  "schema_version": "1.0",
  "encounter_id": "02448",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 2.59,
      "duration_seconds": 1.82,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.33,
      "end_seconds": 7.36,
      "duration_seconds": 4.03,
      "text": "Mm, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.3,
      "end_seconds": 16.85,
      "duration_seconds": 7.55,
      "text": "Sorry, what was I saying, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.39,
      "end_seconds": 23.78,
      "duration_seconds": 6.39,
      "text": "Okay, that's fine, sit down. We'll go through it together. Where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.52,
      "end_seconds": 30.63,
      "duration_seconds": 6.11,
      "text": "Right, she's been having electric shock pains in my cheek, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.66,
      "end_seconds": 35.07,
      "duration_seconds": 3.41,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.84,
      "end_seconds": 40.97,
      "duration_seconds": 4.13,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.05,
      "end_seconds": 45.28,
      "duration_seconds": 2.23,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.01,
      "end_seconds": 59.52,
      "duration_seconds": 12.51,
      "text": "Um, uh, I notice it more with chewing and touching the face. Oh, you know, and pain lasting seconds."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.01,
      "end_seconds": 68.69,
      "duration_seconds": 7.68,
      "text": "Have you had electric shock pains in your cheek before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.71,
      "end_seconds": 76.83,
      "duration_seconds": 7.12,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.56,
      "end_seconds": 78.75,
      "duration_seconds": 1.19,
      "text": "Any hearing loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.42,
      "end_seconds": 90.5,
      "duration_seconds": 11.08,
      "text": "Nope, you know, no hearing loss. I did have being afraid to eat at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.43,
      "end_seconds": 94.69,
      "duration_seconds": 2.26,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.85,
      "end_seconds": 99.73,
      "duration_seconds": 3.88,
      "text": "Um, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.02,
      "end_seconds": 103.16,
      "duration_seconds": 2.14,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.67,
      "end_seconds": 105.82,
      "duration_seconds": 1.15,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.68,
      "end_seconds": 108.81,
      "duration_seconds": 2.13,
      "text": "So, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 114.34,
      "duration_seconds": 4.09,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.86,
      "end_seconds": 117.23,
      "duration_seconds": 2.37,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 122.85,
      "duration_seconds": 4.36,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.29,
      "end_seconds": 127.06,
      "duration_seconds": 2.77,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.02,
      "end_seconds": 131.88,
      "duration_seconds": 3.86,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.62,
      "end_seconds": 140.83,
      "duration_seconds": 7.21,
      "text": "Do you react to any medicines or foods? Any allergies? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.59,
      "end_seconds": 153.66,
      "duration_seconds": 9.07,
      "text": "I, I was told I'm allergic to tramadol, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.26,
      "end_seconds": 158.8,
      "duration_seconds": 3.54,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.78,
      "end_seconds": 175.37,
      "duration_seconds": 15.59,
      "text": "I have acid reflux. Thin bones, for two years. Yeah, I've had gout for about a year now. I didn't want to make a fuss, you know. Yes, heart failure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.39,
      "end_seconds": 182.87,
      "duration_seconds": 6.48,
      "text": "Okay, I can see gout and heart failure in your file as well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.77,
      "end_seconds": 195.71,
      "duration_seconds": 4.94,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.77,
      "end_seconds": 212.65,
      "duration_seconds": 15.88,
      "text": "Omeprazole, 20 milligrams, once a day. I'm on alendronate, 70 milligrams, once a week for my bones. Allopurinol. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 214.72,
      "end_seconds": 225.24,
      "duration_seconds": 10.52,
      "text": "Doctor, I think the last prescription for the allopurinol was 50 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.33,
      "end_seconds": 231.87,
      "duration_seconds": 4.54,
      "text": "Okay, I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.97,
      "end_seconds": 242.74,
      "duration_seconds": 8.77,
      "text": "Ah, uh, I don't think I have it with me. It's paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.59,
      "end_seconds": 246.67,
      "duration_seconds": 3.08,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.82,
      "end_seconds": 249.93,
      "duration_seconds": 2.11,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.63,
      "end_seconds": 254.98,
      "duration_seconds": 3.35,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.98,
      "end_seconds": 264.63,
      "duration_seconds": 2.65,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.82,
      "end_seconds": 291.8,
      "duration_seconds": 6.98,
      "text": "Okay: blood pressure 117 over 75, temperature is 36.8 degrees, saturation 97 percent. And pulse 82."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.42,
      "end_seconds": 296.62,
      "duration_seconds": 3.2,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.34,
      "end_seconds": 300.83,
      "duration_seconds": 2.49,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.84,
      "end_seconds": 306.39,
      "duration_seconds": 4.55,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.39,
      "end_seconds": 320.49,
      "duration_seconds": 1.1,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.58,
      "end_seconds": 322.87,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.4,
      "end_seconds": 345.67,
      "duration_seconds": 6.27,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.24,
      "end_seconds": 369.23,
      "duration_seconds": 18.99,
      "text": "That's the examination finished. Right, here's what I'm thinking. I think we're dealing with trigeminal neuralgia at this stage. That's my thinking for now, and it may change as we learn more. It could also be a dental problem, so we'll keep that open."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.16,
      "end_seconds": 372.54,
      "duration_seconds": 2.38,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.45,
      "end_seconds": 407.95,
      "duration_seconds": 31.5,
      "text": "I can't promise yet, but most people with trigeminal neuralgia do well once it's treated properly. Let's book an MRI scan of the head to look into facial pain. You'll be taking carbamazepine, 100 milligrams, twice a day, titrate. You take it by mouth. That's for nerve pain. I'll put all of this in writing so you don't have to remember it. Avoid known triggers and eat soft foods when it flares."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.39,
      "end_seconds": 423.21,
      "duration_seconds": 13.82,
      "text": "Let's get you seen by the neurology clinic, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 424.61,
      "end_seconds": 426.89,
      "duration_seconds": 2.28,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.64,
      "end_seconds": 444.42,
      "duration_seconds": 11.78,
      "text": "If the symptoms get worse, that's the point to come in urgently. Please come and see me in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 445.33,
      "end_seconds": 447.19,
      "duration_seconds": 1.86,
      "text": "That's clear, thanks."
    }
  ]
}