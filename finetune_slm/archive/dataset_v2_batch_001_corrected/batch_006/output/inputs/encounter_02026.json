{
  "schema_version": "1.0",
  "encounter_id": "02026",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 3.91,
      "duration_seconds": 3.32,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 9.53,
      "duration_seconds": 4.0,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.89,
      "end_seconds": 17.29,
      "duration_seconds": 6.4,
      "text": "Honestly, it's no symptoms, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.38,
      "end_seconds": 21.85,
      "duration_seconds": 2.47,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 24.96,
      "duration_seconds": 1.11,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.64,
      "end_seconds": 30.07,
      "duration_seconds": 3.43,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.73,
      "end_seconds": 34.85,
      "duration_seconds": 3.12,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.84,
      "end_seconds": 39.14,
      "duration_seconds": 3.3,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.09,
      "end_seconds": 46.15,
      "duration_seconds": 6.06,
      "text": "Being a little overweight goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.68,
      "end_seconds": 69.09,
      "duration_seconds": 4.41,
      "text": "okay, did you get frequent urination, thirst or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.91,
      "end_seconds": 73.17,
      "duration_seconds": 3.26,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.72,
      "end_seconds": 78.19,
      "duration_seconds": 3.47,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.84,
      "end_seconds": 82.72,
      "duration_seconds": 2.88,
      "text": "Hmm, no, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.66,
      "end_seconds": 86.66,
      "duration_seconds": 2.0,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.31,
      "end_seconds": 89.13,
      "duration_seconds": 1.82,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.59,
      "end_seconds": 109.43,
      "duration_seconds": 3.84,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.9,
      "end_seconds": 114.6,
      "duration_seconds": 1.7,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.49,
      "end_seconds": 117.93,
      "duration_seconds": 1.44,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.81,
      "end_seconds": 123.09,
      "duration_seconds": 3.28,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.91,
      "end_seconds": 125.77,
      "duration_seconds": 1.86,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.47,
      "end_seconds": 130.3,
      "duration_seconds": 2.83,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.41,
      "end_seconds": 138.57,
      "duration_seconds": 3.16,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.48,
      "end_seconds": 144.52,
      "duration_seconds": 5.04,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.46,
      "end_seconds": 147.24,
      "duration_seconds": 1.78,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.13,
      "end_seconds": 151.41,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.8,
      "end_seconds": 173.96,
      "duration_seconds": 4.16,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.72,
      "end_seconds": 178.24,
      "duration_seconds": 2.52,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.03,
      "end_seconds": 182.41,
      "duration_seconds": 3.38,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.25,
      "end_seconds": 186.51,
      "duration_seconds": 2.26,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.38,
      "end_seconds": 191.36,
      "duration_seconds": 3.98,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.3,
      "end_seconds": 207.72,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.54,
      "end_seconds": 236.35,
      "duration_seconds": 12.81,
      "text": "okay: weight 70 kilos, temp 36.6 degrees, BMI works out to 30.3. And heart rate 81, blood pressure 121 over 74, saturation 99 percent, height 152 centimetres"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.43,
      "end_seconds": 240.72,
      "duration_seconds": 2.29,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.71,
      "end_seconds": 246.13,
      "duration_seconds": 3.42,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.92,
      "end_seconds": 253.14,
      "duration_seconds": 4.22,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.27,
      "end_seconds": 255.46,
      "duration_seconds": 1.19,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.1,
      "end_seconds": 271.84,
      "duration_seconds": 3.74,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.37,
      "end_seconds": 277.33,
      "duration_seconds": 2.96,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.74,
      "end_seconds": 299.27,
      "duration_seconds": 10.53,
      "text": "Okay, thinking it through, it fits best with prediabetes. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.14,
      "end_seconds": 301.66,
      "duration_seconds": 1.52,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.4,
      "end_seconds": 318.31,
      "duration_seconds": 11.91,
      "text": "Nothing I've seen today points to an emergency. It looks like prediabetes, but I'd like to confirm. I'd like to to arrange a repeat HbA1c for prediabetes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 323.78,
      "end_seconds": 327.1,
      "duration_seconds": 3.32,
      "text": "I can book that for Thursday at 2 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.95,
      "end_seconds": 338.83,
      "duration_seconds": 9.88,
      "text": "Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.95,
      "end_seconds": 341.67,
      "duration_seconds": 1.72,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.34,
      "end_seconds": 346.83,
      "duration_seconds": 4.49,
      "text": "come back in six months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.43,
      "end_seconds": 351.94,
      "duration_seconds": 3.51,
      "text": "no, that's all. Thanks a lot"
    }
  ]
}