      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 151.38,
      "end_seconds": 158.72,
      "duration_seconds": 7.34,
      "text": "yeah, she is on escitalopram, once a day, I give it to her"
