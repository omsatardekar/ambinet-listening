{
  "schema_version": "1.0",
  "encounter_id": "02041",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 7.47,
      "duration_seconds": 6.36,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 12.57,
      "duration_seconds": 4.0,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.88,
      "end_seconds": 23.0,
      "duration_seconds": 9.12,
      "text": "I'm here because of a shaky feeling in my hands. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.77,
      "end_seconds": 32.41,
      "duration_seconds": 8.64,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.85,
      "end_seconds": 44.84,
      "duration_seconds": 10.99,
      "text": "I get some relief from resting. Moderate, I'd say. Right, um, I had sweaty palms before. That's settled now, though."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.56,
      "end_seconds": 53.78,
      "duration_seconds": 8.22,
      "text": "Right, have you had a shaky feeling in your hands before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.51,
      "end_seconds": 62.62,
      "duration_seconds": 8.11,
      "text": "Let me think, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.07,
      "end_seconds": 66.58,
      "duration_seconds": 2.51,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.61,
      "end_seconds": 73.68,
      "duration_seconds": 5.07,
      "text": "I'm allergic to walnuts, I get my lips swelling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.44,
      "end_seconds": 80.86,
      "duration_seconds": 1.42,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.63,
      "end_seconds": 86.25,
      "duration_seconds": 3.62,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.83,
      "end_seconds": 88.41,
      "duration_seconds": 1.58,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.41,
      "end_seconds": 96.37,
      "duration_seconds": 2.96,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.28,
      "end_seconds": 102.54,
      "duration_seconds": 4.26,
      "text": "Alright, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.87,
      "end_seconds": 108.09,
      "duration_seconds": 4.22,
      "text": "Depression, for nearly five years. Yes, heart disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.72,
      "end_seconds": 115.78,
      "duration_seconds": 6.06,
      "text": "Yes, heart disease is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.11,
      "end_seconds": 139.54,
      "duration_seconds": 7.43,
      "text": "Can you list what you take, tablets, creams or inhalers? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.28,
      "end_seconds": 152.42,
      "duration_seconds": 11.14,
      "text": "Sertraline. I take it 50 milligrams, once a day for my mood. Aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.16,
      "end_seconds": 157.92,
      "duration_seconds": 3.76,
      "text": "Have you noticed fainting, weight loss or weakness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.56,
      "end_seconds": 162.83,
      "duration_seconds": 4.27,
      "text": "No, no fainting, weight loss or weakness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.17,
      "end_seconds": 167.05,
      "duration_seconds": 2.88,
      "text": "Have you had palpitations, by any chance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.86,
      "end_seconds": 170.14,
      "duration_seconds": 2.28,
      "text": "No, none, no palpitations."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.15,
      "end_seconds": 173.41,
      "duration_seconds": 2.26,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.43,
      "end_seconds": 176.61,
      "duration_seconds": 2.18,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.55,
      "end_seconds": 181.37,
      "duration_seconds": 3.82,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.46,
      "end_seconds": 189.5,
      "duration_seconds": 4.04,
      "text": "Let me think, no, that's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.15,
      "end_seconds": 206.76,
      "duration_seconds": 2.61,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.32,
      "end_seconds": 222.7,
      "duration_seconds": 2.38,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.34,
      "end_seconds": 241.03,
      "duration_seconds": 8.69,
      "text": "Okay: oxygen saturation is 99 percent, respiratory rate 18, pulse is 85 beats a minute, blood pressure 111 over 76."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.64,
      "end_seconds": 245.22,
      "duration_seconds": 2.58,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.05,
      "end_seconds": 248.78,
      "duration_seconds": 2.73,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 252.87,
      "duration_seconds": 2.92,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.73,
      "end_seconds": 256.47,
      "duration_seconds": 1.74,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.75,
      "end_seconds": 260.92,
      "duration_seconds": 3.17,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.3,
      "end_seconds": 275.47,
      "duration_seconds": 6.17,
      "text": "There is a fine, fast tremor that goes away when the hands are resting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.18,
      "end_seconds": 277.88,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 283.85,
      "duration_seconds": 1.85,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.66,
      "end_seconds": 321.16,
      "duration_seconds": 23.5,
      "text": "Putting it all together, it fits best with an anxiety or caffeine-related tremor. I can't rule out an overactive thyroid yet. I'll request a thyroid test, it'll help with tremor. Cut down caffeine and try slow breathing when it starts. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.12,
      "end_seconds": 323.8,
      "duration_seconds": 1.68,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.42,
      "end_seconds": 327.52,
      "duration_seconds": 3.1,
      "text": "I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.76,
      "end_seconds": 329.46,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.82,
      "end_seconds": 335.3,
      "duration_seconds": 4.48,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.37,
      "end_seconds": 339.48,
      "duration_seconds": 3.11,
      "text": "Erm, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.85,
      "end_seconds": 342.08,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
}