{
  "schema_version": "1.0",
  "encounter_id": "02362",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 2.57,
      "duration_seconds": 1.7,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.64,
      "end_seconds": 8.26,
      "duration_seconds": 4.62,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.32,
      "end_seconds": 13.34,
      "duration_seconds": 3.02,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.41,
      "end_seconds": 19.81,
      "duration_seconds": 4.4,
      "text": "Well, yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.04,
      "end_seconds": 24.81,
      "duration_seconds": 3.77,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.15,
      "end_seconds": 47.66,
      "duration_seconds": 21.51,
      "text": "I mean, so the thing is, I've got a bump on the head. A neighbour of mine said I should see someone about it. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.95,
      "end_seconds": 51.1,
      "duration_seconds": 2.15,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.0,
      "end_seconds": 59.03,
      "duration_seconds": 7.03,
      "text": "Oh, I've had it since last Tuesday. Oh, and a little tearfulness afterwards."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.42,
      "end_seconds": 74.86,
      "duration_seconds": 4.44,
      "text": "Have you noticed fit, vomiting, loss of consciousness or drowsiness?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.45,
      "end_seconds": 85.02,
      "duration_seconds": 4.57,
      "text": "No, um, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.02,
      "end_seconds": 88.69,
      "duration_seconds": 2.67,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.65,
      "end_seconds": 92.15,
      "duration_seconds": 1.5,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.33,
      "end_seconds": 95.57,
      "duration_seconds": 2.24,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.71,
      "end_seconds": 100.7,
      "duration_seconds": 3.99,
      "text": "Ah, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.71,
      "end_seconds": 102.8,
      "duration_seconds": 1.09,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.97,
      "end_seconds": 117.56,
      "duration_seconds": 11.59,
      "text": "An enlarged prostate, for five years. I'm hoping you can tell me something definite. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.46,
      "end_seconds": 121.31,
      "duration_seconds": 1.85,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.96,
      "end_seconds": 125.75,
      "duration_seconds": 3.79,
      "text": "Right, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.75,
      "end_seconds": 127.58,
      "duration_seconds": 0.83,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 137.77,
      "duration_seconds": 9.54,
      "text": "Yes, high blood pressure is known to us, good to have that clear. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.42,
      "end_seconds": 147.56,
      "duration_seconds": 8.14,
      "text": "So, yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.14,
      "end_seconds": 167.83,
      "duration_seconds": 3.69,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.04,
      "end_seconds": 182.71,
      "duration_seconds": 13.67,
      "text": "I'm, I'm on valsartan, 80 milligrams, once a day. Tamsulosin, 0.4 milligrams, at night. I take aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.83,
      "end_seconds": 187.29,
      "duration_seconds": 1.46,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.35,
      "end_seconds": 190.75,
      "duration_seconds": 2.4,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.91,
      "end_seconds": 194.36,
      "duration_seconds": 2.45,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.03,
      "end_seconds": 205.81,
      "duration_seconds": 10.78,
      "text": "I walk the dog every morning. My partner and our baby. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.3,
      "end_seconds": 210.12,
      "duration_seconds": 2.82,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.57,
      "end_seconds": 221.54,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.12,
      "end_seconds": 240.93,
      "duration_seconds": 7.81,
      "text": "Okay: oxygen saturation is 99 percent, heart rate 72, temp 36.7 degrees. And blood pressure 113 over 82."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.49,
      "end_seconds": 244.32,
      "duration_seconds": 1.83,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.27,
      "end_seconds": 249.05,
      "duration_seconds": 2.78,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.77,
      "end_seconds": 254.12,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.86,
      "end_seconds": 257.17,
      "duration_seconds": 1.31,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.16,
      "end_seconds": 261.13,
      "duration_seconds": 1.97,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.94,
      "end_seconds": 279.31,
      "duration_seconds": 8.37,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.16,
      "end_seconds": 287.56,
      "duration_seconds": 2.4,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.97,
      "end_seconds": 310.98,
      "duration_seconds": 8.01,
      "text": "Having listened and examined, the most likely explanation is a minor head bump with no worrying signs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.72,
      "end_seconds": 313.46,
      "duration_seconds": 1.74,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.28,
      "end_seconds": 331.12,
      "duration_seconds": 16.84,
      "text": "I understand the worry. At the moment I'd say it's a minor head bump with no worrying signs, and we'll watch how it goes. Today I'm not changing anything. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.79,
      "end_seconds": 337.77,
      "duration_seconds": 2.98,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.75,
      "end_seconds": 341.08,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}