{
  "schema_version": "1.0",
  "encounter_id": "02105",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 7.6,
      "duration_seconds": 6.51,
      "text": "Okay, so doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 13.75,
      "duration_seconds": 5.11,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.73,
      "end_seconds": 25.14,
      "duration_seconds": 9.41,
      "text": "So, So the thing is, I've got a feeling of something stuck in my throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.83,
      "end_seconds": 30.28,
      "duration_seconds": 3.45,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.48,
      "end_seconds": 39.46,
      "duration_seconds": 7.98,
      "text": "Actually, I take naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.46,
      "end_seconds": 42.85,
      "duration_seconds": 2.39,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.78,
      "end_seconds": 52.61,
      "duration_seconds": 8.83,
      "text": "About a year now. Tamsulosin. I take it 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.11,
      "end_seconds": 64.12,
      "duration_seconds": 3.01,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.65,
      "end_seconds": 77.55,
      "duration_seconds": 9.9,
      "text": "Yeah, it's been going on for five days. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.93,
      "end_seconds": 81.1,
      "duration_seconds": 3.17,
      "text": "Yes. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.62,
      "end_seconds": 87.52,
      "duration_seconds": 4.9,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.99,
      "end_seconds": 93.14,
      "duration_seconds": 2.15,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.94,
      "end_seconds": 101.8,
      "duration_seconds": 6.86,
      "text": "I notice it more with swallowing. And I've been having eaten fish as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.93,
      "end_seconds": 106.21,
      "duration_seconds": 3.28,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.03,
      "end_seconds": 115.87,
      "duration_seconds": 7.84,
      "text": "Sorry, what was I saying, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.47,
      "end_seconds": 121.27,
      "duration_seconds": 3.8,
      "text": "And what about blood, drooling or neck swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.08,
      "end_seconds": 125.96,
      "duration_seconds": 3.88,
      "text": "I mean, no, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.03,
      "end_seconds": 129.93,
      "duration_seconds": 2.9,
      "text": "Right, did you notice any difficulty breathing?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.43,
      "end_seconds": 134.01,
      "duration_seconds": 3.58,
      "text": "Right, I haven't noticed any difficulty breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.04,
      "end_seconds": 136.86,
      "duration_seconds": 1.82,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.51,
      "end_seconds": 139.94,
      "duration_seconds": 2.43,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.25,
      "end_seconds": 145.67,
      "duration_seconds": 4.42,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.48,
      "end_seconds": 156.43,
      "duration_seconds": 8.95,
      "text": "So, I had a reaction to diclofenac when I was younger, wheezing, and I've avoided it since."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.42,
      "end_seconds": 163.82,
      "duration_seconds": 3.4,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.37,
      "end_seconds": 170.07,
      "duration_seconds": 4.7,
      "text": "Mm, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.59,
      "end_seconds": 172.68,
      "duration_seconds": 2.09,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.35,
      "end_seconds": 182.71,
      "duration_seconds": 9.36,
      "text": "Arthritis in my knees, for about a year. I have an enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.52,
      "end_seconds": 194.84,
      "duration_seconds": 10.32,
      "text": "Okay, I can see arthritis in your knees in your file as well. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.01,
      "end_seconds": 210.23,
      "duration_seconds": 14.22,
      "text": "I retired from the post office two years ago. I grab fast food at lunch most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.58,
      "end_seconds": 225.82,
      "duration_seconds": 4.24,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 235.26,
      "duration_seconds": 2.08,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.2,
      "end_seconds": 256.31,
      "duration_seconds": 5.11,
      "text": "Okay: BP is 126 over 79, temp 37.0 degrees, pulse 68."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.27,
      "end_seconds": 259.04,
      "duration_seconds": 1.77,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.13,
      "end_seconds": 262.8,
      "duration_seconds": 2.67,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.4,
      "end_seconds": 267.93,
      "duration_seconds": 3.53,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.91,
      "end_seconds": 272.16,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.4,
      "end_seconds": 292.96,
      "duration_seconds": 5.56,
      "text": "I can't see anything in the throat and the neck is not tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.24,
      "end_seconds": 300.85,
      "duration_seconds": 3.61,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.59,
      "end_seconds": 320.45,
      "duration_seconds": 10.86,
      "text": "So, to recap quickly. You've had a feeling of something stuck in your throat for five days, and no neck swelling or blood."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.36,
      "end_seconds": 323.79,
      "duration_seconds": 2.43,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.04,
      "end_seconds": 331.04,
      "duration_seconds": 6.0,
      "text": "I think a neck X-ray makes sense here, for foreign body sensation."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 331.74,
      "end_seconds": 335.18,
      "duration_seconds": 3.44,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.7,
      "end_seconds": 338.31,
      "duration_seconds": 2.61,
      "text": "Friday, that works for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.5,
      "end_seconds": 346.96,
      "duration_seconds": 5.46,
      "text": "Sip water and eat soft foods; if it persists we look with a camera."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.2,
      "end_seconds": 352.24,
      "duration_seconds": 5.04,
      "text": "Understood. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.9,
      "end_seconds": 356.49,
      "duration_seconds": 3.59,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.52,
      "end_seconds": 358.73,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}