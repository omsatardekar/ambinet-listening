{
  "schema_version": "1.0",
  "encounter_id": "02069",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 5.12,
      "duration_seconds": 4.12,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.75,
      "end_seconds": 10.69,
      "duration_seconds": 4.94,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.08,
      "end_seconds": 19.62,
      "duration_seconds": 5.54,
      "text": "Uh, I wanted to get being very breathless looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.45,
      "end_seconds": 22.77,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.16,
      "end_seconds": 34.78,
      "duration_seconds": 10.62,
      "text": "I've, I've had it for two days. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.61,
      "end_seconds": 40.98,
      "duration_seconds": 5.37,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.03,
      "end_seconds": 67.32,
      "duration_seconds": 24.29,
      "text": "Lying flat definitely sets it off. It sort of comes and goes. Only sitting up, and it's not much. Maybe a four out of ten on a bad day. Okay, so I've been coughing up pink frothy sputum too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.44,
      "end_seconds": 72.34,
      "duration_seconds": 3.9,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.11,
      "end_seconds": 76.28,
      "duration_seconds": 3.17,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.09,
      "end_seconds": 79.53,
      "duration_seconds": 2.44,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.62,
      "end_seconds": 83.21,
      "duration_seconds": 2.59,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.32,
      "end_seconds": 101.18,
      "duration_seconds": 3.86,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.73,
      "end_seconds": 103.68,
      "duration_seconds": 1.95,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.37,
      "end_seconds": 107.22,
      "duration_seconds": 1.85,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.14,
      "end_seconds": 112.92,
      "duration_seconds": 4.78,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.66,
      "end_seconds": 115.42,
      "duration_seconds": 1.76,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.67,
      "end_seconds": 120.7,
      "duration_seconds": 4.03,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.57,
      "end_seconds": 125.56,
      "duration_seconds": 3.99,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.99,
      "end_seconds": 128.69,
      "duration_seconds": 1.7,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.08,
      "end_seconds": 132.1,
      "duration_seconds": 2.02,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.61,
      "end_seconds": 140.08,
      "duration_seconds": 6.47,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.96,
      "end_seconds": 144.74,
      "duration_seconds": 3.78,
      "text": "Have you noticed fever, calf pain or wheeze?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.57,
      "end_seconds": 151.73,
      "duration_seconds": 6.16,
      "text": "Sorry, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.24,
      "end_seconds": 157.47,
      "duration_seconds": 5.23,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.25,
      "end_seconds": 164.78,
      "duration_seconds": 3.53,
      "text": "I mean, no, that's all normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.54,
      "end_seconds": 169.89,
      "duration_seconds": 3.35,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.03,
      "end_seconds": 185.59,
      "duration_seconds": 2.56,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.95,
      "end_seconds": 212.6,
      "duration_seconds": 9.65,
      "text": "Okay: blood pressure 128 over 85, oxygen saturation is 89 percent, respiratory rate 25. And pulse is 96 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.22,
      "end_seconds": 216.75,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 222.28,
      "duration_seconds": 3.8,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.2,
      "end_seconds": 228.75,
      "duration_seconds": 3.55,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.97,
      "end_seconds": 231.3,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.07,
      "end_seconds": 248.57,
      "duration_seconds": 6.5,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.4,
      "end_seconds": 261.1,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.66,
      "end_seconds": 272.28,
      "duration_seconds": 7.62,
      "text": "Good, you can sit up again. Putting it all together, the most likely explanation is acute pulmonary oedema."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.97,
      "end_seconds": 276.27,
      "duration_seconds": 2.3,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.35,
      "end_seconds": 287.22,
      "duration_seconds": 8.87,
      "text": "It's reasonable to be concerned, but right now acute pulmonary oedema is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.32,
      "end_seconds": 330.22,
      "duration_seconds": 29.9,
      "text": "We should do a chest X-ray for pulmonary oedema. An ECG is what I'd like next, for pulmonary oedema. I'd rather check than guess, and this is the quickest way to know more. I'd like you to take furosemide, 40 milligrams, once now, single dose. That should help with fluid on the lungs. Sit upright, I am giving oxygen and a water tablet injection now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.11,
      "end_seconds": 346.68,
      "duration_seconds": 14.57,
      "text": "If it hasn't settled in a month, we'd think about blood tests, but not now. I'll want another look straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.54,
      "end_seconds": 350.92,
      "duration_seconds": 2.38,
      "text": "Thank you, that's helpful."
    }
  ]
}