{
  "schema_version": "1.0",
  "encounter_id": "02030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 5.01,
      "duration_seconds": 4.18,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 10.88,
      "duration_seconds": 5.17,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.7,
      "end_seconds": 19.26,
      "duration_seconds": 6.56,
      "text": "It's very heavy periods. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.18,
      "end_seconds": 24.46,
      "duration_seconds": 3.28,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.86,
      "end_seconds": 32.78,
      "duration_seconds": 6.92,
      "text": "About... well, ten days. And I've been feeling exhausted as well, for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.83,
      "end_seconds": 36.68,
      "duration_seconds": 2.85,
      "text": "Have you had being breathless on stairs?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 45.8,
      "duration_seconds": 7.84,
      "text": "Yes, since last night. With being breathless on stairs, it's a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.9,
      "end_seconds": 59.83,
      "duration_seconds": 3.93,
      "text": "Have you had any fainting, weight loss or pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.63,
      "end_seconds": 64.01,
      "duration_seconds": 2.38,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.25,
      "end_seconds": 72.06,
      "duration_seconds": 2.81,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.15,
      "end_seconds": 76.36,
      "duration_seconds": 2.21,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.11,
      "end_seconds": 80.3,
      "duration_seconds": 2.19,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.47,
      "end_seconds": 88.69,
      "duration_seconds": 3.22,
      "text": "It's lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.98,
      "end_seconds": 106.43,
      "duration_seconds": 4.45,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.14,
      "end_seconds": 109.57,
      "duration_seconds": 2.43,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.18,
      "end_seconds": 115.75,
      "duration_seconds": 4.57,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.16,
      "end_seconds": 119.59,
      "duration_seconds": 2.43,
      "text": "Acid reflux, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.58,
      "end_seconds": 129.4,
      "duration_seconds": 8.82,
      "text": "Okay, I can see acid reflux in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.21,
      "end_seconds": 139.88,
      "duration_seconds": 8.67,
      "text": "My partner and our baby. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.19,
      "end_seconds": 155.52,
      "duration_seconds": 2.33,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.25,
      "end_seconds": 161.8,
      "duration_seconds": 4.55,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.96,
      "end_seconds": 166.14,
      "duration_seconds": 3.18,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.89,
      "end_seconds": 177.61,
      "duration_seconds": 2.72,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.9,
      "end_seconds": 207.09,
      "duration_seconds": 12.19,
      "text": "Okay: BMI works out to 28.5, weight 65 kilos, temperature 37.1, respiratory rate 16, pressure 126 over 77, heart rate 108, height 151 centimetres."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 210.32,
      "duration_seconds": 1.44,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.85,
      "end_seconds": 215.65,
      "duration_seconds": 3.8,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.47,
      "end_seconds": 222.09,
      "duration_seconds": 3.62,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.09,
      "end_seconds": 225.54,
      "duration_seconds": 2.45,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 243.99,
      "duration_seconds": 4.69,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.52,
      "end_seconds": 257.5,
      "duration_seconds": 10.98,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I'd lean towards heavy periods with iron deficiency. We shouldn't forget fibroids."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.02,
      "end_seconds": 262.47,
      "duration_seconds": 3.45,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.7,
      "end_seconds": 293.53,
      "duration_seconds": 29.83,
      "text": "It's reasonable to be concerned, but right now heavy periods with iron deficiency is my leading thought, not anything worse. I want a ferritin level done, that's for heavy periods. What I'm giving you is tranexamic acid, 1 gram, three times a day, during periods. That's for heavy periods. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.31,
      "end_seconds": 318.45,
      "duration_seconds": 19.14,
      "text": "I'm going to put you on ferrous sulfate, 200 milligrams, once a day, three months. That should help with iron deficiency. I'll put all of this in writing so you don't have to remember it. Keep a pad count diary."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.54,
      "end_seconds": 325.89,
      "duration_seconds": 5.35,
      "text": "Could I get a blood count done? A friend had it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.21,
      "end_seconds": 338.91,
      "duration_seconds": 11.7,
      "text": "Not at this point, no. It isn't indicated yet. I'd like to see you again after the results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.22,
      "end_seconds": 343.89,
      "duration_seconds": 3.67,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.0,
      "end_seconds": 347.22,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}