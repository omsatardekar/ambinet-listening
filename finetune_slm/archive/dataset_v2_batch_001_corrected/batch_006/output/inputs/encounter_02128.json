{
  "schema_version": "1.0",
  "encounter_id": "02128",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 6.63,
      "duration_seconds": 5.88,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.48,
      "end_seconds": 12.54,
      "duration_seconds": 5.06,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.05,
      "end_seconds": 25.15,
      "duration_seconds": 8.1,
      "text": "Yeah, it's severe pain in the lower leg after a fracture. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.91,
      "end_seconds": 28.63,
      "duration_seconds": 1.72,
      "text": "Right, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.38,
      "end_seconds": 31.91,
      "duration_seconds": 2.53,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.78,
      "end_seconds": 40.66,
      "duration_seconds": 7.88,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.46,
      "end_seconds": 78.32,
      "duration_seconds": 35.86,
      "text": "It's, It's once or twice a day. I notice it more with passive movement. I'd rather not end up on lots of tablets if I can avoid it. I told myself I'd wait and see, uh, and here I am. Oh, and tingling in the foot. That's been about the same, six months. About tingling in the foot, honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.67,
      "end_seconds": 83.52,
      "duration_seconds": 3.85,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.13,
      "end_seconds": 96.6,
      "duration_seconds": 1.47,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.42,
      "end_seconds": 99.85,
      "duration_seconds": 1.43,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.41,
      "end_seconds": 118.4,
      "duration_seconds": 5.99,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.68,
      "end_seconds": 129.27,
      "duration_seconds": 5.59,
      "text": "All finished, thank you. Any wound infection, fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.03,
      "end_seconds": 134.93,
      "duration_seconds": 3.9,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.74,
      "end_seconds": 138.23,
      "duration_seconds": 2.49,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.1,
      "end_seconds": 140.15,
      "duration_seconds": 1.05,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.94,
      "end_seconds": 161.28,
      "duration_seconds": 5.34,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.26,
      "end_seconds": 166.08,
      "duration_seconds": 2.82,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.85,
      "end_seconds": 169.07,
      "duration_seconds": 2.22,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.84,
      "end_seconds": 174.67,
      "duration_seconds": 3.83,
      "text": "Mm, I take losartan, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.32,
      "end_seconds": 177.38,
      "duration_seconds": 2.06,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.25,
      "end_seconds": 184.32,
      "duration_seconds": 1.07,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.3,
      "end_seconds": 191.83,
      "duration_seconds": 5.53,
      "text": "What about your medical history? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.67,
      "end_seconds": 199.94,
      "duration_seconds": 6.27,
      "text": "I've got high blood pressure. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.42,
      "end_seconds": 202.12,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.72,
      "end_seconds": 222.11,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.29,
      "end_seconds": 226.42,
      "duration_seconds": 3.13,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.54,
      "end_seconds": 229.32,
      "duration_seconds": 1.78,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.93,
      "end_seconds": 234.95,
      "duration_seconds": 4.02,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.23,
      "end_seconds": 255.95,
      "duration_seconds": 2.72,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.57,
      "end_seconds": 262.47,
      "duration_seconds": 4.9,
      "text": "Hmm, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.81,
      "end_seconds": 292.32,
      "duration_seconds": 24.51,
      "text": "Having listened and examined, it fits best with possible compartment syndrome needing urgent surgery. We should do measuring the pressure in the leg for possible compartment syndrome. Remove the cast now, you are going to theatre for a decompression. Let's get you seen by the orthopaedic team, I'll arrange the letter. Let's review you straight away."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.04,
      "end_seconds": 294.87,
      "duration_seconds": 1.83,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.58,
      "end_seconds": 302.06,
      "duration_seconds": 2.48,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.72,
      "end_seconds": 308.87,
      "duration_seconds": 6.15,
      "text": "Sorry, what was I saying, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.51,
      "end_seconds": 312.23,
      "duration_seconds": 1.72,
      "text": "Okay, goodbye for now."
    }
  ]
}