{
  "schema_version": "1.0",
  "encounter_id": "02241",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.88,
      "end_seconds": 7.43,
      "duration_seconds": 6.55,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 12.66,
      "duration_seconds": 4.12,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.24,
      "end_seconds": 18.98,
      "duration_seconds": 5.74,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.83,
      "end_seconds": 25.31,
      "duration_seconds": 3.48,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.46,
      "end_seconds": 33.22,
      "duration_seconds": 6.76,
      "text": "Honestly, you know, it's brain fog, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.93,
      "end_seconds": 37.87,
      "duration_seconds": 2.94,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.08,
      "end_seconds": 42.14,
      "duration_seconds": 3.06,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.47,
      "end_seconds": 50.79,
      "duration_seconds": 2.32,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.77,
      "end_seconds": 81.95,
      "duration_seconds": 29.18,
      "text": "A racing heart on standing goes along with it, most of the time. And breathlessness months after the infection as well, since last night. I mean, with breathlessness months after the infection, it happens on and off. The racing heart on standing? That's been for about three months. Right, about racing heart on standing, yes, standing. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 83.7,
      "end_seconds": 87.73,
      "duration_seconds": 4.03,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.58,
      "end_seconds": 94.15,
      "duration_seconds": 4.57,
      "text": "Have you had any coughing up blood or leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.44,
      "end_seconds": 99.21,
      "duration_seconds": 3.77,
      "text": "No, no coughing up blood or leg swelling."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.95,
      "end_seconds": 101.18,
      "duration_seconds": 1.23,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.93,
      "end_seconds": 108.82,
      "duration_seconds": 2.89,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 109.82,
      "end_seconds": 115.35,
      "duration_seconds": 5.53,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.73,
      "end_seconds": 123.73,
      "duration_seconds": 7.0,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.49,
      "end_seconds": 130.76,
      "duration_seconds": 6.27,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.57,
      "end_seconds": 133.6,
      "duration_seconds": 2.03,
      "text": "Nope, no chest pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.62,
      "end_seconds": 139.38,
      "duration_seconds": 3.76,
      "text": "So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.15,
      "end_seconds": 143.68,
      "duration_seconds": 1.53,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.19,
      "end_seconds": 150.03,
      "duration_seconds": 5.84,
      "text": "Let's run through your medicines. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.02,
      "end_seconds": 156.61,
      "duration_seconds": 4.59,
      "text": "Oh, it's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 157.97,
      "end_seconds": 163.39,
      "duration_seconds": 5.42,
      "text": "Doctor, our chart from the last visit lists it as 140 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.15,
      "end_seconds": 170.28,
      "duration_seconds": 3.13,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.28,
      "end_seconds": 176.64,
      "duration_seconds": 5.36,
      "text": "No, I left it at home. Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.01,
      "end_seconds": 182.12,
      "duration_seconds": 4.11,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.13,
      "end_seconds": 189.49,
      "duration_seconds": 3.36,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.09,
      "end_seconds": 209.32,
      "duration_seconds": 4.23,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.39,
      "end_seconds": 218.62,
      "duration_seconds": 8.23,
      "text": "Yes, tramadol. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.64,
      "end_seconds": 222.55,
      "duration_seconds": 2.91,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.81,
      "end_seconds": 227.15,
      "duration_seconds": 3.34,
      "text": "No, you know, not at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.75,
      "end_seconds": 231.08,
      "duration_seconds": 3.33,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.13,
      "end_seconds": 233.96,
      "duration_seconds": 1.83,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.42,
      "end_seconds": 236.73,
      "duration_seconds": 1.31,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.77,
      "end_seconds": 245.64,
      "duration_seconds": 6.87,
      "text": "COPD, for about ten years. I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.38,
      "end_seconds": 248.43,
      "duration_seconds": 1.05,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.98,
      "end_seconds": 259.77,
      "duration_seconds": 10.79,
      "text": "Yes, depression. I've never really been one for hospitals. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.71,
      "end_seconds": 269.49,
      "duration_seconds": 8.78,
      "text": "Right, so thin bones and COPD are already on your record. We'll keep that in mind today. How about smoking?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 270.88,
      "end_seconds": 273.39,
      "duration_seconds": 2.51,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.19,
      "end_seconds": 279.33,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 280.37,
      "end_seconds": 284.43,
      "duration_seconds": 4.06,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.4,
      "end_seconds": 287.6,
      "duration_seconds": 1.2,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 288.48,
      "end_seconds": 292.5,
      "duration_seconds": 4.02,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 294.17,
      "end_seconds": 305.05,
      "duration_seconds": 10.88,
      "text": "Doctor, I've got the readings for you. Saturation 97 percent, pulse is 86 beats a minute, respiratory rate 16. Temperature is 36.7 degrees, pressure 123 over 82."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.83,
      "end_seconds": 307.79,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.87,
      "end_seconds": 312.59,
      "duration_seconds": 3.72,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.24,
      "end_seconds": 316.49,
      "duration_seconds": 2.25,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.42,
      "end_seconds": 335.08,
      "duration_seconds": 6.66,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.27,
      "end_seconds": 339.83,
      "duration_seconds": 2.56,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.72,
      "end_seconds": 367.41,
      "duration_seconds": 10.69,
      "text": "Okay, thinking it through, I'd lean towards post-viral symptoms after COVID. It could also be a thyroid problem, so we'll keep that open."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.39,
      "end_seconds": 371.36,
      "duration_seconds": 1.97,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.03,
      "end_seconds": 385.42,
      "duration_seconds": 12.39,
      "text": "Nothing I've seen today points to an emergency. It looks like post-viral symptoms after COVID. So, to recap quickly. You've had brain fog, moderate, and no coughing up blood."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 386.42,
      "end_seconds": 388.18,
      "duration_seconds": 1.76,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.02,
      "end_seconds": 403.09,
      "duration_seconds": 14.07,
      "text": "Pace your activity and increase it slowly each week. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 404.69,
      "end_seconds": 405.73,
      "duration_seconds": 1.04,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.46,
      "end_seconds": 410.09,
      "duration_seconds": 3.63,
      "text": "Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.57,
      "end_seconds": 414.47,
      "duration_seconds": 2.9,
      "text": "Hmm, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.87,
      "end_seconds": 417.61,
      "duration_seconds": 1.74,
      "text": "Have a good day."
    }
  ]
}