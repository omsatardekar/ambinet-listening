{
  "schema_version": "1.0",
  "encounter_id": "02206",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 5.49,
      "duration_seconds": 4.58,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.54,
      "end_seconds": 8.67,
      "duration_seconds": 1.13,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.97,
      "end_seconds": 14.91,
      "duration_seconds": 4.94,
      "text": "Thank you for fitting us in, you know, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.71,
      "end_seconds": 21.36,
      "duration_seconds": 4.65,
      "text": "Absolutely, come and sit beside them. Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.94,
      "end_seconds": 29.59,
      "duration_seconds": 4.65,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.62,
      "end_seconds": 32.49,
      "duration_seconds": 1.87,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.27,
      "end_seconds": 37.72,
      "duration_seconds": 3.45,
      "text": "Well, I've been having a throbbing toothache."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.79,
      "end_seconds": 43.03,
      "duration_seconds": 3.24,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.8,
      "end_seconds": 60.34,
      "duration_seconds": 3.54,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.5,
      "end_seconds": 84.28,
      "duration_seconds": 10.78,
      "text": "Okay: height 177 centimetres, respiratory rate 20, blood pressure 116 over 76, weight 58 kilos, pulse is 89 beats a minute, temperature is 38.2 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.59,
      "end_seconds": 89.67,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.5,
      "end_seconds": 97.82,
      "duration_seconds": 6.32,
      "text": "Right, we'll look at it together shortly. How long has it been like this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.26,
      "end_seconds": 102.51,
      "duration_seconds": 3.25,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.32,
      "end_seconds": 112.73,
      "duration_seconds": 9.41,
      "text": "So, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.09,
      "end_seconds": 133.4,
      "duration_seconds": 15.31,
      "text": "Hot drinks definitely sets it off. I'd say every other day. Maybe a six out of ten on a bad day. I did have a low temperature at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.32,
      "end_seconds": 142.42,
      "duration_seconds": 8.1,
      "text": "Let me check a few things. Any eye swelling, noisy breathing, difficulty opening the mouth or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.82,
      "end_seconds": 150.65,
      "duration_seconds": 6.83,
      "text": "No, no eye swelling, noisy breathing, difficulty opening the mouth or difficulty swallowing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.64,
      "end_seconds": 157.05,
      "duration_seconds": 2.41,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.13,
      "end_seconds": 160.17,
      "duration_seconds": 2.04,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.14,
      "end_seconds": 162.6,
      "duration_seconds": 1.46,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.04,
      "end_seconds": 165.96,
      "duration_seconds": 1.92,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.62,
      "end_seconds": 176.5,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.06,
      "end_seconds": 185.4,
      "duration_seconds": 3.34,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.83,
      "end_seconds": 188.08,
      "duration_seconds": 1.25,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.57,
      "end_seconds": 192.53,
      "duration_seconds": 2.96,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.71,
      "end_seconds": 196.39,
      "duration_seconds": 2.68,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.97,
      "end_seconds": 202.45,
      "duration_seconds": 4.48,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.68,
      "end_seconds": 206.58,
      "duration_seconds": 2.9,
      "text": "Alright, do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.04,
      "end_seconds": 211.83,
      "duration_seconds": 3.79,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.7,
      "end_seconds": 214.39,
      "duration_seconds": 1.69,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.36,
      "end_seconds": 218.98,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.96,
      "end_seconds": 224.52,
      "duration_seconds": 4.56,
      "text": "Okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.08,
      "end_seconds": 228.61,
      "duration_seconds": 2.53,
      "text": "I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 239.23,
      "duration_seconds": 9.37,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.71,
      "end_seconds": 242.26,
      "duration_seconds": 1.55,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 256.35,
      "duration_seconds": 5.09,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.38,
      "end_seconds": 261.82,
      "duration_seconds": 3.44,
      "text": "I'm allergic to amoxicillin, I get hives."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.78,
      "end_seconds": 283.85,
      "duration_seconds": 3.07,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.44,
      "end_seconds": 287.8,
      "duration_seconds": 2.36,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.42,
      "end_seconds": 293.16,
      "duration_seconds": 4.74,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.53,
      "end_seconds": 299.97,
      "duration_seconds": 4.44,
      "text": "I take omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.06,
      "end_seconds": 304.52,
      "duration_seconds": 3.46,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.52,
      "end_seconds": 310.67,
      "duration_seconds": 2.15,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.72,
      "end_seconds": 317.08,
      "duration_seconds": 4.36,
      "text": "Right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.32,
      "end_seconds": 320.5,
      "duration_seconds": 2.18,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.03,
      "end_seconds": 334.64,
      "duration_seconds": 5.61,
      "text": "The lower right molar is tender with swollen gum and the cheek is puffy."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.0,
      "end_seconds": 357.84,
      "duration_seconds": 19.84,
      "text": "You can relax now. Okay, so my impression is this: I think we're dealing with a dental abscess at this stage. The reason I say that is that your story and my examination fit together. A salivary gland infection is also on my list."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.44,
      "end_seconds": 362.94,
      "duration_seconds": 3.5,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.96,
      "end_seconds": 394.18,
      "duration_seconds": 30.22,
      "text": "Nothing I've seen today points to an emergency. It looks like a dental abscess, but I'd like to confirm. Let's book a dental X-ray to look into dental abscess. See the dentist today, rinse with warm salt water. The dentist would be the right next step, I'll refer you. Please come and see me in two days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.81,
      "end_seconds": 398.21,
      "duration_seconds": 3.4,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 399.28,
      "end_seconds": 400.51,
      "duration_seconds": 1.23,
      "text": "Look after yourself."
    }
  ]
}