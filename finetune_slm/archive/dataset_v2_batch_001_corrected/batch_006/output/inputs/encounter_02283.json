{
  "schema_version": "1.0",
  "encounter_id": "02283",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.65,
      "duration_seconds": 3.45,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.55,
      "end_seconds": 11.01,
      "duration_seconds": 5.46,
      "text": "Yes, come in and and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.82,
      "end_seconds": 14.9,
      "duration_seconds": 3.08,
      "text": "So, I've been feeling exhausted, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.34,
      "end_seconds": 19.6,
      "duration_seconds": 3.26,
      "text": "Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.16,
      "end_seconds": 24.2,
      "duration_seconds": 3.04,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.62,
      "end_seconds": 28.25,
      "duration_seconds": 2.63,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.05,
      "end_seconds": 33.01,
      "duration_seconds": 3.96,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.5,
      "end_seconds": 37.99,
      "duration_seconds": 4.49,
      "text": "Hm, okay. Did you get fainting or bleeding between periods?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.74,
      "end_seconds": 43.73,
      "duration_seconds": 3.99,
      "text": "No, no fainting or bleeding between periods."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.56,
      "end_seconds": 47.48,
      "duration_seconds": 2.92,
      "text": "And what about pain or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.46,
      "end_seconds": 56.26,
      "duration_seconds": 4.8,
      "text": "Oh, no pain or weight loss, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.66,
      "end_seconds": 59.99,
      "duration_seconds": 2.33,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.9,
      "end_seconds": 61.82,
      "duration_seconds": 0.92,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.01,
      "end_seconds": 69.47,
      "duration_seconds": 4.46,
      "text": "Do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.76,
      "end_seconds": 72.22,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.28,
      "end_seconds": 83.62,
      "duration_seconds": 3.34,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.38,
      "end_seconds": 87.31,
      "duration_seconds": 2.93,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.15,
      "end_seconds": 103.82,
      "duration_seconds": 4.67,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.57,
      "end_seconds": 108.5,
      "duration_seconds": 2.93,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.58,
      "end_seconds": 110.85,
      "duration_seconds": 1.27,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.52,
      "end_seconds": 115.22,
      "duration_seconds": 3.7,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.17,
      "end_seconds": 119.48,
      "duration_seconds": 2.31,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.4,
      "end_seconds": 125.97,
      "duration_seconds": 2.57,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 128.72,
      "duration_seconds": 2.07,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.19,
      "end_seconds": 134.33,
      "duration_seconds": 4.14,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.78,
      "end_seconds": 156.19,
      "duration_seconds": 3.41,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.31,
      "end_seconds": 169.77,
      "duration_seconds": 2.46,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.45,
      "end_seconds": 192.47,
      "duration_seconds": 9.02,
      "text": "Okay: oxygen saturation is 97 percent, heart rate 126, temperature is 37.1 degrees, blood pressure 133 over 81."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.63,
      "end_seconds": 198.32,
      "duration_seconds": 3.69,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.43,
      "end_seconds": 200.67,
      "duration_seconds": 1.24,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.96,
      "end_seconds": 218.1,
      "duration_seconds": 5.14,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.42,
      "end_seconds": 222.37,
      "duration_seconds": 1.95,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.15,
      "end_seconds": 242.83,
      "duration_seconds": 5.68,
      "text": "Right, here's what I'm thinking. It fits best with heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.69,
      "end_seconds": 248.62,
      "duration_seconds": 3.93,
      "text": "So, um, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.7,
      "end_seconds": 264.13,
      "duration_seconds": 13.43,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods with iron deficiency, but I'd like to confirm. I'm going to order a blood count, for heavy periods."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.17,
      "end_seconds": 268.63,
      "duration_seconds": 2.46,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.36,
      "end_seconds": 281.84,
      "duration_seconds": 12.48,
      "text": "I'll start you on tranexamic acid, 1 gram, three times a day, during periods. You take it by mouth. That should help with heavy periods."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.85,
      "end_seconds": 287.79,
      "duration_seconds": 3.94,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.91,
      "end_seconds": 296.3,
      "duration_seconds": 7.39,
      "text": "Keep a a pad count diary. We'll catch up after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.05,
      "end_seconds": 300.95,
      "duration_seconds": 2.9,
      "text": "great, thank you for your help"
    }
  ]
}