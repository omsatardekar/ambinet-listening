  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 8.39,
      "duration_seconds": 7.11,
      "text": "Doctor, uh, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.31,
      "end_seconds": 17.59,
      "duration_seconds": 4.28,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 19.35,
      "end_seconds": 26.02,
      "duration_seconds": 6.67,
      "text": "Hmm, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.85,
      "end_seconds": 31.52,
      "duration_seconds": 4.67,
      "text": "Um, so... no symptoms. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.77,
      "end_seconds": 32.61,
      "duration_seconds": 0.84,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.63,
      "end_seconds": 39.76,
      "duration_seconds": 5.13,
      "text": "And a high blood sugar on a routine test, too."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 40.76,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.52,
      "end_seconds": 46.49,
      "duration_seconds": 4.97,
      "text": "Um, I've also had being a little overweight."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.74,
      "end_seconds": 49.81,
      "duration_seconds": 2.07,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.1,
      "end_seconds": 60.62,
      "duration_seconds": 9.52,
      "text": "It's hydrocortisone cream, when needed, doctor. Actually, uh, it's metformin, 500 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.72,
      "end_seconds": 81.61,
      "duration_seconds": 3.89,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 87.54,
      "duration_seconds": 1.68,
      "text": "I've got eczema."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.38,
      "end_seconds": 90.4,
      "duration_seconds": 1.02,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.95,
      "end_seconds": 97.28,
      "duration_seconds": 5.33,
      "text": "Let me think, I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.93,
      "end_seconds": 106.38,
      "duration_seconds": 8.45,
      "text": "Okay, I can see diabetes in your file as well. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.4,
      "end_seconds": 125.86,
      "duration_seconds": 18.46,
      "text": "No, I've never smoked in my life. I only drink at family occasions. I'm a plumber, lots of bending and kneeling. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.65,
      "end_seconds": 143.28,
      "duration_seconds": 4.63,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 148.7,
      "duration_seconds": 4.56,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.26,
      "end_seconds": 153.23,
      "duration_seconds": 3.97,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.38,
      "end_seconds": 157.24,
      "duration_seconds": 2.86,
      "text": "Well, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.14,
      "end_seconds": 161.35,
      "duration_seconds": 3.21,
      "text": "And what about blurred vision or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.49,
      "end_seconds": 167.03,
      "duration_seconds": 4.54,
      "text": "Oh, no, no blurred vision or weight loss."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.72,
      "end_seconds": 173.42,
      "duration_seconds": 4.7,
      "text": "Let me check a few things. Any frequent urination or thirst?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.54,
      "end_seconds": 179.7,
      "duration_seconds": 5.16,
      "text": "Let me think, uh, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.09,
      "end_seconds": 182.98,
      "duration_seconds": 2.89,
      "text": "Hm, okay. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.61,
      "end_seconds": 190.57,
      "duration_seconds": 2.96,
      "text": "Nothing unusual, uh, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.77,
      "end_seconds": 194.19,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.59,
      "end_seconds": 206.33,
      "duration_seconds": 2.74,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.57,
      "end_seconds": 224.89,
      "duration_seconds": 8.32,
      "text": "Okay: oxygen saturation is 98 percent, heart rate 72, temp 36.8 degrees. And blood pressure 117 over 71."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.6,
      "end_seconds": 228.4,
      "duration_seconds": 1.8,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.12,
      "end_seconds": 233.12,
      "duration_seconds": 3.0,
      "text": "Alright, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.87,
      "end_seconds": 238.52,
      "duration_seconds": 3.65,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.97,
      "end_seconds": 241.99,
      "duration_seconds": 2.02,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 263.47,
      "duration_seconds": 3.15,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.58,
      "end_seconds": 271.61,
      "duration_seconds": 3.03,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.9,
      "end_seconds": 306.0,
      "duration_seconds": 23.1,
      "text": "Okay, thinking it through, it fits best with prediabetes. Let's get a repeat HbA1c, for prediabetes. Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. Let's get you seen by the diabetes prevention programme, I'll arrange the letter. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.21,
      "end_seconds": 311.58,
      "duration_seconds": 4.37,
      "text": "Okay, so good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.25,
      "end_seconds": 313.51,
      "duration_seconds": 1.26,
      "text": "Goodbye for now."
    }
  ]
}