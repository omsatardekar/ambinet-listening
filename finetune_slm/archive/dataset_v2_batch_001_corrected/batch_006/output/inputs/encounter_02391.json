{
  "schema_version": "1.0",
  "encounter_id": "02391",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 5.31,
      "duration_seconds": 4.67,
      "text": "Uh, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.98,
      "end_seconds": 10.59,
      "duration_seconds": 3.61,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.94,
      "end_seconds": 19.13,
      "duration_seconds": 4.19,
      "text": "well I've been having a red swollen foot"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.07,
      "end_seconds": 22.35,
      "duration_seconds": 2.28,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.08,
      "end_seconds": 37.6,
      "duration_seconds": 13.52,
      "text": "Since last weekend that's when it began. I've also been feeling shivery for about two weeks. As for feeling shivery it feels mild to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.58,
      "end_seconds": 41.77,
      "duration_seconds": 3.19,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.07,
      "end_seconds": 48.29,
      "duration_seconds": 5.22,
      "text": "I'm on gliclazide, 80 milligrams, maybe, twice a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.23,
      "end_seconds": 58.0,
      "duration_seconds": 4.77,
      "text": "alright, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.72,
      "end_seconds": 61.73,
      "duration_seconds": 2.01,
      "text": "No it's at home."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.56,
      "end_seconds": 65.04,
      "duration_seconds": 1.48,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.01,
      "end_seconds": 68.04,
      "duration_seconds": 1.03,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.75,
      "end_seconds": 71.42,
      "duration_seconds": 2.67,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.52,
      "end_seconds": 80.54,
      "duration_seconds": 8.02,
      "text": "Diabetes for two years. My sister suggested writing things down but I forgot. I've got thin bones."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.24,
      "end_seconds": 89.45,
      "duration_seconds": 7.21,
      "text": "I follow. Okay, I can see diabetes and and thin bones in your file as well. Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.03,
      "end_seconds": 94.44,
      "duration_seconds": 4.41,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.31,
      "end_seconds": 97.78,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.17,
      "end_seconds": 102.28,
      "duration_seconds": 3.11,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.21,
      "end_seconds": 106.09,
      "duration_seconds": 2.88,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.03,
      "end_seconds": 112.93,
      "duration_seconds": 4.9,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.74,
      "end_seconds": 115.53,
      "duration_seconds": 1.79,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.91,
      "end_seconds": 120.75,
      "duration_seconds": 3.84,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.51,
      "end_seconds": 123.86,
      "duration_seconds": 2.35,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.07,
      "end_seconds": 130.36,
      "duration_seconds": 2.29,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.39,
      "end_seconds": 148.64,
      "duration_seconds": 4.25,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.64,
      "end_seconds": 153.12,
      "duration_seconds": 2.48,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.9,
      "end_seconds": 155.92,
      "duration_seconds": 2.02,
      "text": "and fever any of that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.75,
      "end_seconds": 159.38,
      "duration_seconds": 1.63,
      "text": "no fever, thankfully"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.39,
      "end_seconds": 168.26,
      "duration_seconds": 5.87,
      "text": "and what about pain in the foot tracking redness or black skin?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.94,
      "end_seconds": 175.18,
      "duration_seconds": 6.24,
      "text": "Mm no no pain in the foot tracking redness or black skin."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.18,
      "end_seconds": 180.5,
      "duration_seconds": 3.32,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.21,
      "end_seconds": 186.87,
      "duration_seconds": 4.66,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.41,
      "end_seconds": 190.02,
      "duration_seconds": 2.61,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.65,
      "end_seconds": 193.21,
      "duration_seconds": 1.56,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.04,
      "end_seconds": 208.23,
      "duration_seconds": 3.19,
      "text": "time for your numbers if that's okay"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.07,
      "end_seconds": 224.78,
      "duration_seconds": 2.71,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.24,
      "end_seconds": 247.73,
      "duration_seconds": 9.49,
      "text": "Okay: temperature is 39.0 degrees, BP is 124 over 69, heart rate 95. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.25,
      "end_seconds": 253.05,
      "duration_seconds": 2.8,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.92,
      "end_seconds": 257.13,
      "duration_seconds": 2.21,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.11,
      "end_seconds": 277.37,
      "duration_seconds": 8.26,
      "text": "the ulcer is deep to the fat with surrounding redness and the the foot pulses are present"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.05,
      "end_seconds": 285.99,
      "duration_seconds": 2.94,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.38,
      "end_seconds": 302.83,
      "duration_seconds": 7.45,
      "text": "So, based on the history and the examination, this looks most like an infected diabetic foot ulcer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.88,
      "end_seconds": 307.31,
      "duration_seconds": 3.43,
      "text": "well, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.17,
      "end_seconds": 326.26,
      "duration_seconds": 18.09,
      "text": "I can't promise yet, but most people with an infected diabetic foot ulcer do well once it's treated properly. I want blood tests done, that's for infected ulcer. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.29,
      "end_seconds": 330.53,
      "duration_seconds": 2.24,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.89,
      "end_seconds": 345.98,
      "duration_seconds": 14.09,
      "text": "I want a wound swab done, that's for infected ulcer. We'll begin with co-amoxiclav, 625 milligrams, three times a day, seven days. That should help with infected ulcer."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.99,
      "end_seconds": 351.31,
      "duration_seconds": 4.32,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.92,
      "end_seconds": 383.01,
      "duration_seconds": 30.09,
      "text": "keep the weight off the foot and keep the dressing dry. Let's get you seen by the diabetic foot clinic I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the the next visit so we can settle the dose. Keep an eye out and if the symptoms get worse call us the same day or go to emergency. I'd like to see you again in two days"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.82,
      "end_seconds": 385.76,
      "duration_seconds": 1.94,
      "text": "alright I'll be back"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.82,
      "end_seconds": 390.63,
      "duration_seconds": 3.81,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.72,
      "end_seconds": 397.96,
      "duration_seconds": 2.24,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.91,
      "end_seconds": 401.47,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}