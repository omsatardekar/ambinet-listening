{
  "schema_version": "1.0",
  "encounter_id": "02317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 4.5,
      "duration_seconds": 3.12,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.18,
      "end_seconds": 9.99,
      "duration_seconds": 3.81,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.63,
      "end_seconds": 13.09,
      "duration_seconds": 2.46,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 14.13,
      "end_seconds": 19.03,
      "duration_seconds": 4.9,
      "text": "He's been having pain in the lower left tummy, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.64,
      "end_seconds": 23.72,
      "duration_seconds": 3.08,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.96,
      "end_seconds": 31.74,
      "duration_seconds": 6.78,
      "text": "About two weeks, I think... sorry, about a week, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.39,
      "end_seconds": 41.27,
      "duration_seconds": 8.88,
      "text": "Tell me a a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.61,
      "end_seconds": 50.97,
      "duration_seconds": 8.36,
      "text": "Maybe a six out of ten on a bad day. It's once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.95,
      "end_seconds": 55.83,
      "duration_seconds": 2.88,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.76,
      "end_seconds": 66.48,
      "duration_seconds": 8.72,
      "text": "A low fever goes along with it, most of the time. The low fever? That's been for two months"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.0,
      "end_seconds": 69.97,
      "duration_seconds": 2.97,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.51,
      "end_seconds": 82.14,
      "duration_seconds": 10.63,
      "text": "Moderate, really. I've been feeling bloated too, for about four days. With feeling bloated, Moderate, really. And constipation then loose stools, too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.89,
      "end_seconds": 105.51,
      "duration_seconds": 4.62,
      "text": "Did you get blood in the stool or urinary symptoms?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.79,
      "end_seconds": 110.37,
      "duration_seconds": 3.58,
      "text": "Well, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.34,
      "end_seconds": 117.05,
      "duration_seconds": 4.71,
      "text": "let me check a few things any vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.47,
      "end_seconds": 120.89,
      "duration_seconds": 2.42,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.42,
      "end_seconds": 124.42,
      "duration_seconds": 2.0,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.4,
      "end_seconds": 127.76,
      "duration_seconds": 1.36,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.43,
      "end_seconds": 133.71,
      "duration_seconds": 5.28,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.63,
      "end_seconds": 146.41,
      "duration_seconds": 10.78,
      "text": "I think I reacted to some antibiotic once, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.2,
      "end_seconds": 165.48,
      "duration_seconds": 4.28,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.38,
      "end_seconds": 170.45,
      "duration_seconds": 4.07,
      "text": "I have diabetes. Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.75,
      "end_seconds": 175.96,
      "duration_seconds": 4.21,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.01,
      "end_seconds": 185.47,
      "duration_seconds": 5.46,
      "text": "It's glibenclamide, 5 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.81,
      "end_seconds": 191.42,
      "duration_seconds": 4.61,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.53,
      "end_seconds": 208.22,
      "duration_seconds": 14.69,
      "text": "No, it's at home. Seretide inhaler. I take it twice a day. Sorry, I know I'm rambling a bit. Before this I was on gliclazide; that's been stopped."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.96,
      "end_seconds": 212.74,
      "duration_seconds": 2.78,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.44,
      "end_seconds": 217.76,
      "duration_seconds": 4.32,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.09,
      "end_seconds": 222.92,
      "duration_seconds": 3.83,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.05,
      "end_seconds": 230.13,
      "duration_seconds": 4.08,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.22,
      "end_seconds": 234.43,
      "duration_seconds": 2.21,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.19,
      "end_seconds": 249.17,
      "duration_seconds": 12.98,
      "text": "I had an operation for a hernia last spring my family kept telling me to get it checked i took the morning off to come in today"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 249.97,
      "end_seconds": 258.5,
      "duration_seconds": 8.53,
      "text": "Okay, so the vitals from earlier. Temperature 38.4, pressure 105 over 70. Pulse 99, saturation 95 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.34,
      "end_seconds": 264.04,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.98,
      "end_seconds": 268.99,
      "duration_seconds": 3.01,
      "text": "Let's move on to the the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 270.69,
      "end_seconds": 271.66,
      "duration_seconds": 0.97,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.08,
      "end_seconds": 274.28,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.99,
      "end_seconds": 297.94,
      "duration_seconds": 4.95,
      "text": "it is tender in the lower left with no guarding or rigidity"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.42,
      "end_seconds": 304.29,
      "duration_seconds": 2.87,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.95,
      "end_seconds": 338.4,
      "duration_seconds": 15.45,
      "text": "Let me tell you where I've got to. My working impression is acute diverticulitis. A bowel tumour is also on my list. I think blood tests makes sense here, for abdominal pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 340.34,
      "end_seconds": 341.52,
      "duration_seconds": 1.18,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.15,
      "end_seconds": 355.78,
      "duration_seconds": 12.63,
      "text": "let's get a CT scan, for left iliac fossa pain what I'm giving you is co-amoxiclav, 625 milligrams, three times a day, five days that's for diverticulitis"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.39,
      "end_seconds": 357.97,
      "duration_seconds": 1.58,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.75,
      "end_seconds": 372.63,
      "duration_seconds": 13.88,
      "text": "Drink plenty and start with a light diet. And please bring the the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in one week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 373.78,
      "end_seconds": 376.93,
      "duration_seconds": 3.15,
      "text": "I'll note it it in my calendar"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.78,
      "end_seconds": 380.53,
      "duration_seconds": 2.75,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 382.3,
      "end_seconds": 386.04,
      "duration_seconds": 3.74,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}